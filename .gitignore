# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Python virtual environments
.venv/

# Python bytecode caches
__pycache__/
*.pyc

# Logs/
# Ignore dry-run and local logs.
logs/*-d-*.md
logs/local_*.md

# Reports/

reports/*
!reports/README.md
!reports/branch/
!reports/guidelines/
!reports/repository/

reports/branch/*
!reports/branch/README.md
!reports/branch/mergeto-v*.*.*-*.md
!reports/branch/mergeto-main-*.md
# Ignore dry-run reports.
reports/branch/*-d-*.md

reports/guidelines/*
!reports/guidelines/README.md
!reports/guidelines/updatebrand-*.md
# Ignore dry-run reports.
reports/guidelines/*-d-*.md

# reports/repository/
# Ignore dry-run reports.
reports/repository/*-d-*.md
