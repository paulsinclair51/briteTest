#!/usr/bin/env bash

# mkclone - Clone a Git repository.
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default options
COMMENT=""
TARGET_DIR=""

usage() {
  cat <<'EOF'
Usage:
  mkclone [OPTIONS] <repo-url> [directory]
  mkclone -h | --help

Clone a Git repository to a local directory.

Arguments:
  <repo-url>         The URL of the repository to clone
                     Examples: https://github.com/user/repo.git
                               git@github.com:user/repo.git
  [directory]        Optional target directory name
                     If not specified, uses repository name from URL
                     Examples: mkclone https://github.com/user/repo.git
                                 → Creates ./repo/
                               mkclone https://github.com/user/repo.git my-repo
                                 → Creates ./my-repo/

Comment Options (mutually exclusive):
  -m, --message MSG  Attach a comment to the operation
                     Usage: mkclone https://github.com/user/repo.git -m "Setup for feature work"
  -- COMMENT TEXT    Unix-style comment (everything after -- is the comment)
                     Usage: mkclone https://github.com/user/repo.git -- Setup for feature work
                     Note: No quotes needed, captures all remaining arguments

Options:
  -h, --help         Output this help to stdout and exit.
  -m, --message MSG  Add comment message (GitHub style, requires quotes if spaces)
  -- TEXT            Add comment (Unix style, everything after -- is the comment)

Examples:
  # Basic clone with default directory name
  mkclone https://github.com/paulsinclair51/BriteTest.git
    → Creates ./BriteTest/

  # Clone into custom directory
  mkclone https://github.com/paulsinclair51/BriteTest.git my-repo
    → Creates ./my-repo/

  # With GitHub-style comment
  mkclone https://github.com/paulsinclair51/BriteTest.git -m "Setup for new feature development"

  # With Unix-style comment
  mkclone https://github.com/paulsinclair51/BriteTest.git work-repo -- Starting feature branch work

  # SSH URL
  mkclone git@github.com:paulsinclair51/BriteTest.git

Exit codes:
  0   Success
  1   Argument error
  2   Git clone failed
  3   Target directory already exists
EOF
}

info() {
  echo -e "${BLUE}ℹ${NC} $1"
}

success() {
  echo -e "${GREEN}✓${NC} $1"
}

warn() {
  echo -e "${YELLOW}⚠${NC} $1"
}

error_exit() {
  local code="$1"
  local message="$2"
  local repo_url="${3:-}"

  echo -e "${RED}Error:${NC} $message" >&2
  exit "$code"
}

extract_repo_name() {
  local url="$1"
  
  # Remove .git suffix if present
  url="${url%.git}"
  
  # Extract the last component (repo name)
  # Handles both https://github.com/user/repo and git@github.com:user/repo
  basename "$url"
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -m requires a message argument" ""
      fi
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for comment" ""
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for comment" ""
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      error_exit 1 "Unknown option: $1" ""
      ;;
    *)
      # Positional argument
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Check that we have at least 1 positional argument (repo URL)
if [[ $# -lt 1 ]]; then
  error_exit 1 "Expected at least 1 argument (repo-url), got $#" ""
fi

if [[ $# -gt 2 ]]; then
  error_exit 1 "Expected at most 2 arguments (repo-url and optional directory), got $#" ""
fi

REPO_URL="$1"

# Validate repo URL
if [[ -z "$REPO_URL" ]]; then
  error_exit 1 "Repository URL cannot be empty" ""
fi

# Determine target directory
if [[ $# -eq 2 ]]; then
  TARGET_DIR="$2"
else
  TARGET_DIR=$(extract_repo_name "$REPO_URL")
fi

# Validate target directory name
if [[ -z "$TARGET_DIR" ]]; then
  error_exit 1 "Could not determine target directory name from URL: $REPO_URL" "$REPO_URL"
fi

# Check if target directory already exists
if [[ -e "$TARGET_DIR" ]]; then
  error_exit 3 "Target directory '$TARGET_DIR' already exists" "$REPO_URL"
fi

# Clone the repository
info "Cloning repository from $REPO_URL..."
if ! git clone "$REPO_URL" "$TARGET_DIR" 2>&1; then
  error_exit 2 "Failed to clone repository from $REPO_URL" "$REPO_URL"
fi

success "Repository cloned to '$TARGET_DIR'"

# Display next steps
info "Next steps:"
echo "  cd $TARGET_DIR"
echo "  mkbranch patch/your-branch main"

exit 0
