#!/usr/bin/env bash

# mkclone - Clone the BriteTest repository.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Repository configuration
REPO_URL="https://github.com/paulsinclair51/BriteTest"
REPO_NAME="BriteTest"

# Default options
COMMENT=""
TARGET_DIR=""

usage() {
  cat <<EOF
Usage:
  mkclone [OPTIONS] [directory]
  mkclone -h | --help

Clone the BriteTest repository to a local directory.

Arguments:
  [directory]        Optional target directory name
                     If not specified, uses '$REPO_NAME'
                     Examples: mkclone
                                 → Creates ./$REPO_NAME/
                               mkclone my-repo
                                 → Creates ./my-repo/

Comment Options (mutually exclusive):
  -m, --message MSG  Attach a comment to the operation
                     Usage: mkclone -m "Setup for feature work"
  -- COMMENT TEXT    Unix-style comment (everything after -- is the comment)
                     Usage: mkclone -- Setup for feature work
                     Note: No quotes needed, captures all remaining arguments

Options:
  -h, --help         Output this help to stdout and exit.
  -m, --message MSG  Add comment message (GitHub style, requires quotes if spaces)
  -- TEXT            Add comment (Unix style, everything after -- is the comment)

Examples:
  # Basic clone with default directory name
  mkclone
    → Creates ./$REPO_NAME/

  # Clone into custom directory
  mkclone my-repo
    → Creates ./my-repo/

  # With GitHub-style comment
  mkclone -m "Setup for new feature development"

  # With Unix-style comment
  mkclone work-repo -- Starting feature branch work

Exit codes:
  0   Success
  1   Argument error
  2   Git clone failed
  3   Target directory already exists
EOF
}

info() {
  echo -e "${BLUE}ℹ${NC} $1"
}

success() {
  echo -e "${GREEN}✓${NC} $1"
}

error_exit() {
  local code="$1"
  local message="$2"

  echo -e "${RED}Error:${NC} $message" >&2
  exit "$code"
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -m requires a message argument"
      fi
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for comment"
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for comment"
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      error_exit 1 "Unknown option: $1"
      ;;
    *)
      # Positional argument
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Check that we have at most 1 positional argument
if [[ $# -gt 1 ]]; then
  error_exit 1 "Expected at most 1 argument (directory), got $#"
fi

# Determine target directory
if [[ $# -eq 1 ]]; then
  TARGET_DIR="$1"
else
  TARGET_DIR="$REPO_NAME"
fi

# Validate target directory name
if [[ -z "$TARGET_DIR" ]]; then
  error_exit 1 "Target directory name cannot be empty"
fi

# Check if target directory already exists
if [[ -e "$TARGET_DIR" ]]; then
  error_exit 3 "Target directory '$TARGET_DIR' already exists"
fi

# Clone the repository
info "Cloning repository..."
if ! git clone "$REPO_URL" "$TARGET_DIR" 2>&1; then
  error_exit 2 "Failed to clone repository from $REPO_URL"
fi

success "Repository cloned successfully"

# Display repository information
info "Repository: $REPO_URL"
info "Cloned to: ./$TARGET_DIR"
info "Next steps:"
echo "  cd $TARGET_DIR"
echo "  mkbranch patch/your-branch main"

exit 0
