#!/usr/bin/env bash

# mksync - Fetch and pull latest changes from remote in BriteTest.
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default options
SYNC_ALL=false
VERBOSE=false
COMMENT=""

usage() {
  cat <<'EOF'
Usage:
  mksync [OPTIONS]
  mksync -h | --help

Fetch latest changes from remote and update the current branch.
Shows summary of changes and warns if behind main or if diverged from remote.

Features:
  - Fetches from remote
  - Pulls latest changes into current branch
  - Shows summary of what changed
  - Warns if current branch is behind main (suggests mksyncup)
  - Warns if local commits exist that aren't pushed
  - Detects diverged branches and suggests resolution

Options:
  -h, --help         Output this help to stdout and exit.
  -a, --all          Fetch all branches (default: current branch only)
  -v, --verbose      Show detailed change information
  -m, --message MSG  Add comment message (GitHub style, requires quotes if spaces)
  -- TEXT            Add comment (Unix style, everything after -- is the comment)
                     Note: No quotes needed, captures all remaining arguments

Comment Options (mutually exclusive):
  -m, --message MSG  Attach a comment to the operation
  -- COMMENT TEXT    Unix-style comment (everything after -- is the comment)

Examples:
  # Sync current branch only
  mksync

  # Sync with verbose output
  mksync -v

  # Sync all branches
  mksync -a

  # Sync with comment
  mksync -m "Getting latest before starting feature work"

  # Unix-style comment
  mksync -- Getting latest changes

Exit codes:
  0   Success
  1   Argument or validation error
  2   Git fetch or pull failed
  3   Branch diverged from remote (manual resolution needed)
EOF
}

info() {
  echo -e "${BLUE}ℹ${NC} $1"
}

success() {
  echo -e "${GREEN}✓${NC} $1"
}

warn() {
  echo -e "${YELLOW}⚠${NC} $1"
}

error_exit() {
  local code="$1"
  local message="$2"

  echo -e "${RED}Error:${NC} $message" >&2
  exit "$code"
}

get_current_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null || error_exit 1 "Failed to determine current branch"
}

check_diverged() {
  local branch="$1"
  
  # Get local and remote commit hashes
  local local_commit=$(git rev-parse "$branch" 2>/dev/null || echo "")
  local remote_commit=$(git rev-parse "origin/$branch" 2>/dev/null || echo "")
  
  if [[ -z "$local_commit" ]] || [[ -z "$remote_commit" ]]; then
    return 1
  fi
  
  # Check if branches have diverged
  local merge_base=$(git merge-base "$branch" "origin/$branch" 2>/dev/null || echo "")
  
  if [[ "$merge_base" != "$local_commit" ]] && [[ "$merge_base" != "$remote_commit" ]]; then
    return 0  # Diverged
  fi
  
  return 1  # Not diverged
}

count_unpushed_commits() {
  local branch="$1"
  
  # Count commits that are in local branch but not in origin
  git rev-list --count "origin/$branch..$branch" 2>/dev/null || echo "0"
}

count_commits_behind_main() {
  local branch="$1"
  
  # Count commits that are in main but not in current branch
  git rev-list --count "$branch..origin/main" 2>/dev/null || echo "0"
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -a | --all)
      SYNC_ALL=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -m requires a message argument"
      fi
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for comment"
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for comment"
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      error_exit 1 "Unknown option: $1"
      ;;
    *)
      error_exit 1 "Unknown argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(get_current_branch)
info "Current branch: $CURRENT_BRANCH"

# Fetch from remote
info "Fetching from remote..."
if ! git fetch origin 2>&1; then
  error_exit 2 "Failed to fetch from remote"
fi
success "Fetched successfully"

# Sync current branch
if [[ "$SYNC_ALL" == false ]]; then
  info "Pulling latest changes into $CURRENT_BRANCH..."
  
  # Check for divergence before pulling
  if check_diverged "$CURRENT_BRANCH"; then
    error_exit 3 "Branch '$CURRENT_BRANCH' has diverged from remote. Manual resolution needed. Use 'git rebase' or 'mkmerge' to resolve."
  fi
  
  # Pull changes
  if ! git pull origin "$CURRENT_BRANCH" 2>&1; then
    error_exit 2 "Failed to pull changes for $CURRENT_BRANCH"
  fi
  
  success "Updated $CURRENT_BRANCH"
  
  # Show commit count if verbose
  if [[ "$VERBOSE" == true ]]; then
    local new_commits=$(git rev-list --count "HEAD@{1}..HEAD" 2>/dev/null || echo "?")
    if [[ "$new_commits" != "?" ]]; then
      info "$new_commits new commits pulled"
    fi
  fi
else
  # Sync all branches
  info "Pulling latest changes for all branches..."
  
  local branches=$(git branch -r | grep -v HEAD | sed 's/origin\///')
  local updated_count=0
  
  for branch in $branches; do
    if git pull origin "$branch" 2>&1 >/dev/null; then
      ((updated_count++))
    fi
  done
  
  success "Updated $updated_count branches"
fi

# Check for unpushed commits in current branch
local unpushed=$(count_unpushed_commits "$CURRENT_BRANCH")
if [[ "$unpushed" -gt 0 ]]; then
  warn "Local commits not pushed: $unpushed commit(s)"
  if [[ "$VERBOSE" == true ]]; then
    git log --oneline "origin/$CURRENT_BRANCH..$CURRENT_BRANCH" 2>/dev/null | sed 's/^/  /'
  fi
fi

# Check if behind main
local behind_main=$(count_commits_behind_main "$CURRENT_BRANCH")
if [[ "$behind_main" -gt 0 ]] && [[ "$CURRENT_BRANCH" != "main" ]]; then
  warn "Your branch is $behind_main commit(s) behind main"
  info "Run: mksyncup"
fi

success "Sync complete"
exit 0
