#!/bin/bash

# mkrebase - Rebase a branch onto a different base branch.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.
#
# This script rebases a branch onto the specified new base branch,
# effectively retargeting the feature to a another branch.

set -e

if [ $# -ne 1 ]; then
    echo "Usage: mkrebase <branch> <newbasebranch>"
    echo ""
    echo "Example: Retarget a feature branch based on v2.1.0 to be"
    echo ".        targeted to the v2.2.0 branch."
    echo "  mkrebase feature-a v2.2.0"
    echo ""
    echo "Rebases the feature-a branch onto the v2.2.0 branch."
    exit 1
fi

NEW_BASE=$1
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$CURRENT_BRANCH" = "HEAD" ]; then
    echo "Error: You are in a detached HEAD state. Please checkout a branch first."
    exit 1
fi

if [ "$CURRENT_BRANCH" = "main" ]; then
    echo "Error: Cannot rebase the main branch. Please checkout a feature branch."
    exit 1
fi

# Check if current branch contains a period (e.g., v2.1.3)
if [[ "$CURRENT_BRANCH" == *"."* ]]; then
    echo "Error: Cannot rebase release branches (branches with version numbers like v2.1.3)."
    exit 1
fi

echo "Rebasing '$CURRENT_BRANCH' onto '$NEW_BASE'..."
git rebase "$NEW_BASE"

echo ""
echo "Successfully rebased '$CURRENT_BRANCH' onto '$NEW_BASE'"
echo ""
echo "To force push to remote (use with caution):"
echo "  git push origin $CURRENT_BRANCH --force-with-lease"
