#!/usr/bin/env bash

# mkbranch - Create a new branch from a base branch and optionally push to remote.
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LOG_FILE="$REPO_ROOT/logs/branch_history.md"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default options
MODE="local"  # local, remote, or validate
VALIDATE_ONLY=false

# Valid branch type prefixes
VALID_TYPES=("major" "minor" "patch" "docs")

usage() {
  cat <<'EOF'
Usage:
  mkbranch [OPTIONS] <branchname> <basebranchname>
  mkbranch -h | --help

Create a new branch from a base branch with optional remote push.

Arguments:
  <branchname>       Name of the new branch to create
                     Format: [<type>/]<description>
                     If no type prefix is specified, 'patch/' is used by default.
  <basebranchname>   Name of the base branch to create from

Branch Naming Convention:
  Branches should follow the format: <type>/<description>
  
  Types (default is 'patch' if no type specified):
    major  - Major features or changes (e.g., major/new-ui-system, major/core-refactor)
    minor  - Minor features or changes (e.g., minor/add-logging, minor/optimize-parser)
    patch  - Bug fixes (e.g., patch/fix-login-bug, patch/memory-leak)
    docs   - Documentation updates only (e.g., docs/api-guide, docs/setup-instructions)

  Naming Rules:
    - Lowercase letters, numbers, hyphens, and forward slashes only
    - No uppercase letters or special characters (except / and -)
    - Type prefix must be one of: major, minor, patch, docs
    - Description must not be empty

  Examples:
    mkbranch major/redesign-authentication main
      Creates: major/redesign-authentication
    
    mkbranch fix-login-bug main
      Creates: patch/fix-login-bug (default type)
    
    mkbranch minor/improve-performance main
      Creates: minor/improve-performance
    
    mkbranch docs/update-readme main
      Creates: docs/update-readme

Type Hierarchy:
  Branches can only be created from compatible base branch types:
    major  → from main or major/*
    minor  → from main or major/*
    patch  → from main, major/*, minor/*, or patch/*
    docs   → from main or docs/*

Options:
  -h, --help         Output this help to stdout and exit.
  -l                 Create local branch only (default).
  -r                 Create local branch and push to remote.
  -v                 Validate only: check if valid without creating branch.

Modes:
  Local (-l):
    - Verify the base branch exists
    - Check that the new branch doesn't already exist
    - Create the new branch from the base branch (adding default type if needed)
    - Log the operation to logs/branch_history.md

  Remote (-r):
    - All of the above, plus:
    - Push the new branch to the remote repository

  Validate (-v):
    - Verify the base branch exists
    - Check that the new branch doesn't already exist
    - Validate branch naming format (if type is specified, must be valid)
    - Validate type hierarchy compatibility
    - Report validity without creating or pushing
    - Exit with status code indicating validity

Exit codes:
  0   Success (or validation passed)
  1   Argument error
  2   Git operation failed
  3   Branch already exists
  4   Base branch doesn't exist
  5   Validation failed
  6   Type hierarchy violation
EOF
}

log_operation() {
  local status="$1"
  local branchname="$2"
  local basebranchname="$3"
  local message="$4"
  local timestamp

  # Create logs directory if it doesn't exist
  mkdir -p "$(dirname "$LOG_FILE")"

  # Initialize log file with header if it doesn't exist
  if [[ ! -f "$LOG_FILE" ]]; then
    cat > "$LOG_FILE" <<'HEADER'
# Branch History Log

HEADER
  fi

  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

  # Append operation to log in simplified markdown format (no bullet points)
  cat >> "$LOG_FILE" <<EOF

**$timestamp**: $message
EOF
}

error_exit() {
  local code="$1"
  local message="$2"
  local branchname="${3:-}"
  local basebranchname="${4:-}"

  echo -e "${RED}Error:${NC} $message" >&2

  if [[ -n "$branchname" ]]; then
    log_operation "FAILED" "$branchname" "$basebranchname" "Branch \`$branchname\` creation from \`$basebranchname\` failed - $message"
  fi

  exit "$code"
}

info() {
  echo -e "${BLUE}ℹ${NC} $1"
}

success() {
  echo -e "${GREEN}✓${NC} $1"
}

is_valid_type() {
  local type="$1"
  local valid
  
  for valid in "${VALID_TYPES[@]}"; do
    if [[ "$type" == "$valid" ]]; then
      return 0
    fi
  done
  
  return 1
}

is_valid_name_chars() {
  local name="$1"
  # Allow lowercase letters, numbers, hyphens, and forward slashes
  if [[ "$name" =~ ^[a-z0-9/-]+$ ]]; then
    return 0
  fi
  return 1
}

get_branch_type() {
  local branchname="$1"
  
  if [[ "$branchname" =~ / ]]; then
    echo "${branchname%%/*}"
  else
    echo ""
  fi
}

is_type_hierarchy_valid() {
  local new_type="$1"
  local base_type="$2"
  
  case "$new_type" in
    major)
      # major can only be created from main or major
      [[ "$base_type" == "" || "$base_type" == "major" ]]
      ;;
    minor)
      # minor can only be created from main or major
      [[ "$base_type" == "" || "$base_type" == "major" ]]
      ;;
    patch)
      # patch can be created from main, major, minor, or patch
      [[ "$base_type" == "" || "$base_type" == "major" || "$base_type" == "minor" || "$base_type" == "patch" ]]
      ;;
    docs)
      # docs can only be created from main or docs
      [[ "$base_type" == "" || "$base_type" == "docs" ]]
      ;;
    *)
      return 1
      ;;
  esac
}

normalize_branch_name() {
  local branchname="$1"
  
  # Validate character set
  if ! is_valid_name_chars "$branchname"; then
    return 1
  fi
  
  # Check if branch contains a slash (type/description format)
  if [[ "$branchname" =~ / ]]; then
    # Extract the type (part before the slash)
    local type="${branchname%%/*}"
    local description="${branchname#*/}"
    
    # Validate description is not empty
    if [[ -z "$description" ]]; then
      return 1
    fi
    
    # Validate the type
    if ! is_valid_type "$type"; then
      return 1
    fi
    
    # Return as-is (already has valid type)
    echo "$branchname"
  else
    # No type specified, default to patch
    echo "patch/$branchname"
  fi
  
  return 0
}

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -l)
      MODE="local"
      shift
      ;;
    -r)
      MODE="remote"
      shift
      ;;
    -v)
      MODE="validate"
      VALIDATE_ONLY=true
      shift
      ;;
    -*)
      error_exit 1 "Unknown option: $1" "" ""
      ;;
    *)
      # Positional argument
      break
      ;;
  esac
done

# Check that we have exactly 2 positional arguments
if [[ $# -ne 2 ]]; then
  error_exit 1 "Expected 2 arguments (branchname and basebranchname), got $#" "" ""
fi

BRANCHNAME="$1"
BASEBRANCHNAME="$2"

# Validate branch name format (basic validation)
if [[ -z "$BRANCHNAME" ]]; then
  error_exit 1 "Branch name cannot be empty" "$BRANCHNAME" "$BASEBRANCHNAME"
fi

if [[ -z "$BASEBRANCHNAME" ]]; then
  error_exit 1 "Base branch name cannot be empty" "$BRANCHNAME" "$BASEBRANCHNAME"
fi

# Normalize branch name (add default type if needed, validate if type specified)
NORMALIZED_NAME=$(normalize_branch_name "$BRANCHNAME")
if [[ $? -ne 0 ]]; then
  error_exit 1 "Invalid branch name '$BRANCHNAME'. Must contain only lowercase letters, numbers, hyphens, and slashes. Type must be one of: ${VALID_TYPES[*]}" "$BRANCHNAME" "$BASEBRANCHNAME"
fi

# If type was added, indicate it
if [[ "$NORMALIZED_NAME" != "$BRANCHNAME" ]]; then
  info "Branch name normalized: '$BRANCHNAME' → '$NORMALIZED_NAME' (default type: patch)"
  BRANCHNAME="$NORMALIZED_NAME"
fi

# Extract types for hierarchy validation
NEW_TYPE=$(get_branch_type "$BRANCHNAME")
BASE_TYPE=$(get_branch_type "$BASEBRANCHNAME")

# Validate type hierarchy
if ! is_type_hierarchy_valid "$NEW_TYPE" "$BASE_TYPE"; then
  error_exit 6 "Type hierarchy violation: $NEW_TYPE branches cannot be created from $BASE_TYPE branches" "$BRANCHNAME" "$BASEBRANCHNAME"
fi

# Change to repo root
cd "$REPO_ROOT"

# Determine operation description
case "$MODE" in
  local)
    info "Creating local branch '$BRANCHNAME' from base '$BASEBRANCHNAME'..."
    ;;
  remote)
    info "Creating branch '$BRANCHNAME' from base '$BASEBRANCHNAME' and pushing to remote..."
    ;;
  validate)
    info "Validating branch '$BRANCHNAME' from base '$BASEBRANCHNAME'..."
    ;;
esac

# Fetch latest refs from remote
info "Fetching latest refs from remote..."
if ! git fetch origin >/dev/null 2>&1; then
  error_exit 2 "Failed to fetch from remote" "$BRANCHNAME" "$BASEBRANCHNAME"
fi

# Check if base branch exists (check both local and remote)
if ! git rev-parse --verify "$BASEBRANCHNAME" >/dev/null 2>&1; then
  if ! git rev-parse --verify "origin/$BASEBRANCHNAME" >/dev/null 2>&1; then
    if [[ "$MODE" == "validate" ]]; then
      echo -e "${RED}✗${NC} Base branch '$BASEBRANCHNAME' does not exist"
      exit 5
    else
      error_exit 4 "Base branch '$BASEBRANCHNAME' does not exist" "$BRANCHNAME" "$BASEBRANCHNAME"
    fi
  fi
  BASEBRANCHNAME="origin/$BASEBRANCHNAME"
fi

# Check if new branch already exists (local or remote)
if git rev-parse --verify "$BRANCHNAME" >/dev/null 2>&1; then
  if [[ "$MODE" == "validate" ]]; then
    echo -e "${RED}✗${NC} Branch '$BRANCHNAME' already exists locally"
    exit 5
  else
    error_exit 3 "Branch '$BRANCHNAME' already exists locally" "$BRANCHNAME" "$BASEBRANCHNAME"
  fi
fi

if git rev-parse --verify "origin/$BRANCHNAME" >/dev/null 2>&1; then
  if [[ "$MODE" == "validate" ]]; then
    echo -e "${RED}✗${NC} Branch '$BRANCHNAME' already exists on remote"
    exit 5
  else
    error_exit 3 "Branch '$BRANCHNAME' already exists on remote" "$BRANCHNAME" "$BASEBRANCHNAME"
  fi
fi

# If validate mode, we're done (all checks passed)
if [[ "$MODE" == "validate" ]]; then
  success "Branch '$BRANCHNAME' can be created from '$BASEBRANCHNAME'"
  exit 0
fi

# Create the branch
info "Creating local branch from '$BASEBRANCHNAME'..."
if ! git checkout -b "$BRANCHNAME" "$BASEBRANCHNAME" >/dev/null 2>&1; then
  error_exit 2 "Failed to create branch '$BRANCHNAME'" "$BRANCHNAME" "$BASEBRANCHNAME"
fi

success "Local branch '$BRANCHNAME' created"

# Push to remote if in remote mode
if [[ "$MODE" == "remote" ]]; then
  info "Pushing branch to remote..."
  if ! git push -u origin "$BRANCHNAME" >/dev/null 2>&1; then
    # Clean up local branch on failure
    git checkout - >/dev/null 2>&1 || true
    git branch -D "$BRANCHNAME" >/dev/null 2>&1 || true
    error_exit 2 "Failed to push branch to remote" "$BRANCHNAME" "$BASEBRANCHNAME"
  fi
  success "Branch '$BRANCHNAME' pushed to remote"
  log_operation "SUCCESS" "$BRANCHNAME" "$BASEBRANCHNAME" "Branch \`$BRANCHNAME\` created from \`$BASEBRANCHNAME\` and pushed to remote."
else
  log_operation "SUCCESS" "$BRANCHNAME" "$BASEBRANCHNAME" "Branch \`$BRANCHNAME\` created from \`$BASEBRANCHNAME\`."
fi

exit 0
