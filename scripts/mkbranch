#!/usr/bin/env bash

# mkbranch - Create a new branch from a base branch and optionally push to remote.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LOG_FILE="$REPO_ROOT/logs/branch_history.md"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default options
MODE="local"  # local, remote, or validate
VALIDATE_ONLY=false
COMMENT=""

# Valid branch type prefixes
VALID_TYPES=("major" "minor" "patch")

usage() {
  cat <<'EOF'
Usage:
  mkbranch [OPTIONS] <newbranch> <basebranch> [COMMENT]
  mkbranch -h | --help

Create a new branch from a base branch with optional remote push and comment.

Arguments:
  <newbranch>        Name of the new branch to create.
  <basebranch>       Name of the base branch from which to create the new branch.

  If the base branch is main, the user must be an approver (see 
  docs/Contributor_Guide.md) and the new branch is remote and must have one of
  the following forms where <M>, <m>, and <p> must be one or 2 digits (first
  digit must not be 0):
    - v<M>.0.0 (<M> must be such there is a v<M-1>.0.0 branch or release).
    - v<M>.<m>.0 (<m> must be such that there is a v<M>.0.0 branch/release
      and <m> is 1 or there is a v<M>.<m-1>.0 branch/release).
    - vM.m.p (<p> must be such that there is a v<M>.<m>.0 branch/release
      and <p> is 1 or there is v<M>.<m>.<p-1> branch/release).

  If the base branch is not main, the user must be a contributor (see 
  docs/Contributor_Guide.md) the new branch may be local or remote and
  must be a valid GitHub branch name except the name may not include a period.

  Example: Create a feature branch targeted to a major release.
    mkbranch redesign-authentication v2.0.0
       
  Example: Create a performance improvement branch targeted to a minor release.
    mkbranch improve-performance v1.1.0

  Example: Create a branch for a patch targeted to patch release.
    mkbranch fix-login-bug v1.0.2

Options:
  -h, --help        Output this help to stdout and exit.
  -l                Create local branch only (default if base branch is not main).
  -r                Create local branch and push to remote (default if base branch is main).
  -v                Validate only without creating branch.
  -m "MSG"          Attach a commit message/comment to the operation
                    Usage: mkbranch feature-a v2.0.0 -m "Implement new feature a."
  --message "MSG"   Attach a commit message/comment to the operation
                    Usage: mkbranch patch/fix-bug major --message "Fix critical memory leak."
  -- MSG            Attach commit message/comment (everything after -- is the comment)
                    Usage: mkbranch patch/fix-bug major -- Fix critical memory leak
                    Note: No quotes needed, captures all remaining arguments.

   Note: -m "MSG", --message "MSG", -- MSG are mutually exclusive.

Modes:
  Local (-l):
     - -r is not specified.
    - Verify the base branch exists locally or remotely.
    - Check that the new branch doesn't already exist locally.
    - Create the new branch from the base branch.
    - Log the operation to 'logs/local_branch_history.md'.

  Remote (-r):
    - -l is not specified.
    - Verify that the base branch exists remotely.
    - Check that the new branch doesn't already exist locally or remotely.
    - Create the new branch from the base branch.
    - Push the new branch to the remote repository.
    - Log the operation to 'logs/branch_history.md'.

  Validate (-v):
    - Verify the base branch exists.
    - Check that the new branch doesn't already exist.
    - Validate branch name.
    - Report validity without creating or pushing.
    - Exit with status code indicating validity.

Examples: Basic usage.
  mkbranch fix-bug v2.1.1
  mkbranch -r feature-a v2.0.0

Examples: With GitHub-style comment.
  mkbranch fix-bug v1.1.5 -m "Fix critical memory leak."
  mkbranch -r feature-b v2.3.0 -m "Add minor new dashboard feature."

Examples:  With Unix-style comment.
  mkbranch fix-bug v1.1.5 -- Fix critical memory leak.
  mkbranch -r feature-b v2.3.0 -- Add minor new dashboard feature.

Examples: Validation mode for invalid mkbranch.
  mkbranch -v redesign main
  mkbranch -v -r hotfix v2.0.0

Exit codes:
  0   Success (or validation passed).
  1   Arguments/options invalid.
  2   Invalid branch name.
  3   Invalid option.
  4   Conflicting options.
  5   Git operation failed.
  6   Branch already exists.
  7   Base branch doesn't exist.
  9   Validation failed.
EOF
}

log_operation() {
  local status="$1"
  local branchname="$2"
  local basebranchname="$3"
  local message="$4"
  local comment="${5:-}"
  local timestamp

  # Create logs directory if it doesn't exist
  mkdir -p "$(dirname "$LOG_FILE")"

  # Initialize log file with header if it doesn't exist
  if [[ ! -f "$LOG_FILE" ]]; then
    cat > "$LOG_FILE" <<'HEADER'
# Branch History Log

HEADER
  fi

  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

  # Append operation to log
  if [[ -n "$comment" ]]; then
    cat >> "$LOG_FILE" <<EOF

**$timestamp**: $message
  $comment
EOF
  else
    cat >> "$LOG_FILE" <<EOF

**$timestamp**: $message
EOF
  fi
}

error_exit() {
  local code="$1"
  local message="$2"
  local branchname="${3:-}"
  local basebranchname="${4:-}"
  local comment="${5:-}"

  echo -e "${RED}Error:${NC} $message" >&2

  if [[ -n "$branchname" ]]; then
    log_operation "FAILED" "$branchname" "$basebranchname" "Branch \`$branchname\` creation from \`$basebranchname\` failed - $message" "$comment"
  fi

  exit "$code"
}

info() {
  echo -e "${BLUE}ℹ${NC} $1"
}

success() {
  echo -e "${GREEN}✓${NC} $1"
}

is_valid_type() {
  local type="$1"
  local valid
  
  for valid in "${VALID_TYPES[@]}"; do
    if [[ "$type" == "$valid" ]]; then
      return 0
    fi
  done
  
  return 1
}

is_valid_name_chars() {
  local name="$1"
  # Allow lowercase letters, numbers, hyphens, and forward slashes
  if [[ "$name" =~ ^[a-z0-9/-]+$ ]]; then
    return 0
  fi
  return 1
}

get_branch_type() {
  local branchname="$1"
  
  if [[ "$branchname" =~ / ]]; then
    echo "${branchname%%/*}"
  else
    echo ""
  fi
}

is_type_hierarchy_valid() {
  local new_type="$1"
  local base_type="$2"
  
  case "$new_type" in
    major)
      # major can only be created from main or major
      [[ "$base_type" == "" || "$base_type" == "major" ]]
      ;;
    minor)
      # minor can only be created from main or major
      [[ "$base_type" == "" || "$base_type" == "major" ]]
      ;;
    patch)
      # patch can be created from main, major, minor, or patch
      [[ "$base_type" == "" || "$base_type" == "major" || "$base_type" == "minor" || "$base_type" == "patch" ]]
      ;;
    docs)
      # docs can be created from main, major, minor, patch, or docs
      [[ "$base_type" == "" || "$base_type" == "major" || "$base_type" == "minor" || "$base_type" == "patch" || "$base_type" == "docs" ]]
      ;;
    *)
      return 1
      ;;
  esac
}

normalize_branch_name() {
  local branchname="$1"
  
  # Validate character set
  if ! is_valid_name_chars "$branchname"; then
    return 1
  fi
  
  # Check if branch contains a slash (type/description format)
  if [[ "$branchname" =~ / ]]; then
    # Extract the type (part before the slash)
    local type="${branchname%%/*}"
    local description="${branchname#*/}"
    
    # Validate description is not empty
    if [[ -z "$description" ]]; then
      return 1
    fi
    
    # Validate the type
    if ! is_valid_type "$type"; then
      return 1
    fi
    
    # Return as-is (already has valid type)
    echo "$branchname"
  else
    # No type specified, default to patch
    echo "patch/$branchname"
  fi
  
  return 0
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -l)
      MODE="local"
      shift
      ;;
    -r)
      MODE="remote"
      shift
      ;;
    -v)
      MODE="validate"
      VALIDATE_ONLY=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -m requires a message argument" "" "" ""
      fi
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for comment" "" "" ""
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for comment" "" "" ""
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      error_exit 1 "Unknown option: $1" "" "" ""
      ;;
    *)
      # Positional argument
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Check that we have exactly 2 positional arguments
if [[ $# -ne 2 ]]; then
  error_exit 1 "Expected 2 arguments (branchname and basebranchname), got $#" "" "" ""
fi

BRANCHNAME="$1"
BASEBRANCHNAME="$2"

# Validate branch name format (basic validation)
if [[ -z "$BRANCHNAME" ]]; then
  error_exit 1 "Branch name cannot be empty" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
fi

if [[ -z "$BASEBRANCHNAME" ]]; then
  error_exit 1 "Base branch name cannot be empty" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
fi

# Normalize branch name (add default type if needed, validate if type specified)
NORMALIZED_NAME=$(normalize_branch_name "$BRANCHNAME")
if [[ $? -ne 0 ]]; then
  error_exit 1 "Invalid branch name '$BRANCHNAME'. Must contain only lowercase letters, numbers, hyphens, and slashes. Type must be one of: ${VALID_TYPES[*]}" "$BRANCHNAME" "$BASEBRANCHNAME" "" "[...]
fi

# If type was added, indicate it
if [[ "$NORMALIZED_NAME" != "$BRANCHNAME" ]]; then
  info "Branch name normalized: '$BRANCHNAME' → '$NORMALIZED_NAME' (default type: patch)"
  BRANCHNAME="$NORMALIZED_NAME"
fi

# Extract types for hierarchy validation
NEW_TYPE=$(get_branch_type "$BRANCHNAME")
BASE_TYPE=$(get_branch_type "$BASEBRANCHNAME")

# Validate type hierarchy
if ! is_type_hierarchy_valid "$NEW_TYPE" "$BASE_TYPE"; then
  error_exit 6 "Type hierarchy violation: $NEW_TYPE branches cannot be created from $BASE_TYPE branches" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
fi

# Change to repo root
cd "$REPO_ROOT"

# Determine operation description
case "$MODE" in
  local)
    info "Creating local branch '$BRANCHNAME' from base '$BASEBRANCHNAME'..."
    ;;
  remote)
    info "Creating branch '$BRANCHNAME' from base '$BASEBRANCHNAME' and pushing to remote..."
    ;;
  validate)
    info "Validating branch '$BRANCHNAME' from base '$BASEBRANCHNAME'..."
    ;;
esac

# Fetch latest refs from remote
info "Fetching latest refs from remote..."
if ! git fetch origin >/dev/null 2>&1; then
  error_exit 2 "Failed to fetch from remote" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
fi

# Check if base branch exists (check both local and remote)
if ! git rev-parse --verify "$BASEBRANCHNAME" >/dev/null 2>&1; then
  if ! git rev-parse --verify "origin/$BASEBRANCHNAME" >/dev/null 2>&1; then
    if [[ "$MODE" == "validate" ]]; then
      echo -e "${RED}✗${NC} Base branch '$BASEBRANCHNAME' does not exist"
      exit 5
    else
      error_exit 4 "Base branch '$BASEBRANCHNAME' does not exist" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
    fi
  fi
  BASEBRANCHNAME="origin/$BASEBRANCHNAME"
fi

# Check if new branch already exists (local or remote)
if git rev-parse --verify "$BRANCHNAME" >/dev/null 2>&1; then
  if [[ "$MODE" == "validate" ]]; then
    echo -e "${RED}✗${NC} Branch '$BRANCHNAME' already exists locally"
    exit 5
  else
    error_exit 3 "Branch '$BRANCHNAME' already exists locally" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
  fi
fi

if git rev-parse --verify "origin/$BRANCHNAME" >/dev/null 2>&1; then
  if [[ "$MODE" == "validate" ]]; then
    echo -e "${RED}✗${NC} Branch '$BRANCHNAME' already exists on remote"
    exit 5
  else
    error_exit 3 "Branch '$BRANCHNAME' already exists on remote" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
  fi
fi

# If validate mode, we're done (all checks passed)
if [[ "$MODE" == "validate" ]]; then
  success "Branch '$BRANCHNAME' can be created from '$BASEBRANCHNAME'"
  exit 0
fi

# Create the branch
info "Creating local branch from '$BASEBRANCHNAME'..."
if ! git checkout -b "$BRANCHNAME" "$BASEBRANCHNAME" >/dev/null 2>&1; then
  error_exit 2 "Failed to create branch '$BRANCHNAME'" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
fi

success "Local branch '$BRANCHNAME' created"

# Push to remote if in remote mode
if [[ "$MODE" == "remote" ]]; then
  info "Pushing branch to remote..."
  if ! git push -u origin "$BRANCHNAME" >/dev/null 2>&1; then
    # Clean up local branch on failure
    git checkout - >/dev/null 2>&1 || true
    git branch -D "$BRANCHNAME" >/dev/null 2>&1 || true
    error_exit 2 "Failed to push branch to remote" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
  fi
  success "Branch '$BRANCHNAME' pushed to remote"
  log_operation "SUCCESS" "$BRANCHNAME" "$BASEBRANCHNAME" "Branch \`$BRANCHNAME\` created from \`$BASEBRANCHNAME\` and pushed to remote." "$COMMENT"
else
  log_operation "SUCCESS" "$BRANCHNAME" "$BASEBRANCHNAME" "Branch \`$BRANCHNAME\` created from \`$BASEBRANCHNAME\`." "$COMMENT"
fi

exit 0
