#!/usr/bin/env bash

# mkfeedback - Handle and respond to PR review feedback.
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default options
VERBOSE=false
ACTION=""
COMMENT=""

usage() {
  cat <<'EOF'
Usage:
  mkfeedback [ACTION] [OPTIONS]
  mkfeedback -h | --help

Handle and respond to pull request review feedback.

This script guides you through addressing reviewer comments and maintaining
communication during the PR review cycle. It helps coordinate feedback,
track changes, and update your PR accordingly.

Actions:
  view      Show all feedback/comments on current PR
  update    Commit fixes to address feedback
  respond   Add a response comment to PR
  sync      Sync changes and push to PR
  resolve   Mark feedback as resolved

Features:
  - Fetch and display PR review comments
  - Track feedback from reviewers
  - Help structure response commits
  - Sync local changes to remote PR
  - Document how feedback was addressed
  - Coordinate with multiple reviewers

Options:
  -h, --help           Output this help to stdout and exit.
  -v, --verbose        Show detailed information
  -m, --message MSG    Add comment message (GitHub style)
  -- TEXT              Unix-style comment (everything after --)
  -c, --comment ID     Reference specific comment to address

Workflow:

  1. View feedback:
     mkfeedback view

  2. Make changes locally to address feedback:
     # Edit files
     git add .

  3. Commit changes with reference to feedback:
     mkfeedback update -m "Address reviewer feedback on auth logic"

  4. Push to PR:
     mkfeedback sync

  5. Respond to reviewer:
     mkfeedback respond -m "Fixed as requested, auth now validates tokens properly"

Examples:

  # Show all comments on current PR
  mkfeedback view

  # Show all comments with verbose detail
  mkfeedback view -v

  # Commit fixes for feedback
  mkfeedback update -m "Add null-check in parser as requested"

  # Push updates to PR
  mkfeedback sync

  # Add response to PR
  mkfeedback respond -m "Updated error handling as discussed"

  # Mark feedback resolved
  mkfeedback resolve -c comment-id

Workflow Scenarios:

  Scenario 1: Small changes requested
  ---------------------------------
  mkfeedback view              # See what's requested
  # Edit files...
  mkfeedback update -m "Fix parameter validation"
  mkfeedback sync              # Push changes

  Scenario 2: Multiple reviewers with different feedback
  -------------------------------------------------------
  mkfeedback view -v           # See all comments with context
  # Address feedback from reviewer 1
  mkfeedback update -m "Fix race condition in worker thread"
  # Address feedback from reviewer 2
  mkfeedback update -m "Add error handling for edge case"
  mkfeedback sync              # Push all fixes together

  Scenario 3: Request clarification
  ----------------------------------
  mkfeedback view              # See feedback
  mkfeedback respond -m "Question: Should this handle null input?"
  # Wait for clarification
  mkfeedback view              # Check for response
  # Make changes based on clarification
  mkfeedback update
  mkfeedback sync

  Scenario 4: Disagreement with feedback
  ----------------------------------------
  mkfeedback view              # See feedback
  mkfeedback respond -m "This approach is intentional because X. Alternative would be Y."
  # If reviewer agrees, continue
  # If reviewer insists, make the change
  mkfeedback update -m "Changed approach per reviewer request"
  mkfeedback sync

Remote Workflow (Codespaces, SSH, etc.):

  When working in Codespaces or remote environments:
  - Use `mkfeedback view` to see feedback without browser
  - Use `mkfeedback update` to organize your commits
  - Use `mkfeedback respond` to communicate feedback resolutions
  - Use `mkfeedback sync` to push changes from remote environment

Exit codes:
  0   Success
  1   Argument or validation error
  2   Failed to fetch PR feedback
  3   No PR associated with current branch
  4   GitHub API error
EOF
}

info() {
  echo -e "${BLUE}ℹ${NC} $1"
}

success() {
  echo -e "${GREEN}✓${NC} $1"
}

warn() {
  echo -e "${YELLOW}⚠${NC} $1"
}

error_exit() {
  local code="$1"
  local message="$2"

  echo -e "${RED}Error:${NC} $message" >&2
  exit "$code"
}

get_current_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null || error_exit 3 "Failed to determine current branch"
}

get_pr_number() {
  local branch="$1"
  
  # Try to find PR for this branch
  # In real implementation, would use GitHub API or gh cli
  if command -v gh &> /dev/null; then
    gh pr view --json number -q .number 2>/dev/null || echo ""
  else
    echo ""
  fi
}

view_feedback() {
  local branch
  local pr_number
  
  branch=$(get_current_branch)
  info "Current branch: $branch"
  
  if command -v gh &> /dev/null; then
    pr_number=$(get_pr_number "$branch")
    
    if [[ -z "$pr_number" ]]; then
      error_exit 3 "No PR found for branch '$branch'. Create a PR first using mkpr."
    fi
    
    info "Fetching reviews for PR #$pr_number..."
    
    if [[ "$VERBOSE" == true ]]; then
      gh pr view "$pr_number" --comments
    else
      gh pr view "$pr_number"
    fi
    
    success "Done"
  else
    error_exit 4 "GitHub CLI (gh) not installed. Install gh to use mkfeedback."
  fi
}

update_for_feedback() {
  local branch
  
  branch=$(get_current_branch)
  info "Current branch: $branch"
  
  if [[ -z "$COMMENT" ]]; then
    error_exit 1 "Message required. Use -m or -- to provide commit message."
  fi
  
  info "Staging changes..."
  if ! git add . 2>&1; then
    error_exit 2 "Failed to stage changes"
  fi
  
  # Check if there are changes to commit
  if ! git diff --cached --quiet; then
    info "Committing feedback fixes..."
    if ! git commit -m "$COMMENT" 2>&1; then
      error_exit 2 "Failed to commit changes"
    fi
    success "Changes committed: $COMMENT"
  else
    warn "No staged changes to commit"
  fi
}

sync_to_pr() {
  local branch
  
  branch=$(get_current_branch)
  info "Current branch: $branch"
  
  info "Pushing changes to remote..."
  if ! git push origin "$branch" 2>&1; then
    error_exit 2 "Failed to push changes"
  fi
  
  success "Changes pushed to PR"
  
  if command -v gh &> /dev/null; then
    info "PR updated and ready for review"
  fi
}

respond_to_feedback() {
  local branch
  local pr_number
  
  branch=$(get_current_branch)
  
  if command -v gh &> /dev/null; then
    pr_number=$(get_pr_number "$branch")
    
    if [[ -z "$pr_number" ]]; then
      error_exit 3 "No PR found for branch '$branch'."
    fi
    
    if [[ -z "$COMMENT" ]]; then
      error_exit 1 "Comment required. Use -m or -- to provide response."
    fi
    
    info "Adding comment to PR #$pr_number..."
    if ! gh pr comment "$pr_number" -b "$COMMENT" 2>&1; then
      error_exit 4 "Failed to add comment to PR"
    fi
    
    success "Comment added to PR"
  else
    error_exit 4 "GitHub CLI (gh) not installed."
  fi
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -m requires a message argument"
      fi
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for message"
      fi
      COMMENT="$2"
      shift 2
      ;;
    -c | --comment)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -c requires a comment ID"
      fi
      shift 2
      ;;
    --)
      # Unix-style message
      shift
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for message"
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      error_exit 1 "Unknown option: $1"
      ;;
    *)
      if [[ -z "$ACTION" ]]; then
        ACTION="$1"
        shift
      else
        error_exit 1 "Unexpected argument: $1"
      fi
      ;;
  esac
done

# Validate action
if [[ -z "$ACTION" ]]; then
  error_exit 1 "ACTION required (view, update, respond, sync, or resolve)"
fi

# Dispatch to appropriate function
case "$ACTION" in
  view)
    view_feedback
    ;;
  update)
    update_for_feedback
    ;;
  sync)
    sync_to_pr
    ;;
  respond)
    respond_to_feedback
    ;;
  resolve)
    success "Feedback resolved (manual action needed in GitHub)"
    ;;
  *)
    error_exit 1 "Unknown action: $ACTION (valid: view, update, respond, sync, resolve)"
    ;;
esac

exit 0
