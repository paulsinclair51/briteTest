#!/usr/bin/env bash

# rmbranch - Remove a branch locally and/or from remote.
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LOG_FILE="$REPO_ROOT/logs/branch_history.md"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default options
MODE="local"  # local, remote, or both
FORCE=false
COMMENT=""

# Protected branches that cannot be deleted
PROTECTED_BRANCHES=("main")

usage() {
  cat <<'EOF'
Usage:
  rmbranch [OPTIONS] <branchname> [-- MSG]
  rmbranch -h | --help

Remove a branch locally and/or from remote.

Arguments:
  <branchname>       Name of the branch to remove.
                     Examples: fix-bug, add-feature, refactor.

Protected branches):
  - main cannot be deleted.
  - Branches where name includes one or more periods can only be deleted
    by an approver (see docs/Contributor_Guide_md)

Options:
  -h, --help         Output this help to stdout and exit.
  -l                 Remove local branch only (default).
  -r                 Remove branch from remote only.
  -a                 Remove from both local and remote.
  -f                 Force removal (no confirmation prompt).
  -m "MSG"           Attach a commit message/comment to the operation.
                     Usage: rmbranch patch/old-fix -m "Reverted in favor of better approach.".
  --message "MSG"    Attach a commit message/comment to the operation.
                     Usage: rmbranch old-fix --message "Reverted in favor of better approach."
  -- MSG             Attach a commit message/comment (everything after -- is the comment)
                     Usage: rmbranch old-fix -- Reverted in favor of better approach.
                     Note: No quotes needed, captures all remaining text.

Modes:
  Local (-l, default):
    - Delete the local branch.
    - Log the operation to 'logs/local_branch_history.md'.

  Remote (-r):
    - Delete the branch from remote only.
    - Log the operation to 'logs/branch_history.md'.

  Both (-a):
    - Delete the local branch.
    - Delete the branch from remote.
    - Log the operation to 'logs/branch_history.md' and 'logs/local_branch_history.md'

Examples: Basic usage.
  rmbranch old-fix
  rmbranch -r experiment
  rmbranch -a -f temp-feature

Examples: With GitHub-style comment.
  rmbranch old-fix -m "Reverted in favor of better approach."
  rmbranch -r experiment -m "Experiment failed."

Exanples: With Unix-style comment.
  rmbranch old-fix -- Reverted in favor of better approach.
  rmbranch -r experiment -- Experiment failed.

Examples: Force removal with comment.
  rmbranch -f temp -m "Temporary testing branch."
  rmbranch -a -f old -- Cleanup old feature branch.

Exit codes:
  0   Success
  1   Argument error
  2   Git operation failed
  3   Branch does not exist
  4   Branch is protected (cannot delete)
  5   Operation cancelled
  6   Type mismatch (specified type does not match actual branch)
EOF
}

log_operation() {
  local status="$1"
  local branchname="$2"
  local message="$3"
  local comment="${4:-}"
  local timestamp

  # Create logs directory if it doesn't exist
  mkdir -p "$(dirname "$LOG_FILE")"

  # Initialize log file with header if it doesn't exist
  if [[ ! -f "$LOG_FILE" ]]; then
    cat > "$LOG_FILE" <<'HEADER'
# Branch History Log

HEADER
  fi

  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

  # Append operation to log
  if [[ -n "$comment" ]]; then
    cat >> "$LOG_FILE" <<EOF

**$timestamp**: $message
  $comment
EOF
  else
    cat >> "$LOG_FILE" <<EOF

**$timestamp**: $message
EOF
  fi
}

error_exit() {
  local code="$1"
  local message="$2"
  local branchname="${3:-}"
  local comment="${4:-}"

  echo -e "${RED}Error:${NC} $message" >&2

  if [[ -n "$branchname" ]]; then
    log_operation "FAILED" "$branchname" "Branch \`$branchname\` deletion failed - $message" "$comment"
  fi

  exit "$code"
}

info() {
  echo -e "${BLUE}ℹ${NC} $1"
}

success() {
  echo -e "${GREEN}✓${NC} $1"
}

warn() {
  echo -e "${YELLOW}⚠${NC} $1"
}

is_protected_branch() {
  local branch="$1"
  local protected
  
  for protected in "${PROTECTED_BRANCHES[@]}"; do
    if [[ "$branch" == "$protected" ]]; then
      return 0
    fi
  done
  return 1
}

is_valid_type() {
  local type="$1"
  local valid
  
  for valid in "${VALID_TYPES[@]}"; do
    if [[ "$type" == "$valid" ]]; then
      return 0
    fi
  done
  
  return 1
}

confirm_deletion() {
  local branch="$1"
  local mode="$2"
  
  if [[ "$FORCE" == true ]]; then
    return 0
  fi

  local prompt_msg="Are you sure you want to delete branch '$branch' ($mode)? (y/N) "
  local response
  
  read -p "$prompt_msg" response
  
  case "$response" in
    [yY])
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -l)
      MODE="local"
      shift
      ;;
    -r)
      MODE="remote"
      shift
      ;;
    -a)
      MODE="both"
      shift
      ;;
    -f)
      FORCE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -m requires a message argument" "" ""
      fi
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for comment" "" ""
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        error_exit 1 "Cannot use both -m and -- for comment" "" ""
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      error_exit 1 "Unknown option: $1" "" ""
      ;;
    *)
      # Positional argument
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Check that we have exactly 1 positional argument
if [[ $# -ne 1 ]]; then
  error_exit 1 "Expected 1 argument (branchname), got $#" ""
fi

BRANCHNAME="$1"

# Validate branch name
if [[ -z "$BRANCHNAME" ]]; then
  error_exit 1 "Branch name cannot be empty" ""
fi

# Check if a type was specified
TYPE_SPECIFIED=false
SPECIFIED_TYPE=""

if [[ "$BRANCHNAME" =~ / ]]; then
  TYPE_SPECIFIED=true
  SPECIFIED_TYPE="${BRANCHNAME%%/*}"
  
  # Validate the specified type
  if ! is_valid_type "$SPECIFIED_TYPE"; then
    error_exit 1 "Invalid branch type '$SPECIFIED_TYPE'. Valid types: ${VALID_TYPES[*]}" "$BRANCHNAME" "$COMMENT"
  fi
fi

# Check if branch is protected
if is_protected_branch "$BRANCHNAME"; then
  error_exit 4 "Branch '$BRANCHNAME' is protected and cannot be deleted" "$BRANCHNAME" "$COMMENT"
fi

# Change to repo root
cd "$REPO_ROOT"

# Determine operation description
case "$MODE" in
  local)
    info "Removing local branch '$BRANCHNAME'..."
    MODE_DESC="local"
    ;;
  remote)
    info "Removing branch '$BRANCHNAME' from remote..."
    MODE_DESC="remote"
    ;;
  both)
    info "Removing branch '$BRANCHNAME' from local and remote..."
    MODE_DESC="local and remote"
    ;;
esac

# Fetch latest refs from remote
if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  info "Fetching latest refs from remote..."
  if ! git fetch origin >/dev/null 2>&1; then
    error_exit 2 "Failed to fetch from remote" "$BRANCHNAME" "$COMMENT"
  fi
fi

# Check if branch exists (local or remote)
LOCAL_EXISTS=false
REMOTE_EXISTS=false

if git rev-parse --verify "$BRANCHNAME" >/dev/null 2>&1; then
  LOCAL_EXISTS=true
fi

if git rev-parse --verify "origin/$BRANCHNAME" >/dev/null 2>&1; then
  REMOTE_EXISTS=true
fi

# Verify branch exists in the requested mode
if [[ "$MODE" == "local" && "$LOCAL_EXISTS" == false ]]; then
  error_exit 3 "Local branch '$BRANCHNAME' does not exist" "$BRANCHNAME" "$COMMENT"
elif [[ "$MODE" == "remote" && "$REMOTE_EXISTS" == false ]]; then
  error_exit 3 "Remote branch '$BRANCHNAME' does not exist" "$BRANCHNAME" "$COMMENT"
elif [[ "$MODE" == "both" && "$LOCAL_EXISTS" == false && "$REMOTE_EXISTS" == false ]]; then
  error_exit 3 "Branch '$BRANCHNAME' does not exist locally or remotely" "$BRANCHNAME" "$COMMENT"
fi

# If type was specified, validate that the branch actually has that type
if [[ "$TYPE_SPECIFIED" == true ]]; then
  info "Validating branch type matches '$SPECIFIED_TYPE'..."
  # Branch name is already formatted correctly, just confirm it exists
  info "Type validation: branch '$BRANCHNAME' matches specified type '$SPECIFIED_TYPE'"
fi

# Get confirmation from user
if ! confirm_deletion "$BRANCHNAME" "$MODE_DESC"; then
  info "Branch deletion cancelled"
  exit 5
fi

# Delete local branch if needed
if [[ "$MODE" == "local" || "$MODE" == "both" ]]; then
  if [[ "$LOCAL_EXISTS" == true ]]; then
    info "Deleting local branch..."
    
    # Check if we're currently on the branch
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$CURRENT_BRANCH" == "$BRANCHNAME" ]]; then
      info "Switching to main branch..."
      if ! git checkout main >/dev/null 2>&1; then
        # Try master if main doesn't exist
        if ! git checkout master >/dev/null 2>&1; then
          error_exit 2 "Failed to switch away from branch '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
        fi
      fi
    fi
    
    if ! git branch -d "$BRANCHNAME" >/dev/null 2>&1; then
      # Try force delete with -D
      warn "Local branch has unmerged commits, forcing deletion..."
      if ! git branch -D "$BRANCHNAME" >/dev/null 2>&1; then
        error_exit 2 "Failed to delete local branch '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
      fi
    fi
    
    success "Local branch '$BRANCHNAME' deleted"
  fi
fi

# Delete remote branch if needed
if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  if [[ "$REMOTE_EXISTS" == true ]]; then
    info "Deleting remote branch..."
    if ! git push origin --delete "$BRANCHNAME" >/dev/null 2>&1; then
      error_exit 2 "Failed to delete remote branch '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
    fi
    
    success "Remote branch '$BRANCHNAME' deleted"
  fi
fi

# Log successful operation
log_operation "SUCCESS" "$BRANCHNAME" "Branch \`$BRANCHNAME\` deleted." "$COMMENT"

success "Branch '$BRANCHNAME' successfully removed"

exit 0
