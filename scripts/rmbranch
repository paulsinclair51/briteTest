#!/usr/bin/env bash

# rmbranch - Remove a branch locally and/or from remote.
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LOG_FILE="$REPO_ROOT/logs/branch_history.md"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default options
MODE="local"  # local, remote, or both
FORCE=false

# Protected branches that cannot be deleted
PROTECTED_BRANCHES=("main" "master" "develop" "development")

# Valid branch type prefixes
VALID_TYPES=("major" "minor" "patch" "docs")

usage() {
  cat <<'EOF'
Usage:
  rmbranch [OPTIONS] <branchname>
  rmbranch -h | --help

Remove a branch locally and/or from remote.

Arguments:
  <branchname>       Name of the branch to remove
                     Format: [<type>/]<description>
                     Examples: patch/fix-bug, minor/add-feature, major/refactor, docs/api-guide

Branch Naming Convention:
  Branches typically follow the format: <type>/<description>
  
  Valid types:
    major  - Major features or changes (e.g., major/new-ui-system, major/core-refactor)
    minor  - Minor features or changes (e.g., minor/add-logging, minor/optimize-parser)
    patch  - Bug fixes (e.g., patch/fix-login-bug, patch/memory-leak)
    docs   - Documentation updates only (e.g., docs/api-guide, docs/setup-instructions)

  Type validation (only if type is specified):
    - If you specify a type (e.g., 'patch/fix-bug'), the actual branch must have that exact type.
    - If no type is specified (e.g., 'fix-bug'), no type validation is performed.
    - Example: rmbranch patch/fix-bug will only delete if a branch named 'patch/fix-bug' exists.

Protected branches (cannot be deleted):
  - main
  - master
  - develop
  - development

Options:
  -h, --help         Output this help to stdout and exit.
  -l                 Remove local branch only (default).
  -r                 Remove branch from remote only.
  -a                 Remove from both local and remote.
  -f                 Force removal (no confirmation prompt).

Modes:
  Local (-l, default):
    - Delete the local branch
    - Log the operation to logs/branch_history.md

  Remote (-r):
    - Delete the branch from remote only
    - Log the operation to logs/branch_history.md

  Both (-a):
    - Delete the local branch
    - Delete the branch from remote
    - Log the operation to logs/branch_history.md

Exit codes:
  0   Success
  1   Argument error
  2   Git operation failed
  3   Branch does not exist
  4   Branch is protected (cannot delete)
  5   Operation cancelled
  6   Type mismatch (specified type does not match actual branch)
EOF
}

log_operation() {
  local status="$1"
  local branchname="$2"
  local message="$3"
  local timestamp

  # Create logs directory if it doesn't exist
  mkdir -p "$(dirname "$LOG_FILE")"

  # Initialize log file with header if it doesn't exist
  if [[ ! -f "$LOG_FILE" ]]; then
    cat > "$LOG_FILE" <<'HEADER'
# Branch History Log

Log of branch creation and deletion operations.

## Operations

HEADER
  fi

  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

  # Append operation to log
  cat >> "$LOG_FILE" <<EOF
- **$timestamp** | Status: \`$status\` | Branch: \`$branchname\` | $message
EOF
}

error_exit() {
  local code="$1"
  local message="$2"
  local branchname="${3:-}"

  echo -e "${RED}Error:${NC} $message" >&2

  if [[ -n "$branchname" ]]; then
    log_operation "FAILED" "$branchname" "$message"
  fi

  exit "$code"
}

info() {
  echo -e "${BLUE}ℹ${NC} $1"
}

success() {
  echo -e "${GREEN}✓${NC} $1"
}

warn() {
  echo -e "${YELLOW}⚠${NC} $1"
}

is_protected_branch() {
  local branch="$1"
  local protected
  
  for protected in "${PROTECTED_BRANCHES[@]}"; do
    if [[ "$branch" == "$protected" ]]; then
      return 0
    fi
  done
  return 1
}

is_valid_type() {
  local type="$1"
  local valid
  
  for valid in "${VALID_TYPES[@]}"; do
    if [[ "$type" == "$valid" ]]; then
      return 0
    fi
  done
  
  return 1
}

confirm_deletion() {
  local branch="$1"
  local mode="$2"
  
  if [[ "$FORCE" == true ]]; then
    return 0
  fi

  local prompt_msg="Are you sure you want to delete branch '$branch' ($mode)? (y/N) "
  local response
  
  read -p "$prompt_msg" response
  
  case "$response" in
    [yY])
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -l)
      MODE="local"
      shift
      ;;
    -r)
      MODE="remote"
      shift
      ;;
    -a)
      MODE="both"
      shift
      ;;
    -f)
      FORCE=true
      shift
      ;;
    -*)
      error_exit 1 "Unknown option: $1" "" ""
      ;;
    *)
      # Positional argument
      break
      ;;
  esac
done

# Check that we have exactly 1 positional argument
if [[ $# -ne 1 ]]; then
  error_exit 1 "Expected 1 argument (branchname), got $#" "" ""
fi

BRANCHNAME="$1"

# Validate branch name
if [[ -z "$BRANCHNAME" ]]; then
  error_exit 1 "Branch name cannot be empty" ""
fi

# Check if a type was specified
TYPE_SPECIFIED=false
SPECIFIED_TYPE=""

if [[ "$BRANCHNAME" =~ / ]]; then
  TYPE_SPECIFIED=true
  SPECIFIED_TYPE="${BRANCHNAME%%/*}"
  
  # Validate the specified type
  if ! is_valid_type "$SPECIFIED_TYPE"; then
    error_exit 1 "Invalid branch type '$SPECIFIED_TYPE'. Valid types: ${VALID_TYPES[*]}" "$BRANCHNAME"
  fi
fi

# Check if branch is protected
if is_protected_branch "$BRANCHNAME"; then
  error_exit 4 "Branch '$BRANCHNAME' is protected and cannot be deleted" "$BRANCHNAME"
fi

# Change to repo root
cd "$REPO_ROOT"

# Determine operation description
case "$MODE" in
  local)
    info "Removing local branch '$BRANCHNAME'..."
    MODE_DESC="local only"
    ;;
  remote)
    info "Removing branch '$BRANCHNAME' from remote..."
    MODE_DESC="remote only"
    ;;
  both)
    info "Removing branch '$BRANCHNAME' from local and remote..."
    MODE_DESC="local and remote"
    ;;
esac

# Fetch latest refs from remote
if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  info "Fetching latest refs from remote..."
  if ! git fetch origin >/dev/null 2>&1; then
    error_exit 2 "Failed to fetch from remote" "$BRANCHNAME"
  fi
fi

# Check if branch exists (local or remote)
LOCAL_EXISTS=false
REMOTE_EXISTS=false

if git rev-parse --verify "$BRANCHNAME" >/dev/null 2>&1; then
  LOCAL_EXISTS=true
fi

if git rev-parse --verify "origin/$BRANCHNAME" >/dev/null 2>&1; then
  REMOTE_EXISTS=true
fi

# Verify branch exists in the requested mode
if [[ "$MODE" == "local" && "$LOCAL_EXISTS" == false ]]; then
  error_exit 3 "Local branch '$BRANCHNAME' does not exist" "$BRANCHNAME"
elif [[ "$MODE" == "remote" && "$REMOTE_EXISTS" == false ]]; then
  error_exit 3 "Remote branch '$BRANCHNAME' does not exist" "$BRANCHNAME"
elif [[ "$MODE" == "both" && "$LOCAL_EXISTS" == false && "$REMOTE_EXISTS" == false ]]; then
  error_exit 3 "Branch '$BRANCHNAME' does not exist locally or remotely" "$BRANCHNAME"
fi

# If type was specified, validate that the branch actually has that type
if [[ "$TYPE_SPECIFIED" == true ]]; then
  if [[ "$LOCAL_EXISTS" == true ]] && ! git branch -a | grep -q "^[* ] $BRANCHNAME$"; then
    # Local check passed (branch exists)
    info "Validating branch type matches '$SPECIFIED_TYPE'..."
  fi
  
  # Check if the branch with the specified type actually exists
  # This is already done above (we checked if "$BRANCHNAME" exists)
  # If we got here, the branch with the specified type exists
  info "Type validation: branch '$BRANCHNAME' matches specified type '$SPECIFIED_TYPE'"
fi

# Get confirmation from user
if ! confirm_deletion "$BRANCHNAME" "$MODE_DESC"; then
  info "Branch deletion cancelled"
  exit 5
fi

# Delete local branch if needed
if [[ "$MODE" == "local" || "$MODE" == "both" ]]; then
  if [[ "$LOCAL_EXISTS" == true ]]; then
    info "Deleting local branch..."
    
    # Check if we're currently on the branch
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$CURRENT_BRANCH" == "$BRANCHNAME" ]]; then
      info "Switching to main branch..."
      if ! git checkout main >/dev/null 2>&1; then
        # Try master if main doesn't exist
        if ! git checkout master >/dev/null 2>&1; then
          error_exit 2 "Failed to switch away from branch '$BRANCHNAME'" "$BRANCHNAME"
        fi
      fi
    fi
    
    if ! git branch -d "$BRANCHNAME" >/dev/null 2>&1; then
      # Try force delete with -D
      warn "Local branch has unmerged commits, forcing deletion..."
      if ! git branch -D "$BRANCHNAME" >/dev/null 2>&1; then
        error_exit 2 "Failed to delete local branch '$BRANCHNAME'" "$BRANCHNAME"
      fi
    fi
    
    success "Local branch '$BRANCHNAME' deleted"
  fi
fi

# Delete remote branch if needed
if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  if [[ "$REMOTE_EXISTS" == true ]]; then
    info "Deleting remote branch..."
    if ! git push origin --delete "$BRANCHNAME" >/dev/null 2>&1; then
      error_exit 2 "Failed to delete remote branch '$BRANCHNAME'" "$BRANCHNAME"
    fi
    
    success "Remote branch '$BRANCHNAME' deleted"
  fi
fi

# Log successful operation
log_operation "SUCCESS" "$BRANCHNAME" "Branch deleted ($MODE_DESC)"

success "Branch '$BRANCHNAME' successfully removed"

exit 0
