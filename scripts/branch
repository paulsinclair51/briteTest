#!/usr/bin/env bash

# branch - Unified branch management utility
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

usage() {
  cat <<'EOF'
Usage:
  branch <command> [OPTIONS] [ARGS]
  branch -h | --help

Unified utility for managing Git branches with consistent naming conventions.

Commands:
  new      Create a new branch
  remove   Remove a branch
  help     Show help for a specific command
  -h, --help
           Show this help message

Examples:
  # Create a new branch (interactive)
  branch new
  
  # Create a new branch with type
  branch new major/redesign main
  
  # Create a new branch with options
  branch new -r patch/fix-bug develop
  
  # Remove a branch
  branch remove patch/fix-bug
  
  # Get help on a specific command
  branch help new
  branch help remove

For detailed documentation, see scripts/README.md
EOF
}

help_new() {
  cat <<'EOF'
Create a new branch with optional remote push.

Usage:
  branch new [OPTIONS] [<branchname> [<basebranchname>]]
  branch new -h | --help

If no arguments are provided, you will be prompted interactively.

Arguments:
  <branchname>       Name of the new branch (format: [<type>/]<description>)
  <basebranchname>   Base branch to create from (default: main)

Options:
  -l                 Create local branch only (default)
  -r                 Create local branch and push to remote
  -v                 Validate only (check if valid without creating)
  -h, --help         Show this help message

Branch Types (optional prefix, default is 'patch'):
  major  - Major features or changes
  minor  - Minor features or changes
  patch  - Bug fixes (default if no type specified)
  docs   - Documentation updates only

Examples:
  branch new                                    # Interactive mode
  branch new fix-critical-bug                   # Creates patch/fix-critical-bug
  branch new major/redesign main                # Creates major/redesign from main
  branch new -r minor/add-feature develop       # Creates and pushes minor/add-feature
  branch new -v patch/validate-only main        # Validate without creating
EOF
}

help_remove() {
  cat <<'EOF'
Remove a branch locally and/or from remote.

Usage:
  branch remove [OPTIONS] <branchname>
  branch remove -h | --help

Arguments:
  <branchname>   Name of the branch to remove (format: [<type>/]<description>)

Options:
  -l             Remove local branch only (default)
  -r             Remove branch from remote only
  -a             Remove from both local and remote
  -f             Force removal (no confirmation prompt)
  -h, --help     Show this help message

Type Validation (only if type is specified):
  - If you specify a type (e.g., 'patch/fix-bug'), the branch must have that exact type
  - If no type is specified, no type validation is performed

Examples:
  branch remove patch/fix-bug                 # Remove local patch/fix-bug
  branch remove -f patch/old-feature          # Force remove without confirmation
  branch remove -r minor/completed-feature    # Remove from remote only
  branch remove -a major/finished-refactor    # Remove from both local and remote
EOF
}

interactive_new() {
  echo -e "${BLUE}ℹ${NC} Creating a new branch"
  echo
  
  # Get branch name
  read -p "Enter branch name (or type/description): " branchname
  if [[ -z "$branchname" ]]; then
    echo -e "${RED}Error:${NC} Branch name cannot be empty"
    return 1
  fi
  
  # Get base branch
  read -p "Enter base branch (default: main): " basebranchname
  basebranchname="${basebranchname:-main}"
  
  # Ask about options
  read -p "Push to remote? (y/N): " push_response
  local mode="-l"
  if [[ "$push_response" =~ [yY] ]]; then
    mode="-r"
  fi
  
  # Call mkbranch
  "$SCRIPT_DIR/mkbranch" $mode "$branchname" "$basebranchname"
}

# Parse top-level command
if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  new)
    shift
    if [[ $# -eq 0 ]]; then
      # Interactive mode
      interactive_new
    elif [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
      help_new
      exit 0
    else
      # Delegate to mkbranch with all remaining arguments
      "$SCRIPT_DIR/mkbranch" "$@"
    fi
    ;;
  remove)
    shift
    if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
      help_remove
      exit 0
    else
      # Delegate to rmbranch with all remaining arguments
      "$SCRIPT_DIR/rmbranch" "$@"
    fi
    ;;
  help)
    shift
    if [[ $# -eq 0 ]]; then
      usage
      exit 0
    fi
    case "$1" in
      new)
        help_new
        ;;
      remove)
        help_remove
        ;;
      *)
        echo -e "${RED}Error:${NC} Unknown command: $1"
        echo "Available commands: new, remove"
        exit 1
        ;;
    esac
    ;;
  *)
    echo -e "${RED}Error:${NC} Unknown command: $1"
    echo "Run 'branch -h' for help"
    exit 1
    ;;
esac

exit 0
