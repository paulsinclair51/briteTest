#!/usr/bin/env bash

# gendocx - Convert PDF files to Microsoft Word DOCX.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.
#
# Dependencies: python3 + pdf2docx package, or libreoffice/soffice.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  gendocx [<doc_options>] <document>[.pdf] [<outdocument>[.docx]]
  gendocx [<dir_options>] <indirectory> [<outdirectory>]
  gendocx [<dir_options>]
  gendocx -t
  gendocx -h | --help

The third form is the same as: gendocx [<dir_options>] ./

<doc_options>:
  [-b <backend>] [-n] [-p] [-q] [-s] [-v]

<dir_options>:
  [-b <backend>] [-g] [-k] [-n] [-p] [-q] [-r] [-s] [-v]
  [-i "<pattern>"]... [-x "<pattern>"]...

Option values:
  <backend>  Conversion backend: auto, python, libreoffice
  <pattern>  Bash glob pattern for relative paths:
             - * or ** matches any characters, including '/'
             - ? matches one character, including '/'
             - [abc] matches one character from a set/range
             - any other character matches itself
             Note: this differs from common path-segment glob expectations,
             where * and ? do not match '/'. Use the -g option to enable
             * and ? not matching '/'.

Options:
  -b  Force conversion backend instead of auto-detecting.
      Useful for diagnostics and testing.
  -g  Use segment-style glob matching for -i/-x patterns:
      * and ? do not match '/'; ** matches across '/'.
  -h, --help  Output this help to stdout and exit.
  -i  Include only files whose relative path matches "<pattern>".
  -k  Keep directory structure under outdirectory (useful with -r).
  -n  Show planned conversions without writing output files.
  -p  Permissive: disable strict extension checks.
  -q  Quiet mode: suppress informational messages to stdout. Help and
      diagnostics are not affected. There is no output to stdout in quiet mode
      when successful.
  -r  When input is a directory, include .pdf files in all subdirectories
      (default: only .pdf files directly in that directory).
  -s  Strict: Require explicit input/output extensions (when provided) to be
      .pdf and .docx respectively.
  -t  Tool check: report available conversion toolchains and exit.
  -v  Verbose mode: print backend diagnostics to stderr.
  -x  Exclude files whose relative path matches "<pattern>".

Environment:
  GENDOCX_STRICT  Default strict-mode setting when flags are not provided.
                  Strict:     1, true, yes, on
                  Permissive: 0, false, no, off
                  Otherwise:  Raises an error.

Converts PDF files to DOCX.

Examples:
  gendocx docs/pdf/briteTest.pdf
  gendocx docs/pdf/briteTest.pdf docs/docx/briteTest
  gendocx docs/pdf docs/docx
EOF
}

strict_ext=0
quiet=0
verbose=0
check_only=0
recursive=0
keep_structure=0
dry_run=0
backend=auto
segment_glob=0
declare -a include_patterns=()
declare -a exclude_patterns=()

log_info() {
  if [[ $quiet -eq 0 ]]; then
    echo "$1"
  fi
}

log_debug() {
  if [[ $verbose -eq 1 ]]; then
    echo "Debug: $1" >&2
  fi
}

log_error() {
  echo "Error: $1" >&2
}

trim_trailing_slashes() {
  local path=$1
  while [[ "$path" != "/" && "$path" == */ ]]; do
    path=${path%/}
  done
  printf '%s\n' "$path"
}

can_write_target() {
  local target_file=$1
  local target_dir

  if [[ -e "$target_file" ]]; then
    [[ -w "$target_file" ]]
    return
  fi

  target_dir=$(dirname "$target_file")
  [[ -d "$target_dir" && -w "$target_dir" ]]
}

validate_backend() {
  case "$1" in
    auto|python|libreoffice)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

match_any_pattern() {
  local text=$1
  shift
  local pattern
  local regex

  for pattern in "$@"; do
    if [[ $segment_glob -eq 1 ]]; then
      regex=$(glob_to_regex_segment "$pattern")
      if [[ "$text" =~ $regex ]]; then
        return 0
      fi
    elif [[ "$text" == $pattern ]]; then
      return 0
    fi
  done

  return 1
}

glob_to_regex_segment() {
  local pattern=$1
  local regex='^'
  local i=0
  local len=${#pattern}
  local ch
  local next
  local j
  local cls

  while (( i < len )); do
    ch=${pattern:i:1}

    if [[ "$ch" == "*" ]]; then
      next=''
      if (( i + 1 < len )); then
        next=${pattern:i+1:1}
      fi

      if [[ "$next" == "*" ]]; then
        regex+='.*'
        ((i+=2))
        continue
      fi

      regex+='[^/]*'
      ((i++))
      continue
    fi

    if [[ "$ch" == "?" ]]; then
      regex+='[^/]'
      ((i++))
      continue
    fi

    if [[ "$ch" == "[" ]]; then
      j=$((i + 1))
      while (( j < len )) && [[ ${pattern:j:1} != "]" ]]; do
        ((j++))
      done

      if (( j < len )); then
        cls=${pattern:i+1:j-i-1}
        if [[ "${cls:0:1}" == "!" ]]; then
          cls="^${cls:1}"
        fi
        regex+="[${cls}]"
        i=$((j + 1))
        continue
      fi
    fi

    case "$ch" in
      .|^|$|\(|\)|+|\{|\}|\|)
        regex+="\\$ch"
        ;;
      *)
        regex+="$ch"
        ;;
    esac

    ((i++))
  done

  regex+='$'
  printf '%s\n' "$regex"
}

toolcheck_python() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - <<'PY' >/dev/null 2>&1
from pdf2docx import Converter  # noqa: F401
print("ok")
PY
}

toolcheck_libreoffice() {
  command -v libreoffice >/dev/null 2>&1 || command -v soffice >/dev/null 2>&1
}

show_toolcheck() {
  local py_status="missing"
  local lo_status="missing"

  if toolcheck_python; then
    py_status="available"
  fi
  if toolcheck_libreoffice; then
    lo_status="available"
  fi

  echo "python(pdf2docx): $py_status"
  echo "libreoffice:     $lo_status"

  if [[ "$py_status" == "missing" && "$lo_status" == "missing" ]]; then
    return 1
  fi
  return 0
}

run_backend_python() {
  local input_pdf=$1
  local output_docx=$2

  python3 - "$input_pdf" "$output_docx" <<'PY'
import sys
from pdf2docx import Converter

inp = sys.argv[1]
outp = sys.argv[2]
cv = Converter(inp)
try:
    cv.convert(outp)
finally:
    cv.close()
PY
}

run_backend_libreoffice() {
  local input_pdf=$1
  local output_docx=$2
  local outdir
  local expected
  local cmd

  outdir=$(dirname "$output_docx")

  if command -v libreoffice >/dev/null 2>&1; then
    cmd=libreoffice
  elif command -v soffice >/dev/null 2>&1; then
    cmd=soffice
  else
    return 1
  fi

  "$cmd" --headless --convert-to docx --outdir "$outdir" "$input_pdf" >/dev/null

  expected="$outdir/$(basename "${input_pdf%.*}").docx"
  if [[ ! -f "$expected" ]]; then
    return 1
  fi

  if [[ "$expected" != "$output_docx" ]]; then
    mv -f "$expected" "$output_docx"
  fi
}

convert_with_backend() {
  local selected=$1
  local input_pdf=$2
  local output_docx=$3

  case "$selected" in
    python)
      toolcheck_python || return 1
      run_backend_python "$input_pdf" "$output_docx"
      ;;
    libreoffice)
      toolcheck_libreoffice || return 1
      run_backend_libreoffice "$input_pdf" "$output_docx"
      ;;
    *)
      return 1
      ;;
  esac
}

convert_pdf_to_docx() {
  local input_pdf=$1
  local output_docx=$2

  if [[ $dry_run -eq 1 ]]; then
    log_info "[dry-run] $input_pdf -> $output_docx"
    return 0
  fi

  mkdir -p "$(dirname "$output_docx")"

  if ! can_write_target "$output_docx"; then
    log_error "cannot write output file: $output_docx"
    return 1
  fi

  if [[ "$backend" != "auto" ]]; then
    log_debug "trying backend '$backend' for: $input_pdf"
    if convert_with_backend "$backend" "$input_pdf" "$output_docx"; then
      log_info "$input_pdf -> $output_docx"
      return 0
    fi
    log_error "requested backend '$backend' failed or is not available"
    return 1
  fi

  local candidate
  for candidate in python libreoffice; do
    log_debug "trying auto backend '$candidate' for: $input_pdf"
    if convert_with_backend "$candidate" "$input_pdf" "$output_docx"; then
      log_info "$input_pdf -> $output_docx"
      return 0
    fi
  done

  log_error "no conversion backend available for: $input_pdf"
  return 1
}

has_extension() {
  local name
  name=$(basename "$1")
  [[ "$name" == *.* ]]
}

ensure_input_pdf() {
  local arg=$1

  if [[ $strict_ext -eq 1 ]] && has_extension "$arg" && [[ "$arg" != *.pdf ]]; then
    log_error "strict mode: input extension must be .pdf: $arg"
    return 1
  fi

  if [[ -f "$arg" ]]; then
    printf '%s\n' "$arg"
    return 0
  fi

  if [[ -f "${arg}.pdf" ]]; then
    printf '%s\n' "${arg}.pdf"
    return 0
  fi

  log_error "input PDF not found: $arg"
  return 1
}

resolve_output_docx() {
  local in_pdf=$1
  local out_arg=${2:-}
  local out

  if [[ -z "$out_arg" ]]; then
    out="${in_pdf%.*}.docx"
    printf '%s\n' "$out"
    return 0
  fi

  if [[ $strict_ext -eq 1 ]] && has_extension "$out_arg" && [[ "$out_arg" != *.docx ]]; then
    log_error "strict mode: output extension must be .docx: $out_arg"
    return 1
  fi

  out=$out_arg
  if ! has_extension "$out"; then
    out="${out}.docx"
  fi

  printf '%s\n' "$out"
}

should_include_relative() {
  local rel=$1

  if [[ ${#include_patterns[@]} -gt 0 ]]; then
    if ! match_any_pattern "$rel" "${include_patterns[@]}"; then
      return 1
    fi
  fi

  if [[ ${#exclude_patterns[@]} -gt 0 ]]; then
    if match_any_pattern "$rel" "${exclude_patterns[@]}"; then
      return 1
    fi
  fi

  return 0
}

convert_file_mode() {
  local in_arg=$1
  local out_arg=${2:-}
  local in_pdf
  local out_docx

  in_pdf=$(ensure_input_pdf "$in_arg") || return 1
  out_docx=$(resolve_output_docx "$in_pdf" "$out_arg") || return 1

  convert_pdf_to_docx "$in_pdf" "$out_docx"
}

convert_dir_mode() {
  local in_dir=$1
  local out_dir=$2
  local find_cmd
  local file
  local rel
  local out
  local ok=1
  local found=0

  if [[ ! -d "$in_dir" ]]; then
    log_error "input directory not found: $in_dir"
    return 1
  fi

  in_dir=$(trim_trailing_slashes "$in_dir")
  out_dir=$(trim_trailing_slashes "$out_dir")
  mkdir -p "$out_dir"

  if [[ $recursive -eq 1 ]]; then
    find_cmd=(find "$in_dir" -type f -name '*.pdf')
  else
    find_cmd=(find "$in_dir" -maxdepth 1 -type f -name '*.pdf')
  fi

  while IFS= read -r file; do
    found=1
    rel=${file#"$in_dir"/}
    should_include_relative "$rel" || continue

    if [[ $keep_structure -eq 1 ]]; then
      out="$out_dir/${rel%.*}.docx"
    else
      out="$out_dir/$(basename "${file%.*}").docx"
    fi

    if ! convert_pdf_to_docx "$file" "$out"; then
      ok=0
    fi
  done < <("${find_cmd[@]}" | sort)

  if [[ $found -eq 0 ]]; then
    log_error "no .pdf files found in: $in_dir"
    return 1
  fi

  [[ $ok -eq 1 ]]
}

if [[ -n "${GENDOCX_STRICT:-}" ]]; then
  case "${GENDOCX_STRICT,,}" in
    1|true|yes|on)
      strict_ext=1
      ;;
    0|false|no|off)
      strict_ext=0
      ;;
    *)
      log_error "invalid GENDOCX_STRICT value: ${GENDOCX_STRICT}"
      exit 2
      ;;
  esac
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -b)
      shift
      [[ $# -gt 0 ]] || { log_error "missing value for -b"; exit 2; }
      backend=$1
      ;;
    -g)
      segment_glob=1
      ;;
    -i)
      shift
      [[ $# -gt 0 ]] || { log_error "missing value for -i"; exit 2; }
      include_patterns+=("$1")
      ;;
    -k)
      keep_structure=1
      ;;
    -n)
      dry_run=1
      ;;
    -p)
      strict_ext=0
      ;;
    -q)
      quiet=1
      ;;
    -r)
      recursive=1
      ;;
    -s)
      strict_ext=1
      ;;
    -t)
      check_only=1
      ;;
    -v)
      verbose=1
      ;;
    -x)
      shift
      [[ $# -gt 0 ]] || { log_error "missing value for -x"; exit 2; }
      exclude_patterns+=("$1")
      ;;
    --)
      shift
      break
      ;;
    -*)
      log_error "unknown option: $1"
      exit 2
      ;;
    *)
      break
      ;;
  esac
  shift
done

if ! validate_backend "$backend"; then
  log_error "invalid backend '$backend' (expected: auto|python|libreoffice)"
  exit 2
fi

if [[ $check_only -eq 1 ]]; then
  show_toolcheck
  exit $?
fi

if [[ $# -eq 0 ]]; then
  set -- ./
fi

if [[ $# -gt 2 ]]; then
  log_error "too many positional arguments"
  usage >&2
  exit 2
fi

if [[ $# -eq 1 ]]; then
  if [[ -d "$1" ]]; then
    convert_dir_mode "$1" "$1"
    exit $?
  fi
  convert_file_mode "$1"
  exit $?
fi

if [[ -d "$1" ]]; then
  convert_dir_mode "$1" "$2"
else
  convert_file_mode "$1" "$2"
fi
