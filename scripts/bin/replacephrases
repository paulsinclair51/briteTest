#!/usr/bin/env bash

# replacephrases - Run markdown phrase replacement from a config file.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

usage() {
	cat <<'EOF'
Usage:
	replacephrases [config_file] [--dry-run]
	replacephrases -h | --help

Run phrase replacement across markdown files using scripts/helpers/replace_phrases.py.

Arguments:
	config_file  Optional replacement config path. Default: config/phrase_replacements.txt

Options:
	--dry-run    Show planned changes without modifying files.
	-h, --help   Show this help and exit.
EOF
}

for arg in "$@"; do
	case "$arg" in
		-h|--help)
			usage
			exit 0
			;;
	esac
done

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Invoke the Python script with all arguments
python3 "$SCRIPT_DIR/../helpers/replace_phrases.py" "$@"
