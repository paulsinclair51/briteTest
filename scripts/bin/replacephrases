#!/usr/bin/env bash

# replacephrases - Run markdown phrase replacement from a config file.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

# Summary of script behavior:
# - Invokes phrase-replacement workflow for markdown files using configured
#   mappings.
# - Supports dry-run preview and apply modes.
# - Reports file-level replacement counts and summary totals.

set -euo pipefail

usage() {
	cat <<'EOF'
Usage:
	replacephrases [config_file] [-d]
	replacephrases -h | --help

Run phrase replacement across markdown files using scripts/helpers/replace_phrases.sh.

Arguments:
	config_file  Optional replacement config path. Default: config/phrase_replacements.txt

Options:
	-d           Show planned changes without modifying files.
	-h, --help   Show this help and exit.
EOF
}

for arg in "$@"; do
	case "$arg" in
		-h|--help)
			usage
			exit 0
			;;
	esac
done

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Invoke the helper script with all arguments
bash "$SCRIPT_DIR/../helpers/replace_phrases.sh" "$@"
