#!/usr/bin/env bash

# lsbranchlog - Query and display branch history log entries.
#
# See usage below for details, or run: lsbranchlog -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  lsbranchlog [OPTIONS]
  lsbranchlog {-h | --help}

Query and display branch history log entries from logs/remote_branch_history.md.

Features:
  - List all history entries (or filtered)
  - Filter by operation type (merge, release, created, deleted, etc.)
  - Filter by branch name
  - Filter by user
  - Show formatted output or raw markdown
  - Export to file
  - Sort ascending/descending
  - Limit number of entries

History File Format:
  remote_branch_history.md contains:
    - [timestamp] [user/type] Operation: details
    - [timestamp] [UNDO] operation: details

Options:
  -h, --help           Output this help to stdout and exit (other options
                       and arguments are ignored).
  -t, --type TYPE      Filter by operation type
                       (merged, deleted, created, released, undo, etc.)
  -b, --branch BRANCH  Filter by branch name (substring match)
  -u, --user USER      Filter by user (substring match)
  -l, --limit N        Limit results to N entries (0 = no limit, default: 0)
  -r, --reverse        Sort descending (oldest first, default: newest first)
  -o, --output FILE    Write results to file instead of stdout
  -v, --verbose        Show detailed formatting with full timestamps
  -f, --file FILE      Use custom history file
                       (default: logs/remote_branch_history.md)

Examples:
  # Show all history entries
  lsbranchlog

  # Show last 10 entries
  lsbranchlog -l 10

  # Show all merges
  lsbranchlog -t merged

  # Show all releases
  lsbranchlog -t released

  # Show entries for a specific branch
  lsbranchlog -b "feature/auth"

  # Show entries from a specific user
  lsbranchlog -u "alice"

  # Show all undos
  lsbranchlog -t undo

  # Export to file
  lsbranchlog -o history_report.txt

  # Combine filters: merges by alice on auth branches
  lsbranchlog -t merged -u alice -b auth -l 20


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented
    output locations.

Exit codes:
  0   Success
  1   Argument or validation error
  2   History file not found
  3   No entries found matching criteria
EOF
}

# High-Level Flow:
# - Reads branch history markdown logs from logs/ and filters by
#   branch/date/type options.
# - Formats matching entries for terminal output and optional report files.
# - Supports concise history queries to inspect prior workflow actions.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"
# shellcheck source=helpers/validation-helpers.sh
source "$SCRIPT_DIR/../helpers/validation-helpers.sh"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_NOT_FOUND=2
readonly EXIT_OPERATION_FAILED=3

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

# Default options
# Default to the current branch's history file.
_ck_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
[[ "$_ck_branch" == "HEAD" || -z "$_ck_branch" ]] && _ck_branch="main"

# Validate branch name conforms to naming conventions
if ! validate_branch_name "$_ck_branch" "current branch"; then
  usage_error "Current branch does not conform to naming conventions"
fi

HISTORY_FILE="$REPO_ROOT/$(bt_branch_to_history_file "$_ck_branch")"
OUTPUT_FILE=""
VERBOSE=false
FILTER_TYPE=""
FILTER_BRANCH=""
FILTER_USER=""
LIMIT=0
REVERSE=false


# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -t | --type)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -t requires a type argument"
      fi
      FILTER_TYPE="$2"
      shift 2
      ;;
    -b | --branch)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -b requires a branch argument"
      fi
      FILTER_BRANCH="$2"
      shift 2
      ;;
    -u | --user)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -u requires a user argument"
      fi
      FILTER_USER="$2"
      shift 2
      ;;
    -l | --limit)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -l requires a number argument"
      fi
      LIMIT="$2"
      shift 2
      ;;
    -r | --reverse)
      REVERSE=true
      shift
      ;;
    -o | --output)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -o requires a file argument"
      fi
      OUTPUT_FILE="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -f | --file)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -f requires a file argument"
      fi
      HISTORY_FILE="$2"
      shift 2
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      usage_error "Unknown argument: $1"
      ;;
  esac
done

# Propagate repository history from remote if available
bt_propagate_repository_history
case $? in
  0) ;;
  1) bt_info "Updated repository history from remote" ;;
  *) ;;
esac

# Check history file exists
if [[ ! -f "$HISTORY_FILE" ]]; then
  bt_error_exit "$EXIT_NOT_FOUND" "History file not found: $HISTORY_FILE"
fi

bt_info "Reading history from $HISTORY_FILE"

# Extract entries (skip header lines)
# Format: - [timestamp] [user] Operation: details
entries=$(grep -E '^\s*-\s+\[' "$HISTORY_FILE" | tail -n +1)

if [[ -z "$entries" ]]; then
  bt_warn "No history entries found"
  exit "$EXIT_OPERATION_FAILED"
fi

# Apply filters
filtered_entries="$entries"

# Filter by type
if [[ -n "$FILTER_TYPE" ]]; then
  bt_info "Filtering by type: $FILTER_TYPE"
  filtered_entries=$(echo "$filtered_entries" | grep -i "$FILTER_TYPE")
fi

# Filter by branch
if [[ -n "$FILTER_BRANCH" ]]; then
  bt_info "Filtering by branch: $FILTER_BRANCH"
  filtered_entries=$(echo "$filtered_entries" | grep -i "$FILTER_BRANCH")
fi

# Filter by user
if [[ -n "$FILTER_USER" ]]; then
  bt_info "Filtering by user: $FILTER_USER"
  filtered_entries=$(echo "$filtered_entries" | grep -i "$FILTER_USER")
fi

# Check if any entries remain after filtering
if [[ -z "$filtered_entries" ]]; then
  bt_warn "No entries found matching criteria"
  exit "$EXIT_OPERATION_FAILED"
fi

# Reverse order if requested
if [[ "$REVERSE" == true ]]; then
  filtered_entries=$(echo "$filtered_entries" | tac)
fi

# Apply limit
if [[ "$LIMIT" -gt 0 ]]; then
  filtered_entries=$(echo "$filtered_entries" | head -n "$LIMIT")
fi

# Count entries
entry_count=$(echo "$filtered_entries" | wc -l)
bt_success "Found $entry_count matching entries"

# Format output
output_text=""
if [[ "$VERBOSE" == true ]]; then
  # Verbose: show full details
  output_text=$(echo "$filtered_entries" | sed 's/^\s*-\s*//')
else
  # Compact: clean up formatting
  output_text=$(echo "$filtered_entries" | sed 's/^\s*-\s*/  /')
fi

# Output to file or stdout
if [[ -n "$OUTPUT_FILE" ]]; then
  echo "$output_text" > "$OUTPUT_FILE"
  bt_success "Results written to $OUTPUT_FILE"
else
  echo ""
  echo "$output_text"
  echo ""
fi

bt_success "Done"
exit 0
