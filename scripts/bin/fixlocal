#!/usr/bin/env bash

# fixlocal - Check this local repository for corruption and issues,
# apply safe cleanup/fixes, and generate a report.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  fixlocal [OPTIONS]
  fixlocal {-h | --help}

Check this local repository for integrity and maintenance issues, apply safe
local remediations when enabled, and generate a diagnostic report.

Scope:
  - Operates on the local working copy: <repo>/scripts/bin/fixlocal -> <repo>.
  - Checks local integrity, worktree state, layout, branch tracking, and remote
    reachability (origin) when enabled.
  - Applies only local, guarded remediations. It never modifies hosted remote
    state directly.

Pre-requisites:
  - User must be a contributor (listed in <repo>/config/contributors.md) or
    repository owner.
  - Make sure the remote (origin) is connected and reachable if you want
    remote/tracking checks and remote-tracking refresh for the local
    repository or you specify the -f option.

Features:
  - Validates git object database integrity (`git fsck --full`).
  - Verifies working tree cleanliness and repository structure/layout.
  - Checks remote connectivity/tracking status.
  - Iterates all local branches to evaluate upstream ahead/behind status.
  - Attempts safe remote-tracking refresh (`git fetch --prune origin`) when
    tracking metrics cannot be computed.
  - Attempts guarded remote synchronization of the current local branch from
    its configured remote-tracking branch (use `-r 0` to skip remote checks).
  - Optional force mode (`-f`) can discard local-only divergence/working-tree
    changes (after creating a backup ref) to converge this local branch to
    remote branch for stabilization (with potential local loss
    of recent changes).
  - Runs safe cleanup (`git gc --prune=now`) and reruns affected verification
    checks after cleanup.
  - Continues through remaining checks when non-critical checks/fixes fail and
    records all failures in the report.
  - Distinguishes fixable vs non-fixable issues and verified vs. unverified
    remediations.

Options:
  -d                Dry-run mode: report issues only, do not attempt repairs.
  -f                Force local stabilization: allow discarding local dirty
                    changes and local-ahead commits during guarded remote sync
                    (backup ref created first). Requires remote connectivity.
  -h                Output this help to stdout and exit (other options ignored).
  --help            Output this help to stdout and exit (other options ignored).
  -r SEC            Remote reachability timeout in seconds (default: 10).
                    Use 0 to skip remote connectivity/tracking checks.
  -v                Verbose mode: add per-step progress detail to stdout.

Common runs:
  fixlocal             Full checks with safe auto-fixes and remote checks/
                       tracking refresh if the connection to the remote occurs
                       within the default timeout of 10 seconds.
  fixlocal -d          Full checks in report-only mode.
  fixlocal -f          Full checks with safe auto-fixes and remote checks/
                       tracking refresh plus forced local stabilization
                       safeguards if needed. Requires connection to the
                       remote within the default timeout of 10 seconds.
  fixlocal -r 0        Full checks without accessing remote (no remote checks).
  fixlocal -r 4        Full checks with safe auto-fixes and remote checks/
                       tracking refresh if the connection to the remote occurs
                       within the specified timeout of 4 seconds.
  fixlocal -v          Full checks with safe auto-fixes and remote checks/
                       tracking refresh if the connection to the remote occurs
                       within the default timeout of 10 seconds and per-step
                       verbose detail.

Outputs:
  - Prints issue counts and report path to stdout; per-step detail with -v.
  - Writes errors and diagnostics to stderr.
  - Writes a repository diagnostic report to local main with fallback chain:
      1. <repo>/reports/repository/repository-<date>-<time>-<pid>.md
         (local main branch; preferred)
      2. <repo>/repository-<date>-<time>-<pid>.md (root of local main,
         if directory missing or unwritable)
      3. stdout (if local main branch cannot be written to)
  - Copies the report to the original current branch at the same
    relative location if that directory exists and is writable.
  - The report is listed in .gitignore and remains an untracked artifact.
  - Returns to the original branch after writing the report.
  - Branch tracking checks do not require manual branch switching.
  - Report includes:
      - Timestamp of the run.
      - User and machine information.
      - Repository path.
      - Target repository name and path.
      - Checks performed and their results.
      - Summary of issues detected, auto-handled, and remaining.
      - Suggested next steps for any remaining issues.
      - Blockers preventing checking (partially or fully) the repository:
          - Cannot determine current branch or repository state.
          - Cannot checkout main branch.
          - Git operation failed (generic/unspecified).
          - Git fsck failed - repository integrity check error.
          - Git fetch or remote operation failed.
          - Git checkout or branch operation failed.
          - Missing or invalid configuration file.
      - Report location failures:
          - report/repository/ directory in local main branch does not
            exist or is not writable.
          - Fallback to root of local main branch is not writable.
      - Remote corruption warnings (if detected):
          - If remote (origin) main branch has corruption, the report
            documents it.
          - Local clone pushes are blocked until remote is verified clean.
          - Contact the repository owner to use fixremote script or
            manually recover the remote.

Recovery Workflow:
  If fixlocal detects remote corruption while local clone is clean:
    1. fixlocal fixes local clone and documents remote issues in the report.
    2. Pushes from this clone are blocked (to prevent spreading corruption).
    3. Repository owner runs: fixremote <path-to-this-clean-clone>
    4. fixremote recovers remote from the clean clone objects and refs.
    5. If there are still issues, the owner can attempt to manually recover
       remote.
    6. Once remote is verified clean, owner clears the corruption flag.
    7. Contributors can then push to remote normally.

Exit codes:
  0   Success - no issues or all issues fixed.
  1   Invalid option or argument.
  2   Not authorized to run fixlocal (requires a contributor or the
      repository owner).
  3   Issues detected - one or more were not fixable.
  4   For dry-run (-d) mode, fixable issues were detected that would
      be fixed if run without -d. No non-fixable issues were detected.
  100 Missing required helper files, dependencies, or configuration.
EOF
}

# High-Level Flow:
# 1. Validate prerequisites, helper availability, and caller authorization.
# 2. Run local integrity/worktree/layout checks and optional remote checks.
# 3. Attempt guarded local remediations for fixable findings (unless -d).
# 4. Continue on recoverable failures and record outcomes in the report.
# 5. Emit summary and exit with status reflecting remaining issues.

# Fast-path help handling before any helper sourcing/network/git side effects.
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    usage
    exit 0
  fi
done

set -euo pipefail

# Capture original command line for report
COMMAND_LINE="fixlocal$(printf ' %q' "$@")"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_UNAUTHORIZED=2
readonly EXIT_ISSUES_DETECTED=3
readonly EXIT_FIXABLE_ONLY=4
readonly EXIT_MISSING_DEPENDENCIES=100

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"
# Repository-specific: keep generated reports under this workspace layout.
REPOSITORY_REPORTS_DIR="$REPO_ROOT/reports/repository"

# Validate required helpers exist
if [[ ! -f "$SCRIPT_DIR/../helpers/common.sh" ]]; then
  echo "Error: Required helper not found: $SCRIPT_DIR/../helpers/common.sh" >&2
  exit "$EXIT_INVALID_ARGUMENT"
fi
if [[ ! -f "$SCRIPT_DIR/../helpers/git_helpers.sh" ]]; then
  echo "Error: Required helper not found: $SCRIPT_DIR/../helpers/git_helpers.sh" >&2
  exit "$EXIT_INVALID_ARGUMENT"
fi
if [[ ! -f "$SCRIPT_DIR/../helpers/report_helpers.sh" ]]; then
  echo "Error: Required helper not found: $SCRIPT_DIR/../helpers/report_helpers.sh" >&2
  exit "$EXIT_INVALID_ARGUMENT"
fi
if [[ ! -f "$SCRIPT_DIR/../helpers/health_report.sh" ]]; then
  echo "Error: Required helper not found: $SCRIPT_DIR/../helpers/health_report.sh" >&2
  exit "$EXIT_INVALID_ARGUMENT"
fi
if [[ ! -f "$SCRIPT_DIR/../helpers/ckrole.sh" ]]; then
  echo "Error: Required helper not found: $SCRIPT_DIR/../helpers/ckrole.sh" >&2
  exit "$EXIT_INVALID_ARGUMENT"
fi

# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"
# shellcheck source=helpers/health_report.sh
source "$SCRIPT_DIR/../helpers/health_report.sh"

# history_log.sh is optional in isolated test fixtures.
# If unavailable, provide a no-op fallback used at startup.
if [[ -f "$SCRIPT_DIR/../helpers/history_log.sh" ]]; then
  # shellcheck source=helpers/history_log.sh
  source "$SCRIPT_DIR/../helpers/history_log.sh"
else
  bt_propagate_repository_history() {
    return 0
  }
fi

# Propagate repository history from remote if available (best-effort).
set +e
bt_propagate_repository_history >/dev/null 2>&1
set -e

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

require_contributor_role() {
  if bash "$SCRIPT_DIR/../helpers/ckrole.sh" contributor >/dev/null 2>&1; then
    return 0
  fi

  bt_error_exit "$EXIT_UNAUTHORIZED" \
    "User is not authorized to run fixlocal (requires contributor role or higher)."
}

RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_ID="${RUN_TS_FILE}-${BASHPID}"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"

OUTPUT_FILE=""
# shellcheck disable=SC2034  # Consumed indirectly by shared report helper.
REPOSITORY_REPORT_DELETIONS=()
VERBOSE=false
DRY_RUN=false
FORCE_LOCAL_STABILIZATION=false
REMOTE_TIMEOUT_SECONDS=10
readonly REMOTE_RETRY_ATTEMPTS=3
readonly REMOTE_RETRY_BASE_DELAY_SECONDS=1

ISSUES_FOUND=0
ISSUES_FIXED=0
FIXABLE_ISSUES_FOUND=0
REMEDIATIONS_ATTEMPTED=0
REMEDIATIONS_VERIFIED=0
REMEDIATIONS_UNVERIFIED=0
REMEDIATIONS_FAILED=0
CRITICAL_ERROR=false
TARGET_ISSUES_FOUND=0
TARGET_FIXABLE_ISSUES_FOUND=0

CURRENT_REPO=""
CURRENT_TARGET_NAME=""

TARGET_NAMES=()
TARGET_PATHS=()

increment_counter() {
  local var_name="$1"
  printf -v "$var_name" '%d' "$(( ${!var_name} + 1 ))"
}

# log_verbose: printed only when -v (verbose mode).
# Use for per-step progress detail inside check functions.
log_verbose() {
  [[ "$VERBOSE" == true ]] || return 0
  bt_info "$1"
}

safe_trim_spaces() {
  # Normalize mixed whitespace to single spaces for robust token parsing.
  printf '%s' "$1" | tr '\t' ' ' | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//'
}

filtered_status_output() {
  local repo_path="$1"
  local status_output=""

  status_output="$(git -C "$repo_path" status --porcelain 2>/dev/null || true)"
  if [[ -n "$status_output" ]]; then
    status_output="$(printf '%s\n' "$status_output" | awk '
      {
        path = substr($0, 4)
        if (path ~ /^reports\/repository\/repository-[0-9]{8}-[0-9]{6}(-[0-9]+)?\.md$/) {
          next
        }
        print
      }
    ')"
  fi

  printf '%s' "$status_output"
}

is_valid_timeout_seconds() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

has_required_api_files() {
  local repo_path="$1"

  # Treat as valid repository when required API files exist.
  if [[ -f "$repo_path/src/runnerapi.c" || -f "$repo_path/src/testapi.c" || -f "$repo_path/include/runnerapi.h" || -f "$repo_path/include/testapi.h" ]]; then
    return 0
  fi

  return 1
}

add_target_repo() {
  local target_name="$1"
  local target_path="$2"

  local i
  for i in "${!TARGET_PATHS[@]}"; do
    if [[ "${TARGET_PATHS[$i]}" == "$target_path" ]]; then
      return 0
    fi
  done

  TARGET_NAMES+=("$target_name")
  TARGET_PATHS+=("$target_path")
}

init_report() {
  cat > "$OUTPUT_FILE" << EOF
# Local Repository Repair Report

**Timestamp:** ${RUN_TS_DISPLAY}

**Command:** $COMMAND_LINE

**Repository:** $REPO_ROOT

## Checks Performed
EOF
}

append_target_header() {
  local target_name="$1"
  local target_path="$2"

  # Target header is redundant with earlier report info; skip it
  return 0
}

append_section() {
  bt_hr_append_section "$OUTPUT_FILE" "$1"
}

append_check() {
  local check_name="$1"
  local status="$2"
  local details="$3"
  local fixable="${4:-false}"

  bt_hr_append_check "$OUTPUT_FILE" "$check_name" "$status" "$details" ISSUES_FOUND ISSUES_FIXED

  if [[ "$status" == "ISSUE" ]]; then
    increment_counter TARGET_ISSUES_FOUND
    if [[ "$fixable" == "true" ]]; then
      increment_counter FIXABLE_ISSUES_FOUND
      increment_counter TARGET_FIXABLE_ISSUES_FOUND
    fi
  elif [[ "$status" == "FIXABLE" ]]; then
    increment_counter FIXABLE_ISSUES_FOUND
    increment_counter TARGET_FIXABLE_ISSUES_FOUND
  elif [[ "$status" == "ERROR" ]]; then
    increment_counter TARGET_ISSUES_FOUND
    CRITICAL_ERROR=true
  fi
}

check_git_validity() {
  append_section "Git Repository Validity"

  if ! bt_git_is_repository "$CURRENT_REPO"; then
    append_check "Git Directory" "ERROR" "Not a valid git repository"
    return 1
  fi

  append_check "Git Directory" "PASS" "Valid git repository structure"
  return 0
}

check_object_database() {
  append_section "Object Database Integrity"

  local fsck_output
  fsck_output="$(git -C "$CURRENT_REPO" fsck --full 2>&1 || true)"

  if printf '%s\n' "$fsck_output" | grep -Eq '(^|[[:space:]])(error|fatal):'; then
    append_check "Object Database" "ISSUE" \
      "Repository integrity check detected errors. Not auto-handled; contact the repository owner for recovery assistance."
    printf '%s\n' "$fsck_output" | sed 's/^/    /' >> "$OUTPUT_FILE"
    return 1
  fi

  append_check "Object Database" "PASS" "No corruption detected"

  local dangling_count
  dangling_count="$(printf '%s\n' "$fsck_output" | grep -c '^dangling ' || true)"
  if [[ "$dangling_count" =~ ^[0-9]+$ ]] && [[ "$dangling_count" -gt 0 ]]; then
    append_check "Dangling Objects" "FIXABLE" \
      "Found $dangling_count dangling objects; will be pruned by garbage collection."
  fi

  return 0
}

check_remote_connectivity() {
  append_section "Remote Connectivity"

  local origin_url
  origin_url="$(git -C "$CURRENT_REPO" remote get-url origin 2>/dev/null || true)"

  if [[ -z "$origin_url" ]]; then
    append_check "Origin Remote" "PASS" "No origin remote configured"
    return 0
  fi

  append_check "Origin Remote" "PASS" "$origin_url"

  if [[ "$REMOTE_TIMEOUT_SECONDS" -eq 0 ]]; then
    append_check "Origin Reachability" "PASS" \
      "Skipped (disabled by -r 0)"
    append_check "Tracking Branch" "PASS" \
      "Skipped (disabled by -r 0)"
    return 0
  fi

  if bt_git_ls_remote_origin_with_timeout_and_retry \
    "$CURRENT_REPO" "$REMOTE_TIMEOUT_SECONDS" \
    "$REMOTE_RETRY_ATTEMPTS" "$REMOTE_RETRY_BASE_DELAY_SECONDS"; then
    append_check "Origin Reachability" "PASS" "Remote is reachable"
  else
    append_check "Origin Reachability" "ISSUE" \
      "Remote is configured but not reachable (timeout: ${REMOTE_TIMEOUT_SECONDS}s). Not auto-handled; suggested fix: Verify network/auth and confirm the origin URL."
    return 1
  fi

  local upstream
  upstream="$(git -C "$CURRENT_REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  if [[ -z "$upstream" ]]; then
    append_check "Tracking Branch" "PASS" "No upstream configured for current branch"
    return 0
  fi

  local counts
  counts="$(git -C "$CURRENT_REPO" rev-list --left-right --count HEAD..."$upstream" 2>/dev/null || true)"
  counts="$(safe_trim_spaces "$counts")"
  local ahead=""
  local behind=""
  local extra=""
  read -r ahead behind extra <<< "$counts"
  if [[ "$ahead" =~ ^[0-9]+$ ]] && [[ "$behind" =~ ^[0-9]+$ ]] && [[ -z "$extra" ]]; then
    append_check "Tracking Branch" "PASS" \
      "Upstream: $upstream (ahead $ahead, behind $behind)"
  else
    append_check "Tracking Branch" "PASS" \
      "Unable to compute ahead/behind for current branch; see 'Local Branch Tracking' section for per-branch remediation attempt."
  fi

  return 0
}

refresh_remote_tracking_state() {
  append_section "Remote Tracking Remediation"

  increment_counter REMEDIATIONS_ATTEMPTED
  if bt_git_fetch_prune_origin_with_retry \
    "$CURRENT_REPO" "$REMOTE_RETRY_ATTEMPTS" "$REMOTE_RETRY_BASE_DELAY_SECONDS" >/dev/null 2>&1; then
    append_check "Remote Tracking Refresh" "PASS" \
      "Refreshed remote-tracking references"
    return 0
  fi

  append_check "Remote Tracking Refresh" "ISSUE" \
    "Unable to refresh remote-tracking references. Not auto-handled; contact the repository owner to investigate and resolve the tracking issue."
  increment_counter REMEDIATIONS_FAILED
  return 1
}

check_all_local_branch_tracking() {
  append_section "Local Branch Tracking"

  if [[ "$REMOTE_TIMEOUT_SECONDS" -eq 0 ]]; then
    append_check "All Local Branches" "PASS" \
      "Skipped (disabled by -r 0)"
    return 0
  fi

  local branch_rows=()
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    branch_rows+=("$row")
  done < <(git -C "$CURRENT_REPO" for-each-ref --format='%(refname:short)|%(upstream:short)' refs/heads)

  if [[ "${#branch_rows[@]}" -eq 0 ]]; then
    append_check "All Local Branches" "PASS" "No local branches found"
    return 0
  fi

  local row
  local branch_name
  local upstream
  local counts
  local ahead
  local behind
  local extra
  local has_issue=false
  local refresh_attempted=false

  for row in "${branch_rows[@]}"; do
    branch_name="${row%%|*}"
    upstream="${row#*|}"

    if [[ -z "$upstream" ]]; then
      append_check "Branch: $branch_name" "PASS" \
        "No upstream configured"
      continue
    fi

    counts="$(git -C "$CURRENT_REPO" rev-list --left-right --count "$branch_name...$upstream" 2>/dev/null || true)"
    counts="$(safe_trim_spaces "$counts")"
    ahead=""
    behind=""
    extra=""
    read -r ahead behind extra <<< "$counts"

    if [[ "$ahead" =~ ^[0-9]+$ ]] && [[ "$behind" =~ ^[0-9]+$ ]] && [[ -z "$extra" ]]; then
      append_check "Branch: $branch_name" "PASS" \
        "Upstream: $upstream (ahead $ahead, behind $behind)"
    else
      append_check "Branch: $branch_name" "ISSUE" \
        "Unable to compute ahead/behind against $upstream. Attempting safe tracking refresh." \
        "true"

      if [[ "$DRY_RUN" == true ]]; then
        append_check "Branch: $branch_name" "ISSUE" \
          "Dry-run mode enabled; no remote-tracking refresh attempted. Re-run without -d to allow safe remediation."
        has_issue=true
        continue
      fi

      if [[ "$refresh_attempted" == false ]]; then
        refresh_attempted=true
        if ! refresh_remote_tracking_state; then
          has_issue=true
          continue
        fi
      fi

      counts="$(git -C "$CURRENT_REPO" rev-list --left-right --count "$branch_name...$upstream" 2>/dev/null || true)"
      counts="$(safe_trim_spaces "$counts")"
      ahead=""
      behind=""
      extra=""
      read -r ahead behind extra <<< "$counts"

      if [[ "$ahead" =~ ^[0-9]+$ ]] && [[ "$behind" =~ ^[0-9]+$ ]] && [[ -z "$extra" ]]; then
        append_check "Branch: $branch_name" "FIXED" \
          "Tracking refreshed. Upstream: $upstream (ahead $ahead, behind $behind)"
      else
        append_check "Branch: $branch_name" "ISSUE" \
          "Ahead/behind still unavailable after tracking refresh. Not auto-handled; suggested fix: Verify upstream branch configuration and remote branch existence."
        has_issue=true
      fi
    fi
  done

  if [[ "$has_issue" == false ]]; then
    append_check "All Local Branches" "PASS" \
      "Per-branch tracking checks completed"
    return 0
  fi

  return 1
}

safe_sync_current_branch_from_upstream() {
  append_section "Safe Remote Synchronization"

  if [[ "$DRY_RUN" == true ]]; then
    append_check "Current Branch Remote Synchronization" "PASS" \
      "Skipped in dry-run mode (-d)"
    return 0
  fi

  if [[ "$REMOTE_TIMEOUT_SECONDS" -eq 0 ]]; then
    append_check "Current Branch Remote Synchronization" "ISSUE" \
      "Cannot run with -r 0 because remote checks are disabled. Re-run without -r 0." \
      "true"
    return 1
  fi

  local origin_url=""
  origin_url="$(git -C "$CURRENT_REPO" remote get-url origin 2>/dev/null || true)"
  if [[ -z "$origin_url" ]]; then
    append_check "Current Branch Remote Synchronization" "PASS" \
      "No origin remote configured"
    return 0
  fi

  if ! bt_git_ls_remote_origin_with_timeout_and_retry \
    "$CURRENT_REPO" "$REMOTE_TIMEOUT_SECONDS" \
    "$REMOTE_RETRY_ATTEMPTS" "$REMOTE_RETRY_BASE_DELAY_SECONDS"; then
    append_check "Current Branch Remote Synchronization" "ISSUE" \
      "Origin is not reachable (timeout: ${REMOTE_TIMEOUT_SECONDS}s). Safe remote synchronization skipped." \
      "true"
    return 1
  fi

  local current_branch=""
  current_branch="$(git -C "$CURRENT_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [[ -z "$current_branch" || "$current_branch" == "HEAD" ]]; then
    append_check "Current Branch Remote Synchronization" "ISSUE" \
      "Detached HEAD or unknown current branch. Safe remote synchronization skipped." \
      "true"
    return 1
  fi

  local upstream=""
  upstream="$(git -C "$CURRENT_REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  if [[ -z "$upstream" ]]; then
    append_check "Current Branch Remote Synchronization" "PASS" \
      "Current branch '$current_branch' has no remote-tracking branch configured"
    return 0
  fi

  local status_output=""
  local dirty_force_needed=false
  status_output="$(filtered_status_output "$CURRENT_REPO")"
  if [[ -n "$status_output" ]]; then
    local file_count=""
    file_count="$(printf '%s\n' "$status_output" | wc -l | tr -d ' ')"
    if [[ "$FORCE_LOCAL_STABILIZATION" == true ]]; then
      append_check "Current Branch Remote Synchronization" "ISSUE" \
        "Working directory is not clean ($file_count changed entries). Force mode (-f) will discard local working-tree changes after backup ref creation." \
        "true"
      dirty_force_needed=true
    else
      append_check "Current Branch Remote Synchronization" "ISSUE" \
        "Working directory is not clean ($file_count changed entries). Commit/stash changes or re-run with -f to allow forced local stabilization." \
        "true"
      return 1
    fi
  fi

  local counts=""
  local ahead=""
  local behind=""
  local extra=""
  counts="$(git -C "$CURRENT_REPO" rev-list --left-right --count HEAD..."$upstream" 2>/dev/null || true)"
  counts="$(safe_trim_spaces "$counts")"
  read -r ahead behind extra <<< "$counts"

  if ! [[ "$ahead" =~ ^[0-9]+$ ]] || ! [[ "$behind" =~ ^[0-9]+$ ]] || [[ -n "$extra" ]]; then
    append_check "Current Branch Remote Synchronization" "ISSUE" \
      "Unable to compute ahead/behind for '$current_branch' vs '$upstream'. Safe remote synchronization skipped." \
      "true"
    return 1
  fi

  if [[ "$ahead" -gt 0 ]]; then
    if [[ "$FORCE_LOCAL_STABILIZATION" == true ]]; then
      append_check "Current Branch Remote Synchronization" "ISSUE" \
        "Current branch '$current_branch' is ahead of '$upstream' by $ahead commit(s). Force mode (-f) will discard local-ahead commits after backup ref creation." \
        "true"
    else
      append_check "Current Branch Remote Synchronization" "ISSUE" \
        "Current branch '$current_branch' is ahead of '$upstream' by $ahead commit(s). Auto-sync skipped to avoid rewriting local commits. Re-run with -f to allow forced local stabilization." \
        "true"
      return 1
    fi
  fi

  if [[ "$behind" -eq 0 && "$ahead" -eq 0 && "$dirty_force_needed" == false ]]; then
    append_check "Current Branch Remote Synchronization" "PASS" \
      "Current branch '$current_branch' is already up to date with '$upstream'"
    return 0
  fi

  if [[ "$FORCE_LOCAL_STABILIZATION" == true ]]; then
    append_check "Current Branch Remote Synchronization" "ISSUE" \
      "Attempting forced local stabilization for '$current_branch' (backup-first, local-only)." \
      "true"
  else
    append_check "Current Branch Remote Synchronization" "ISSUE" \
      "Current branch '$current_branch' is behind '$upstream' by $behind commit(s). Attempting guarded fast-forward sync." \
      "true"
  fi

  increment_counter REMEDIATIONS_ATTEMPTED

  local current_commit=""
  current_commit="$(git -C "$CURRENT_REPO" rev-parse HEAD 2>/dev/null || true)"
  if [[ -z "$current_commit" ]]; then
    append_check "Current Branch Remote Synchronization" "ISSUE" \
      "Unable to capture current commit for backup. Sync aborted."
    increment_counter REMEDIATIONS_FAILED
    return 1
  fi

  local backup_ref=""
  backup_ref="refs/briteTest/backups/fixlocal/${current_branch//\//-}-${RUN_ID}"
  if ! git -C "$CURRENT_REPO" update-ref "$backup_ref" "$current_commit" >/dev/null 2>&1; then
    append_check "Current Branch Remote Synchronization" "ISSUE" \
      "Unable to create backup ref '$backup_ref'. Sync aborted to preserve safety."
    increment_counter REMEDIATIONS_FAILED
    return 1
  fi

  if [[ "$FORCE_LOCAL_STABILIZATION" == true && "$dirty_force_needed" == true ]]; then
    if ! git -C "$CURRENT_REPO" reset --hard HEAD >/dev/null 2>&1; then
      append_check "Current Branch Remote Synchronization" "ISSUE" \
        "Force mode failed to reset working tree to HEAD. Restore point: $backup_ref"
      increment_counter REMEDIATIONS_FAILED
      return 1
    fi
    if ! git -C "$CURRENT_REPO" clean -fd >/dev/null 2>&1; then
      append_check "Current Branch Remote Synchronization" "ISSUE" \
        "Force mode failed to clean untracked files. Restore point: $backup_ref"
      increment_counter REMEDIATIONS_FAILED
      return 1
    fi
  fi

  if [[ "$FORCE_LOCAL_STABILIZATION" == true && "$ahead" -gt 0 ]]; then
    if git -C "$CURRENT_REPO" reset --hard "$upstream" >/dev/null 2>&1; then
      counts="$(git -C "$CURRENT_REPO" rev-list --left-right --count HEAD..."$upstream" 2>/dev/null || true)"
      counts="$(safe_trim_spaces "$counts")"
      ahead=""
      behind=""
      extra=""
      read -r ahead behind extra <<< "$counts"

      if [[ "$ahead" =~ ^[0-9]+$ ]] && [[ "$behind" =~ ^[0-9]+$ ]] && [[ -z "$extra" ]] && [[ "$ahead" -eq 0 ]] && [[ "$behind" -eq 0 ]]; then
        append_check "Current Branch Remote Synchronization" "FIXED" \
          "Forced reset to '$upstream' completed for '$current_branch'. Backup ref: $backup_ref"
        increment_counter REMEDIATIONS_VERIFIED
        return 0
      fi

      append_check "Current Branch Remote Synchronization" "ISSUE" \
        "Forced reset executed but verification did not converge to '$upstream'. Restore point: $backup_ref"
      increment_counter REMEDIATIONS_UNVERIFIED
      return 1
    fi

    append_check "Current Branch Remote Synchronization" "ISSUE" \
      "Forced reset to '$upstream' failed for '$current_branch'. Restore point: $backup_ref"
    increment_counter REMEDIATIONS_FAILED
    return 1
  fi

  if git -C "$CURRENT_REPO" merge --ff-only "$upstream" >/dev/null 2>&1; then
    counts="$(git -C "$CURRENT_REPO" rev-list --left-right --count HEAD..."$upstream" 2>/dev/null || true)"
    counts="$(safe_trim_spaces "$counts")"
    ahead=""
    behind=""
    extra=""
    read -r ahead behind extra <<< "$counts"

    if [[ "$ahead" =~ ^[0-9]+$ ]] && [[ "$behind" =~ ^[0-9]+$ ]] && [[ -z "$extra" ]] && [[ "$behind" -eq 0 ]]; then
      append_check "Current Branch Remote Synchronization" "FIXED" \
        "Fast-forward sync completed for '$current_branch'. Backup ref: $backup_ref"
      increment_counter REMEDIATIONS_VERIFIED
      return 0
    fi

    append_check "Current Branch Remote Synchronization" "ISSUE" \
      "Fast-forward merge ran, but verification did not confirm sync. Review branch state; backup ref: $backup_ref"
    increment_counter REMEDIATIONS_UNVERIFIED
    return 1
  fi

  append_check "Current Branch Remote Synchronization" "ISSUE" \
    "Fast-forward merge failed for '$current_branch' from '$upstream'. Restore point: $backup_ref"
  increment_counter REMEDIATIONS_FAILED
  return 1
}

check_loose_objects() {
  append_section "Repository Optimization"

  local loose_count=0
  if [[ -d "$CURRENT_REPO/.git/objects" ]]; then
    loose_count="$(find "$CURRENT_REPO/.git/objects" -type f ! -path '*/pack/*' \
      2>/dev/null | wc -l | tr -d ' ')"
  fi

  if [[ "$loose_count" =~ ^[0-9]+$ ]] && [[ "$loose_count" -gt 100 ]]; then
    local status_type="ISSUE"
    if [[ "$DRY_RUN" == true ]]; then
      status_type="FIXABLE"
    fi
    append_check "Loose Objects" "$status_type" \
      "Found $loose_count loose objects (threshold: 100)." \
      "true"
  else
    append_check "Loose Objects" "PASS" \
      "Repository has $loose_count loose objects (below threshold)"
  fi
}

check_large_objects() {
  append_section "Object Size Analysis"

  local large_objects
  large_objects="$(
    git -C "$CURRENT_REPO" rev-list --objects --all 2>/dev/null | \
      git -C "$CURRENT_REPO" cat-file --batch-check='%(objecttype) %(objectsize) %(rest)' \
      2>/dev/null | \
      awk '$1=="blob" && $2 > 10485760 {count++} END {print count+0}'
  )"

  if [[ "$large_objects" =~ ^[0-9]+$ ]] && [[ "$large_objects" -gt 0 ]]; then
    append_check "Large Objects (>10MB)" "ISSUE" \
      "Found $large_objects blobs larger than 10MB. Not auto-handled; suggested fix: Migrate large files to Git LFS and consider history rewrite if needed."
  else
    append_check "Large Objects" "PASS" "No blobs larger than 10MB detected"
  fi
}

check_working_directory() {
  append_section "Working Directory Status"

  local current_branch
  current_branch="$(git -C "$CURRENT_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')"

  local status_output
  status_output="$(filtered_status_output "$CURRENT_REPO")"

  if [[ -n "$status_output" ]]; then
    local file_count
    file_count="$(printf '%s\n' "$status_output" | wc -l | tr -d ' ')"
    append_check "Uncommitted Changes" "PASS" \
      "Working directory has $file_count changed tracked/untracked entries"
  else
    append_check "Uncommitted Changes" "PASS" "Working directory is clean"
  fi

  append_check "Current Branch" "PASS" "Currently on branch: $current_branch"
}

check_repository_structure() {
  append_section "Repository Structure"

  # Repository-specific: these paths reflect the expected repo layout.
  local required_items=(
    ".git"
    ".gitignore"
    "README.md"
    "scripts"
    "scripts/bin"
    "scripts/helpers"
    "reports"
  )

  local missing_items=0
  local item
  for item in "${required_items[@]}"; do
    if [[ -e "$CURRENT_REPO/$item" ]]; then
      append_check "Exists: $item" "PASS" ""
    else
      append_check "Missing: $item" "ISSUE" \
        "Required item not found. Not auto-handled; suggested fix: Restore from main branch or a trusted clone."
      missing_items=$((missing_items + 1))
    fi
  done

  if [[ "$missing_items" -gt 0 ]]; then
    append_check "Repository Structure" "ISSUE" \
      "Missing $missing_items required items. Not auto-handled; suggested fix: Restore missing files/directories from main branch or a trusted clone."
  fi
}

check_repository_layout() {
  append_section "Repository Structure Checks"

  local target_kind="repository"
  if [[ "$CURRENT_TARGET_NAME" == "Clone Repository" ]]; then
    target_kind="clone"
  fi

  if ! has_required_api_files "$CURRENT_REPO"; then
    append_check "Repository Structure Checks" "PASS" \
      "Repository structure checks skipped for this $target_kind because it does not appear to have required API files."
    return 0
  fi

  append_check "Repository Structure Checks" "PASS" \
    "Repository has required API files; running layout checks."
  check_repository_structure
}

cleanup_repository() {
  if [[ "$DRY_RUN" == true ]] || [[ "$TARGET_FIXABLE_ISSUES_FOUND" -eq 0 ]]; then
    if [[ "$DRY_RUN" == false ]] && [[ "$TARGET_ISSUES_FOUND" -gt 0 ]]; then
      append_section "Cleanup Operations"
      append_check "Safe Cleanup" "PASS" \
        "No fixable issues detected; cleanup skipped"
    fi
    return 0
  fi

  append_section "Cleanup Operations"
  log_verbose "Performing safe cleanup for $CURRENT_TARGET_NAME..."

  increment_counter REMEDIATIONS_ATTEMPTED
  if git -C "$CURRENT_REPO" gc --prune=now >/dev/null 2>&1; then
    append_check "Garbage Collection" "PASS" "Ran garbage collection and object pruning"

    verify_cleanup_effects
  else
    append_check "Garbage Collection" "ISSUE" \
      "Garbage collection failed during cleanup. Not auto-handled; contact the repository owner to investigate the cleanup failure."
    increment_counter REMEDIATIONS_FAILED
  fi
}

verify_cleanup_effects() {
  append_section "Post-Cleanup Verification"

  local verification_failed=false
  local loose_count=0
  local fsck_output

  fsck_output="$(git -C "$CURRENT_REPO" fsck --full 2>&1 || true)"

  if ! printf '%s\n' "$fsck_output" | grep -Eq '(^|[[:space:]])(error|fatal):'; then
    append_check "Object Database" "PASS" "Repository integrity check passed after cleanup"
  else
    append_check "Object Database" "ISSUE" \
      "Repository integrity check still reports issues after cleanup. Not auto-handled; contact the repository owner for recovery assistance."
    verification_failed=true
  fi

  if [[ -d "$CURRENT_REPO/.git/objects" ]]; then
    loose_count="$(find "$CURRENT_REPO/.git/objects" -type f ! -path '*/pack/*' \
      2>/dev/null | wc -l | tr -d ' ')"
  fi

  if [[ "$loose_count" =~ ^[0-9]+$ ]] && [[ "$loose_count" -le 100 ]]; then
    append_check "Loose Objects" "PASS" \
      "Post-cleanup loose object count is $loose_count (below threshold)"
  else
    append_check "Loose Objects" "ISSUE" \
      "Post-cleanup loose object count remains above threshold or could not be determined. Not auto-handled; suggested fix: Contact the repository owner for further investigation."
    verification_failed=true
  fi

  local dangling_count
  dangling_count="$(printf '%s\n' "$fsck_output" | grep -c '^dangling ' || true)"
  if [[ "$dangling_count" =~ ^[0-9]+$ ]] && [[ "$dangling_count" -eq 0 ]]; then
    append_check "Dangling Objects" "FIXED" "All dangling objects pruned"
  else
    append_check "Dangling Objects" "PASS" "$dangling_count dangling objects remain (normal)"
  fi

  if [[ "$verification_failed" == false ]]; then
    append_check "Repository Cleanup" "FIXED" \
      "Safe cleanup completed and post-cleanup verification passed."
    increment_counter REMEDIATIONS_VERIFIED
  else
    append_check "Repository Cleanup" "ISSUE" \
      "Cleanup completed, but post-cleanup verification still found issues. Not auto-handled; suggested fix: Review the verification failures above."
    increment_counter REMEDIATIONS_UNVERIFIED
  fi
}

run_target_checks() {
  local target_name="$1"
  local target_path="$2"

  CURRENT_TARGET_NAME="$target_name"
  CURRENT_REPO="$target_path"
  TARGET_ISSUES_FOUND=0
  TARGET_FIXABLE_ISSUES_FOUND=0

  log_verbose "Checking ${CURRENT_TARGET_NAME}: ${CURRENT_REPO}"

  append_target_header "$CURRENT_TARGET_NAME" "$CURRENT_REPO"

  check_git_validity || return 1
  check_object_database || true
  check_remote_connectivity || true
  check_all_local_branch_tracking || true
  check_loose_objects
  check_large_objects
  check_working_directory
  safe_sync_current_branch_from_upstream || true
  check_repository_layout
  cleanup_repository

  return 0
}

finalize_report() {
  local issues_remaining
  issues_remaining=$((ISSUES_FOUND - ISSUES_FIXED))
  if [[ "$issues_remaining" -lt 0 ]]; then
    issues_remaining=0
  fi

  cat >> "$OUTPUT_FILE" << EOF

## Summary

**Issues Detected:** $ISSUES_FOUND  
**Fixable Issues Detected:** $FIXABLE_ISSUES_FOUND  
**Auto-Handled Attempts:** $REMEDIATIONS_ATTEMPTED  
**Remediations Verified:** $REMEDIATIONS_VERIFIED  
**Remediations Not Verified:** $REMEDIATIONS_UNVERIFIED  
**Remediations Failed:** $REMEDIATIONS_FAILED  
**Issues Remaining:** $issues_remaining

EOF

  if [[ "$ISSUES_FOUND" -eq 0 && "$FIXABLE_ISSUES_FOUND" -eq 0 ]]; then
    cat >> "$OUTPUT_FILE" << 'EOF'
Status: Repository health checks passed with no issues detected.
EOF
  elif [[ "$DRY_RUN" == true ]] && [[ "$ISSUES_FOUND" -eq 0 ]]; then
    cat >> "$OUTPUT_FILE" << 'EOF'
Status: Fixable items detected; no automated fixes applied (-d).
EOF
  elif [[ "$DRY_RUN" == true ]]; then
    cat >> "$OUTPUT_FILE" << 'EOF'
Status: Issues and fixable items detected; no automated fixes applied (-d).
EOF
  elif [[ "$issues_remaining" -eq 0 && "$REMEDIATIONS_VERIFIED" -gt 0 ]]; then
    cat >> "$OUTPUT_FILE" << 'EOF'
Status: All detected issues were resolved by verified remediations.
EOF
  elif [[ "$REMEDIATIONS_VERIFIED" -gt 0 ]]; then
    cat >> "$OUTPUT_FILE" << 'EOF'
Status: Some automated remediations were verified; unresolved issues may remain.
EOF
  elif [[ "$REMEDIATIONS_ATTEMPTED" -gt 0 ]]; then
    cat >> "$OUTPUT_FILE" << 'EOF'
Status: Remediation attempts were made, but none were fully verified.
EOF
  else
    cat >> "$OUTPUT_FILE" << 'EOF'
Status: Issues detected; no automated fixes were recorded.
EOF
  fi

  # Dynamic recommendations based on what was found
  local recs=""
  if [[ "$ISSUES_FOUND" -gt 0 ]]; then
    recs+="- Review ISSUE items in this report.\n"
  fi
  if [[ "$FIXABLE_ISSUES_FOUND" -gt 0 && "$DRY_RUN" == true ]]; then
    recs+="- Re-run fixlocal without -d to apply safe cleanup.\n"
  fi
  if grep -q '\[ISSUE\] \*\*Origin Reachability\*\*' "$OUTPUT_FILE" 2>/dev/null; then
    recs+="- If remote appears unreachable, verify network/auth and remote URL.\n"
  fi
  if [[ "$REMEDIATIONS_FAILED" -gt 0 ]] || [[ "$CRITICAL_ERROR" == true ]]; then
    recs+="- For persistent errors, contact the repository owner for assistance.\n"
  fi

  if [[ -n "$recs" ]]; then
    printf '\n### Recommendations\n\n' >> "$OUTPUT_FILE"
    printf '%b' "$recs" >> "$OUTPUT_FILE"
  fi

  cat >> "$OUTPUT_FILE" << 'EOF'

### Handling Notes

- "Auto-Handled Attempts" counts safe remediation actions attempted.
- "Remediations Verified" means remediation succeeded and verification passed.
- "Remediations Not Verified" means remediation ran but verification did not pass.
- "Remediations Failed" means remediation command did not complete successfully.
- "Issues Remaining" reflects unresolved issues after verified remediations.
- "Remaining" means manual follow-up is still recommended.

Report Generated: This report is committed to the current branch for diagnostics.
EOF
}

cleanup_old_reports() {
  local old_report
  local keep_recent_cutoff
  local report_list=()

  # shellcheck disable=SC2034  # Consumed indirectly by shared report helper.
  REPOSITORY_REPORT_DELETIONS=()

  [[ -f "$OUTPUT_FILE" ]] || return

  # Repository-specific: keep a small rolling history and recent month of diagnostics.
  keep_recent_cutoff=$(( $(date +%s) - (30 * 24 * 60 * 60) ))

  while IFS= read -r old_report; do
    [[ -n "$old_report" ]] || continue
    report_list+=("$old_report")
  done < <(ls -1t "$REPOSITORY_REPORTS_DIR"/repository-*.md 2>/dev/null || true)

  local report_index=0
  local report_mtime
  for old_report in "${report_list[@]}"; do
    [[ -e "$old_report" ]] || continue

    report_mtime=$(stat -c '%Y' "$old_report" 2>/dev/null || echo 0)
    if [[ "$old_report" == "$OUTPUT_FILE" ]] || [[ "$report_index" -lt 5 ]] || [[ "$report_mtime" -ge "$keep_recent_cutoff" ]]; then
      :
    else
      bt_report_remove_and_record \
        "$REPO_ROOT" REPOSITORY_REPORT_DELETIONS "$old_report" \
        "repository report"
    fi
    report_index=$((report_index + 1))
  done
}



POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -v)
      VERBOSE=true
      shift
      ;;
    -d)
      DRY_RUN=true
      shift
      ;;
    -f)
      FORCE_LOCAL_STABILIZATION=true
      shift
      ;;
    -r)
      [[ $# -ge 2 ]] || usage_error "Missing value for $1"
      REMOTE_TIMEOUT_SECONDS="$2"
      shift 2
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ "${#POSITIONAL[@]}" -gt 0 ]]; then
  usage_error "Unexpected argument(s): ${POSITIONAL[*]}"
fi

if ! is_valid_timeout_seconds "$REMOTE_TIMEOUT_SECONDS"; then
  usage_error "Invalid -r value: $REMOTE_TIMEOUT_SECONDS (expected integer >= 0)"
fi

if [[ ! -d "$REPO_ROOT/reports" ]]; then
  bt_error_exit "$EXIT_MISSING_DEPENDENCIES" "Reports directory not found: $REPO_ROOT/reports"
fi

require_contributor_role

if ! mkdir -p "$REPOSITORY_REPORTS_DIR"; then
  bt_error_exit "$EXIT_MISSING_DEPENDENCIES" "Unable to create reports directory: $REPOSITORY_REPORTS_DIR"
fi

OUTPUT_FILE="$REPOSITORY_REPORTS_DIR/repository-${RUN_ID}.md"

add_target_repo "This Repository" "$REPO_ROOT"

init_report

index=0
for target_path in "${TARGET_PATHS[@]}"; do
  run_target_checks "${TARGET_NAMES[$index]}" "$target_path" || true
  index=$((index + 1))
done

finalize_report
cleanup_old_reports
bt_report_mark_read_only "$OUTPUT_FILE" "$EXIT_MISSING_DEPENDENCIES"

ISSUES_REMAINING=$((ISSUES_FOUND - REMEDIATIONS_VERIFIED))
if [[ "$ISSUES_REMAINING" -lt 0 ]]; then
  ISSUES_REMAINING=0
fi

echo "Issues: $ISSUES_FOUND found  $ISSUES_FIXED fixed  $ISSUES_REMAINING remaining.  Fixable: $FIXABLE_ISSUES_FOUND."
echo "See ${OUTPUT_FILE#"${REPO_ROOT}"/} for details."

if [[ "$VERBOSE" == true ]]; then
  echo ""
  echo "Report contents:"
  sed 's/^/  /' "$OUTPUT_FILE"
fi

if [[ "$CRITICAL_ERROR" == true ]]; then
  exit "$EXIT_MISSING_DEPENDENCIES"
fi

if [[ "$ISSUES_REMAINING" -gt 0 ]]; then
  exit "$EXIT_ISSUES_DETECTED"
fi

if [[ "$DRY_RUN" == true ]] && [[ "$FIXABLE_ISSUES_FOUND" -gt 0 ]]; then
  exit "$EXIT_FIXABLE_ONLY"
fi

exit 0
