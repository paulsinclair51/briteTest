#!/usr/bin/env bash

# feedback - Handle and respond to PR review feedback.
#
# See usage below for details, or run: feedback -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  feedback [ACTION] [OPTIONS]
  feedback {-h | --help}

Handle and respond to pull request review feedback.

This script guides you through addressing reviewer comments and maintaining
communication during the PR review cycle. It helps coordinate feedback,
track changes, and update your PR accordingly.

Actions:
  view      Show all feedback/comments on current PR
  update    Commit fixes to address feedback
  respond   Add a response comment to PR
  sync      Sync changes and push to PR
  resolve   Mark feedback as resolved

Features:
  - Fetch and display PR review comments
  - Track feedback from reviewers
  - Help structure response commits
  - Sync local changes to remote PR
  - Document how feedback was addressed
  - Coordinate with multiple reviewers

Options:
  -h, --help           Output this help to stdout and exit (other options
                       and arguments are ignored).
  -v, --verbose        Show detailed information
  -m, --message MSG    Add comment message (GitHub style)
  -- TEXT              Unix-style comment (everything after --)
  -c, --comment ID     Reference specific comment to address

Workflow:

  1. View feedback:
     feedback view

  2. Make changes locally to address feedback:
     # Edit files
     git add .

  3. Commit changes with reference to feedback:
     feedback update -m "Address reviewer feedback on auth logic"

  4. Push to PR:
     feedback sync

  5. Respond to reviewer:
    feedback respond -m "Fixed as requested, auth now validates"
    "tokens properly"

Examples:

  # Show all comments on current PR
  feedback view

  # Show all comments with verbose detail
  feedback view -v

  # Commit fixes for feedback
  feedback update -m "Add null-check in parser as requested"

  # Push updates to PR
  feedback sync

  # Add response to PR
  feedback respond -m "Updated error handling as discussed"

  # Mark feedback resolved
  feedback resolve -c comment-id

Workflow Scenarios:

  Scenario 1: Small changes requested
  ---------------------------------
  feedback view              # See what's requested
  # Edit files...
  feedback update -m "Fix parameter validation"
  feedback sync              # Push changes

  Scenario 2: Multiple reviewers with different feedback
  -------------------------------------------------------
  feedback view -v           # See all comments with context
  # Address feedback from reviewer 1
  feedback update -m "Fix race condition in worker thread"
  # Address feedback from reviewer 2
  feedback update -m "Add error handling for edge case"
  feedback sync              # Push all fixes together

  Scenario 3: Request clarification
  ----------------------------------
  feedback view              # See feedback
  feedback respond -m "Question: Should this handle null input?"
  # Wait for clarification
  feedback view              # Check for response
  # Make changes based on clarification
  feedback update
  feedback sync

  Scenario 4: Disagreement with feedback
  ----------------------------------------
  feedback view              # See feedback
  feedback respond -m "This approach is intentional because X."
  "Alternative would be Y."
  # If reviewer agrees, continue
  # If reviewer insists, make the change
  feedback update -m "Changed approach per reviewer request"
  feedback sync

Remote Workflow (Codespaces, SSH, etc.):

  When working in Codespaces or remote environments:
  - Use `feedback view` to see feedback without browser
  - Use `feedback update` to organize your commits
  - Use `feedback respond` to communicate feedback resolutions
  - Use `feedback sync` to push changes from remote environment


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented
    output locations.

Exit codes:
  0   Success.
  1   Invalid option or argument.
  2   Failed to fetch PR feedback.
  3   No PR associated with current branch.
  4   GitHub API error.
EOF
}

# High-Level Flow:
# - Supports PR feedback actions: view, update, respond, sync, and resolve.
# - Fetches PR/review context with gh and applies follow-up fixes with git.
# - Validates branch/PR/message prerequisites and returns action-specific
#   failure codes.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/github_helpers.sh
source "$SCRIPT_DIR/../helpers/github_helpers.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"

readonly EXIT_SUCCESS=0
readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_NOT_FOUND=2
readonly EXIT_OPERATION_FAILED=3
readonly EXIT_CONFIG_ERROR=4

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "Invalid option or argument. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

# Default options
VERBOSE=false
ACTION=""
COMMENT=""


get_pr_number() {
  local branch="$1"
  
  # Try to find PR for this branch
  # In real implementation, would use GitHub API or gh cli
  if command -v gh &> /dev/null; then
    bt_gh_find_pr_number_for_branch "$branch" "open"
  else
    echo ""
  fi
}

view_feedback() {
  local branch
  local pr_number
  
  branch=$(bt_get_current_branch || \
    bt_error_exit "$EXIT_NOT_FOUND" "Failed to determine current branch")
  bt_info "Current branch: $branch"
  
  if command -v gh &> /dev/null; then
    pr_number=$(get_pr_number "$branch")
    
    if [[ -z "$pr_number" ]]; then
      bt_error_exit "$EXIT_OPERATION_FAILED" "No PR found for branch '$branch'." \
        "Create a PR first using review."
    fi
    
    bt_info "Fetching reviews for PR #$pr_number..."
    
    if [[ "$VERBOSE" == true ]]; then
      gh pr view "$pr_number" --comments
    else
      gh pr view "$pr_number"
    fi
    
    bt_success "Done"
  else
    bt_error_exit "$EXIT_CONFIG_ERROR" "GitHub CLI (gh) not installed." \
      "Install gh to use feedback."
  fi
}

update_for_feedback() {
  local branch
  
  branch=$(bt_get_current_branch || \
    bt_error_exit "$EXIT_NOT_FOUND" "Failed to determine current branch")
  bt_info "Current branch: $branch"
  
  if [[ -z "$COMMENT" ]]; then
    usage_error "Message required. Use -m or -- to provide commit message."
  fi
  
  bt_info "Staging changes..."
  if ! git add . 2>&1; then
    bt_error_exit "$EXIT_NOT_FOUND" "Failed to stage changes"
  fi
  
  # Check if there are changes to commit
  if ! git diff --cached --quiet; then
    bt_info "Committing feedback fixes..."
    if ! git commit -m "$COMMENT" 2>&1; then
      bt_error_exit "$EXIT_NOT_FOUND" "Failed to commit changes"
    fi
    bt_success "Changes committed: $COMMENT"
  else
    bt_warn "No staged changes to commit"
  fi
}

sync_to_pr() {
  local branch
  
  branch=$(bt_get_current_branch || \
    bt_error_exit "$EXIT_NOT_FOUND" "Failed to determine current branch")
  bt_info "Current branch: $branch"
  
  bt_info "Pushing changes to remote..."
  if ! git push origin "$branch" 2>&1; then
    bt_error_exit "$EXIT_NOT_FOUND" "Failed to push changes"
  fi
  
  bt_success "Changes pushed to PR"
  
  # Propagate repository history from remote if available
  bt_propagate_repository_history
  case $? in
    0) ;;
    1) bt_info "Updated repository history from remote" ;;
    *) ;;
  esac
  
  if command -v gh &> /dev/null; then
    bt_info "PR updated and ready for review"
  fi
}

respond_to_feedback() {
  local branch
  local pr_number
  
  branch=$(bt_get_current_branch || \
    bt_error_exit "$EXIT_NOT_FOUND" "Failed to determine current branch")
  
  if command -v gh &> /dev/null; then
    pr_number=$(get_pr_number "$branch")
    
    if [[ -z "$pr_number" ]]; then
      bt_error_exit "$EXIT_OPERATION_FAILED" "No PR found for branch '$branch'."
    fi
    
    if [[ -z "$COMMENT" ]]; then
      usage_error "Comment required. Use -m or -- to provide response."
    fi
    
    bt_info "Adding comment to PR #$pr_number..."
    if ! gh pr comment "$pr_number" -b "$COMMENT" 2>&1; then
      bt_error_exit "$EXIT_CONFIG_ERROR" "Failed to add comment to PR"
    fi
    
    bt_success "Comment added to PR"
  else
    bt_error_exit "$EXIT_CONFIG_ERROR" "GitHub CLI (gh) not installed."
  fi
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -m requires a message argument"
      fi
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -m and -- for message"
      fi
      COMMENT="$2"
      shift 2
      ;;
    -c | --comment)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -c requires a comment ID"
      fi
      shift 2
      ;;
    --)
      # Unix-style message
      shift
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -m and -- for message"
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      if [[ -z "$ACTION" ]]; then
        ACTION="$1"
        shift
      else
        usage_error "Unexpected argument: $1"
      fi
      ;;
  esac
done

# Validate action
if [[ -z "$ACTION" ]]; then
  usage_error "ACTION required (view, update, respond, sync, or resolve)"
fi

# Dispatch to appropriate function
case "$ACTION" in
  view)
    view_feedback
    ;;
  update)
    update_for_feedback
    ;;
  sync)
    sync_to_pr
    ;;
  respond)
    respond_to_feedback
    ;;
  resolve)
    bt_success "Feedback resolved (manual action needed in GitHub)"
    ;;
  *)
    usage_error "Unknown action: $ACTION" \
      "(valid: view, update, respond, sync, resolve)"
    ;;
esac

exit 0
