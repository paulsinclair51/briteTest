#!/usr/bin/env bash

# mkrebase - Rebase current branch onto a different base branch.
#
# See usage below for details, or run: mkrebase -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

usage() {
  cat <<'EOF'
Usage:
  mkrebase [OPTIONS] <newbasebranch>
  mkrebase -h | --help

Rebase the current branch onto a different base branch, effectively retargeting
the branch to target a different release or feature base.

Arguments:
  <newbasebranch>    Name of the branch to rebase onto (the new base).

  Example: Retarget a feature branch based on v2.1.0 to be targeted to v2.2.0.
    mkrebase v2.2.0

  This rebases the current branch onto v2.2.0 and updates it to be based on
  that version instead.

Options:
  -h, --help        Output this help to stdout and exit (other options
                    and arguments are ignored).
  -v                Validate only without performing rebase (dry-run).
  -f, --force       Force rebase with --force-with-lease push to remote.
  -m "MSG"          Attach a comment/reason to the operation
                    Usage: mkrebase v2.2.0 -m "Retarget to latest minor release."
  --message "MSG"   Attach a comment/reason to the operation
                    Usage: mkrebase v2.2.0 --message "Retarget to latest minor release."
  -- MSG            Attach comment/reason (everything after -- is the comment)
                    Usage: mkrebase v2.2.0 -- Retarget to latest minor release
                    Note: No quotes needed, captures all remaining arguments.

   Note: -m "MSG", --message "MSG", -- MSG are mutually exclusive.

Modes:
  Rebase (default):
    - Verify the current branch can be rebased (not main, not a version branch).
    - Verify the new base branch exists locally or remotely.
    - Perform git rebase onto the new base branch.
    - Log the operation to 'logs/remote_branch_history.md'.
    - Show instructions for force pushing if needed.

  Validate (-v):
    - Verify the current branch can be rebased.
    - Verify the new base branch exists.
    - Check if rebase would succeed without actually performing it.
    - Report validity without making changes.
    - Exit with status code indicating validity.

Examples: Basic usage.
  mkrebase v2.2.0
  mkrebase main

Examples: With comment.
  mkrebase v2.2.0 -m "Retarget to latest minor release."
  mkrebase main -- Retarget feature to main

Examples: Validation mode.
  mkrebase -v v2.2.0
  mkrebase -v main

Examples: With force push.
  mkrebase -f v2.2.0
  mkrebase -f v2.2.0 -m "Retarget and force push."


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented output locations.

Exit codes:
  0   Success (or validation passed).
  1   Arguments/options invalid.
  2   Invalid branch name or branch state.
  3   Invalid option.
  4   Conflicting options.
  5   Git operation failed.
  7   Base branch doesn't exist.
  9   Validation failed.
EOF
}

# High-Level Flow:
# - Rebases the current branch onto a specified base branch.
# - Runs preflight checks to reduce risky rebase operations.
# - Reports rebase progress and conflict/error states.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOG_FILE="$REPO_ROOT/logs/remote_branch_history.md"

# Shared helpers
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"

# Default options
MODE="rebase"  # rebase or validate
FORCE=false
COMMENT=""


log_operation() {
  local status="$1"
  local branch="$2"
  local newbase="$3"
  local message="$4"
  local comment="${5:-}"

  # status/branch/newbase are retained for compatibility with existing callers.
  : "$status" "$branch" "$newbase"
  bt_append_history_log "$LOG_FILE" "$message" "$comment"
}

error_exit() {
  local code="$1"
  local message="$2"
  local branch="${3:-}"
  local newbase="${4:-}"
  local comment="${5:-}"

  echo "Error: $message" >&2

  if [[ -n "$branch" && -n "$newbase" ]]; then
    log_operation "FAILED" "$branch" "$newbase" "Rebase of \`$branch\` onto \`$newbase\` failed - $message" "$comment"
  fi

  exit "$code"
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v)
      MODE="validate"
      shift
      ;;
    -f | --force)
      FORCE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -m requires a message argument" "" "" ""
      fi
      if [[ -n "$COMMENT" ]]; then
        error_exit 4 "Cannot use both -m and -- for comment" "" "" ""
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        error_exit 4 "Cannot use both -m and -- for comment" "" "" ""
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      error_exit 3 "Unknown option: $1" "" "" ""
      ;;
    *)
      # Positional argument
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Check that we have exactly 1 positional argument
if [[ $# -ne 1 ]]; then
  error_exit 1 "Expected 1 argument (newbasebranch), got $#" "" "" ""
fi

NEWBASE="$1"

# Validate arguments
if [[ -z "$NEWBASE" ]]; then
  error_exit 1 "New base branch name cannot be empty" "" "" "" "$COMMENT"
fi

# Change to repo root
cd "$REPO_ROOT"

# Get current branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)

# Validate current branch state
if [[ "$CURRENT_BRANCH" == "HEAD" ]]; then
  error_exit 2 "You are in a detached HEAD state. Please checkout a branch first." "$CURRENT_BRANCH" "$NEWBASE" "" "$COMMENT"
fi

if [[ -z "$CURRENT_BRANCH" ]]; then
  error_exit 2 "Failed to determine current branch." "" "$NEWBASE" "" "$COMMENT"
fi

if [[ "$CURRENT_BRANCH" == "main" ]]; then
  error_exit 2 "Cannot rebase the main branch. Please checkout a feature branch first." "$CURRENT_BRANCH" "$NEWBASE" "" "$COMMENT"
fi

# Check if current branch contains a period (version branch like v2.1.3)
if [[ "$CURRENT_BRANCH" == *"."* ]]; then
  error_exit 2 "Cannot rebase release/version branches (branches with version numbers like v2.1.3). Use 'mkmerge' to integrate version branches." "$CURRENT_BRANCH" "$NEWBASE" "" "$COMMENT"
fi

# Fetch latest refs from remote
echo "Fetching latest refs from remote..."
if ! git fetch origin >/dev/null 2>&1; then
  error_exit 5 "Failed to fetch from remote" "$CURRENT_BRANCH" "$NEWBASE" "" "$COMMENT"
fi

# Check if new base branch exists (check both local and remote)
if ! git rev-parse --verify "$NEWBASE" >/dev/null 2>&1; then
  if ! git rev-parse --verify "origin/$NEWBASE" >/dev/null 2>&1; then
    if [[ "$MODE" == "validate" ]]; then
      echo "Base branch '$NEWBASE' does not exist"
      exit 9
    else
      error_exit 7 "Base branch '$NEWBASE' does not exist" "$CURRENT_BRANCH" "$NEWBASE" "" "$COMMENT"
    fi
  fi
  NEWBASE="origin/$NEWBASE"
fi

# If validate mode, we're done (all checks passed)
if [[ "$MODE" == "validate" ]]; then
  echo "Branch '$CURRENT_BRANCH' can be rebased onto '$NEWBASE'"
  exit 0
fi

# Perform the rebase
echo "Rebasing '$CURRENT_BRANCH' onto '$NEWBASE'..."
if ! git rebase "$NEWBASE"; then
  error_exit 5 "Failed to rebase branch '$CURRENT_BRANCH' onto '$NEWBASE'. Resolve conflicts and run 'git rebase --continue' or 'git rebase --abort'." "$CURRENT_BRANCH" "$NEWBASE" "" "$COMMENT"
fi

echo "Successfully rebased '$CURRENT_BRANCH' onto '$NEWBASE'"

# Log the operation
log_operation "SUCCESS" "$CURRENT_BRANCH" "$NEWBASE" "Branch \`$CURRENT_BRANCH\` rebased onto \`$NEWBASE\`." "$COMMENT"

# Show instructions for pushing
echo ""
if [[ "$FORCE" == true ]]; then
  echo "Force pushing to remote with --force-with-lease..."
  if ! git push origin "$CURRENT_BRANCH" --force-with-lease; then
    error_exit 5 "Failed to force push branch to remote" "$CURRENT_BRANCH" "$NEWBASE" "" "$COMMENT"
  fi
  echo "Branch successfully force pushed to remote"
  log_operation "SUCCESS" "$CURRENT_BRANCH" "$NEWBASE" "Branch \`$CURRENT_BRANCH\` force pushed to remote after rebase onto \`$NEWBASE\`." "$COMMENT"
else
  echo "To push the rebased branch to remote (use with caution, as history is rewritten):"
  echo "  git push origin $CURRENT_BRANCH --force-with-lease"
fi

exit 0
