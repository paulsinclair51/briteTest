#!/usr/bin/env bash

# mkbranch - Create a new branch.
#
# See usage below for details, or run: mkbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  mkbranch BRANCHNAME PARENTBRANCH [OPTIONS]
  mkbranch -h | --help

Create a new local or remote branch.

Arguments:
  BRANCHNAME         Name of the new branch (required)
                     Format: [type/]description-version
  PARENTBRANCH       Parent branch to base new branch on (required)
                     Example: main, v1.2.3, dev/feature-v1.0.0

Options:
  -h, --help         Output this help to stdout and exit
  -l, --local        Create only local branch (default: local only)
  -r, --remote       Push to remote after creation
  -v, --verbose      Show detailed progress information

Examples:
  # Create local branch
  mkbranch patch/my-fix main

  # Create and push to remote
  mkbranch fix/auth-bug v1.0.0 -r

Outputs:
  - Writes status messages to stdout
  - Writes errors to stderr

Exit codes:
  0  Success
  1  Argument or validation error
  2  Git operation failed
  3  Branch already exists
EOF
}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Ensure Git hooks are installed
ensure_hooks_installed

# Default options
BRANCHNAME=""
PARENTBRANCH=""
PUSH_REMOTE=false
VERBOSE=false

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -l | --local)
      PUSH_REMOTE=false
      shift
      ;;
    -r | --remote)
      PUSH_REMOTE=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -)
      bt_error_exit 1 "Invalid option: $1"
      ;;
    *)
      if [[ -z "$BRANCHNAME" ]]; then
        BRANCHNAME="$1"
      elif [[ -z "$PARENTBRANCH" ]]; then
        PARENTBRANCH="$1"
      else
        bt_error_exit 1 "Unexpected argument: $1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$BRANCHNAME" || -z "$PARENTBRANCH" ]]; then
  bt_error_exit 1 "BRANCHNAME and PARENTBRANCH are required"
fi

cd "$REPO_ROOT"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  bt_error_exit 1 "Not in a Git repository"
fi

bt_info "Creating branch: $BRANCHNAME from $PARENTBRANCH"

# Fetch latest from remote
git fetch origin >/dev/null 2>&1 || bt_warn "Failed to fetch from origin"

# Check if branch already exists
if git show-ref --verify --quiet "refs/heads/$BRANCHNAME"; then
  bt_error_exit 3 "Local branch '$BRANCHNAME' already exists"
fi

if git show-ref --verify --quiet "refs/remotes/origin/$BRANCHNAME"; then
  bt_error_exit 3 "Remote branch '$BRANCHNAME' already exists"
fi

# Create branch
export BRITETEST_BYPASS_HOOKS=true
if ! git checkout -b "$BRANCHNAME" "origin/$PARENTBRANCH" >/dev/null 2>&1; then
  unset BRITETEST_BYPASS_HOOKS
  bt_error_exit 2 "Failed to create branch '$BRANCHNAME' from '$PARENTBRANCH'"
fi
unset BRITETEST_BYPASS_HOOKS

bt_success "Branch '$BRANCHNAME' created locally"

# Push to remote if requested
if [[ "$PUSH_REMOTE" == true ]]; then
  bt_info "Pushing to remote..."
  export BRITETEST_BYPASS_HOOKS=true
  if ! git push -u origin "$BRANCHNAME" >/dev/null 2>&1; then
    unset BRITETEST_BYPASS_HOOKS
    bt_error_exit 2 "Failed to push '$BRANCHNAME' to remote"
  fi
  unset BRITETEST_BYPASS_HOOKS
  bt_success "Branch pushed to remote"
fi

bt_info "Next step: mkbranch patch/your-fix $BRANCHNAME"
exit 0
