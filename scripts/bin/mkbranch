#!/usr/bin/env bash

# mkbranch - Create a new branch from a base branch and optionally push to remote.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOG_FILE="$REPO_ROOT/logs/branch_history.md"
CONFIG_FILE="$REPO_ROOT/config/contributors.md"

# Shared helpers
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"

# Default options
MODE="local"  # local, remote, or validate
COMMENT=""

usage() {
  cat <<'EOF'
Usage:
  mkbranch [OPTIONS] <newbranch> <basebranch> [-- MSG]
  mkbranch -h | --help

Create a new branch from a base branch with optional remote push and comment.

Arguments:
  <newbranch>        Name of the new branch to create.
  <basebranch>       Name of the base branch from which to create the new branch.

  If the base branch is main, the user must be an approver (see 
  docs/Contributor_Guide.md), the new branch must be created locally and pushed to remote,
  the new branch name must match the form v<M>.<m>.<p> where:
    - M is 1-2 digits starting with 1-9.
    - m/p are either 0 or 1-2 digits starting with 1-9.
    - For v<M>.0.0, <M> must be such there is a v<M-1>.0.0 branch or release.
    - For v<M>.<m>.0. <m> must be such that there is a v<M>.0.0 branch/release
      and <m> is 1 or there is a v<M>.<m-1>.0 branch/release.
    - For v<M>.<m>.<p>, <p> must be such that there is a v<M>.<m>.0 branch/release
      and <p> is 1 or there is v<M>.<m>.<p-1> branch/release.

  If the base branch is not main, the user must be a contributor (see 
  docs/Contributor_Guide.md), the new branch may be local or remote, and the
  new branch name must be a valid GitHub branch name except the name must
  neither be main nor contain periods.

  Example: Create a feature branch targeted to a major release.
    mkbranch redesign-authentication v2.0.0
       
  Example: Create a performance improvement branch targeted to a minor release.
    mkbranch improve-performance v1.1.0

  Example: Create a branch for a patch targeted to patch release.
    mkbranch fix-login-bug v1.0.2

Options:
  -h, --help        Output this help to stdout and exit.
  -l                Create local branch only (default if base branch is not main).
  -r                Create local branch and push to remote (default if base branch is main).
  -v                Validate only without creating branch.
  -m "MSG"          Attach a commit message/comment to the operation
                    Usage: mkbranch feature-a v2.0.0 -m "Implement new feature a."
  --message "MSG"   Attach a commit message/comment to the operation
                    Usage: mkbranch fix-bug v1.0.2 --message "Fix critical memory leak."
  -- MSG            Attach commit message/comment (everything after -- is the comment)
                    Usage: mkbranch fix-bug v1.0.2 -- Fix critical memory leak
                    Note: No quotes needed, captures all remaining arguments.

   Note: -m "MSG", --message "MSG", -- MSG are mutually exclusive.

Modes:
  Local (-l):
    - -r is not specified.
    - Verify the base branch exists locally or remotely.
    - Check that the new branch doesn't already exist locally.
    - Create the new branch from the base branch.
    - Log the operation to 'logs/branch_history.md'.

  Remote (-r):
    - -l is not specified.
    - Verify that the base branch exists remotely.
    - Check that the new branch doesn't already exist locally or remotely.
    - Create the new branch from the base branch.
    - Push the new branch to the remote repository.
    - Log the operation to 'logs/branch_history.md'.

  Validate (-v):
    - Verify the base branch exists.
    - Check that the new branch doesn't already exist.
    - Validate branch name.
    - Report validity without creating or pushing.
    - Exit with status code indicating validity.

Examples: Basic usage.
  mkbranch fix-bug v2.1.1
  mkbranch -r feature-a v2.0.0

Examples: With GitHub-style comment.
  mkbranch fix-bug v1.1.5 -m "Fix critical memory leak."
  mkbranch -r feature-b v2.3.0 -m "Add minor new dashboard feature."

Examples:  With Unix-style comment.
  mkbranch fix-bug v1.1.5 -- Fix critical memory leak.
  mkbranch -r feature-b v2.3.0 -- Add minor new dashboard feature.

Examples: Validation mode for invalid mkbranch.
  mkbranch -v redesign main
  mkbranch -v -r hotfix v2.0.0

Exit codes:
  0   Success (or validation passed).
  1   Arguments/options invalid.
  2   Invalid branch name.
  3   Invalid option.
  4   Conflicting options.
  5   Git operation failed.
  6   Branch already exists.
  7   Base branch doesn't exist.
  9   Validation failed.
EOF
}

log_operation() {
  local status="$1"
  local branchname="$2"
  local basebranchname="$3"
  local message="$4"
  local comment="${5:-}"

  # status/basebranchname are retained for compatibility with existing callers.
  : "$status" "$basebranchname"
  bt_append_history_log "$LOG_FILE" "$message" "$comment"
}

error_exit() {
  local code="$1"
  local message="$2"
  local branchname="${3:-}"
  local basebranchname="${4:-}"
  local comment="${5:-}"

  echo "Error: $message" >&2

  if [[ -n "$branchname" ]]; then
    log_operation "FAILED" "$branchname" "$basebranchname" "Branch \`$branchname\` creation from \`$basebranchname\` failed - $message" "$comment"
  fi

  exit "$code"
}

is_contributor_or_higher() {
  local user_name="$1"

  if [[ ! -f "$CONFIG_FILE" ]]; then
    error_exit 5 "Configuration file not found: $CONFIG_FILE"
  fi

  if grep -E "^\s*-\s+[CRA]/${user_name}," "$CONFIG_FILE" > /dev/null 2>&1; then
    return 0
  fi

  return 1
}

is_approver() {
  local user_name="$1"

  if [[ ! -f "$CONFIG_FILE" ]]; then
    error_exit 5 "Configuration file not found: $CONFIG_FILE"
  fi

  if grep -E "^\s*-\s+A/${user_name}," "$CONFIG_FILE" > /dev/null 2>&1; then
    return 0
  fi

  return 1
}

is_valid_version() {
  local version="$1"

  # Must match v<M>.<m>.<p> where M is 1-2 digits starting with 1-9
  # and m/p are either 0 or 1-2 digits starting with 1-9.
  if [[ "$version" =~ ^v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$ ]]; then
    return 0
  fi
  return 1
}

is_valid_branch_name() {
  local name="$1"
  
  # Allow lowercase letters, numbers, hyphens, forward slashes
  # No uppercase, no periods
  if [[ "$name" =~ ^[a-z0-9/_-]+$ ]] && [[ ! "$name" =~ \. ]]; then
    return 0
  fi
  return 1
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -l)
      MODE="local"
      shift
      ;;
    -r)
      MODE="remote"
      shift
      ;;
    -v)
      MODE="validate"
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -m requires a message argument" "" "" ""
      fi
      if [[ -n "$COMMENT" ]]; then
        error_exit 4 "Cannot use both -m and -- for comment" "" "" ""
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        error_exit 4 "Cannot use both -m and -- for comment" "" "" ""
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      error_exit 3 "Unknown option: $1" "" "" ""
      ;;
    *)
      # Positional argument
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Check that we have exactly 2 positional arguments
if [[ $# -ne 2 ]]; then
  error_exit 1 "Expected 2 arguments (newbranch and basebranch), got $#" "" "" ""
fi

BRANCHNAME="$1"
BASEBRANCHNAME="$2"

# Validate branch name format (basic validation)
if [[ -z "$BRANCHNAME" ]]; then
  error_exit 1 "Branch name cannot be empty" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
fi

if [[ -z "$BASEBRANCHNAME" ]]; then
  error_exit 1 "Base branch name cannot be empty" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
fi

# Validate branch name based on base branch
if [[ "$BASEBRANCHNAME" == "main" ]]; then
  # Base is main: new branch must be a version number
  if ! is_valid_version "$BRANCHNAME"; then
    error_exit 2 "Invalid branch name '$BRANCHNAME'. When base is 'main', branch must be a version in format v<M>.<m>.<p> where M, m, p are 1-2 digits (first digit not 0)" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
  fi
else
  # Base is not main: new branch must be a valid GitHub name (no periods)
  if ! is_valid_branch_name "$BRANCHNAME"; then
    error_exit 2 "Invalid branch name '$BRANCHNAME'. Must contain only lowercase letters, numbers, hyphens, and slashes. Periods are not allowed." "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
  fi
fi

# Change to repo root
cd "$REPO_ROOT"

CURRENT_USER="$(git config user.name 2>/dev/null || true)"
if [[ -z "$CURRENT_USER" ]]; then
  error_exit 1 "Failed to determine current user from git config user.name" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
fi

# Validate user role based on base branch
if [[ "$BASEBRANCHNAME" == "main" ]]; then
  if ! is_approver "$CURRENT_USER"; then
    error_exit 2 "User '$CURRENT_USER' is not an approver. Only approvers can create branches based on 'main'." "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
  fi
else
  if ! is_contributor_or_higher "$CURRENT_USER"; then
    error_exit 2 "User '$CURRENT_USER' is not a contributor. Only contributors, reviewers, and approvers can create branches not based on 'main'." "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
  fi
fi

# Determine operation description
case "$MODE" in
  local)
    echo "Creating local branch '$BRANCHNAME' from base '$BASEBRANCHNAME'..."
    ;;
  remote)
    echo "Creating branch '$BRANCHNAME' from base '$BASEBRANCHNAME' and pushing to remote..."
    ;;
  validate)
    echo "Validating branch '$BRANCHNAME' from base '$BASEBRANCHNAME'..."
    ;;
esac

# Fetch latest refs from remote
echo "Fetching latest refs from remote..."
if ! git fetch origin >/dev/null 2>&1; then
  error_exit 5 "Failed to fetch from remote" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
fi

# Check if base branch exists (check both local and remote)
if ! git rev-parse --verify "$BASEBRANCHNAME" >/dev/null 2>&1; then
  if ! git rev-parse --verify "origin/$BASEBRANCHNAME" >/dev/null 2>&1; then
    if [[ "$MODE" == "validate" ]]; then
      echo "Base branch '$BASEBRANCHNAME' does not exist"
      exit 9
    else
      error_exit 7 "Base branch '$BASEBRANCHNAME' does not exist" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
    fi
  fi
  BASEBRANCHNAME="origin/$BASEBRANCHNAME"
fi

# Check if new branch already exists (local or remote)
if git rev-parse --verify "$BRANCHNAME" >/dev/null 2>&1; then
  if [[ "$MODE" == "validate" ]]; then
    echo "Branch '$BRANCHNAME' already exists locally"
    exit 9
  else
    error_exit 6 "Branch '$BRANCHNAME' already exists locally" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
  fi
fi

if git rev-parse --verify "origin/$BRANCHNAME" >/dev/null 2>&1; then
  if [[ "$MODE" == "validate" ]]; then
    echo "Branch '$BRANCHNAME' already exists on remote"
    exit 9
  else
    error_exit 6 "Branch '$BRANCHNAME' already exists on remote" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
  fi
fi

# If validate mode, we're done (all checks passed)
if [[ "$MODE" == "validate" ]]; then
  echo "Branch '$BRANCHNAME' can be created from '$BASEBRANCHNAME'"
  exit 0
fi

# Create the branch
echo "Creating local branch from '$BASEBRANCHNAME'..."
if ! git checkout -b "$BRANCHNAME" "$BASEBRANCHNAME" >/dev/null 2>&1; then
  error_exit 5 "Failed to create branch '$BRANCHNAME'" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
fi

echo "Local branch '$BRANCHNAME' created"

# Push to remote if in remote mode
if [[ "$MODE" == "remote" ]]; then
  echo "Pushing branch to remote..."
  if ! git push -u origin "$BRANCHNAME" >/dev/null 2>&1; then
    # Clean up local branch on failure
    git checkout - >/dev/null 2>&1 || true
    git branch -D "$BRANCHNAME" >/dev/null 2>&1 || true
    error_exit 5 "Failed to push branch to remote" "$BRANCHNAME" "$BASEBRANCHNAME" "" "$COMMENT"
  fi
  echo "Branch '$BRANCHNAME' pushed to remote"
  log_operation "SUCCESS" "$BRANCHNAME" "$BASEBRANCHNAME" "Branch \`$BRANCHNAME\` created from \`$BASEBRANCHNAME\` and pushed to remote." "$COMMENT"
else
  log_operation "SUCCESS" "$BRANCHNAME" "$BASEBRANCHNAME" "Branch \`$BRANCHNAME\` created from \`$BASEBRANCHNAME\`." "$COMMENT"
fi

exit 0
