#!/usr/bin/env bash

# mkbranch - Create a new branch from a parent branch and
#            optionally push to remote.
#
# See usage below for details, or run: mkbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

# Repository branch rules
# for the following four kinds of branches:
#
# 1. The 'main' branch (protected, no parent branch).
#
# 2. A 'version' branch (protected, created from the main branch by
#    an approver) with branch name in the form:
#
#      v<M>.<m>.0
#
#    where:
#
#      <M> is 1-2 digits starting with 1-9.
#      <m> is either 0 or 1-2 digits starting with 1-9.
#
# 3. A 'targeted' branch (not protected, created from a version branch by
#    a contributor) with a branch name in one of the forms:
#
#      dev/<description>-<target-version>
#      fix/<description>-<target-version>
#
#    where:
#
#      <description> consists of lowercase letters, digits, and hyphens.
#      <target-version> is the name of the 'version' branch.
#
# 4. A 'contributor' branch (not protected, created from a
#    'targeted' or 'contributor' branch by a contributor) with a branch
#    name (other than 'main') in the form:
#
#       [<type>/]<description>
#
#     where <type> consists of between 1 and 30 lowercase letters (for example,
#     'dev', 'fix', or 'mywork') and <description> is as defined above.
#
# Protected branches:
#
# - Require pull request before merging
# - Require approvals (1+)
# - Require status checks
# - Block force pushes
# - Block deletions
#
# This script mirrors the branch-naming policy used by
# <repo>/.github/workflows/branch-validation-*.yml.
#
# For more information, see '<repo>/docs/md/Contributor_Guide.md'.

usage() {
  cat <<'EOF'
Usage:
  mkbranch [OPTIONS] <newbranch> [<parentbranch>] [-- MSG]
  mkbranch {-h | --help}

Create a new branch from a parent branch.

Arguments:
  <newbranch>        Name of the new branch to create.
  <parentbranch>     Name of the parent branch.

  1. If the <newbranch> is a 'version' branch, i.e., the name has the form:

      v<M>.<m>.0

     where:
       - M is 1-2 digits starting with 1-9.
       - m is either 0 or 1-2 digits starting with 1-9.
       - For v<M>.0.0, <M> must be such there is a v<M-1>.0.0 branch.
       - For v<M>.<m>.0, <m> must be such that there is a v<M>.0.0 branch
         with matching <M> and <m> where <m> is 1 or there is a
         v<M>.<m-1>.0 branch.

     If <parentbranch> is specified, it must be main; if not specified, it
     defaults to main.

     The user must be an approver (see <repo>/docs/md/Contributor_Guide.md).

    By default, the new branch is created locally and pushed to remote.
    Specify -l to create the branch locally only.

  2. If the <newbranch> is a 'targeted' branch, i.e., the name has one of
     the forms:

       dev/<description>-v<M>.<m>.0
       fix/<description>-v<M>.<m>.0

     where:
       - dev or fix is a prefix indicating the type of branch.
         dev should be used for development (feature/performance,
         refactoring, etc.) branches. fix should be used for bug fix
         branches. However, this is not enforced by this script. A
         reviewer or approver may request a change to the name of
         the branch if the prefix is not appropriate or reject a
         pull request (PR) for the branch.
       - <description> consists of lowercase letters, digits, and hyphens.
       - <M> is 1-2 digits starting with 1-9.
       - <m> is either 0 or 1-2 digits starting with 1-9.

     If <parentbranch> is specified, it must have the form v<M>.<m>.0
     with matching <M> and <m>; if not specified, it defaults to
     v<M>.<m>.0.

     The user must be a contributor (see <repo>/docs/md/Contributor_Guide.md).

     By default, the new branch is created locally. Specify -r to push to
     remote.

  3. If the <newbranch> is a 'contributor' branch, i.e., the name has the
     form:

       [<type>/]<description>

     where:
       - The name must not be main.
       - <type> consists of between 1 and 30 lowercase letters (for example,
         'dev', 'fix', or 'mywork').
       - <description> consists of lowercase letters, digits, and hyphens.

     <parentbranch> must be specified and it must be a 'targeted' branch name or
     'contributor' branch.

     The user must be a contributor (see <repo>/docs/md/Contributor_Guide.md).

     By default, the new branch is created locally. Specify -r to push to
     remote.

  4. If <newbranch> is none of the above, creating the branch fails.

  Example: Create a minor version branch.
    mkbranch v1.1.0

  Example: Create a major version branch:
    mkbranch v2.0.0

  Example: Create a feature branch targeted to a major version.
    mkbranch dev/redesign-authentication-v2.0.0 \
      v2.0.0

  Example: Create a performance improvement branch targeted to a minor version.
    mkbranch dev/improve-performance-v1.1.0 \
      v1.1.0

  Example: Create a branch for a patch targeted for a major version.
    mkbranch fix/login-bug-v1.0.0 v1.0.0

Options:
  -d                Dry-run (validate only), without creating branch.
  -h, --help        Output this help to stdout and exit (other options
                    and arguments are ignored).
  -l                Create local branch only.
  -m "MSG"          Attach a commit message/comment to the operation
                    Usage: mkbranch dev/feature-a-v2.0.0 v2.0.0 -m \
                      "Implement new feature a."
  --message "MSG"   Attach a commit message/comment to the operation
                    Usage: mkbranch fix/memory-leak-v1.0.0 v1.0.0 \
                      --message "Fix critical memory leak."
  -r                Push to remote (default if the new branch is a
                    'version' branch).
  -v                Verbose output.
  -- MSG            Attach commit message/comment (everything after
                    -- is the comment)
                    Usage: mkbranch fix/login-bug-v1.0.0 v1.0.0 --
                      Fix critical memory leak
                    Note: No quotes needed, captures all remaining
                      arguments.

   Note: -m "MSG", --message "MSG", -- MSG are mutually exclusive.

Local branch:
  - If the parent branch doesn't exist locally, fail with error that
    local parent branch doesn't exist.
  - If new branch exists locally and -r is specified, and the new branch
    exists remotely, fail with error that remote branch already exists.
  - If new branch exists locally and -r is not specified, fail with
    error that local branch already exists.
  - If new branch does not exist locally,
    - Create the new branch from the parent branch.
    - Log the operation to 'logs/remote_branch_history.md'.

Remote branch (-r or if the new branch is a 'version' branch):
  - If the parent branch doesn't exist remotely, fail with error
    that remote parent branch doesn't exist.
  - If the new branch doesn't exist remotely:
    - Push the new or existing local branch to the remote repository.
    - Log the operation to 'logs/remote_branch_history.md'.

Validate (-d):
  - Verify the parent branch exists.
  - Check that the new branch doesn't already exist locally.
  - Check that the new branch doesn't already exist remotely.
  - Validate branch name.
  - Report validity without creating or pushing.
  - Exit with status code indicating validity.

Verbose (-v):
  - Print additional progress and decision details.

Examples: Basic usage.
  mkbranch fix/bug-v2.1.0 v2.1.0
  mkbranch -r dev/feature-a-v2.0.0

Examples: With GitHub-style comment.
  mkbranch fix/memory-leak-v1.1.0 v1.1.0 -m "Fix critical memory leak."
  mkbranch -r dev/feature-b-v2.3.0 v2.3.0 -m "Add minor new dashboard feature."

Examples: With Unix-style comment.
  mkbranch fix/login-bug-v1.0.0 v1.0.0 -- Fix critical memory leak.
  mkbranch -r dev/dashboard-v2.3.0 v2.3.0 -- Add minor new dashboard feature.

Examples: Validation mode for invalid mkbranch.
  mkbranch -d redesign main
  mkbranch -d -r hotfix v2.0.0

Examples: Verbose mode.
  mkbranch -v dev/fix-bug-v2.1.0 v2.1.0
  mkbranch -v -r dev/feature-a-v2.0.0 v2.0.0

Outputs:
  - Writes help text, status messages, and results or summaries to
    stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented
    output locations.

Exit codes:
   0   Success (or validation passed).
   1   Arguments/options invalid.
   2   Invalid branch name.
   3   Invalid option.
   4   Conflicting options.
   5   Git operation failed.
   6   Local parent branch doesn't exist.
   7   Remote parent branch doesn't exist.
   8   Local branch already exists.
   9   Remote branch already exists.
  10   Validation failed.
EOF
}

# High-Level Flow:
# - Parse options, arguments, and optional free-form message/comment.
# - Classify the new branch (version/targeted/contributor) and
#   infer/validate parent-branch rules for that type.
# - Validate caller role against branch type (approver for version;
#   contributor+ for targeted and contributor).
# - Resolve parent reference and branch-existence checks according to
#   selected mode (local/remote/validate).
# - Create and optionally push the branch, then log success/failure with
#   context.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
CONFIG_FILE="$REPO_ROOT/config/contributors.md"
HISTORY_HELPER="$SCRIPT_DIR/../helpers/history_log.sh"
GIT_HELPER="$SCRIPT_DIR/../helpers/git_helpers.sh"

# Shared helpers
if [[ ! -f "$HISTORY_HELPER" ]]; then
  echo "Error: Required helper not found: $HISTORY_HELPER" >&2
  exit 5
fi
# shellcheck source=helpers/history_log.sh
if ! source "$HISTORY_HELPER"; then
  echo "Error: Failed to load helper: $HISTORY_HELPER" >&2
  exit 5
fi
if [[ ! -f "$GIT_HELPER" ]]; then
  echo "Error: Required helper not found: $GIT_HELPER" >&2
  exit 5
fi
# shellcheck source=helpers/git_helpers.sh
if ! source "$GIT_HELPER"; then
  echo "Error: Failed to load helper: $GIT_HELPER" >&2
  exit 5
fi

# Default options
MODE="local"  # local, remote, or validate
VERBOSE=0
COMMENT=""
EXPLICIT_LOCAL_MODE=0

readonly EXIT_INVALID_ARGUMENT=1

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "Invalid option or argument. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

log_verbose() {
  if [[ "$VERBOSE" -eq 1 ]]; then
    echo "[verbose] $*"
  fi
}

ensure_clean_before_branch_switch() {
  if bt_is_worktree_dirty; then
    error_exit 5 "Current branch has uncommitted changes. Commit first before running mkbranch" \
      "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
}

log_operation() {
  local status="$1"
  local branchname="$2"
  local parentbranchname="$3"
  local message="$4"
  local comment="${5:-}"
  local log_branch="${parentbranchname#origin/}"
  local log_file
  log_file="$REPO_ROOT/$(bt_branch_to_history_file "$log_branch")"

  # status/branchname are retained for compatibility with existing callers.
  : "$status" "$branchname"
  if ! bt_append_history_log "$log_file" "$message" "$comment"; then
    # Logging failures should not hide the primary command result.
    echo "Warning: Failed to append history log: $log_file" >&2
  fi
}

error_exit() {
  local code="$1"
  local message="$2"
  local branchname="${3:-}"
  local parentbranchname="${4:-}"
  local comment="${5:-}"

  echo "Error: $message" >&2

  if [[ -n "$branchname" ]]; then
    log_operation "FAILED" "$branchname" "$parentbranchname" \
      "Branch \`$branchname\` creation from parent " \
      "\`$parentbranchname\` failed - $message" \
      "$comment"
  fi

  exit "$code"
}

is_contributor_or_higher() {
  local user_name="$1"
  local user_email
  user_email="$(git config user.email 2>/dev/null || true)"

  if [[ ! -f "$CONFIG_FILE" ]]; then
    error_exit 5 "Configuration file not found: $CONFIG_FILE"
  fi

  awk -F',' -v user_name="$user_name" -v user_email="$user_email" '
    function trim(s) {
      gsub(/^[[:space:]-]+|[[:space:]]+$/, "", s)
      return s
    }
    {
      login = trim($1)
      role = trim($2)
      email = trim($3)

      if ((login == user_name || (user_email != "" && email == user_email)) &&
          (role == "C" || role == "R" || role == "A")) {
        found = 1
      }
    }
    END {
      exit(found ? 0 : 1)
    }
  ' "$CONFIG_FILE"
}

is_approver() {
  local user_name="$1"
  local user_email
  user_email="$(git config user.email 2>/dev/null || true)"

  if [[ ! -f "$CONFIG_FILE" ]]; then
    error_exit 5 "Configuration file not found: $CONFIG_FILE"
  fi

  awk -F',' -v user_name="$user_name" -v user_email="$user_email" '
    function trim(s) {
      gsub(/^[[:space:]-]+|[[:space:]]+$/, "", s)
      return s
    }
    {
      login = trim($1)
      role = trim($2)
      email = trim($3)

      if ((login == user_name || (user_email != "" && email == user_email)) &&
          role == "A") {
        found = 1
      }
    }
    END {
      exit(found ? 0 : 1)
    }
  ' "$CONFIG_FILE"
}

is_valid_version() {
  local version="$1"

  # Must match v<M>.<m>.<p> where M is 1-2 digits starting with 1-9
  # and m/p are either 0 or 1-2 digits starting with 1-9.
  if [[ "$version" =~ ^v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$ ]]; then
    return 0
  fi
  return 1
}

is_targeted_branch_name() {
  local name="$1"

  if [[ "$name" =~ ^(dev|fix)/[a-z0-9][a-z0-9-]*-(v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?))$ ]]; then
    return 0
  fi
  return 1
}

is_contributor_branch_name() {
  local name="$1"
  local desc='[a-z0-9]+(-[a-z0-9]+)*'
  local type='[a-z][a-z]{0,29}'

  if [[ "$name" == "main" ]]; then
    return 1
  fi

  if is_valid_version "$name" || is_targeted_branch_name "$name"; then
    return 1
  fi

  # Contributor branches use optional type prefix: [<type>/]<description>.
  # This intentionally accepts both "my-feature" and "mywork/my-feature".
  if [[ "$name" =~ ^((${type}/)?${desc})$ ]]; then
    return 0
  fi
  return 1
}

get_target_version_from_targeted_branch() {
  local name="$1"

  if [[ "$name" =~ ^(dev|fix)/[a-z0-9][a-z0-9-]*-(v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?))$ ]]; then
    echo "${BASH_REMATCH[2]}"
    return 0
  fi
  return 1
}

branch_exists_local() {
  local branchname="$1"
  git rev-parse --verify "$branchname" >/dev/null 2>&1
}

branch_exists_remote() {
  local branchname="$1"
  git rev-parse --verify "origin/$branchname" >/dev/null 2>&1
}

# Resolve and validate the parent reference based on mode.
# In remote mode, parent must exist on origin.
# In local mode, parent must exist locally.
# In validate mode, parent can exist either locally or on origin.
resolve_parent_reference_for_mode() {
  if [[ "$MODE" == "local" ]]; then
    if ! branch_exists_local "$PARENTBRANCHNAME"; then
      error_exit 6 "Local parent branch '$PARENTBRANCHNAME' does not exist" \
        "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
    fi
    return 0
  fi

  if [[ "$MODE" == "remote" ]]; then
    if ! branch_exists_remote "$PARENTBRANCHNAME"; then
      error_exit 7 "Remote parent branch '$PARENTBRANCHNAME' does not exist" \
        "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
    fi
    PARENTBRANCHNAME="origin/$PARENTBRANCHNAME"
    return 0
  fi

  if ! branch_exists_local "$PARENTBRANCHNAME"; then
    if ! branch_exists_remote "$PARENTBRANCHNAME"; then
      echo "Parent branch '$PARENTBRANCHNAME' does not exist"
      if [[ "$BRANCH_TYPE" == "version" ]]; then
        exit 7
      fi
      exit 6
    fi
    PARENTBRANCHNAME="origin/$PARENTBRANCHNAME"
  fi
}

set_branch_existence_flags() {
  LOCAL_EXISTS=0
  REMOTE_EXISTS=0

  if branch_exists_local "$BRANCHNAME"; then
    LOCAL_EXISTS=1
  fi
  if branch_exists_remote "$BRANCHNAME"; then
    REMOTE_EXISTS=1
  fi
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d)
      MODE="validate"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -l)
      if [[ "$MODE" == "remote" ]]; then
        error_exit 4 "Cannot use both -l and -r" "" "" ""
      fi
      MODE="local"
      EXPLICIT_LOCAL_MODE=1
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -m requires a message argument" "" "" ""
      fi
      if [[ -n "$COMMENT" ]]; then
        error_exit 4 "Cannot use both -m and -- for comment" "" "" ""
      fi
      COMMENT="$2"
      shift 2
      ;;
    -r)
      if [[ "$EXPLICIT_LOCAL_MODE" -eq 1 ]]; then
        error_exit 4 "Cannot use both -l and -r" "" "" ""
      fi
      MODE="remote"
      shift
      ;;
    -v)
      VERBOSE=1
      shift
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        error_exit 4 "Cannot use both -m and -- for comment" "" "" ""
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      # Positional argument
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Check that we have 1-2 positional arguments
if [[ $# -lt 1 || $# -gt 2 ]]; then
  usage_error \
    "Expected 1 or 2 arguments (newbranch [parentbranch]), got $#" \
    "" "" ""
fi

BRANCHNAME="$1"
PARENTBRANCHNAME="${2:-}"

BRANCH_TYPE=""
TARGET_VERSION=""
REQUIRED_ROLE="contributor"

if is_valid_version "$BRANCHNAME"; then
  BRANCH_TYPE="version"
  REQUIRED_ROLE="approver"
  if [[ -z "$PARENTBRANCHNAME" ]]; then
    PARENTBRANCHNAME="main"
  elif [[ "$PARENTBRANCHNAME" != "main" ]]; then
    usage_error \
      "When newbranch is a version branch, parentbranch must be 'main'" \
      "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
  if [[ "$MODE" == "local" && "$EXPLICIT_LOCAL_MODE" -eq 0 ]]; then
    MODE="remote"
  fi
elif is_targeted_branch_name "$BRANCHNAME"; then
  BRANCH_TYPE="targeted"
  TARGET_VERSION="$(get_target_version_from_targeted_branch "$BRANCHNAME")"
  if [[ -z "$PARENTBRANCHNAME" ]]; then
    PARENTBRANCHNAME="$TARGET_VERSION"
  elif [[ "$PARENTBRANCHNAME" != "$TARGET_VERSION" ]]; then
    usage_error \
      "When newbranch is a targeted branch, parentbranch must match " \
      "its target version '$TARGET_VERSION'" \
      "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
elif is_contributor_branch_name "$BRANCHNAME"; then
  BRANCH_TYPE="contributor"
  if [[ -z "$PARENTBRANCHNAME" ]]; then
    usage_error \
      "When newbranch is a contributor branch, parentbranch is " \
      "required" \
      "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
  if ! is_targeted_branch_name "$PARENTBRANCHNAME" && \
      ! is_contributor_branch_name "$PARENTBRANCHNAME"; then
    usage_error \
      "For contributor branches, parentbranch must be a targeted " \
      "or contributor branch" \
      "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
else
  error_exit 2 \
    "Invalid branch name '$BRANCHNAME'. Must be version, targeted, " \
    "or contributor format" \
    "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
fi

log_verbose "Mode: $MODE"
log_verbose "Branch argument: $BRANCHNAME"
log_verbose "Parent argument: $PARENTBRANCHNAME"
log_verbose "Branch type: $BRANCH_TYPE"

# Validate branch name format (basic validation)
if [[ -z "$BRANCHNAME" ]]; then
  usage_error "Branch name cannot be empty" "$BRANCHNAME" \
    "$PARENTBRANCHNAME" "" "$COMMENT"
fi

log_verbose "Branch name and parent-branch rule validation passed"

# Change to repo root
cd "$REPO_ROOT"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  error_exit 5 "Repository root '$REPO_ROOT' is not a Git working " \
    "tree" "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
fi

if ! git remote get-url origin >/dev/null 2>&1; then
  error_exit 5 "Remote 'origin' is not configured" "$BRANCHNAME" \
    "$PARENTBRANCHNAME" "" "$COMMENT"
fi

CURRENT_USER="$(git config user.name 2>/dev/null || true)"
if [[ -z "$CURRENT_USER" ]]; then
  usage_error "Failed to determine current user from git config " \
    "user.name" "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
fi

log_verbose "Current user from git config: $CURRENT_USER"

# Validate user role based on new-branch type.
# Approver is required for version branches; contributor-or-higher otherwise.
if [[ "$REQUIRED_ROLE" == "approver" ]]; then
  if ! is_approver "$CURRENT_USER"; then
    error_exit 2 \
      "User '$CURRENT_USER' is not an approver. Only approvers can " \
      "create version branches." \
      "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
else
  if ! is_contributor_or_higher "$CURRENT_USER"; then
    error_exit 2 \
      "User '$CURRENT_USER' is not a contributor. Only " \
      "contributors, reviewers, and approvers can create targeted or " \
      "contributor branches." \
      "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
fi

log_verbose "Role/permission checks passed"

# Determine operation description
case "$MODE" in
  local)
    echo "Creating local branch '$BRANCHNAME' from parent " \
      "'$PARENTBRANCHNAME'..."
    ;;
  remote)
    echo "Creating branch '$BRANCHNAME' from parent " \
      "'$PARENTBRANCHNAME' and pushing to remote..."
    ;;
  validate)
    echo "Validating branch '$BRANCHNAME' from parent " \
      "'$PARENTBRANCHNAME'..."
    ;;
esac

# Fetch latest refs from remote
echo "Fetching latest refs from remote..."
if ! git fetch origin >/dev/null 2>&1; then
  error_exit 5 "Failed to fetch from remote" "$BRANCHNAME" \
    "$PARENTBRANCHNAME" "" "$COMMENT"
fi
log_verbose "Fetched origin successfully"

# Propagate repository history from remote if available
history_status=0
if bt_propagate_repository_history; then
  history_status=0
else
  history_status=$?
fi
case "$history_status" in
  0) log_verbose "Repository history already up to date" ;;
  1) log_verbose "Updated repository history from remote" ;;
  *) ;;
esac

# Check if parent branch exists according to mode-specific rules.
resolve_parent_reference_for_mode
log_verbose "Resolved parent branch reference: $PARENTBRANCHNAME"

set_branch_existence_flags
log_verbose "Branch existence - local: $LOCAL_EXISTS, remote: " \
  "$REMOTE_EXISTS"

# If validate mode, we're done (all checks passed)
if [[ "$MODE" == "validate" ]]; then
  if [[ "$LOCAL_EXISTS" -eq 1 ]]; then
    echo "Branch '$BRANCHNAME' already exists locally"
    exit 8
  fi
  if [[ "$REMOTE_EXISTS" -eq 1 ]]; then
    echo "Branch '$BRANCHNAME' already exists on remote"
    exit 9
  fi
  echo "Branch '$BRANCHNAME' can be created from parent " \
    "'$PARENTBRANCHNAME'"
  exit 0
fi

# Local mode: local branch must not already exist.
if [[ "$MODE" == "local" ]]; then
  if [[ "$LOCAL_EXISTS" -eq 1 ]]; then
    error_exit 8 "Branch '$BRANCHNAME' already exists locally" \
      "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
  ensure_clean_before_branch_switch
  echo "Creating local branch from '$PARENTBRANCHNAME'..."
  if ! git checkout -b "$BRANCHNAME" "$PARENTBRANCHNAME" >/dev/null 2>&1; then
    error_exit 5 "Failed to create branch '$BRANCHNAME'" \
      "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
  echo "Local branch '$BRANCHNAME' created"
  log_operation "SUCCESS" "$BRANCHNAME" "$PARENTBRANCHNAME" \
    "Branch \`$BRANCHNAME\` created from parent " \
    "\`$PARENTBRANCHNAME\`." "$COMMENT"
  exit 0
fi

# Remote mode: remote branch must not already exist. Use existing
# local if present, otherwise create from parent and then push.
if [[ "$REMOTE_EXISTS" -eq 1 ]]; then
  error_exit 9 "Branch '$BRANCHNAME' already exists on remote" \
    "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
fi

CREATED_LOCAL=0
if [[ "$LOCAL_EXISTS" -eq 0 ]]; then
  ensure_clean_before_branch_switch
  echo "Creating local branch from '$PARENTBRANCHNAME'..."
  if ! git checkout -b "$BRANCHNAME" "$PARENTBRANCHNAME" >/dev/null 2>&1; then
    error_exit 5 "Failed to create branch '$BRANCHNAME'" \
      "$BRANCHNAME" "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
  CREATED_LOCAL=1
  echo "Local branch '$BRANCHNAME' created"
else
  echo "Using existing local branch '$BRANCHNAME' for remote " \
    "push..."
fi

if [[ "$MODE" == "remote" ]]; then
  echo "Pushing branch to remote..."
  if ! git push -u origin "$BRANCHNAME" >/dev/null 2>&1; then
    # Clean up only the branch created in this run.
    if [[ "$CREATED_LOCAL" -eq 1 ]]; then
      git checkout - >/dev/null 2>&1 || true
      git branch -D "$BRANCHNAME" >/dev/null 2>&1 || true
    fi
    error_exit 5 "Failed to push branch to remote" "$BRANCHNAME" \
      "$PARENTBRANCHNAME" "" "$COMMENT"
  fi
  echo "Branch '$BRANCHNAME' pushed to remote"
  log_operation "SUCCESS" "$BRANCHNAME" "$PARENTBRANCHNAME" \
    "Branch \`$BRANCHNAME\` created from parent " \
    "\`$PARENTBRANCHNAME\` and pushed to remote." "$COMMENT"
else
  log_operation "SUCCESS" "$BRANCHNAME" "$PARENTBRANCHNAME" \
    "Branch \`$BRANCHNAME\` created from parent " \
    "\`$PARENTBRANCHNAME\`." "$COMMENT"
fi

exit 0
