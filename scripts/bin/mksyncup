#!/usr/bin/env bash

# mksyncup - Merge base branch into current branch.
#
# See usage below for details, or run: mksyncup -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

usage() {
  cat <<'EOF'
Usage:
  mksyncup [OPTIONS]
  mksyncup -h | --help

Merge the base branch of the current branch into current branch to sync up with latest changes.

Automatically determines the base branch based on Git history (the branch that the current
branch was created from). Handles simple conflicts automatically and provides instructions
for complex ones.

Protected branches (cannot run mksyncup):
  - main
  - v<M>.<m>.<p> release branches created from main

Allowed branches (can use mksyncup):
  - Branches created from non-main base branches (no period in branch name)

Features:
  - Automatically determines base branch
  - Merges base branch into current branch
  - Auto-resolves simple (non-overlapping) conflicts
  - Shows instructions for complex conflicts
  - Prompts for confirmation before merge and push
  - Optional force mode to skip confirmations

Options:
  -h, --help         Output this help to stdout and exit (other options
                     and arguments are ignored).
  -f, --force        Skip all confirmations (auto-merge and auto-push)
  -v, --verbose      Show detailed merge information
  -m, --message MSG  Custom merge commit message (GitHub style)
  -- TEXT            Custom message (Unix style, everything after --)
                     Note: No quotes needed, captures all remaining arguments

Merge Message Options (mutually exclusive):
  -m, --message MSG  Set custom merge message (requires quotes if spaces)
  -- TEXT            Unix-style message (everything after -- is the message)
  (default)          "Merge <base-branch> into <current-branch>"

Examples:
  # Sync up with confirmations
  mksyncup

  # Force merge and push (no confirmations)
  mksyncup -f

  # Custom merge message
  mksyncup -m "Sync with latest base branch for bug fix"

  # Verbose output
  mksyncup -v

  # Unix-style message with force
  mksyncup -f -- Sync up with latest changes


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented output locations.

Exit codes:
  0   Success
  1   Argument or validation error
  2   Git merge or push failed
  3   Conflicts detected (user must resolve)
  4   Branch is protected (cannot sync up)
  5   Failed to determine base branch
EOF
}

# High-Level Flow:
# - Brings base-branch changes into the current branch using project sync-up
#   workflow.
# - Validates branch relationships and merge/rebase preconditions.
# - Reports integration outcomes and required follow-up actions.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Default options
FORCE=false
VERBOSE=false
CUSTOM_MESSAGE=""


get_base_branch() {
  local current_branch="$1"

  local target_branch
  target_branch=$(bt_resolve_target_branch_from_fork_point "$current_branch" "main") || {
    bt_error_exit 5 "Failed to determine base branch"
  }

  echo "$target_branch"
}

is_protected_branch() {
  local branch="$1"
  
  # Check if branch is main
  if [[ "$branch" == "main" ]]; then
    return 0
  fi
  
  # Branches created from main follow release version format v<M>.<m>.<p>
  if [[ "$branch" =~ ^v([1-9][0-9]?)\.([0-9]|[1-9][0-9]?)\.([0-9]|[1-9][0-9]?)$ ]]; then
    return 0
  fi
  
  # Not protected
  return 1
}

resolve_simple_conflicts() {
  local status
  status=$(git status --porcelain) || return 1
  
  # Check for unresolved conflicts (marked with <<<<<<)
  if echo "$status" | grep -q "^UU\|^AA\|^DD"; then
    return 1  # Has conflicts that need manual resolution
  fi
  
  return 0  # No conflicts or all resolved
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -f | --force)
      FORCE=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -m requires a message argument"
      fi
      if [[ -n "$CUSTOM_MESSAGE" ]]; then
        bt_error_exit 1 "Cannot use both -m and -- for message"
      fi
      CUSTOM_MESSAGE="$2"
      shift 2
      ;;
    --)
      # Unix-style message: everything after -- is the message
      shift
      if [[ -n "$CUSTOM_MESSAGE" ]]; then
        bt_error_exit 1 "Cannot use both -m and -- for message"
      fi
      CUSTOM_MESSAGE="$*"
      break
      ;;
    -*)
      bt_error_exit 1 "Unknown option: $1"
      ;;
    *)
      bt_error_exit 1 "Unknown argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || bt_error_exit 2 "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

# Check if branch is protected
if is_protected_branch "$CURRENT_BRANCH"; then
  bt_error_exit 4 "Cannot sync up on protected branch '$CURRENT_BRANCH'. Use 'mkmerge' to merge changes to this branch."
fi

# Determine base branch
bt_info "Determining base branch..."
BASE_BRANCH=$(get_base_branch "$CURRENT_BRANCH")
bt_info "Base branch: $BASE_BRANCH"

# Ensure base branch exists and is up to date
bt_info "Fetching latest from remote..."
if ! git fetch origin "$BASE_BRANCH" 2>&1 >/dev/null; then
  bt_error_exit 2 "Failed to fetch base branch '$BASE_BRANCH' from remote"
fi

# Count commits from base branch to current branch
commits_to_merge=""
commits_to_merge=$(git rev-list --count "HEAD..origin/$BASE_BRANCH" 2>/dev/null || echo "0")

if [[ "$commits_to_merge" == "0" ]]; then
  bt_success "Already up to date with $BASE_BRANCH"
  exit 0
fi

bt_info "Commits to merge: $commits_to_merge"

# Determine merge message
if [[ -z "$CUSTOM_MESSAGE" ]]; then
  MERGE_MESSAGE="Merge $BASE_BRANCH into $CURRENT_BRANCH"
else
  MERGE_MESSAGE="$CUSTOM_MESSAGE"
fi

# Ask for confirmation before merge (unless force)
if [[ "$FORCE" == false ]]; then
  echo -n "Create merge commit? (y/n): "
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    bt_warn "Merge cancelled"
    exit 0
  fi
fi

# Perform merge
bt_info "Merging $BASE_BRANCH into $CURRENT_BRANCH..."
if ! git merge "origin/$BASE_BRANCH" -m "$MERGE_MESSAGE" 2>&1; then
  # Check if merge failed due to conflicts
  if git status | grep -q "both"; then
    bt_warn "Merge conflicts detected"
    bt_info "Complex conflicts require manual resolution"
    bt_info "Conflicted files:"
    git status --porcelain | grep "^UU" | awk '{print "  " $2}'
    bt_info "Steps to resolve:"
    echo "  1. Edit conflicted files to resolve conflicts"
    echo "  2. Stage resolved files: git add <files>"
    echo "  3. Complete merge: git commit"
    bt_error_exit 3 "Merge stopped - manual conflict resolution needed"
  else
    bt_error_exit 2 "Failed to merge $BASE_BRANCH into $CURRENT_BRANCH"
  fi
fi

bt_success "Merge successful"

# Show merge details if verbose
if [[ "$VERBOSE" == true ]]; then
  bt_info "Merge details:"
  git log -1 --oneline | sed 's/^/  /'
fi

# Ask for confirmation before push (unless force)
if [[ "$FORCE" == false ]]; then
  echo -n "Push merge to remote? (y/n): "
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    bt_warn "Push skipped - merge committed locally"
    exit 0
  fi
fi

# Push merge commit
bt_info "Pushing merge commit to remote..."
if ! git push origin "$CURRENT_BRANCH" 2>&1; then
  bt_error_exit 2 "Failed to push merge commit to remote"
fi

bt_success "Pushed merge commit"
bt_success "Sync up complete"
exit 0
