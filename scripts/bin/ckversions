#!/usr/bin/env bash

# ckversions - Validate version consistency across docs, headers, and sources.
#              Also validates that version changes align with branch naming policy
#              (patch, minor, major branches).
#
# See usage below for details, or run: ckversions -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

usage() {
  cat <<'EOF'
Usage:
  ckversions
  ckversions -h | --help

Validate version consistency across versioned project files.

Checks include the shared version tuple across headers, sources, and docs,
and reports mismatches that violate repository versioning rules.


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - Writes a validation report to reports/versions-report-<datetime>.md.
  - Removes previous reports when a new one is successfully written.
  - May generate files, reports, or other artifacts in the documented output locations.

Exit codes:
  0  Success, or help requested with -h/--help.
  1  Validation failure.
  2  Invalid command-line argument.
EOF
}

# High-Level Flow:
# - Extracts semantic versions from headers, sources, and markdown docs.
# - Validates major/minor consistency and allowed patch-only differences across
#   versioned files.
# - Emits validation failures suitable for local checks and CI gate enforcement.

set -euo pipefail

readonly EXIT_OK=0
readonly EXIT_VALIDATION=1
readonly EXIT_USAGE=2


usage() {
  cat <<'EOF'
Usage:
  ckversions
  ckversions -h | --help

Validate that version consistency across docs, headers, and sources, and that
version changes align with branch naming policy.

This script:
  1. Ensures major and minor release versions are consistent across:
     - docs/md/*.md (excluding docs/md/README.md)
     - include/*.h
     - src/*.c
  
  2. If the current branch follows the naming convention (patch/*, minor/*,
     major/*), validates that version changes match the branch type:
     - patch/* branches: only patch version differs across files
     - minor/* branches: all files updated to same major.minor (patch = 0)
     - major/* branches: all files updated to same major (minor = patch = 0)
  
  3. If not on a versioned branch, only validates consistency.

Exit codes:
  0  Success, or help requested with -h/--help.
  1  Validation failure.
  2  Invalid command-line argument.
EOF
}

# High-Level Flow:
# - Extracts semantic versions from headers, sources, and markdown docs.
# - Validates major/minor consistency and allowed patch-only differences across
#   versioned files.
# - Emits validation failures suitable for local checks and CI gate enforcement.

set -euo pipefail

readonly EXIT_OK=0
readonly EXIT_VALIDATION=1
readonly EXIT_USAGE=2

RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
RUN_OUTPUT_FILE="$(mktemp)"
REPORT_FILE=""

setup_output_capture() {
  exec > >(tee "$RUN_OUTPUT_FILE") 2>&1
}

write_report_on_exit() {
  local exit_code="$?"
  local old_report
  set +e

  {
    echo "# ckversions Report"
    echo
    echo "**Timestamp:** $RUN_TS_DISPLAY"
    echo
    echo "## Validation Output"
    echo '```text'
    sed -n '1,$p' "$RUN_OUTPUT_FILE"
    echo '```'
  } > "$REPORT_FILE"

  # Remove old reports if new one was written successfully
  if [[ -f "$REPORT_FILE" ]]; then
    for old_report in "$repo_root"/reports/versions-report-*.md; do
      [[ "$old_report" == "$REPORT_FILE" ]] && continue
      [[ -e "$old_report" ]] || continue
      rm -f "$old_report"
    done
  fi

  rm -f "$RUN_OUTPUT_FILE"
  trap - EXIT
  exit "$exit_code"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit "$EXIT_USAGE"
      ;;
  esac
done

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"
REPORT_FILE="$repo_root/reports/versions-report-${RUN_TS_FILE}.md"

trap write_report_on_exit EXIT
setup_output_capture

extract_major() {
  local semver="$1"
  printf '%s\n' "${semver%%.*}"
}

extract_minor() {
  local semver="$1"
  local major="${semver%%.*}"
  local minor_patch="${semver#*.}"
  printf '%s\n' "${minor_patch%%.*}"
}

extract_patch() {
  local semver="$1"
  printf '%s\n' "${semver##*.}"
}

extract_major_minor() {
  local semver="$1"
  printf '%s\n' "${semver%.*}"
}

doc_major() {
  local file="$1"
  local semver

  # The document version table appears near the top of each docs file.
  semver="$(head -n 220 "$file" | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' | head -n 1 || true)"
  printf '%s\n' "$semver"
}

header_major() {
  local file="$1"
  local semver

  semver="$(grep -Ei '^#[[:space:]]*define[[:space:]]+RA_[A-Za-z_]*VERSION[A-Za-z_]*[[:space:]]+"[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}"' "$file" \
    | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' \
    | head -n 1 || true)"

  if [[ -z "$semver" ]]; then
    semver="$(extract_semver "$file")"
  fi

  printf '%s\n' "$semver"
}

source_major() {
  local file="$1"
  local semver
  local include_line

  semver="$(grep -Ei '^#[[:space:]]*define[[:space:]]+[A-Za-z_]*VERSION[A-Za-z_]*[[:space:]]+"[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}"' "$file" \
    | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' \
    | head -n 1 || true)"

  if [[ -n "$semver" ]]; then
    printf '%s\n' "$semver"
    return 0
  fi

  include_line="$(grep -E '^#[[:space:]]*include[[:space:]]+"(britetest_(runner|test)|runnerapi|testapi)\.h"' "$file" | head -n 1 || true)"

  if [[ "$include_line" == *'"runnerapi.h"'* ]]; then
    semver="$(header_major "include/runnerapi.h")"
  elif [[ "$include_line" == *'"testapi.h"'* ]]; then
    semver="$(header_major "include/testapi.h")"
  else
    semver="$(extract_semver "$file")"
  fi

  printf '%s\n' "$semver"
}

failures=0
expected_major=""
expected_minor=""
expected_major_minor=""
declare -A versions

record_and_check() {
  local file="$1"
  local semver="$2"
  local major
  local minor
  local patch
  local major_minor

  if [[ -z "$semver" ]]; then
    echo "ERROR: Could not find semantic version in '$file'" >&2
    failures=$((failures + 1))
    return
  fi

  major="$(extract_major "$semver")"
  minor="$(extract_minor "$semver")"
  patch="$(extract_patch "$semver")"
  major_minor="$(extract_major_minor "$semver")"

  # Store version for branch policy validation
  versions["$file"]="$semver"

  if [[ -z "$expected_major_minor" ]]; then
    expected_major="$major"
    expected_minor="$minor"
    expected_major_minor="$major_minor"
    echo "Reference major.minor release: $expected_major_minor (from $file: $semver)"
    return
  fi

  if [[ "$major_minor" != "$expected_major_minor" ]]; then
    echo "ERROR: Major.minor release mismatch in '$file'" >&2
    echo "  Found:    $semver (major.minor $major_minor)" >&2
    echo "  Expected: major.minor $expected_major_minor" >&2
    failures=$((failures + 1))
  fi
}

# Collect all versions
while IFS= read -r file; do
  [[ "$(basename "$file")" == "README.md" ]] && continue
  semver="$(doc_major "$file")"
  record_and_check "$file" "$semver"
done < <(find docs/md -maxdepth 1 -type f -name '*.md' | sort)

while IFS= read -r file; do
  semver="$(header_major "$file")"
  record_and_check "$file" "$semver"
done < <(find include -maxdepth 1 -type f -name '*.h' | sort)

while IFS= read -r file; do
  semver="$(source_major "$file")"
  record_and_check "$file" "$semver"
done < <(find src -maxdepth 1 -type f -name '*.c' | sort)

if [[ "$failures" -ne 0 ]]; then
  echo >&2
  echo "Major.minor release consistency check failed with $failures issue(s)." >&2
  exit "$EXIT_VALIDATION"
fi

echo "Major.minor release consistency check passed."

# ============================================================================
# Branch Policy Validation
# ============================================================================
# If on a versioned branch (patch/*, minor/*, major/*), validate that version
# changes align with the branch type.

current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"

if [[ -z "$current_branch" ]]; then
  exit "$EXIT_OK"
fi

# Extract branch type from branch name
branch_type=""
if [[ "$current_branch" == patch/* ]]; then
  branch_type="patch"
elif [[ "$current_branch" == minor/* ]]; then
  branch_type="minor"
elif [[ "$current_branch" == major/* ]]; then
  branch_type="major"
fi

# If not on a versioned branch, skip policy validation
if [[ -z "$branch_type" ]]; then
  exit "$EXIT_OK"
fi

echo ""
echo "Branch policy validation: $current_branch ($branch_type branch)"

# Get main branch versions for comparison
main_versions=()
while IFS= read -r file; do
  [[ "$(basename "$file")" == "README.md" ]] && continue
  semver="$(git show main:"$file" 2>/dev/null | head -n 220 | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' | head -n 1 || echo "")"
  if [[ -n "$semver" ]]; then
    main_versions+=("$file:$semver")
  fi
done < <(find docs/md -maxdepth 1 -type f -name '*.md' | sort)

while IFS= read -r file; do
  semver="$(git show main:"$file" 2>/dev/null | grep -Ei '^#[[:space:]]*define[[:space:]]+RA_[A-Za-z_]*VERSION[A-Za-z_]*[[:space:]]+"[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}"' | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' | head -n 1 || echo "")"
  if [[ -n "$semver" ]]; then
    main_versions+=("$file:$semver")
  fi
done < <(find include -maxdepth 1 -type f -name '*.h' | sort)

while IFS= read -r file; do
  semver="$(git show main:"$file" 2>/dev/null | grep -Ei '^#[[:space:]]*define[[:space:]]+[A-Za-z_]*VERSION[A-Za-z_]*[[:space:]]+"[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}"' | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' | head -n 1 || echo "")"
  if [[ -n "$semver" ]]; then
    main_versions+=("$file:$semver")
  fi
done < <(find src -maxdepth 1 -type f -name '*.c' | sort)

# Validate branch policy
policy_failures=0

case "$branch_type" in
  patch)
    # Patch branch: only patch version should differ
    for entry in "${main_versions[@]}"; do
      file="${entry%:*}"
      main_semver="${entry#*:}"
      current_semver="${versions[$file]:-}"

      if [[ -z "$current_semver" ]]; then
        continue
      fi

      main_major_minor="$(extract_major_minor "$main_semver")"
      current_major_minor="$(extract_major_minor "$current_semver")"

      if [[ "$main_major_minor" != "$current_major_minor" ]]; then
        echo "ERROR (patch branch policy): Major.minor version changed in '$file'" >&2
        echo "  main: $main_semver (major.minor $main_major_minor)" >&2
        echo "  current: $current_semver (major.minor $current_major_minor)" >&2
        echo "  Patch branches should only increment the patch version." >&2
        policy_failures=$((policy_failures + 1))
      fi
    done
    ;;

  minor)
    # Minor branch: all files must have same major.minor, patch must be 0
    for entry in "${main_versions[@]}"; do
      file="${entry%:*}"
      main_semver="${entry#*:}"
      current_semver="${versions[$file]:-}"

      if [[ -z "$current_semver" ]]; then
        continue
      fi

      current_patch="$(extract_patch "$current_semver")"
      current_major_minor="$(extract_major_minor "$current_semver")"

      if [[ "$current_patch" != "0" ]]; then
        echo "ERROR (minor branch policy): Patch version is not 0 in '$file'" >&2
        echo "  current: $current_semver (patch $current_patch)" >&2
        echo "  Minor branches must have patch = 0 (e.g., 1.2.0)." >&2
        policy_failures=$((policy_failures + 1))
      fi

      if [[ "$current_major_minor" != "$expected_major_minor" ]]; then
        echo "ERROR (minor branch policy): Major.minor mismatch in '$file'" >&2
        echo "  current: $current_semver (major.minor $current_major_minor)" >&2
        echo "  expected: major.minor $expected_major_minor" >&2
        echo "  All files in minor branches must have the same major.minor version." >&2
        policy_failures=$((policy_failures + 1))
      fi
    done
    ;;

  major)
    # Major branch: all files must have same major, minor and patch must be 0
    for entry in "${main_versions[@]}"; do
      file="${entry%:*}"
      main_semver="${entry#*:}"
      current_semver="${versions[$file]:-}"

      if [[ -z "$current_semver" ]]; then
        continue
      fi

      current_major="$(extract_major "$current_semver")"
      current_minor="$(extract_minor "$current_semver")"
      current_patch="$(extract_patch "$current_semver")"

      if [[ "$current_major" != "$expected_major" ]]; then
        echo "ERROR (major branch policy): Major version mismatch in '$file'" >&2
        echo "  current: $current_semver (major $current_major)" >&2
        echo "  expected: major $expected_major" >&2
        echo "  All files in major branches must have the same major version." >&2
        policy_failures=$((policy_failures + 1))
      fi

      if [[ "$current_minor" != "0" ]]; then
        echo "ERROR (major branch policy): Minor version is not 0 in '$file'" >&2
        echo "  current: $current_semver (minor $current_minor)" >&2
        echo "  Major branches must have minor = 0 (e.g., 2.0.0)." >&2
        policy_failures=$((policy_failures + 1))
      fi

      if [[ "$current_patch" != "0" ]]; then
        echo "ERROR (major branch policy): Patch version is not 0 in '$file'" >&2
        echo "  current: $current_semver (patch $current_patch)" >&2
        echo "  Major branches must have patch = 0 (e.g., 2.0.0)." >&2
        policy_failures=$((policy_failures + 1))
      fi
    done
    ;;
esac

if [[ "$policy_failures" -ne 0 ]]; then
  echo >&2
  echo "Branch policy validation failed with $policy_failures issue(s)." >&2
  exit "$EXIT_VALIDATION"
fi

echo "Branch policy validation passed."
exit "$EXIT_OK"
