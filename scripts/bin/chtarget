#!/usr/bin/env bash

# chtarget - Change the parent branch of a targeted branch via rebase.
#
# See usage below for details, or run: chtarget -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  chtarget NEWPARENT [OPTIONS]
  chtarget -h | --help

Change the parent branch of the current targeted branch via rebase.

Arguments:
  NEWPARENT          New parent version branch (required)
                     Example: v1.2.3, v2.0.0

Options:
  -h, --help         Output this help to stdout and exit
  -d, --dry-run      Preview rebase without making changes
  -v, --verbose      Show detailed information

Examples:
  # Rebase current branch onto new parent
  chtarget v1.2.3

  # Preview rebase
  chtarget v1.2.3 -d

Outputs:
  - Writes status messages to stdout
  - Writes errors to stderr

Exit codes:
  0  Success
  1  Argument error
  2  Git operation failed
  4  Working tree not clean
  5  Rebase conflicts detected
EOF
}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Ensure Git hooks are installed
ensure_hooks_installed

NEWPARENT=""
DRY_RUN=false
VERBOSE=false

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -d | --dry-run)
      DRY_RUN=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    *)
      if [[ -z "$NEWPARENT" ]]; then
        NEWPARENT="$1"
      else
        bt_error_exit 1 "Unexpected argument: $1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$NEWPARENT" ]]; then
  bt_error_exit 1 "NEWPARENT is required"
fi

cd "$REPO_ROOT"

TARGET_BRANCH=$(bt_get_current_branch || bt_error_exit 2 "Failed to determine current branch")
bt_info "Current branch: $TARGET_BRANCH"

# Check working tree is clean
if ! git diff --quiet || ! git diff --cached --quiet; then
  bt_error_exit 4 "Working tree must be clean before running chtarget"
fi

bt_info "Fetching from remote..."
if ! git fetch origin >/dev/null 2>&1; then
  bt_error_exit 4 "Failed to fetch from origin"
fi

# Check new parent exists
if ! git show-ref --verify --quiet "refs/remotes/origin/$NEWPARENT"; then
  bt_error_exit 2 "New parent branch '$NEWPARENT' not found on origin"
fi

bt_info "Rebasing '$TARGET_BRANCH' onto '$NEWPARENT'"

if [[ "$DRY_RUN" == true ]]; then
  bt_success "Dry-run passed"
  bt_info "Rebase preview: git rebase origin/$NEWPARENT"
  exit 0
fi

export BRITETEST_BYPASS_HOOKS=true
if ! git rebase "origin/$NEWPARENT"; then
  unset BRITETEST_BYPASS_HOOKS
  bt_warn "Rebase conflicts detected"
  bt_info "Resolve conflicts and continue:"
  echo "  1. Resolve conflicts in your editor"
  echo "  2. Stage resolved files: git add ."
  echo "  3. Continue rebase: git rebase --continue"
  echo "  4. Push with lease: git push --force-with-lease origin $TARGET_BRANCH"
  bt_error_exit 5 "Rebase paused for conflict resolution"
fi

bt_info "Pushing rebased branch..."
if ! git push --force-with-lease origin "$TARGET_BRANCH"; then
  unset BRITETEST_BYPASS_HOOKS
  bt_error_exit 2 "Failed to push rebased branch"
fi
unset BRITETEST_BYPASS_HOOKS

bt_success "Branch retargeted successfully"
exit 0
