#!/usr/bin/env bash

# mrgbranch - Fetch and pull latest changes from remote.
#
# See usage below for details, or run: mrgbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  mrgbranch [OPTIONS] [BRANCH] [-- TOKENS]
  mrgbranch {-h | --help}

Synchronizes a local branch with its corresponding remote branch when
it is safe to do so. Shows summary of changes to a local branch.
Warns if a branch is behind its parent branch or if a local branch
has diverged from its corresponding remote. A reachable remote is
required.
Sync for a branch is skipped when that local branch has uncommitted
changes.

Arguments:
  BRANCH            The name of the local branch to synchronize with
                    its corresponding remote branch. If BRANCH is
                    specified, the -a option must not be specified. If
                    BRANCH and the -a option are not specified, BRANCH
                    defaults to the name of the current branch. If the
                    -a option is specified, all local branches are
                    synced to their corresponding remote branches. If
                    a local branch has no corresponding remote branch,
                    it is skipped.

Options:
  -h, --help        Output this help to stdout and exit (other options
                    and arguments are ignored).
  -a                Sync all local branches with their corresponding
                    remote branch (skips local branches with no
                    corresponding remote). This option is not allowed
                    if BRANCH is specified.
  -d                Preview what would happen without changing anything
                    in your repository (no fetch, no pull, no branch
                    updates).
  -m TOKEN          Add comment message (GitHub style, requires quotes
                    if spaces in TOKEN).
  --message TOKEN   Add comment message (GitHub style, requires quotes
                    if spaces in TOKEN).
  -- TOKENS         Add comment (Unix style, the tokens after -- form
                    the comment). Captures all remaining tokens as the
                    comment. There must be at least one token after --.
                    Whitespace between tokens is replaced with a single
                    space. For a quoted token, the quotes are removed
                    and whitespace within the token is preserved.
  -v                Show detailed change and diagnostic information.

  Options -m TOKEN, --message TOKEN, and -- TOKENS are mutually exclusive.
  Only one may be specified.

Examples:
  # Sync current branch only
  mrgbranch

  # Sync with verbose output
  mrgbranch -v

  # Sync all branches
  mrgbranch -a

  # Preview sync (dry run) for current branch
  mrgbranch -d

  # Preview sync (dry run) for a specific branch
  mrgbranch -d dev/release-v1.0.0

  # Invalid: cannot combine -a with BRANCH
  mrgbranch -a dev/release-v1.0.0

  # Sync with comment
  mrgbranch -m "Getting latest before starting feature work."

  # Unix-style comment
  mrgbranch -- Getting latest changes.

  # Sync a specific branch
  mrgbranch dev/release-v1.0.0

  # Sync a specific branch with verbose output
  mrgbranch -v dev/release-v1.0.0

  # Sync a specific branch with message option
  mrgbranch --message "Sync before testing." dev/release-v1.0.0

  # Sync a specific branch with Unix-style comment
  mrgbranch fix/memory-fault-v1.0.0 -- sync fix with remote.

Outputs:
  - Writes help text, status messages, and results or summaries
    to stdout.
  - Writes errors and diagnostics to stderr.
  - Writes a report to:
    - <repo>/reports/branch/mrgbranch-<datetime>.md (normal run)
    - <repo>/reports/branch/mrgbranch-d-<datetime>.md (dry run)
  - Report includes:
    - Header with report title and timestamp.
    - Command line used for the run.
    - Branch scope summary for the run (requested branch or all).
    - Totals summary (synchronized, skipped, total evaluated).
    - Branch results table with one row per evaluated branch.
      Required columns include branch name, sync status
      (synchronized/skipped), and skip reason when skipped.
    - Optional notes section for additional diagnostics or
      workflow guidance.
  - Older dry-run reports are removed when a new report is generated.

Exit codes:
  0   Success (operation completed successfully for the requested
      branch scope; dry run completes with no repository changes).
  1   Argument or validation error.
  2   Remote disconnected.
  3   Partial success: at least one local branch was synchronized, and
      at least one branch was skipped. See output for per-branch reasons.
  4   No branches synchronized: all evaluated branches were skipped.
      See output for per-branch reasons.
  5   No local branches.
  6   No remote branches for the local branches.

If a branch is skipped because local and remote have diverged:
  1. Inspect branch sync status:
       lsbranch BRANCH -v
  2. If your branch needs latest parent updates first:
       mrgdown
  3. If divergence remains, use one possible script workflow
     (for example, copy fixes to a clean branch):
       copyfix SOURCE_BRANCH
  4. Run mrgbranch again.
EOF
}

# High-Level Flow:
# - Synchronizes current branch with remote by fetching and pulling latest
#   updates.
# - Validates branch/repository conditions before sync operations.
# - Reports sync results and non-fast-forward/error situations.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BRANCH_REPORTS_DIR="$REPO_ROOT/reports/branch"
RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
REPORT_FILE=""
ORIGINAL_ARGS=("$@")

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"

# Default options
SYNC_ALL=false
VERBOSE=false
COMMENT=""
DRY_RUN=false
TARGET_BRANCH=""

CURRENT_BRANCH=""

EVALUATED_COUNT=0
SYNCED_COUNT=0
SKIPPED_COUNT=0
REMOTE_MATCH_COUNT=0

declare -a RESULT_BRANCHES=()
declare -a RESULT_STATUS=()
declare -a RESULT_REASON=()


format_command_line() {
  local formatted="mrgbranch"
  local arg

  for arg in "${ORIGINAL_ARGS[@]}"; do
    printf -v formatted '%s %q' "$formatted" "$arg"
  done

  printf '%s\n' "$formatted"
}

initialize_report_file() {
  if [[ "$DRY_RUN" == true ]]; then
    REPORT_FILE="$BRANCH_REPORTS_DIR/mrgbranch-d-${RUN_TS_FILE}.md"
  else
    REPORT_FILE="$BRANCH_REPORTS_DIR/mrgbranch-${RUN_TS_FILE}.md"
  fi
}

cleanup_old_dry_run_reports() {
  local old_report

  for old_report in "$BRANCH_REPORTS_DIR"/mrgbranch-d-*.md; do
    [[ -e "$old_report" ]] || continue
    [[ -n "$REPORT_FILE" && "$old_report" == "$REPORT_FILE" ]] && continue
    rm -f "$old_report"
  done
}

is_remote_connected() {
  git remote get-url origin >/dev/null 2>&1 || return 1
  git ls-remote --heads origin >/dev/null 2>&1 || return 1
}

branch_has_uncommitted_changes() {
  local branch="$1"

  if [[ "$branch" != "$CURRENT_BRANCH" ]]; then
    return 1
  fi

  [[ -n "$(git status --porcelain 2>/dev/null || true)" ]]
}

branch_has_remote() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

branch_is_diverged() {
  local branch="$1"

  local local_commit
  local remote_commit
  local merge_base

  local_commit="$(git rev-parse "$branch" 2>/dev/null || true)"
  remote_commit="$(git rev-parse "origin/$branch" 2>/dev/null || true)"
  merge_base="$(git merge-base "$branch" "origin/$branch" 2>/dev/null || true)"

  [[ -n "$local_commit" && -n "$remote_commit" && -n "$merge_base" ]] || return 1

  [[ "$merge_base" != "$local_commit" && "$merge_base" != "$remote_commit" ]]
}

branch_is_up_to_date() {
  local branch="$1"
  local local_commit
  local remote_commit

  local_commit="$(git rev-parse "$branch" 2>/dev/null || true)"
  remote_commit="$(git rev-parse "origin/$branch" 2>/dev/null || true)"

  [[ -n "$local_commit" && "$local_commit" == "$remote_commit" ]]
}

branch_fast_forward_possible() {
  local branch="$1"

  local local_commit
  local remote_commit
  local merge_base

  local_commit="$(git rev-parse "$branch" 2>/dev/null || true)"
  remote_commit="$(git rev-parse "origin/$branch" 2>/dev/null || true)"
  merge_base="$(git merge-base "$branch" "origin/$branch" 2>/dev/null || true)"

  [[ -n "$local_commit" && -n "$remote_commit" && -n "$merge_base" ]] || return 1

  [[ "$merge_base" == "$local_commit" ]]
}

add_result() {
  local branch="$1"
  local status="$2"
  local reason="$3"

  RESULT_BRANCHES+=("$branch")
  RESULT_STATUS+=("$status")
  RESULT_REASON+=("$reason")
}

warn_branch_behind_parent() {
  local branch="$1"

  local parent_branch
  parent_branch="$(bt_resolve_parent_branch "$branch" "")"
  [[ -n "$parent_branch" ]] || return 0

  local behind_parent
  behind_parent="$(git rev-list --count "$branch..origin/$parent_branch" 2>/dev/null || echo 0)"
  [[ "$behind_parent" =~ ^[0-9]+$ ]] || behind_parent=0

  if [[ "$behind_parent" -gt 0 ]]; then
    bt_warn "Branch '$branch' is $behind_parent commit(s) behind parent '$parent_branch'"
    if bt_is_protected_branch "$branch"; then
      bt_info "Protected branches require an approver-managed merge workflow"
    else
      bt_info "Run: mrgdown"
    fi
  fi
}

evaluate_branch() {
  local branch="$1"

  EVALUATED_COUNT=$((EVALUATED_COUNT + 1))

  if ! branch_has_remote "$branch"; then
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    add_result "$branch" "skipped" "no corresponding remote branch"
    if [[ "$VERBOSE" == true ]]; then
      bt_warn "Skipped '$branch': no corresponding remote branch"
    fi
    return 0
  fi

  REMOTE_MATCH_COUNT=$((REMOTE_MATCH_COUNT + 1))

  if branch_has_uncommitted_changes "$branch"; then
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    add_result "$branch" "skipped" "local branch has uncommitted changes"
    bt_warn "Skipped '$branch': local branch has uncommitted changes"
    return 0
  fi

  if branch_is_diverged "$branch"; then
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    add_result "$branch" "skipped" "local and remote have diverged"
    bt_warn "Skipped '$branch': local and remote have diverged"
    return 0
  fi

  if branch_is_up_to_date "$branch"; then
    SYNCED_COUNT=$((SYNCED_COUNT + 1))
    add_result "$branch" "synchronized" "already up to date"
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Branch '$branch' is already up to date"
    fi
    warn_branch_behind_parent "$branch"
    return 0
  fi

  if ! branch_fast_forward_possible "$branch"; then
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    add_result "$branch" "skipped" "cannot fast-forward safely"
    bt_warn "Skipped '$branch': cannot fast-forward safely"
    return 0
  fi

  if [[ "$DRY_RUN" == true ]]; then
    SYNCED_COUNT=$((SYNCED_COUNT + 1))
    add_result "$branch" "synchronized" "would synchronize (dry run)"
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Dry run: would synchronize '$branch'"
    fi
    warn_branch_behind_parent "$branch"
    return 0
  fi

  if [[ "$branch" == "$CURRENT_BRANCH" ]]; then
    if git merge --ff-only "origin/$branch" >/dev/null 2>&1; then
      SYNCED_COUNT=$((SYNCED_COUNT + 1))
      add_result "$branch" "synchronized" "fast-forwarded from remote"
      bt_success "Synchronized '$branch'"
      warn_branch_behind_parent "$branch"
      return 0
    fi

    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    add_result "$branch" "skipped" "failed to fast-forward current branch"
    bt_warn "Skipped '$branch': failed to fast-forward current branch"
    return 0
  fi

  if git branch -f "$branch" "origin/$branch" >/dev/null 2>&1; then
    SYNCED_COUNT=$((SYNCED_COUNT + 1))
    add_result "$branch" "synchronized" "fast-forwarded from remote"
    if [[ "$VERBOSE" == true ]]; then
      bt_success "Synchronized '$branch'"
    fi
    warn_branch_behind_parent "$branch"
    return 0
  fi

  SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
  add_result "$branch" "skipped" "failed to update local branch reference"
  bt_warn "Skipped '$branch': failed to update local branch reference"
}

generate_report() {
  local command_text
  local branch_scope
  local i

  command_text="$(format_command_line)"
  if [[ "$SYNC_ALL" == true ]]; then
    branch_scope="all local branches"
  else
    branch_scope="$TARGET_BRANCH"
  fi

  mkdir -p "$BRANCH_REPORTS_DIR"

  cat > "$REPORT_FILE" <<EOF
# Sync From Remote Report ${RUN_TS_DISPLAY}

**Command:** \`${command_text}\`

**Branch Scope:** \`${branch_scope}\`

**Synchronized:** ${SYNCED_COUNT}<br>
**Skipped:** ${SKIPPED_COUNT}<br>
**Total Evaluated:** ${EVALUATED_COUNT}

## Branch Results

| **Branch** | **Status** | **Reason** |
| --- | --- | --- |
EOF

  for ((i=0; i<${#RESULT_BRANCHES[@]}; i++)); do
    local branch="${RESULT_BRANCHES[$i]}"
    local status="${RESULT_STATUS[$i]}"
    local reason="${RESULT_REASON[$i]}"

    [[ -n "$reason" ]] || reason="-"
    reason="${reason//|/\\|}"
    printf '| %s | %s | %s |\n' "$branch" "$status" "$reason" >> "$REPORT_FILE"
  done

  if [[ -n "$COMMENT" ]]; then
    printf '\n## Notes\n\n- User note: %s\n' "$COMMENT" >> "$REPORT_FILE"
  fi

  if [[ "$SKIPPED_COUNT" -gt 0 ]]; then
    printf '\n- Review skipped-branch reasons above for follow-up actions.\n' >> "$REPORT_FILE"
  fi

  if [[ "$DRY_RUN" == true ]]; then
    cleanup_old_dry_run_reports
  fi
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -a | --all)
      SYNC_ALL=true
      shift
      ;;
    -d)
      DRY_RUN=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -m requires a message argument"
      fi
      if [[ -n "$COMMENT" ]]; then
        bt_error_exit 1 "Cannot use both -m and -- for comment"
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        bt_error_exit 1 "Cannot use both -m and -- for comment"
      fi
      if [[ $# -lt 1 ]]; then
        bt_error_exit 1 "Option -- requires at least one token for comment"
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      bt_error_exit 1 "Unknown option: $1"
      ;;
    *)
      if [[ -n "$TARGET_BRANCH" ]]; then
        bt_error_exit 1 "Only one BRANCH argument is allowed"
      fi
      TARGET_BRANCH="$1"
      shift
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit 1 "Failed to determine current branch")

if [[ "$CURRENT_BRANCH" == "HEAD" && -z "$TARGET_BRANCH" ]]; then
  bt_error_exit 1 "Current branch is detached; specify BRANCH explicitly"
fi

if [[ "$SYNC_ALL" == true && -n "$TARGET_BRANCH" ]]; then
  bt_error_exit 1 "Cannot combine -a with BRANCH"
fi

if [[ -z "$TARGET_BRANCH" && "$SYNC_ALL" == false ]]; then
  TARGET_BRANCH="$CURRENT_BRANCH"
fi

if [[ "$SYNC_ALL" == false ]]; then
  if ! git show-ref --verify --quiet "refs/heads/$TARGET_BRANCH"; then
    bt_error_exit 1 "Local branch '$TARGET_BRANCH' does not exist"
  fi
fi

bt_info "Current branch: $CURRENT_BRANCH"

if [[ -n "$COMMENT" ]]; then
  bt_info "Note: $COMMENT"
fi

if ! is_remote_connected; then
  bt_error_exit 2 "Remote disconnected"
fi

if [[ "$DRY_RUN" == false ]]; then
  bt_info "Fetching from remote..."
  if ! git fetch origin 2>&1; then
    bt_error_exit 2 "Remote disconnected"
  fi
  bt_success "Fetched successfully"
  
  # Propagate repository history from remote if available
  bt_propagate_repository_history
  case $? in
    0) ;;
    1) bt_info "Updated repository history from remote" ;;
    *) ;;
  esac
else
  bt_info "Dry run: no fetch, pull, or branch updates will be performed"
fi

declare -a EVAL_BRANCHES=()
if [[ "$SYNC_ALL" == true ]]; then
  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    EVAL_BRANCHES+=("$branch")
  done < <(git for-each-ref --format='%(refname:short)' refs/heads)

  if [[ "${#EVAL_BRANCHES[@]}" -eq 0 ]]; then
    bt_error_exit 5 "No local branches"
  fi
else
  EVAL_BRANCHES=("$TARGET_BRANCH")
fi

for branch in "${EVAL_BRANCHES[@]}"; do
  evaluate_branch "$branch"
done

initialize_report_file
generate_report

bt_info "Summary: synchronized=$SYNCED_COUNT, skipped=$SKIPPED_COUNT, total=$EVALUATED_COUNT"
bt_success "Report generated: ${REPORT_FILE#${REPO_ROOT}/}"

if [[ "$REMOTE_MATCH_COUNT" -eq 0 ]]; then
  bt_error_exit 6 "No remote branches for the local branches"
fi

if [[ "$SYNCED_COUNT" -gt 0 && "$SKIPPED_COUNT" -gt 0 ]]; then
  bt_success "Sync complete: partial success"
  exit 3
fi

if [[ "$SYNCED_COUNT" -eq 0 ]]; then
  bt_warn "Sync complete: no branches synchronized"
  exit 4
fi

bt_success "Sync complete"
exit 0
