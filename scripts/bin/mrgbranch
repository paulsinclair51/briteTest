#!/usr/bin/env bash

# mrgbranch - Fetch and pull latest changes from remote.
#
# See usage below for details, or run: mrgbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  mrgbranch [OPTIONS] [-- TOKEN...]
  mrgbranch {-h | --help}

If current local branch is behind its remote branch, mrgbranch fetches
and pulls the latest changes from the remote branch into the local branch
when it is safe to do so so that the local branch is synchronized with
its remote branch.

If local and remote branches have diverged, mrgbranch attempts to
automatically resolve the divergence via rebase when it is safe to
do so.

If automatic rebase encounters conflicts, mrgbranch leaves the rebase
in progress for manual resolution. The report includes conflicting files
and guidance for manual resolution. After resolving conflicts, rerun
mrgbranch.

The merge is skipped when the current local branch has uncommitted or
untracked changes.

Options:
  -h, --help        Output this help to stdout and exit (other options
                    and arguments are ignored).
  -d                Dry-run for the branch sync workflow. No fetch, pull,
                    rebase, or branch update is performed, but the script
                    still generates the report and may delete stale dry-run
                    reports and persist report updates.
  -n TOKEN          Add notes to the report.
  -- TOKEN...       Add notes to the report.
  -o                Owner override. Allows repository owner to continue
                     when user-policy checks would otherwise skip execution,
                     for this command run only; normal role restrictions
                     apply again after exit.
  -v                Show detailed change and diagnostic information.

  For notes options '-n TOKEN' and '-- TOKEN...':
    - These options are mutually exclusive and notes are optional.
    - For '-- TOKEN...', '--' must be a separate token, followed by at least
      one or more tokens. Leading/trailing whitespace is not preserved
      and whitespace between tokens is reduced to a single space.
    - For a quoted token, whitespace is preserved and the quotes are
      removed.
    - For example, the following both have the same notes:
        mrgbranch -- do "  keep   this spacing  " for notes.
        mrgbranch -n "do   keep   this spacing   for note."
    - The resulting note from TOKEN/TOKENS must include at least
      one non-whitespace character.
    - Notes may contain \n for line breaks between notes
      and following the notes.

Examples:
  Add notes to the report:
    mrgbranch -n "Note: Getting latest changes before \nstarting feature work.\n"

  Alternate option for report note:
    mrgbranch -- Note: Getting latest changes before \nstarting feature work.\n

Examples:
  # Sync current branch only
  mrgbranch

  # Sync with verbose output
  mrgbranch -v

  # Preview sync (dry run) for current branch
  mrgbranch -d

  # Sync with report note
  mrgbranch -n "Getting latest changes before starting feature work.\n"

  # Alternate option for report note
  mrgbranch -- Getting latest changes before starting feature work.\n

Outputs:
  - Writes help text, status messages, and results or summaries
    to stdout.
  - Writes errors and diagnostics to stderr.
  - Writes a report to:
    - <repo>/reports/branch/mrgbranch-<datetime>.md (normal run)
    - <repo>/reports/branch/mrgbranch-d-<datetime>.md (dry run)
  - Report files are made read-only after generation. To edit a report,
    copy it outside the repository first.
  - Report updates generated by this run, including dry-run report deletions,
    are automatically committed and pushed when remote is
    connected/reachable, including in dry-run mode.
  - Report includes:
    - Header with report title and timestamp.
    - Command line used for the run.
    - Branch scope summary for the run (current branch).
    - Totals summary (synchronized, skipped, total evaluated).
    - Branch results table with one row per evaluated branch.
      Required columns include branch name, sync status
      (synchronized/skipped), and skip reason when skipped.
    - Divergence details section when divergence is detected,
      including auto-resolution outcome, conflicting files (if any),
      and guidance for manual resolution.
    - Optional notes section for the run note, if one was provided,
      and additional diagnostics or workflow guidance.
  - Older dry-run reports are removed when a new report is generated.

Exit codes:
  0   Success (operation completed for current branch scope; dry run
  completes with no branch-sync changes).
  1   Argument or validation error.
  2   Remote disconnected.
  4   Branch was skipped and not synchronized (for example, no
      corresponding remote branch, uncommitted changes in worktree,
      unresolved divergence, or unsafe fast-forward).

If a branch is skipped because local and remote have diverged:
  1. Inspect branch sync status:
       lsbranch BRANCH -v
  2. If your branch needs latest parent updates first:
       mrgdown
  3. If divergence remains, use one possible script workflow
     (for example, copy fixes to a clean branch):
       copyfix SOURCE_BRANCH
  4. Run mrgbranch again.
EOF
}

# High-Level Flow:
# - Merges current branch with remote by fetching and pulling latest
#   updates.
# - Validates branch/repository conditions before merge operations.
# - Reports merge branch results and non-fast-forward/error situations.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BRANCH_REPORTS_DIR="$REPO_ROOT/reports/branch"
RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
REPORT_FILE=""
ORIGINAL_ARGS=("$@")
BRANCH_REPORTS_DIR_UNLOCKED=false

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_NOT_FOUND=2
readonly EXIT_CONFIG_ERROR=4

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

# Default options
VERBOSE=false
COMMENT=""
DRY_RUN=false
OWNER_OVERRIDE=false
OWNER_OVERRIDE_ACTIVE=false

CURRENT_BRANCH=""
REBASE_IN_PROGRESS_AT_START=false

EVALUATED_COUNT=0
SYNCED_COUNT=0
SKIPPED_COUNT=0
GLOBAL_SKIP_REASON=""

declare -a RESULT_BRANCHES=()
declare -a RESULT_STATUS=()
declare -a RESULT_REASON=()
declare -a DIVERGENCE_BRANCHES=()
declare -a DIVERGENCE_OUTCOMES=()
declare -a DIVERGENCE_FILES=()
declare -a DIVERGENCE_GUIDANCE=()
# shellcheck disable=SC2034  # Consumed indirectly by shared report helper.
DRY_RUN_REPORT_DELETIONS=()

cleanup_runtime_files() {
  # shellcheck disable=SC2317  # Invoked by trap cleanup_runtime_files EXIT.
  if [[ "$BRANCH_REPORTS_DIR_UNLOCKED" == true ]]; then
    bt_report_dir_disable_writes "$BRANCH_REPORTS_DIR" "$EXIT_CONFIG_ERROR" || true
    BRANCH_REPORTS_DIR_UNLOCKED=false
  fi
}

trap cleanup_runtime_files EXIT

enable_branch_reports_write_access() {
  bt_report_dir_enable_writes "$BRANCH_REPORTS_DIR" "$EXIT_CONFIG_ERROR"
  BRANCH_REPORTS_DIR_UNLOCKED=true
}

disable_branch_reports_write_access() {
  if [[ "$BRANCH_REPORTS_DIR_UNLOCKED" == true ]]; then
    bt_report_dir_disable_writes "$BRANCH_REPORTS_DIR" "$EXIT_CONFIG_ERROR"
    BRANCH_REPORTS_DIR_UNLOCKED=false
  fi
}

get_repository_owner_login() {
  local origin_url=""
  local owner=""

  origin_url="$(git remote get-url origin 2>/dev/null || true)"
  [[ -n "$origin_url" ]] || {
    echo ""
    return 0
  }

  if [[ "$origin_url" =~ ^git@github\.com:([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  elif [[ "$origin_url" =~ ^https://github\.com/([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  elif [[ "$origin_url" =~ ^ssh://git@github\.com/([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  fi

  owner="$(bt_normalize_login "$owner")"
  echo "$owner"
}

is_repository_owner() {
  local user_name="$1"
  local repo_owner=""

  repo_owner="$(get_repository_owner_login)"
  [[ -n "$repo_owner" ]] || return 1

  [[ "$(bt_normalize_login "$user_name")" == "$repo_owner" ]]
}


format_command_line() {
  local formatted="mrgbranch"
  local arg

  for arg in "${ORIGINAL_ARGS[@]}"; do
    printf -v formatted '%s %q' "$formatted" "$arg"
  done

  printf '%s\n' "$formatted"
}

initialize_report_file() {
  if [[ "$DRY_RUN" == true ]]; then
    REPORT_FILE="$BRANCH_REPORTS_DIR/mrgbranch-d-${RUN_TS_FILE}.md"
  else
    REPORT_FILE="$BRANCH_REPORTS_DIR/mrgbranch-${RUN_TS_FILE}.md"
  fi
}

cleanup_old_dry_run_reports() {
  local old_report

  # shellcheck disable=SC2034  # Consumed indirectly by shared report helper.
  DRY_RUN_REPORT_DELETIONS=()

  for old_report in "$BRANCH_REPORTS_DIR"/mrgbranch-d-*.md; do
    [[ -e "$old_report" ]] || continue
    [[ -n "$REPORT_FILE" && "$old_report" == "$REPORT_FILE" ]] && continue
    bt_report_remove_and_record \
      "$REPO_ROOT" DRY_RUN_REPORT_DELETIONS "$old_report" "dry-run report"
  done
}

persist_report_changes() {
  local commit_message

  commit_message="mrgbranch: update branch report ${RUN_TS_DISPLAY}"
  bt_report_persist_changes \
    "$REPO_ROOT" "$REPORT_FILE" DRY_RUN_REPORT_DELETIONS \
    "$commit_message" "$EXIT_CONFIG_ERROR" false
}

is_remote_connected() {
  git remote get-url origin >/dev/null 2>&1 || return 1
  git ls-remote --heads origin >/dev/null 2>&1 || return 1
}

current_branch_has_uncommitted_changes() {
  bt_is_worktree_dirty
}

branch_has_remote() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

remote_branch_exists() {
  local branch="$1"
  git ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1
}

is_rebase_in_progress() {
  [[ -d "$(git rev-parse --git-path rebase-merge 2>/dev/null || true)" || -d "$(git rev-parse --git-path rebase-apply 2>/dev/null || true)" ]]
}

get_rebase_head_branch() {
  local head_name=""
  local path

  for path in "$(git rev-parse --git-path rebase-merge/head-name 2>/dev/null || true)" "$(git rev-parse --git-path rebase-apply/head-name 2>/dev/null || true)"; do
    [[ -f "$path" ]] || continue
    head_name="$(tr -d '\n' < "$path")"
    break
  done

  [[ -n "$head_name" ]] || return 1
  head_name="${head_name#refs/heads/}"
  [[ -n "$head_name" ]] || return 1
  printf '%s\n' "$head_name"
}

get_conflict_files() {
  local conflict_files
  conflict_files="$(git diff --name-only --diff-filter=U 2>/dev/null || true)"
  if [[ -z "$conflict_files" ]]; then
    conflict_files="$(git --no-optional-locks status --porcelain 2>/dev/null | awk '/^UU / {print $2}')"
  fi
  [[ -n "$conflict_files" ]] || conflict_files="(unable to determine conflicting files)"
  printf '%s\n' "$conflict_files"
}

continue_rebase_if_in_progress() {
  local branch="$1"
  local progressed=false

  if ! is_rebase_in_progress; then
    return 1
  fi

  while is_rebase_in_progress; do
    local conflict_files
    conflict_files="$(get_conflict_files)"
    if [[ "$conflict_files" != "(unable to determine conflicting files)" ]]; then
      SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
      add_result "$branch" "skipped" "manual conflict resolution required (rebase in progress)"
      add_divergence_detail \
        "$branch" \
        "rebase paused for manual conflict resolution" \
        "$conflict_files" \
        "Resolve conflicts, stage files, rerun mrgbranch to continue. Use git rebase --abort to cancel."
      bt_warn "Skipped '$branch': rebase is paused for manual conflict resolution."
      return 0
    fi

    bt_info "Rebase in progress on '$branch'; attempting to continue"
    if ! GIT_BYPASS_HOOKS=true GIT_EDITOR=true git rebase --continue >/dev/null 2>&1; then
      local continue_conflicts
      continue_conflicts="$(get_conflict_files)"
      if [[ "$continue_conflicts" != "(unable to determine conflicting files)" ]]; then
        SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
        add_result "$branch" "skipped" "manual conflict resolution required (rebase in progress)"
        add_divergence_detail \
          "$branch" \
          "rebase paused for manual conflict resolution" \
          "$conflict_files" \
          "Resolve conflicts, stage files, rerun mrgbranch to continue. Use git rebase --abort to cancel."
        bt_warn "Skipped '$branch': rebase paused again due to conflicts."
        return 0
      fi
      SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
      add_result "$branch" "skipped" "failed to continue rebase"
      bt_warn "Skipped '$branch': failed to continue rebase."
      return 0
    fi
    progressed=true
  done

  if [[ "$progressed" == true ]]; then
    bt_success "Completed in-progress rebase for '$branch'."
  fi
  return 1
}

branch_is_diverged() {
  local branch="$1"

  local local_commit
  local remote_commit
  local merge_base

  local_commit="$(git rev-parse "$branch" 2>/dev/null || true)"
  remote_commit="$(git rev-parse "origin/$branch" 2>/dev/null || true)"
  merge_base="$(git merge-base "$branch" "origin/$branch" 2>/dev/null || true)"

  [[ -n "$local_commit" && -n "$remote_commit" && -n "$merge_base" ]] || return 1

  [[ "$merge_base" != "$local_commit" && "$merge_base" != "$remote_commit" ]]
}

branch_is_up_to_date() {
  local branch="$1"
  local local_commit
  local remote_commit

  local_commit="$(git rev-parse "$branch" 2>/dev/null || true)"
  remote_commit="$(git rev-parse "origin/$branch" 2>/dev/null || true)"

  [[ -n "$local_commit" && "$local_commit" == "$remote_commit" ]]
}

branch_contains_remote() {
  local branch="$1"
  local local_commit
  local remote_commit
  local merge_base

  local_commit="$(git rev-parse "$branch" 2>/dev/null || true)"
  remote_commit="$(git rev-parse "origin/$branch" 2>/dev/null || true)"
  merge_base="$(git merge-base "$branch" "origin/$branch" 2>/dev/null || true)"

  [[ -n "$local_commit" && -n "$remote_commit" && -n "$merge_base" ]] || return 1

  [[ "$merge_base" == "$remote_commit" ]]
}

branch_fast_forward_possible() {
  local branch="$1"

  local local_commit
  local remote_commit
  local merge_base

  local_commit="$(git rev-parse "$branch" 2>/dev/null || true)"
  remote_commit="$(git rev-parse "origin/$branch" 2>/dev/null || true)"
  merge_base="$(git merge-base "$branch" "origin/$branch" 2>/dev/null || true)"

  [[ -n "$local_commit" && -n "$remote_commit" && -n "$merge_base" ]] || return 1

  [[ "$merge_base" == "$local_commit" ]]
}

add_result() {
  local branch="$1"
  local status="$2"
  local reason="$3"

  RESULT_BRANCHES+=("$branch")
  RESULT_STATUS+=("$status")
  RESULT_REASON+=("$reason")
}

add_divergence_detail() {
  local branch="$1"
  local outcome="$2"
  local files="$3"
  local guidance="$4"

  DIVERGENCE_BRANCHES+=("$branch")
  DIVERGENCE_OUTCOMES+=("$outcome")
  DIVERGENCE_FILES+=("$files")
  DIVERGENCE_GUIDANCE+=("$guidance")
}

attempt_auto_resolve_divergence() {
  local branch="$1"

  if [[ "$DRY_RUN" == true ]]; then
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    add_result "$branch" "skipped" "local and remote have diverged (dry run: auto-resolution not executed)"
    add_divergence_detail \
      "$branch" \
      "dry-run only; auto-resolution not executed" \
      "" \
      "Run mrgbranch without -d to attempt automatic rebase, or run git rebase origin/$branch and resolve conflicts manually."
    bt_warn "Skipped '$branch': local and remote have diverged (dry run)"
    return 0
  fi

  bt_warn "Branch '$branch' has diverged; attempting automatic rebase onto remote $branch."

  if GIT_BYPASS_HOOKS=true GIT_BYPASS_HOOKS=true git rebase "origin/$branch" >/dev/null 2>&1; then
    SYNCED_COUNT=$((SYNCED_COUNT + 1))
    add_result "$branch" "synchronized" "auto-resolved divergence via rebase"
    add_divergence_detail \
      "$branch" \
      "auto-resolved via rebase" \
      "" \
      "Review rebased commits, run tests, and push when ready."
    bt_success "Synchronized '$branch' (auto-resolved divergence)."
    warn_branch_behind_parent "$branch"
    return 0
  fi

  local conflict_files
  conflict_files="$(get_conflict_files)"

  SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
  add_result "$branch" "skipped" "diverged; rebase paused for manual conflict resolution"
  add_divergence_detail \
    "$branch" \
    "rebase paused for manual conflict resolution" \
    "$conflict_files" \
    "Resolve conflicts in listed files, stage them, and rerun mrgbranch to continue rebase. Use git rebase --abort to cancel."
  bt_warn "Skipped '$branch': diverged and requires manual conflict resolution."
}

warn_branch_behind_parent() {
  local branch="$1"

  local parent_branch
  parent_branch="$(bt_resolve_parent_branch "$branch" "")"
  [[ -n "$parent_branch" ]] || return 0

  local behind_parent
  behind_parent="$(git rev-list --count "$branch..origin/$parent_branch" 2>/dev/null || echo 0)"
  [[ "$behind_parent" =~ ^[0-9]+$ ]] || behind_parent=0

  if [[ "$behind_parent" -gt 0 ]]; then
    bt_warn "Branch '$branch' is $behind_parent commit(s) behind parent '$parent_branch'."
    if bt_is_protected_branch "$branch"; then
      bt_info "Protected branches require an approver-managed merge workflow."
    else
      bt_info "Run: mrgdown"
    fi
  fi
}

evaluate_branch() {
  local branch="$1"

  EVALUATED_COUNT=$((EVALUATED_COUNT + 1))

  if [[ -n "$GLOBAL_SKIP_REASON" ]]; then
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    add_result "$branch" "skipped" "$GLOBAL_SKIP_REASON"
    bt_warn "Skipped '$branch': $GLOBAL_SKIP_REASON"
    return 0
  fi

  if continue_rebase_if_in_progress "$branch"; then
    return 0
  fi

  if ! branch_has_remote "$branch"; then
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    add_result "$branch" "skipped" "no corresponding remote branch"
    if [[ "$VERBOSE" == true ]]; then
      bt_warn "Skipped '$branch': no corresponding remote branch."
    fi
    return 0
  fi

  if branch_is_diverged "$branch"; then
    attempt_auto_resolve_divergence "$branch"
    return 0
  fi

  if branch_is_up_to_date "$branch"; then
    SYNCED_COUNT=$((SYNCED_COUNT + 1))
    add_result "$branch" "synchronized" "already up to date"
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Branch '$branch' is already up to date."
    fi
    warn_branch_behind_parent "$branch"
    return 0
  fi

  if branch_contains_remote "$branch"; then
    SYNCED_COUNT=$((SYNCED_COUNT + 1))
    add_result "$branch" "synchronized" "contains latest remote commits (local ahead)"
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Branch '$branch' already contains latest remote commits."
    fi
    warn_branch_behind_parent "$branch"
    return 0
  fi

  if ! branch_fast_forward_possible "$branch"; then
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    add_result "$branch" "skipped" "cannot fast-forward safely"
    bt_warn "Skipped '$branch': cannot fast-forward safely."
    return 0
  fi

  if [[ "$DRY_RUN" == true ]]; then
    SYNCED_COUNT=$((SYNCED_COUNT + 1))
    add_result "$branch" "synchronized" "would synchronize (dry run)"
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Dry run: would synchronize '$branch'."
    fi
    warn_branch_behind_parent "$branch"
    return 0
  fi

  if GIT_BYPASS_HOOKS=true git merge --ff-only "origin/$branch" >/dev/null 2>&1; then
    SYNCED_COUNT=$((SYNCED_COUNT + 1))
    add_result "$branch" "synchronized" "fast-forwarded from remote"
    bt_success "Synchronized '$branch'."
    warn_branch_behind_parent "$branch"
    return 0
  fi

  SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
  add_result "$branch" "skipped" "failed to fast-forward current branch"
  bt_warn "Skipped '$branch': failed to fast-forward current branch."
}

generate_report() {
  local command_text
  local branch_scope
  local i

  command_text="$(format_command_line)"
  branch_scope="$CURRENT_BRANCH"

  enable_branch_reports_write_access

  cat > "$REPORT_FILE" <<EOF
# Sync From Remote Report ${RUN_TS_DISPLAY}

**Command:** \`${command_text}\`

**Branch Scope:** \`${branch_scope}\`

**Synchronized:** ${SYNCED_COUNT}<br>
**Skipped:** ${SKIPPED_COUNT}<br>
**Total Evaluated:** ${EVALUATED_COUNT}

## Branch Results

| **Branch** | **Status** | **Reason** |
| --- | --- | --- |
EOF

  for ((i=0; i<${#RESULT_BRANCHES[@]}; i++)); do
    local branch="${RESULT_BRANCHES[$i]}"
    local status="${RESULT_STATUS[$i]}"
    local reason="${RESULT_REASON[$i]}"

    [[ -n "$reason" ]] || reason="-"
    reason="${reason//|/\\|}"
    printf '| %s | %s | %s |\n' "$branch" "$status" "$reason" >> "$REPORT_FILE"
  done

  if [[ -n "$COMMENT" ]]; then
    printf '\n## Notes\n\n- User note: %s.\n' "$COMMENT" >> "$REPORT_FILE"
  fi

  if [[ "$SKIPPED_COUNT" -gt 0 ]]; then
    printf '\n- Review skipped-branch reasons above for follow-up actions.\n' >> "$REPORT_FILE"
  fi

  if [[ "${#DIVERGENCE_BRANCHES[@]}" -gt 0 ]]; then
    printf '\n## Divergence Details\n' >> "$REPORT_FILE"
    for ((i=0; i<${#DIVERGENCE_BRANCHES[@]}; i++)); do
      local d_branch="${DIVERGENCE_BRANCHES[$i]}"
      local d_outcome="${DIVERGENCE_OUTCOMES[$i]}"
      local d_files="${DIVERGENCE_FILES[$i]}"
      local d_guidance="${DIVERGENCE_GUIDANCE[$i]}"

      # shellcheck disable=SC2016  # Backticks are literal markdown delimiters here.
      printf '\n### `%s`\n\n' "$d_branch" >> "$REPORT_FILE"
      printf -- '- Outcome: %s\n' "$d_outcome" >> "$REPORT_FILE"
      if [[ -n "$d_files" ]]; then
        printf -- '- Conflicting files:\n' >> "$REPORT_FILE"
        while IFS= read -r file_path; do
          [[ -n "$file_path" ]] || continue
          printf '  - %s\n' "$file_path" >> "$REPORT_FILE"
        done <<< "$d_files"
      fi
      if [[ -n "$d_guidance" ]]; then
        printf -- '- Guidance: %s.\n' "$d_guidance" >> "$REPORT_FILE"
      fi
    done
  fi

  if [[ "$DRY_RUN" == true ]]; then
    cleanup_old_dry_run_reports
  fi

  bt_report_mark_read_only "$REPORT_FILE" "$EXIT_CONFIG_ERROR"
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -d)
      DRY_RUN=true
      shift
      ;;
    -o)
      OWNER_OVERRIDE=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -m requires a message argument."
      fi
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -m and -- for comment."
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -m and -- for comment."
      fi
      if [[ $# -lt 1 ]]; then
        usage_error "Option -- requires at least one token for comment."
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1."
      ;;
    *)
      usage_error "Unexpected argument: $1."
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  usage_error "Failed to determine current branch.")

if [[ "$CURRENT_BRANCH" == "HEAD" ]]; then
  if is_rebase_in_progress; then
    REBASE_IN_PROGRESS_AT_START=true
    CURRENT_BRANCH="$(get_rebase_head_branch || true)"
    [[ -n "$CURRENT_BRANCH" ]] || usage_error "Cannot sync from detached branch state."
    bt_info "Detected rebase in progress for branch: $CURRENT_BRANCH"
  else
    usage_error "Cannot sync from detached branch state."
  fi
fi

if is_rebase_in_progress; then
  REBASE_IN_PROGRESS_AT_START=true
fi

bt_info "Current branch: $CURRENT_BRANCH"

if [[ "$OWNER_OVERRIDE" == true ]]; then
  CURRENT_USER="$(bt_require_login || true)"
  if [[ -z "$CURRENT_USER" ]]; then
    bt_error_exit "$EXIT_NOT_FOUND" "Option -o requires a resolvable GitHub login"
  fi
  if is_repository_owner "$CURRENT_USER"; then
    OWNER_OVERRIDE_ACTIVE=true
    bt_info "Owner override enabled for repository owner '$CURRENT_USER'"
  else
    bt_error_exit "$EXIT_CONFIG_ERROR" "Option -o is allowed only for the repository owner"
  fi
fi

if [[ -n "$COMMENT" ]]; then
  bt_info "Note: $COMMENT"
fi

if ! is_remote_connected; then
  bt_error_exit "$EXIT_NOT_FOUND" "Remote disconnected."
fi

if remote_branch_exists "$CURRENT_BRANCH"; then
  :
else
  GLOBAL_SKIP_REASON="current branch '$CURRENT_BRANCH' has no corresponding remote branch."
fi

if [[ "$REBASE_IN_PROGRESS_AT_START" == false ]] && current_branch_has_uncommitted_changes; then
  if [[ "$OWNER_OVERRIDE_ACTIVE" == true ]]; then
    bt_warn "Owner override enabled: proceeding despite uncommitted or untracked changes on '$CURRENT_BRANCH'."
  else
    GLOBAL_SKIP_REASON="current branch '$CURRENT_BRANCH' has uncommitted or untracked changes."
  fi
fi

if [[ -n "$GLOBAL_SKIP_REASON" ]]; then
  bt_warn "Cannot proceed: $GLOBAL_SKIP_REASON"
elif is_rebase_in_progress; then
  bt_info "Rebase already in progress; skipping fetch and continuing rebase workflow."
elif [[ "$DRY_RUN" == false ]]; then
  bt_info "Fetching from remote..."
  if ! GIT_BYPASS_HOOKS=true git fetch origin 2>&1; then
    bt_error_exit "$EXIT_NOT_FOUND" "Remote disconnected."
  fi
  bt_success "Fetched successfully"

  # Propagate repository history from remote if available
  history_status=0
  if bt_propagate_repository_history; then
    history_status=0
  else
    history_status=$?
  fi
  case "$history_status" in
    0) ;;
    1) bt_info "Updated repository history from remote." ;;
    *) ;;
  esac
else
  bt_info "Dry run: no fetch, pull, or branch updates will be performed."
fi

declare -a EVAL_BRANCHES=("$CURRENT_BRANCH")

for branch in "${EVAL_BRANCHES[@]}"; do
  evaluate_branch "$branch"
done

initialize_report_file
generate_report
persist_report_changes
disable_branch_reports_write_access

bt_info "Summary: synchronized=$SYNCED_COUNT, skipped=$SKIPPED_COUNT, total=$EVALUATED_COUNT"
bt_success "${REPORT_FILE#"${REPO_ROOT}"/} generated."

if [[ "$SYNCED_COUNT" -eq 0 ]]; then
  bt_warn "Sync complete: no branches synchronized."
  exit "$EXIT_CONFIG_ERROR"
fi

bt_success "Sync complete."
exit 0
