#!/usr/bin/env bash

# syncfromremote - Fetch and pull latest changes from remote.
#
# See usage below for details, or run: syncfromremote -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  syncfromremote [OPTIONS]
  syncfromremote -h | --help

Fetch latest changes from remote and update the current branch.
Shows summary of changes and warns if behind its parent branch or if diverged
from remote.

Features:
  - Fetches from remote
  - Pulls latest changes into current branch
  - Fast-forwards other local branches safely when -a is used
  - Shows summary of what changed
  - Warns if current branch is behind its parent branch
  - Warns if local commits exist that aren't pushed
  - Detects diverged branches and suggests resolution

Options:
  -h, --help         Output this help to stdout and exit (other options
                     and arguments are ignored).
  -a, --all          Fetch all branches and fast-forward local branches when
                     it is safe to do so
  -v, --verbose      Show detailed change information
  -m, --message MSG  Add comment message (GitHub style,
                     requires quotes if spaces)
  -- TEXT            Add comment (Unix style,
                     everything after -- is the comment)
                     Note: No quotes needed, captures all remaining arguments

Comment Options (mutually exclusive):
  -m, --message MSG  Attach a comment to the operation
  -- COMMENT TEXT    Unix-style comment (everything after -- is the comment)

Examples:
  # Sync current branch only
  syncfromremote

  # Sync with verbose output
  syncfromremote -v

  # Sync all branches
  syncfromremote -a

  # Sync with comment
  syncfromremote -m "Getting latest before starting feature work"

  # Unix-style comment
  syncfromremote -- Getting latest changes


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented
    output locations.

Exit codes:
  0   Success
  1   Argument or validation error
  2   Git fetch or pull failed
  3   Branch diverged from remote (manual resolution needed)
EOF
}

# High-Level Flow:
# - Synchronizes current branch with remote by fetching and pulling latest
#   updates.
# - Validates branch/repository conditions before sync operations.
# - Reports sync results and non-fast-forward/error situations.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Default options
SYNC_ALL=false
VERBOSE=false
COMMENT=""


check_diverged() {
  local branch="$1"
  
  # Get local and remote commit hashes
  local local_commit=$(git rev-parse "$branch" 2>/dev/null || echo "")
  local remote_commit=$(git rev-parse "origin/$branch" 2>/dev/null || echo "")
  
  if [[ -z "$local_commit" ]] || [[ -z "$remote_commit" ]]; then
    return 1
  fi
  
  # Check if branches have diverged
  local merge_base=$(git merge-base "$branch" "origin/$branch" \
    2>/dev/null || echo "")
  
  if [[ "$merge_base" != "$local_commit" ]] && \
    [[ "$merge_base" != "$remote_commit" ]]; then
    return 0  # Diverged
  fi
  
  return 1  # Not diverged
}

count_unpushed_commits() {
  local branch="$1"
  
  # Count commits that are in local branch but not in origin
  git rev-list --count "origin/$branch..$branch" 2>/dev/null || echo "0"
}

count_commits_behind_parent() {
  local branch="$1"

  local parent_branch
  parent_branch=$(bt_resolve_parent_branch "$branch" "")

  if [[ -z "$parent_branch" ]]; then
    echo "0"
    return 0
  fi

  git rev-list --count "$branch..origin/$parent_branch" 2>/dev/null || echo "0"
}

fast_forward_branch_ref() {
  local branch="$1"

  if ! git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    return 1
  fi

  local local_commit
  local remote_commit
  local merge_base
  local_commit=$(git rev-parse "$branch" 2>/dev/null || echo "")
  remote_commit=$(git rev-parse "origin/$branch" 2>/dev/null || echo "")
  merge_base=$(git merge-base "$branch" "origin/$branch" 2>/dev/null || echo "")

  if [[ -z "$local_commit" || -z "$remote_commit" ]]; then
    return 1
  fi

  if [[ "$local_commit" == "$remote_commit" ]]; then
    return 2
  fi

  if [[ "$merge_base" != "$local_commit" ]]; then
    return 1
  fi

  git branch -f "$branch" "origin/$branch" >/dev/null 2>&1
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -a | --all)
      SYNC_ALL=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -m requires a message argument"
      fi
      if [[ -n "$COMMENT" ]]; then
        bt_error_exit 1 "Cannot use both -m and -- for comment"
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        bt_error_exit 1 "Cannot use both -m and -- for comment"
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      bt_error_exit 1 "Unknown option: $1"
      ;;
    *)
      bt_error_exit 1 "Unknown argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit 2 "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

if [[ -n "$COMMENT" ]]; then
  bt_info "Note: $COMMENT"
fi

# Fetch from remote
bt_info "Fetching from remote..."
if ! git fetch origin 2>&1; then
  bt_error_exit 2 "Failed to fetch from remote"
fi
bt_success "Fetched successfully"

# Sync current branch
if [[ "$SYNC_ALL" == false ]]; then
  bt_info "Pulling latest changes into $CURRENT_BRANCH..."
  
  # Check for divergence before pulling
  if check_diverged "$CURRENT_BRANCH"; then
    bt_error_exit 3 \
      "Branch '$CURRENT_BRANCH' has diverged from remote. Manual resolution "\
"needed. Use 'git rebase' or 'merge' to resolve."
  fi
  
  # Pull changes
  if ! git pull origin "$CURRENT_BRANCH" 2>&1; then
    bt_error_exit 2 "Failed to pull changes for $CURRENT_BRANCH"
  fi
  
  bt_success "Updated $CURRENT_BRANCH"
  
  # Show commit count if verbose
  if [[ "$VERBOSE" == true ]]; then
    new_commits=$(git rev-list --count "HEAD@{1}..HEAD" 2>/dev/null || echo "?")
    if [[ "$new_commits" != "?" ]]; then
      bt_info "$new_commits new commits pulled"
    fi
  fi
else
  # Sync all local branches safely.
  bt_info "Fast-forwarding local branches where safe..."

  local_branches=$(git for-each-ref --format='%(refname:short)' refs/heads)
  updated_count=0
  skipped_count=0

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    [[ "$branch" == "$CURRENT_BRANCH" ]] && continue

    if fast_forward_branch_ref "$branch"; then
      updated_count=$((updated_count + 1))
    else
      rc=$?
      if [[ "$rc" -eq 2 ]]; then
        continue
      fi
      skipped_count=$((skipped_count + 1))
      if [[ "$VERBOSE" == true ]]; then
        bt_warn "Skipped local branch '$branch' (ahead, diverged, or no remote)"
      fi
    fi
  done <<< "$local_branches"

  bt_success "Updated $updated_count additional local branch(es)"
  if [[ "$skipped_count" -gt 0 ]]; then
    bt_warn "Skipped $skipped_count branch(es) that could not be fast-forwarded safely"
  fi
fi

# Check for unpushed commits in current branch
unpushed=$(count_unpushed_commits "$CURRENT_BRANCH")
if [[ "$unpushed" -gt 0 ]]; then
  bt_warn "Local commits not pushed: $unpushed commit(s)"
  if [[ "$VERBOSE" == true ]]; then
    git log --oneline "origin/$CURRENT_BRANCH..$CURRENT_BRANCH" \
      2>/dev/null | sed 's/^/  /'
  fi
fi

# Check if behind parent branch
PARENT_BRANCH=$(bt_resolve_parent_branch "$CURRENT_BRANCH" "")
behind_parent=$(count_commits_behind_parent "$CURRENT_BRANCH")
if [[ "$behind_parent" -gt 0 ]] && [[ -n "$PARENT_BRANCH" ]]; then
  bt_warn "Your branch is $behind_parent commit(s) behind parent '$PARENT_BRANCH'"
  if bt_is_protected_branch "$CURRENT_BRANCH"; then
    bt_info "Protected branches require an approver-managed merge workflow"
  else
    bt_info "Run: syncfromparent"
  fi
fi

bt_success "Sync complete"
exit 0
