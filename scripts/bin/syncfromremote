#!/usr/bin/env bash

# syncfromremote - Fetch and pull latest changes from remote.
#
# See usage below for details, or run: syncfromremote -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  syncfromremote [OPTIONS] [BRANCH] [-- TOKENS]
  syncfromremote {-h | --help}

Synchronizes a local branch with its corresponding remote branch when
it is safe to do so. Shows summary of changes to a local branch.
Warns if a branch is behind its parent branch or if a local branch
has diverged from its corresponding remote. A reachable remote is
required.
Sync for a branch is skipped when that local branch has uncommitted
changes.

Arguments:
  BRANCH            The name of the local branch to synchronize with
                    its corresponding remote branch. If BRANCH is
                    specified, the -a option must not be specified. If
                    BRANCH and the -a option are not specified, BRANCH
                    defaults to the name of the current branch. If the
                    -a option is specified, all local branches are
                    synced to their corresponding remote branches. If
                    a local branch has no corresponding remote branch,
                    it is skipped.

Options:
  -h, --help        Output this help to stdout and exit (other options
                    and arguments are ignored).
  -a                Sync all local branches with their corresponding
                    remote branch (skips local branches with no
                    corresponding remote). This option is not allowed
                    if BRANCH is specified.
  -d                Preview what would happen without changing anything
                    in your repository (no fetch, no pull, no branch
                    updates).
  -m TOKEN          Add comment message (GitHub style, requires quotes
                    if spaces in TOKEN).
  --message TOKEN   Add comment message (GitHub style, requires quotes
                    if spaces in TOKEN).
  -- TOKENS         Add comment (Unix style, the tokens after -- form
                    the comment). Captures all remaining tokens as the
                    comment. There must be at least one token after --.
                    Whitespace between tokens is replaced with a single
                    space. For a quoted token, the quotes are removed
                    and whitespace within the token is preserved.
  -v                Show detailed change and diagnostic information.

  Options -m TOKEN, --message TOKEN, and -- TOKENS are mutually exclusive.
  Only one may be specified.

Examples:
  # Sync current branch only
  syncfromremote

  # Sync with verbose output
  syncfromremote -v

  # Sync all branches
  syncfromremote -a

  # Preview sync (dry run) for current branch
  syncfromremote -d

  # Preview sync (dry run) for a specific branch
  syncfromremote -d dev/release-v1.0.0

  # Invalid: cannot combine -a with BRANCH
  syncfromremote -a dev/release-v1.0.0

  # Sync with comment
  syncfromremote -m "Getting latest before starting feature work."

  # Unix-style comment
  syncfromremote -- Getting latest changes.

  # Sync a specific branch
  syncfromremote dev/release-v1.0.0

  # Sync a specific branch with verbose output
  syncfromremote -v dev/release-v1.0.0

  # Sync a specific branch with message option
  syncfromremote --message "Sync before testing." dev/release-v1.0.0

  # Sync a specific branch with Unix-style comment
  syncfromremote fix/memory-fault-v1.0.0 -- sync fix with remote.

Outputs:
  - Writes help text, status messages, and results or summaries
    to stdout.
  - Writes errors and diagnostics to stderr.
  - Writes a report to:
    - <repo>/reports/syncfromremote-<datetime>.md (normal run)
    - <repo>/reports/syncfromremote-d-<datetime>.md (dry run)
  - Report includes:
    - Header with report title and timestamp.
    - Command line used for the run.
    - Branch scope summary for the run (requested branch or all).
    - Totals summary (synchronized, skipped, total evaluated).
    - Branch results table with one row per evaluated branch.
      Required columns include branch name, sync status
      (synchronized/skipped), and skip reason when skipped.
    - Optional notes section for additional diagnostics or
      workflow guidance.
  - Older dry-run reports are removed when a new report is generated.

Exit codes:
  0   Success (operation completed successfully for the requested
      branch scope; dry run completes with no repository changes).
  1   Argument or validation error.
  2   Remote disconnected.
  3   Partial success: at least one local branch was synchronized, and
      at least one branch was skipped. See output for per-branch reasons.
  4   No branches synchronized: all evaluated branches were skipped.
      See output for per-branch reasons.
  5   No local branches.
  6   No remote branches for the local branches.

If a branch is skipped because local and remote have diverged:
  1. Inspect branch sync status:
       lsbranch BRANCH -v
  2. If your branch needs latest parent updates first:
       syncfromparent
  3. If divergence remains, use one possible script workflow
     (for example, copy fixes to a clean branch):
       copyfix SOURCE_BRANCH
  4. Run syncfromremote again.
EOF
}

# High-Level Flow:
# - Synchronizes current branch with remote by fetching and pulling latest
#   updates.
# - Validates branch/repository conditions before sync operations.
# - Reports sync results and non-fast-forward/error situations.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Default options
SYNC_ALL=false
VERBOSE=false
COMMENT=""


check_diverged() {
  local branch="$1"
  
  # Get local and remote commit hashes
  local local_commit=$(git rev-parse "$branch" 2>/dev/null || echo "")
  local remote_commit=$(git rev-parse "origin/$branch" 2>/dev/null || echo "")
  
  if [[ -z "$local_commit" ]] || [[ -z "$remote_commit" ]]; then
    return 1
  fi
  
  # Check if branches have diverged
  local merge_base=$(git merge-base "$branch" "origin/$branch" \
    2>/dev/null || echo "")
  
  if [[ "$merge_base" != "$local_commit" ]] && \
    [[ "$merge_base" != "$remote_commit" ]]; then
    return 0  # Diverged
  fi
  
  return 1  # Not diverged
}

count_unpushed_commits() {
  local branch="$1"
  
  # Count commits that are in local branch but not in origin
  git rev-list --count "origin/$branch..$branch" 2>/dev/null || echo "0"
}

count_commits_behind_parent() {
  local branch="$1"

  local parent_branch
  parent_branch=$(bt_resolve_parent_branch "$branch" "")

  if [[ -z "$parent_branch" ]]; then
    echo "0"
    return 0
  fi

  git rev-list --count "$branch..origin/$parent_branch" 2>/dev/null || echo "0"
}

fast_forward_branch_ref() {
  local branch="$1"

  if ! git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    return 1
  fi

  local local_commit
  local remote_commit
  local merge_base
  local_commit=$(git rev-parse "$branch" 2>/dev/null || echo "")
  remote_commit=$(git rev-parse "origin/$branch" 2>/dev/null || echo "")
  merge_base=$(git merge-base "$branch" "origin/$branch" 2>/dev/null || echo "")

  if [[ -z "$local_commit" || -z "$remote_commit" ]]; then
    return 1
  fi

  if [[ "$local_commit" == "$remote_commit" ]]; then
    return 2
  fi

  if [[ "$merge_base" != "$local_commit" ]]; then
    return 1
  fi

  git branch -f "$branch" "origin/$branch" >/dev/null 2>&1
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -a | --all)
      SYNC_ALL=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -m requires a message argument"
      fi
      if [[ -n "$COMMENT" ]]; then
        bt_error_exit 1 "Cannot use both -m and -- for comment"
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        bt_error_exit 1 "Cannot use both -m and -- for comment"
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      bt_error_exit 1 "Unknown option: $1"
      ;;
    *)
      bt_error_exit 1 "Unknown argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit 2 "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

if [[ -n "$COMMENT" ]]; then
  bt_info "Note: $COMMENT"
fi

# Fetch from remote
bt_info "Fetching from remote..."
if ! git fetch origin 2>&1; then
  bt_error_exit 2 "Failed to fetch from remote"
fi
bt_success "Fetched successfully"

# Sync current branch
if [[ "$SYNC_ALL" == false ]]; then
  bt_info "Pulling latest changes into $CURRENT_BRANCH..."
  
  # Check for divergence before pulling
  if check_diverged "$CURRENT_BRANCH"; then
    bt_error_exit 3 \
      "Branch '$CURRENT_BRANCH' has diverged from remote. Manual resolution "\
"needed. Use 'git rebase' or 'merge' to resolve."
  fi
  
  # Pull changes
  if ! git pull origin "$CURRENT_BRANCH" 2>&1; then
    bt_error_exit 2 "Failed to pull changes for $CURRENT_BRANCH"
  fi
  
  bt_success "Updated $CURRENT_BRANCH"
  
  # Show commit count if verbose
  if [[ "$VERBOSE" == true ]]; then
    new_commits=$(git rev-list --count "HEAD@{1}..HEAD" 2>/dev/null || echo "?")
    if [[ "$new_commits" != "?" ]]; then
      bt_info "$new_commits new commits pulled"
    fi
  fi
else
  # Sync all local branches safely.
  bt_info "Fast-forwarding local branches where safe..."

  local_branches=$(git for-each-ref --format='%(refname:short)' refs/heads)
  updated_count=0
  skipped_count=0

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    [[ "$branch" == "$CURRENT_BRANCH" ]] && continue

    if fast_forward_branch_ref "$branch"; then
      updated_count=$((updated_count + 1))
    else
      rc=$?
      if [[ "$rc" -eq 2 ]]; then
        continue
      fi
      skipped_count=$((skipped_count + 1))
      if [[ "$VERBOSE" == true ]]; then
        bt_warn "Skipped local branch '$branch' (ahead, diverged, or no remote)"
      fi
    fi
  done <<< "$local_branches"

  bt_success "Updated $updated_count additional local branch(es)"
  if [[ "$skipped_count" -gt 0 ]]; then
    bt_warn "Skipped $skipped_count branch(es) that could not be fast-forwarded safely"
  fi
fi

# Check for unpushed commits in current branch
unpushed=$(count_unpushed_commits "$CURRENT_BRANCH")
if [[ "$unpushed" -gt 0 ]]; then
  bt_warn "Local commits not pushed: $unpushed commit(s)"
  if [[ "$VERBOSE" == true ]]; then
    git log --oneline "origin/$CURRENT_BRANCH..$CURRENT_BRANCH" \
      2>/dev/null | sed 's/^/  /'
  fi
fi

# Check if behind parent branch
PARENT_BRANCH=$(bt_resolve_parent_branch "$CURRENT_BRANCH" "")
behind_parent=$(count_commits_behind_parent "$CURRENT_BRANCH")
if [[ "$behind_parent" -gt 0 ]] && [[ -n "$PARENT_BRANCH" ]]; then
  bt_warn "Your branch is $behind_parent commit(s) behind parent '$PARENT_BRANCH'"
  if bt_is_protected_branch "$CURRENT_BRANCH"; then
    bt_info "Protected branches require an approver-managed merge workflow"
  else
    bt_info "Run: syncfromparent"
  fi
fi

bt_success "Sync complete"
exit 0
