#!/usr/bin/env bash

# chcurrent - Switch to the specified branch.
#
# See usage below for details, or run: chcurrent -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  chcurrent BRANCH
  chcurrent --list-remote-only
  chcurrent {-h | --help}

Switch to a local BRANCH.

Arguments:
  BRANCH      Name of the branch to switch to.

Options:
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored).
  --list-remote-only
              List cached origin/* branches that do not have a matching
              local branch in this clone.

Rules:
  - Current branch is always local (never detached origin/*).
  - origin/BRANCH inputs are rejected.
  - Switching to main is blocked by policy.
  - If BRANCH is missing locally but exists on origin, chcurrent creates
    a local tracking branch automatically.
  - If current working tree has uncommitted changes, chcurrent creates a
    branch-tagged auto-stash before switching.
  - After switching, chcurrent attempts to re-apply a matching auto-stash
    for the new current branch when it can be applied cleanly.

Examples:
  chcurrent dev/my-feature-v1.0.0
  chcurrent v1.0.0
  chcurrent --list-remote-only

Outputs:
  - Writes help text and status messages to stdout.
  - Writes errors and diagnostics to stderr.

Exit codes:
  0   Success.
  1   Argument or validation error.
  3   Local branch does not exist.
  5   Branch switch operation failed.
  6   Auto-stash creation failed.
EOF
}

# High-Level Flow:
# - Parses branch selection for local branch checkout mode.
# - Rejects remote-only refs and policy-protected main branch switching.
# - Creates local tracking branches from origin when available.
# - Uses git switch for local checkout only.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

usage_error() {
  local message="$1"

  echo "Error: $message" >&2
  echo >&2
  usage >&2
  exit 1
}

if [[ $# -eq 0 ]]; then
  usage_error "Branch name is required"
fi

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
  esac
done

BRANCH_ARG=""
LIST_REMOTE_ONLY=false

for arg in "$@"; do
  case "$arg" in
    --list-remote-only)
      LIST_REMOTE_ONLY=true
      ;;
    --*)
      usage_error "Unknown option: $arg"
      ;;
    -*)
      usage_error "Unknown option: $arg"
      ;;
    *)
      if [[ -n "$BRANCH_ARG" ]]; then
        usage_error "Exactly one branch name is required"
      fi
      BRANCH_ARG="$arg"
      ;;
  esac
done

if [[ -z "$BRANCH_ARG" ]]; then
  if [[ "$LIST_REMOTE_ONLY" == true ]]; then
    :
  else
    usage_error "Branch name is required"
  fi
fi

if [[ "$LIST_REMOTE_ONLY" == true && -n "$BRANCH_ARG" ]]; then
  usage_error "--list-remote-only cannot be combined with a branch name"
fi

list_remote_only_branches() {
  local had_any=false
  local had_remote_only=false

  while IFS= read -r remote_ref; do
    local branch="${remote_ref#origin/}"
    [[ "$branch" == "HEAD" ]] && continue
    [[ -z "$branch" ]] && continue

    had_any=true
    if ! git show-ref --verify --quiet "refs/heads/$branch"; then
      if [[ "$had_remote_only" == false ]]; then
        bt_info "Remote-tracking branches without local branches:"
      fi
      had_remote_only=true
      echo "  origin/$branch"
    fi
  done < <(git for-each-ref --format='%(refname:short)' refs/remotes/origin)

  if [[ "$had_any" == false ]]; then
    bt_warn "No cached origin/* remote-tracking branches were found in this clone"
    bt_info "Run: git fetch origin"
    return 0
  fi

  if [[ "$had_remote_only" == false ]]; then
    bt_success "All cached origin/* branches already have local counterparts"
  fi
}

if [[ "$LIST_REMOTE_ONLY" == true ]]; then
  list_remote_only_branches
  exit 0
fi

is_worktree_dirty() {
  [[ -n "$(git status --porcelain 2>/dev/null || true)" ]]
}

make_auto_stash_label() {
  local branch="$1"
  local ts
  ts="$(date '+%Y%m%d-%H%M%S')"
  printf 'chcurrent-auto:%s:%s\n' "$branch" "$ts"
}

create_auto_stash() {
  local branch="$1"
  local label

  label="$(make_auto_stash_label "$branch")"
  if ! git stash push -u -m "$label" >/dev/null 2>&1; then
    return 1
  fi

  bt_info "Stashed uncommitted changes from '$branch'"
  return 0
}

find_branch_auto_stash_ref() {
  local branch="$1"
  local prefix

  prefix="chcurrent-auto:${branch}:"
  git stash list --format='%gd%x09%gs' | \
    awk -F '\t' -v p="$prefix" 'index($2, p) { print $1; exit }'
}

can_apply_stash_cleanly() {
  local stash_ref="$1"

  git stash show -p "$stash_ref" | git apply --3way --check >/dev/null 2>&1
}

apply_branch_auto_stash_if_present() {
  local branch="$1"
  local stash_ref

  stash_ref="$(find_branch_auto_stash_ref "$branch")"
  if [[ -z "$stash_ref" ]]; then
    return 0
  fi

  if is_worktree_dirty; then
    bt_warn "Auto-unstash skipped for '$branch' because working tree is not clean"
    bt_warn "Manual recovery: git stash list | grep 'chcurrent-auto:${branch}:'"
    return 0
  fi

  if ! can_apply_stash_cleanly "$stash_ref"; then
    bt_warn "Auto-unstash skipped for '$branch' due to potential conflicts"
    bt_warn "Manual recovery: git stash apply --index $stash_ref"
    return 0
  fi

  if ! git stash apply --index "$stash_ref" >/dev/null 2>&1; then
    bt_warn "Auto-unstash failed for '$branch'; stash kept as $stash_ref"
    bt_warn "Manual recovery: git stash apply --index $stash_ref"
    return 0
  fi

  git stash drop "$stash_ref" >/dev/null 2>&1 || true
  bt_info "Unstashed saved changes for '$branch'"
  return 0
}

TARGET_BRANCH="$BRANCH_ARG"
if [[ "$TARGET_BRANCH" == origin/* ]]; then
  bt_error_exit 1 "Remote branch input '$TARGET_BRANCH' is not allowed. Create a local tracking branch first."
fi

if [[ -z "$TARGET_BRANCH" ]]; then
  usage_error "Branch name is required"
fi

if [[ "$TARGET_BRANCH" == "main" ]]; then
  bt_error_exit 1 "Switching to 'main' is blocked by policy. Use contributor/targeted branches, or a local version branch."
fi

has_local=false

if git show-ref --verify --quiet "refs/heads/$TARGET_BRANCH"; then
  has_local=true
fi

has_cached_remote=false
if git show-ref --verify --quiet "refs/remotes/origin/$TARGET_BRANCH"; then
  has_cached_remote=true
fi

switch_local() {
  local branch="$1"

  bt_info "Switching to local branch '$branch'..."
  if ! git switch "$branch" >/dev/null 2>&1; then
    bt_error_exit 5 "Failed to switch to local branch '$branch'"
  fi
  bt_success "Current branch is now '$branch'"
  return 0
}

create_and_switch_tracking_branch() {
  local branch="$1"

  bt_info "Creating local tracking branch '$branch' from 'origin/$branch'..."
  if ! git switch -c "$branch" --track "origin/$branch" >/dev/null 2>&1; then
    bt_error_exit 5 "Failed to create local tracking branch '$branch' from 'origin/$branch'"
  fi
  bt_success "Current branch is now '$branch' (tracking origin/$branch)"
  return 0
}

refresh_remote_branch_ref() {
  local branch="$1"
  local ls_status=0

  git ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1 || ls_status=$?

  if [[ $ls_status -eq 0 ]]; then
    bt_info "Found origin/$branch. Fetching branch metadata..."
    if ! git fetch origin "$branch:refs/remotes/origin/$branch" >/dev/null 2>&1; then
      bt_error_exit 5 "Found origin/$branch but failed to fetch its reference"
    fi
    return 0
  fi

  if [[ $ls_status -eq 2 ]]; then
    return 1
  fi

  bt_error_exit 3 "Local branch '$branch' does not exist and remote could not be queried (offline or auth issue)."
}

if [[ "$has_local" == false ]]; then
  previous_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if is_worktree_dirty; then
    if [[ -z "$previous_branch" || "$previous_branch" == "HEAD" ]]; then
      bt_error_exit 6 "Unable to auto-stash changes from detached HEAD"
    fi
    if ! create_auto_stash "$previous_branch"; then
      bt_error_exit 6 "Failed to auto-stash uncommitted changes before switch"
    fi
  fi

  if [[ "$has_cached_remote" == true ]]; then
    create_and_switch_tracking_branch "$TARGET_BRANCH"
    apply_branch_auto_stash_if_present "$TARGET_BRANCH"
    exit 0
  fi

  if refresh_remote_branch_ref "$TARGET_BRANCH"; then
    create_and_switch_tracking_branch "$TARGET_BRANCH"
    apply_branch_auto_stash_if_present "$TARGET_BRANCH"
    exit 0
  fi

  bt_error_exit 3 "Local branch '$TARGET_BRANCH' does not exist and was not found on origin"
fi

previous_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if is_worktree_dirty; then
  if [[ -z "$previous_branch" || "$previous_branch" == "HEAD" ]]; then
    bt_error_exit 6 "Unable to auto-stash changes from detached HEAD"
  fi
  if ! create_auto_stash "$previous_branch"; then
    bt_error_exit 6 "Failed to auto-stash uncommitted changes before switch"
  fi
fi

switch_local "$TARGET_BRANCH"
apply_branch_auto_stash_if_present "$TARGET_BRANCH"
exit 0
