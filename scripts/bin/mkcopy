#!/usr/bin/env bash

# mkcopy - Cherry-pick commits from one branch to another.
#
# See usage below for details, or run: mkcopy -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

usage() {
  cat <<'EOF'
Usage:
  mkcopy SOURCE_BRANCH [OPTIONS]
  mkcopy --continue [OPTIONS]
  mkcopy -h | --help

Cherry-pick all commits from a source branch to the current branch.

Before cherry-picking:
  - Verifies current branch has no uncommitted changes
  - Fetches latest from remote
  - Cherry-picks all commits from source branch

If conflicts occur:
  - Script pauses and prompts to resolve conflicts manually
  - Run `mkcopy --continue` after resolving to complete the cherry-pick

Features:
  - Cherry-picks all commits from source branch
  - Auto-generates commit message or uses specified message
  - Handles conflicts with pause and resume
  - Validates clean working directory

Options:
  -h, --help           Output this help to stdout and exit.
  -m, --message MSG    Custom commit message for squashed result
                       Default: "Copy from source-branch to target-branch: message"
  -v, --verbose        Show detailed information
  --continue           Continue after resolving conflicts manually

Examples:
  # Cherry-pick from feature branch to current branch
  mkcopy feature-auth

  # Cherry-pick with custom message
  mkcopy feature-auth -m "Backport: Auth improvements"

  # Continue after resolving conflicts
  mkcopy --continue

  # Verbose output
  mkcopy feature-auth -v

Workflow:
  1. Cherry-pick commits: mkcopy source-branch
  2. If conflicts occur, resolve them manually
  3. Continue: mkcopy --continue
  4. Repeat steps 2-3 if more conflicts


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented output locations.

Exit codes:
  0   Success
  1   Argument or validation error
  2   Git operation failed
  3   Working directory not clean
  4   Source branch not found
  5   Cherry-pick conflicts (pause for resolution)
EOF
}

# High-Level Flow:
# - Cherry-picks selected commits from a source branch into a target branch.
# - Validates branch/commit inputs and guards against unsafe copy scenarios.
# - Reports applied commits and failures for conflict resolution.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Default options
CUSTOM_MESSAGE=""
VERBOSE=false
CONTINUE_MODE=false
SOURCE_BRANCH=""


check_working_directory_clean() {
  if ! git diff-index --quiet HEAD --; then
    bt_error_exit 3 "Working directory has uncommitted changes. Commit or stash them first."
  fi
}

branch_exists() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null || return 1
}

get_commits_from_branch() {
  local source_branch="$1"
  local current_branch="$2"
  
  # Get commits in source branch that are not in current branch
  git log "$current_branch..origin/$source_branch" --oneline 2>/dev/null | awk '{print $1}' || echo ""
}

cherry_pick_commits() {
  local commits="$1"
  
  if [[ -z "$commits" ]]; then
    bt_warn "No new commits to cherry-pick from source branch"
    return 0
  fi
  
  # Convert to array and reverse (cherry-pick oldest first)
  local commit_array=($commits)
  local reversed=()
  for ((i=${#commit_array[@]}-1; i>=0; i--)); do
    reversed+=("${commit_array[$i]}")
  done
  
  bt_info "Cherry-picking ${#reversed[@]} commit(s)..."
  
  for commit in "${reversed[@]}"; do
    bt_info "Cherry-picking $commit..."
    
    if ! git cherry-pick "$commit" 2>&1; then
      bt_warn "Conflict detected during cherry-pick of $commit"
      echo "WARN: Please resolve conflicts manually, then run:"
      echo "  mkcopy --continue"
      exit 5
    fi
  done
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --continue)
      CONTINUE_MODE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -m requires a message argument"
      fi
      CUSTOM_MESSAGE="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -*)
      bt_error_exit 1 "Unknown option: $1"
      ;;
    *)
      if [[ "$CONTINUE_MODE" == false ]]; then
        SOURCE_BRANCH="$1"
        shift
      else
        bt_error_exit 1 "Unexpected argument with --continue: $1"
      fi
      ;;
  esac
done

# Handle continue mode
if [[ "$CONTINUE_MODE" == true ]]; then
  bt_info "Continuing cherry-pick..."
  
  if git cherry-pick --continue 2>&1; then
    bt_success "Cherry-pick continued successfully"
    exit 0
  else
    bt_warn "Conflict still present after continue"
    echo -e "${YELLOW}Please resolve remaining conflicts, then run:${NC}"
    echo "  mkcopy --continue"
    exit 5
  fi
fi

# Validate source branch provided
if [[ -z "$SOURCE_BRANCH" ]]; then
  bt_error_exit 1 "SOURCE_BRANCH argument required"
fi

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || bt_error_exit 2 "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

# Check working directory is clean
bt_info "Checking working directory..."
check_working_directory_clean
bt_success "Working directory is clean"

# Fetch latest from remote
bt_info "Fetching latest from remote..."
git fetch origin 2>/dev/null || bt_warn "Failed to fetch from origin"

# Verify source branch exists
if ! branch_exists "$SOURCE_BRANCH"; then
  bt_error_exit 4 "Source branch not found: $SOURCE_BRANCH"
fi
bt_info "Source branch found: $SOURCE_BRANCH"

# Get commits to cherry-pick
bt_info "Getting commits from $SOURCE_BRANCH..."
COMMITS=$(get_commits_from_branch "$SOURCE_BRANCH" "$CURRENT_BRANCH")

if [[ -z "$COMMITS" ]]; then
  bt_success "No new commits to cherry-pick from $SOURCE_BRANCH"
  exit 0
fi

bt_info "Found commits to cherry-pick:"
echo "$COMMITS" | while read -r commit; do
  echo "  $commit"
done

# Cherry-pick commits
cherry_pick_commits "$COMMITS"

bt_success "Cherry-pick completed successfully"
if [[ "$VERBOSE" == true ]]; then
  bt_info "Details:"
  echo "  Source branch: $SOURCE_BRANCH"
  echo "  Target branch: $CURRENT_BRANCH"
  echo "  Commits picked: $(echo "$COMMITS" | wc -l)"
fi

bt_success "Done"
exit 0
