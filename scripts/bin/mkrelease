#!/usr/bin/env bash

# mkrelease - Create and publish a release with annotated git tag.
#
# See usage below for details, or run: mkrelease -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  mkrelease VERSION [OPTIONS]
  mkrelease -h | --help

Create and publish a release with annotated git tag and GitHub release.

Before releasing:
  - Verifies current branch is main or protected branch
  - Checks working directory is clean
  - Creates annotated git tag
  - Pushes tag to remote
  - Creates GitHub release

Arguments:
  VERSION            Release version in format v1.2.3 (required)

Options:
  -h, --help         Output this help to stdout and exit
  -v, --verbose      Show detailed information

Examples:
  # Create release v1.0.0
  mkrelease v1.0.0

  # Create release with verbose output
  mkrelease v2.1.3 -v

Outputs:
  - Writes status messages to stdout
  - Writes errors to stderr

Exit codes:
  0  Success
  1  Argument error
  2  Git operation failed
  3  Not on main branch
  7  Tag already exists
EOF
}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Ensure Git hooks are installed
ensure_hooks_installed

VERSION=""
VERBOSE=false

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    v[0-9]*)
      VERSION="$1"
      shift
      ;;
    *)
      bt_error_exit 1 "Unknown option or invalid version: $1"
      ;;
  esac
done

if [[ -z "$VERSION" ]]; then
  bt_error_exit 1 "VERSION is required (format: v1.2.3)"
fi

cd "$REPO_ROOT"

CURRENT_BRANCH=$(bt_get_current_branch || bt_error_exit 2 "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

if [[ "$CURRENT_BRANCH" != "main" ]]; then
  bt_error_exit 3 "Must be on main branch to create release"
fi

# Check working directory is clean
if ! git diff --quiet || ! git diff --cached --quiet; then
  bt_error_exit 2 "Working directory has uncommitted changes"
fi

# Check if tag already exists
if git show-ref --verify --quiet "refs/tags/$VERSION"; then
  bt_error_exit 7 "Tag '$VERSION' already exists"
fi

bt_info "Creating release $VERSION..."

# Create annotated tag
export BRITETEST_BYPASS_HOOKS=true
if ! git tag -a "$VERSION" -m "Release $VERSION" 2>&1; then
  unset BRITETEST_BYPASS_HOOKS
  bt_error_exit 2 "Failed to create tag"
fi

bt_info "Pushing tag to remote..."
if ! git push origin "$VERSION" 2>&1; then
  unset BRITETEST_BYPASS_HOOKS
  bt_error_exit 2 "Failed to push tag to remote"
fi
unset BRITETEST_BYPASS_HOOKS

bt_success "Release $VERSION created and published"
if [[ "$VERBOSE" == true ]]; then
  bt_info "Tag details:"
  git show "$VERSION" | head -10
fi

exit 0
