#!/usr/bin/env bash

# mkfork - Create a fork of the repository and configure it via API.
#
# See usage below for details, or run: mkfork -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  mkfork [OPTIONS]
  mkfork -h | --help

Create a fork of the repository and configure it via GitHub API.

A fork is a personal copy of the repository that you control. Use forks to:
  - Contribute to the project via pull requests
  - Experiment with changes safely
  - Create your own variations of the project
  - Maintain a personal backup

Forking process:
  - Verifies GitHub authentication is configured
  - Checks if a fork already exists
  - Creates fork on your GitHub account via API
  - Configures contributors.md via API (fork becomes immediately usable)

After forking:
  - Use mkclone to clone the fork locally
  - Use other scripts to manage branches, commits, and pull requests

Features:
  - Creates fork on your GitHub account via API
  - Automatically configures fork contributors via API
  - Validates fork configuration after creation
  - Supports dry-run mode for planning
  - No role restrictions: any user can fork the repository

Options:
  -h, --help           Output this help to stdout and exit (other options
                       and arguments are ignored).
  -v, --verbose        Show detailed information during fork operations.
  --dry-run            Show what would be done without creating fork.

Examples:
  # Create and configure fork
  mkfork

  # Verbose output
  mkfork -v

  # Dry-run to preview operations
  mkfork --dry-run

  # After forking, clone locally
  mkfork
  mkclone --fork


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented output locations.

Exit codes:
  0   Success
  1   Argument or validation error
  2   GitHub API error
  3   Fork already exists (not an error, fork is ready)
  4   Authentication failed
  5   Clone operation failed
  6   Configuration error
  7   Repository update failed
EOF
}

# High-Level Flow:
# - Validates GitHub authentication and repository context.
# - Creates fork via GitHub API if it doesn't already exist.
# - Configures fork's contributors.md via GitHub API (no local clone needed).
# - Reports fork status and next-step guidance.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/github_helpers.sh
source "$SCRIPT_DIR/../helpers/github_helpers.sh"

# Default options
VERBOSE=false
DRY_RUN=false

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    -*)
      bt_error_exit 1 "Unknown option: $1"
      ;;
    *)
      bt_error_exit 1 "Unexpected argument: $1"
      ;;
  esac
done

# Helper functions
get_github_username() {
  gh auth whoami 2>/dev/null || bt_error_exit 4 "GitHub authentication not configured. Run 'gh auth login' first."
}

get_repo_info() {
  local origin_url
  origin_url=$(git config --get remote.origin.url 2>/dev/null || true)
  
  if [[ -z "$origin_url" ]]; then
    bt_error_exit 6 "Cannot determine repository URL from git config"
  fi
  
  # Extract owner and repo from URL (supports both HTTPS and SSH)
  if [[ "$origin_url" =~ github\.com[:/]([^/]+)/([^/]+?)(\.git)?$ ]]; then
    REPO_OWNER="${BASH_REMATCH[1]}"
    REPO_NAME="${BASH_REMATCH[2]}"
  else
    bt_error_exit 6 "Cannot parse repository URL: $origin_url"
  fi
  
  if [[ "$VERBOSE" == "true" ]]; then
    echo "[verbose] Detected repo: $REPO_OWNER/$REPO_NAME" >&2
  fi
}

fork_exists() {
  local gh_user="$1"
  if gh repo view "$gh_user/$REPO_NAME" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

create_fork() {
  local source_repo="$1"
  
  if [[ "$DRY_RUN" == "true" ]]; then
    echo "[dry-run] Would create fork of $source_repo"
    return 0
  fi
  
  if [[ "$VERBOSE" == "true" ]]; then
    echo "[verbose] Creating fork of $source_repo..." >&2
  fi
  
  if ! gh repo fork "$source_repo" --clone=false 2>&1; then
    bt_error_exit 2 "Failed to create fork via GitHub API"
  fi
  
  echo "Fork created successfully"
}

wait_for_fork() {
  local gh_user="$1"
  local max_attempts=30
  local attempt=0
  
  if [[ "$DRY_RUN" == "true" ]]; then
    echo "[dry-run] Would wait for fork to be ready"
    return 0
  fi
  
  if [[ "$VERBOSE" == "true" ]]; then
    echo "[verbose] Waiting for fork to be ready on GitHub..." >&2
  fi
  
  while [[ $attempt -lt $max_attempts ]]; do
    if gh repo view "$gh_user/$REPO_NAME" >/dev/null 2>&1; then
      if [[ "$VERBOSE" == "true" ]]; then
        echo "[verbose] Fork is ready" >&2
      fi
      return 0
    fi
    ((attempt++))
    sleep 1
  done
  
  bt_error_exit 2 "Fork did not become available in time (waited $((max_attempts)) seconds)"
}

configure_fork_contributors_via_api() {
  local gh_user="$1"
  local file_path="config/contributors.md"
  
  if [[ "$DRY_RUN" == "true" ]]; then
    echo "[dry-run] Would configure $file_path in fork via API"
    return 0
  fi
  
  if [[ "$VERBOSE" == "true" ]]; then
    echo "[verbose] Retrieving current $file_path from fork..." >&2
  fi
  
  # Get current file to extract the SHA
  local file_response
  if ! file_response=$(gh api "repos/$gh_user/$REPO_NAME/contents/$file_path" 2>&1); then
    bt_error_exit 7 "Failed to retrieve $file_path from fork"
  fi
  
  local current_sha
  current_sha=$(echo "$file_response" | jq -r '.sha')
  
  if [[ "$VERBOSE" == "true" ]]; then
    echo "[verbose] Current file SHA: $current_sha" >&2
  fi
  
  # Generate new contributors.md content
  local new_content
  new_content=$(cat <<CONTRIBUTORS_EOF
# Contributors

Copyright (c) 2026 Paul Sinclair  
SPDX-License-Identifier: MIT  
For license details, see \`<repo>/LICENSE\`.

See \`<repo>/README.md\` for an introduction to briteTest.

## Overview

This file lists the allowed contributors to briteTest with their GitHub login,
role, and email address.

An approver may modify the list below to add or remove a contributor or change a
contributor's role. If there are no approvers, a reviewer may modify the list.
If there are neither approvers nor reviewers, a contributor may modify the list.
Otherwise, any user may modify the list.

See \`<repo>/docs/md/Contributor_Guide.md\` for additional information.

## Contributor Roles and Responsibilities

Contributors are categorized by their roles and permissions:

- **C** (Contributor-only): Can contribute code and documentation changes.

- **R** (Reviewer): Can contribute and review pull requests (PRs).
  Reviewers help maintain code and documentation quality through peer review.

- **A** (Approver): Can contribute, review pull requests (PRs), approve PRs for
  merging, and modify permissions. Approvers have final authority on code and
  documentation changes.

## Contributors

Each entry uses this form:

- \`<github-login>, <role>, <email>\`

- $gh_user, A, $gh_user@github.local
CONTRIBUTORS_EOF
)
  
  # Base64 encode the new content
  local encoded_content
  encoded_content=$(echo -n "$new_content" | base64 -w 0)
  
  if [[ "$VERBOSE" == "true" ]]; then
    echo "[verbose] Updating $file_path in fork via API..." >&2
  fi
  
  # Update the file via API
  if ! gh api --method PUT "repos/$gh_user/$REPO_NAME/contents/$file_path" \
    -f message="Configure contributors.md for fork: $gh_user as sole approver" \
    -f content="$encoded_content" \
    -f sha="$current_sha" 2>&1 > /dev/null; then
    bt_error_exit 7 "Failed to update $file_path in fork"
  fi
  
  echo "Contributors configured via API: $gh_user is the sole approver"
}

# Main flow
echo "Preparing to create fork of $REPO_OWNER/$REPO_NAME..."

# Get authenticated user
GH_USER=$(get_github_username)
echo "Authenticated as: $GH_USER"

# Check if fork already exists
if fork_exists "$GH_USER"; then
  echo "Fork already exists at $GH_USER/$REPO_NAME"
else
  # Create fork
  create_fork "$REPO_OWNER/$REPO_NAME"
  
  # Wait for fork to be ready on GitHub
  wait_for_fork "$GH_USER"
fi

# Always configure contributors via API
configure_fork_contributors_via_api "$GH_USER"

if [[ "$DRY_RUN" == "true" ]]; then
  echo ""
  echo "Dry-run completed. No changes were made."
else
  echo ""
  echo "Fork setup completed successfully!"
  echo "Fork URL: https://github.com/$GH_USER/$REPO_NAME"
  echo ""
  echo "Next steps:"
  echo "  mkclone --fork  # Clone the fork locally"
fi

exit 0
