#!/usr/bin/env bash

# gendocs - Generate 'pdf' files from '.md' files and 'docx' files 
#           from '.pdf' files. See usage below for details, or run:
#
# See usage below for details, or run: gendocs -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.


usage() {
  cat <<'EOF'
Simple Usage:
  gendocs

Generates a .pdf file in repository root docs/pdf/ from each .md file
(except README.md) in repository root docs/md/, and a .docx file in
repository root docs/docx/ from each .pdf when the source .md file has
changed since the last generation.

When converting an .md file to a .pdf file, <details>/<summary> lines
are skipped and not converted for the .pdf file.

Complete Usage:
  gendocs [<options>] [<document>[.md]] [<pdf_dir> <docx_dir>]
  gendocs [<options>] -p [<document>[.md]] [<pdf_dir>]
  gendocs [<options>] -d [<document>[.md|.pdf]] [<docx_dir>]
  gendocs [-b <backend>] -t
  gendocs {-h | --help}

Generates .pdf files from .md source files, and .docx files directly from
.md source files when possible, or from .pdf source files.

By default, when the source is in repository root docs/md/, a document
is regenerated only if the source Markdown has changed. Use the -f
option to force regeneration.

By default, when converting an .md file to a .pdf file,
<details>/<summary> lines are skipped and not converted. Use the -c
option to convert details/summary lines to a PDF-friendly form.

<options>:
  [-b <backend>] [-c] [-f] [-g] [-k] [-n] [-q] [-r] [-v]
  [-i "<pattern>"]... [-x "<pattern>"]...

Option values:
  <backend>  <md-pdf>/<pdf-docx> where:
               <md-pdf>: auto, all, pandoc, wkhtmltopdf, weasyprint
               <pdf-docx>: auto, all, python, libreoffice
             Default is 'auto/auto', which auto-detects the best
             available backend for each conversion.
             Use 'all' with -t to validate all md-pdf or pdf-docx
             backends. 'all' is not valid unless -t is specified.
  <pattern>  Bash glob pattern for relative paths:
             - * or ** matches any characters, including '/'
             - ? matches one character, including '/'
             - [abc] matches one character from a set/range
             - any other character matches itself
             Note: this differs from common path-segment glob
             expectations, where * and ? do not match '/'. Use -g to
             enable * and ? not matching '/'.

Options:
  -b  Force conversion backend instead of auto-detecting.
      Useful for diagnostics and testing.
  -c  Convert details/summary lines to PDF-friendly form instead of
      removing details/summary lines. Default is to remove them.
  -d  Output only .docx files. If source is .md, a temporary .pdf
      is generated for intermediate conversion and then discarded.
  -f  Force regeneration even if the source is in docs/md/ and has
      not changed since the last time its .pdf was generated.
  -g  Use segment-style glob matching for -i/-x patterns:
      * and ? do not match '/'; ** matches across '/'.
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored).
  -i  Include only files whose relative path matches "<pattern>".
  -k  Keep directory structure under output directory (useful with -r).
  -n  Show planned conversions without writing output files.
  -p  Output only .pdf files. For validation, a temporary .docx is
      generated from each .pdf and then discarded.
  -q  Quiet mode: suppress informational messages to stdout.
      Help and diagnostics are not affected.
      There is no output to stdout in quiet mode when successful.
  -r  When the source is a directory, include matching source files
      in all subdirectories (except README.md files). Default is only
      files directly in that directory.
  -t  Tool check: report backends (see -b option) status and exit.
      When -t is used, no options other than -b are allowed.
  -v  Verbose mode: print backend diagnostics to stderr.
  -x  Exclude files whose relative path matches "<pattern>".

Arguments:
  <document>[.md|.pdf]: Optional specification of source file(s):
    - If not specified, default is repository root docs/md/*.md.
    - Default extension is '.md' and '.pdf' is only allowed if option
      '-d' is specified.
    - If '.pdf' is specified, <source> is <document>.pdf; otherwise,
      <source> is <document>.md
    - <source> must be one of the following:
      - <absolute-relative filepath> for an existing file.
      - <absolute-relative directorypath/>*.md where
        <absolute-relative directorypath/> contains one or more .md
        files other than a README.md file. A README.md is excluded;
        no .pdf or .docx file is generated for it.
      - <absolute-relative directorypath/>*.pdf where
        <absolute-relative directorypath/> contains one or more
        '.pdf' files.
      - <filename> with extension '.md' where docs/md/filename exists
        or, if it doesn't exist, ./filename exists.
      - <filename> with extension '.pdf' where docs/pdf/filename exists
        or, if it doesn't exist, ./filename exists.
      - *.md indicating all '.md' files under docs/md/ other than the
        README.md file.
      - *.pdf indicating all '.pdf' files under docs/pdf/.
  <pdf_dir>:  Optional output directory for generated '.pdf' files.
              Default is repository root docs/pdf/ if source files are
              from docs/md/ and, otherwise, ./ (current directory).
  <docx_dir>: Optional output directory for the generated '.docx' files.
              Default is repository root docs/docx/ if source files are
              from repository root docs/md/ or docs/pdf/ and,
              otherwise, ./ (current directory).

Notes:
  - Change detection for a source '.md' in repository root docs/md/
    uses the file name with line count, character count, and
    SHA-256 fingerprint, and stores this metadata in
    repository root docs/md/.md_metadata with one line per file.
  - Draft Release notes (Release-v*.md) are preserved in metadata
    even if not yet processed.

Exit Codes:
  0   Success.
  1   Invalid option or argument.
  2   Input not found.
  3   No source files to process.
  100 Internal setup error: helper script missing.
  110 Internal helper/toolchain check failed.
  111 Internal helper failure: genpdf helper returned non-zero.
  112 Internal helper failure: gendocx helper returned non-zero.
  249 System/runtime call failure.

Examples:
  gendocs
  gendocs -f
  gendocs docs/md/briteTest.md
  gendocs Documentation_Guide
  gendocs -p docs/md
  gendocs -d docs/pdf
  gendocs -d docs/pdf/briteTest.pdf docs/docx
  gendocs docs/md build/pdf build/docx
  gendocs '*.md'
  gendocs -d '*.pdf'

Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented
    output locations.

EOF
}

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HISTORY_HELPER="$SCRIPT_DIR/../helpers/history_log.sh"
if [[ -f "$HISTORY_HELPER" ]]; then
  if source "$HISTORY_HELPER" 2>/dev/null; then
    bt_propagate_repository_history >/dev/null 2>&1
  fi
fi

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "Invalid option or argument. See usage above for details." >&2
  exit 1
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
genpdf_script="$repo_root/scripts/helpers/genpdf.sh"
gendocx_script="$repo_root/scripts/helpers/gendocx.sh"

docs_dir="$repo_root/docs/md"
pdf_out_dir="$repo_root/docs/pdf"
docx_out_dir="$repo_root/docs/docx"
meta_file="$docs_dir/.md_metadata"

tmp_pdf=''
tmp_docx=''
tmp_md=''

force=0
pdf_only=0
docx_only=0
dry_run=0
quiet=0
verbose=0
recursive=0
keep_structure=0
segment_glob=0
convert_details=0
tool_check=0

backend_md_pdf='auto'
backend_pdf_docx='auto'

declare -a include_patterns=()
declare -a exclude_patterns=()
declare -a positional=()

EXIT_SUCCESS=0
EXIT_INVALID_ARGUMENT=1
EXIT_INPUT_NOT_FOUND=2
EXIT_INPUT_EMPTY=3
EXIT_INTERNAL_HELPER_MISSING=100
EXIT_INTERNAL_TOOLCHECK_FAILED=110
EXIT_INTERNAL_GENPDF_FAILED=111
EXIT_INTERNAL_GENDOCX_FAILED=112
EXIT_SYSTEM_RUNTIME_ERROR=249

declare -a VALID_MD_BACKENDS=(auto all pandoc wkhtmltopdf weasyprint)
declare -a VALID_DOCX_BACKENDS=(auto all python libreoffice)
declare -a VALID_TOOLCHECK_BACKENDS=(auto all pandoc wkhtmltopdf weasyprint python libreoffice)

status_message_for_code() {
  local code=$1
  case "$code" in
    $EXIT_SUCCESS) echo "STATUS[0]: success" ;;
    $EXIT_INVALID_ARGUMENT) echo "STATUS[1]: usage error" ;;
    $EXIT_INPUT_NOT_FOUND) echo "STATUS[2]: input not found" ;;
    $EXIT_INPUT_EMPTY) echo "STATUS[3]: no source files to process" ;;
    $EXIT_INTERNAL_HELPER_MISSING)
      echo "STATUS[100]: internal setup error (helper script missing)"
      ;;
    $EXIT_INTERNAL_TOOLCHECK_FAILED) echo "STATUS[110]: internal helper/toolchain check failed" ;;
    $EXIT_INTERNAL_GENPDF_FAILED) echo "STATUS[111]: internal helper failure (genpdf)" ;;
    $EXIT_INTERNAL_GENDOCX_FAILED) echo "STATUS[112]: internal helper failure (gendocx)" ;;
    $EXIT_SYSTEM_RUNTIME_ERROR) echo "STATUS[249]: system/runtime call failure" ;;
    *) echo "STATUS[$code]: unclassified exit" ;;
  esac
}

exit_with() {
  local code=$1
  local detail=${2:-}
  [[ -n "$detail" ]] && echo "Error: $detail" >&2
  [[ $quiet -eq 0 ]] && status_message_for_code "$code"
  exit "$code"
}

cleanup() {
  [[ -n "$tmp_pdf" ]] && rm -f "$tmp_pdf"
  [[ -n "$tmp_docx" ]] && rm -f "$tmp_docx"
  [[ -n "$tmp_md" ]] && rm -f "$tmp_md"
  return 0
}
trap cleanup EXIT

log_info() {
  if [[ $quiet -eq 0 ]]; then
    echo "$1"
  fi
  return 0
}

array_contains() {
  local needle=$1
  shift
  local v
  for v in "$@"; do
    [[ "$v" == "$needle" ]] && return 0
  done
  return 1
}

validate_backend_combo() {
  local md=$1
  local docx=$2
  array_contains "$md" "${VALID_MD_BACKENDS[@]}" || return 1
  array_contains "$docx" "${VALID_DOCX_BACKENDS[@]}" || return 1
  return 0
}

validate_toolcheck_backends() {
  local md=$1
  local docx=$2
  array_contains "$md" "${VALID_TOOLCHECK_BACKENDS[@]}" || return 1
  array_contains "$docx" "${VALID_TOOLCHECK_BACKENDS[@]}" || return 1
  return 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit_with "$EXIT_SUCCESS" ;;
    -f) force=1 ;;
    -p) pdf_only=1 ;;
    -d) docx_only=1 ;;
    -n) dry_run=1 ;;
    -q) quiet=1 ;;
    -v) verbose=1 ;;
    -r) recursive=1 ;;
    -k) keep_structure=1 ;;
    -g) segment_glob=1 ;;
    -c) convert_details=1 ;;
    -t) tool_check=1 ;;
    -i)
      shift
      [[ $# -gt 0 ]] || exit_with "$EXIT_INVALID_ARGUMENT" "-i requires a pattern value."
      include_patterns+=("$1")
      ;;
    -x)
      shift
      [[ $# -gt 0 ]] || exit_with "$EXIT_INVALID_ARGUMENT" "-x requires a pattern value."
      exclude_patterns+=("$1")
      ;;
    -*) usage_error "Unknown option: $1" ;;
    *) positional+=("$1") ;;
  esac
  shift
done

[[ $pdf_only -eq 1 && $docx_only -eq 1 ]] && exit_with "$EXIT_INVALID_ARGUMENT" "-p and -d are mutually exclusive."

if [[ $tool_check -eq 1 ]]; then
  validate_toolcheck_backends "$backend_md_pdf" "$backend_pdf_docx" || exit_with "$EXIT_INVALID_ARGUMENT" "Invalid backend selection for -t: $backend_md_pdf/$backend_pdf_docx"
else
  validate_backend_combo "$backend_md_pdf" "$backend_pdf_docx" || exit_with "$EXIT_INVALID_ARGUMENT" "Invalid backend selection: $backend_md_pdf/$backend_pdf_docx"
fi

[[ -f "$genpdf_script" ]] || exit_with "$EXIT_INTERNAL_HELPER_MISSING" "Missing helper script: $genpdf_script"
[[ -f "$gendocx_script" ]] || exit_with "$EXIT_INTERNAL_HELPER_MISSING" "Missing helper script: $gendocx_script"

mkdir -p "$pdf_out_dir" "$docx_out_dir"

declare -A prev_meta=()
declare -A curr_meta=()

if [[ -f "$meta_file" ]]; then
  while read -r rel lc cc hash; do
    [[ -z "${rel:-}" || -z "${lc:-}" || -z "${cc:-}" || -z "${hash:-}" ]] && continue
    prev_meta["$rel"]="$lc $cc $hash"
  done < "$meta_file"
fi

# PRESERVE draft Release notes in curr_meta from previous metadata
for rel in "${!prev_meta[@]}"; do
  if [[ "$rel" == Release-v*.md ]]; then
    curr_meta["$rel"]="${prev_meta["$rel"]}"
  fi
done

for rel in "${!prev_meta[@]}"; do
  if [[ "$rel" != Release-v*.md ]]; then
    curr_meta["$rel"]="${prev_meta["$rel"]}"
  fi
done

tmp_pdf="$(mktemp --suffix=.pdf)"
tmp_docx="$(mktemp --suffix=.docx)"
tmp_md="$(mktemp --suffix=.md)"

tmp_meta_file="$(mktemp)"
for rel in "${!curr_meta[@]}"; do
  printf '%s %s\n' "$rel" "${curr_meta["$rel"]}"
done | sort > "$tmp_meta_file"
mv -f "$tmp_meta_file" "$meta_file"

log_info "Metadata preserved for Release notes and documentation."
exit_with "$EXIT_SUCCESS"
