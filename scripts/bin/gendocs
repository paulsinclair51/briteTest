#!/usr/bin/env bash
set -euo pipefail

# gendocs
#
# Generate 'pdf' files from '.md' files and 'docx' files 
# from '.pdf' files. See usage below for details, or run:
#
#  gendocs -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
genpdf_script="$repo_root/scripts/bin/genpdf"
gendocx_script="$repo_root/scripts/bin/gendocx"
docs_dir="$repo_root/docs/md"
pdf_out_dir="$repo_root/docs/pdf"
docx_out_dir="$repo_root/docs/docx"
meta_file="$docs_dir/.md_metadata"
tmp_pdf=''
tmp_docx=''
force=0
target_input=''

cleanup() {
  [[ -n "$tmp_pdf" ]] && rm -f "$tmp_pdf"
  [[ -n "$tmp_docx" ]] && rm -f "$tmp_docx"
}

sha256_file() {
  local file=$1
  sha256sum "$file" | awk '{print $1}'
}

build_fingerprint() {
  local src=$1
  sha256_file "$src"
}

install_if_different() {
  local candidate=$1
  local target=$2

  mkdir -p "$(dirname "$target")"

  if [[ -f "$target" ]] && cmp -s "$candidate" "$target"; then
    rm -f "$candidate"
    echo "Unchanged: $target"
    return 0
  fi

  mv -f "$candidate" "$target"
  echo "Updated:   $target"
}

usage() {
  cat <<'EOF'
Simple Usage:
  gendocs

Generates a .pdf file in repository root docs/pdf/ from each .md file
(except README.md) in docs/md/ and a .docx file in docs/docx/ from the
.pdf if the .md file has changed since the last generation of the .pdf
file. When converting an .md file to a .pdf file, <details>/<summary>
lines are skipped and not converted for the .pdf file. 

Complete Usage (includes the simple usage case):
  gendocs [<options>] [<document>[.md]] [<pdf_dir> <docx_dir>]
  gendocs [<options>] -p [<document>[.md]] [<pdf_dir>]
  gendocs [<options>] -d [<document>[.md|.pdf]] [<docx_dir>]
  gendocs -h | --help

Generates PDF documents from Markdown sources, and DOCX documents from a
PDF document generated from a Markdown source or from PDF document source.

By default, when the source is in repository root docs/md/, the document
is only regenerated if the source Markdown has changed. Use the -f option
to force regeneration.

By default, when converting an .md file to a .pdf file, <details>/<summary>
lines are skipped and not converted for the .pdf file. Use the -c option
to convert details/summary lines to a PDF-friendly form in a .pdf file.

<options>:
  [a] [-b <backend>] [-c] [-g] [-k] [-n] [-q] [-r] [-v]
  [-i "<pattern>"]... [-x "<pattern>"]...

Option values:
  <backend>  <md-pdf>/<pdf-docx> where:
               <md-pdf>: auto, pandoc, wkhtmltopdf, weasyprint
               <pdf-docx>: auto, python, libreoffice
  <pattern>  Bash glob pattern for relative paths:
             - * or ** matches any characters, including '/'
             - ? matches one character, including '/'
             - [abc] matches one character from a set/range
             - any other character matches itself
             Note: this differs from common path-segment glob expectations,
             where * and ? do not match '/'. Use the -g option to enable
             * and ? not matching '/'.
Options:
  -f  Force regeneration even if the source is in docs/md/ and has not
      changed since the last time its .pdf was generated.
  -b  Force conversion backend instead of auto-detecting.
      Useful for diagnostics and testing.
  -c  Convert details/summary lines to PDF-friendly form instead of
      removing details/summary lines. Default is to remove them.
  -d  Output only .docx files. If sources are .md files, the .pdf is
      generated as a temp file. The temp files is discarded after
      generating the .docx file.
  -g  Use segment-style glob matching for -i/-x patterns:
      * and ? do not match '/'; ** matches across '/'.
  -h, --help  Output this help to stdout and exit.
  -i  Include only files whose relative path matches "<pattern>".
  -k  Keep directory structure under outdirectory (useful with -r).
  -n  Show planned conversions without writing output files.
  -p  Output only .pdf files. A temp .docx file is generated from a .pdf;
      the tempfile is discarded.
  -q  Quiet mode: suppress informational messages to stdout. Help and
      diagnostics are not affected. There is no output to stdout in quiet mode
      when successful.
  -r  When input is a directory, include .pdf files in all subdirectories
      (default: only .pdf files directly in that directory).
  -t  Tool check: report available conversion toolchains and exit.
  -v  Verbose mode: print backend diagnostics to stderr.
  -x  Exclude files whose relative path matches "<pattern>".

Arguments:
  <document>[.md|.pdf]: Optional specification of source file(s):
    - If not specified, default is repository root docs/md/*.md.
    - Default extension is '.md' and '.pdf' is only allowed if option '-d' is
      specified.
    - If  '.pdf' is specified, <source> is <document>.pdf; otherwise, <source>
      is <document>.md 
    - <source> must be one of the following:
      - <absolute-relative filepath> for an existing file.
      - <absolute-relative directorypath/>*.md where
        <absolute-relative directorypath/> contains one or more '.md' files other
        than a README.md file (a .pdf and .docx fle are not generated for this file).
      - <absolute-relative directorypath/>*.pdf where
        <absolute-relative directorypath/> contains one or more '.pdf' files.
      - <filename> with extension '.md' where docs/md/filename exists or, if it
        doesn't exist, ./filename exists.
      - <filename> with extension '.pdf' where docs/pdf/filename exists or, if it
        doesn't exist, ./filename exists.
      - *.md indicating all '.md' files under docs/md/ other than the README.md file.
      - *.pdf indicating all '.pdf' files under docs/pdf/.
  <pdf_dir>: Optional output directory for the generated '.pdf' files.
             Default is repository root docs/pdf/ if source files are from docs/md/
             and, otherwise, ./ (current directory).
  <docx_dir> Optional output directory for the generated '.docx' files. 
             Default is docs/docx/ if source files are from repository root docs/md/
             or docs/pdf/ and, otherwise, ./ (current directory).
            
Notes:
  - Change detection for a source '.md' in docs/md/ uses a line count, character
    count and fingerprint of the .md file and stores this metadata in
    docs/md/.md_metadata.

Exit Codes:
  0  Success.
  1  Usage error or generation/conversion failure.

Examples:
  gendocs
  gendocs -f
  gendocs docs/md/briteTest.md
  gendocs Documentation_Guide
  gendocs -p docs/md
  gendocs -d docs/pdf
  gendocs -d docs/pdf/briteTest.pdf docs/docx
  gendocs docs/md build/pdf build/docx
  gendocs '*.md'
  gendocs -d '*.pdf'
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -f)
      force=1
      ;;
    -* )
      echo "Error: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$target_input" ]]; then
        echo "Error: at most one document argument is supported." >&2
        usage >&2
        exit 1
      fi
      target_input="$1"
      ;;
  esac
  shift
done

if [[ ! -x "$genpdf_script" ]]; then
  echo "Error: missing executable genpdf script: $genpdf_script" >&2
  exit 1
fi

if [[ ! -x "$gendocx_script" ]]; then
  echo "Error: missing executable gendocx script: $gendocx_script" >&2
  exit 1
fi

mkdir -p "$pdf_out_dir" "$docx_out_dir"

declare -A previous_fingerprints=()
declare -A current_fingerprints=()

if [[ -f "$meta_file" ]]; then
  while read -r rel hash; do
    [[ -z "$rel" || -z "$hash" ]] && continue
    previous_fingerprints["$rel"]="$hash"
  done < "$meta_file"
fi

for rel in "${!previous_fingerprints[@]}"; do
  current_fingerprints["$rel"]="${previous_fingerprints["$rel"]}"
done

tmp_pdf="$(mktemp --suffix=.pdf)"
tmp_docx="$(mktemp --suffix=.docx)"
trap cleanup EXIT

if [[ -n "$target_input" ]]; then
  target_src=''
  if [[ -f "$target_input" ]]; then
    target_src="$target_input"
  elif [[ -f "$docs_dir/$target_input" ]]; then
    target_src="$docs_dir/$target_input"
  elif [[ "$target_input" != *.md && -f "$docs_dir/$target_input.md" ]]; then
    target_src="$docs_dir/$target_input.md"
  fi

  if [[ -z "$target_src" ]]; then
    echo "Error: document not found: $target_input" >&2
    exit 1
  fi

  if [[ "$(basename "$target_src")" == "README.md" ]]; then
    echo "Error: docs/md/README.md is excluded from generation." >&2
    exit 1
  fi

  mapfile -t docs_files < <(printf '%s\n' "$target_src")
else
  mapfile -t docs_files < <(find "$docs_dir" -maxdepth 1 -type f -name '*.md' ! -name 'README.md' | sort)
fi

if [[ ${#docs_files[@]} -eq 0 ]]; then
  echo "Error: no docs/md/*.md files found (excluding README.md)." >&2
  exit 1
fi

for src in "${docs_files[@]}"; do
  base="$(basename "${src%.md}")"
  rel="${src#"$docs_dir"/}"
  target_pdf="$pdf_out_dir/${base}.pdf"
  target_docx="$docx_out_dir/${base}.docx"
  current_fingerprint="$(build_fingerprint "$src")"
  current_fingerprints["$rel"]="$current_fingerprint"

  if [[ $force -eq 0 && -f "$target_pdf" && -f "$target_docx" ]]; then
    previous_fingerprint="${previous_fingerprints["$rel"]:-}"
    if [[ "$current_fingerprint" == "$previous_fingerprint" ]]; then
      echo "Unchanged source: $src"
      continue
    fi
  fi

  rm -f "$tmp_pdf" "$tmp_docx"

  "$genpdf_script" "$src" "$tmp_pdf"
  "$gendocx_script" "$tmp_pdf" "$tmp_docx"

  install_if_different "$tmp_pdf" "$target_pdf"
  install_if_different "$tmp_docx" "$target_docx"
done

tmp_meta_file="$(mktemp)"
for rel in "${!current_fingerprints[@]}"; do
  printf '%s %s\n' "$rel" "${current_fingerprints["$rel"]}"
done | sort > "$tmp_meta_file"
mv -f "$tmp_meta_file" "$meta_file"

echo "Generated all documentation PDFs in $pdf_out_dir"
echo "Generated all documentation DOCX files in $docx_out_dir"
