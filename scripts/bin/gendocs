#!/usr/bin/env bash
set -Eeuo pipefail

# gendocs
#
# Generate 'pdf' files from '.md' files and 'docx' files 
# from '.pdf' files. See usage below for details, or run:
#
#  gendocs -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
genpdf_script="$repo_root/scripts/helpers/genpdf.sh"
gendocx_script="$repo_root/scripts/helpers/gendocx.sh"

docs_dir="$repo_root/docs/md"
pdf_out_dir="$repo_root/docs/pdf"
docx_out_dir="$repo_root/docs/docx"
meta_file="$docs_dir/.md_metadata"

tmp_pdf=''
tmp_docx=''

force=0
pdf_only=0
docx_only=0
dry_run=0
quiet=0
verbose=0
recursive=0
keep_structure=0
segment_glob=0
convert_details=0
tool_check=0

backend_md_pdf='auto'
backend_pdf_docx='auto'

declare -a include_patterns=()
declare -a exclude_patterns=()
declare -a positional=()

# Exit codes
# 1-99: user usage/input issues
# 100-199: internal script/setup issues
# 200-249: system call/tool execution failures
EXIT_SUCCESS=0
EXIT_USAGE_GENERAL=1
EXIT_USAGE_OPTION=2
EXIT_USAGE_ARGUMENT=3
EXIT_USAGE_MODE=4
EXIT_INPUT_NOT_FOUND=5
EXIT_INPUT_EMPTY=6
EXIT_INTERNAL_HELPER_MISSING=100
EXIT_INTERNAL_TOOLCHECK_FAILED=110
EXIT_INTERNAL_GENPDF_FAILED=111
EXIT_INTERNAL_GENDOCX_FAILED=112
EXIT_SYSTEM_RUNTIME_ERROR=249

declare -a VALID_MD_BACKENDS=(auto all pandoc wkhtmltopdf weasyprint)
declare -a VALID_DOCX_BACKENDS=(auto all python libreoffice)
declare -a VALID_TOOLCHECK_BACKENDS=(auto all pandoc wkhtmltopdf weasyprint python libreoffice)

status_message_for_code() {
  local code=$1
  case "$code" in
    $EXIT_SUCCESS) echo "STATUS[0]: success" ;;
    $EXIT_USAGE_GENERAL) echo "STATUS[1]: usage error (general)" ;;
    $EXIT_USAGE_OPTION) echo "STATUS[2]: usage error (invalid or incomplete option)" ;;
    $EXIT_USAGE_ARGUMENT) echo "STATUS[3]: usage error (invalid argument)" ;;
    $EXIT_USAGE_MODE) echo "STATUS[4]: usage error (invalid option combination or mode)" ;;
    $EXIT_INPUT_NOT_FOUND) echo "STATUS[5]: input not found" ;;
    $EXIT_INPUT_EMPTY) echo "STATUS[6]: no source files to process" ;;
    $EXIT_INTERNAL_HELPER_MISSING)
      echo "STATUS[100]: internal setup error (helper script missing)"
      ;;
    $EXIT_INTERNAL_TOOLCHECK_FAILED) echo "STATUS[110]: internal helper/toolchain check failed" ;;
    $EXIT_INTERNAL_GENPDF_FAILED) echo "STATUS[111]: internal helper failure (genpdf)" ;;
    $EXIT_INTERNAL_GENDOCX_FAILED) echo "STATUS[112]: internal helper failure (gendocx)" ;;
    $EXIT_SYSTEM_RUNTIME_ERROR) echo "STATUS[249]: system/runtime call failure" ;;
    *) echo "STATUS[$code]: unclassified exit" ;;
  esac
}

exit_with() {
  local code=$1
  local detail=${2:-}
  [[ -n "$detail" ]] && echo "Error: $detail" >&2
  [[ $quiet -eq 0 ]] && status_message_for_code "$code"
  exit "$code"
}

on_unexpected_error() {
  local rc=$1
  local line=$2
  exit_with "$EXIT_SYSTEM_RUNTIME_ERROR" "Unexpected failure at line $line (rc=$rc)."
}

trap 'on_unexpected_error $? $LINENO' ERR

cleanup() {
  [[ -n "$tmp_pdf" ]] && rm -f "$tmp_pdf"
  [[ -n "$tmp_docx" ]] && rm -f "$tmp_docx"
  return 0
}
trap cleanup EXIT

log_info() {
  if [[ $quiet -eq 0 ]]; then
    echo "$1"
  fi
  return 0
}

array_contains() {
  local needle=$1
  shift
  local v
  for v in "$@"; do
    [[ "$v" == "$needle" ]] && return 0
  done
  return 1
}

validate_backend_combo() {
  local md=$1
  local docx=$2

  array_contains "$md" "${VALID_MD_BACKENDS[@]}" || return 1
  array_contains "$docx" "${VALID_DOCX_BACKENDS[@]}" || return 1
  return 0
}

validate_toolcheck_backends() {
  local md=$1
  local docx=$2

  array_contains "$md" "${VALID_TOOLCHECK_BACKENDS[@]}" || return 1
  array_contains "$docx" "${VALID_TOOLCHECK_BACKENDS[@]}" || return 1
  return 0
}

has_disallowed_toolcheck_args() {
  [[ $force -eq 1 ||
     $pdf_only -eq 1 ||
     $docx_only -eq 1 ||
     $dry_run -eq 1 ||
     $quiet -eq 1 ||
     $verbose -eq 1 ||
     $recursive -eq 1 ||
     $keep_structure -eq 1 ||
     $segment_glob -eq 1 ||
     $convert_details -eq 1 ||
     ${#include_patterns[@]} -gt 0 ||
     ${#exclude_patterns[@]} -gt 0 ||
     ${#positional[@]} -gt 0 ]]
}

run_toolcheck() {
  local pdf_check_rc=0
  local docx_check_rc=0
  local md_backends=("$backend_md_pdf")
  local docx_backends=("$backend_pdf_docx")
  local b

  [[ "$backend_md_pdf" == "all" ]] && md_backends=(pandoc wkhtmltopdf weasyprint)
  [[ "$backend_pdf_docx" == "all" ]] && docx_backends=(python libreoffice)

  if [[ "$backend_md_pdf" == "all" ]]; then
    for b in "${md_backends[@]}"; do
      if bash "$genpdf_script" -b "$b" -t >/dev/null 2>&1; then
        echo "md-pdf($b): available"
      else
        echo "md-pdf($b): missing"
        pdf_check_rc=1
      fi
    done
  elif [[ "$backend_md_pdf" == "auto" ]]; then
    bash "$genpdf_script" -t || pdf_check_rc=$?
  else
    bash "$genpdf_script" -b "$backend_md_pdf" -t || pdf_check_rc=$?
  fi

  if [[ "$backend_pdf_docx" == "all" ]]; then
    for b in "${docx_backends[@]}"; do
      if bash "$gendocx_script" -b "$b" -t >/dev/null 2>&1; then
        echo "pdf-docx($b): available"
      else
        echo "pdf-docx($b): missing"
        docx_check_rc=1
      fi
    done
  elif [[ "$backend_pdf_docx" == "auto" ]]; then
    bash "$gendocx_script" -t || docx_check_rc=$?
  else
    bash "$gendocx_script" -b "$backend_pdf_docx" -t || docx_check_rc=$?
  fi

  if [[ $pdf_check_rc -ne 0 || $docx_check_rc -ne 0 ]]; then
    exit_with "$EXIT_INTERNAL_TOOLCHECK_FAILED" \
      "Helper toolchain check failed for PDF and/or DOCX generation."
  fi

  exit_with "$EXIT_SUCCESS"
}

segment_glob_match() {
  local path=$1
  local pattern=$2

  local old_ifs=$IFS
  IFS='/' read -r -a path_parts <<< "$path"
  IFS='/' read -r -a pat_parts <<< "$pattern"
  IFS=$old_ifs

  local path_len=${#path_parts[@]}
  local pat_len=${#pat_parts[@]}

  _match_parts() {
    local pi=$1
    local ti=$2

    if (( ti == pat_len )); then
      (( pi == path_len )) && return 0
      return 1
    fi

    local token=${pat_parts[$ti]}
    if [[ "$token" == "**" ]]; then
      local k
      for ((k=pi; k<=path_len; k++)); do
        _match_parts "$k" "$((ti+1))" && return 0
      done
      return 1
    fi

    (( pi < path_len )) || return 1
    [[ "${path_parts[$pi]}" == $token ]] || return 1
    _match_parts "$((pi+1))" "$((ti+1))"
  }

  _match_parts 0 0
}

path_matches_pattern() {
  local rel_path=$1
  local pattern=$2

  if [[ $segment_glob -eq 1 ]]; then
    segment_glob_match "$rel_path" "$pattern"
  else
    [[ "$rel_path" == $pattern ]]
  fi
}

is_included_path() {
  local rel_path=$1
  local p

  if [[ ${#include_patterns[@]} -gt 0 ]]; then
    local any_include=0
    for p in "${include_patterns[@]}"; do
      if path_matches_pattern "$rel_path" "$p"; then
        any_include=1
        break
      fi
    done
    [[ $any_include -eq 1 ]] || return 1
  fi

  for p in "${exclude_patterns[@]}"; do
    if path_matches_pattern "$rel_path" "$p"; then
      return 1
    fi
  done

  return 0
}

collect_sources_from_dir() {
  local dir=$1
  local old_ifs=$IFS
  local maxdepth_arg=()
  local -a names=("*.md")

  [[ $docx_only -eq 1 ]] && names+=("*.pdf")

  if [[ $recursive -eq 0 ]]; then
    maxdepth_arg=(-maxdepth 1)
  fi

  local name
  for name in "${names[@]}"; do
    while IFS= read -r found; do
      [[ -n "$found" ]] || continue
      [[ "$(basename "$found")" == "README.md" ]] && continue
      sources+=("$found")
    done < <(find "$dir" "${maxdepth_arg[@]}" -type f -name "$name" | sort)
  done
  IFS=$old_ifs
}

sha256_file() { sha256sum "$1" | awk '{print $1}'; }
line_count_file() { wc -l < "$1" | tr -d ' '; }
char_count_file() { wc -m < "$1" | tr -d ' '; }
fingerprint_triplet() {
  local f=$1
  printf '%s %s %s\n' "$(line_count_file "$f")" "$(char_count_file "$f")" "$(sha256_file "$f")"
}

usage() {
  cat <<'EOF'
Simple Usage:
  gendocs

Generates a .pdf file in repository root docs/pdf/ from each .md file
(except README.md) in repository root docs/md/, and a .docx file in
repository root docs/docx/ from each .pdf when the source .md file has
changed since the last generation.

When converting an .md file to a .pdf file, <details>/<summary> lines
are skipped and not converted for the .pdf file.

Complete Usage:
  gendocs [<options>] [<document>[.md]] [<pdf_dir> <docx_dir>]
  gendocs [<options>] -p [<document>[.md]] [<pdf_dir>]
  gendocs [<options>] -d [<document>[.md|.pdf]] [<docx_dir>]
  gendocs [-b <backend>] -t
  gendocs -h | --help

Generates .pdf files from .md source files, and .docx files from .pdf
files generated from .md source files, or from .pdf source files.

By default, when the source is in repository root docs/md/, a document
is regenerated only if the source Markdown has changed. Use the -f
option to force regeneration.

By default, when converting an .md file to a .pdf file,
<details>/<summary> lines are skipped and not converted. Use the -c
option to convert details/summary lines to a PDF-friendly form.

<options>:
  [-b <backend>] [-c] [-f] [-g] [-k] [-n] [-q] [-r] [-v]
  [-i "<pattern>"]... [-x "<pattern>"]...

Option values:
  <backend>  <md-pdf>/<pdf-docx> where:
               <md-pdf>: auto, all, pandoc, wkhtmltopdf, weasyprint
               <pdf-docx>: auto, all, python, libreoffice
             Default is 'auto/auto', which auto-detects the best
             available backend for each conversion.
             Use 'all' with -t to validate all md-pdf or pdf-docx
             backends. 'all' is not valid unless -t is specified.
  <pattern>  Bash glob pattern for relative paths:
             - * or ** matches any characters, including '/'
             - ? matches one character, including '/'
             - [abc] matches one character from a set/range
             - any other character matches itself
             Note: this differs from common path-segment glob
             expectations, where * and ? do not match '/'. Use -g to
             enable * and ? not matching '/'.

Options:
  -b  Force conversion backend instead of auto-detecting.
      Useful for diagnostics and testing.
  -c  Convert details/summary lines to PDF-friendly form instead of
      removing details/summary lines. Default is to remove them.
  -d  Output only .docx files. If source is .md, a temporary .pdf
      is generated for intermediate conversion and then discarded.
  -f  Force regeneration even if the source is in docs/md/ and has
      not changed since the last time its .pdf was generated.
  -g  Use segment-style glob matching for -i/-x patterns:
      * and ? do not match '/'; ** matches across '/'.
  -h, --help  Output this help to stdout and exit.
  -i  Include only files whose relative path matches "<pattern>".
  -k  Keep directory structure under output directory (useful with -r).
  -n  Show planned conversions without writing output files.
  -p  Output only .pdf files. For validation, a temporary .docx is
      generated from each .pdf and then discarded.
  -q  Quiet mode: suppress informational messages to stdout.
      Help and diagnostics are not affected.
      There is no output to stdout in quiet mode when successful.
  -r  When the source is a directory, include matching source files
      in all subdirectories (except README.md files). Default is only
      files directly in that directory.
  -t  Tool check: report backends (see -b option) status and exit.
      When -t is used, no options other than -b are allowed.
  -v  Verbose mode: print backend diagnostics to stderr.
  -x  Exclude files whose relative path matches "<pattern>".

Arguments:
  <document>[.md|.pdf]: Optional specification of source file(s):
    - If not specified, default is repository root docs/md/*.md.
    - Default extension is '.md' and '.pdf' is only allowed if option
      '-d' is specified.
    - If '.pdf' is specified, <source> is <document>.pdf; otherwise,
      <source> is <document>.md
    - <source> must be one of the following:
      - <absolute-relative filepath> for an existing file.
      - <absolute-relative directorypath/>*.md where
        <absolute-relative directorypath/> contains one or more .md
        files other than a README.md file. A README.md is excluded;
        no .pdf or .docx file is generated for it.
      - <absolute-relative directorypath/>*.pdf where
        <absolute-relative directorypath/> contains one or more
        '.pdf' files.
      - <filename> with extension '.md' where docs/md/filename exists
        or, if it doesn't exist, ./filename exists.
      - <filename> with extension '.pdf' where docs/pdf/filename exists
        or, if it doesn't exist, ./filename exists.
      - *.md indicating all '.md' files under docs/md/ other than the
        README.md file.
      - *.pdf indicating all '.pdf' files under docs/pdf/.
  <pdf_dir>:  Optional output directory for generated '.pdf' files.
              Default is repository root docs/pdf/ if source files are
              from docs/md/ and, otherwise, ./ (current directory).
  <docx_dir>: Optional output directory for the generated '.docx' files.
              Default is repository root docs/docx/ if source files are
              from repository root docs/md/ or docs/pdf/ and,
              otherwise, ./ (current directory).

Notes:
  - Change detection for a source '.md' in repository root docs/md/
    uses the file name with line count, character count, and
    SHA-256 fingerprint, and stores this metadata in
    repository root docs/md/.md_metadata with one line per file.

Exit Codes:
  0   Success.
  1   Usage error: general.
  2   Usage error: invalid or incomplete option.
  3   Usage error: invalid argument.
  4   Usage error: invalid option combination/mode.
  5   Input not found.
  6   No source files to process.
  100 Internal setup error: helper script missing.
  110 Internal helper/toolchain check failed.
  111 Internal helper failure: genpdf helper returned non-zero.
  112 Internal helper failure: gendocx helper returned non-zero.
  249 System/runtime call failure.

Examples:
  gendocs
  gendocs -f
  gendocs docs/md/briteTest.md
  gendocs Documentation_Guide
  gendocs -p docs/md
  gendocs -d docs/pdf
  gendocs -d docs/pdf/briteTest.pdf docs/docx
  gendocs docs/md build/pdf build/docx
  gendocs '*.md'
  gendocs -d '*.pdf'
EOF
}

# High-level flow: parse CLI options and validate mode/backend constraints, run
# tool-check mode (-t) early when requested, then resolve/filter source files,
# derive output paths (including recursive/keep-structure behavior), convert via
# helper scripts with metadata-based skip logic, persist metadata, and exit
# through a single status/exit-code path.

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit_with "$EXIT_SUCCESS" ;;
    -f) force=1 ;;
    -p) pdf_only=1 ;;
    -d) docx_only=1 ;;
    -n) dry_run=1 ;;
    -q) quiet=1 ;;
    -v) verbose=1 ;;
    -r) recursive=1 ;;
    -k) keep_structure=1 ;;
    -g) segment_glob=1 ;;
    -c) convert_details=1 ;;
    -t) tool_check=1 ;;
    -i)
      shift
      [[ $# -gt 0 ]] || exit_with "$EXIT_USAGE_OPTION" "-i requires a pattern value."
      include_patterns+=("$1")
      ;;
    -x)
      shift
      [[ $# -gt 0 ]] || exit_with "$EXIT_USAGE_OPTION" "-x requires a pattern value."
      exclude_patterns+=("$1")
      ;;
    -b)
      shift
      [[ $# -gt 0 ]] || exit_with "$EXIT_USAGE_OPTION" "-b requires a backend value."
      if [[ "$1" == */* ]]; then
        backend_md_pdf="${1%%/*}"
        backend_pdf_docx="${1##*/}"
      else
        backend_md_pdf="$1"
        backend_pdf_docx="$1"
      fi
      ;;
    -*) usage >&2; exit_with "$EXIT_USAGE_GENERAL" "Unknown option: $1" ;;
    *) positional+=("$1") ;;
  esac
  shift
done

[[ $pdf_only -eq 1 && $docx_only -eq 1 ]] && \
  exit_with "$EXIT_USAGE_MODE" "-p and -d are mutually exclusive."

if [[ $tool_check -eq 1 ]]; then
  # With -t, only -b is allowed. All other options/args are invalid.
  if has_disallowed_toolcheck_args; then
    exit_with "$EXIT_USAGE_MODE" "With -t, only -b is allowed."
  fi

  validate_toolcheck_backends "$backend_md_pdf" "$backend_pdf_docx" || \
    exit_with "$EXIT_USAGE_OPTION" \
      "Invalid backend selection for -t: $backend_md_pdf/$backend_pdf_docx"
else
  validate_backend_combo "$backend_md_pdf" "$backend_pdf_docx" || \
    exit_with "$EXIT_USAGE_OPTION" \
      "Invalid backend selection: $backend_md_pdf/$backend_pdf_docx"
  [[ "$backend_md_pdf" != "all" && "$backend_pdf_docx" != "all" ]] || \
    exit_with "$EXIT_USAGE_MODE" "Backend token 'all' is only valid with -t."
fi

[[ -f "$genpdf_script" ]] || \
  exit_with "$EXIT_INTERNAL_HELPER_MISSING" "Missing helper script: $genpdf_script"
[[ -f "$gendocx_script" ]] || \
  exit_with "$EXIT_INTERNAL_HELPER_MISSING" "Missing helper script: $gendocx_script"

if [[ $tool_check -eq 1 ]]; then
  run_toolcheck
fi

mkdir -p "$pdf_out_dir" "$docx_out_dir"

declare -A prev_meta=()
declare -A curr_meta=()

if [[ -f "$meta_file" ]]; then
  while read -r rel lc cc hash; do
    [[ -z "${rel:-}" || -z "${lc:-}" || -z "${cc:-}" || -z "${hash:-}" ]] && continue
    prev_meta["$rel"]="$lc $cc $hash"
  done < "$meta_file"
fi
for rel in "${!prev_meta[@]}"; do curr_meta["$rel"]="${prev_meta["$rel"]}"; done

tmp_pdf="$(mktemp --suffix=.pdf)"
tmp_docx="$(mktemp --suffix=.docx)"

# Build helper option arrays
pdf_opts=()
docx_opts=()
[[ $dry_run -eq 1 ]] && { pdf_opts+=(-n); docx_opts+=(-n); }
[[ $quiet -eq 1 ]] && { pdf_opts+=(-q); docx_opts+=(-q); }
[[ $verbose -eq 1 ]] && { pdf_opts+=(-v); docx_opts+=(-v); }
[[ $recursive -eq 1 ]] && { pdf_opts+=(-r); docx_opts+=(-r); }
[[ $keep_structure -eq 1 ]] && { pdf_opts+=(-k); docx_opts+=(-k); }
[[ $segment_glob -eq 1 ]] && { pdf_opts+=(-g); docx_opts+=(-g); }
[[ $convert_details -eq 1 ]] && pdf_opts+=(-c)

for p in "${include_patterns[@]}"; do
  pdf_opts+=(-i "$p")
  docx_opts+=(-i "$p")
done
for p in "${exclude_patterns[@]}"; do
  pdf_opts+=(-x "$p")
  docx_opts+=(-x "$p")
done

pdf_opts+=(-b "$backend_md_pdf")
docx_opts+=(-b "$backend_pdf_docx")

# Resolve sources and optional out dirs from positional arguments
doc_arg="${positional[0]:-}"
out1="${positional[1]:-}"
out2="${positional[2]:-}"

if [[ ${#positional[@]} -gt 3 ]]; then
  exit_with "$EXIT_USAGE_ARGUMENT" "Too many positional arguments."
fi

declare -a sources=()

if [[ -z "$doc_arg" ]]; then
  collect_sources_from_dir "$docs_dir"
else
  if [[ -f "$doc_arg" ]]; then
    sources=("$doc_arg")
  elif [[ -d "$doc_arg" ]]; then
    collect_sources_from_dir "$doc_arg"
  elif [[ "$doc_arg" == *"*"* || "$doc_arg" == *"?"* || "$doc_arg" == *"["* ]]; then
    while IFS= read -r matched; do
      [[ -n "$matched" ]] || continue
      [[ -f "$matched" ]] || continue
      [[ "$(basename "$matched")" == "README.md" ]] && continue
      case "$matched" in
        *.md|*.pdf) sources+=("$matched") ;;
      esac
    done < <(compgen -G "$doc_arg" || true)
  elif [[ -f "$docs_dir/$doc_arg" ]]; then
    sources=("$docs_dir/$doc_arg")
  elif [[ "$doc_arg" != *.md && -f "$docs_dir/$doc_arg.md" ]]; then
    sources=("$docs_dir/$doc_arg.md")
  elif [[ "$doc_arg" == *.pdf && -f "$doc_arg" ]]; then
    sources=("$doc_arg")
  else
    exit_with "$EXIT_INPUT_NOT_FOUND" "Document not found: $doc_arg"
  fi
fi

[[ ${#sources[@]} -gt 0 ]] || exit_with "$EXIT_INPUT_EMPTY" "No source files found."

filtered_sources=()
for src in "${sources[@]}"; do
  rel_filter="$(basename "$src")"
  if [[ "$src" == "$docs_dir"/* ]]; then
    rel_filter="${src#"$docs_dir/"}"
  elif [[ -n "$doc_arg" && -d "$doc_arg" && "$src" == "$doc_arg"/* ]]; then
    rel_filter="${src#"$doc_arg/"}"
  fi

  if is_included_path "$rel_filter"; then
    filtered_sources+=("$src")
  fi
done
sources=("${filtered_sources[@]}")

[[ ${#sources[@]} -gt 0 ]] || \
  exit_with "$EXIT_INPUT_EMPTY" \
    "No source files matched include/exclude filters."

for src in "${sources[@]}"; do
  b="$(basename "$src")"

  if [[ "$b" == "README.md" ]]; then
    log_info "Skipping README.md: $src"
    continue
  fi

  base="${b%.*}"
  rel_subdir=''
  if [[ $recursive -eq 1 && $keep_structure -eq 1 ]]; then
    if [[ "$src" == "$docs_dir"/* ]]; then
      rel_subdir="$(dirname "${src#"$docs_dir/"}")"
    elif [[ -n "$doc_arg" && -d "$doc_arg" && "$src" == "$doc_arg"/* ]]; then
      rel_subdir="$(dirname "${src#"$doc_arg/"}")"
    fi
  fi

  pdf_base="${out1:-$pdf_out_dir}"
  docx_base="${out2:-$docx_out_dir}"
  if [[ -n "$rel_subdir" && "$rel_subdir" != "." ]]; then
    pdf_base="$pdf_base/$rel_subdir"
    docx_base="$docx_base/$rel_subdir"
  fi

  target_pdf="$pdf_base/${base}.pdf"
  target_docx="$docx_base/${base}.docx"

  if [[ "$src" == *.md ]]; then
    rel="${src#"$docs_dir"/}"
    fp="$(fingerprint_triplet "$src")"
    curr_meta["$rel"]="$fp"

    if [[ $force -eq 0 && -f "$target_pdf" && -f "$target_docx" ]]; then
      prev="${prev_meta["$rel"]:-}"
      if [[ "$fp" == "$prev" ]]; then
        log_info "Unchanged source: $src"
        continue
      fi
    fi

    if [[ $docx_only -eq 1 ]]; then
      if ! bash "$genpdf_script" "${pdf_opts[@]}" "$src" "$tmp_pdf"; then
        exit_with "$EXIT_INTERNAL_GENPDF_FAILED" \
          "genpdf helper failed while generating PDF from source: $src"
      fi
      if ! bash "$gendocx_script" "${docx_opts[@]}" "$tmp_pdf" "$target_docx"; then
        exit_with "$EXIT_INTERNAL_GENDOCX_FAILED" \
          "gendocx helper failed while generating DOCX from temporary PDF for source: $src"
      fi
      continue
    fi

    if ! bash "$genpdf_script" "${pdf_opts[@]}" "$src" "$target_pdf"; then
      exit_with "$EXIT_INTERNAL_GENPDF_FAILED" \
        "genpdf helper failed while generating PDF from source: $src"
    fi

    if [[ $pdf_only -eq 1 ]]; then
      if ! bash "$gendocx_script" "${docx_opts[@]}" "$target_pdf" "$tmp_docx"; then
        exit_with "$EXIT_INTERNAL_GENDOCX_FAILED" \
          "gendocx helper failed while validating DOCX generation from PDF: $target_pdf"
      fi
      rm -f "$tmp_docx"
      continue
    fi

    if ! bash "$gendocx_script" "${docx_opts[@]}" "$target_pdf" "$target_docx"; then
      exit_with "$EXIT_INTERNAL_GENDOCX_FAILED" \
        "gendocx helper failed while generating DOCX from PDF: $target_pdf"
    fi

  elif [[ "$src" == *.pdf ]]; then
    # Only valid in -d mode per usage
    [[ $docx_only -eq 1 ]] || exit_with "$EXIT_USAGE_MODE" ".pdf input requires -d mode."
    base="${b%.pdf}"
    target_docx="$docx_base/${base}.docx"
    if ! bash "$gendocx_script" "${docx_opts[@]}" "$src" "$target_docx"; then
      exit_with "$EXIT_INTERNAL_GENDOCX_FAILED" \
        "gendocx helper failed while generating DOCX from PDF source: $src"
    fi
  else
    exit_with "$EXIT_USAGE_ARGUMENT" "Unsupported source type: $src"
  fi
done

tmp_meta_file="$(mktemp)"
for rel in "${!curr_meta[@]}"; do
  printf '%s %s\n' "$rel" "${curr_meta["$rel"]}"
done | sort > "$tmp_meta_file"
mv -f "$tmp_meta_file" "$meta_file"

if [[ $docx_only -eq 1 ]]; then
  log_info "Generated DOCX files."
elif [[ $pdf_only -eq 1 ]]; then
  log_info "Generated PDF files and validated DOCX conversion via temporary outputs."
else
  log_info "Generated PDF and DOCX files."
fi

exit_with "$EXIT_SUCCESS"
