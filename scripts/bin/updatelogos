#!/usr/bin/env python3

# updatelogos - Update branding assets and propagate brand phrase replacements.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

"""
Update .svg files in docs/branding with brand abbreviation replacements,
then regenerate the corresponding PNG files, and update markdown documentation.

Copyright (c) 2026 Paul Sinclair
SPDX-License-Identifier: MIT
For license details, see LICENSE in the repository root.

This script reads phrase replacements from a configuration file, generates
abbreviations from the phrases, and applies them to .svg files in the
docs/branding directory. After updating SVG files, it regenerates the
corresponding PNG files using the genpng script. It then calls the
replacephrases script to update all markdown files in docs/.

Configuration file format:
    old_phrase = new_phrase
    # Completed: <date time>:

The configuration supports a history log:
- Lines starting with # Completed: <date time>: mark completed replacement batches
- All other #<comment> lines are treated as comments and ignored
- Only replacements BEFORE the first # Completed: <date time>: line are processed
- When complete, a new # Completed: <date time>: line is inserted at the beginning

Each line defines a replacement where:
- old_phrase: the text to find (abbreviation extracted from this)
- new_phrase: the text to replace it with (abbreviation extracted from this)

Abbreviations are generated by taking the first letter of each word.

Examples:
    LiteTest = briteTest       # Replaces LT with BT (SVGs) and LiteTest (docs)
    Test Framework = My Framework  # Replaces TF with MF (SVGs) and Test Framework (docs)
    # Completed: 2026-06-24 15:30:45:

Whitespace around the '=' is ignored.
Lines starting with #Completed: <date time>: mark completed batches.
Lines starting with # are comments (unless # Completed: <date time>:).
Empty lines are ignored.

Usage:
    python3 scripts/bin/updatelogos [config_file] [--dry-run]

Default config file: docs/branding/brand.txt
"""

import os
import sys
import subprocess
import argparse
from pathlib import Path
from datetime import datetime


def generate_abbreviation(phrase):
    """
    Generate an abbreviation from a phrase by taking the first letter of each word.
    
    Args:
        phrase: The phrase to abbreviate
        
    Returns:
        The abbreviation in uppercase (e.g., "BriteTest" -> "BT")
    """
    words = phrase.split()
    abbreviation = ''.join(word[0] for word in words if word)
    return abbreviation.upper()


def parse_config(config_file):
    """
    Parse the configuration file and return phrase replacements and abbreviation replacements.
    
    Processes only lines before the first # Completed: <date time>: marker.
    
    Args:
        config_file: Path to the configuration file
        
    Returns:
        Tuple of (phrase_replacements, abbr_replacements) where:
        - phrase_replacements: List of (old_phrase, new_phrase) tuples
        - abbr_replacements: List of (old_abbr, new_abbr) tuples
        
    Raises:
        FileNotFoundError: If config file doesn't exist
        ValueError: If config file has invalid format or circular references
    """
    phrase_replacements = []
    abbr_replacements = []
    
    try:
        with open(config_file, 'r', encoding='utf-8') as f:
            for line_num, line in enumerate(f, 1):
                line = line.rstrip('\n\r')
                
                # Check for completion marker - stop processing
                if line.startswith('# Completed:') and line.endswith(':'):
                    break
                
                # Skip empty lines and comments
                if not line.strip() or line.startswith('#'):
                    continue
                
                # Parse the replacement
                if '=' not in line:
                    raise ValueError(f"Line {line_num}: Missing '=' separator. Expected format: old_phrase = new_phrase")
                
                old_phrase, new_phrase = line.split('=', 1)
                old_phrase = old_phrase.strip()
                new_phrase = new_phrase.strip()
                
                if not old_phrase:
                    raise ValueError(f"Line {line_num}: old_phrase cannot be empty")
                
                # Store phrase replacement
                phrase_replacements.append((old_phrase, new_phrase))
                
                # Generate abbreviations
                old_abbr = generate_abbreviation(old_phrase)
                new_abbr = generate_abbreviation(new_phrase)
                
                if old_abbr and new_abbr:
                    abbr_replacements.append((old_abbr, new_abbr))
    
    except FileNotFoundError:
        raise FileNotFoundError(f"Config file not found: {config_file}")
    
    return phrase_replacements, abbr_replacements


def validate_replacements(phrase_replacements, abbr_replacements):
    """
    Validate that no old phrase/abbreviation matches any new phrase/abbreviation
    to prevent infinite loops during replacements.
    
    Args:
        phrase_replacements: List of (old_phrase, new_phrase) tuples
        abbr_replacements: List of (old_abbr, new_abbr) tuples
        
    Raises:
        ValueError: If circular references are detected
    """
    # Collect all new phrases and abbreviations
    all_new_phrases = set(new_phrase for _, new_phrase in phrase_replacements)
    all_new_abbrs = set(new_abbr for _, new_abbr in abbr_replacements)
    
    # Check phrase replacements
    for old_phrase, new_phrase in phrase_replacements:
        if old_phrase in all_new_phrases:
            raise ValueError(
                f"Circular reference detected: old_phrase '{old_phrase}' matches a new_phrase. "
                f"This would cause an infinite loop during replacement."
            )
    
    # Check abbreviation replacements
    for old_abbr, new_abbr in abbr_replacements:
        if old_abbr in all_new_abbrs:
            raise ValueError(
                f"Circular reference detected: old_abbr '{old_abbr}' matches a new_abbr. "
                f"This would cause an infinite loop during replacement."
            )


def find_svg_files_in_branding(branding_dir='docs/branding'):
    """
    Find all .svg files in the docs/branding directory.
    
    Args:
        branding_dir: Path to the branding directory (default: docs/branding)
        
    Yields:
        Path objects for each .svg file in docs/branding
    """
    branding_path = Path(branding_dir)
    if not branding_path.exists():
        return
    
    for path in branding_path.glob('*.svg'):
        yield path


def process_file(file_path, replacements, dry_run=False):
    """
    Replace content in a single .svg file.
    
    Args:
        file_path: Path to the .svg file
        replacements: List of (old_text, new_text) tuples
        dry_run: If True, don't actually modify the file
        
    Returns:
        Tuple of (replacements_made, changes_list) where changes_list contains
        details about each replacement made
    """
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()
    except Exception as e:
        return 0, [f"Error reading {file_path}: {e}"]
    
    original_content = content
    changes = []
    replacements_made = 0
    
    for old_text, new_text in replacements:
        if old_text in content:
            count = content.count(old_text)
            content = content.replace(old_text, new_text)
            replacements_made += count
            changes.append(f"  - Replaced '{old_text}' -> '{new_text}' ({count} occurrence{'s' if count != 1 else ''})")
    
    if content != original_content:
        if not dry_run:
            try:
                with open(file_path, 'w', encoding='utf-8') as f:
                    f.write(content)
            except Exception as e:
                return 0, [f"Error writing to {file_path}: {e}"]
    
    return replacements_made, changes


def regenerate_pngs(dry_run=False):
    """
    Regenerate PNG files from updated SVG files using genpng.
    
    Args:
        dry_run: If True, don't actually run the regeneration
        
    Returns:
        True if successful, False otherwise
    """
    script_dir = Path(__file__).parent
    genpng_script = script_dir / 'genpng'
    
    if not genpng_script.exists():
        print(f"Warning: {genpng_script} not found. PNG files will not be regenerated.", file=sys.stderr)
        return False
    
    if dry_run:
        print(f"[DRY RUN] Would execute: {genpng_script}")
        return True
    
    print("\nRegenerating PNG files from SVG sources...")
    try:
        result = subprocess.run(
            [str(genpng_script)],
            check=True,
            capture_output=True,
            text=True
        )
        print(result.stdout)
        return True
    except subprocess.CalledProcessError as e:
        print(f"Error regenerating PNG files: {e.stderr}", file=sys.stderr)
        return False
    except Exception as e:
        print(f"Error executing genpng: {e}", file=sys.stderr)
        return False


def update_markdown_docs(config_file, dry_run=False):
    """
    Call the replacephrases script to update markdown documentation.
    
    Args:
        config_file: Path to the configuration file
        dry_run: If True, don't actually modify files
        
    Returns:
        True if successful, False otherwise
    """
    script_dir = Path(__file__).parent
    replacephrases_script = script_dir / 'replacephrases'
    
    if not replacephrases_script.exists():
        print(f"Warning: {replacephrases_script} not found. Markdown files will not be updated.", file=sys.stderr)
        return False
    
    if dry_run:
        print(f"[DRY RUN] Would execute: {replacephrases_script} {config_file}")
        return True
    
    print(f"\nUpdating markdown documentation using {replacephrases_script}...")
    try:
        result = subprocess.run(
            [str(replacephrases_script), config_file],
            check=True,
            capture_output=True,
            text=True
        )
        print(result.stdout)
        return True
    except subprocess.CalledProcessError as e:
        print(f"Error updating markdown files: {e.stderr}", file=sys.stderr)
        return False
    except Exception as e:
        print(f"Error executing replacephrases: {e}", file=sys.stderr)
        return False


def insert_completion_marker(config_file):
    """
    Insert a completion marker at the beginning of the config file.
    
    Args:
        config_file: Path to the configuration file
        
    Returns:
        True if successful, False otherwise
    """
    try:
        # Read current contents
        with open(config_file, 'r', encoding='utf-8') as f:
            content = f.read()
        
        # Generate timestamp
        timestamp = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        completion_marker = f"# Completed: {timestamp}:\n"
        
        # Insert marker at the beginning
        new_content = completion_marker + content
        
        # Write back
        with open(config_file, 'w', encoding='utf-8') as f:
            f.write(new_content)
        
        return True
    except Exception as e:
        print(f"Error inserting completion marker: {e}", file=sys.stderr)
        return False


def main():
    """Main entry point."""
    parser = argparse.ArgumentParser(
        prog='updatelogos',
        usage='updatelogos [-h] [--dry-run] [config_file]',
        description='Update .svg files in docs/branding with brand replacements, regenerate PNGs, and update markdown docs',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
Configuration file format:
  old_phrase = new_phrase
  # Completed: <date time>:
  
The configuration supports a history log:
- Lines starting with # Completed: <date time>: mark completed replacement batches
- Only replacements before the first # Completed: <date time>: are processed
- When complete, a new # Completed: <date time>: is inserted at the beginning

Abbreviations are generated from phrases by taking the first letter of each word.
Both phrase replacements and abbreviation replacements are applied to SVG files.
Phrase replacements are then applied to markdown files in docs/.

Example:
  # docs/branding/brand.txt
  LiteTest = briteTest
  # Completed: 2026-06-24 15:30:45:
  
  # This will:
    # 1. Update SVGs with "LiteTest" -> "briteTest" and "LT" -> "bT"
  # 2. Regenerate PNG files
    # 3. Update markdown files with "LiteTest" -> "briteTest"
  # 4. Insert new # Completed: <date time>: marker at the beginning
        '''
    )
    
    parser.add_argument(
        'config_file',
        nargs='?',
        default='docs/branding/brand.txt',
        help='Path to the configuration file (default: docs/branding/brand.txt)'
    )
    
    parser.add_argument(
        '--dry-run',
        action='store_true',
        help='Show what would be replaced without actually modifying files'
    )
    
    args = parser.parse_args()
    
    # Check if config file exists
    config_path = Path(args.config_file)
    if not config_path.exists():
        print(f"Config file not found: {args.config_file}")
        return 0
    
    # Check if config file is empty
    if config_path.stat().st_size == 0:
        print(f"Config file is empty: {args.config_file}")
        return 0
    
    # Parse configuration
    try:
        phrase_replacements, abbr_replacements = parse_config(args.config_file)
    except (FileNotFoundError, ValueError) as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1
    
    if not phrase_replacements and not abbr_replacements:
        print(f"No new replacements found in {args.config_file} (all have been completed)")
        return 0
    
    # Validate replacements for circular references
    try:
        validate_replacements(phrase_replacements, abbr_replacements)
    except ValueError as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1
    
    # Combine all replacements (phrases first, then abbreviations)
    all_replacements = phrase_replacements + abbr_replacements
    
    print(f"Loaded {len(phrase_replacements)} phrase replacement(s) from {args.config_file}")
    if phrase_replacements:
        print("Phrase replacements:")
        for old_phrase, new_phrase in phrase_replacements:
            print(f"  '{old_phrase}' -> '{new_phrase}'")
    
    if abbr_replacements:
        print("\nAbbreviation replacements:")
        for old_abbr, new_abbr in abbr_replacements:
            print(f"  {old_abbr} -> {new_abbr}")
    print()
    
    if args.dry_run:
        print("DRY RUN MODE - No files will be modified\n")
    
    # Find and process all .svg files in docs/branding
    svg_files = list(find_svg_files_in_branding())
    
    total_replacements = 0
    files_modified = 0
    
    if not svg_files:
        print("No .svg files found in docs/branding")
    else:
        for file_path in sorted(svg_files):
            replacements_made, changes = process_file(file_path, all_replacements, args.dry_run)
            
            if replacements_made > 0:
                files_modified += 1
                total_replacements += replacements_made
                print(f"{file_path}:")
                for change in changes:
                    print(change)
                print()
        
        # Summary for SVG updates
        print("=" * 60)
        if args.dry_run:
            print("SVG DRY RUN SUMMARY:")
        else:
            print("SVG UPDATE SUMMARY:")
        print(f"  Files processed: {len(svg_files)}")
        print(f"  SVG files modified: {files_modified}")
        print(f"  Total replacements: {total_replacements}")
        
        # Regenerate PNGs if SVG files were modified
        if files_modified > 0 or (args.dry_run and total_replacements > 0):
            if not regenerate_pngs(args.dry_run):
                print("\nWarning: PNG regeneration failed, but SVG files were updated.", file=sys.stderr)
    
    # Update markdown documentation
    if not update_markdown_docs(args.config_file, args.dry_run):
        print("\nWarning: Markdown documentation update failed.", file=sys.stderr)
        return 1
    
    # Insert completion marker if not a dry run
    if not args.dry_run:
        if not insert_completion_marker(args.config_file):
            print("\nWarning: Failed to insert completion marker.", file=sys.stderr)
            return 1
        
        print("\n" + "=" * 60)
        print("COMPLETED")
        print("Completion marker inserted at the beginning of config file")
    else:
        print("\n" + "=" * 60)
        print("DRY RUN COMPLETE")
        print("Run without --dry-run to apply these changes")
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
