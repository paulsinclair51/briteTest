#!/usr/bin/env bash

# mkclone - Clone the repository and automatically install scripts and Git hooks.
#
# See usage below for details, or run: mkclone -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<EOF
Usage:
  mkclone [OPTIONS] [directory]
  mkclone {-h | --help}

Clone the BriteTest repository to a local directory with automatic setup.

Requirements:
  - Must be run on a machine with bash, git, and curl installed
  - Network access to GitHub (https://github.com)
  - Can be run from ANY directory on your local machine
  - NO prior clone or local repository needed

This script:
  - Clones the repository to a target directory
  - Automatically installs scripts and Git hooks (no manual steps required)
  - Git hooks protect against accidental direct git commands
  - Sets up PATH so scripts are immediately available

Arguments:
  [directory]        Optional target directory name
                     If not specified, uses 'BriteTest'
                     Examples: mkclone
                                 -> Creates ./BriteTest/
                                mkclone my-workspace
                                 -> Creates ./my-workspace/

Comment Options (mutually exclusive):
  -m, --message MSG  Attach a comment to the operation
                     Usage: mkclone -m "Setup for feature work"
  -- COMMENT TEXT    Unix-style comment (everything after -- is the comment)
                     Usage: mkclone -- Setup for feature work
                     Note: No quotes needed, captures all remaining arguments

Options:
  -h, --help         Output this help to stdout and exit (other options
                     and arguments are ignored).
  -m, --message MSG  Add comment message (GitHub style,
                     requires quotes if spaces)
  -- TEXT            Add comment (Unix style,
                     everything after -- is the comment)

Examples:
  # Basic clone with automatic setup (run from anywhere)
  mkclone
    -> Creates ./BriteTest/ with scripts and hooks installed

  # Clone into custom directory with automatic setup
  mkclone my-workspace
    -> Creates ./my-workspace/ with scripts and hooks installed

  # With GitHub-style comment
  mkclone -m "Setup for new feature development"

  # With Unix-style comment
  mkclone work-repo -- Starting feature branch work


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented
    output locations.

Exit codes:
  0   Success
  1   Argument error
  2   Git clone failed
  3   Target directory already exists
  4   Failed to install scripts or hooks
  5   Missing required tools (git, bash, curl)
EOF
}

# High-Level Flow:
# - Can run from ANY directory on your local machine
# - Does NOT require bash helpers upfront
# - Clones the configured repository URL into a default or user-specified
#   target directory.
# - Validates arguments, comment options, and target-path preconditions before
#   cloning.
# - Automatically runs setupclone to set up scripts and Git hooks.
# - Reports clone results and prints next-step workflow guidance.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
HISTORY_HELPER="$SCRIPT_DIR/../helpers/history_log.sh"

# Shared helpers
if [[ ! -f "$HISTORY_HELPER" ]]; then
  echo "Error: Required helper not found: $HISTORY_HELPER" >&2
  exit 5
fi
# shellcheck source=helpers/history_log.sh
if ! source "$HISTORY_HELPER"; then
  echo "Error: Failed to load helper: $HISTORY_HELPER" >&2
  exit 5
fi

# Repository configuration
REPO_URL="https://github.com/paulsinclair51/BriteTest"
REPO_NAME="BriteTest"

readonly EXIT_INVALID_ARGUMENT=1

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "Invalid option or argument. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

# Default options
COMMENT=""
TARGET_DIR=""

# Simple output helpers (no external dependency)
info() {
  echo "[INFO] $1"
}

success() {
  echo "[SUCCESS] $1"
}

warn() {
  echo "[WARN] $1"
}

error_exit() {
  local code="$1"
  local message="$2"
  echo "[ERROR] $message" >&2
  exit "$code"
}

# Check for required tools
check_requirements() {
  local missing=()
  
  if ! command -v git &> /dev/null; then
    missing+=("git")
  fi
  
  if ! command -v bash &> /dev/null; then
    missing+=("bash")
  fi
  
  if [[ ${#missing[@]} -gt 0 ]]; then
    error_exit 5 "Missing required tools: ${missing[*]}"
  fi
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -m requires a message argument"
      fi
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -m and -- for comment"
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -m and -- for comment"
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      # Positional argument
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Check that we have at most 1 positional argument
if [[ $# -gt 1 ]]; then
  usage_error "Expected at most 1 argument (directory), got $#"
fi

# Determine target directory
if [[ $# -eq 1 ]]; then
  TARGET_DIR="$1"
else
  TARGET_DIR="$REPO_NAME"
fi

# Validate target directory name
if [[ -z "$TARGET_DIR" ]]; then
  usage_error "Target directory name cannot be empty"
fi

# Check if target directory already exists
if [[ -e "$TARGET_DIR" ]]; then
  error_exit 3 "Target directory '$TARGET_DIR' already exists"
fi

# Check requirements before starting
check_requirements

# Clone the repository
info "Cloning repository..."
if ! git clone "$REPO_URL" "$TARGET_DIR" 2>&1; then
  error_exit 2 "Failed to clone repository from $REPO_URL"
fi

success "Repository cloned successfully"

# Propagate repository history from remote if available
if cd "$TARGET_DIR"; then
  bt_propagate_repository_history
  case $? in
    0) ;;
    1) info "Updated repository history from remote" ;;
    *) ;;
  esac
  cd - >/dev/null
fi

# Display repository information
info "Repository: $REPO_URL"
info "Cloned to: ./$TARGET_DIR"

# Install scripts and Git hooks
info "Setting up scripts and Git hooks..."
if bash "$TARGET_DIR/scripts/bin/installscripts" >/dev/null 2>&1; then
  success "Scripts and Git hooks installed successfully"
else
  warn "Warning: Failed to install scripts or Git hooks"
  info "You can install them manually by running:"
  info "  cd $TARGET_DIR"
  info "  bash scripts/bin/installscripts"
fi

# Enforce policy: do not leave a local 'main' branch in the clone.
if git -C "$TARGET_DIR" show-ref --verify --quiet refs/heads/main; then
  info "Applying branch policy: removing local 'main' from clone..."

  current_branch="$(git -C "$TARGET_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

  # Preferred fallback order when choosing a non-main local branch:
  # 1) targeted branch, 2) contributor branch, 3) version branch,
  # 4) detach at origin/main.
  remote_branches="$(git -C "$TARGET_DIR" for-each-ref --format='%(refname:short)' refs/remotes/origin | sed -n 's#^origin/##p' | grep -Ev '^(HEAD|main)$' | sort || true)"

  preferred_remote_branch="$(printf '%s\n' "$remote_branches" | grep -E '^(dev|fix)/[a-z0-9][a-z0-9-]*-v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$' | head -n 1 || true)"

  if [[ -z "$preferred_remote_branch" ]]; then
    preferred_remote_branch="$(printf '%s\n' "$remote_branches" | grep -Ev '^v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$|^(dev|fix)/[a-z0-9][a-z0-9-]*-v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$' | head -n 1 || true)"
  fi

  if [[ -z "$preferred_remote_branch" ]]; then
    preferred_remote_branch="$(printf '%s\n' "$remote_branches" | grep -E '^v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$' | head -n 1 || true)"
  fi

  if [[ "$current_branch" == "main" ]]; then
    if [[ -n "$preferred_remote_branch" ]]; then
      if ! git -C "$TARGET_DIR" switch -c "$preferred_remote_branch" --track "origin/$preferred_remote_branch" >/dev/null 2>&1; then
        error_exit 4 "Failed to create local tracking branch '$preferred_remote_branch' before removing local main"
      fi
      info "Switched to local branch '$preferred_remote_branch'"
    else
      if ! git -C "$TARGET_DIR" switch --detach origin/main >/dev/null 2>&1; then
        error_exit 4 "Failed to detach to origin/main before removing local main"
      fi
      warn "No targeted, contributor, or version branch found; repository is detached at origin/main"
    fi
  fi

  if ! git -C "$TARGET_DIR" branch -D main >/dev/null 2>&1; then
    error_exit 4 "Failed to remove local main branch from clone"
  fi

  success "Removed local 'main' from clone"
fi

info "Next steps:"
echo "  cd $TARGET_DIR"
echo "  mkbranch fix/your-branch main"

exit 0
