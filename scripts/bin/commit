#!/usr/bin/env bash

# commit - Commit changes to the current branch.
#
# See usage below for details, or run: commit -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  commit [OPTIONS] [-- TOKEN...]
  commit {-h | --help}

Commit changes for a contributor to the current branch with a
commit comment. The current branch must be a local non-protected
targeted or contributor branch:
  - dev/<desc>-<version>
  - fix/<desc>-<version>
  - [<type>/]<description>

See chbranch script for details on switching branches. See the
Contributor Guide for details on branch naming conventions and
contributor workflow.

Arguments:
  None.

Options:
  -c TOKEN           Commit comment as a single token which may be quoted.
  -- TOKEN...        Commit comment from one or more tokens.
                     A token may be quoted. Token '--' must be a separate token.
  -d                 Dry-run for the branch commit workflow.
                     The changes are not committed.
  -h                 Output this help to stdout and exit (other options
                     and arguments are ignored).
  --help             Output this help to stdout and exit (other options
                     and arguments are ignored).
  -v                 Verbose output. Shows detailed progress lines.

  For commit comment options '-c TOKEN' and '-- TOKEN...':
    - These options are mutually exclusive.
    - A commit comment is required except when -h or --help is specified.
    - For '-- TOKEN...', tokens are concatenated separated by a
      single space.
    - Quoted token whitespace is preserved and the quotes are removed.
    - For example, the following both have the same commit comment:
        commit -- do "  keep   this spacing  " for commit comment.
        commit -c "do   keep   this spacing   for commit comment."
    - The resulting commit comment from TOKEN or TOKEN... must include
      at least one non-whitespace character.
    - Always ensure that the commit comment accurately reflects the
      changes being committed.

Example: Commit changes using the -c option.
  commit -c "Fix authentication bug in login module."

Example: Commit changes using the -- option.
  commit -- Add new feature.

Outputs:
  - Output to stdout includes for a completed commit:
      Current local branch: <branch>.
      1 file committed. or <n> files committed.
      See reports/branch/commit-<datetime>-<pid>.md for details.
  Output to stdout includes for a completed dry-run commit:
      Current local branch: <branch>.
      1 file to commit. or <n> files to commit.
      See reports/branch/commit-d-<datetime>.md for details.
  - Output to stdout includes when there are no files to commit:
      Current local branch: <branch>.
      No files to commit.
  - With -v, output to stdout includes additional progress and
    detailed file/commit lists.
  - Writes a commit report in the current branch:
    - For a successful commit:
          <repo>/reports/branch/commit-<datetime>-<pid>.md
    - For a failed commit:
          <repo>/reports/branch/commit-f-<datetime>.md
    - For a dry-run commit:
          <repo>/reports/branch/commit-d-<datetime>.md
  - A report is not generated when the exit code is 1, 2, 3, 4, or 5,
    when there are no changes to commit, or the -h/--help option is
    specified.
  - Report files are untracked and are made read-only after generation.
    To edit a report, copy it outside the repository first.
  - Older untracked failed and dry-run reports in the current branch
    are removed when a new report is generated.
  - Writes errors and diagnostics to stderr.

Exit codes:
  0   Success: commit or dry-run completed, nothing to commit,
      or help requested.
  1   Invalid command usage. See the error line after usage output for details.
  2   User is not a contributor.
  3   Commit comment is missing or empty.
  4   Current branch is not local.
  5   Current branch is a protected branch.
  200 Could not inspect working tree. Run `fixrepo`; if the issue
      persists, contact an approver or repository owner to resolve
      file/state/permission issues.
  201 Failed to commit. Run `fixrepo`; if the issue persists, contact
      an approver or repository owner to resolve file/state/permission
      issues.
EOF
}

# High-Level Flow:
# - Parse options and initialize run mode (dry-run, verbose).
# - Validate branch constraints and determine whether there are local changes to
#   commit.
# - Execute commit and automatic push when remote conditions are met.
# - Generate a report only when work occurred, prune stale dry-run reports, then
#   mark the report read-only and persist the commit-owned report changes.
# - Print a single final status line that includes counts and report
#   disposition.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BRANCH_REPORTS_DIR="$REPO_ROOT/reports/branch"
CONTRIBUTORS_FILE="$REPO_ROOT/config/contributors.md"
RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
REPORT_FILE=""
ORIGINAL_ARGS=("$@")
DRY_RUN_REPORT_DELETIONS=()
BRANCH_REPORTS_DIR_UNLOCKED=false

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"
# shellcheck source=helpers/report_sync.sh
source "$SCRIPT_DIR/../helpers/report_sync.sh"

# history_log.sh is optional in minimal or isolated test environments.
# If unavailable, provide a no-op fallback used by divergence handling.
if [[ -f "$SCRIPT_DIR/../helpers/history_log.sh" ]]; then
  # shellcheck source=helpers/history_log.sh
  source "$SCRIPT_DIR/../helpers/history_log.sh"
else
  bt_propagate_repository_history() {
    return 0
  }
fi

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_NOT_AUTHORIZED=2
readonly EXIT_COMMENT_EMPTY=3
readonly EXIT_NOT_LOCAL_BRANCH=4
readonly EXIT_PROTECTED_BRANCH=5
readonly EXIT_WORKTREE_INSPECTION_FAILED=200
readonly EXIT_STAGE_COMMIT_FAILED=201

# Aliases for branch/config/login failure paths used below.
readonly EXIT_NOT_ON_BRANCH=4
readonly EXIT_NOT_ON_LOCAL_BRANCH=4
readonly EXIT_CONFIG_NOT_FOUND=2
readonly EXIT_LOGIN_UNKNOWN=2

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

ensure_trailing_period() {
  local message="$1"

  if [[ -z "$message" ]]; then
    printf '.'
    return 0
  fi

  if [[ "$message" == *"." ]]; then
    printf '%s' "$message"
  else
    printf '%s.' "$message"
  fi
}

bt_info() {
  echo "$(ensure_trailing_period "$1")"
}

bt_success() {
  echo "$(ensure_trailing_period "$1")"
}

bt_warn() {
  echo "$(ensure_trailing_period "$1")"
}

bt_error_exit() {
  local code="$1"
  local message="$2"

  echo "Error: $(ensure_trailing_period "$message")" >&2
  exit "$code"
}

generate_failed_commit_report() {
  REPORT_FILE="$BRANCH_REPORTS_DIR/commit-f-${RUN_TS_FILE}.md"

  enable_branch_reports_write_access

  if [[ -f "$REPORT_FILE" ]]; then
    chmod u+w "$REPORT_FILE" 2>/dev/null || true
  fi

  cat > "$REPORT_FILE" <<EOF
# Commit Report ${RUN_TS_DISPLAY}

**Status:** Failed
**Command:** \`$(format_command_line)\`
**Branch:** \`${CURRENT_BRANCH}\`

The commit workflow did not complete successfully.
EOF

  if [[ "$COMMITTED_FILES" -gt 0 && -n "$COMMIT_FILE_LIST" ]]; then
    {
      echo
      echo "## Pending Files"
      echo
      printf '%s\n' "$COMMIT_FILE_LIST" | sed 's/^/- /'
    } >> "$REPORT_FILE"
  fi

  mark_report_read_only "$REPORT_FILE"
  disable_branch_reports_write_access
}

fail_commit_and_exit() {
  generate_failed_commit_report
  bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Failed to commit. Run 'fixrepo'; if the issue persists, contact an approver to help resolve file/state issues, then retry."
}

run_git_command() {
  if [[ "$VERBOSE" == true ]]; then
    "$@"
  else
    "$@" >/dev/null 2>&1
  fi
}

cleanup_old_dry_run_reports() {
  local old_report
  local report_rel
  local pattern

  DRY_RUN_REPORT_DELETIONS=()

  for pattern in "commit-d-*.md" "commit-f-*.md"; do
    for old_report in "$BRANCH_REPORTS_DIR"/$pattern; do
      [[ -e "$old_report" ]] || continue
      [[ -n "$REPORT_FILE" && "$old_report" == "$REPORT_FILE" ]] && continue

      # Keep tracked report artifacts untouched to avoid unrelated deletions.
      if git ls-files --error-unmatch "$old_report" >/dev/null 2>&1; then
        continue
      fi

      report_rel="${old_report#"${REPO_ROOT}"/}"
      if rm -f "$old_report" 2>/dev/null; then
        DRY_RUN_REPORT_DELETIONS+=("$report_rel")
      else
        bt_warn "Could not remove stale report: $report_rel"
      fi
    done
  done
}

mark_report_read_only() {
  local report_path="$1"

  if ! chmod a-w "$report_path" 2>/dev/null; then
    bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Failed to mark report read-only: $report_path"
  fi
}

persist_report_changes() {
  local current_branch
  local report_filename
  local report_rel
  local commit_comment
  local -a report_paths=()

  if [[ -z "$REPORT_FILE" || ! -f "$REPORT_FILE" ]]; then
    bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Report file was not generated as expected."
  fi

  report_filename="$(basename "$REPORT_FILE")"
  report_rel="${REPORT_FILE#"${REPO_ROOT}"/}"
  current_branch="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
  if [[ -z "$current_branch" ]]; then
    bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Cannot save report. Check out a branch and try again."
  fi

  # Only persist this script's report file plus stale dry-run deletions.
  report_paths=(
    "$report_rel"
  )
  if [[ ${#DRY_RUN_REPORT_DELETIONS[@]} -gt 0 ]]; then
    report_paths+=("${DRY_RUN_REPORT_DELETIONS[@]}")
  fi

  if ! run_git_command env GIT_BYPASS_HOOKS=true git add -A -- "${report_paths[@]}"; then
    bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Failed to prepare report for commit."
  fi

  if git diff --cached --quiet -- "${report_paths[@]}"; then
    bt_info "No changes to report."
    return 0
  fi

  commit_comment="commit: update branch report ${RUN_TS_DISPLAY}"
  if ! run_git_command env GIT_BYPASS_HOOKS=true git commit -m "$commit_comment" -- "${report_paths[@]}"; then
    bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Failed to commit report."
  fi

  if [[ "$VERBOSE" == true ]]; then
    bt_success "Report $report_filename committed."
  fi
}

initialize_report_file() {
  if [[ "$DRY_RUN" == true ]]; then
    REPORT_FILE="$BRANCH_REPORTS_DIR/commit-d-${RUN_TS_FILE}.md"
  else
    if [[ -d "$BRANCH_REPORTS_DIR" ]] && compgen -G "$BRANCH_REPORTS_DIR/commit-${RUN_TS_FILE}-*.md" >/dev/null; then
      # Avoid same-second collisions by waiting until the clock advances
      # to the next second before generating the report name.
      while :; do
        local next_ts
        next_ts="$(date '+%Y%m%d-%H%M%S')"
        if [[ "$next_ts" != "$RUN_TS_FILE" ]]; then
          RUN_TS_FILE="$next_ts"
          RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
          break
        fi
      done
    fi
    REPORT_FILE="$BRANCH_REPORTS_DIR/commit-${RUN_TS_FILE}-$$.md"
  fi
}

# Default options
COMMIT_COMMENT=""
DRY_RUN=false
VERBOSE=false
COMMITTED_FILES=0
NEEDS_COMMIT=false
COMMIT_FILE_LIST=""
COMMIT_STATS_FILE="$(mktemp)"

cleanup_runtime_files() {
  # shellcheck disable=SC2317  # Invoked by trap cleanup_runtime_files EXIT.
  if [[ "$BRANCH_REPORTS_DIR_UNLOCKED" == true ]]; then
    bt_report_dir_disable_writes "$BRANCH_REPORTS_DIR" "$EXIT_STAGE_COMMIT_FAILED" || true
    BRANCH_REPORTS_DIR_UNLOCKED=false
  fi
  rm -f "$COMMIT_STATS_FILE"
}

trap cleanup_runtime_files EXIT

enable_branch_reports_write_access() {
  bt_report_dir_enable_writes "$BRANCH_REPORTS_DIR" "$EXIT_STAGE_COMMIT_FAILED"
  BRANCH_REPORTS_DIR_UNLOCKED=true
}

disable_branch_reports_write_access() {
  if [[ "$BRANCH_REPORTS_DIR_UNLOCKED" == true ]]; then
    bt_report_dir_disable_writes "$BRANCH_REPORTS_DIR" "$EXIT_STAGE_COMMIT_FAILED"
    BRANCH_REPORTS_DIR_UNLOCKED=false
  fi
}

is_contributor_or_higher() {
  local login="$1"
  local user_email

  user_email="$(git config user.email 2>/dev/null || true)"

  awk -F',' -v login="$login" -v user_email="$user_email" '
    function trim(s) {
      gsub(/^[[:space:]-]+|[[:space:]]+$/, "", s)
      return s
    }
    {
      actor = trim($1)
      role = trim($2)
      email = trim($3)

      if ((actor == login || (user_email != "" && email == user_email)) &&
          (role == "C" || role == "R" || role == "A")) {
        found = 1
      }
    }
    END {
      exit(found ? 0 : 1)
    }
  ' "$CONTRIBUTORS_FILE"
}

is_remote_connected() {
  git remote get-url origin >/dev/null 2>&1
}

print_summary() {
  bt_info "Summary: committed files=$COMMITTED_FILES"
}

emit_file_count_status() {
  local count="$1"
  local mode="$2"

  if [[ "$mode" == "dry-run" ]]; then
    if [[ "$count" -eq 1 ]]; then
      bt_success "1 file to commit"
    else
      bt_success "$count files to commit"
    fi
  else
    if [[ "$count" -eq 1 ]]; then
      bt_success "1 file committed"
    else
      bt_success "$count files committed"
    fi
  fi
}

collect_commit_file_stats() {
  : > "$COMMIT_STATS_FILE"

  [[ -n "$COMMIT_FILE_LIST" ]] || return 0

  printf '%s\n' "$COMMIT_FILE_LIST" | while IFS= read -r file_path; do
    [[ -n "$file_path" ]] || continue

    local added="0"
    local removed="0"
    local stats_line=""

    stats_line="$(git diff --numstat HEAD -- "$file_path" 2>/dev/null || true)"
    if [[ -n "$stats_line" ]]; then
      added="$(printf '%s\n' "$stats_line" | awk '{ if ($1 ~ /^[0-9]+$/) s+=$1 } END { print s+0 }')"
      removed="$(printf '%s\n' "$stats_line" | awk '{ if ($2 ~ /^[0-9]+$/) s+=$2 } END { print s+0 }')"
    elif [[ -f "$file_path" ]] && ! git cat-file -e "HEAD:$file_path" >/dev/null 2>&1; then
      added="$(wc -l < "$file_path" | tr -d ' ')"
      removed="0"
    fi

    printf '%s\t%s\t%s\n' "$file_path" "$added" "$removed" >> "$COMMIT_STATS_FILE"
  done
}

collect_commit_candidate_files() {
  local status_tmp
  local record=""
  local status=""
  local path=""
  local old_path=""
  local -a candidates=()

  status_tmp="$(mktemp)"

  if ! git status --porcelain -z >"$status_tmp" 2>/dev/null; then
    rm -f "$status_tmp"
    bt_error_exit "$EXIT_WORKTREE_INSPECTION_FAILED" "Failed to inspect working tree status"
  fi

  exec 3<"$status_tmp"

  while IFS= read -r -d '' record <&3; do
    [[ ${#record} -ge 3 ]] || continue
    status="${record:0:2}"
    path="${record:3}"

    # For porcelain -z rename/copy entries, the next NUL field is the source path.
    if [[ "${status:0:1}" == "R" || "${status:1:1}" == "R" ]]; then
      IFS= read -r -d '' old_path <&3 || old_path=""
      [[ -n "$old_path" ]] && candidates+=("$old_path")
      [[ -n "$path" ]] && candidates+=("$path")
    elif [[ "${status:0:1}" == "C" || "${status:1:1}" == "C" ]]; then
      IFS= read -r -d '' old_path <&3 || true
      [[ -n "$path" ]] && candidates+=("$path")
    else
      [[ -n "$path" ]] && candidates+=("$path")
    fi
  done
  exec 3<&-
  rm -f "$status_tmp"

  if [[ ${#candidates[@]} -eq 0 ]]; then
    COMMIT_FILE_LIST=""
  else
    COMMIT_FILE_LIST="$(printf '%s\n' "${candidates[@]}" | sed '/^$/d' | sort -u)"
  fi
}

print_commit_file_details() {
  local heading="$1"
  local status_label="${2:-commit}"

  [[ -n "$COMMIT_FILE_LIST" ]] || return 0

  bt_info "$heading"
  printf '%s\n' "$COMMIT_FILE_LIST" | while IFS= read -r file_path; do
    [[ -n "$file_path" ]] || continue
    bt_info "  - $file_path [$status_label]"
  done
}

format_command_line() {
  local formatted="commit"
  local arg

  for arg in "${ORIGINAL_ARGS[@]}"; do
    printf -v formatted '%s %q' "$formatted" "$arg"
  done

  printf '%s\n' "$formatted"
}

get_stats_for_file() {
  local file_path="$1"
  local stats_file="$2"

  local stats_line
  stats_line="$(awk -F '\t' -v f="$file_path" '$1 == f { print $0; exit }' "$stats_file" 2>/dev/null || true)"
  if [[ -z "$stats_line" ]]; then
    printf '0\t0\n'
    return 0
  fi

  printf '%s\n' "$stats_line" | awk -F '\t' '{ printf "%s\t%s\n", $2, $3 }'
}

write_commit_report_row() {
  local file_path="$1"
  local commit_hash="$2"
  local added="$3"
  local removed="$4"
  local total_lines="$5"
  local notes="$6"
  local out_file="${7:-$REPORT_FILE}"
  local net

  net=$((added - removed))
  printf '| %s | %s | %s | %s | %+d | %s | %s |\n' \
    "$file_path" "$commit_hash" "$added" "$removed" "$net" "$total_lines" "$notes" >> "$out_file"
}

append_commit_table_header() {
  cat >> "$REPORT_FILE" <<'EOF'
| **File** | **Commit Hash** | **Added** | **Deleted** | **Net** | **Total** | **Notes** |
| --- | --- | --- | --- | --- | --- | --- |
EOF
}

get_total_lines_for_file() {
  local file_path="$1"

  if [[ -f "$file_path" ]]; then
    wc -l < "$file_path" | tr -d ' '
  else
    printf ''
  fi
}

build_commit_note() {
  local file_path="$1"
  local added="$2"
  local removed="$3"
  local change_text
  local scope_text

  if [[ "$added" -gt 0 && "$removed" -eq 0 ]]; then
    change_text="Added new content"
  elif [[ "$added" -eq 0 && "$removed" -gt 0 ]]; then
    change_text="Removed existing content"
  else
    change_text="Updated existing content"
  fi

  case "$file_path" in
    *.md)
      scope_text="documentation"
      ;;
    scripts/bin/* | scripts/helpers/* | *.sh)
      scope_text="script logic"
      ;;
    src/*.[ch] | include/*.[ch])
      scope_text="C source implementation"
      ;;
    *)
      scope_text="file content"
      ;;
  esac

  printf '%s in %s\n' "$change_text" "$scope_text"
}

generate_commit_report() {
  local command_text
  command_text="$(format_command_line)"
  local report_title="Commit Report"

  local committed_only=0
  local total_rows=0
  local commit_hash=""

  enable_branch_reports_write_access

  if [[ "$NEEDS_COMMIT" == true && "$DRY_RUN" == false ]]; then
    commit_hash="$(git rev-parse --short HEAD 2>/dev/null || true)"
  elif [[ "$NEEDS_COMMIT" == true && "$DRY_RUN" == true ]]; then
    commit_hash=""
  fi

  if [[ -f "$REPORT_FILE" ]]; then
    # Dry-run reports reuse second-resolution names; allow overwrite within
    # the same second even when a prior run made the file read-only.
    chmod u+w "$REPORT_FILE" 2>/dev/null || true
  fi

  cat > "$REPORT_FILE" <<EOF
# ${report_title} ${RUN_TS_DISPLAY}

**Command:** \`${command_text}\`

**Branch:** \`${CURRENT_BRANCH}\`

__SUMMARY_LINE_1__
__SUMMARY_LINE_2__
EOF

  local commit_only_rows_tmp
  commit_only_rows_tmp="$(mktemp)"

  if [[ "$NEEDS_COMMIT" == true ]]; then
    printf '%s\n' "$COMMIT_FILE_LIST" | while IFS= read -r file_path; do
      [[ -n "$file_path" ]] || continue
      local stats
      stats="$(get_stats_for_file "$file_path" "$COMMIT_STATS_FILE")"
      local added removed
      added="${stats%%$'\t'*}"
      removed="${stats#*$'\t'}"
      local total_lines
      total_lines="$(get_total_lines_for_file "$file_path")"
      local commit_notes
      commit_notes="$(build_commit_note "$file_path" "$added" "$removed")"
      commit_notes="${commit_notes//|/\\|}"
      write_commit_report_row "$file_path" "$commit_hash" "$added" "$removed" "$total_lines" "$commit_notes" "$commit_only_rows_tmp"
    done
    committed_only="$COMMITTED_FILES"
  fi

  if [[ "$committed_only" -gt 0 ]]; then
    printf '\n## Commit\n\n' >> "$REPORT_FILE"
    append_commit_table_header
    cat "$commit_only_rows_tmp" >> "$REPORT_FILE"
  fi

  total_rows="$committed_only"

  # shellcheck disable=SC2016
  awk -v c="$committed_only" -v t="$total_rows" '
    /^__SUMMARY_LINE_1__$/ { print "**Commit:** " c "<br>"; next }
    /^__SUMMARY_LINE_2__$/ { print "**Total:** " t; next }
    { print }
  ' "$REPORT_FILE" > "$REPORT_FILE.tmp" && mv "$REPORT_FILE.tmp" "$REPORT_FILE"

  cleanup_old_dry_run_reports
  mark_report_read_only "$REPORT_FILE"

  rm -f "$commit_only_rows_tmp"
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -c)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -c requires a comment token"
      fi
      if [[ -n "$COMMIT_COMMENT" ]]; then
        usage_error "Cannot use both -c and -- for comment"
      fi
      COMMIT_COMMENT="$2"
      shift 2
      ;;
    -d)
      DRY_RUN=true
      shift
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    --)
      # '-- TOKEN...': the tokens after '--' are the comment
      shift
      if [[ -n "$COMMIT_COMMENT" ]]; then
        usage_error "Cannot use both -c and -- for the commit comment"
      fi
      if [[ $# -eq 0 ]]; then
        usage_error "Option -- requires one or more tokens for the commit comment"
      fi
      COMMIT_COMMENT="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      usage_error "Unexpected argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit "$EXIT_NOT_ON_BRANCH" "Failed to determine current branch")
bt_success "Current local branch: $CURRENT_BRANCH"
initialize_report_file

# Disallow commits from detached HEAD (for example, origin/main or origin/v*).
if [[ "$CURRENT_BRANCH" == "HEAD" ]]; then
  bt_error_exit "$EXIT_NOT_LOCAL_BRANCH" \
    "Not on a local working branch. Use 'chbranch' to switch to a local non-protected branch, then retry."
fi

# Commit script operates on a local branch only.
if ! git show-ref --verify --quiet "refs/heads/$CURRENT_BRANCH"; then
  bt_error_exit "$EXIT_NOT_ON_LOCAL_BRANCH" "Not on a local branch. Use 'chbranch' to switch to a local non-protected branch, then retry."
fi

if [[ ! -f "$CONTRIBUTORS_FILE" ]]; then
  bt_error_exit "$EXIT_CONFIG_NOT_FOUND" "Configuration file not found: $CONTRIBUTORS_FILE"
fi

ACTOR_LOGIN="$(bt_require_login || true)"
if [[ -z "$ACTOR_LOGIN" ]]; then
  bt_error_exit "$EXIT_LOGIN_UNKNOWN" "Unable to determine GitHub login identity for permission check"
fi

if ! is_contributor_or_higher "$ACTOR_LOGIN"; then
  bt_error_exit "$EXIT_NOT_AUTHORIZED" "User '$ACTOR_LOGIN' is not authorized to run commit (requires contributor role or higher)"
fi

# Check if branch is protected
if bt_is_protected_branch "$CURRENT_BRANCH"; then
  bt_error_exit "$EXIT_PROTECTED_BRANCH" \
    "Current branch '$CURRENT_BRANCH' is protected. Use 'chbranch' to switch to a non-protected local branch, then retry."
fi

# Validate commit comment for all non-help invocations.
if [[ -z "$COMMIT_COMMENT" ]]; then
  bt_error_exit "$EXIT_COMMENT_REQUIRED" "Commit comment is required (-c TOKEN or -- TOKENS)"
fi

COMMIT_COMMENT_TRIMMED="$COMMIT_COMMENT"
COMMIT_COMMENT_TRIMMED="${COMMIT_COMMENT_TRIMMED#"${COMMIT_COMMENT_TRIMMED%%[![:space:]]*}"}"
COMMIT_COMMENT_TRIMMED="${COMMIT_COMMENT_TRIMMED%"${COMMIT_COMMENT_TRIMMED##*[![:space:]]}"}"
if [[ -z "$COMMIT_COMMENT_TRIMMED" ]]; then
  bt_error_exit "$EXIT_COMMENT_EMPTY" "Commit comment must include at least one non-whitespace character"
fi

# Determine commit candidates
collect_commit_candidate_files
if [[ -n "$COMMIT_FILE_LIST" ]]; then
  NEEDS_COMMIT=true
  COMMITTED_FILES="$(printf '%s\n' "$COMMIT_FILE_LIST" | wc -l | tr -d ' ')"
  collect_commit_file_stats
else
  NEEDS_COMMIT=false
  COMMITTED_FILES=0
fi

# Commit flow
if [[ "$NEEDS_COMMIT" == true ]]; then
  if [[ "$DRY_RUN" == true ]]; then
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Dry run: would create commit with $COMMITTED_FILES file(s)"
      print_commit_file_details "Files that would be committed:" "commit"
    fi
  else
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Preparing for commit..."
    fi
    if ! run_git_command env GIT_BYPASS_HOOKS=true git add --all; then
      fail_commit_and_exit
    fi
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Prepared for commit"
    fi

    if [[ "$VERBOSE" == true ]]; then
      bt_info "Creating commit..."
    fi
    if ! run_git_command env GIT_BYPASS_HOOKS=true git commit -m "$COMMIT_COMMENT"; then
      fail_commit_and_exit
    fi
    if [[ "$VERBOSE" == true ]]; then
      bt_success "Commit created: $COMMIT_COMMENT"
      print_commit_file_details "Committed files:" "commit"
    fi
  fi
else
  if [[ "$VERBOSE" == true ]]; then
    bt_info "No changes to commit"
  fi
fi

if [[ "$VERBOSE" == true && "$COMMITTED_FILES" -gt 0 ]]; then
  print_summary
fi
if [[ "$COMMITTED_FILES" -gt 0 ]]; then
  generate_commit_report
  disable_branch_reports_write_access
  report_rel="${REPORT_FILE#"${REPO_ROOT}"/}"
  if [[ "$DRY_RUN" == true ]]; then
    emit_file_count_status "$COMMITTED_FILES" "dry-run"
  else
    emit_file_count_status "$COMMITTED_FILES" "commit"
  fi
  bt_success "See ${report_rel} for details"
else
  bt_success "No files to commit"
fi
exit 0
