#!/usr/bin/env bash

# commit - Commit changes to the local current branch and optionally push
# changes to the corresponding remote (origin) branch.
#
# See usage below for details, or run: commit -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  commit [OPTIONS] [files...]
  commit -h | --help

Commit changes to the current branch in briteTest.
Stages all changes by default and commits them with a message.
Optionally pushes to remote if remote is connected.

Protected branches (require mergetoparent for changes):
  - main
  - v<M>.<m>.<p> version branches created from main

Allowed branches (can use commit):
  - dev/<desc>-<version> and fix/<desc>-<version> targeted branches.
  - [<type>/]<description> contributor branches.

Arguments:
  [files...]         Optional list of files to stage and commit
                     If not specified, stages all changes (git add .)
                     Examples: commit file1.js file2.js
                               commit src/index.js

Commit Message Options (mutually exclusive):
  -m, --message MSG  Commit message (GitHub style, requires quotes if spaces)
                     Usage: commit -m "Fix authentication bug"
  -- TEXT            Unix-style message (everything after -- is the message)
                     Usage: commit -- Fix authentication bug
                     Note: No quotes needed, captures all remaining arguments

Push Options:
  -d                 Dry run (do not actually commit or push, just show what
                     would be done).
  -p                 Push changes to remote after commit to branch.
                     Shows confirmation prompt before pushing
  -f                 Force push (skip confirmation, use with caution)
                     Only applies with -p

Options:
  -h, --help         Output this help to stdout and exit (other options
                     and arguments are ignored).

Examples:
  # Commit all changes locally only
  commit -m "Fix authentication bug in login module"

  # Commit specific files locally
  commit src/auth.js src/login.js -m "Update authentication logic"

  # Commit all changes and push (with confirmation)
  commit -m "Add new feature" -p

  # Commit and force push (skip confirmation)
  commit -m "Rebase and force push" -p -f

  # Unix-style message
  commit -- Fix critical memory leak

  # Commit specific files with Unix-style message
  commit file1.js file2.js -- Update parser logic


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.

Exit codes:
  0   Success.
  1   Argument or validation error.
  2   Current branch is protected.
  3   Current branch is not local.
  4   Skipped push to remote since remote is not connected.
  5   Git staging or commit failed.
  6   Git push failed.
  7   Conflict handling failed.
EOF
}

# High-Level Flow:
# - Stages and commits repository changes with workflow-aware validation.
# - Pushes the commit and records commit metadata to history logs when
#   configured.
# - Checks branch context and clean/dirty states before commit operations.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Default options
COMMIT_MESSAGE=""
PUSH=false
FORCE=false
DRY_RUN=false
FILES=()
COMMIT_CREATED=false
COMMITTED_FILES=0
PUSHED_COMMITS=0

is_remote_connected() {
  git remote get-url origin >/dev/null 2>&1
}

get_unpushed_commit_count() {
  local branch="$1"

  if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git rev-list --count "origin/$branch..$branch" 2>/dev/null || echo 0
  else
    git rev-list --count "$branch" 2>/dev/null || echo 0
  fi
}

print_summary() {
  bt_info "Summary: committed files=$COMMITTED_FILES, pushed commits=$PUSHED_COMMITS"
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -m requires a message argument"
      fi
      if [[ -n "$COMMIT_MESSAGE" ]]; then
        bt_error_exit 1 "Cannot use both -m and -- for message"
      fi
      COMMIT_MESSAGE="$2"
      shift 2
      ;;
    -d)
      DRY_RUN=true
      shift
      ;;
    -p)
      PUSH=true
      shift
      ;;
    -f)
      FORCE=true
      shift
      ;;
    --)
      # Unix-style message: everything after -- is the message
      shift
      if [[ -n "$COMMIT_MESSAGE" ]]; then
        bt_error_exit 1 "Cannot use both -m and -- for message"
      fi
      COMMIT_MESSAGE="$*"
      break
      ;;
    -*)
      bt_error_exit 1 "Unknown option: $1"
      ;;
    *)
      # Positional argument (file)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Collect files
FILES=("$@")

# Validate commit message
if [[ -z "$COMMIT_MESSAGE" ]]; then
  bt_error_exit 1 "Commit message is required (-m or -- followed by message)"
fi

if [[ "$FORCE" == true && "$PUSH" == false ]]; then
  bt_error_exit 1 "Option -f requires -p"
fi

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit 1 "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

# Disallow commits from detached HEAD (for example, origin/main or origin/v*).
if [[ "$CURRENT_BRANCH" == "HEAD" ]]; then
  bt_error_exit 1 \
    "Cannot commit from detached HEAD. Switch to a local non-protected branch first."
fi

# Commit script operates on a local branch only.
if ! git show-ref --verify --quiet "refs/heads/$CURRENT_BRANCH"; then
  bt_error_exit 3 "Current branch '$CURRENT_BRANCH' is not a local branch"
fi

# Check if branch is protected
if bt_is_protected_branch "$CURRENT_BRANCH"; then
  bt_error_exit 2 \
    "Cannot commit directly to protected branch '$CURRENT_BRANCH'. "\
"Use 'mergetoparent' to merge changes to this branch."
fi

# Stage changes
bt_info "Staging changes..."
if [[ ${#FILES[@]} -eq 0 ]]; then
  # Stage all changes
  if ! git add --all 2>&1; then
    bt_error_exit 5 "Failed to stage changes"
  fi
  bt_info "Staged all changes"
else
  # Stage specific files
  if ! git add "${FILES[@]}" 2>&1; then
    bt_error_exit 5 "Failed to stage files: ${FILES[*]}"
  fi
  bt_info "Staged files: ${FILES[*]}"
fi

# Count staged files before commit.
COMMITTED_FILES=$(git diff --cached --name-only | sed '/^$/d' | wc -l | tr -d ' ')

# Check if there are staged changes
if ! git diff --cached --quiet; then
  # Create commit
  if [[ "$DRY_RUN" == true ]]; then
    bt_info "Dry run: would create commit with $COMMITTED_FILES file(s)"
    COMMIT_CREATED=true
  else
    bt_info "Creating commit..."
    if ! git commit -m "$COMMIT_MESSAGE" 2>&1; then
      bt_error_exit 5 "Failed to create commit"
    fi
    COMMIT_CREATED=true
    bt_success "Commit created: $COMMIT_MESSAGE"
  fi
else
  COMMITTED_FILES=0
  bt_info "No changes staged to commit"
fi

# Push if requested
if [[ "$PUSH" == true ]]; then
  if ! is_remote_connected; then
    bt_warn "Remote 'origin' is not connected; skipping push"
    PUSHED_COMMITS=0
    print_summary
    exit 4
  fi

  local_unpushed="$(get_unpushed_commit_count "$CURRENT_BRANCH")"
  if [[ ! "$local_unpushed" =~ ^[0-9]+$ ]]; then
    local_unpushed=0
  fi

  if [[ "$local_unpushed" -eq 0 ]]; then
    bt_info "Nothing to push"
  else
    bt_info "Ready to push $local_unpushed commit(s) to remote"
    bt_info "Pushing branch '$CURRENT_BRANCH' to remote..."

    if [[ "$FORCE" == false && "$DRY_RUN" == false ]]; then
      # Ask for confirmation
      echo -n "Push to remote? (y/n): "
      read -r response
      if [[ ! "$response" =~ ^[Yy]$ ]]; then
        bt_warn "Push cancelled"
        print_summary
        exit 0
      fi
    fi

    # Push changes
    if [[ "$DRY_RUN" == true ]]; then
      bt_info "Dry run: would push $local_unpushed commit(s)"
      PUSHED_COMMITS="$local_unpushed"
    elif [[ "$FORCE" == true ]]; then
      if ! git push --force origin "$CURRENT_BRANCH" 2>&1; then
        bt_error_exit 6 "Failed to force push to remote"
      fi
      PUSHED_COMMITS="$local_unpushed"
      bt_success "Force pushed to remote"
    else
      if ! git push origin "$CURRENT_BRANCH" 2>&1; then
        bt_error_exit 6 "Failed to push to remote"
      fi
      PUSHED_COMMITS="$local_unpushed"
      bt_success "Pushed to remote"
    fi
  fi
fi

if [[ "$COMMITTED_FILES" -eq 0 && "$PUSHED_COMMITS" -eq 0 ]]; then
  bt_info "Nothing to commit, nothing to push"
fi

print_summary
bt_success "Commit complete"
exit 0
