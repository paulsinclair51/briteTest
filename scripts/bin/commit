#!/usr/bin/env bash

# commit - Commit any changes to the local current branch and
# automatically push changes when a corresponding remote
#
# See usage below for details, or run: commit -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  commit [OPTIONS] [-- TOKEN...]
  commit {-h | --help}

Commit changes to the current local branch in briteTest with a
commit comment. After commit, this script automatically pushes
when remote is connected and the corresponding remote branch
exists.

Commit is not allowed on protected branches. Use mrgup to apply
changes to a protected branch:
  - main
  - v<M>.<m>.<p> version branches created from main.

Local branches may use commit:
  - dev/<desc>-<version> and fix/<desc>-<version> targeted branches.
  - [<type>/]<description> contributor branches.

Arguments:
  None.

Options:
  -c TOKEN           Commit comment as a single token.
  -- TOKEN...        Commit comment as 'TOKEN...' indicating one or more tokens.
  -d                 Dry-run for the branch commit/push workflow. The script
                     does not create or push the primary code commit, but it
                     still generates the report and may delete stale dry-run
                     reports.
  -h                 Output this help to stdout and exit (other options
                     and arguments are ignored).
  --help             Output this help to stdout and exit (other options
                     and arguments are ignored).
  -v                 Verbose output. Shows detailed progress lines.

  For commit comment options '-c TOKEN' and '-- TOKEN...':
    - These options are mutually exclusive.
    - One of these options is required if one or more commits are to be made.
    - Ignored if no changes need to be committed.
    - Neither of these options are required if only pushing existing local
      commits to remote.
    - In dry-run mode (-d), commit comment requirements are still validated
      when a commit would be created.
    - For '-- TOKEN...', '--' must be a separate token, followed by at least
      one or more tokens. Leading/trailing whitespace is not preserved
      and whitespace between tokens is reduced to a single space.
    - For a quoted token, whitespace is preserved and the quotes are
      removed.
    - For example, the following both have the same commit comment:
        commit -- do "  keep   this spacing  " for commit comment.
        commit -c "do   keep   this spacing   for commit comment."
    - The resulting commit comment from TOKEN or TOKEN... must include
      at least one non-whitespace character.
    - Always ensure that the commit comment accurately reflects the
      changes being committed.

Example: Commit all changes (auto-pushes when corresponding remote
         exists).
  commit -c "Fix authentication bug in login module."

Example: Commit all changes (auto-pushes when corresponding remote
         exists).
  commit -- Add new feature.

Outputs:
  - By default (without -v), output to stdout is:
    - Current branch.
    - Final status includes counts based on mode:
      - Commit: <n> (no corresponding remote or not connected)
      - Commit/Push: <c>, Push: <p> (connected with a corresponding
        remote)
      - Push: <p> (local commits are pending to be pushed)
      - No commits / No commits or pushes when no work was done.
  - With -v, output to stdout includes additional progress and
    detailed file/commit lists.
  - Writes a report to:
    - <repo>/reports/branch/commit-<datetime>-<pid>.md (normal run)
    - <repo>/reports/branch/commit-d-<datetime>.md (dry run)
  - Report files are made read-only after generation. To edit a report,
    copy it outside the repository first.
  - Older untracked local dry-run reports are removed when a new report is
    generated.
  - Non-dry-run reports are copied to remote (not git-persisted) so both
    local and remote have the same reports for audit trail continuity.
  - Writes errors and diagnostics to stderr.

Exit codes:
  0   Success.
  1   Invalid command usage. See the error line after usage output for details.
  3   Branch diverged. Run `mrgbranch` to resolve conflicts, then retry.
  4   Remote is not connected/reachable. Verify remote access and network,
      then retry.
  5   Not authorized for commit. Request authorization from an approver.
  6   Commit comment is missing/empty when changes require a commit.
  7   Could not inspect working tree. Run `fixrepo` or request an approver
      to help resolve repository health and permissions issues.
  200 Failed to commit. Run `fixrepo`;
      if the issue persists, contact an approver to resolve file/state issues.
  201 Could not push to remote (git push failed). Verify remote access and
      network, then retry.
EOF
}

# High-Level Flow:
# - Parse options and initialize run mode (dry-run, verbose).
# - Validate branch constraints and determine whether there are local changes to
#   commit.
# - Execute commit and automatic push when remote conditions are met.
# - Generate a report only when work occurred, prune stale dry-run reports, then
#   mark the report read-only and persist the commit-owned report changes.
# - Print a single final status line that includes counts and report
#   disposition.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BRANCH_REPORTS_DIR="$REPO_ROOT/reports/branch"
CONTRIBUTORS_FILE="$REPO_ROOT/config/contributors.md"
RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
REPORT_FILE=""
ORIGINAL_ARGS=("$@")
DRY_RUN_REPORT_DELETIONS=()
BRANCH_REPORTS_DIR_UNLOCKED=false

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"
# shellcheck source=helpers/report_sync.sh
source "$SCRIPT_DIR/../helpers/report_sync.sh"

# history_log.sh is optional in minimal or isolated test environments.
# If unavailable, provide a no-op fallback used by divergence handling.
if [[ -f "$SCRIPT_DIR/../helpers/history_log.sh" ]]; then
  # shellcheck source=helpers/history_log.sh
  source "$SCRIPT_DIR/../helpers/history_log.sh"
else
  bt_propagate_repository_history() {
    return 0
  }
fi

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_BRANCH_DIVERGED=3
readonly EXIT_REMOTE_UNREACHABLE=4
readonly EXIT_NOT_AUTHORIZED=5
readonly EXIT_COMMENT_REQUIRED=6
readonly EXIT_COMMENT_EMPTY=7
readonly EXIT_WORKTREE_INSPECTION_FAILED=7
readonly EXIT_STAGE_COMMIT_FAILED=200
readonly EXIT_PUSH_FAILED=201

# Aliases for branch/config/login failure paths used below.
readonly EXIT_NOT_ON_BRANCH=1
readonly EXIT_NOT_ON_LOCAL_BRANCH=1
readonly EXIT_CONFIG_NOT_FOUND=6
readonly EXIT_LOGIN_UNKNOWN=5

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

ensure_trailing_period() {
  local message="$1"

  if [[ -z "$message" ]]; then
    printf '.'
    return 0
  fi

  if [[ "$message" == *"." ]]; then
    printf '%s' "$message"
  else
    printf '%s.' "$message"
  fi
}

bt_info() {
  echo "$(ensure_trailing_period "$1")"
}

bt_success() {
  echo "$(ensure_trailing_period "$1")"
}

bt_warn() {
  echo "$(ensure_trailing_period "$1")"
}

bt_error_exit() {
  local code="$1"
  local message="$2"

  echo "Error: $(ensure_trailing_period "$message")" >&2
  exit "$code"
}

fail_commit_and_exit() {
  bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Failed to commit. Run 'fixrepo'; if the issue persists, contact an approver to help resolve file/state issues, then retry."
}

run_git_command() {
  if [[ "$VERBOSE" == true ]]; then
    "$@"
  else
    "$@" >/dev/null 2>&1
  fi
}

cleanup_old_dry_run_reports() {
  local old_report
  local report_rel

  DRY_RUN_REPORT_DELETIONS=()

  for old_report in "$BRANCH_REPORTS_DIR"/commit-d-*.md; do
    [[ -e "$old_report" ]] || continue
    [[ -n "$REPORT_FILE" && "$old_report" == "$REPORT_FILE" ]] && continue

    # Keep tracked report artifacts untouched to avoid unrelated deletions.
    if git ls-files --error-unmatch "$old_report" >/dev/null 2>&1; then
      continue
    fi

    report_rel="${old_report#"${REPO_ROOT}"/}"
    if rm -f "$old_report" 2>/dev/null; then
      DRY_RUN_REPORT_DELETIONS+=("$report_rel")
    else
      bt_warn "Could not remove stale dry-run report: $report_rel"
    fi
  done
}

mark_report_read_only() {
  local report_path="$1"

  if ! chmod a-w "$report_path" 2>/dev/null; then
    bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Failed to mark report read-only: $report_path"
  fi
}

persist_report_changes() {
  local current_branch
  local report_filename
  local report_rel
  local commit_comment
  local -a report_paths=()

  if [[ -z "$REPORT_FILE" || ! -f "$REPORT_FILE" ]]; then
    bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Report file was not generated as expected."
  fi

  report_filename="$(basename "$REPORT_FILE")"
  report_rel="${REPORT_FILE#"${REPO_ROOT}"/}"
  current_branch="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
  if [[ -z "$current_branch" ]]; then
    bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Cannot save report. Check out a branch and try again."
  fi

  # Only persist this script's report file plus stale dry-run deletions.
  report_paths=(
    "$report_rel"
  )
  if [[ ${#DRY_RUN_REPORT_DELETIONS[@]} -gt 0 ]]; then
    report_paths+=("${DRY_RUN_REPORT_DELETIONS[@]}")
  fi

  if ! run_git_command env GIT_BYPASS_HOOKS=true git add -A -- "${report_paths[@]}"; then
    bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Failed to prepare report for commit."
  fi

  if git diff --cached --quiet -- "${report_paths[@]}"; then
    bt_info "No changes to report."
    return 0
  fi

  commit_comment="commit: update branch report ${RUN_TS_DISPLAY}"
  if ! run_git_command env GIT_BYPASS_HOOKS=true git commit -m "$commit_comment" -- "${report_paths[@]}"; then
    bt_error_exit "$EXIT_STAGE_COMMIT_FAILED" "Failed to commit report."
  fi

  if ! git remote get-url origin >/dev/null 2>&1; then
    bt_warn "No remote repository configured"
    if [[ "$VERBOSE" == true ]]; then
      bt_success "Report $report_filename committed."
    fi
    return 0
  fi

  if ! git ls-remote --heads origin >/dev/null 2>&1; then
    bt_warn "Cannot connect to remote repository"
    if [[ "$VERBOSE" == true ]]; then
      bt_success "Report $report_filename committed."
    fi
    return 0
  fi

  if run_git_command env GIT_BYPASS_HOOKS=true git push origin "$current_branch"; then
    if [[ "$VERBOSE" == true ]]; then
      bt_success "Report $report_filename committed/pushed."
    fi
    return 0
  fi

  bt_warn "Failed to push report commit to remote."
  if [[ "$VERBOSE" == true ]]; then
    bt_success "Report $report_filename committed."
  fi
}

initialize_report_file() {
  if [[ "$DRY_RUN" == true ]]; then
    REPORT_FILE="$BRANCH_REPORTS_DIR/commit-d-${RUN_TS_FILE}.md"
  else
    if [[ -d "$BRANCH_REPORTS_DIR" ]] && compgen -G "$BRANCH_REPORTS_DIR/commit-${RUN_TS_FILE}-*.md" >/dev/null; then
      # Avoid same-second collisions by waiting until the clock advances
      # to the next second before generating the report name.
      while :; do
        local next_ts
        next_ts="$(date '+%Y%m%d-%H%M%S')"
        if [[ "$next_ts" != "$RUN_TS_FILE" ]]; then
          RUN_TS_FILE="$next_ts"
          RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
          break
        fi
      done
    fi
    REPORT_FILE="$BRANCH_REPORTS_DIR/commit-${RUN_TS_FILE}-$$.md"
  fi
}

# Default options
COMMIT_COMMENT=""
PUSH=false
DRY_RUN=false
VERBOSE=false
COMMITTED_FILES=0
PUSHED_COMMITS=0
DID_PUSH_REMOTE=false
NEEDS_COMMIT=false
COMMIT_FILE_LIST=""
PUSH_COMMIT_LIST=""
PRE_PUSHED_COMMITS=0
PRE_PUSH_COMMIT_LIST=""
PRE_PUSH_RANGE=""
PUSH_RANGE=""
BEHIND_COMMITS=0
DIVERGENCE_AUTO_RESOLVED=false
COMMIT_STATS_FILE="$(mktemp)"
PREPUSH_STATS_FILE="$(mktemp)"
PREPUSH_NOTES_FILE="$(mktemp)"

cleanup_runtime_files() {
  # shellcheck disable=SC2317  # Invoked by trap cleanup_runtime_files EXIT.
  if [[ "$BRANCH_REPORTS_DIR_UNLOCKED" == true ]]; then
    bt_report_dir_disable_writes "$BRANCH_REPORTS_DIR" "$EXIT_STAGE_COMMIT_FAILED" || true
    BRANCH_REPORTS_DIR_UNLOCKED=false
  fi
  rm -f "$COMMIT_STATS_FILE" "$PREPUSH_STATS_FILE" "$PREPUSH_NOTES_FILE"
}

trap cleanup_runtime_files EXIT

enable_branch_reports_write_access() {
  bt_report_dir_enable_writes "$BRANCH_REPORTS_DIR" "$EXIT_STAGE_COMMIT_FAILED"
  BRANCH_REPORTS_DIR_UNLOCKED=true
}

disable_branch_reports_write_access() {
  if [[ "$BRANCH_REPORTS_DIR_UNLOCKED" == true ]]; then
    bt_report_dir_disable_writes "$BRANCH_REPORTS_DIR" "$EXIT_STAGE_COMMIT_FAILED"
    BRANCH_REPORTS_DIR_UNLOCKED=false
  fi
}

is_contributor_or_higher() {
  local login="$1"
  local user_email

  user_email="$(git config user.email 2>/dev/null || true)"

  awk -F',' -v login="$login" -v user_email="$user_email" '
    function trim(s) {
      gsub(/^[[:space:]-]+|[[:space:]]+$/, "", s)
      return s
    }
    {
      actor = trim($1)
      role = trim($2)
      email = trim($3)

      if ((actor == login || (user_email != "" && email == user_email)) &&
          (role == "C" || role == "R" || role == "A")) {
        found = 1
      }
    }
    END {
      exit(found ? 0 : 1)
    }
  ' "$CONTRIBUTORS_FILE"
}

is_remote_connected() {
  git remote get-url origin >/dev/null 2>&1
}

print_summary() {
  bt_info "Summary: committed files=$COMMITTED_FILES, pushed commits=$PUSHED_COMMITS"
}

emit_final_status() {
  local completion_text="$1"
  local report_generated="$2"
  local report_rel=""
  local final_text="$completion_text"

  if [[ "$report_generated" == true ]]; then
    report_rel="${REPORT_FILE#"${REPO_ROOT}"/}"
  fi

  if [[ "$DIVERGENCE_AUTO_RESOLVED" == true ]]; then
    final_text="${final_text} Diverged history was auto-resolved; review resolved code before sharing."
  fi

  bt_success "$final_text"

  if [[ "$report_generated" == true ]]; then
    bt_success "See ${report_rel} for details."
  else
    bt_success "Report not generated."
  fi
}

collect_commit_file_stats() {
  : > "$COMMIT_STATS_FILE"

  [[ -n "$COMMIT_FILE_LIST" ]] || return 0

  printf '%s\n' "$COMMIT_FILE_LIST" | while IFS= read -r file_path; do
    [[ -n "$file_path" ]] || continue

    local added="0"
    local removed="0"
    local stats_line=""

    stats_line="$(git diff --numstat HEAD -- "$file_path" 2>/dev/null || true)"
    if [[ -n "$stats_line" ]]; then
      added="$(printf '%s\n' "$stats_line" | awk '{ if ($1 ~ /^[0-9]+$/) s+=$1 } END { print s+0 }')"
      removed="$(printf '%s\n' "$stats_line" | awk '{ if ($2 ~ /^[0-9]+$/) s+=$2 } END { print s+0 }')"
    elif [[ -f "$file_path" ]] && ! git cat-file -e "HEAD:$file_path" >/dev/null 2>&1; then
      added="$(wc -l < "$file_path" | tr -d ' ')"
      removed="0"
    fi

    printf '%s\t%s\t%s\n' "$file_path" "$added" "$removed" >> "$COMMIT_STATS_FILE"
  done
}

collect_commit_candidate_files() {
  local status_tmp
  local record=""
  local status=""
  local path=""
  local old_path=""
  local -a candidates=()

  status_tmp="$(mktemp)"

  if ! git status --porcelain -z >"$status_tmp" 2>/dev/null; then
    rm -f "$status_tmp"
    bt_error_exit "$EXIT_WORKTREE_INSPECTION_FAILED" "Failed to inspect working tree status"
  fi

  exec 3<"$status_tmp"

  while IFS= read -r -d '' record <&3; do
    [[ ${#record} -ge 3 ]] || continue
    status="${record:0:2}"
    path="${record:3}"

    # For porcelain -z rename/copy entries, the next NUL field is the source path.
    if [[ "${status:0:1}" == "R" || "${status:1:1}" == "R" ]]; then
      IFS= read -r -d '' old_path <&3 || old_path=""
      [[ -n "$old_path" ]] && candidates+=("$old_path")
      [[ -n "$path" ]] && candidates+=("$path")
    elif [[ "${status:0:1}" == "C" || "${status:1:1}" == "C" ]]; then
      IFS= read -r -d '' old_path <&3 || true
      [[ -n "$path" ]] && candidates+=("$path")
    else
      [[ -n "$path" ]] && candidates+=("$path")
    fi
  done
  exec 3<&-
  rm -f "$status_tmp"

  if [[ ${#candidates[@]} -eq 0 ]]; then
    COMMIT_FILE_LIST=""
  else
    COMMIT_FILE_LIST="$(printf '%s\n' "${candidates[@]}" | sed '/^$/d' | sort -u)"
  fi
}

print_commit_file_details() {
  local heading="$1"
  local status_label="${2:-commit}"

  [[ -n "$COMMIT_FILE_LIST" ]] || return 0

  bt_info "$heading"
  printf '%s\n' "$COMMIT_FILE_LIST" | while IFS= read -r file_path; do
    [[ -n "$file_path" ]] || continue
    bt_info "  - $file_path [$status_label]"
  done
}

collect_unpushed_commits() {
  local branch="$1"
  local count="0"
  local list=""

  if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    PUSH_RANGE="origin/$branch..$branch"
    count="$(git rev-list --count "origin/$branch..$branch" 2>/dev/null || echo 0)"
    list="$(git rev-list --oneline --reverse "origin/$branch..$branch" 2>/dev/null || true)"
  else
    PUSH_RANGE="$branch"
    count="$(git rev-list --count "$branch" 2>/dev/null || echo 0)"
    list="$(git rev-list --oneline --reverse "$branch" 2>/dev/null || true)"
  fi

  if [[ ! "$count" =~ ^[0-9]+$ ]]; then
    count=0
  fi

  PUSHED_COMMITS="$count"
  PUSH_COMMIT_LIST="$list"
}

collect_remote_behind_commits() {
  local branch="$1"
  local count="0"

  if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    count="$(git rev-list --count "$branch..origin/$branch" 2>/dev/null || echo 0)"
  fi

  if [[ ! "$count" =~ ^[0-9]+$ ]]; then
    count=0
  fi

  BEHIND_COMMITS="$count"
}

auto_resolve_divergence_if_safe() {
  local branch="$1"
  local history_status=0

  if [[ "$DRY_RUN" == true ]]; then
    bt_error_exit "$EXIT_BRANCH_DIVERGED" "Local and remote branch '$branch' have diverged. Dry run cannot perform auto-resolution. Run without -d to auto-resolve or run 'mrgbranch' manually."
  fi

  if [[ "$VERBOSE" == true ]]; then
    bt_info "Divergence detected; attempting automatic rebase onto origin/$branch"
  fi

  if ! git fetch origin "$branch" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_REMOTE_UNREACHABLE" "Unable to connect to remote. Verify remote access/network and retry."
  fi

  # Propagate repository history from remote if available
  bt_propagate_repository_history || history_status=$?
  case "$history_status" in
    0) ;;
    1) bt_info "Updated repository history from remote" ;;
    *) ;;
  esac

  if git rebase "origin/$branch" >/dev/null 2>&1; then
    DIVERGENCE_AUTO_RESOLVED=true
    bt_info "Divergence auto-resolved; review resolved code before sharing"
    return 0
  fi

  git rebase --abort >/dev/null 2>&1 || true
  bt_error_exit "$EXIT_BRANCH_DIVERGED" "Local and remote branch '$branch' have diverged and could not be auto-resolved cleanly. Run 'mrgbranch', resolve conflicts, then rerun commit."
}
collect_prepush_file_stats() {
  : > "$PREPUSH_STATS_FILE"
  : > "$PREPUSH_NOTES_FILE"

  if [[ -z "$PRE_PUSH_RANGE" || "$PRE_PUSHED_COMMITS" -eq 0 ]]; then
    return 0
  fi

  git log --numstat --format='' "$PRE_PUSH_RANGE" 2>/dev/null | \
    awk '
      NF == 3 {
        a = ($1 ~ /^[0-9]+$/) ? $1 : 0
        r = ($2 ~ /^[0-9]+$/) ? $2 : 0
        f = $3
        add[f] += a
        rem[f] += r
      }
      END {
        for (f in add) {
          printf "%s\t%d\t%d\n", f, add[f], rem[f]
        }
      }
    ' | sort > "$PREPUSH_STATS_FILE"

  # Build per-file push-only summary notes from how many pending commits touched
  # each file in the push set.
  git log --name-only --format='' "$PRE_PUSH_RANGE" 2>/dev/null | \
    awk '
      NF > 0 {
        count[$0] += 1
      }
      END {
        for (f in count) {
          printf "%s\t%d\n", f, count[f]
        }
      }
    ' | sort > "$PREPUSH_NOTES_FILE"
}

format_command_line() {
  local formatted="commit"
  local arg

  for arg in "${ORIGINAL_ARGS[@]}"; do
    printf -v formatted '%s %q' "$formatted" "$arg"
  done

  printf '%s\n' "$formatted"
}

get_stats_for_file() {
  local file_path="$1"
  local stats_file="$2"

  local stats_line
  stats_line="$(awk -F '\t' -v f="$file_path" '$1 == f { print $0; exit }' "$stats_file" 2>/dev/null || true)"
  if [[ -z "$stats_line" ]]; then
    printf '0\t0\n'
    return 0
  fi

  printf '%s\n' "$stats_line" | awk -F '\t' '{ printf "%s\t%s\n", $2, $3 }'
}

write_commit_report_row() {
  local file_path="$1"
  local commit_hash="$2"
  local added="$3"
  local removed="$4"
  local total_lines="$5"
  local notes="$6"
  local out_file="${7:-$REPORT_FILE}"
  local net

  net=$((added - removed))
  printf '| %s | %s | %s | %s | %+d | %s | %s |\n' \
    "$file_path" "$commit_hash" "$added" "$removed" "$net" "$total_lines" "$notes" >> "$out_file"
}

write_push_report_row() {
  local file_path="$1"
  local added="$2"
  local removed="$3"
  local total_lines="$4"
  local notes="$5"
  local out_file="${6:-$REPORT_FILE}"
  local net

  net=$((added - removed))
  printf '| %s | %s | %s | %+d | %s | %s |\n' \
    "$file_path" "$added" "$removed" "$net" "$total_lines" "$notes" >> "$out_file"
}

append_commit_table_header() {
  cat >> "$REPORT_FILE" <<'EOF'
| **File** | **Commit Hash** | **Added** | **Deleted** | **Net** | **Total** | **Notes** |
| --- | --- | --- | --- | --- | --- | --- |
EOF
}

append_push_table_header() {
  cat >> "$REPORT_FILE" <<'EOF'
| **File** | **Added** | **Deleted** | **Net** | **Total** | **Notes** |
| --- | --- | --- | --- | --- | --- |
EOF
}

get_total_lines_for_file() {
  local file_path="$1"

  if [[ -f "$file_path" ]]; then
    wc -l < "$file_path" | tr -d ' '
  else
    printf ''
  fi
}

build_commit_note() {
  local file_path="$1"
  local added="$2"
  local removed="$3"
  local change_text
  local scope_text

  if [[ "$added" -gt 0 && "$removed" -eq 0 ]]; then
    change_text="Added new content"
  elif [[ "$added" -eq 0 && "$removed" -gt 0 ]]; then
    change_text="Removed existing content"
  else
    change_text="Updated existing content"
  fi

  case "$file_path" in
    *.md)
      scope_text="documentation"
      ;;
    scripts/bin/* | scripts/helpers/* | *.sh)
      scope_text="script logic"
      ;;
    src/*.[ch] | include/*.[ch])
      scope_text="C source implementation"
      ;;
    *)
      scope_text="file content"
      ;;
  esac

  printf '%s in %s\n' "$change_text" "$scope_text"
}

get_prepush_note_for_file() {
  local file_path="$1"
  local added="$2"
  local removed="$3"
  local note_line
  local pending_count
  local summary

  note_line="$(awk -F '\t' -v f="$file_path" '$1 == f { print $2; exit }' "$PREPUSH_NOTES_FILE" 2>/dev/null || true)"
  if [[ -n "$note_line" ]]; then
    pending_count="$note_line"
    summary="$(build_commit_note "$file_path" "$added" "$removed")"
    if [[ "$pending_count" -eq 1 ]]; then
      printf '%s\n' "$summary"
    else
      printf '%s (commits %s)\n' "$summary" "$pending_count"
    fi
  else
    printf '%s\n' "$(build_commit_note "$file_path" "$added" "$removed")"
  fi
}

get_push_commit_summary() {
  local summary=""

  if [[ "$PUSH" != true ]]; then
    printf '%s' ""
    return 0
  fi

  if [[ "$NEEDS_COMMIT" == true && "$DRY_RUN" == false ]]; then
    summary="$(git log --oneline -1 2>/dev/null || true)"
  elif [[ -n "$PRE_PUSH_COMMIT_LIST" ]]; then
    summary="$(printf '%s\n' "$PRE_PUSH_COMMIT_LIST" | sed -n '1p')"
  fi

  printf '%s' "$summary"
}

append_divergence_section() {
  [[ "$DIVERGENCE_AUTO_RESOLVED" == true ]] || return 0

  cat >> "$REPORT_FILE" <<EOF

## Divergence Handling

- Status: Local and remote histories diverged and were auto-resolved.
- Method: Rebased local branch onto origin/${CURRENT_BRANCH}.
- Guidance: Review resolved code and rerun tests before sharing.
EOF
}

generate_commit_report() {
  local command_text
  command_text="$(format_command_line)"
  local report_title="Commit Report"

  local committed_only=0
  local pushed_only=0
  local committed_and_pushed=0
  local total_rows=0
  local commit_hash=""
  local push_commit_hash=""
  local push_commit_comment=""

  enable_branch_reports_write_access

  if [[ "$NEEDS_COMMIT" == true && "$DRY_RUN" == false ]]; then
    commit_hash="$(git rev-parse --short HEAD 2>/dev/null || true)"
  elif [[ "$NEEDS_COMMIT" == true && "$DRY_RUN" == true ]]; then
    commit_hash=""
  fi

  if [[ -f "$REPORT_FILE" ]]; then
    # Dry-run reports reuse second-resolution names; allow overwrite within
    # the same second even when a prior run made the file read-only.
    chmod u+w "$REPORT_FILE" 2>/dev/null || true
  fi

  cat > "$REPORT_FILE" <<EOF
# ${report_title} ${RUN_TS_DISPLAY}

**Command:** \`${command_text}\`

**Branch:** \`${CURRENT_BRANCH}\`

__PUSH_SUMMARY_LINE__

__SUMMARY_LINE_1__
__SUMMARY_LINE_2__
__SUMMARY_LINE_3__
__SUMMARY_LINE_4__
EOF

  # Track commit-file names to avoid duplicate push-only rows.
  local commit_files_tmp
  local commit_only_rows_tmp
  local commit_push_rows_tmp
  local push_rows_tmp
  commit_files_tmp="$(mktemp)"
  commit_only_rows_tmp="$(mktemp)"
  commit_push_rows_tmp="$(mktemp)"
  push_rows_tmp="$(mktemp)"

  if [[ -n "$COMMIT_FILE_LIST" ]]; then
    printf '%s\n' "$COMMIT_FILE_LIST" > "$commit_files_tmp"
  fi

  if [[ "$NEEDS_COMMIT" == true ]]; then

    printf '%s\n' "$COMMIT_FILE_LIST" | while IFS= read -r file_path; do
      [[ -n "$file_path" ]] || continue
      local stats
      stats="$(get_stats_for_file "$file_path" "$COMMIT_STATS_FILE")"
      local added removed
      added="${stats%%$'\t'*}"
      removed="${stats#*$'\t'}"
      local total_lines
      total_lines="$(get_total_lines_for_file "$file_path")"
      local commit_notes
      commit_notes="$(build_commit_note "$file_path" "$added" "$removed")"
      commit_notes="${commit_notes//|/\\|}"
      if [[ "$PUSH" == true ]]; then
        write_commit_report_row "$file_path" "$commit_hash" "$added" "$removed" "$total_lines" "$commit_notes" "$commit_push_rows_tmp"
      else
        write_commit_report_row "$file_path" "$commit_hash" "$added" "$removed" "$total_lines" "$commit_notes" "$commit_only_rows_tmp"
      fi
    done

    if [[ "$PUSH" == true ]]; then
      committed_and_pushed="$COMMITTED_FILES"
    else
      committed_only="$COMMITTED_FILES"
    fi
  fi

  if [[ "$PRE_PUSHED_COMMITS" -gt 0 ]]; then
    while IFS=$'\t' read -r file_path added removed; do
      [[ -n "$file_path" ]] || continue
      if [[ -f "$commit_files_tmp" ]] && grep -Fxq "$file_path" "$commit_files_tmp"; then
        continue
      fi
      local total_lines
      total_lines="$(get_total_lines_for_file "$file_path")"
      local push_notes
      push_notes="$(get_prepush_note_for_file "$file_path" "$added" "$removed")"
      push_notes="${push_notes//|/\\|}"
      write_push_report_row "$file_path" "$added" "$removed" "$total_lines" "$push_notes" "$push_rows_tmp"
      pushed_only=$((pushed_only + 1))
    done < "$PREPUSH_STATS_FILE"
  fi

  if [[ "$committed_only" -gt 0 ]]; then
    printf '\n## Commit\n\n' >> "$REPORT_FILE"
    append_commit_table_header
    cat "$commit_only_rows_tmp" >> "$REPORT_FILE"
  fi

  if [[ "$committed_and_pushed" -gt 0 ]]; then
    printf '\n## Commit/Push\n\n' >> "$REPORT_FILE"
    append_commit_table_header
    cat "$commit_push_rows_tmp" >> "$REPORT_FILE"
  fi

  if [[ "$pushed_only" -gt 0 ]]; then
    printf '\n## Push\n\n' >> "$REPORT_FILE"
    append_push_table_header
    cat "$push_rows_tmp" >> "$REPORT_FILE"
  fi

  total_rows=$((committed_only + pushed_only + committed_and_pushed))

  push_commit_summary="$(get_push_commit_summary)"
  if [[ -n "$push_commit_summary" ]]; then
    push_commit_hash="${push_commit_summary%% *}"
    if [[ "$push_commit_summary" == *" "* ]]; then
      push_commit_comment="${push_commit_summary#* }"
    fi

    if [[ "$DID_PUSH_REMOTE" == true ]]; then
      push_commit_summary="**Pushed Commit Hash:** $push_commit_hash"
    else
      push_commit_summary="**Commit Selected for Push Hash:** $push_commit_hash"
    fi

    if [[ -n "$push_commit_comment" ]]; then
      # Use a hard line break so markdown renderers keep these on separate lines.
      push_commit_summary="${push_commit_summary}  
**Commit Comment:** $push_commit_comment"
    fi
  fi

  # shellcheck disable=SC2016
  awk -v cp="$committed_and_pushed" -v c="$committed_only" -v p="$pushed_only" -v t="$total_rows" -v push_commit_summary="$push_commit_summary" '
    /^__PUSH_SUMMARY_LINE__$/ {
      if (push_commit_summary != "") {
        print push_commit_summary
      }
      next
    }
    /^__SUMMARY_LINE_1__$/ { print "**Commit/Push:** " cp "<br>"; next }
    /^__SUMMARY_LINE_2__$/ { print "**Commit:** " c "<br>"; next }
    /^__SUMMARY_LINE_3__$/ { print "**Push:** " p "<br>"; next }
    /^__SUMMARY_LINE_4__$/ { print "**Total:** " t; next }
    { print }
  ' "$REPORT_FILE" > "$REPORT_FILE.tmp" && mv "$REPORT_FILE.tmp" "$REPORT_FILE"
  append_divergence_section

  cleanup_old_dry_run_reports
  mark_report_read_only "$REPORT_FILE"

  rm -f "$commit_files_tmp" "$commit_only_rows_tmp" "$commit_push_rows_tmp" "$push_rows_tmp"
}

print_push_commit_details() {
  local heading="$1"
  local status_label="${2:-push}"

  [[ -n "$PUSH_COMMIT_LIST" ]] || return 0

  bt_info "$heading"
  printf '%s\n' "$PUSH_COMMIT_LIST" | while IFS= read -r commit_line; do
    [[ -n "$commit_line" ]] || continue
    bt_info "  - $commit_line [$status_label]"
  done
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -c)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -c requires a comment token"
      fi
      if [[ -n "$COMMIT_COMMENT" ]]; then
        usage_error "Cannot use both -c and -- for comment"
      fi
      COMMIT_COMMENT="$2"
      shift 2
      ;;
    -d)
      DRY_RUN=true
      shift
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    --)
      # '-- TOKEN...': the tokens after '--' are the comment
      shift
      if [[ -n "$COMMIT_COMMENT" ]]; then
        usage_error "Cannot use both -c and -- for the commit comment"
      fi
      if [[ $# -eq 0 ]]; then
        usage_error "Option -- requires one or more tokens for the commit comment"
      fi
      COMMIT_COMMENT="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      usage_error "Unexpected argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit "$EXIT_NOT_ON_BRANCH" "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"
initialize_report_file

# Disallow commits from detached HEAD (for example, origin/main or origin/v*).
if [[ "$CURRENT_BRANCH" == "HEAD" ]]; then
  bt_error_exit 3 \
    "Not on a local working branch. Use 'chbranch' to switch to a local non-protected branch, then retry."
fi

# Commit script operates on a local branch only.
if ! git show-ref --verify --quiet "refs/heads/$CURRENT_BRANCH"; then
  bt_error_exit "$EXIT_NOT_ON_LOCAL_BRANCH" "Not on a local branch. Use 'chbranch' to switch to a local non-protected branch, then retry."
fi

if [[ ! -f "$CONTRIBUTORS_FILE" ]]; then
  bt_error_exit "$EXIT_CONFIG_NOT_FOUND" "Configuration file not found: $CONTRIBUTORS_FILE"
fi

ACTOR_LOGIN="$(bt_require_login || true)"
if [[ -z "$ACTOR_LOGIN" ]]; then
  bt_error_exit "$EXIT_LOGIN_UNKNOWN" "Unable to determine GitHub login identity for permission check"
fi

if ! is_contributor_or_higher "$ACTOR_LOGIN"; then
  bt_error_exit "$EXIT_NOT_AUTHORIZED" "User '$ACTOR_LOGIN' is not authorized to run commit (requires contributor role or higher)"
fi

# Check if branch is protected
if bt_is_protected_branch "$CURRENT_BRANCH"; then
  bt_error_exit 5 \
    "Current branch '$CURRENT_BRANCH' is protected. Use 'chbranch' to switch to a non-protected local branch, then retry."
fi

# Automatic push is enabled only when origin is connected and a
# corresponding remote branch exists.
if is_remote_connected &&
  git show-ref --verify --quiet "refs/remotes/origin/$CURRENT_BRANCH"; then
  PUSH=true
else
  PUSH=false
fi

# Determine commit candidates before validating comment so push-only mode works
# without requiring '-c TOKEN' or '-- TOKEN...'
collect_commit_candidate_files
if [[ -n "$COMMIT_FILE_LIST" ]]; then
  NEEDS_COMMIT=true
  COMMITTED_FILES="$(printf '%s\n' "$COMMIT_FILE_LIST" | wc -l | tr -d ' ')"
  collect_commit_file_stats
else
  NEEDS_COMMIT=false
  COMMITTED_FILES=0
fi

# Capture pre-run unpushed commits before any commit in this run.
if [[ "$PUSH" == true ]]; then
  collect_unpushed_commits "$CURRENT_BRANCH"
  PRE_PUSHED_COMMITS="$PUSHED_COMMITS"
  PRE_PUSH_COMMIT_LIST="$PUSH_COMMIT_LIST"
  PRE_PUSH_RANGE="$PUSH_RANGE"
  collect_prepush_file_stats
fi

# Validate commit comment only when a commit is actually needed.
if [[ "$NEEDS_COMMIT" == true ]]; then
  if [[ -z "$COMMIT_COMMENT" ]]; then
    bt_error_exit "$EXIT_COMMENT_REQUIRED" "Commit comment is required (-c TOKEN or -- TOKENS) when there are changes to commit"
  fi

  COMMIT_COMMENT_TRIMMED="$COMMIT_COMMENT"
  COMMIT_COMMENT_TRIMMED="${COMMIT_COMMENT_TRIMMED#"${COMMIT_COMMENT_TRIMMED%%[![:space:]]*}"}"
  COMMIT_COMMENT_TRIMMED="${COMMIT_COMMENT_TRIMMED%"${COMMIT_COMMENT_TRIMMED##*[![:space:]]}"}"
  if [[ -z "$COMMIT_COMMENT_TRIMMED" ]]; then
    bt_error_exit "$EXIT_COMMENT_EMPTY" "Commit comment must include at least one non-whitespace character when there are changes to commit"
  fi
fi

# Commit flow
if [[ "$NEEDS_COMMIT" == true ]]; then
  if [[ "$DRY_RUN" == true ]]; then
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Dry run: would create commit with $COMMITTED_FILES file(s)"
      if [[ "$PUSH" == true ]]; then
        print_commit_file_details "Files that would be committed:" "commit+push"
      else
        print_commit_file_details "Files that would be committed:" "commit"
      fi
    fi
  else
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Preparing for commit..."
    fi
    if ! run_git_command env GIT_BYPASS_HOOKS=true git add --all; then
      fail_commit_and_exit
    fi
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Prepared for commit"
    fi

    if [[ "$VERBOSE" == true ]]; then
      bt_info "Creating commit..."
    fi
    if ! run_git_command env GIT_BYPASS_HOOKS=true git commit -m "$COMMIT_COMMENT"; then
      fail_commit_and_exit
    fi
    if [[ "$VERBOSE" == true ]]; then
      bt_success "Commit created: $COMMIT_COMMENT"
      if [[ "$PUSH" == true ]]; then
        print_commit_file_details "Committed files:" "commit+push"
      else
        print_commit_file_details "Committed files:" "commit"
      fi
    fi
  fi
else
  if [[ "$VERBOSE" == true ]]; then
    bt_info "No changes to commit"
  fi
fi

# Automatic push when eligible
if [[ "$PUSH" == true ]]; then
  collect_unpushed_commits "$CURRENT_BRANCH"

  # In dry-run mode, if a commit would be created, include that hypothetical
  # commit in push totals and output.
  if [[ "$DRY_RUN" == true && "$NEEDS_COMMIT" == true ]]; then
    PUSHED_COMMITS=$((PUSHED_COMMITS + 1))
  fi

  collect_remote_behind_commits "$CURRENT_BRANCH"
  if [[ "$BEHIND_COMMITS" -gt 0 && "$PUSHED_COMMITS" -gt 0 ]]; then
    auto_resolve_divergence_if_safe "$CURRENT_BRANCH"
    collect_unpushed_commits "$CURRENT_BRANCH"
    collect_remote_behind_commits "$CURRENT_BRANCH"
    if [[ "$BEHIND_COMMITS" -gt 0 && "$PUSHED_COMMITS" -gt 0 ]]; then
      bt_error_exit "$EXIT_BRANCH_DIVERGED" "Local and remote branch '$CURRENT_BRANCH' still appear diverged after auto-resolution. Run 'mrgbranch', resolve conflicts, then rerun commit."
    fi
  fi

  if [[ "$PUSHED_COMMITS" -eq 0 ]]; then
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Nothing to push"
    fi
  else
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Ready to push $PUSHED_COMMITS commit(s) to remote"
    fi

    if [[ "$NEEDS_COMMIT" == false && "$PRE_PUSHED_COMMITS" -gt 0 ]]; then
      PUSH_COMMIT_LIST="$PRE_PUSH_COMMIT_LIST"
      if [[ "$VERBOSE" == true ]]; then
        print_push_commit_details "Previously committed changes selected for push:" "push-only"
      fi
    elif [[ "$PRE_PUSHED_COMMITS" -gt 0 ]]; then
      PUSH_COMMIT_LIST="$PRE_PUSH_COMMIT_LIST"
      if [[ "$VERBOSE" == true ]]; then
        print_push_commit_details "Previously committed changes pending push:" "push-only"
      fi
    fi

    if [[ "$NEEDS_COMMIT" == true && "$DRY_RUN" == true ]]; then
      if [[ "$VERBOSE" == true ]]; then
        if [[ "$PRE_PUSHED_COMMITS" -gt 0 ]]; then
          bt_info "This run would add one new commit to the push set:"
        else
          bt_info "This run would push one new commit from current changes:"
        fi
        bt_info "  - <new commit from current working changes> [push]"
      fi
    elif [[ "$NEEDS_COMMIT" == true ]]; then
      # Show the full selected push set after listing previously pending commits.
      collect_unpushed_commits "$CURRENT_BRANCH"
      if [[ "$VERBOSE" == true ]]; then
        print_push_commit_details "Commits selected for push (including this run):" "push"
      fi
    else
      if [[ "$VERBOSE" == true ]]; then
        print_push_commit_details "Commits selected for push:" "push"
      fi
    fi

    if [[ "$VERBOSE" == true ]]; then
      bt_info "Pushing branch '$CURRENT_BRANCH' to remote..."
    fi

    # Push changes
    if [[ "$DRY_RUN" == true ]]; then
      if [[ "$VERBOSE" == true ]]; then
        bt_info "Dry run: would push $PUSHED_COMMITS commit(s)"
      fi
    else
      if ! run_git_command env GIT_BYPASS_HOOKS=true git push origin "$CURRENT_BRANCH"; then
        bt_error_exit "$EXIT_PUSH_FAILED" "Failed to push to remote. Verify remote access and network, then retry."
      fi
      DID_PUSH_REMOTE=true
      if [[ "$VERBOSE" == true ]]; then
        bt_success "Pushed to remote"
      fi
    fi
  fi
fi

if [[ "$VERBOSE" == true && ( "$COMMITTED_FILES" -gt 0 || "$PUSHED_COMMITS" -gt 0 ) ]]; then
  print_summary
fi
if [[ "$COMMITTED_FILES" -gt 0 || "$PUSHED_COMMITS" -gt 0 ]]; then
  generate_commit_report
  
  # Non-dry-run reports are copied to remote so both local and remote
  # have the same reports for audit trail continuity.
  if [[ "$DRY_RUN" == false ]] && is_remote_connected; then
    bt_report_copy_to_remote "$REPO_ROOT" "$BRANCH_REPORTS_DIR" "commit*.md" || true
  fi
  
  disable_branch_reports_write_access
  if [[ "$DRY_RUN" == true ]]; then
    emit_final_status "Commit/Push: ${COMMITTED_FILES}. Dry-run" true
  elif [[ "$COMMITTED_FILES" -gt 0 && "$PUSHED_COMMITS" -gt 0 ]]; then
    emit_final_status "Commit/Push: ${COMMITTED_FILES}" true
  elif [[ "$COMMITTED_FILES" -eq 0 && "$PUSHED_COMMITS" -gt 0 ]]; then
    emit_final_status "Push: ${PUSHED_COMMITS}" true
  else
    emit_final_status "Commit: ${COMMITTED_FILES}" true
  fi
else
  emit_final_status "No commits or pushes" false
fi
exit 0
