#!/usr/bin/env bash

# merge - Merge a branch to its parent branch with validation.
#
# See usage below for details, or run: merge -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  merge [OPTIONS]
  merge -h | --help

Merge the current branch to its parent branch.

Requirements:
  - Current branch must be a targeted or contributor branch
  - Parent branch must be a valid version or main branch
  - An open PR must exist for the current branch
  - All status checks must pass
  - If parent is protected, current user must be an approver

Options:
  -h, --help         Output this help to stdout and exit (other options
                     and arguments are ignored).
  -m, --message MSG  Custom commit message for merge (GitHub style,
                     requires quotes if spaces). If not specified,
                     uses the PR title.
  -v, --verbose      Show detailed progress information.

Examples:
  # Merge current branch using PR title as commit message
  merge

  # Merge with custom commit message
  merge -m "Custom merge message"

  # Merge with verbose output
  merge -v


Outputs:
  - Writes help text, status messages, and results to stdout.
  - Writes errors and diagnostics to stderr.
  - Logs merge to logs/remote_branch_history.md.

Exit codes:
  0  Success
  1  Argument or validation error
  2  Git operation failed
  3  Insufficient permissions (not an approver)
  4  PR or status checks failed
  5  Merge validation failed
EOF
}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Ensure Git hooks are installed
ensure_hooks_installed

# Default options
CUSTOM_MESSAGE=""
VERBOSE=false

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -m requires a message argument"
      fi
      CUSTOM_MESSAGE="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    *)
      bt_error_exit 1 "Unknown option: $1"
      ;;
  esac
done

# Get current branch and user
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit 2 "Failed to determine current branch")
CURRENT_USER="$(git config user.name 2>/dev/null || true)"

if [[ -z "$CURRENT_USER" ]]; then
  bt_error_exit 1 "Failed to determine current user from git config"
fi

bt_info "Current branch: $CURRENT_BRANCH"
bt_info "Current user: $CURRENT_USER"

# Get parent branch
PARENT_BRANCH=$(bt_get_parent_branch "$CURRENT_BRANCH" || \
  bt_error_exit 5 "Failed to determine parent branch")
bt_info "Parent branch: $PARENT_BRANCH"

# Check if parent is protected
if bt_is_protected_branch "$PARENT_BRANCH"; then
  # Verify current user is an approver
  if ! is_approver "$CURRENT_USER"; then
    bt_error_exit 3 "User '$CURRENT_USER' is not an approver. Only approvers can merge to protected branches."
  fi
  bt_success "User '$CURRENT_USER' is an approver"
else
  bt_info "Parent branch is not protected"
fi

# Find associated PR
PR_NUMBER=$(get_existing_pr_number "$CURRENT_BRANCH")
if [[ -z "$PR_NUMBER" ]]; then
  bt_error_exit 5 "No open PR found for branch '$CURRENT_BRANCH'"
fi
bt_info "Found PR #$PR_NUMBER"

# Check status checks pass
check_status_checks "$PR_NUMBER"

# Determine commit message
if [[ -n "$CUSTOM_MESSAGE" ]]; then
  COMMIT_MESSAGE="$CUSTOM_MESSAGE"
  bt_info "Using custom message: $COMMIT_MESSAGE"
else
  COMMIT_MESSAGE=$(get_pr_title "$PR_NUMBER")
  if [[ -z "$COMMIT_MESSAGE" ]]; then
    bt_error_exit 4 "Failed to get PR title"
  fi
  bt_info "Using PR title as message: $COMMIT_MESSAGE"
fi

# Perform squash merge
bt_info "Performing squash merge..."
git fetch origin 2>/dev/null || bt_warn "Failed to fetch from origin"

if git show-ref --verify --quiet "refs/heads/$PARENT_BRANCH"; then
  if ! git checkout "$PARENT_BRANCH" >/dev/null 2>&1; then
    bt_error_exit 2 "Failed to check out parent branch '$PARENT_BRANCH'"
  fi
else
  if ! git checkout -b "$PARENT_BRANCH" "origin/$PARENT_BRANCH" >/dev/null 2>&1; then
    bt_error_exit 2 "Failed to create local parent branch '$PARENT_BRANCH'"
  fi
fi

if ! git pull --ff-only origin "$PARENT_BRANCH" 2>&1; then
  bt_error_exit 2 "Failed to fast-forward parent branch '$PARENT_BRANCH'"
fi

# Use bypass for merge operation
export BRITETEST_BYPASS_HOOKS=true
if ! git merge --squash --no-commit "$CURRENT_BRANCH" 2>&1; then
  unset BRITETEST_BYPASS_HOOKS
  bt_error_exit 2 "Failed to squash merge '$CURRENT_BRANCH' into '$PARENT_BRANCH'"
fi
unset BRITETEST_BYPASS_HOOKS

# Log merge to history
log_merge_to_history "$CURRENT_BRANCH" "$PARENT_BRANCH" \
  "$CURRENT_USER" "$COMMIT_MESSAGE"

# Stage history file
export BRITETEST_BYPASS_HOOKS=true
git add logs/remote_branch_history.md 2>/dev/null || true

# Create commit with message
if ! git commit -m "$COMMIT_MESSAGE" 2>&1; then
  unset BRITETEST_BYPASS_HOOKS
  bt_error_exit 2 "Failed to create commit"
fi
unset BRITETEST_BYPASS_HOOKS

# Push to remote
bt_info "Pushing parent branch..."
export BRITETEST_BYPASS_HOOKS=true
if ! git push origin "$PARENT_BRANCH" 2>&1; then
  unset BRITETEST_BYPASS_HOOKS
  bt_error_exit 2 "Failed to push parent branch"
fi
unset BRITETEST_BYPASS_HOOKS

if ! git checkout "$CURRENT_BRANCH" >/dev/null 2>&1; then
  bt_warn "Merged successfully, but failed to switch back to '$CURRENT_BRANCH'"
fi

# Show verbose output if requested
if [[ "$VERBOSE" == true ]]; then
  bt_info "Merge details:"
  echo "  Branch: $CURRENT_BRANCH"
  echo "  Parent: $PARENT_BRANCH"
  echo "  Approver: $CURRENT_USER"
  echo "  PR: #$PR_NUMBER"
  echo "  Message: $COMMIT_MESSAGE"
fi

bt_success "Branch '$CURRENT_BRANCH' merged to '$PARENT_BRANCH'"
bt_success "Done"
exit 0
