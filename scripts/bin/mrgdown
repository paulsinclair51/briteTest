#!/usr/bin/env bash

# mrgdown - Merge parent branch into current branch.
#
# See usage below for details, or run: mrgdown -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  mrgdown [OPTIONS]
  mrgdown {-h | --help}

Merge the parent branch of the current branch into current branch
to sync up with latest changes.

Automatically determines the parent branch based on branch naming
and Git history (the branch that the current branch was created
from). Handles simple conflicts automatically and provides
instructions for complex ones.

Before merging:
  - The current branch must have no untracked or uncommitted changes.
  - If there are changes, use the commit or undo workflow first.

Protected branches (cannot run mrgdown):
  - main
  - v<M>.<m>.<p> version branches created from main.

Allowed branches (can use mrgdown):
  - Unprotected branches with an identified parent branch.

Features:
  - Automatically determines parent branch
  - Merges parent branch into current branch
  - Shows instructions for complex conflicts
  - Prompts for confirmation before merge and push
  - Optional force mode to skip confirmations

Options:
  -d                 Dry-run for the branch commit/push workflow. The script
                     does not create or push the primary code commit, but it
                     still generates the report and may delete stale dry-run
                     reports.
  -h                 Output this help to stdout and exit (other options
                     and arguments are ignored).
  --help             Output this help to stdout and exit (other options
                     and arguments are ignored).
  -o                 Owner override. Allows repository owner to run even
                     on version branches normally blocked by user policy
                     for this command run only; normal role restrictions
                     apply again after exit.
  -v                Show detailed merge information.

Example: Merge down.
  mrgdown

Example: Merge down with verbose output.
  mrgdown -v

Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - For a non-dry-run mrgup:
    - Writes an untracked report in the current branch to:
          <repo>/reports/branch/commit-<datetime>-<pid>.md
    - The report is copied (untracked) to the remote current branch
      so both local and remote have the same reports for audit
      trail continuity.
  - A dry-run report is written (untracked) to the current branch to: 
        <repo>/reports/branch/commit-d-<datetime>.md
  - Report files are made read-only after generation.

Exit codes:
    0   Success.
    1   Argument or validation error.
    2   Conflicts detected (user must resolve).
    3   Branch is protected (cannot sync up).
  200   Failed to determine parent branch.
  201   Git merge or push failed.
EOF
}

# High-Level Flow:
# - Brings parent-branch changes into the current branch using project sync-up
#   workflow.
# - Validates branch relationships and merge/rebase preconditions.
# - Reports integration outcomes and required follow-up actions.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BRANCH_REPORTS_DIR="$REPO_ROOT/reports/branch"
RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
REPORT_FILE=""
ORIGINAL_ARGS=("$@")
BRANCH_REPORTS_DIR_UNLOCKED=false

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"
# shellcheck source=helpers/report_sync.sh
source "$SCRIPT_DIR/../helpers/report_sync.sh"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_NOT_FOUND=2
readonly EXIT_OPERATION_FAILED=3
readonly EXIT_CONFIG_ERROR=4
readonly EXIT_INTERNAL_ERROR=100

cleanup_runtime_files() {
  # shellcheck disable=SC2317  # Invoked by trap cleanup_runtime_files EXIT.
  if [[ "$BRANCH_REPORTS_DIR_UNLOCKED" == true ]]; then
    bt_report_dir_disable_writes "$BRANCH_REPORTS_DIR" "$EXIT_CONFIG_ERROR" || true
    BRANCH_REPORTS_DIR_UNLOCKED=false
  fi
}

trap cleanup_runtime_files EXIT

enable_branch_reports_write_access() {
  bt_report_dir_enable_writes "$BRANCH_REPORTS_DIR" "$EXIT_CONFIG_ERROR"
  BRANCH_REPORTS_DIR_UNLOCKED=true
}

disable_branch_reports_write_access() {
  if [[ "$BRANCH_REPORTS_DIR_UNLOCKED" == true ]]; then
    bt_report_dir_disable_writes "$BRANCH_REPORTS_DIR" "$EXIT_CONFIG_ERROR"
    BRANCH_REPORTS_DIR_UNLOCKED=false
  fi
}

mark_report_read_only() {
  local report_path="$1"

  if ! chmod a-w "$report_path" 2>/dev/null; then
    bt_error_exit "$EXIT_CONFIG_ERROR" "Failed to mark report read-only: $report_path"
  fi
}

generate_merge_report() {
  local parent_branch="$1"
  local merge_message="$2"
  local merge_hash="$3"
  local commits_merged="$4"
  local command_text
  local push_summary_line

  command_text="$(format_command_line)"
  if [[ "$DID_PUSH_REMOTE" == true ]]; then
    push_summary_line="**Pushed Commit Hash:** ${merge_hash}"
  else
    push_summary_line="**Commit Selected for Push Hash:** ${merge_hash}"
  fi

  enable_branch_reports_write_access

  REPORT_FILE="$BRANCH_REPORTS_DIR/commit-${RUN_TS_FILE}-$$.md"

  cat > "$REPORT_FILE" <<EOF
# Commit Report ${RUN_TS_DISPLAY}

**Command:** \`${command_text}\`

**Branch:** \`${CURRENT_BRANCH}\`

${push_summary_line}

**Commit Comment:** ${merge_message}

**Commit/Push:** $([[ "$DID_PUSH_REMOTE" == true ]] && echo 1 || echo 0)<br>
**Commit:** $([[ "$DID_PUSH_REMOTE" == true ]] && echo 0 || echo 1)<br>
**Push:** $([[ "$DID_PUSH_REMOTE" == true ]] && echo 0 || echo 1)<br>
**Total:** 1

## Commit

| Branch | Parent Branch | Parent Commits Integrated | Merge Commit Hash |
| --- | --- | --- | --- |
| ${CURRENT_BRANCH} | ${parent_branch} | ${commits_merged} | ${merge_hash} |

## Merge Details

- **Status:** Parent branch merged into current branch.
- **Method:** Merge commit (`--no-ff`) created by mrgdown.
- **Guidance:** Review merged changes and run tests before sharing.

EOF

  mark_report_read_only "$REPORT_FILE"
  disable_branch_reports_write_access
}

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

ensure_trailing_period() {
  local message="$1"

  if [[ -z "$message" ]]; then
    printf '.'
    return 0
  fi

  if [[ "$message" == *"." ]]; then
    printf '%s' "$message"
  else
    printf '%s.' "$message"
  fi
}

bt_info() {
  echo "$(ensure_trailing_period "$1")"
}

bt_success() {
  echo "$(ensure_trailing_period "$1")"
}

bt_warn() {
  echo "$(ensure_trailing_period "$1")"
}

bt_error_exit() {
  local code="$1"
  local message="$2"

  echo "Error: $(ensure_trailing_period "$message")" >&2
  exit "$code"
}

format_command_line() {
  local formatted="mrgdown"
  local arg

  for arg in "${ORIGINAL_ARGS[@]}"; do
    printf -v formatted '%s %q' "$formatted" "$arg"
  done

  printf '%s\n' "$formatted"
}

# Default options
FORCE=false
VERBOSE=false
CUSTOM_MESSAGE=""
OWNER_OVERRIDE=false
OWNER_OVERRIDE_ACTIVE=false
DID_PUSH_REMOTE=false

ensure_clean_worktree() {
  if bt_is_worktree_dirty; then
    bt_error_exit "$EXIT_NOT_FOUND" "Current branch has uncommitted changes. Commit or undo them before running mrgdown"
  fi
}

auto_resolve_history_log_conflicts() {
  local conflicted_files="$1"
  local file=""
  local remaining_conflicts=""

  [[ -n "$conflicted_files" ]] || return 1

  # Only auto-resolve known mrgup/mrgdown history artifacts.
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    if [[ ! "$file" =~ ^logs/.+_history\.md$ ]]; then
      return 1
    fi
  done <<< "$conflicted_files"

  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    if ! git checkout --theirs -- "$file" >/dev/null 2>&1; then
      if ! git checkout --ours -- "$file" >/dev/null 2>&1; then
        return 1
      fi
    fi

    if ! git add "$file" >/dev/null 2>&1; then
      return 1
    fi
  done <<< "$conflicted_files"

  remaining_conflicts="$(git diff --name-only --diff-filter=U 2>/dev/null || true)"
  [[ -z "$remaining_conflicts" ]]
}

get_repository_owner_login() {
  local origin_url=""
  local owner=""

  origin_url="$(git remote get-url origin 2>/dev/null || true)"
  [[ -n "$origin_url" ]] || {
    echo ""
    return 0
  }

  if [[ "$origin_url" =~ ^git@github\.com:([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  elif [[ "$origin_url" =~ ^https://github\.com/([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  elif [[ "$origin_url" =~ ^ssh://git@github\.com/([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  fi

  owner="$(bt_normalize_login "$owner")"
  echo "$owner"
}

is_repository_owner() {
  local user_name="$1"
  local repo_owner=""

  repo_owner="$(get_repository_owner_login)"
  [[ -n "$repo_owner" ]] || return 1

  [[ "$(bt_normalize_login "$user_name")" == "$repo_owner" ]]
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -f | --force)
      FORCE=true
      shift
      ;;
    -o)
      OWNER_OVERRIDE=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -c | -m | --message)
      if [[ $# -lt 2 ]]; then
        usage_error "Option $1 requires a commit comment argument"
      fi
      if [[ -n "$CUSTOM_MESSAGE" ]]; then
        usage_error "Cannot use both single-token comment option and -- for commit comment"
      fi
      CUSTOM_MESSAGE="$2"
      shift 2
      ;;
    --)
      # '-- TOKEN...' commit comment
      shift
      if [[ -n "$CUSTOM_MESSAGE" ]]; then
        usage_error "Cannot use both single-token comment option and -- for commit comment."
      fi
      CUSTOM_MESSAGE="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      usage_error "Unknown argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit "$EXIT_NOT_FOUND" "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

if [[ "$OWNER_OVERRIDE" == true ]]; then
  CURRENT_USER="$(bt_require_login || true)"
  if [[ -z "$CURRENT_USER" ]]; then
    bt_error_exit "$EXIT_NOT_FOUND" "Option -o requires a resolvable GitHub login"
  fi
  if is_repository_owner "$CURRENT_USER"; then
    OWNER_OVERRIDE_ACTIVE=true
    bt_info "Owner override enabled for repository owner '$CURRENT_USER'"
  else
    bt_error_exit "$EXIT_CONFIG_ERROR" "Option -o is allowed only for the repository owner"
  fi
fi

# Check if branch is protected
if bt_is_protected_branch "$CURRENT_BRANCH"; then
  if [[ "$OWNER_OVERRIDE_ACTIVE" == true ]]; then
    bt_warn "Owner override enabled: allowing sync on protected branch '$CURRENT_BRANCH'"
  else
    bt_error_exit "$EXIT_CONFIG_ERROR" "Cannot sync up on protected branch '$CURRENT_BRANCH'." \
      "Use 'mrgup' to merge changes to this branch."
  fi
fi

# Determine parent branch
bt_info "Determining parent branch..."
PARENT_BRANCH=$(bt_resolve_parent_branch "$CURRENT_BRANCH" "main")
if [[ -z "$PARENT_BRANCH" ]]; then
  bt_error_exit "$EXIT_INTERNAL_ERROR" "Failed to determine parent branch"
fi
bt_info "Parent branch: $PARENT_BRANCH"

ensure_clean_worktree

# Ensure parent branch exists and is up to date
bt_info "Fetching latest from remote..."
if ! git fetch origin "$PARENT_BRANCH" >/dev/null 2>&1; then
  bt_error_exit "$EXIT_NOT_FOUND" "Failed to fetch parent branch '$PARENT_BRANCH' from remote"
fi

# Propagate repository history from remote if available
history_sync_rc=0
bt_propagate_repository_history || history_sync_rc=$?
case "$history_sync_rc" in
  0) ;;
  1) bt_info "Updated repository history from remote" ;;
  *) ;;
esac

# Count commits from parent branch to current branch
commits_to_merge=""
commits_to_merge=$(git rev-list --count "HEAD..origin/$PARENT_BRANCH" \
  2>/dev/null || echo "0")

if [[ "$commits_to_merge" == "0" ]]; then
  bt_success "Already up to date with $PARENT_BRANCH"
  exit 0
fi

bt_info "Commits to merge: $commits_to_merge"

# Determine merge message
if [[ -z "$CUSTOM_MESSAGE" ]]; then
  MERGE_MESSAGE="Merge $PARENT_BRANCH into $CURRENT_BRANCH"
else
  MERGE_MESSAGE="$CUSTOM_MESSAGE"
fi

# Ask for confirmation before merge (unless force)
if [[ "$FORCE" == false ]]; then
  echo -n "Create merge commit? (y/n): "
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    bt_warn "Merge cancelled"
    exit 0
  fi
fi

# Perform merge without auto-commit so hooks cannot block the merge commit path.
bt_info "Merging $PARENT_BRANCH into $CURRENT_BRANCH..."
if ! git merge --no-commit --no-ff "origin/$PARENT_BRANCH" >/dev/null 2>&1; then
  # Check if merge failed due to conflicts
  conflicted_files=$(git diff --name-only --diff-filter=U)
  if [[ -n "$conflicted_files" ]]; then
    if auto_resolve_history_log_conflicts "$conflicted_files"; then
      bt_warn "Auto-resolved history log conflicts from parent branch"
    else
    bt_warn "Merge conflicts detected"
    bt_info "Complex conflicts require manual resolution"
    bt_info "Conflicted files:"
    while IFS= read -r file; do
      [[ -n "$file" ]] && echo "  $file"
    done <<< "$conflicted_files"
    bt_info "Steps to resolve:"
    echo "  1. Edit conflicted files to resolve conflicts"
    echo "  2. Stage resolved files: git add <files>"
    echo "  3. Complete merge: git commit"
    bt_error_exit "$EXIT_OPERATION_FAILED" "Merge stopped - manual conflict resolution needed"
    fi
  else
    bt_error_exit "$EXIT_NOT_FOUND" "Failed to merge $PARENT_BRANCH into $CURRENT_BRANCH"
  fi
fi

if ! GIT_BYPASS_HOOKS=true git commit -m "$MERGE_MESSAGE" >/dev/null 2>&1; then
  bt_error_exit "$EXIT_NOT_FOUND" "Merge applied, but failed to create merge commit"
fi

bt_success "Merge successful"

# Show merge details if verbose
if [[ "$VERBOSE" == true ]]; then
  bt_info "Merge details:"
  git log -1 --oneline | sed 's/^/  /'
fi

# Ask for confirmation before push (unless force)
if [[ "$FORCE" == false ]]; then
  echo -n "Push merge to remote? (y/n): "
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    DID_PUSH_REMOTE=false
    MERGE_COMMIT_HASH="$(git rev-parse --short HEAD 2>/dev/null || true)"
    generate_merge_report "$PARENT_BRANCH" "$MERGE_MESSAGE" "$MERGE_COMMIT_HASH" "$commits_to_merge"
    if git remote get-url origin >/dev/null 2>&1; then
      bt_report_copy_to_remote "$REPO_ROOT" "$BRANCH_REPORTS_DIR" "commit*.md" || true
    fi
    bt_warn "Push skipped - merge committed locally"
    if [[ -n "$REPORT_FILE" ]]; then
      report_rel="${REPORT_FILE#"${REPO_ROOT}"/}"
      bt_success "See ${report_rel} for details."
    fi
    exit 0
  fi
fi

# Push merge commit
bt_info "Pushing merge commit to remote..."
if ! GIT_BYPASS_HOOKS=true git push origin "$CURRENT_BRANCH" 2>&1; then
  bt_error_exit "$EXIT_NOT_FOUND" "Failed to push merge commit to remote"
fi
DID_PUSH_REMOTE=true

MERGE_COMMIT_HASH="$(git rev-parse --short HEAD 2>/dev/null || true)"
generate_merge_report "$PARENT_BRANCH" "$MERGE_MESSAGE" "$MERGE_COMMIT_HASH" "$commits_to_merge"
if git remote get-url origin >/dev/null 2>&1; then
  bt_report_copy_to_remote "$REPO_ROOT" "$BRANCH_REPORTS_DIR" "commit*.md" || true
fi

bt_success "Pushed merge commit"
bt_success "Sync up complete"
if [[ -n "$REPORT_FILE" ]]; then
  report_rel="${REPORT_FILE#"${REPO_ROOT}"/}"
  bt_success "See ${report_rel} for details."
fi
exit 0
