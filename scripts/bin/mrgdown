#!/usr/bin/env bash

# mrgdown - Merge parent branch into current branch.
#
# See usage below for details, or run: mrgdown -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  mrgdown [OPTIONS]
  mrgdown {-h | --help}

Merge the parent branch of the current branch into current branch
to sync up with latest changes.

Automatically determines the parent branch based on branch naming
and Git history (the branch that the current branch was created
from). Handles simple conflicts automatically and provides
instructions for complex ones.

Before merging:
  - The current branch must have no untracked or uncommitted changes.
  - If there are local changes, use the commit or undo workflow first.

Protected branches (cannot run mrgdown):
  - main
  - v<M>.<m>.<p> release branches created from main

Allowed branches (can use mrgdown):
  - Unprotected branches with an identified parent branch

Features:
  - Automatically determines parent branch
  - Merges parent branch into current branch
  - Shows instructions for complex conflicts
  - Prompts for confirmation before merge and push
  - Optional force mode to skip confirmations

Options:
  -c TOKEN           Commit comment as a single token.
  -- TOKEN...        Commit comment with 'TOKEN...' indicating one or more tokens.
  -h, --help         Output this help to stdout and exit (other options
                     and arguments are ignored).
  -o                 Owner override. Allows repository owner to run even
                     on branches normally blocked by user policy for this
                     command run only; normal role restrictions apply again
                     after exit.
  -v                 Show detailed merge information.

For commit comment options '-c TOKEN' and '-- TOKEN...':
    - These options are mutually exclusive.
    - One of these options is required if one or more commits are to be made.
    - Ignored if no changes need to be committed.
    - None of these options are required if only pushing existing local commits
      to remote.
    - In dry-run mode (-d), commit comment requirements are still validated when a
      commit would be created.
    - For '-- TOKEN...', '--' must be a separate token, followed by at least
      one or more tokens. Leading/trailing whitespace is not preserved
      and whitespace between tokens is reduced to a single space.
    - For a quoted token, whitespace is preserved and the quotes are
      removed.
    - For example, the following both have the same commit comment:
        commit -- do "  keep   this spacing  " for commit comment.
        commit -c "do   keep   this spacing   for commit comment."
    - The resulting commit comment from TOKEN/TOKENS must include at least
      one non-whitespace character.
    - Always ensure that the commit comment accurately reflects the changes
      being committed.

Commit Comment Options (mutually exclusive):
  -c, --comment TOKEN  Set custom commit comment (requires quotes if spaces)
  -- TOKEN...           Unix-style comment (everything after -- is the comment)
  (default)             "Merge <parent-branch> into <current-branch>"

Examples:
  # Sync up with confirmations
  mrgdown

  # Force merge and push (no confirmations)
  mrgdown -f

  # Custom merge message
  mrgdown -m "Sync with latest parent branch for bug fix"

  # Verbose output
  mrgdown -v

  # Unix-style message with force
  mrgdown -f -- Sync up with latest changes


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented
    output locations.

Exit codes:
  0   Success
  1   Argument or validation error
  2   Git merge or push failed
  3   Conflicts detected (user must resolve)
  4   Branch is protected (cannot sync up)
  5   Failed to determine parent branch
EOF
}

# High-Level Flow:
# - Brings parent-branch changes into the current branch using project sync-up
#   workflow.
# - Validates branch relationships and merge/rebase preconditions.
# - Reports integration outcomes and required follow-up actions.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_NOT_FOUND=2
readonly EXIT_OPERATION_FAILED=3
readonly EXIT_CONFIG_ERROR=4
readonly EXIT_INTERNAL_ERROR=100

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

# Default options
FORCE=false
VERBOSE=false
CUSTOM_MESSAGE=""
OWNER_OVERRIDE=false
OWNER_OVERRIDE_ACTIVE=false

ensure_clean_worktree() {
  if bt_is_worktree_dirty; then
    bt_error_exit "$EXIT_NOT_FOUND" "Current branch has uncommitted changes. Commit or undo them before running mrgdown"
  fi
}

get_repository_owner_login() {
  local origin_url=""
  local owner=""

  origin_url="$(git remote get-url origin 2>/dev/null || true)"
  [[ -n "$origin_url" ]] || {
    echo ""
    return 0
  }

  if [[ "$origin_url" =~ ^git@github\.com:([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  elif [[ "$origin_url" =~ ^https://github\.com/([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  elif [[ "$origin_url" =~ ^ssh://git@github\.com/([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  fi

  owner="$(bt_normalize_login "$owner")"
  echo "$owner"
}

is_repository_owner() {
  local user_name="$1"
  local repo_owner=""

  repo_owner="$(get_repository_owner_login)"
  [[ -n "$repo_owner" ]] || return 1

  [[ "$(bt_normalize_login "$user_name")" == "$repo_owner" ]]
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -f | --force)
      FORCE=true
      shift
      ;;
    -o)
      OWNER_OVERRIDE=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -m requires a message argument"
      fi
      if [[ -n "$CUSTOM_MESSAGE" ]]; then
        usage_error "Cannot use both -m and -- for message"
      fi
      CUSTOM_MESSAGE="$2"
      shift 2
      ;;
    --)
      # Unix-style message: everything after -- is the message
      shift
      if [[ -n "$CUSTOM_MESSAGE" ]]; then
        usage_error "Cannot use both -m and -- for message"
      fi
      CUSTOM_MESSAGE="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      usage_error "Unknown argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit "$EXIT_NOT_FOUND" "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

if [[ "$OWNER_OVERRIDE" == true ]]; then
  CURRENT_USER="$(bt_require_login || true)"
  if [[ -z "$CURRENT_USER" ]]; then
    bt_error_exit "$EXIT_NOT_FOUND" "Option -o requires a resolvable GitHub login"
  fi
  if is_repository_owner "$CURRENT_USER"; then
    OWNER_OVERRIDE_ACTIVE=true
    bt_info "Owner override enabled for repository owner '$CURRENT_USER'"
  else
    bt_error_exit "$EXIT_CONFIG_ERROR" "Option -o is allowed only for the repository owner"
  fi
fi

# Check if branch is protected
if bt_is_protected_branch "$CURRENT_BRANCH"; then
  if [[ "$OWNER_OVERRIDE_ACTIVE" == true ]]; then
    bt_warn "Owner override enabled: allowing sync on protected branch '$CURRENT_BRANCH'"
  else
    bt_error_exit "$EXIT_CONFIG_ERROR" "Cannot sync up on protected branch '$CURRENT_BRANCH'." \
      "Use 'mrgup' to merge changes to this branch."
  fi
fi

# Determine parent branch
bt_info "Determining parent branch..."
PARENT_BRANCH=$(bt_resolve_parent_branch "$CURRENT_BRANCH" "main")
if [[ -z "$PARENT_BRANCH" ]]; then
  bt_error_exit "$EXIT_INTERNAL_ERROR" "Failed to determine parent branch"
fi
bt_info "Parent branch: $PARENT_BRANCH"

ensure_clean_worktree

# Ensure parent branch exists and is up to date
bt_info "Fetching latest from remote..."
if ! git fetch origin "$PARENT_BRANCH" >/dev/null 2>&1; then
  bt_error_exit "$EXIT_NOT_FOUND" "Failed to fetch parent branch '$PARENT_BRANCH' from remote"
fi

# Propagate repository history from remote if available
history_sync_rc=0
bt_propagate_repository_history || history_sync_rc=$?
case "$history_sync_rc" in
  0) ;;
  1) bt_info "Updated repository history from remote" ;;
  *) ;;
esac

# Count commits from parent branch to current branch
commits_to_merge=""
commits_to_merge=$(git rev-list --count "HEAD..origin/$PARENT_BRANCH" \
  2>/dev/null || echo "0")

if [[ "$commits_to_merge" == "0" ]]; then
  bt_success "Already up to date with $PARENT_BRANCH"
  exit 0
fi

bt_info "Commits to merge: $commits_to_merge"

# Determine merge message
if [[ -z "$CUSTOM_MESSAGE" ]]; then
  MERGE_MESSAGE="Merge $PARENT_BRANCH into $CURRENT_BRANCH"
else
  MERGE_MESSAGE="$CUSTOM_MESSAGE"
fi

# Ask for confirmation before merge (unless force)
if [[ "$FORCE" == false ]]; then
  echo -n "Create merge commit? (y/n): "
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    bt_warn "Merge cancelled"
    exit 0
  fi
fi

# Perform merge without auto-commit so hooks cannot block the merge commit path.
bt_info "Merging $PARENT_BRANCH into $CURRENT_BRANCH..."
if ! git merge --no-commit --no-ff "origin/$PARENT_BRANCH" >/dev/null 2>&1; then
  # Check if merge failed due to conflicts
  conflicted_files=$(git diff --name-only --diff-filter=U)
  if [[ -n "$conflicted_files" ]]; then
    bt_warn "Merge conflicts detected"
    bt_info "Complex conflicts require manual resolution"
    bt_info "Conflicted files:"
    while IFS= read -r file; do
      [[ -n "$file" ]] && echo "  $file"
    done <<< "$conflicted_files"
    bt_info "Steps to resolve:"
    echo "  1. Edit conflicted files to resolve conflicts"
    echo "  2. Stage resolved files: git add <files>"
    echo "  3. Complete merge: git commit"
    bt_error_exit "$EXIT_OPERATION_FAILED" "Merge stopped - manual conflict resolution needed"
  else
    bt_error_exit "$EXIT_NOT_FOUND" "Failed to merge $PARENT_BRANCH into $CURRENT_BRANCH"
  fi
fi

if ! GIT_BYPASS_HOOKS=true git commit -m "$MERGE_MESSAGE" >/dev/null 2>&1; then
  bt_error_exit "$EXIT_NOT_FOUND" "Merge applied, but failed to create merge commit"
fi

bt_success "Merge successful"

# Show merge details if verbose
if [[ "$VERBOSE" == true ]]; then
  bt_info "Merge details:"
  git log -1 --oneline | sed 's/^/  /'
fi

# Ask for confirmation before push (unless force)
if [[ "$FORCE" == false ]]; then
  echo -n "Push merge to remote? (y/n): "
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    bt_warn "Push skipped - merge committed locally"
    exit 0
  fi
fi

# Push merge commit
bt_info "Pushing merge commit to remote..."
if ! GIT_BYPASS_HOOKS=true git push origin "$CURRENT_BRANCH" 2>&1; then
  bt_error_exit "$EXIT_NOT_FOUND" "Failed to push merge commit to remote"
fi

bt_success "Pushed merge commit"
bt_success "Sync up complete"
exit 0
