#!/usr/bin/env bash

# ckstyle - Validate canonical style across repository.
#
# See usage below for details, or run: ckstyle -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

usage() {
  cat <<'EOF'
Usage:
  ckstyle [OPTIONS]
  ckstyle -h | --help

Validate canonical style across repository for the current branch.

This script performs comprehensive style validation including:
  - Document canonical form in docs/md/
  - Directory guide structure in all subdirectories
  - Document front matter and structure
  - Directory README.md requirements
  - File and subdirectory section consistency

Document Checks:
  - Front matter structure and SPDX identifiers
  - Details/summary pairing and formatting
  - Table-of-contents numbering syntax
  - Numbered heading formatting
  - Summary/heading alignment
  - ASCII-only content
  - Shared Document Version History blocks
  - Corresponding docs/branding/*.svg files

Directory Guide Checks:
  - Required README.md presence in subdirectories
  - Canonical heading and header layout
  - Copyright, SPDX, and license information
  - Files section with proper alphabetical ordering
  - Subdirectories section accuracy
  - README.md listed last in file entries
  
Versioning Checks:
  - Versioned files all specify the same major and minor version
    and, if the branch is named for a version, that version has the same
    major and minor version.
  
Options:
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored).
  -d          Check documents.
  -r          Check directory guide README.md files.
  -r          Check directory guide README.md files.
  -v           Check versioned files and branch name (if versioed) for
               versioning consistency.
               

  If neither -d nor -r is specified, same as specifying both -d and -r
  (i.e., both documents and directory guides are checked).

Examples:
  # Check both documents and directory guides
  ckstyle

  # Check only documents
  ckstyle -d

  # Check only directory guides
  ckstyle -r

  # Show help
  ckstyle -h

Outputs:
  - Writes help text, status messages, and results to stdout.
  - Writes errors and diagnostics to stderr.
  - Writes a validation report to reports/ckstyle-<datetime>.md.
  - Removes previous reports when a new one is successfully written.

Exit codes:
  0  Success, or help requested with -h/--help.
  1  Validation failure.
  2  Invalid command-line argument.
EOF
}

# High-Level Flow:
# - Validates document structure, front matter, and directory guides
# - Checks document-to-SVG correspondence and directory README requirements
# - Reports all validation failures with detailed diagnostics

set -euo pipefail

readonly EXIT_OK=0
readonly EXIT_VALIDATION=1
readonly EXIT_USAGE=2

RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
RUN_OUTPUT_FILE="$(mktemp)"
REPORT_FILE=""

CHECK_DOCUMENTS_FLAG=false
CHECK_GUIDES_FLAG=false

setup_output_capture() {
  exec > >(tee "$RUN_OUTPUT_FILE") 2>&1
}

write_report_on_exit() {
  local exit_code="$?"
  local old_report
  set +e

  {
    echo "# ckstyle Validation Report"
    echo
    echo "**Timestamp:** $RUN_TS_DISPLAY"
    echo
    echo "## Validation Output"
    echo '```text'
    sed -n '1,$p' "$RUN_OUTPUT_FILE"
    echo '```'
  } > "$REPORT_FILE"

  # Remove old reports if new one was written successfully
  if [[ -n "$repo_root" && -f "$REPORT_FILE" ]]; then
    for old_report in "$repo_root"/reports/ckstyle-*.md; do
      [[ "$old_report" == "$REPORT_FILE" ]] && continue
      [[ -e "$old_report" ]] || continue
      rm -f "$old_report"
    done
  fi

  rm -f "$RUN_OUTPUT_FILE"
  trap - EXIT
  exit "$exit_code"
}

# Check for help first — if specified, show usage and exit, ignoring all other arguments
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    usage
    exit "$EXIT_OK"
  fi
done

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d)
      CHECK_DOCUMENTS_FLAG=true
      shift
      ;;
    -r)
      CHECK_GUIDES_FLAG=true
      shift
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit "$EXIT_USAGE"
      ;;
  esac
done

# Determine what to check based on flags
# If neither flag specified, default to both; if at least one flag specified, use the flags
if ! $CHECK_DOCUMENTS_FLAG && ! $CHECK_GUIDES_FLAG; then
  # Default: check both
  CHECK_DOCUMENTS=true
  CHECK_GUIDES=true
else
  # At least one flag specified: use exactly what was specified
  CHECK_DOCUMENTS=$CHECK_DOCUMENTS_FLAG
  CHECK_GUIDES=$CHECK_GUIDES_FLAG
fi

repo_root=$(cd "$(dirname "$0")/../.." && pwd)

# Validate reports directory exists before proceeding
if [[ ! -d "$repo_root/reports" ]]; then
  echo "ERROR: reports directory not found: $repo_root/reports" >&2
  exit "$EXIT_VALIDATION"
fi
cd "$repo_root"
REPORT_FILE="$repo_root/reports/ckstyle-${RUN_TS_FILE}.md"

trap write_report_on_exit EXIT
setup_output_capture

docs_dir="$repo_root/docs/md"
branding_dir="$repo_root/docs/branding"
svg_template="$branding_dir/Test_Guide.svg"

failures=0

fail() {
  echo "ERROR: $1" >&2
  failures=$((failures + 1))
}

# ============================================================================
# DOCUMENT VALIDATION FUNCTIONS
# ============================================================================

license_summary='<summary><strong>License</strong></summary>'
preface_summary='<summary><strong>Preface</strong></summary>'
dvh_summary='<summary>&nbsp;&nbsp;&nbsp;&nbsp;Document Version History</summary>'
toc_summary='<summary><strong>Table of Contents</strong></summary>'
overview_doc='briteTest.md'

front_matter() {
  local file=$1
  awk '{ print } /^## Table of Contents$/ { exit }' "$file"
}

summary_lines() {
  local file=$1
  front_matter "$file" | grep '^<summary>' || true
}

extract_dvh_block() {
  local file=$1
  awk '
    /### Document Version History/ { capture=1 }
    capture { print }
    capture && /<\/details><br>/ { exit }
  ' "$file"
}

check_standard_doc() {
  local file=$1
  local first_nonblank

  first_nonblank=$(awk 'NF { print; exit }' "$file")
  if ! printf '%s\n' "$first_nonblank" | grep -Eq '^!\[[^]]+\]\(\.\./branding/[^)]+\.png\)$'; then
    fail "$file: first non-blank line must be the document banner image"
  fi

  if grep -q '^\[!\[' "$file"; then
    fail "$file: badges are only allowed in $overview_doc"
  fi
}

check_overview_doc() {
  local file=$1
  local first_four

  mapfile -t first_four < <(awk 'NF { print; if (++count == 4) exit }' "$file")

  [[ ${#first_four[@]} -ge 4 ]] || {
    fail "$file: expected badges and logo before the copyright line"
    return
  }

  [[ ${first_four[0]} == '[![License: MIT](https://img.shields.io/badge/License-MIT-yellow.svg)](LICENSE)' ]] || \
    fail "$file: missing canonical license badge"
  [[ ${first_four[1]} == '[![Latest Release](https://img.shields.io/github/v/release/paulsinclair51/BriteTest?display_name=tag)](https://github.com/paulsinclair51/BriteTest/releases)' ]] || \
    fail "$file: missing canonical latest release badge"
  [[ ${first_four[2]} == '[![CI](https://github.com/paulsinclair51/BriteTest/actions/workflows/ci.yml/badge.svg)](https://github.com/paulsinclair51/BriteTest/actions/workflows/ci.yml)' ]] || \
    fail "$file: missing canonical CI badge"
  [[ ${first_four[3]} == '![BriteTest Logo](../branding/Logo_with_BrandName.png)' ]] || \
    fail "$file: missing canonical overview logo"
}

check_details_structure() {
  local file=$1
  local opens closes summaries

  opens=$(grep -c '^<details>$' "$file" || true)
  closes=$(grep -Ec '^[[:space:]]*</details>(<br>)?[[:space:]]*$' "$file" || true)
  summaries=$(grep -c '^<summary>' "$file" || true)

  [[ "$opens" -eq "$closes" ]] || fail "$file: <details> and </details> counts differ ($opens != $closes)"
  [[ "$opens" -eq "$summaries" ]] || fail "$file: each <details> block must have exactly one <summary> ($opens != $summaries)"

  awk -v file="$file" '
    /^<details>$/ {
      if (getline nextline <= 0) {
        printf("ERROR: %s: <details> at end of file without a summary\n", file) > "/dev/stderr"
        status=1
        exit
      }
      if (nextline !~ /^<summary>/) {
        printf("ERROR: %s: <details> must be followed immediately by <summary>\n", file) > "/dev/stderr"
        status=1
        exit
      }
      print nextline
      next
    }
    { print }
    END { exit status }
  ' "$file" >/dev/null || failures=$((failures + 1))

  awk -v file="$file" '
    {
      lines[NR] = $0
    }
    END {
      for (i = 1; i < NR; i++) {
        if (lines[i] ~ /^[[:space:]]*<\/details>[[:space:]]*$/ && lines[i + 1] ~ /^[[:space:]]*<\/details>[[:space:]]*$/) {
          printf("ERROR: %s: adjacent </details> blocks require the first closing tag to be </details><br>: %s\n", file, lines[i]) > "/dev/stderr"
          status = 1
        }
      }
      exit status
    }
  ' "$file" || failures=$((failures + 1))
}

check_heading_numbering() {
  local file=$1

  awk -v file="$file" '
    function is_numbered_heading(text) {
      return text ~ /^[0-9]+(\.[0-9]+)*(\.)?[[:space:]]+/
    }

    (/^```/ || /^~~~/) {
      in_code_block = !in_code_block
      next
    }

    in_code_block {
      next
    }

    /^###[[:space:]]/ {
      heading=$0
      sub(/^###[[:space:]]+/, "", heading)
      if (heading ~ /^[0-9]/ && !is_numbered_heading(heading)) {
        printf("ERROR: %s: malformed level-3 heading numbering: %s\n", file, $0) > "/dev/stderr"
        status=1
      }

      if (heading ~ /^[0-9]/) {
        if (current_section_heading == "") {
          printf("ERROR: %s: numbered level-3 heading appears before a level-2 heading: %s\n", file, $0) > "/dev/stderr"
          status=1
        } else {
          if (current_section_heading !~ /^[0-9]/) {
            printf("ERROR: %s: numbered level-3 headings require a numbered level-2 section heading: %s\n", file, $0) > "/dev/stderr"
            status=1
          }
          section_has_numbered_h3=1
        }
      } else if (section_has_numbered_h3) {
        printf("ERROR: %s: all level-3 headings in a section must be numbered once one is numbered: %s\n", file, $0) > "/dev/stderr"
        status=1
      }
    }
    /^##[[:space:]]/ {
      section_has_numbered_h3=0
      if ($0 == "## Preface" || $0 == "## Table of Contents") {
        current_section_heading=""
        next
      }
      heading=$0
      sub(/^##[[:space:]]+/, "", heading)
      current_section_heading=heading
      if (heading ~ /^[0-9]/ && !is_numbered_heading(heading)) {
        printf("ERROR: %s: malformed level-2 heading numbering: %s\n", file, $0) > "/dev/stderr"
        status=1
      }

      if (heading !~ /^[0-9]/) {
        current_section_heading=heading
      }
    }
    END { exit status }
  ' "$file" || failures=$((failures + 1))
}

check_toc_syntax() {
  local file=$1

  awk -v file="$file" '
    /^## Table of Contents$/ { in_toc=1; next }
    in_toc && /^<\/details>$/ { exit status }
    !in_toc { next }

    /^[[:space:]]*$/ { next }

    {
      line=$0
      gsub(/&nbsp;/, " ", line)

      if (line ~ /^[[:space:]]*[0-9]+,[[:space:]]*\[/) {
        printf("ERROR: %s: Table of Contents entry uses a comma instead of a period: %s\n", file, $0) > "/dev/stderr"
        status=1
      }

      if (line ~ /^[[:space:]]*\[[^]]*[0-9]/) {
        if (line !~ /^[[:space:]]*\[[^]]*[0-9]+(\.[0-9]+)*\./) {
          printf("ERROR: %s: numbered Table of Contents entry is malformed: %s\n", file, $0) > "/dev/stderr"
          status=1
        }
      }

      if (line ~ /^[[:space:]]*[0-9]/ && line !~ /^[[:space:]]*[0-9]+(\.[0-9]+)*\.[[:space:]]+\[/) {
        printf("ERROR: %s: Table of Contents numbering syntax is malformed: %s\n", file, $0) > "/dev/stderr"
        status=1
      }

      if (match(line, /^[[:space:]]*([0-9]+(\.[0-9]+)*)\.[[:space:]]+\[([^]]+)\]/, parts)) {
        label=parts[3]
        gsub(/\*\*/, "", label)
        if (label ~ /^[0-9]+(\.[0-9]+)*\./) {
          printf("ERROR: %s: Table of Contents label must not repeat the numbered prefix: %s\n", file, $0) > "/dev/stderr"
          status=1
        }
      }
    }
    END { exit status }
  ' "$file" || failures=$((failures + 1))
}

check_summary_heading_alignment() {
  local file=$1

  awk -v file="$file" '
    function is_strong_summary(raw) {
      return raw ~ /^<summary><strong>.*<\/strong><\/summary>$/
    }

    function is_indented_summary(raw) {
      return raw ~ /^<summary>&nbsp;&nbsp;&nbsp;&nbsp;.*<\/summary>$/
    }

    function normalize_summary(text, result) {
      result=text
      sub(/^<summary>/, "", result)
      sub(/<\/summary>$/, "", result)
      gsub(/&nbsp;/, "", result)
      gsub(/<strong>/, "", result)
      gsub(/<\/strong>/, "", result)
      sub(/^([0-9]+(\.[0-9]+)+) /, "\\1. ", result)
      sub(/^[[:space:]]+/, "", result)
      sub(/[[:space:]]+$/, "", result)
      return result
    }

    /^<summary>/ {
      raw_summary=$0
      summary=normalize_summary($0)
      if (summary == "License" || summary == "Preface" || summary == "Document Version History" || summary == "Table of Contents") {
        pending=""
        pending_raw=""
        next
      }
      pending=summary
      pending_raw=raw_summary
      next
    }

    pending != "" && /^###[[:space:]]/ {
      heading=$0
      sub(/^###[[:space:]]+/, "", heading)
      if (heading != pending) {
        printf("ERROR: %s: summary/heading mismatch: %s != %s\n", file, pending, heading) > "/dev/stderr"
        status=1
      }
      if (!is_indented_summary(pending_raw) || pending_raw ~ /<strong>/) {
        printf("ERROR: %s: canonical summary style for level-3 headings must be indented without <strong>: %s\n", file, pending_raw) > "/dev/stderr"
        status=1
      }
      pending=""
      pending_raw=""
      next
    }

    pending != "" && /^##[[:space:]]/ {
      heading=$0
      sub(/^##[[:space:]]+/, "", heading)
      if (heading != pending) {
        printf("ERROR: %s: summary/heading mismatch: %s != %s\n", file, pending, heading) > "/dev/stderr"
        status=1
      }
      if (!is_strong_summary(pending_raw) || pending_raw ~ /&nbsp;/) {
        printf("ERROR: %s: canonical summary style for level-2 headings must use <strong> with no &nbsp; prefix: %s\n", file, pending_raw) > "/dev/stderr"
        status=1
      }
      pending=""
      pending_raw=""
      next
    }
    END { exit status }
  ' "$file" || failures=$((failures + 1))
}

check_ascii_only() {
  local file=$1
  local first_match

  first_match=$(LC_ALL=C grep -nP -m1 '[^\x00-\x7F]' "$file" || true)
  if [[ -n "$first_match" ]]; then
    fail "$file: non-ASCII character found: $first_match"
  fi
}

check_doc_file() {
  local file=$1
  local base
  local summaries

  base=$(basename "$file")

  if ! front_matter "$file" | grep -qx '## Table of Contents'; then
    fail "$file: missing Table of Contents heading in front matter"
    return
  fi

  if ! front_matter "$file" | grep -qx 'SPDX-License-Identifier: MIT'; then
    fail "$file: missing SPDX identifier before Table of Contents"
  fi

  if ! front_matter "$file" | grep -qx '#### Copyright (c) 2026 Paul Sinclair'; then
    fail "$file: missing canonical copyright line before Table of Contents"
  fi

  summaries=$(summary_lines "$file")
  if [[ "$summaries" != "$license_summary
$preface_summary
$dvh_summary
$toc_summary" ]]; then
    fail "$file: summary tags before Table of Contents do not match the canonical order/style"
  fi

  if [[ "$base" == "$overview_doc" ]]; then
    check_overview_doc "$file"
  else
    check_standard_doc "$file"
  fi

  check_ascii_only "$file"
  check_details_structure "$file"
  check_heading_numbering "$file"
  check_toc_syntax "$file"
  check_summary_heading_alignment "$file"
}

ensure_doc_svgs() {
  local -a md_files=()
  local -a expected_svgs=()
  local -a branding_svgs=()
  local md_file
  local svg_file
  local base
  local doc_title
  local target_svg
  local expected_name
  local found

  if [[ ! -d "$branding_dir" ]]; then
    fail "missing directory: docs/branding"
    return
  fi

  if [[ ! -f "$svg_template" ]]; then
    fail "missing SVG template for auto-create: docs/branding/Test_Guide.svg"
    return
  fi

  mapfile -t md_files < <(find "$docs_dir" -maxdepth 1 -type f -name '*.md' ! -name 'README.md' | sort)
  mapfile -t branding_svgs < <(find "$branding_dir" -maxdepth 1 -type f -name '*.svg' | sort)

  for md_file in "${md_files[@]}"; do
    base=$(basename "$md_file" .md)
    expected_svgs+=("${base}.svg")
    target_svg="$branding_dir/${base}.svg"

    if [[ ! -f "$target_svg" ]]; then
      doc_title="${base//_/ }"
      cp "$svg_template" "$target_svg"
      DOC_TITLE="$doc_title" perl -i -pe 's/Test Guide/$ENV{DOC_TITLE}/g' "$target_svg"
      echo "INFO: added missing SVG: docs/branding/${base}.svg"
    fi
  done

  for svg_file in "${branding_svgs[@]}"; do
    base=$(basename "$svg_file")
    case "$base" in
      canary-live.svg|canary.svg|Monogram.svg|Logo_with_BrandName.svg|Logo_with_Tagline.svg)
        continue
        ;;
    esac

    found=0
    for expected_name in "${expected_svgs[@]}"; do
      if [[ "$base" == "$expected_name" ]]; then
        found=1
        break
      fi
    done

    if [[ "$found" -eq 0 ]]; then
      echo "INFO: unexpected SVG (no matching docs/md/*.md): docs/branding/${base}"
    fi
  done
}

# ============================================================================
# DIRECTORY GUIDE VALIDATION FUNCTIONS
# ============================================================================

list_immediate_subdirs() {
  local dir="$1"

  find "$dir" -mindepth 1 -maxdepth 1 -type d -not -path './.git*' -printf '%f\n' | sort
}

extract_subdirectory_entries() {
  local file="$1"
  awk '
    BEGIN { in_section = 0 }
    /^## Subdirectories$/ { in_section = 1; next }
    /^## / && in_section { exit }
    in_section { print }
  ' "$file"
}

extract_files_section_lines() {
  local file="$1"
  awk '
    BEGIN { in_section = 0 }
    /^## Files$/ { in_section = 1; next }
    /^## / && in_section { exit }
    in_section { print }
  ' "$file"
}

list_immediate_files() {
  local dir="$1"

  find "$dir" -mindepth 1 -maxdepth 1 -type f -not -name '.*' -printf '%f\n' | sort
}

normalize_file_entry() {
  local entry="$1"

  entry="$(printf '%s' "$entry" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  entry="${entry#\`}"
  entry="${entry%\`}"

  printf '%s\n' "$entry"
}

entry_matches_file() {
  local entry="$1"
  local file="$2"
  local ext
  local entry_regex

  entry="$(normalize_file_entry "$entry")"

  if [[ "$entry" =~ ^\.([A-Za-z0-9_+-]+)[[:space:]]+files$ ]]; then
    ext="${BASH_REMATCH[1]}"
    [[ "$file" == *."$ext" ]]
    return
  fi

  if [[ "$entry" == *"<datetime>"* ]]; then
    entry_regex="${entry//./\\.}"
    entry_regex="${entry_regex//\*/.*}"
    entry_regex="${entry_regex//<datetime>/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]}"
    [[ "$file" =~ ^${entry_regex}$ ]]
    return
  fi

  if printf '%s\n' "$entry" | grep -Eq '<[A-Za-z0-9_+-]+>'; then
    entry_regex="${entry//./\\.}"
    entry_regex="${entry_regex//\*/.*}"
    entry_regex="$(printf '%s' "$entry_regex" | sed -E 's/<[A-Za-z0-9_+-]+>/[^\/]+/g')"
    [[ "$file" =~ ^${entry_regex}$ ]]
    return
  fi

  if [[ "$entry" == *'*'* ]]; then
    [[ "$file" == $entry ]]
    return
  fi

  [[ "$file" == "$entry" ]]
}

is_filelike_entry() {
  local entry="$1"

  entry="$(normalize_file_entry "$entry")"

  if printf '%s\n' "$entry" | grep -Eq '^[A-Za-z0-9_.<>/-]+$'; then
    return 0
  fi
  [[ "$entry" == *"*"* ]] && return 0
  [[ "$entry" == *"<datetime>"* ]] && return 0
  [[ "$entry" =~ ^\.[A-Za-z0-9_+-]+[[:space:]]+files$ ]] && return 0
  [[ "$entry" =~ ^[^[:space:]]+\.[^[:space:]]+$ ]] && return 0

  return 1
}

check_files_section() {
  local readme="$1"
  local dir="$2"
  local rel_dir
  local allow_logical_order=0
  local files_section_entries=()
  local files_section_lines
  local actual_files
  local actual
  local entry
  local found_match
  local line
  local section='__ROOT__'
  local section_name
  local has_h3=0
  local root_entry_count=0
  local first_readme_section=''
  local last_readme_section=''
  local last_section='__ROOT__'
  local last_entry_in_last_section=''
  local prev

  declare -A prev_by_section=()
  declare -A readme_seen_by_section=()
  declare -A section_seen=()
  declare -A last_entry_by_section=()

  rel_dir="${dir#./}"
  if [[ "$rel_dir" == "docs/branding" ]]; then
    allow_logical_order=1
  fi

  mapfile -t files_section_lines < <(extract_files_section_lines "$readme")
  mapfile -t actual_files < <(list_immediate_files "$dir")

  for line in "${files_section_lines[@]}"; do
    if [[ "$line" =~ ^###[[:space:]]+(.+)$ ]]; then
      has_h3=1
      section_name="${BASH_REMATCH[1]}"
      section="$section_name"
      section_seen["$section"]=1
      last_section="$section"
      continue
    fi

    if [[ "$line" =~ ^-[[:space:]]*\*\*(.+)\*\*:[[:space:]]* ]]; then
      entry="$(normalize_file_entry "${BASH_REMATCH[1]}")"
      files_section_entries+=("$entry")

      if [[ "$section" == '__ROOT__' ]]; then
        root_entry_count=$((root_entry_count + 1))
      fi

      if is_filelike_entry "$entry"; then
        if [[ "$entry" == 'README.md' ]]; then
          readme_seen_by_section["$section"]=1
        else
          if [[ "${readme_seen_by_section[$section]-0}" -eq 1 ]]; then
            if [[ "$section" == '__ROOT__' ]]; then
              echo "ERROR: '$readme' lists entries after 'README.md' in '## Files' section"
            else
              echo "ERROR: '$readme' lists entries after 'README.md' in Files subsection '$section'"
            fi
            return 1
          fi

          prev="${prev_by_section[$section]-}"
          if [[ $allow_logical_order -eq 0 && -n "$prev" && "$entry" < "$prev" ]]; then
            if [[ "$section" == '__ROOT__' ]]; then
              echo "ERROR: '$readme' has non-alphabetical Files entries ('$prev' before '$entry')"
            else
              echo "ERROR: '$readme' has non-alphabetical Files entries in subsection '$section' ('$prev' before '$entry')"
            fi
            return 1
          fi
          prev_by_section["$section"]="$entry"
        fi
      fi

      if [[ "$entry" == 'README.md' ]]; then
        [[ -z "$first_readme_section" ]] && first_readme_section="$section"
        last_readme_section="$section"
      fi

      last_entry_by_section["$section"]="$entry"
    fi
  done

  if [[ ${#files_section_entries[@]} -eq 0 ]]; then
    echo "ERROR: '$readme' has no file entries in '## Files' section"
    return 1
  fi

  if [[ $has_h3 -eq 1 && $root_entry_count -gt 0 ]]; then
    echo "ERROR: '$readme' mixes top-level file entries with level-3 Files subsections"
    return 1
  fi

  for actual in "${actual_files[@]}"; do
    found_match=0
    for entry in "${files_section_entries[@]}"; do
      if entry_matches_file "$entry" "$actual"; then
        found_match=1
        break
      fi
    done

    if [[ $found_match -eq 0 ]]; then
      echo "ERROR: '$readme' does not list file '$actual' in '## Files' section"
      return 1
    fi
  done

  if [[ $has_h3 -eq 0 ]]; then
    if [[ "${files_section_entries[-1]}" != 'README.md' ]]; then
      echo "ERROR: '$readme' must list 'README.md' last in '## Files' section"
      return 1
    fi
  else
    if [[ -z "$last_readme_section" ]]; then
      echo "ERROR: '$readme' must include 'README.md' in the final Files subsection"
      return 1
    fi

    if [[ "$last_readme_section" != "$last_section" ]]; then
      echo "ERROR: '$readme' must place 'README.md' in the final Files subsection"
      return 1
    fi

    last_entry_in_last_section="${last_entry_by_section[$last_section]-}"
    if [[ "$last_entry_in_last_section" != 'README.md' ]]; then
      echo "ERROR: '$readme' must list 'README.md' last within the final Files subsection"
      return 1
    fi
  fi

  return 0
}

check_subdirectories_section() {
  local readme="$1"
  local dir="$2"
  local subdirs_section
  local expected_subdirs
  local found_subdirs
  local line

  subdirs_section="$(extract_subdirectory_entries "$readme")"

  mapfile -t expected_subdirs < <(list_immediate_subdirs "$dir")
  mapfile -t found_subdirs < <(
    printf '%s\n' "$subdirs_section" | \
      sed -n 's/^-[[:space:]]*\*\*\([^*][^*]*\)\*\*:.*$/\1/p' | \
      sed 's:/$::' | \
      sort
  )

  if [[ ${#expected_subdirs[@]} -eq 0 ]]; then
    if ! printf '%s\n' "$subdirs_section" | grep -qx '[-][[:space:]]None\.'; then
      echo "ERROR: '$readme' missing '- None.' line in '## Subdirectories' section"
      return 1
    fi
    return 0
  fi

  if printf '%s\n' "$subdirs_section" | grep -qx '[-][[:space:]]None\.'; then
    echo "ERROR: '$readme' has '- None.' line but directory contains subdirectories"
    return 1
  fi

  for line in "${found_subdirs[@]}"; do
    [[ -z "$line" ]] && continue
    if ! printf '%s\n' "${expected_subdirs[@]}" | grep -qxF "$line"; then
      echo "ERROR: '$readme' lists unexpected subdirectory '$line'"
      return 1
    fi
  done

  for line in "${expected_subdirs[@]}"; do
    [[ -z "$line" ]] && continue
    if ! printf '%s\n' "${found_subdirs[@]}" | grep -qxF "$line"; then
      echo "ERROR: '$readme' is missing subdirectory '$line'"
      return 1
    fi
  done

  return 0
}

check_directory_guides() {
  local dir
  local readme
  local display_dir
  local rel_dir
  local expected_heading
  local heading_line
  local second_line
  local description_line
  local line4
  local line5
  local line6
  local line7
  local line8
  local extra_h1_line
  local extra_h1_text
  local copyright_ln
  local spdx_ln
  local license_ln
  local intro_ln
  local files_ln
  local files_heading_any_ln
  local files_heading_any_text
  local subdirs_ln
  local subdirs_heading_any_ln
  local subdirs_heading_any_text
  local starting_failures=$failures

  readonly EXPECTED_LICENSE_LINE='For license details, see `/LICENSE`.'
  readonly EXPECTED_INTRO_LINE='See `/README.md` for an introduction to briteTest.'

  exempt_dirs=(
    "."
    "./.git"
    "./.github"
  )

  is_exempt_dir() {
    local dir="$1"
    local e
    for e in "${exempt_dirs[@]}"; do
      if [[ "$dir" == "$e" ]]; then
        return 0
      fi
    done
    return 1
  }

  mapfile -t dirs < <(find . -type d -not -path './.git*' | sort)

  for dir in "${dirs[@]}"; do
    if is_exempt_dir "$dir"; then
      continue
    fi

    readme="$dir/README.md"
    display_dir="${dir#./}"

    if [[ ! -f "$readme" ]]; then
      fail "Missing README.md in directory '$display_dir'"
      continue
    fi

    rel_dir="${dir#./}"
    expected_heading="# /${rel_dir}/"
    heading_line="$(sed -n '1p' "$readme")"
    second_line="$(sed -n '2p' "$readme")"
    description_line="$(sed -n '3p' "$readme")"
    line4="$(sed -n '4p' "$readme")"
    line5="$(sed -n '5p' "$readme")"
    line6="$(sed -n '6p' "$readme")"
    line7="$(sed -n '7p' "$readme")"
    line8="$(sed -n '8p' "$readme")"

    if [[ "$heading_line" != "$expected_heading" ]]; then
      echo "ERROR: '$readme' heading mismatch"
      echo "  Expected: $expected_heading"
      echo "  Found:    $heading_line"
      failures=$((failures + 1))
    fi

    if [[ -n "$second_line" ]]; then
      echo "ERROR: '$readme' second line must be blank"
      echo "  Found:    $second_line"
      failures=$((failures + 1))
    fi

    if [[ "$description_line" != 'Directory containing '* ]]; then
      echo "ERROR: '$readme' third line must start with 'Directory containing '"
      echo "  Found:    $description_line"
      failures=$((failures + 1))
    fi

    if sed -n '2,$p' "$readme" | grep -q '^# '; then
      extra_h1_line="$(sed -n '2,$p' "$readme" | grep -n '^# ' | head -n1 | cut -d: -f1)"
      extra_h1_text="$(sed -n '2,$p' "$readme" | grep '^# ' | head -n1)"
      extra_h1_line=$((extra_h1_line + 1))
      echo "ERROR: '$readme' contains an unexpected H1 heading after line 1"
      echo "  Found:    $extra_h1_text"
      echo "  Line:     $extra_h1_line"
      failures=$((failures + 1))
    fi

    if [[ -n "$line4" ]]; then
      echo "ERROR: '$readme' line 4 must be blank"
      echo "  Found:    $line4"
      failures=$((failures + 1))
    fi

    if ! [[ "$line5" =~ ^Copyright\ \(c\)\ [0-9]{4}\ .+ ]]; then
      echo "ERROR: '$readme' line 5 must be a valid copyright line"
      echo "  Found:    $line5"
      failures=$((failures + 1))
    fi

    if [[ "$line6" != 'SPDX-License-Identifier: MIT  ' ]]; then
      echo "ERROR: '$readme' line 6 must be 'SPDX-License-Identifier: MIT  '"
      echo "  Found:    $line6"
      failures=$((failures + 1))
    fi

    if [[ "$line7" != "$EXPECTED_LICENSE_LINE" ]]; then
      echo "ERROR: '$readme' line 7 must match expected license reference"
      echo "  Expected: $EXPECTED_LICENSE_LINE"
      echo "  Found:    $line7"
      failures=$((failures + 1))
    fi

    if [[ -n "$line8" ]]; then
      echo "ERROR: '$readme' line 8 must be blank"
      echo "  Found:    $line8"
      failures=$((failures + 1))
    fi

    if ! grep -qE '^Copyright \(c\) [0-9]{4} .+' "$readme"; then
      echo "ERROR: '$readme' missing/invalid copyright line"
      failures=$((failures + 1))
    fi

    if ! grep -qx 'SPDX-License-Identifier: MIT  *' "$readme"; then
      echo "ERROR: '$readme' missing SPDX line"
      failures=$((failures + 1))
    fi

    if ! grep -qxF "$EXPECTED_LICENSE_LINE" "$readme"; then
      echo "ERROR: '$readme' missing expected license reference"
      echo "  Expected: $EXPECTED_LICENSE_LINE"
      failures=$((failures + 1))
    fi

    if ! grep -qxF "$EXPECTED_INTRO_LINE" "$readme"; then
      echo "ERROR: '$readme' missing expected root README reference"
      echo "  Expected: $EXPECTED_INTRO_LINE"
      failures=$((failures + 1))
    fi

    copyright_ln="$(grep -nE '^Copyright \(c\) [0-9]{4} .+' "$readme" | cut -d: -f1 | head -n1 || true)"
    spdx_ln="$(grep -n '^SPDX-License-Identifier: MIT  *$' "$readme" | cut -d: -f1 | head -n1 || true)"
    license_ln="$(grep -nFx "$EXPECTED_LICENSE_LINE" "$readme" | cut -d: -f1 | head -n1 || true)"
    intro_ln="$(grep -nFx "$EXPECTED_INTRO_LINE" "$readme" | cut -d: -f1 | head -n1 || true)"

    files_ln="$(grep -n '^## Files$' "$readme" | cut -d: -f1 | head -n1 || true)"
    files_heading_any_ln="$(grep -nE '^#{1,6}[[:space:]]+Files$' "$readme" | cut -d: -f1 | head -n1 || true)"
    files_heading_any_text="$(grep -E '^#{1,6}[[:space:]]+Files$' "$readme" | head -n1 || true)"
    subdirs_ln="$(grep -n '^## Subdirectories$' "$readme" | cut -d: -f1 | head -n1 || true)"
    subdirs_heading_any_ln="$(grep -nE '^#{1,6}[[:space:]]+Subdirectories$' "$readme" | cut -d: -f1 | head -n1 || true)"
    subdirs_heading_any_text="$(grep -E '^#{1,6}[[:space:]]+Subdirectories$' "$readme" | head -n1 || true)"

    if [[ -n "$copyright_ln" && -n "$spdx_ln" && -n "$license_ln" && -n "$intro_ln" ]]; then
      if ! [[ "$copyright_ln" -lt "$spdx_ln" && "$spdx_ln" -lt "$license_ln" && "$license_ln" -lt "$intro_ln" ]]; then
        echo "ERROR: '$readme' has canonical header order mismatch"
        echo "  Expected order: Copyright, SPDX, license line, root README line"
        failures=$((failures + 1))
      fi
    fi

    if [[ -z "$files_ln" ]]; then
      if [[ -n "$files_heading_any_ln" ]]; then
        echo "ERROR: '$readme' has incorrect heading level for Files section"
        echo "  Expected: ## Files"
        echo "  Found:    $files_heading_any_text"
        echo "  Line:     $files_heading_any_ln"
      else
        echo "ERROR: '$readme' missing '## Files' section"
      fi
      failures=$((failures + 1))
    fi

    if [[ -z "$subdirs_ln" ]]; then
      if [[ -n "$subdirs_heading_any_ln" ]]; then
        echo "ERROR: '$readme' has incorrect heading level for Subdirectories section"
        echo "  Expected: ## Subdirectories"
        echo "  Found:    $subdirs_heading_any_text"
        echo "  Line:     $subdirs_heading_any_ln"
      else
        echo "ERROR: '$readme' missing '## Subdirectories' section"
      fi
      failures=$((failures + 1))
    fi

    if [[ -n "$files_ln" && -n "$subdirs_ln" && "$files_ln" -ge "$subdirs_ln" ]]; then
      echo "ERROR: '$readme' has section order mismatch ('## Files' must come before '## Subdirectories')"
      failures=$((failures + 1))
    fi

    if [[ -n "$files_ln" ]] && ! check_files_section "$readme" "$dir"; then
      failures=$((failures + 1))
    fi

    if [[ -n "$subdirs_ln" ]] && ! check_subdirectories_section "$readme" "$dir"; then
      failures=$((failures + 1))
    fi
  done

  [[ $failures -eq $starting_failures ]]
}

# ============================================================================
# MAIN VALIDATION FLOW
# ============================================================================

echo "=== Starting ckstyle validation ==="
echo

# Validate documents if requested
if [[ "$CHECK_DOCUMENTS" == true ]]; then
  echo "Checking document canonical form..."
  
  if [[ -d "$docs_dir" ]]; then
    ensure_doc_svgs
    
    reference_dvh=$(extract_dvh_block "$docs_dir/$overview_doc")
    
    while IFS= read -r file; do
      check_doc_file "$file"
      
      if [[ $(extract_dvh_block "$file") != "$reference_dvh" ]]; then
        fail "$file: Document Version History block differs from $overview_doc"
      fi
    done < <(find "$docs_dir" -maxdepth 1 -type f -name '*.md' ! -name 'README.md' | sort)
    
    echo "✓ Document checks complete"
  else
    echo "⚠ Document directory not found: $docs_dir"
  fi
  echo
fi

# Validate directory guides if requested
if [[ "$CHECK_GUIDES" == true ]]; then
  echo "Checking directory guide canonical form..."
  check_directory_guides || true
  echo "✓ Directory guide checks complete"
  echo
fi

if [[ $failures -ne 0 ]]; then
  echo "Canonical-form checks FAILED with $failures issue(s)."
  exit "$EXIT_VALIDATION"
fi

echo "✓ All canonical-form checks PASSED."
