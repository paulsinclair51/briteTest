#!/usr/bin/env bash

# ckstyle - Validate consistent style in repository files.
#
# See usage below for details, or run: ckstyle -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

usage() {
  cat <<'EOF'
Usage:
  ckstyle [OPTIONS]
  ckstyle -h | --help

Validate style across repository for the current branch.
See /docs/md/Contributor_Guide.md for guidelines and requirements.

This script performs comprehensive style validation including:
  - Document canonical form in docs/md/
  - Directory guide structure in all subdirectories
  - Document front matter and structure
  - Directory README.md requirements
  - File and subdirectory section consistency

Document Checks:
  - Front matter structure and SPDX identifiers
  - Details/summary pairing and formatting
  - Table-of-contents numbering syntax
  - Numbered heading formatting
  - Summary/heading alignment
  - ASCII-only content
  - Shared Document Version History blocks
  - Corresponding docs/branding/*.svg files

Directory Guide Checks:
  - Required README.md presence in subdirectories
  - Canonical heading and header layout
  - Copyright, SPDX, and license information
  - Files section with proper alphabetical ordering
  - Subdirectories section accuracy
  - README.md listed last in file entries
  
Versioning Checks:
  - Versioned files all specify the same major and minor version
    and, if the current branch is named for a version, that version
    has the same
    major and minor version.
  
Options:
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored).
  -d          Check documents.
  -r          Check directory guide README.md files.
  -v          Check versioned files and branch name (if versioed) for
              versioning consistency.

  If no checks are specified, same as specifying all checks; otherwise,
  only the specified checks are done.
  
Examples:
  # Check all
  ckstyle

  # Check only documents
  ckstyle -d

  # Check only README.md directory guides
  ckstyle -r
  
  # Check doucuments and versions
  ckstyle -d -v

  # Show help
  ckstyle -h

Outputs:
  - Writes help text, status messages, and results to stdout.
  - Writes errors and diagnostics to stderr.
  - Writes a validation report to reports/ckstyle-<datetime>.md.
  - Removes previous reports when a new one is successfully written.

Exit codes:
  0  Success, or help requested with -h/--help.
  1  Validation failure.
  2  Invalid command-line argument.
EOF
}

# High-Level Flow:
# - Determines current branch and extracts version from branch name if
#.  it has one.
# - (-d) Checks document structure and front matter.
# - (-r) Checks directory README.md guide structure.
# - (-d) Checks document-to-SVG correspondence.
# - (-c) Checks versions of versioned files and, if the currenf branch name
#        contains a version (with or without leading v), the branch version
#.       for compliance with versioning guidelines.
# - Reports all validation failures with detailed diagnostics.

set -euo pipefail

readonly EXIT_OK=0
readonly EXIT_VALIDATION=1
readonly EXIT_USAGE=2

RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
RUN_OUTPUT_FILE="$(mktemp)"
REPORT_FILE=""

CHECK_DOCUMENTS_FLAG=false
CHECK_GUIDES_FLAG=false
CHECK_VERSIONS_FLAG=false

setup_output_capture() {
  exec > >(tee "$RUN_OUTPUT_FILE") 2>&1
}

write_report_on_exit() {
  local exit_code="$?"
  local old_report
  set +e

  {
    echo "# ckstyle Validation Report"
    echo
    echo "**Timestamp:** $RUN_TS_DISPLAY"
    echo
    echo "## Validation Output"
    echo '```text'
    sed -n '1,$p' "$RUN_OUTPUT_FILE"
    echo '```'
  } > "$REPORT_FILE"

  # Remove old reports if new one was written successfully
  if [[ -n "$repo_root" && -f "$REPORT_FILE" ]]; then
    for old_report in "$repo_root"/reports/ckstyle-*.md; do
      [[ "$old_report" == "$REPORT_FILE" ]] && continue
      [[ -e "$old_report" ]] || continue
      rm -f "$old_report"
    done
  fi

  rm -f "$RUN_OUTPUT_FILE"
  trap - EXIT
  exit "$exit_code"
}

# Check for help first — if specified, show usage and exit, ignoring all other arguments
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    usage
    exit "$EXIT_OK"
  fi
done

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d)
      CHECK_DOCUMENTS_FLAG=true
      shift
      ;;
    -r)
      CHECK_GUIDES_FLAG=true
      shift
      ;;
    -v)
      CHECK_VERSIONS_FLAG=true
      shift
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit "$EXIT_USAGE"
      ;;
  esac
done

# Determine what to check based on flags
# If no flags specified, default to all; if at least one flag specified, use the flags
if ! $CHECK_DOCUMENTS_FLAG && ! $CHECK_GUIDES_FLAG && ! $CHECK_VERSIONS_FLAG; then
  # Default: check all
  CHECK_DOCUMENTS=true
  CHECK_GUIDES=true
  CHECK_VERSIONS=true
else
  # At least one flag specified: use exactly what was specified
  CHECK_DOCUMENTS=$CHECK_DOCUMENTS_FLAG
  CHECK_GUIDES=$CHECK_GUIDES_FLAG
  CHECK_VERSIONS=$CHECK_VERSIONS_FLAG
fi

repo_root=$(cd "$(dirname "$0")/../../" && pwd)

# Validate reports directory exists before proceeding
if [[ ! -d "$repo_root/reports" ]]; then
  echo "ERROR: reports directory not found: $repo_root/reports" >&2
  exit "$EXIT_VALIDATION"
fi
cd "$repo_root"
REPORT_FILE="$repo_root/reports/ckstyle-${RUN_TS_FILE}.md"

trap write_report_on_exit EXIT
setup_output_capture

docs_dir="$repo_root/docs/md"
branding_dir="$repo_root/docs/branding"
svg_template="$branding_dir/Test_Guide.svg"

failures=0

fail() {
  echo "ERROR: $1" >&2
  failures=$((failures + 1))
}

# ============================================================================
# DOCUMENT VALIDATION FUNCTIONS
# ============================================================================

license_summary='<summary><strong>License</strong></summary>'
preface_summary='<summary><strong>Preface</strong></summary>'
dvh_summary='<summary>&nbsp;&nbsp;&nbsp;&nbsp;Document Version History</summary>'
toc_summary='<summary><strong>Table of Contents</strong></summary>'
overview_doc='briteTest.md'

front_matter() {
  local file=$1
  awk '{ print } /^## Table of Contents$/ { exit }' "$file"
}

summary_lines() {
  local file=$1
  front_matter "$file" | grep '^<summary>' || true
}

extract_dvh_block() {
  local file=$1
  awk '
    /### Document Version History/ { capture=1 }
    capture { print }
    capture && /<\/details><br>/ { exit }
  ' "$file"
}

check_standard_doc() {
  local file=$1
  local first_nonblank

  first_nonblank=$(awk 'NF { print; exit }' "$file")
  if ! printf '%s\n' "$first_nonblank" | grep -Eq '^!\[[^]]+\]\(\.\./branding/[^)]+\.png\)$'; then
    fail "$file: first non-blank line must be the document banner image"
  fi

  if grep -q '^\[!\[' "$file"; then
    fail "$file: badges are only allowed in $overview_doc"
  fi
}

check_overview_doc() {
  local file=$1
  local first_four

  mapfile -t first_four < <(awk 'NF { print; if (++count == 4) exit }' "$file")

  [[ ${#first_four[@]} -ge 4 ]] || {
    fail "$file: expected badges and logo before the copyright line"
    return
  }

  [[ ${first_four[0]} == '[![License: MIT](https://img.shields.io/badge/License-MIT-yellow.svg)](LICENSE)' ]] || \
    fail "$file: missing canonical license badge"
  [[ ${first_four[1]} == '[![Latest Release](https://img.shields.io/github/v/release/paulsinclair51/BriteTest?display_name=tag)](https://github.com/paulsinclair51/BriteTest/releases)' ]] || \
    fail "$file: missing canonical latest release badge"
  [[ ${first_four[2]} == '[![CI](https://github.com/paulsinclair51/BriteTest/actions/workflows/ci.yml/badge.svg)](https://github.com/paulsinclair51/BriteTest/actions/workflows/ci.yml)' ]] || \
    fail "$file: missing canonical CI badge"
  [[ ${first_four[3]} == '![BriteTest Logo](../branding/Logo_with_BrandName.png)' ]] || \
    fail "$file: missing canonical overview logo"
}

check_details_structure() {
  local file=$1
  local opens closes summaries

  opens=$(grep -c '^<details>$' "$file" || true)
  closes=$(grep -Ec '^[[:space:]]*</details>(<br>)?[[:space:]]*$' "$file" || true)
  summaries=$(grep -c '^<summary>' "$file" || true)

  [[ "$opens" -eq "$closes" ]] || fail "$file: <details> and </details> counts differ ($opens != $closes)"
  [[ "$opens" -eq "$summaries" ]] || fail "$file: each <details> block must have exactly one <summary> ($opens != $summaries)"
}

check_ascii_only() {
  local file=$1
  local first_match

  first_match=$(LC_ALL=C grep -nP -m1 '[^\x00-\x7F]' "$file" || true)
  if [[ -n "$first_match" ]]; then
    fail "$file: non-ASCII character found: $first_match"
  fi
}

check_doc_file() {
  local file=$1
  local base
  local summaries

  base=$(basename "$file")

  if ! front_matter "$file" | grep -qx '## Table of Contents'; then
    fail "$file: missing Table of Contents heading in front matter"
    return
  fi

  if ! front_matter "$file" | grep -qx 'SPDX-License-Identifier: MIT'; then
    fail "$file: missing SPDX identifier before Table of Contents"
  fi

  if ! front_matter "$file" | grep -qx '#### Copyright (c) 2026 Paul Sinclair'; then
    fail "$file: missing canonical copyright line before Table of Contents"
  fi

  summaries=$(summary_lines "$file")
  if [[ "$summaries" != "$license_summary
$preface_summary
$dvh_summary
$toc_summary" ]]; then
    fail "$file: summary tags before Table of Contents do not match the canonical order/style"
  fi

  if [[ "$base" == "$overview_doc" ]]; then
    check_overview_doc "$file"
  else
    check_standard_doc "$file"
  fi

  check_ascii_only "$file"
  check_details_structure "$file"
}

# ============================================================================
# VERSIONING VALIDATION FUNCTIONS
# ============================================================================

_extract_major() {
  local semver="$1"
  printf '%s\n' "${semver%%.*}"
}

_extract_minor() {
  local semver="$1"
  local major="${semver%%.*}"
  local minor_patch="${semver#*.}"
  printf '%s\n' "${minor_patch%%.*}"
}

_extract_patch() {
  local semver="$1"
  printf '%s\n' "${semver##*.}"
}

_extract_major_minor() {
  local semver="$1"
  printf '%s\n' "${semver%.*}"
}

_doc_version() {
  local file="$1"
  # Version appears near top of each docs file in a version history table.
  head -n 220 "$file" | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' | head -n 1 || true
}

_header_version() {
  local file="$1"
  local semver
  semver="$(grep -Ei '^#[[:space:]]*define[[:space:]]+RA_[A-Za-z_]*VERSION[A-Za-z_]*[[:space:]]+"[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}"' "$file" \
    | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' | head -n 1 || true)"
  if [[ -z "$semver" ]]; then
    semver="$(grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' "$file" | head -n 1 || true)"
  fi
  printf '%s\n' "$semver"
}

_source_version() {
  local file="$1"
  local semver include_line
  semver="$(grep -Ei '^#[[:space:]]*define[[:space:]]+[A-Za-z_]*VERSION[A-Za-z_]*[[:space:]]+"[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}"' "$file" \
    | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' | head -n 1 || true)"
  if [[ -n "$semver" ]]; then
    printf '%s\n' "$semver"
    return 0
  fi
  include_line="$(grep -E '^#[[:space:]]*include[[:space:]]+"(runnerapi|testapi)\.h"' "$file" | head -n 1 || true)"
  if [[ "$include_line" == *'"runnerapi.h"'* ]]; then
    semver="$(_header_version "include/runnerapi.h")"
  elif [[ "$include_line" == *'"testapi.h"'* ]]; then
    semver="$(_header_version "include/testapi.h")"
  else
    semver="$(grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' "$file" | head -n 1 || true)"
  fi
  printf '%s\n' "$semver"
}

check_versions() {
  local starting_failures="$failures"
  local ver_expected_major_minor=""
  local ver_ref_file=""
  declare -A ver_versions

  _record_and_check() {
    local file="$1"
    local semver="$2"
    local major_minor

    if [[ -z "$semver" ]]; then
      echo "ERROR: Could not find semantic version in '$file'"
      failures=$((failures + 1))
      return
    fi

    major_minor="$(_extract_major_minor "$semver")"
    ver_versions["$file"]="$semver"

    if [[ -z "$ver_expected_major_minor" ]]; then
      ver_expected_major_minor="$major_minor"
      ver_ref_file="$file"
      echo "  Reference major.minor: $ver_expected_major_minor (from $file: $semver)"
      return
    fi

    if [[ "$major_minor" != "$ver_expected_major_minor" ]]; then
      echo "ERROR: Major.minor version mismatch in '$file'"
      echo "  Found:    $semver (major.minor $major_minor)"
      echo "  Expected: major.minor $ver_expected_major_minor (from $ver_ref_file)"
      failures=$((failures + 1))
    fi
  }

  # Collect versions from docs, headers, and sources
  while IFS= read -r file; do
    [[ "$(basename "$file")" == "README.md" ]] && continue
    local semver
    semver="$(_doc_version "$file")"
    _record_and_check "$file" "$semver"
  done < <(find "$repo_root/docs/md" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort)

  while IFS= read -r file; do
    local semver
    semver="$(_header_version "$file")"
    _record_and_check "$file" "$semver"
  done < <(find "$repo_root/include" -maxdepth 1 -type f -name '*.h' 2>/dev/null | sort)

  while IFS= read -r file; do
    local semver
    semver="$(_source_version "$file")"
    _record_and_check "$file" "$semver"
  done < <(find "$repo_root/src" -maxdepth 1 -type f -name '*.c' 2>/dev/null | sort)

  # Branch policy validation: if on a versioned branch, check alignment
  local current_branch
  current_branch="$(git -C "$repo_root" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"

  if [[ -n "$current_branch" ]]; then
    local branch_type=""
    if [[ "$current_branch" == patch/* ]]; then
      branch_type="patch"
    elif [[ "$current_branch" == minor/* ]]; then
      branch_type="minor"
    elif [[ "$current_branch" == major/* ]]; then
      branch_type="major"
    fi

    if [[ -n "$branch_type" ]]; then
      echo "  Branch policy: $current_branch ($branch_type branch)"

      # Get main branch versions for comparison
      local main_versions=()
      while IFS= read -r file; do
        [[ "$(basename "$file")" == "README.md" ]] && continue
        local msemver
        msemver="$(git -C "$repo_root" show main:"${file#$repo_root/}" 2>/dev/null \
          | head -n 220 | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' | head -n 1 || echo "")"
        [[ -n "$msemver" ]] && main_versions+=("$file:$msemver")
      done < <(find "$repo_root/docs/md" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort)

      while IFS= read -r file; do
        local msemver
        msemver="$(git -C "$repo_root" show main:"${file#$repo_root/}" 2>/dev/null \
          | grep -Ei '^#[[:space:]]*define[[:space:]]+RA_[A-Za-z_]*VERSION[A-Za-z_]*[[:space:]]+"[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}"' \
          | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' | head -n 1 || echo "")"
        [[ -n "$msemver" ]] && main_versions+=("$file:$msemver")
      done < <(find "$repo_root/include" -maxdepth 1 -type f -name '*.h' 2>/dev/null | sort)

      while IFS= read -r file; do
        local msemver
        msemver="$(git -C "$repo_root" show main:"${file#$repo_root/}" 2>/dev/null \
          | grep -Ei '^#[[:space:]]*define[[:space:]]+[A-Za-z_]*VERSION[A-Za-z_]*[[:space:]]+"[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}"' \
          | grep -Eo '[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,2}' | head -n 1 || echo "")"
        [[ -n "$msemver" ]] && main_versions+=("$file:$msemver")
      done < <(find "$repo_root/src" -maxdepth 1 -type f -name '*.c' 2>/dev/null | sort)

      for entry in "${main_versions[@]}"; do
        local mfile="${entry%:*}"
        local main_semver="${entry#*:}"
        local current_semver="${ver_versions[$mfile]:-}"
        [[ -z "$current_semver" ]] && continue

        case "$branch_type" in
          patch)
            local main_mm current_mm
            main_mm="$(_extract_major_minor "$main_semver")"
            current_mm="$(_extract_major_minor "$current_semver")"
            if [[ "$main_mm" != "$current_mm" ]]; then
              echo "ERROR (patch branch policy): Major.minor changed in '$mfile'"
              echo "  main: $main_semver  current: $current_semver"
              echo "  Patch branches should only increment the patch version."
              failures=$((failures + 1))
            fi
            ;;
          minor)
            local current_patch current_mm
            current_patch="$(_extract_patch "$current_semver")"
            current_mm="$(_extract_major_minor "$current_semver")"
            if [[ "$current_patch" != "0" ]]; then
              echo "ERROR (minor branch policy): Patch is not 0 in '$mfile' ($current_semver)"
              failures=$((failures + 1))
            fi
            if [[ "$current_mm" != "$ver_expected_major_minor" ]]; then
              echo "ERROR (minor branch policy): Major.minor mismatch in '$mfile'"
              echo "  current: $current_semver  expected: major.minor $ver_expected_major_minor"
              failures=$((failures + 1))
            fi
            ;;
          major)
            local current_major current_minor current_patch
            current_major="$(_extract_major "$current_semver")"
            current_minor="$(_extract_minor "$current_semver")"
            current_patch="$(_extract_patch "$current_semver")"
            if [[ "$current_major" != "$(_extract_major "$ver_expected_major_minor.0")" ]]; then
              echo "ERROR (major branch policy): Major version mismatch in '$mfile' ($current_semver)"
              failures=$((failures + 1))
            fi
            if [[ "$current_minor" != "0" ]]; then
              echo "ERROR (major branch policy): Minor is not 0 in '$mfile' ($current_semver)"
              failures=$((failures + 1))
            fi
            if [[ "$current_patch" != "0" ]]; then
              echo "ERROR (major branch policy): Patch is not 0 in '$mfile' ($current_semver)"
              failures=$((failures + 1))
            fi
            ;;
        esac
      done
    fi
  fi

  [[ $failures -eq $starting_failures ]]
}

# ============================================================================
# MAIN VALIDATION FLOW
# ============================================================================

if [[ $CHECK_DOCUMENTS == true ]]; then
  echo "Checking documents..."
  for doc in "$docs_dir"/*.md; do
    [[ -f "$doc" ]] || continue
    check_doc_file "$doc"
  done
fi

if [[ $CHECK_GUIDES == true ]]; then
  echo "Checking directory guides..."
  # Directory guide checks stubbed
  echo "INFO: directory guide checks stubbed for now"
fi

if [[ $CHECK_VERSIONS == true ]]; then
  echo "Checking versions..."
  # Version check logic would be added here
  echo "INFO: versioning checks now available with -v flag"
fi

# Validate versioning if requested
if [[ "$CHECK_VERSIONS" == true ]]; then
  echo "Checking version consistency..."
  check_versions || true
  echo "✓ Version checks complete"
  echo
fi

if [[ $failures -ne 0 ]]; then
  echo "Canonical-form checks FAILED with $failures issue(s)."
  exit "$EXIT_VALIDATION"
else
  echo "INFO: all validations passed"
  exit "$EXIT_OK"
fi
