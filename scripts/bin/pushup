#!/usr/bin/env bash

# pushup - Push the current branch up to its parent and resynchronize it.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091  # Helper paths are resolved from this script.
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck disable=SC1091  # Helper paths are resolved from this script.
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck disable=SC1091  # Helper paths are resolved from this script.
source "$SCRIPT_DIR/../helpers/report_helpers.sh"

readonly EXIT_USAGE=1
readonly EXIT_ACTIVE=2
readonly EXIT_NOTHING_TO_CONTINUE=3
readonly EXIT_PREPUBLICATION_FAILED=4
readonly EXIT_PARTIAL=5
readonly EXIT_INTERNAL=200

usage() {
  cat <<'EOF'
Usage:
  pushup [OPTIONS] [-- TOKEN...]
  pushup --continue
  pushup {-h | --help}

Push the current local branch up to its parent, publish the parent, merge the
published parent back into the source branch, and publish the source branch.

Before the parent is published, a failure restores the original local branch
and branch tips. After publication, progress is retained and an error report
explains what completed, what remains, and how to continue.

Parent preparation enforces PR policy: a PR may be required, optional but
present, or optional and absent. When a PR exists, its state and approval are
validated.

Options:
  --continue    Continue a partially completed push-up workflow.
  -c TOKEN      Commit comment for the parent push-up commit.
  -o            Repository-owner override for an eligible push-up workflow.
  -t SEC        Remote timeout in seconds (default: 10).
  -v            Output progress from delegated workflow commands.
  -- TOKEN...   Commit comment built from one or more tokens.
  -h, --help    Output this help and exit.

Exit codes:
  0    Push-up workflow completed.
  1    Invalid option or argument.
  2    Another pushup process is active.
  3    No partial push-up workflow is available to continue.
  4    Push-up workflow failed before publication; local state was restored.
  5    Push-up workflow partially completed; run pushup --continue after following
       the guidance in the reported pushup error report.
  200  Internal state or recovery error.
EOF
}

CONTINUE=false
OWNER_OVERRIDE=false
VERBOSE=false
TIMEOUT_SECONDS=10
COMMENT_MODE=""
COMMENT=""
STATE_FILE=""
LOCK_FILE=""
LOCK_FD=""
REPO_ROOT=""
REPORTS_DIR=""

state_get() {
  git config --file "$STATE_FILE" --get "pushup.$1" 2>/dev/null || true
}

state_set() {
  git config --file "$STATE_FILE" "pushup.$1" "$2"
}

set_phase() {
  state_set phase "$1"
}

remote_tip() {
  git ls-remote --exit-code origin "refs/heads/$1" 2>/dev/null |
    awk 'NR == 1 { print $1 }'
}

write_partial_report() {
  local reason="$1"
  local action="$2"
  local source_branch parent_branch phase report_file timestamp
  source_branch="$(state_get source)"
  parent_branch="$(state_get parent)"
  phase="$(state_get phase)"
  timestamp="$(date '+%Y%m%d-%H%M%S')"
  report_file="$(bt_report_retained_path "$REPORTS_DIR" "pushup-e" \
    "$timestamp" "$BASHPID")"

  bt_report_dir_enable_writes "$REPORTS_DIR" "$EXIT_INTERNAL"
  cat > "$report_file" <<EOF
# Pushup Error Report $(date '+%Y-%m-%d %H:%M:%S')

**Source branch:** \`$source_branch\`  
**Parent branch:** \`$parent_branch\`  
**Saved phase:** \`$phase\`

## Progress

| Step | Status |
|---|---|
| Prepare parent locally | $(phase_status parent-prepared) |
| Publish parent | $(phase_status parent-published) |
| Select source | $(phase_status source-selected) |
| Synchronize source from parent | $(phase_status source-synchronized) |
| Publish source | $(phase_status source-published) |

## Failure

$reason

## Required Action

$action

After completing that action, run \`pushup --continue\`.
EOF
  chmod a-w "$report_file" 2>/dev/null || true
  printf '%s\n' "Push-up workflow partially completed: $reason" >&2
  printf '%s\n' "See ${report_file#"$REPO_ROOT"/} for completed and remaining steps." >&2
  printf '%s\n' "$action" >&2
  printf '%s\n' "Then run: pushup --continue" >&2
}

phase_rank() {
  case "$1" in
    initialized|parent-prepared|publication-uncertain) echo 1 ;;
    parent-published) echo 2 ;;
    source-selected|source-sync-failed|source-conflicted) echo 3 ;;
    source-synchronized|source-publish-failed) echo 4 ;;
    source-published) echo 5 ;;
    *) echo 0 ;;
  esac
}

phase_status() {
  local required="$1"
  if [[ "$(phase_rank "$(state_get phase)")" -ge "$(phase_rank "$required")" ]]; then
    printf 'Completed'
  else
    printf 'Pending'
  fi
}

rollback_local_prepublication() {
  local source_branch parent_branch source_tip parent_tip notes_tip
  source_branch="$(state_get source)"
  parent_branch="$(state_get parent)"
  source_tip="$(state_get source-tip)"
  parent_tip="$(state_get parent-tip)"
  notes_tip="$(state_get notes-tip)"

  git merge --abort >/dev/null 2>&1 || true
  GIT_BYPASS_HOOKS=true git checkout "$source_branch" >/dev/null 2>&1 || return 1
  git update-ref "refs/heads/$source_branch" "$source_tip" >/dev/null 2>&1 || return 1
  git update-ref "refs/heads/$parent_branch" "$parent_tip" >/dev/null 2>&1 || return 1
  if [[ -n "$notes_tip" ]]; then
    git update-ref refs/notes/briteTest-workflow "$notes_tip" >/dev/null 2>&1 || return 1
  else
    git update-ref -d refs/notes/briteTest-workflow >/dev/null 2>&1 || true
  fi
  rm -f "$STATE_FILE"
}

fail_before_publication() {
  local reason="$1"
  if rollback_local_prepublication; then
    printf '%s\n' "Push-up workflow not started: $reason" >&2
    printf '%s\n' "No local push-up changes were retained." >&2
    exit "$EXIT_PREPUBLICATION_FAILED"
  fi
  write_partial_report \
    "Local restoration could not be completed after: $reason" \
    "Run fixlocal, restore the recorded branch tips, and rerun pushup --continue."
  exit "$EXIT_PARTIAL"
}

prepare_parent() {
  local -a args=(-t "$(state_get timeout)")
  [[ "$(state_get verbose)" == true ]] && args+=(-v)
  [[ "$(state_get owner-override)" == true ]] && args+=(-o)
  case "$(state_get comment-mode)" in
    option) args+=(-c "$(state_get comment)") ;;
    tokens) args+=(-- "$(state_get comment)") ;;
  esac
  bash "$SCRIPT_DIR/../helpers/pushup_parent.sh" "${args[@]}"
}

run_push() {
  local -a args=(-t "$(state_get timeout)")
  [[ "$(state_get verbose)" == true ]] && args+=(-v)
  "$SCRIPT_DIR/push" "${args[@]}"
}

publish_parent() {
  local parent_branch local_tip published_tip
  parent_branch="$(state_get parent)"
  local_tip="$(git rev-parse "refs/heads/$parent_branch" 2>/dev/null || true)"
  state_set prepared-parent-tip "$local_tip"
  if run_push; then
    set_phase parent-published
    return 0
  fi

  published_tip="$(remote_tip "$parent_branch" || true)"
  if [[ -n "$published_tip" && "$published_tip" == "$local_tip" ]]; then
    set_phase parent-published
    return 0
  fi
  if [[ -n "$published_tip" ]]; then
    fail_before_publication "the parent changed before it could be published"
  fi

  set_phase publication-uncertain
  write_partial_report \
    "The parent push result could not be verified because the remote is unavailable." \
    "Restore remote access; pushup will verify whether the parent was published."
  exit "$EXIT_PARTIAL"
}

select_source() {
  local source_branch
  source_branch="$(state_get source)"
  if ! "$SCRIPT_DIR/chbranch" -l "$source_branch"; then
    write_partial_report "The published parent could not be followed by selecting the source branch." \
      "Resolve the local checkout problem without changing branch history."
    exit "$EXIT_PARTIAL"
  fi
  set_phase source-selected
}

synchronize_source() {
  local -a args=(-f -t "$(state_get timeout)")
  [[ "$(state_get verbose)" == true ]] && args+=(-v)
  if "$SCRIPT_DIR/pulldown" "${args[@]}"; then
    set_phase source-synchronized
    return 0
  fi
  if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    set_phase source-conflicted
    write_partial_report "The parent was published, but source synchronization has unresolved conflicts." \
      "Resolve the listed conflicts and stage every resolved file."
  else
    set_phase source-sync-failed
    write_partial_report "The parent was published, but the source could not be synchronized." \
      "Address the pulldown prerequisite or remote error shown above."
  fi
  exit "$EXIT_PARTIAL"
}

finish_resolved_merge() {
  local unresolved
  unresolved="$(git diff --name-only --diff-filter=U 2>/dev/null || true)"
  if [[ -n "$unresolved" ]]; then
    write_partial_report "Source synchronization still has unresolved conflicts." \
      "Resolve and stage these files: $(tr '\n' ' ' <<< "$unresolved")"
    exit "$EXIT_PARTIAL"
  fi
  if ! git diff --quiet; then
    write_partial_report "Resolved source files have unstaged changes." \
      "Stage every resolved file with git add."
    exit "$EXIT_PARTIAL"
  fi
  if ! GIT_BYPASS_HOOKS=true git commit --no-edit; then
    write_partial_report "The resolved source merge could not be committed." \
      "Correct the commit error while preserving the merge in progress."
    exit "$EXIT_PARTIAL"
  fi
  set_phase source-synchronized
}

publish_source() {
  local source_branch local_tip published_tip
  source_branch="$(state_get source)"
  local_tip="$(git rev-parse HEAD 2>/dev/null || true)"
  if run_push; then
    set_phase source-published
    return 0
  fi

  published_tip="$(remote_tip "$source_branch" || true)"
  if [[ -n "$published_tip" && "$published_tip" == "$local_tip" ]]; then
    set_phase source-published
    return 0
  fi

  if [[ -n "$published_tip" ]] && \
    ! git merge-base --is-ancestor "$published_tip" HEAD >/dev/null 2>&1; then
    local -a pull_args=(-t "$(state_get timeout)")
    [[ "$(state_get verbose)" == true ]] && pull_args+=(-v)
    if "$SCRIPT_DIR/pull" "${pull_args[@]}" && run_push; then
      set_phase source-published
      return 0
    fi
  fi

  set_phase source-publish-failed
  write_partial_report "The parent and local source were updated, but the source was not published." \
    "Resolve the pull/push error shown above; safe remote divergence is reconciled automatically on continue."
  exit "$EXIT_PARTIAL"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --continue) CONTINUE=true; shift ;;
    -o) OWNER_OVERRIDE=true; shift ;;
    -v) VERBOSE=true; shift ;;
    -t)
      [[ $# -ge 2 && "$2" =~ ^[0-9]+$ && "$2" -gt 0 ]] || { usage >&2; exit "$EXIT_USAGE"; }
      TIMEOUT_SECONDS="$2"; shift 2 ;;
    -c)
      [[ $# -ge 2 && -z "$COMMENT_MODE" ]] || { usage >&2; exit "$EXIT_USAGE"; }
      COMMENT_MODE=option; COMMENT="$2"; shift 2 ;;
    --)
      shift
      [[ $# -gt 0 && -z "$COMMENT_MODE" ]] || { usage >&2; exit "$EXIT_USAGE"; }
      COMMENT_MODE=tokens; COMMENT="$*"; break ;;
    *) usage >&2; exit "$EXIT_USAGE" ;;
  esac
done

if [[ "$CONTINUE" == true && ( "$OWNER_OVERRIDE" == true || "$VERBOSE" == true || \
  "$TIMEOUT_SECONDS" != 10 || -n "$COMMENT_MODE" ) ]]; then
  usage >&2
  exit "$EXIT_USAGE"
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$REPO_ROOT" ]] || { echo "Error: pushup must run in a Git repository." >&2; exit "$EXIT_USAGE"; }
REPORTS_DIR="$REPO_ROOT/reports"
STATE_FILE="$(git rev-parse --git-path briteTest/pushup.state)"
LOCK_FILE="$(git rev-parse --git-path briteTest/pushup.lock)"
mkdir -p "$(dirname "$STATE_FILE")"
exec {LOCK_FD}>"$LOCK_FILE"
flock -n "$LOCK_FD" || { echo "Error: another pushup process is active." >&2; exit "$EXIT_ACTIVE"; }

if [[ "$CONTINUE" == false ]]; then
  [[ ! -f "$STATE_FILE" ]] || {
    echo "Error: a partial push-up workflow exists; run pushup --continue." >&2
    exit "$EXIT_ACTIVE"
  }
  source_branch="$(bt_get_current_branch || true)"
  [[ -n "$source_branch" && "$source_branch" != HEAD ]] || exit "$EXIT_USAGE"
  parent_branch="$(bt_resolve_parent_branch "$source_branch" main)"
  [[ -n "$parent_branch" ]] || exit "$EXIT_USAGE"
  : > "$STATE_FILE"
  state_set phase initialized
  state_set source "$source_branch"
  state_set parent "$parent_branch"
  state_set source-tip "$(git rev-parse "refs/heads/$source_branch")"
  state_set parent-tip "$(git rev-parse "refs/heads/$parent_branch")"
  state_set notes-tip "$(git rev-parse -q --verify refs/notes/briteTest-workflow 2>/dev/null || true)"
  state_set timeout "$TIMEOUT_SECONDS"
  state_set verbose "$VERBOSE"
  state_set owner-override "$OWNER_OVERRIDE"
  state_set comment-mode "$COMMENT_MODE"
  [[ -z "$COMMENT_MODE" ]] || state_set comment "$COMMENT"
else
  [[ -f "$STATE_FILE" ]] || {
    echo "Error: no partial push-up workflow is available to continue." >&2
    exit "$EXIT_NOTHING_TO_CONTINUE"
  }
fi

phase="$(state_get phase)"
if [[ "$phase" == publication-uncertain ]]; then
  expected_tip="$(state_get prepared-parent-tip)"
  current_remote_tip="$(remote_tip "$(state_get parent)" || true)"
  if [[ -z "$current_remote_tip" ]]; then
    write_partial_report "The earlier parent push remains unverified." \
      "Restore remote access so pushup can determine whether publication occurred."
    exit "$EXIT_PARTIAL"
  elif [[ "$current_remote_tip" == "$expected_tip" ]]; then
    set_phase parent-published
  else
    fail_before_publication "the earlier parent push did not publish the prepared commit"
  fi
fi

phase="$(state_get phase)"
if [[ "$phase" == initialized ]]; then
  if ! prepare_parent; then
    fail_before_publication "merge-up prerequisites failed or local preparation did not complete"
  fi
  set_phase parent-prepared
fi

[[ "$(state_get phase)" != parent-prepared ]] || publish_parent
[[ "$(state_get phase)" != parent-published ]] || select_source

phase="$(state_get phase)"
if [[ "$phase" == source-selected || "$phase" == source-sync-failed ]]; then
  synchronize_source
elif [[ "$phase" == source-conflicted ]]; then
  finish_resolved_merge
fi

phase="$(state_get phase)"
if [[ "$phase" == source-synchronized || "$phase" == source-publish-failed ]]; then
  publish_source
fi

if [[ "$(state_get phase)" == source-published ]]; then
  source_branch="$(state_get source)"
  parent_branch="$(state_get parent)"
  rm -f "$STATE_FILE"
  echo "Push-up complete: $source_branch pushed up to $parent_branch and resynchronized."
  exit 0
fi

write_partial_report "Pushup stopped in an unrecognized saved phase: $(state_get phase)." \
  "Inspect the saved state at $STATE_FILE before retrying."
exit "$EXIT_INTERNAL"