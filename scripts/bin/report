#!/usr/bin/env bash

# report - Generate reports from recorded workflow activity.
#
# High-Level Flow:
# - Resolve the selected local branch or chbranch-selected remote snapshot.
# - Read recorded commits and completed workflow activity newest first.
# - Apply type/user/text filters, select the newest limit, then optionally
#   reverse only the selected output.
# - Write one retained branch-history report; never mutate workflow history.
#
# See usage below for details, or run: report -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  report [OPTIONS] [TYPE]
  report {-h | --help}

Generate a report of activity for the branch selected by chbranch. Activity
includes commits and completed pull, push, mrgup, mrgdown, copyfix, and
retarget workflows.

Each activity appears once in the report, including when TYPE is all.

Prerequisites:
  - Run report from a briteTest clone with a local branch or remote snapshot
    branch selected by chbranch.

Argument:
  TYPE        Activity type: commit, pull, push, mrgup, mrgdown,
              copyfix, retarget, all (default: all).
              TYPE may appear before or after options, but may be specified
              only once.

Options:
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored).
  -u USER     Include activity whose associated user contains USER.
              Matching is case-insensitive. Activity without a recorded user
              does not match.
  -q TEXT     Include activity whose summary or details contain TEXT.
              Matching is case-insensitive.
  -l N        Limit the report to N matching activities (default: 1).
              N must be 0 or greater; 0 means no limit. The newest N matches
              are selected before report order is applied.
  -r          Write selected activity oldest first (default: newest first).
              This changes report order, not which activity -l selects.
  -v          Output progress and diagnostics to stdout.

Examples:
  report
  report -u testuser -q "authentication" -l 10
  report push -l 2
  report all -v

Outputs:
  - Writes errors and diagnostics to stderr.
  - Writes verbose (-v) progress and diagnostics to stdout.
  - Writes a retained report under '<repo>/reports/branch/' when matching
    activity exists. Existing history reports are not replaced or deleted.
  - Writes 'See <reportpath> for details.' to stdout when a report is written.

Exit codes:
  0    Success (report written, -h/--help).
  1    Argument or validation error.
  3    No matching activity was found.
  200  Failed to read recorded activity.
  201  Failed to create or write the report.
EOF
}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BRANCH_REPORTS_DIR="$REPO_ROOT/reports/branch"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"

# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_OPERATION_FAILED=3
readonly EXIT_HISTORY_READ_FAILED=200
readonly EXIT_REPORT_WRITE_FAILED=201

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

is_non_negative_integer() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

contains_ci() {
  local haystack="$1"
  local needle="$2"
  local hay_lc=""
  local needle_lc=""

  hay_lc="$(printf '%s' "$haystack" | tr '[:upper:]' '[:lower:]')"
  needle_lc="$(printf '%s' "$needle" | tr '[:upper:]' '[:lower:]')"
  [[ "$hay_lc" == *"$needle_lc"* ]]
}

activity_type() {
  local command_line="$1"
  local command_name="${command_line%% *}"

  case "$command_name" in
    pull|push|mrgup|mrgdown|copyfix|retarget)
      printf '%s\n' "$command_name"
      ;;
    *)
      printf 'commit\n'
      ;;
  esac
}

workflow_note_records() {
  awk '
    /^--- briteTest workflow ---$/ {
      if (record != "") {
        records[++count] = record
      }
      record = $0 ORS
      next
    }
    record != "" {
      record = record $0 ORS
    }
    END {
      if (record != "") {
        records[++count] = record
      }
      for (item = count; item >= 1; item--) {
        printf "%s%c", records[item], 30
      }
    }
  '
}

workflow_event_details() {
  awk '
    /^--- briteTest workflow ---$/ { next }
    /^(Workflow-Type|Workflow-Time|Workflow-Branch|Workflow-User|Command-Line|Summary):/ {
      next
    }
    NF > 0 { print }
  '
}

recorded_field_value() {
  local body="$1"
  local key="$2"
  local value=""
  local line=""

  while IFS= read -r line; do
    if [[ "$line" =~ ^${key}:[[:space:]]*(.*)$ ]]; then
      value="${BASH_REMATCH[1]}"
    fi
  done <<< "$body"

  printf '%s' "$value"
}

TYPE_FILTER="all"
FILTER_USER=""
FILTER_TEXT=""
LIMIT=1
REVERSE=false
VERBOSE=false
TYPE_SPECIFIED=false

for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    usage
    exit 0
  fi
done

while [[ $# -gt 0 ]]; do
  case "$1" in
    -u)
      [[ $# -ge 2 ]] || usage_error "Option -u requires USER"
      FILTER_USER="$2"
      shift 2
      ;;
    -q)
      [[ $# -ge 2 ]] || usage_error "Option -q requires TEXT"
      FILTER_TEXT="$2"
      shift 2
      ;;
    -l)
      [[ $# -ge 2 ]] || usage_error "Option -l requires N"
      is_non_negative_integer "$2" || usage_error "N for -l must be an integer >= 0"
      LIMIT="$2"
      shift 2
      ;;
    -r)
      REVERSE=true
      shift
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      [[ "$TYPE_SPECIFIED" == false ]] || usage_error "TYPE may be specified only once"
      TYPE_FILTER="$1"
      TYPE_SPECIFIED=true
      shift
      ;;
  esac
done

case "$TYPE_FILTER" in
  commit|pull|push|mrgup|mrgdown|copyfix|retarget|all)
    ;;
  *)
    usage_error "Unsupported TYPE '$TYPE_FILTER'"
    ;;
esac

TARGET_REF="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
HISTORY_REF="$TARGET_REF"
if [[ -z "$TARGET_REF" ]]; then
  remote_refs="$(git for-each-ref --format='%(refname:short)' \
    --points-at HEAD refs/remotes/origin 2>/dev/null | \
    grep -v '^origin/HEAD$' || true)"
  remote_count="$(printf '%s\n' "$remote_refs" | sed '/^$/d' | wc -l | tr -d ' ')"
  remembered_branch="$(git config --local --get chbranch.lastBranch \
    2>/dev/null || true)"
  if [[ "$remote_count" == "1" ]]; then
    HISTORY_REF="$(printf '%s\n' "$remote_refs" | sed '/^$/d' | head -n 1)"
  elif [[ "$remote_count" -gt 1 && -n "$remembered_branch" ]] && \
    printf '%s\n' "$remote_refs" | grep -Fxq "origin/$remembered_branch"; then
    HISTORY_REF="origin/$remembered_branch"
  else
    usage_error "Could not resolve current remote snapshot branch"
  fi
  TARGET_REF="${HISTORY_REF#origin/}"
fi
[[ -n "$TARGET_REF" ]] || usage_error "Could not resolve current branch/ref"

if ! git rev-parse --verify "$HISTORY_REF" >/dev/null 2>&1; then
  usage_error "Selected branch is not available: $TARGET_REF"
fi

log_format='%H%x1f%h%x1f%ad%x1f%an%x1f%ae%x1f%s%x1f%B%x1e'
git_log_args=(
  "$HISTORY_REF"
  --date=format:'%Y-%m-%d %H:%M:%S'
  --pretty=format:"$log_format"
)
if ! history="$(git log "${git_log_args[@]}" 2>/dev/null)"; then
  bt_warn "Failed to read repository history"
  exit "$EXIT_HISTORY_READ_FAILED"
fi

entries=()

while IFS= read -r -d $'\x1e' row; do
  while [[ "$row" == $'\n'* ]]; do
    row="${row#$'\n'}"
  done
  [[ -n "$row" ]] || continue
  sep=$'\x1f'
  full_hash="${row%%"$sep"*}"
  row="${row#*"$sep"}"
  short_hash="${row%%"$sep"*}"
  row="${row#*"$sep"}"
  date_text="${row%%"$sep"*}"
  row="${row#*"$sep"}"
  author_name="${row%%"$sep"*}"
  row="${row#*"$sep"}"
  author_email="${row%%"$sep"*}"
  row="${row#*"$sep"}"
  subject="${row%%"$sep"*}"
  body="${row#*"$sep"}"

  note="$(git notes --ref=briteTest-workflow show "$full_hash" 2>/dev/null || true)"
  if [[ -n "$note" ]]; then
    while IFS= read -r -d $'\x1e' note_record; do
      note_type="$(recorded_field_value "$note_record" "Workflow-Type")"
      note_date="$(recorded_field_value "$note_record" "Workflow-Time")"
      note_branch="$(recorded_field_value "$note_record" "Workflow-Branch")"
      note_user="$(recorded_field_value "$note_record" "Workflow-User")"
      note_command="$(recorded_field_value "$note_record" "Command-Line")"
      note_summary="$(recorded_field_value "$note_record" "Summary")"
      note_details="$(printf '%s\n' "$note_record" | workflow_event_details)"

      [[ "$note_branch" == "$TARGET_REF" ]] || continue
      if [[ "$TYPE_FILTER" != "all" && "$note_type" != "$TYPE_FILTER" ]]; then
        continue
      fi
      if [[ -n "$FILTER_USER" ]] && \
        ! contains_ci "$note_user $note_summary $note_details" "$FILTER_USER"; then
        continue
      fi
      if [[ -n "$FILTER_TEXT" ]] && \
        ! contains_ci "$note_summary $note_details $note_command" "$FILTER_TEXT"; then
        continue
      fi

      printf -v entry '## %s: %s\n\n' "$note_type" "$note_date"
      printf -v line '**Commit:** `%s`  \n**User:** %s  \n**Summary:** %s\n' \
        "$short_hash" "$note_user" "$note_summary"
      entry+="$line"
      printf -v line '\n**Command:** `%s`\n' "$note_command"
      entry+="$line"
      if [[ -n "$note_details" ]]; then
        entry+=$'\n### Details\n\n'
        entry+="$note_details"
        entry+=$'\n'
      fi
      entries+=("$entry")

      if [[ "$LIMIT" -gt 0 && "${#entries[@]}" -ge "$LIMIT" ]]; then
        break
      fi
    done < <(printf '%s\n' "$note" | workflow_note_records)
  fi

  if [[ "$LIMIT" -gt 0 && "${#entries[@]}" -ge "$LIMIT" ]]; then
    break
  fi

  command_line="$(recorded_field_value "$body" "Command-Line")"
  entry_type="$(activity_type "$command_line")"
  if [[ "$TYPE_FILTER" != "all" && "$entry_type" != "$TYPE_FILTER" ]]; then
    continue
  fi

  if [[ -n "$FILTER_USER" ]]; then
    if ! contains_ci "$author_name $author_email $subject $body" "$FILTER_USER"; then
      continue
    fi
  fi

  if [[ -n "$FILTER_TEXT" ]]; then
    if ! contains_ci "$subject $body" "$FILTER_TEXT"; then
      continue
    fi
  fi

  printf -v entry '## %s: %s\n\n' "$entry_type" "$date_text"
  printf -v line '**Commit:** `%s`  \n**User:** %s <%s>  \n**Summary:** %s\n' \
    "$short_hash" "$author_name" "$author_email" "$subject"
  entry+="$line"
  if [[ -n "$command_line" ]]; then
    printf -v line '\n**Command:** `%s`\n' "$command_line"
    entry+="$line"
  fi
  if [[ -n "$body" ]]; then
    entry+=$'\n### Details\n\n'
    entry+="$body"
    entry+=$'\n'
  fi
  entries+=("$entry")

  if [[ "$LIMIT" -gt 0 && "${#entries[@]}" -ge "$LIMIT" ]]; then
    break
  fi
done < <(printf '%s' "$history")

if [[ "${#entries[@]}" -eq 0 ]]; then
  bt_warn "No matching activity was found"
  exit "$EXIT_OPERATION_FAILED"
fi

report_timestamp="$(date '+%Y%m%d-%H%M%S')"
report_file="$(bt_report_retained_path "$BRANCH_REPORTS_DIR" "history" "$report_timestamp")"
report_rel="${report_file#"${REPO_ROOT}"/}"

bt_report_dir_enable_writes "$BRANCH_REPORTS_DIR" "$EXIT_REPORT_WRITE_FAILED"
if ! {
  printf '# Branch History Report\n\n'
  printf '**Branch:** `%s`  \n' "$TARGET_REF"
  printf '**Type:** `%s`  \n' "$TYPE_FILTER"
  printf '**Generated:** %s\n\n' "$RUN_TS_DISPLAY"
  if [[ "$REVERSE" == true ]]; then
    for ((index=${#entries[@]} - 1; index >= 0; index--)); do
      printf '%s\n' "${entries[index]}"
    done
  else
    for entry in "${entries[@]}"; do
      printf '%s\n' "$entry"
    done
  fi
} > "$report_file"; then
  bt_warn "Failed to write report: $report_rel"
  exit "$EXIT_REPORT_WRITE_FAILED"
fi

if [[ "$VERBOSE" == true ]]; then
  bt_info "Found ${#entries[@]} matching activities"
fi
printf 'See %s for details.\n' "$report_rel"
exit 0
