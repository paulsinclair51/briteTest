#!/usr/bin/env bash

# report - Generate workflow reports from git commit history.
#
# See usage below for details, or run: report -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  report [OPTIONS]
  report {-h | --help}

Generate workflow reports from git commit history and commit metadata trailers.

Options:
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored).
  -T TYPE     Event type filter (default: commit).
              Supported: commit, push, all
  -b REF      Git branch/ref to inspect (default: current branch)
  -u USER     Filter by user (literal substring match)
  -q TEXT     Filter by literal text in subject/body
  -l N        Limit results to N entries (0 = no limit, default: 0)
  -r          Sort ascending (oldest first, default: newest first)
  -o FILE     Write results to FILE instead of stdout
  -v          Verbose output (includes metadata and body snippets)

Examples:
  report
  report -b dev/release-v1.0.0 -l 25
  report -u testuser -q "Files-Modified" -l 10
  report -T push -l 1 -v
  report -T all -v

Exit codes:
  0   Success
  1   Argument or validation error
  3   No entries found matching criteria
EOF
}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BRANCH_REPORTS_DIR="$REPO_ROOT/reports/branch"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"

# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_OPERATION_FAILED=3

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

is_non_negative_integer() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

contains_ci() {
  local haystack="$1"
  local needle="$2"
  local hay_lc=""
  local needle_lc=""

  hay_lc="$(printf '%s' "$haystack" | tr '[:upper:]' '[:lower:]')"
  needle_lc="$(printf '%s' "$needle" | tr '[:upper:]' '[:lower:]')"
  [[ "$hay_lc" == *"$needle_lc"* ]]
}

build_commit_note() {
  local file_path="$1"
  local added="$2"
  local removed="$3"
  local change_text
  local scope_text

  if [[ "$added" -gt 0 && "$removed" -eq 0 ]]; then
    change_text="Added new content"
  elif [[ "$added" -eq 0 && "$removed" -gt 0 ]]; then
    change_text="Removed existing content"
  else
    change_text="Updated existing content"
  fi

  case "$file_path" in
    *.md)
      scope_text="documentation"
      ;;
    scripts/bin/* | scripts/helpers/* | *.sh)
      scope_text="script logic"
      ;;
    src/*.[ch] | include/*.[ch])
      scope_text="C source implementation"
      ;;
    *)
      scope_text="file content"
      ;;
  esac

  printf '%s in %s\n' "$change_text" "$scope_text"
}

get_total_lines_for_commit_file() {
  local commit_hash="$1"
  local file_path="$2"

  if git cat-file -e "${commit_hash}:${file_path}" >/dev/null 2>&1; then
    git show "${commit_hash}:${file_path}" | wc -l | tr -d ' '
  else
    printf ''
  fi
}

append_commit_table_header() {
  local out_file="$1"

  cat >> "$out_file" <<'EOF'
| **File** | **Added** | **Deleted** | **Net** | **Total** | **Notes** |
| --- | --- | --- | --- | --- | --- |
EOF
}

write_commit_report_row() {
  local out_file="$1"
  local file_path="$2"
  local added="$3"
  local removed="$4"
  local total_lines="$5"
  local notes="$6"
  local net

  net=$((added - removed))
  printf '| %s | %s | %s | %+d | %s | %s |\n' \
    "$file_path" "$added" "$removed" \
    "$net" "$total_lines" "$notes" >> "$out_file"
}

extract_user_comment_from_body() {
  local body="$1"
  local in_section=false
  local line=""
  local comment=""

  while IFS= read -r line; do
    if [[ "$line" == "## User Comment" ]]; then
      in_section=true
      continue
    fi
    if [[ "$in_section" == true && "$line" == "## Summary" ]]; then
      break
    fi
    if [[ "$in_section" != true ]]; then
      continue
    fi

    if [[ "$line" == "> "* ]]; then
      line="${line#> }"
    elif [[ "$line" == ">" ]]; then
      line=""
    else
      continue
    fi

    if [[ -z "$comment" ]]; then
      comment="$line"
    else
      comment+=$'\n'
      comment+="$line"
    fi
  done <<< "$body"

  printf '%s' "$comment"
}

escape_markdown_table_cell() {
  local text="$1"

  text="${text//$'\n'/<br>}"
  text="${text//|/\\|}"
  text="${text//$'\r'/}"

  printf '%s' "$text"
}

build_command_line_with_comment() {
  local command_template="$1"
  local user_comment="$2"
  local user_comment_oneline=""

  user_comment_oneline="${user_comment//$'\n'/\\n}"

  if [[ -z "$command_template" ]]; then
    command_template="commit -- <user-comment>"
  fi

  printf '%s' "${command_template//<user-comment>/$user_comment_oneline}"
}

build_commit_timestamp_token() {
  local date_text="$1"
  printf '%s' "$date_text" | tr -d '-' | tr -d ':' | tr ' ' '-'
}

resolve_unique_commit_hash_token() {
  local full_hash="$1"
  local length=7
  local token=""
  local resolved=""

  full_hash="$(printf '%s' "$full_hash" | tr -d '\r\n')"

  while [[ "$length" -le 40 ]]; do
    token="${full_hash:0:$length}"
    resolved="$(git rev-parse --verify --quiet "${token}^{commit}" 2>/dev/null || true)"
    resolved="$(printf '%s' "$resolved" | tr -d '\r\n')"
    if [[ "$resolved" == "$full_hash" ]]; then
      printf '%s' "$token"
      return 0
    fi
    length=$((length + 1))
  done

  printf '%s' "$full_hash"
}

write_legacy_single_commit_report() {
  local out_file="$1"
  local target_ref="$2"
  local short_hash="$3"
  local full_hash="$4"
  local files_modified="$5"
  local files_added="$6"
  local files_deleted="$7"
  local command_line="$8"
  local commit_date_text="$9"

  local summary_text
  local total_rows

  total_rows=$(( ${files_modified:-0} + ${files_added:-0} + ${files_deleted:-0} ))
  summary_text="${files_modified:-0} modified, ${files_added:-0} added, ${files_deleted:-0} deleted, and ${total_rows} total."

  cat > "$out_file" <<EOF
# Commit Report

**Commit:** \`${full_hash}\` at ${commit_date_text}.

**Command:** \`${command_line}\`

**Branch:** \`${target_ref}\` (local)

**Files:** ${summary_text}
EOF

  printf '\n## Commit\n\n' >> "$out_file"
  append_commit_table_header "$out_file"

  while IFS=$'\t' read -r added removed file_path; do
    [[ -n "$file_path" ]] || continue

    if [[ "$added" == "-" || "$added" == "" ]]; then
      added=0
    fi
    if [[ "$removed" == "-" || "$removed" == "" ]]; then
      removed=0
    fi

    local total_lines
    local notes
    total_lines="$(get_total_lines_for_commit_file "$full_hash" "$file_path")"
    notes="$(build_commit_note "$file_path" "$added" "$removed")"
    notes="${notes//|/\\|}"

    write_commit_report_row "$out_file" "$file_path" \
      "$added" "$removed" "$total_lines" "$notes"
  done < <(git show --pretty='' --numstat "$full_hash")
}

resolve_legacy_report_path() {
  local commit_timestamp_token="$1"
  local commit_hash_token="$2"

  bt_report_dir_enable_writes "$BRANCH_REPORTS_DIR" "$EXIT_INVALID_ARGUMENT"
  printf '%s/commit-%s-%s.md\n' "$BRANCH_REPORTS_DIR" "$commit_timestamp_token" "$commit_hash_token"
}

resolve_push_report_path() {
  local push_timestamp_token="$1"
  local push_hash_token="$2"

  bt_report_dir_enable_writes "$BRANCH_REPORTS_DIR" "$EXIT_INVALID_ARGUMENT"
  printf '%s/push-%s-%s.md\n' "$BRANCH_REPORTS_DIR" "$push_timestamp_token" "$push_hash_token"
}

get_total_lines_for_ref_file() {
  local ref_hash="$1"
  local file_path="$2"

  if git cat-file -e "${ref_hash}:${file_path}" >/dev/null 2>&1; then
    git show "${ref_hash}:${file_path}" | wc -l | tr -d ' '
  else
    printf '0'
  fi
}

emit_last_push_report() {
  local target_ref="$1"
  local output_file="$2"

  local push_reflog_ref="refs/remotes/origin/${target_ref}"
  local push_rows=""
  local latest_push_tip=""
  local previous_push_tip=""
  local latest_push_time=""
  local latest_push_time_token=""
  local latest_push_hash_token=""
  local commits_pushed=0
  local report_path=""
  local report_rel=""
  local file_path=""
  local files_pushed=0
  local added=0
  local deleted=0
  local net=0
  local total_lines=0
  local num_added=""
  local num_deleted=""
  local _rest=""

  push_rows="$(git reflog show --grep-reflog='update by push' \
    --date=format:'%Y-%m-%d %H:%M:%S' --format='%H%x1f%ad' \
    "$push_reflog_ref" 2>/dev/null || true)"
  if [[ -z "$push_rows" ]]; then
    bt_warn "No push history found for ${target_ref}"
    exit "$EXIT_OPERATION_FAILED"
  fi

  latest_push_tip="$(printf '%s\n' "$push_rows" | head -n 1 | awk -F $'\x1f' '{print $1}')"
  previous_push_tip="$(printf '%s\n' "$push_rows" | head -n 2 | tail -n 1 | awk -F $'\x1f' '{print $1}')"
  latest_push_time="$(printf '%s\n' "$push_rows" | head -n 1 | awk -F $'\x1f' '{print $2}')"

  if [[ -z "$latest_push_tip" || -z "$previous_push_tip" ]]; then
    bt_warn "Insufficient push history to reconstruct last push for ${target_ref}"
    exit "$EXIT_OPERATION_FAILED"
  fi

  if ! git rev-parse --verify "$latest_push_tip^{commit}" >/dev/null 2>&1 || \
     ! git rev-parse --verify "$previous_push_tip^{commit}" >/dev/null 2>&1; then
    bt_warn "Unable to resolve push history commits for ${target_ref}"
    exit "$EXIT_OPERATION_FAILED"
  fi

  commits_pushed="$(git rev-list --count "${previous_push_tip}..${latest_push_tip}" 2>/dev/null || echo 0)"
  if [[ "$commits_pushed" == "0" ]]; then
    bt_warn "No commits found in last push range for ${target_ref}"
    exit "$EXIT_OPERATION_FAILED"
  fi

  files_pushed="$(git diff --name-only --find-renames "${previous_push_tip}..${latest_push_tip}" 2>/dev/null | sed '/^$/d' | wc -l | tr -d ' ')"
  [[ "$files_pushed" =~ ^[0-9]+$ ]] || files_pushed=0

  latest_push_time_token="$(build_commit_timestamp_token "$latest_push_time")"
  latest_push_hash_token="$(resolve_unique_commit_hash_token "$latest_push_tip")"

  if [[ -n "$output_file" ]]; then
    report_path="$output_file"
    mkdir -p "$(dirname "$report_path")"
  else
    report_path="$(resolve_push_report_path "$latest_push_time_token" "$latest_push_hash_token")"
  fi

  cat > "$report_path" <<EOF
# Push Report

**Push Tip:** \`${latest_push_tip}\` at ${latest_push_time}.
**Command:** \`push\`  
**Branch:** \`${target_ref}\`  
**Commits:** ${commits_pushed}  
**Files:** ${files_pushed}

<details>
<summary><strong>Commits</strong></summary>

## Commits

| Commit Hash | DateTime | Comment |
| --- | --- | --- |
EOF

  while IFS= read -r commit_hash; do
    [[ -n "$commit_hash" ]] || continue
    commit_date="$(git log -1 --format='%ci' "$commit_hash" 2>/dev/null || true)"
    commit_body="$(git log -1 --format=%B "$commit_hash" 2>/dev/null || true)"
    commit_comment="$(extract_user_comment_from_body "$commit_body")"
    if [[ -z "$commit_comment" ]]; then
      commit_comment="$(git log -1 --format=%s "$commit_hash" 2>/dev/null || true)"
    fi
    commit_comment="$(escape_markdown_table_cell "$commit_comment")"
    printf '| `%s` | %s | %s |\n' "$commit_hash" "$commit_date" "$commit_comment" >> "$report_path"
  done < <(git rev-list --reverse "${previous_push_tip}..${latest_push_tip}" 2>/dev/null || true)

  cat >> "$report_path" <<EOF

</details>

<details>
<summary><strong>Files</strong></summary>

## Files

| File | Commit | Added | Deleted | Net | Total Lines |
| --- | --- | ---: | ---: | ---: | ---: |
EOF

  while IFS= read -r file_path; do
    [[ -n "$file_path" ]] || continue

    added=0
    deleted=0
    while IFS=$'\t' read -r num_added num_deleted _rest; do
      [[ "$num_added" =~ ^[0-9]+$ ]] && added=$((added + num_added))
      [[ "$num_deleted" =~ ^[0-9]+$ ]] && deleted=$((deleted + num_deleted))
    done < <(git diff --numstat --find-renames "${previous_push_tip}..${latest_push_tip}" -- "$file_path" 2>/dev/null || true)

    net=$((added - deleted))
    total_lines="$(get_total_lines_for_ref_file "$latest_push_tip" "$file_path")"
    commit_hash="$(git log -1 --format='%h' "${previous_push_tip}..${latest_push_tip}" -- "$file_path" 2>/dev/null || true)"
    printf '| `%s` | `%s` | %s | %s | %s | %s |\n' \
      "$file_path" "$commit_hash" "$added" "$deleted" "$net" "$total_lines" >> "$report_path"
  done < <(git diff --name-only --find-renames "${previous_push_tip}..${latest_push_tip}" 2>/dev/null || true)

  {
    echo
    echo "</details>"
  } >> "$report_path"

  if [[ "$VERBOSE" == true ]]; then
    {
      echo
      echo "## Commit Details"
      echo
      git log --oneline "${previous_push_tip}..${latest_push_tip}" | sed 's/^/- /'
    } >> "$report_path"
  fi

  if [[ -n "$output_file" ]]; then
    bt_success "Results written to $output_file"
  else
    report_rel="${report_path#"${REPO_ROOT}"/}"
    bt_success "Results written to $report_rel"
  fi
  bt_success "Found 1 matching entries"
  exit 0
}

extract_trailer_value() {
  local body="$1"
  local key="$2"
  local value=""
  local line=""

  while IFS= read -r line; do
    if [[ "$line" =~ ^${key}:[[:space:]]*(.*)$ ]]; then
      value="${BASH_REMATCH[1]}"
    fi
  done <<< "$body"

  printf '%s' "$value"
}

build_verbose_entry() {
  local short_hash="$1"
  local full_hash="$2"
  local date_text="$3"
  local author_name="$4"
  local author_email="$5"
  local subject="$6"
  local body="$7"
  local files_modified="$8"
  local files_added="$9"
  local files_deleted="${10}"
  local lines_added="${11}"
  local lines_deleted="${12}"
  local pr_number="${13}"
  local command_line="${14}"

  printf -- '- [%s] %s %s\n' "$date_text" "$short_hash" "$subject"
  printf -- '  - Commit: %s\n' "$full_hash"
  printf -- '  - Author: %s <%s>\n' "$author_name" "$author_email"
  if [[ -n "$command_line" ]]; then
    printf -- '  - Command line: %s\n' "$command_line"
  fi
  if [[ -n "$files_modified" || -n "$files_added" || -n "$files_deleted" ]]; then
    printf -- '  - Files: modified=%s, added=%s, deleted=%s\n' \
      "${files_modified:-0}" "${files_added:-0}" "${files_deleted:-0}"
  fi
  if [[ -n "$lines_added" || -n "$lines_deleted" ]]; then
    printf -- '  - Lines: added=%s, deleted=%s\n' \
      "${lines_added:-0}" "${lines_deleted:-0}"
  fi
  if [[ -n "$pr_number" ]]; then
    printf -- '  - PR: %s\n' "$pr_number"
  fi

  if [[ -n "$body" ]]; then
    printf -- '  - Body:\n'
    while IFS= read -r line; do
      printf -- '    %s\n' "$line"
    done <<< "$body"
  fi
}

TYPE_FILTER="commit"
TARGET_REF=""
FILTER_USER=""
FILTER_TEXT=""
LIMIT=0
REVERSE=false
OUTPUT_FILE=""
VERBOSE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -T)
      [[ $# -ge 2 ]] || usage_error "Option -T requires TYPE"
      TYPE_FILTER="$2"
      shift 2
      ;;
    -b)
      [[ $# -ge 2 ]] || usage_error "Option -b requires REF"
      TARGET_REF="$2"
      shift 2
      ;;
    -u)
      [[ $# -ge 2 ]] || usage_error "Option -u requires USER"
      FILTER_USER="$2"
      shift 2
      ;;
    -q)
      [[ $# -ge 2 ]] || usage_error "Option -q requires TEXT"
      FILTER_TEXT="$2"
      shift 2
      ;;
    -l)
      [[ $# -ge 2 ]] || usage_error "Option -l requires N"
      is_non_negative_integer "$2" || usage_error "N for -l must be an integer >= 0"
      LIMIT="$2"
      shift 2
      ;;
    -r)
      REVERSE=true
      shift
      ;;
    -o)
      [[ $# -ge 2 ]] || usage_error "Option -o requires FILE"
      OUTPUT_FILE="$2"
      shift 2
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      usage_error "Unknown argument: $1"
      ;;
  esac
done

case "$TYPE_FILTER" in
  commit|push|all)
    ;;
  *)
    usage_error "Unsupported TYPE '$TYPE_FILTER' (supported: commit, push, all)"
    ;;
esac

if [[ -z "$TARGET_REF" ]]; then
  TARGET_REF="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
fi
[[ -n "$TARGET_REF" ]] || usage_error "Could not resolve current branch/ref"

if ! git rev-parse --verify "$TARGET_REF" >/dev/null 2>&1; then
  usage_error "Git ref not found: $TARGET_REF"
fi

if [[ "$TYPE_FILTER" == "push" ]]; then
  if [[ "$VERBOSE" != true || "$LIMIT" -ne 1 ]]; then
    usage_error "TYPE 'push' requires -l 1 -v"
  fi
  emit_last_push_report "$TARGET_REF" "$OUTPUT_FILE"
fi

log_format='%H%x1f%h%x1f%ad%x1f%an%x1f%ae%x1f%s%x1f%B%x1e'
git_log_args=(
  "$TARGET_REF"
  --date=format:'%Y-%m-%d %H:%M:%S'
  --pretty=format:"$log_format"
)
if [[ "$REVERSE" == true ]]; then
  git_log_args+=(--reverse)
fi

if [[ -z "$(git log "${git_log_args[@]}")" ]]; then
  bt_warn "No commit entries found"
  exit "$EXIT_OPERATION_FAILED"
fi

rendered_output=""
match_count=0
first_match_short_hash=""
first_match_full_hash=""
first_match_files_modified=""
first_match_files_added=""
first_match_files_deleted=""
first_match_date_text=""
first_match_command_line=""
first_match_body=""

while IFS= read -r -d $'\x1e' row; do
  [[ -n "$row" ]] || continue
  sep=$'\x1f'
  full_hash="${row%%$sep*}"
  row="${row#*$sep}"
  short_hash="${row%%$sep*}"
  row="${row#*$sep}"
  date_text="${row%%$sep*}"
  row="${row#*$sep}"
  author_name="${row%%$sep*}"
  row="${row#*$sep}"
  author_email="${row%%$sep*}"
  row="${row#*$sep}"
  subject="${row%%$sep*}"
  body="${row#*$sep}"

  if [[ "$TYPE_FILTER" == "commit" ]] && [[ "$subject" != *" committed by "* ]]; then
    continue
  fi

  if [[ -n "$FILTER_USER" ]]; then
    if ! contains_ci "$author_name $author_email $subject $body" "$FILTER_USER"; then
      continue
    fi
  fi

  if [[ -n "$FILTER_TEXT" ]]; then
    if ! contains_ci "$subject $body" "$FILTER_TEXT"; then
      continue
    fi
  fi

  files_modified="$(extract_trailer_value "$body" "Files-Modified")"
  files_added="$(extract_trailer_value "$body" "Files-Added")"
  files_deleted="$(extract_trailer_value "$body" "Files-Deleted")"
  lines_added="$(extract_trailer_value "$body" "Lines-Added")"
  lines_deleted="$(extract_trailer_value "$body" "Lines-Deleted")"
  pr_number="$(extract_trailer_value "$body" "PR")"
  command_line="$(extract_trailer_value "$body" "Command-Line")"

  if [[ "$VERBOSE" == true ]]; then
    rendered_output+="$(build_verbose_entry "$short_hash" "$full_hash" "$date_text" "$author_name" "$author_email" "$subject" "$body" "$files_modified" "$files_added" "$files_deleted" "$lines_added" "$lines_deleted" "$pr_number" "$command_line")"
  else
    line="[$date_text] $short_hash $subject"
    if [[ -n "$pr_number" ]]; then
      line+=" (PR: $pr_number)"
    fi
    rendered_output+="$line"
    rendered_output+=$'\n'
  fi

  match_count=$((match_count + 1))
  if [[ "$match_count" -eq 1 ]]; then
    first_match_short_hash="$short_hash"
    first_match_full_hash="$full_hash"
    first_match_date_text="$date_text"
    first_match_files_modified="$files_modified"
    first_match_files_added="$files_added"
    first_match_files_deleted="$files_deleted"
    first_match_command_line="$command_line"
    first_match_body="$body"
  fi
  if [[ "$LIMIT" -gt 0 && "$match_count" -ge "$LIMIT" ]]; then
    break
  fi
done < <(git log "${git_log_args[@]}")

if [[ "$match_count" -eq 0 ]]; then
  bt_warn "No entries found matching criteria"
  exit "$EXIT_OPERATION_FAILED"
fi

if [[ "$match_count" -eq 1 && "$LIMIT" -eq 1 && "$VERBOSE" == true ]]; then
  first_match_comment="$(extract_user_comment_from_body "$first_match_body")"
  first_match_command_line_full="$(build_command_line_with_comment "$first_match_command_line" "$first_match_comment")"
  first_match_timestamp_token="$(build_commit_timestamp_token "$first_match_date_text")"
  first_match_hash_token="$(resolve_unique_commit_hash_token "$first_match_full_hash")"
  legacy_report_file="$(resolve_legacy_report_path "$first_match_timestamp_token" "$first_match_hash_token")"
  write_legacy_single_commit_report "$legacy_report_file" "$TARGET_REF" \
    "$first_match_short_hash" "$first_match_full_hash" \
    "$first_match_files_modified" "$first_match_files_added" \
    "$first_match_files_deleted" "$first_match_command_line_full" \
    "$first_match_date_text"
  report_rel="${legacy_report_file#"${REPO_ROOT}"/}"
  bt_success "Results written to $report_rel"
elif [[ -n "$OUTPUT_FILE" ]]; then
  printf '%s\n' "$rendered_output" > "$OUTPUT_FILE"
  bt_success "Results written to $OUTPUT_FILE"
else
  printf '\n%s\n\n' "$rendered_output"
fi

bt_success "Found $match_count matching entries"
exit 0
