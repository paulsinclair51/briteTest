#!/usr/bin/env bash

# chbranch - Change to the specified branch.
#
# See usage below for details, or run: chbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  chbranch [-l | -r] [-t SEC] [-v] [BRANCH]
  chbranch {-h | --help}

Change current branch to BRANCH.

Arguments:
  BRANCH      Name of the branch to change to. If BRANCH is omitted,
              defaults to the name of the current branch. If current
              branch name cannot be resolved (detached/ambiguous), falls
              back to the last successful branch name.

Options:
  -h          Output this help to stdout and exit (other options
              and arguments are ignored).
  --help      Output this help to stdout and exit (other options
              and arguments are ignored).
  -l          Change to local BRANCH.
  -r          Change to remote (origin) BRANCH if it exists and is
              connected and reachable within the specified or default
              timeout.
  -t SEC      Timeout in seconds for accessing remote branch (default
              10 seconds).
              SEC must be an integer greater than 0.
  -v          Output verbose progress and diagnostics to stdout.

Rules:
  - Changing branch is blocked when the current branch is dirty; use the commit
    script or undo script, and then rerun chbranch.
  - Protected branches (main and v<M>.<m>.<p>) are always read-only.
  - By default (neither -l nor -r specified), changes to local BRANCH
    when it exists; otherwise, remote branch if it exists and is connected
    and reachable within the specified or default timeout.
  - Mode flags are strict:
      * -l forces local mode.
      * -r forces remote mode.
      * -l and -r together are invalid.
  - For targeted/contributor branches in remote mode:
      * If a corresponding local branch exists, remote is read-only.
      * If no corresponding local branch exists, remote is read/write by
        creating a local tracking branch.

Examples:
  chbranch dev/my-feature-v1.0.0
  chbranch -r dev/my-feature-v1.0.0

Outputs:
  - Writes help text, status message, and verbose output to stdout.
  - Writes errors and diagnostics to stderr.

Exit codes:
  0   Success.
  1   Invalid option or argument.
  2   Current branch is dirty; commit/undo changes and then rerun.
  3   Branch not found (when neither -l nor -r specified).
  4   Local branch not found when -l specified.
  5   Remote branch not found when -r specified.
  6   Remote branch is not connected/reachable.
  7   Timeout waiting for remote branch to be reachable.
  200 Git switch command failed (e.g., corrupted index, merge conflicts,
      permissions, or other git-level errors preventing branch change).
EOF
}

# High-Level Flow:
# 1. Parse options and resolve BRANCH.
#    - If BRANCH is omitted, use current local/detached state; if unresolved,
#      fall back to last successful branch name from local config.
# 2. Validate branch name and policy constraints.
# 3. Determine desired checkout mode.
#    - Default: local when BRANCH exists locally; otherwise remote.
#    - Explicit: -l forces local mode, -r forces remote mode.
# 4. Apply branch policy.
#    - main/version branches are always read-only.
#    - Remote targeted/contributor branches are read-only only when a
#      corresponding local branch exists.
# 5. Validate target availability.
#    - Local mode: local ref must exist.
#    - Remote mode: remote ref must exist and be reachable within timeout.
# 6. Ensure worktree is clean.
# 7. Switch to local/read-write, or detached read-only target.
# 8. Persist the branch name for future no-BRANCH invocations.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck disable=SC1091
# shellcheck source=../helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck disable=SC1091
# shellcheck source=../helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck disable=SC1091
# shellcheck source=../helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"

readonly EXIT_ARG_ERROR=1
readonly EXIT_NOT_GIT_REPO=200
readonly EXIT_DIRTY_WORKTREE=2
readonly EXIT_BRANCH_NOT_FOUND=3
readonly EXIT_LOCAL_NOT_FOUND=4
readonly EXIT_REMOTE_NOT_FOUND=5
readonly EXIT_REMOTE_UNREACHABLE=6
readonly EXIT_REMOTE_TIMEOUT=7
readonly EXIT_CHANGE_FAILED=200

VERBOSE=false
FORCE_LOCAL=false
REMOTE_TIMEOUT_SECONDS=10
readonly LAST_BRANCH_KEY="chbranch.lastBranch"

usage_error() {
  local message="$1"
  usage
  echo "$message" >&2
  exit "$EXIT_ARG_ERROR"
}

arg_error() {
  usage_error "$1"
}

verbose_info() {
  local message="$1"
  if [[ "$VERBOSE" == true ]]; then
    bt_info "$message"
  fi
}

emit_success_changed() {
  local mode="$1"
  local branch="$2"
  echo "Changed to $mode $branch branch."
}

ensure_git_repository() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    bt_error_exit "$EXIT_NOT_GIT_REPO" \
      "This command must be run from inside a git repository"
  fi
}

branch_exists_local() {
  local branch="$1"
  git show-ref --verify --quiet "refs/heads/$branch"
}

branch_exists_cached_remote() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

current_local_branch() {
  git symbolic-ref -q --short HEAD 2>/dev/null || true
}

remember_last_branch() {
  local branch="$1"

  [[ -n "$branch" ]] || return 0
  git config --local "$LAST_BRANCH_KEY" "$branch" >/dev/null 2>&1 || true
}

last_branch_or_empty() {
  local branch=""

  branch="$(git config --local --get "$LAST_BRANCH_KEY" 2>/dev/null || true)"
  if [[ -n "$branch" ]] && git check-ref-format --branch "$branch" >/dev/null 2>&1; then
    echo "$branch"
    return 0
  fi

  echo ""
}

current_branch_name_or_empty() {
  local local_branch
  local remote_branches
  local first_remote
  local remote_count
  local remembered_branch

  local_branch="$(current_local_branch)"
  if [[ -n "$local_branch" ]]; then
    echo "$local_branch"
    return 0
  fi

  remote_branches="$(git for-each-ref --format='%(refname:short)' --points-at HEAD refs/remotes/origin 2>/dev/null | grep -v '^origin/HEAD$' || true)"
  remote_count="$(printf '%s\n' "$remote_branches" | sed '/^$/d' | wc -l | tr -d ' ')"
  remembered_branch="$(last_branch_or_empty)"

  if [[ "$remote_count" == "1" ]]; then
    first_remote="$(printf '%s\n' "$remote_branches" | sed '/^$/d' | head -n 1)"
    first_remote="${first_remote#origin/}"
    remember_last_branch "$first_remote"
    echo "$first_remote"
    return 0
  fi

  # If HEAD points at multiple remote branches, prefer the remembered branch
  # when it is still one of the candidates.
  if [[ "$remote_count" -gt 1 && -n "$remembered_branch" ]] &&
    printf '%s\n' "$remote_branches" | grep -Fxq "origin/$remembered_branch"; then
    echo "$remembered_branch"
    return 0
  fi

  # If HEAD no longer maps to a unique remote ref, fall back to the remembered
  # branch name from the last successful switch.
  if [[ -n "$remembered_branch" ]]; then
    echo "$remembered_branch"
    return 0
  fi

  echo ""
}

# refresh_remote_branch_ref
# Return codes:
#   0 = remote branch exists and local remote-tracking ref is available
#   1 = remote branch not found
#   2 = remote unreachable or remote query/fetch failed
#   3 = timeout while waiting for remote response
refresh_remote_branch_ref() {
  local branch="$1"
  local ls_output=""
  local rc=0

  if ! command -v timeout >/dev/null 2>&1; then
    bt_error_exit "$EXIT_REMOTE_UNREACHABLE" \
      "Required command 'timeout' is not available"
  fi

  set +e
  ls_output="$(timeout "$REMOTE_TIMEOUT_SECONDS" git ls-remote --heads origin "$branch" 2>/dev/null)"
  rc=$?
  set -e

  if [[ "$rc" -eq 124 ]]; then
    return 3
  fi

  if [[ "$rc" -ne 0 ]]; then
    return 2
  fi

  if [[ -z "$ls_output" ]]; then
    return 1
  fi

  verbose_info "Found origin/$branch. Fetching branch metadata..."
  if ! git fetch origin "$branch:refs/remotes/origin/$branch" \
    >/dev/null 2>&1; then
    return 2
  fi

  bt_propagate_repository_history
  case $? in
    0) ;;
    1) verbose_info "Updated repository history from remote" ;;
    *) ;;
  esac

  return 0
}

ensure_remote_ref_available() {
  local branch="$1"
  local require_fresh="${2:-false}"
  local msg=""

  if [[ "$require_fresh" != "true" ]] && \
    branch_exists_cached_remote "$branch"; then
    return 0
  fi

  refresh_remote_branch_ref "$branch"
  case $? in
    0) return 0 ;;
    1) return 1 ;;
    3)
      bt_error_exit "$EXIT_REMOTE_TIMEOUT" \
        "Timeout waiting for remote branch '$branch' to be reachable"
      ;;
    2)
      msg="Remote branch is not connected/reachable while checking '$branch' "
      msg+="(offline or auth issue)."
      bt_error_exit "$EXIT_REMOTE_UNREACHABLE" \
        "$msg"
      ;;
  esac
}

is_current_remote_branch() {
  local branch="$1"
  local local_branch
  local head_sha
  local remote_sha

  local_branch="$(current_local_branch)"
  if [[ -n "$local_branch" ]]; then
    return 1
  fi

  head_sha="$(git rev-parse --verify HEAD 2>/dev/null || true)"
  remote_sha="$(git rev-parse --verify "refs/remotes/origin/$branch" \
    2>/dev/null || true)"

  [[ -n "$head_sha" && -n "$remote_sha" && "$head_sha" == "$remote_sha" ]]
}

switch_local() {
  local branch="$1"

  verbose_info "Switching to local branch '$branch'"
  if ! git switch "$branch" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_CHANGE_FAILED" \
      "Failed to switch to local branch '$branch'"
  fi
  remember_last_branch "$branch"
  emit_success_changed "local" "$branch"
}

switch_remote() {
  local branch="$1"

  verbose_info "Switching to remote branch 'origin/$branch'"
  if ! git switch --detach "origin/$branch" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_CHANGE_FAILED" \
      "Failed to switch to remote branch 'origin/$branch'"
  fi
  remember_last_branch "$branch"
  emit_success_changed "remote" "$branch"
}

switch_local_tracking_from_remote() {
  local branch="$1"

  verbose_info "Creating local tracking branch '$branch' from origin/$branch"
  if ! git switch --track -c "$branch" "origin/$branch" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_CHANGE_FAILED" \
      "Failed to create local tracking branch '$branch' from 'origin/$branch'"
  fi
  remember_last_branch "$branch"
  emit_success_changed "local" "$branch"
}

switch_local_read_only() {
  local branch="$1"

  verbose_info "Switching to read-only local branch '$branch'"
  if ! git switch --detach "$branch" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_CHANGE_FAILED" \
      "Failed to switch to read-only local branch '$branch'"
  fi
  remember_last_branch "$branch"
  emit_success_changed "local" "$branch"
}

parse_args() {
  FORCE_REMOTE=false
  FORCE_LOCAL=false
  BRANCH_ARG=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      -l)
        FORCE_LOCAL=true
        ;;
      -r)
        FORCE_REMOTE=true
        ;;
      -t)
        shift
        if [[ -z "${1:-}" ]]; then
          arg_error "Option -t requires SEC"
        fi
        if [[ ! "$1" =~ ^[1-9][0-9]*$ ]]; then
          arg_error "SEC for -t must be an integer greater than 0"
        fi
        REMOTE_TIMEOUT_SECONDS="$1"
        ;;
      -v)
        VERBOSE=true
        ;;
      --*)
        arg_error "Unknown option: $1"
        ;;
      -*)
        arg_error "Unknown option: $1"
        ;;
      *)
        if [[ -n "$BRANCH_ARG" ]]; then
          arg_error "Exactly one branch name is required"
        fi
        BRANCH_ARG="$1"
        ;;
    esac
    shift
  done

  if [[ "$FORCE_LOCAL" == true && "$FORCE_REMOTE" == true ]]; then
    arg_error "Options -l and -r are mutually exclusive"
  fi

  if [[ -z "$BRANCH_ARG" ]]; then
    BRANCH_ARG="$(current_branch_name_or_empty)"
    if [[ -z "$BRANCH_ARG" ]]; then
      BRANCH_ARG="$(last_branch_or_empty)"
    fi
    if [[ -z "$BRANCH_ARG" ]]; then
      arg_error "BRANCH is required when current branch name cannot be resolved"
    fi
  fi
}

validate_target_branch() {
  local branch="$1"
  local msg=""

  if [[ "$branch" == origin/* ]]; then
    msg="Remote branch input '$branch' is not allowed. Create a local "
    msg+="tracking branch first."
    arg_error "$msg"
  fi

  if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
    arg_error "Invalid branch name: '$branch'"
  fi
}

ensure_clean_or_discard() {
  local curr_branch="$1"
  local msg=""

  if ! bt_is_worktree_dirty; then
    return 0
  fi

  if [[ -n "$curr_branch" ]]; then
    msg="Current branch '$curr_branch' has uncommitted changes. Commit or "
    msg+="undo changes first before switching."
    bt_error_exit "$EXIT_DIRTY_WORKTREE" \
      "$msg"
  fi

  msg="Working tree has uncommitted changes. Commit or undo changes first "
  msg+="before switching."
  bt_error_exit "$EXIT_DIRTY_WORKTREE" \
    "$msg"
}

main() {
  local has_local=false
  local has_remote=false
  local protected_branch=false
  local read_only_mode=false
  local desired_mode="local"
  local require_fresh_remote=false
  local curr_branch
  local msg=""

  ensure_git_repository
  parse_args "$@"

  TARGET_BRANCH="$BRANCH_ARG"
  validate_target_branch "$TARGET_BRANCH"

  if bt_is_protected_branch "$TARGET_BRANCH"; then
    protected_branch=true
    read_only_mode=true
  fi

  if branch_exists_local "$TARGET_BRANCH"; then
    has_local=true
  fi

  if [[ "$FORCE_LOCAL" == true ]]; then
    desired_mode="local"
  elif [[ "$FORCE_REMOTE" == true || "$has_local" == false ]]; then
    desired_mode="remote"
  fi

  # Protected branches are always read-only. Keep local mode for no-local
  # fallback detection but enforce detached checkout below.
  if [[ "$protected_branch" == true && "$FORCE_LOCAL" == true ]]; then
    read_only_mode=true
  fi

  # For explicit -r, always validate against the current remote state rather
  # than relying on a possibly stale local remote-tracking ref.
  if [[ "$FORCE_REMOTE" == true ]]; then
    require_fresh_remote=true
  fi

  if [[ "$FORCE_LOCAL" == true && "$has_local" == false ]]; then
    bt_error_exit "$EXIT_LOCAL_NOT_FOUND" \
      "Local branch '$TARGET_BRANCH' does not exist"
  fi

  if [[ "$desired_mode" == "remote" ]]; then
    if ! ensure_remote_ref_available "$TARGET_BRANCH" "$require_fresh_remote"; then
      if [[ "$FORCE_REMOTE" == true ]]; then
        bt_error_exit "$EXIT_REMOTE_NOT_FOUND" \
          "Remote branch 'origin/$TARGET_BRANCH' does not exist"
      fi
      msg="Local branch '$TARGET_BRANCH' does not exist and was not found on "
      msg+="origin"
      bt_error_exit "$EXIT_BRANCH_NOT_FOUND" \
        "$msg"
    fi
    has_remote=true
  else
    if branch_exists_cached_remote "$TARGET_BRANCH"; then
      has_remote=true
    fi
  fi

  curr_branch="$(current_local_branch)"
  if [[ "$desired_mode" == "local" && "$read_only_mode" == false && \
    "$curr_branch" == "$TARGET_BRANCH" ]]; then
    remember_last_branch "$TARGET_BRANCH"
    emit_success_changed "local" "$TARGET_BRANCH"
    exit 0
  fi

  if [[ "$desired_mode" == "remote" ]] && \
    is_current_remote_branch "$TARGET_BRANCH"; then
    remember_last_branch "$TARGET_BRANCH"
    emit_success_changed "remote" "$TARGET_BRANCH"
    exit 0
  fi

  ensure_clean_or_discard "$curr_branch"

  if [[ "$read_only_mode" == true ]]; then
    # Respect explicit mode flags first.
    if [[ "$FORCE_LOCAL" == true ]]; then
      switch_local_read_only "$TARGET_BRANCH"
    elif [[ "$FORCE_REMOTE" == true ]]; then
      switch_remote "$TARGET_BRANCH"
    # Default mode for protected branches remains local-first, then remote.
    elif [[ "$has_local" == true ]]; then
      switch_local_read_only "$TARGET_BRANCH"
    elif [[ "$has_remote" == true ]]; then
      switch_remote "$TARGET_BRANCH"
    else
      bt_error_exit "$EXIT_BRANCH_NOT_FOUND" \
        "Branch '$TARGET_BRANCH' was not found locally or on origin"
    fi
  elif [[ "$desired_mode" == "local" ]]; then
    switch_local "$TARGET_BRANCH"
  else
    # Remote targeted/contributor policy:
    # - local exists => remote is read-only
    # - no local => remote is read/write (create tracking local branch)
    if [[ "$has_local" == true ]]; then
      switch_remote "$TARGET_BRANCH"
    else
      switch_local_tracking_from_remote "$TARGET_BRANCH"
    fi
  fi
}

main "$@"
