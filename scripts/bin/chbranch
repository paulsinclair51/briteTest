#!/usr/bin/env bash

# chbranch - Change to the specified branch.
#
# See usage below for details, or run: chbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  chbranch [-f] [-r] [-o] BRANCH
  chbranch {-h | --help}

Change current branch to BRANCH.

Arguments:
  BRANCH      Name of the branch to change to.

Options:
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored).
  -r          Change to remote (origin) BRANCH even when local BRANCH exists.
  -f          Discard all uncommitted tracked and untracked changes before
              changing to BRANCH, but only when branch-change prechecks
              succeed.
  -o          Owner override for branches blocked by policy.

Rules:
  - By default, local BRANCH is used when it exists.
  - If local BRANCH does not exist and remote (origin) BRANCH exists, changes to
    remote BRANCH (a local branch is not created).
  - With -r, changes to remote (origin) BRANCH even when a local BRANCH exists.
  - If -r is used and remote (origin) BRANCH does not exist or is not
    connected/reachable, exits with error and preserves uncommitted changes
    (-f is ignored).
  - With -f, all uncommitted tracked and untracked changes are
    discarded before changing the branch.
  - Changing branch is blocked when the current branch is dirty,
    unless -f is specified.
  - With -o, BRANCH is still required and normal local/remote selection
    rules still apply.
  - If BRANCH is policy-blocked for normal users, -o allows switching only
    when the caller is the repository owner.

Examples:
  chbranch dev/my-feature-v1.0.0
  chbranch -f dev/my-feature-v1.0.0
  chbranch -r dev/my-feature-v1.0.0
  chbranch -f -r dev/my-feature-v1.0.0
  chbranch -o main
  chbranch -o -r v1.0.0
  chbranch v1.0.0

Outputs:
  - Writes help text and status messages to stdout.
  - Writes errors and diagnostics to stderr.

Exit codes:
  0   Success.
  1   Invalid option or argument.
  2   Not in a git repository.
  5   Current branch is dirty; commit/undo changes first or resubmit
      with -f to discard all the uncommitted changes.
  6   Remote branch is not connected/reachable.
  8   Owner override (-o) denied (caller is not repository owner or
      owner could not be determined).
  200 Git switch command failed (e.g., corrupted index, merge conflicts,
      permissions, or other git-level errors preventing branch change).
EOF
}

# High-Level Flow:
# - Parses branch selection for local/remote checkout mode.
# - Optionally discards uncommitted tracked/untracked changes with -f.
# - Uses local branch by default, with optional remote branch checkout.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck disable=SC1091
# shellcheck source=../helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck disable=SC1091
# shellcheck source=../helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck disable=SC1091
# shellcheck source=../helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"

readonly EXIT_ARG_ERROR=1
readonly EXIT_NOT_GIT_REPO=2
readonly EXIT_NO_CHANGE=2
readonly EXIT_BRANCH_NOT_FOUND=3
readonly EXIT_REMOTE_NOT_FOUND=4
readonly EXIT_DIRTY_WORKTREE=5
readonly EXIT_REMOTE_UNREACHABLE=6
readonly EXIT_OWNER_REQUIRED=8
readonly EXIT_CHANGE_FAILED=200

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_ARG_ERROR"
}

ensure_git_repository() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    bt_error_exit "$EXIT_NOT_GIT_REPO" \
      "This command must be run from inside a git repository"
  fi
}

branch_exists_local() {
  local branch="$1"
  git show-ref --verify --quiet "refs/heads/$branch"
}

branch_exists_cached_remote() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

current_local_branch() {
  git symbolic-ref -q --short HEAD 2>/dev/null || true
}

discard_uncommitted_changes() {
  bt_warn "Force mode enabled: discarding all uncommitted changes"

  if ! git reset --hard >/dev/null 2>&1; then
    bt_error_exit 5 \
      "Failed to discard tracked changes (git reset --hard failed)"
  fi

  if ! git clean -fd >/dev/null 2>&1; then
    bt_error_exit 5 "Failed to discard untracked changes (git clean -fd failed)"
  fi

  bt_success "Discarded uncommitted tracked and untracked changes"
}

# refresh_remote_branch_ref
# Return codes:
#   0 = remote branch exists and local remote-tracking ref is available
#   1 = remote branch not found
#   2 = remote unreachable or remote query/fetch failed
refresh_remote_branch_ref() {
  local branch="$1"
  local ls_output=""

  if ! ls_output="$(git ls-remote --heads origin "$branch" 2>/dev/null)"; then
    return 2
  fi

  if [[ -z "$ls_output" ]]; then
    return 1
  fi

  bt_info "Found origin/$branch. Fetching branch metadata..."
  if ! git fetch origin "$branch:refs/remotes/origin/$branch" \
    >/dev/null 2>&1; then
    return 2
  fi

  bt_propagate_repository_history
  case $? in
    0) ;;
    1) bt_info "Updated repository history from remote" ;;
    *) ;;
  esac

  return 0
}

ensure_remote_ref_available() {
  local branch="$1"
  local require_fresh="${2:-false}"
  local msg=""

  if [[ "$require_fresh" != "true" ]] && \
    branch_exists_cached_remote "$branch"; then
    return 0
  fi

  refresh_remote_branch_ref "$branch"
  case $? in
    0) return 0 ;;
    1) return 1 ;;
    2)
      msg="Remote branch is not connected/reachable while checking '$branch' "
      msg+="(offline or auth issue)."
      bt_error_exit "$EXIT_REMOTE_UNREACHABLE" \
        "$msg"
      ;;
  esac
}

is_current_remote_branch() {
  local branch="$1"
  local local_branch
  local head_sha
  local remote_sha

  local_branch="$(current_local_branch)"
  if [[ -n "$local_branch" ]]; then
    return 1
  fi

  head_sha="$(git rev-parse --verify HEAD 2>/dev/null || true)"
  remote_sha="$(git rev-parse --verify "refs/remotes/origin/$branch" \
    2>/dev/null || true)"

  [[ -n "$head_sha" && -n "$remote_sha" && "$head_sha" == "$remote_sha" ]]
}

switch_local() {
  local branch="$1"

  bt_info "Switching to local branch '$branch'..."
  if ! git switch "$branch" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_CHANGE_FAILED" \
      "Failed to switch to local branch '$branch'"
  fi
  bt_success "Current branch is now local '$branch'"
}

switch_remote() {
  local branch="$1"

  bt_info "Switching to remote branch 'origin/$branch'..."
  if ! git switch --detach "origin/$branch" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_CHANGE_FAILED" \
      "Failed to switch to remote branch 'origin/$branch'"
  fi
  bt_success "Current branch is now remote 'origin/$branch'"
}

parse_args() {
  FORCE_REMOTE=false
  FORCE_DISCARD=false
  FORCE_OWNER_OVERRIDE=false
  BRANCH_ARG=""

  if [[ $# -eq 0 ]]; then
    usage_error "Branch name is required"
  fi

  for arg in "$@"; do
    case "$arg" in
      -h | --help)
        usage
        exit 0
        ;;
      -r)
        FORCE_REMOTE=true
        ;;
      -f)
        FORCE_DISCARD=true
        ;;
      -o)
        FORCE_OWNER_OVERRIDE=true
        ;;
      --*)
        usage_error "Unknown option: $arg"
        ;;
      -*)
        usage_error "Unknown option: $arg"
        ;;
      *)
        if [[ -n "$BRANCH_ARG" ]]; then
          usage_error "Exactly one branch name is required"
        fi
        BRANCH_ARG="$arg"
        ;;
    esac
  done

  if [[ -z "$BRANCH_ARG" ]]; then
    usage_error "Branch name is required"
  fi
}

resolve_repo_owner_login_or_empty() {
  local repo_slug="${GITHUB_REPOSITORY:-}"
  local remote_url=""
  local owner=""

  if [[ -n "$repo_slug" && "$repo_slug" == */* ]]; then
    owner="${repo_slug%%/*}"
  fi

  if [[ -z "$owner" ]]; then
    remote_url="$(git remote get-url origin 2>/dev/null || true)"
    if [[ "$remote_url" =~ ^git@github\.com:([^/]+)/([^/]+)(\.git)?$ ]]; then
      owner="${BASH_REMATCH[1]}"
    elif [[ "$remote_url" =~ ^https://github\.com/([^/]+)/([^/]+)(\.git)?$ ]]; then
      owner="${BASH_REMATCH[1]}"
    elif [[ "$remote_url" =~ ^ssh://git@github\.com/([^/]+)/([^/]+)(\.git)?$ ]]; then
      owner="${BASH_REMATCH[1]}"
    fi
  fi

  bt_normalize_login "$owner"
}

ensure_repo_owner_for_override() {
  local actor_lc=""
  local repo_owner_lc=""

  if ! actor_lc="$(bt_require_login)"; then
    bt_error_exit "$EXIT_OWNER_REQUIRED" \
      "Owner override (-o) requires a resolvable caller identity"
  fi

  repo_owner_lc="$(resolve_repo_owner_login_or_empty)"
  if [[ -z "$repo_owner_lc" ]]; then
    bt_error_exit "$EXIT_OWNER_REQUIRED" \
      "Owner override (-o) requires repository owner identity (set GITHUB_REPOSITORY or configure origin GitHub URL)"
  fi

  if [[ "$actor_lc" != "$repo_owner_lc" ]]; then
    bt_error_exit "$EXIT_OWNER_REQUIRED" \
      "Owner override (-o) denied: caller '$actor_lc' is not repository owner '$repo_owner_lc'"
  fi
}

validate_target_branch() {
  local branch="$1"
  local owner_override="${2:-false}"
  local msg=""

  if [[ "$branch" == origin/* ]]; then
    msg="Remote branch input '$branch' is not allowed. Create a local "
    msg+="tracking branch first."
    bt_error_exit "$EXIT_ARG_ERROR" \
      "$msg"
  fi

  if [[ "$branch" == "main" ]]; then
    if [[ "$owner_override" == true ]]; then
      ensure_repo_owner_for_override
    else
      msg="Switching to 'main' is blocked by policy. Repository owner can "
      msg+="override with -o."
      bt_error_exit "$EXIT_ARG_ERROR" \
        "$msg"
    fi
  fi

  if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_ARG_ERROR" "Invalid branch name: '$branch'"
  fi
}

ensure_clean_or_discard() {
  local curr_branch="$1"
  local msg=""

  if ! bt_is_worktree_dirty; then
    return 0
  fi

  if [[ "$FORCE_DISCARD" == true ]]; then
    discard_uncommitted_changes
    return
  fi

  if [[ -n "$curr_branch" ]]; then
    msg="Current branch '$curr_branch' has uncommitted changes. Commit or "
    msg+="undo changes first before switching."
    bt_error_exit "$EXIT_DIRTY_WORKTREE" \
      "$msg"
  fi

  msg="Working tree has uncommitted changes. Commit or undo changes first "
  msg+="before switching."
  bt_error_exit "$EXIT_DIRTY_WORKTREE" \
    "$msg"
}

main() {
  local has_local=false
  local desired_mode="local"
  local require_fresh_remote=false
  local curr_branch
  local msg=""

  ensure_git_repository
  parse_args "$@"

  TARGET_BRANCH="$BRANCH_ARG"
  validate_target_branch "$TARGET_BRANCH" "$FORCE_OWNER_OVERRIDE"

  if branch_exists_local "$TARGET_BRANCH"; then
    has_local=true
  fi

  if [[ "$FORCE_REMOTE" == true || "$has_local" == false ]]; then
    desired_mode="remote"
  fi

  # For explicit -r, always validate against the current remote state rather
  # than relying on a possibly stale local remote-tracking ref.
  if [[ "$FORCE_REMOTE" == true ]]; then
    require_fresh_remote=true
  fi

  if [[ "$desired_mode" == "remote" ]]; then
    if ! ensure_remote_ref_available "$TARGET_BRANCH" "$require_fresh_remote"; then
      if [[ "$FORCE_REMOTE" == true ]]; then
        bt_error_exit "$EXIT_REMOTE_NOT_FOUND" \
          "Remote branch 'origin/$TARGET_BRANCH' does not exist"
      fi
      msg="Local branch '$TARGET_BRANCH' does not exist and was not found on "
      msg+="origin"
      bt_error_exit "$EXIT_BRANCH_NOT_FOUND" \
        "$msg"
    fi
  fi

  curr_branch="$(current_local_branch)"
  if [[ "$desired_mode" == "local" && \
    "$curr_branch" == "$TARGET_BRANCH" ]]; then
    bt_info "Current branch already local '$TARGET_BRANCH'; no change needed"
    exit "$EXIT_NO_CHANGE"
  fi

  if [[ "$desired_mode" == "remote" ]] && \
    is_current_remote_branch "$TARGET_BRANCH"; then
    bt_info \
      "Current branch already remote 'origin/$TARGET_BRANCH'; no change needed"
    exit "$EXIT_NO_CHANGE"
  fi

  # Force-discard is applied only after branch-target prechecks succeed.
  ensure_clean_or_discard "$curr_branch"

  if [[ "$desired_mode" == "local" ]]; then
    switch_local "$TARGET_BRANCH"
  else
    switch_remote "$TARGET_BRANCH"
  fi
}

main "$@"
