#!/usr/bin/env bash

# rmbranch - Delete a branch locally and/or remotely.
#
# See usage below for details, or run: rmbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  rmbranch BRANCHNAME [OPTIONS]
  rmbranch -h | --help

Delete a branch locally and/or remotely.

Arguments:
  BRANCHNAME         Name of the branch to delete (required)

Options:
  -h, --help         Output this help to stdout and exit
  -l, --local        Delete only the local branch (default: delete both)
  -r, --remote       Delete only the remote branch (default: delete both)
  -b, --both         Delete both local and remote branches (default behavior)
  -f, --force        Force delete (use -D instead of -d for local branch)
  -v, --verbose      Show detailed progress information

Examples:
  # Delete branch locally and remotely
  rmbranch patch/my-fix

  # Delete only local branch
  rmbranch patch/my-fix -l

  # Delete only remote branch
  rmbranch patch/my-fix -r

  # Force delete (has unmerged commits)
  rmbranch patch/my-fix -f

Outputs:
  - Writes status messages to stdout
  - Writes errors to stderr

Exit codes:
  0  Success
  1  Argument error
  2  Git operation failed
  3  Branch not found
  5  User cancelled deletion
EOF
}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Ensure Git hooks are installed
ensure_hooks_installed

# Default options
BRANCHNAME=""
MODE="both"
FORCE=false
VERBOSE=false

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -l | --local)
      MODE="local"
      shift
      ;;
    -r | --remote)
      MODE="remote"
      shift
      ;;
    -b | --both)
      MODE="both"
      shift
      ;;
    -f | --force)
      FORCE=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -)
      bt_error_exit 1 "Invalid option: $1"
      ;;
    *)
      if [[ -z "$BRANCHNAME" ]]; then
        BRANCHNAME="$1"
      else
        bt_error_exit 1 "Unexpected argument: $1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$BRANCHNAME" ]]; then
  bt_error_exit 1 "BRANCHNAME is required"
fi

cd "$REPO_ROOT"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  bt_error_exit 1 "Not in a Git repository"
fi

if [[ "$MODE" == "local" || "$MODE" == "both" ]]; then
  bt_info "Fetching latest refs from remote..."
  if ! git fetch origin >/dev/null 2>&1; then
    bt_error_exit 2 "Failed to fetch from remote"
  fi
fi

# Check if branch exists
LOCAL_EXISTS=false
REMOTE_EXISTS=false

if git show-ref --verify --quiet "refs/heads/$BRANCHNAME"; then
  LOCAL_EXISTS=true
fi

if git show-ref --verify --quiet "refs/remotes/origin/$BRANCHNAME"; then
  REMOTE_EXISTS=true
fi

# Verify branch exists
if [[ "$MODE" == "local" && "$LOCAL_EXISTS" == false ]]; then
  bt_error_exit 3 "Local branch '$BRANCHNAME' does not exist"
elif [[ "$MODE" == "remote" && "$REMOTE_EXISTS" == false ]]; then
  bt_error_exit 3 "Remote branch '$BRANCHNAME' does not exist"
elif [[ "$MODE" == "both" && "$LOCAL_EXISTS" == false && "$REMOTE_EXISTS" == false ]]; then
  bt_error_exit 3 "Branch '$BRANCHNAME' does not exist locally or remotely"
fi

bt_info "Preparing to delete branch: $BRANCHNAME ($MODE)"
echo "Warning: This action cannot be undone."
read -p "Are you sure? (y/N): " -r confirm
if [[ ! $confirm =~ ^[Yy]$ ]]; then
  bt_info "Branch deletion cancelled"
  exit 5
fi

# Delete local branch if needed
if [[ "$MODE" == "local" || "$MODE" == "both" ]]; then
  if [[ "$LOCAL_EXISTS" == true ]]; then
    bt_info "Deleting local branch..."
    
    # Check if we're on the branch
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$CURRENT_BRANCH" == "$BRANCHNAME" ]]; then
      bt_info "Switching to main branch..."
      if ! git checkout main >/dev/null 2>&1; then
        bt_error_exit 2 "Failed to switch away from branch '$BRANCHNAME'"
      fi
    fi
    
    export BRITETEST_BYPASS_HOOKS=true
    if [[ "$FORCE" == true ]]; then
      if ! git branch -D "$BRANCHNAME" >/dev/null 2>&1; then
        unset BRITETEST_BYPASS_HOOKS
        bt_error_exit 2 "Failed to force delete local branch '$BRANCHNAME'"
      fi
    else
      if ! git branch -d "$BRANCHNAME" >/dev/null 2>&1; then
        unset BRITETEST_BYPASS_HOOKS
        bt_info "Local branch has unmerged commits, use -f to force delete"
        bt_error_exit 2 "Failed to delete local branch '$BRANCHNAME'"
      fi
    fi
    unset BRITETEST_BYPASS_HOOKS
    
    bt_success "Local branch '$BRANCHNAME' deleted"
  fi
fi

# Delete remote branch if needed
if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  if [[ "$REMOTE_EXISTS" == true ]]; then
    bt_info "Deleting remote branch..."
    
    export BRITETEST_BYPASS_HOOKS=true
    if ! git push origin --delete "$BRANCHNAME" >/dev/null 2>&1; then
      unset BRITETEST_BYPASS_HOOKS
      bt_error_exit 2 "Failed to delete remote branch '$BRANCHNAME'"
    fi
    unset BRITETEST_BYPASS_HOOKS
    
    bt_success "Remote branch '$BRANCHNAME' deleted"
  fi
fi

bt_success "Branch deletion complete"
exit 0
