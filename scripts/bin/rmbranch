#!/usr/bin/env bash

# rmbranch - Remove a branch locally and/or from remote.
#
# See usage below for details, or run: rmbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  rmbranch [OPTIONS] <branchname> [-- MSG]
  rmbranch {-h | --help}

Remove a local branch and/or remote branch.

Arguments:
  <branchname>       Name of the branch to remove.
                     Examples: fix/bug, add-feature, refactor.

Protected branches:
  - main and version branches cannot be removed from remote.
  - Local protected branches can be removed when they exist as local.
  - No branch-name policy validation is applied by this script. If a branch
    ref exists (local and/or remote), it can be removed subject to protected
    branch safeguards above.

Permissions:
  - The current user must be a contributor, reviewer, or approver.

Options:
  -h, --help         Output this help to stdout and exit (other options
                     and arguments are ignored).
  -l                 Remove local branch.
  -r                 Remove branch from remote.
  -a                 Remove from both local and remote (alias for -l -r).
  -f                 Force removal when local branch has unmerged commits.
  -m "MSG"           Attach a commit message/comment to the
                     operation. Usage: rmbranch patch/old-fix -m
                     "Reverted in favor of better approach.".
  --message "MSG"    Attach a commit message/comment to the
                     operation. Usage: rmbranch old-fix --message
                     "Reverted in favor of better approach."
  -- MSG             Attach a commit message/comment (everything
                     after -- is the comment). Usage: rmbranch
                     old-fix -- Reverted in favor of better approach.
                     Note: No quotes needed, captures all remaining.

Safety behavior:
  - rmbranch does not prompt for confirmation.
  - Without -f, local deletion uses safe mode and fails if unmerged
    commits exist.
  - When local deletion is requested (-l or default both), working tree must
    be clean before deletion starts.
  - Local deletion is blocked if a pending `chbranch` auto-stash exists for
    the target branch.
  - Rerun with -f only after validating branch cleanup status.

Modes:
  Local (-l):
    - Remove the local branch.
    - Log the operation to 'logs/local_branch_history.md'.

  Remote (-r):
    - Remove the branch from remote only.
    - Log the operation to 'logs/remote_branch_history.md'.
    - Exits with code 5 if the remote branch is protected and
      cannot be removed.

  Both (-l -r, default):
    - Remove the local branch.
    - Remove the branch from remote if it is not protected (main
      or version branches).
    - Exits with code 4 when local removal succeeded but remote
      protected branch removal was skipped.
    - Log the operation to 'logs/remote_branch_history.md' and
      'logs/local_branch_history.md'

Examples: Basic usage.
  rmbranch old-fix
  rmbranch -l old-fix
  rmbranch -r experiment
  rmbranch -l -r -f temp-feature
  rmbranch -a -f temp-feature

Examples: With GitHub-style comment.
  rmbranch old-fix -m "Reverted in favor of better
    approach."
  rmbranch -r experiment -m "Experiment failed."

Examples: With Unix-style comment.
  rmbranch old-fix -- Reverted in favor of better
    approach.
  rmbranch -r experiment -- Experiment failed.

Examples: Force removal with comment.
  rmbranch -f temp -m "Temporary testing branch."
  rmbranch -a -f old -- Cleanup old feature branch.

Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.

Exit codes:
  0   Success.
  1   Argument error.
  2   Git operation failed.
  3   Branch does not exist.
  4   Local branch removed successfully but remote branch is
      protected and was not removed (applies to both-mode requests).
  5   Remote branch is protected (cannot remove).
  6   Branch has unmerged commits (use -f option to force removal).
  7   User is not authorized (must be contributor or higher).
  8   Local deletion blocked (working tree not clean or pending auto-stash
      exists for target branch).
EOF
}

# High-Level Flow:
# - Deletes branches locally and optionally on remote with
#   protected-branch safeguards.
# - Validates branch existence, current-branch constraints, and deletion scope.
# - Reports deletion results and skipped/protected targets.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
_LOG_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
[[ "$_LOG_BRANCH" == "HEAD" ]] && _LOG_BRANCH="main"
COMMON_HELPER="$SCRIPT_DIR/../helpers/common.sh"
HISTORY_HELPER="$SCRIPT_DIR/../helpers/history_log.sh"
CKROLE_HELPER="$SCRIPT_DIR/../helpers/ckrole.sh"

# Shared helpers
if [[ ! -f "$COMMON_HELPER" ]]; then
  echo "Error: Required helper not found: $COMMON_HELPER" >&2
  exit 2
fi
if [[ ! -f "$HISTORY_HELPER" ]]; then
  _msg="Error: Required helper not found: $HISTORY_HELPER"
  echo "$_msg" >&2
  exit 2
fi
if [[ ! -f "$CKROLE_HELPER" ]]; then
  _msg="Error: Required helper not found: $CKROLE_HELPER"
  echo "$_msg" >&2
  exit 2
fi

# shellcheck source=helpers/common.sh
if ! source "$COMMON_HELPER"; then
  _msg="Error: Failed to load helper: $COMMON_HELPER"
  echo "$_msg" >&2
  exit 2
fi
# shellcheck source=helpers/history_log.sh
if ! source "$HISTORY_HELPER"; then
  _msg="Error: Failed to load helper: $HISTORY_HELPER"
  echo "$_msg" >&2
  exit 2
fi
# shellcheck source=helpers/validation-helpers.sh
VALIDATION_HELPER="$SCRIPT_DIR/../helpers/validation-helpers.sh"
if ! source "$VALIDATION_HELPER"; then
  _msg="Error: Failed to load helper: $VALIDATION_HELPER"
  echo "$_msg" >&2
  exit 2
fi
GIT_HELPER="$SCRIPT_DIR/../helpers/git_helpers.sh"
if [[ ! -f "$GIT_HELPER" ]]; then
  echo "Error: Required helper not found: $GIT_HELPER" >&2
  exit 2
fi
# shellcheck source=helpers/git_helpers.sh
if ! source "$GIT_HELPER"; then
  _msg="Error: Failed to load helper: $GIT_HELPER"
  echo "$_msg" >&2
  exit 2
fi

LOG_FILE="$REPO_ROOT/$(bt_branch_to_history_file "$_LOG_BRANCH")"

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit 1
}

# Default options
MODE="both"  # local, remote, or both
FORCE=false
COMMENT=""
INCLUDE_LOCAL_FLAG=false
INCLUDE_REMOTE_FLAG=false
REMOTE_PROTECTED_SKIPPED=false

# Protected branch references for remote deletion checks
PROTECTED_BRANCHES=("main")

append_log_entry() {
  local log_file="$1"
  local status="$2"
  local branchname="$3"
  local message="$4"
  local comment="${5:-}"

  # status/branchname retained for compatibility with
  # existing callers.
  : "$status" "$branchname"
  if ! bt_append_history_log "$log_file" "$message" \
      "$comment"; then
    echo "Warning: Failed to append history log: $log_file" >&2
  fi
}

log_operation() {
  local status="$1"
  local branchname="$2"
  local message="$3"
  local comment="${4:-}"

  # status/branchname are retained for compatibility with existing callers.
  : "$status" "$branchname"
  append_log_entry "$LOG_FILE" "" "" "$message" "$comment"
}

error_exit() {
  local code="$1"
  local message="$2"
  local branchname="${3:-}"
  local comment="${4:-}"

  echo "Error: $message" >&2

  if [[ -n "$branchname" ]]; then
    _log_msg="Branch \`$branchname\` deletion failed" 
    log_operation "FAILED" "$branchname" \
        "$_log_msg - $message" "$comment"
  fi

  exit "$code"
}

info() {
  bt_info "$1"
}

success() {
  bt_success "$1"
}

warn() {
  bt_warn "$1"
}

is_protected_branch() {
  local branch="$1"
  local protected
  
  for protected in "${PROTECTED_BRANCHES[@]}"; do
    if [[ "$branch" == "$protected" ]]; then
      return 0
    fi
  done
  if [[ "$branch" =~ ^v([1-9][0-9]?)\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$ ]]; then
    return 0
  fi
  return 1
}

# Use exact ref lookups rather than generic revision parsing so branch-like
# names that are invalid by local policy can still be removed when refs exist.
local_branch_exists() {
  local branch="$1"
  git show-ref --verify --quiet "refs/heads/$branch"
}

remote_branch_exists() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

find_branch_auto_stash_ref() {
  local branch="$1"
  local prefix

  prefix="chbranch-auto:${branch}:"
  git stash list --format='%gd%x09%gs' | \
    awk -F '\t' -v p="$prefix" 'index($2, p) { print $1; exit }'
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -l)
      INCLUDE_LOCAL_FLAG=true
      shift
      ;;
    -r)
      INCLUDE_REMOTE_FLAG=true
      shift
      ;;
    -a)
      INCLUDE_LOCAL_FLAG=true
      INCLUDE_REMOTE_FLAG=true
      shift
      ;;
    -f)
      FORCE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -m requires a message argument" "" ""
      fi
      if [[ -n "$COMMENT" ]]; then
      _msg="Cannot use both -m and -- for comment"
      usage_error "$_msg" "" ""
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -m and -- for comment" "" ""
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1" "" ""
      ;;
    *)
      # Positional argument
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# Resolve deletion scope: if neither -l nor -r is provided, default to both.
if [[ "$INCLUDE_LOCAL_FLAG" == false && "$INCLUDE_REMOTE_FLAG" == false ]]; then
  INCLUDE_LOCAL=true
  INCLUDE_REMOTE=true
else
  INCLUDE_LOCAL="$INCLUDE_LOCAL_FLAG"
  INCLUDE_REMOTE="$INCLUDE_REMOTE_FLAG"
fi

if [[ "$INCLUDE_LOCAL" == true && "$INCLUDE_REMOTE" == true ]]; then
  MODE="both"
elif [[ "$INCLUDE_LOCAL" == true ]]; then
  MODE="local"
else
  MODE="remote"
fi

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Check that we have exactly 1 positional argument
if [[ $# -ne 1 ]]; then
  usage_error "Expected 1 argument (branchname), got $#" ""
fi

BRANCHNAME="$1"

# Validate branch name
if [[ -z "$BRANCHNAME" ]]; then
  usage_error "Branch name cannot be empty" ""
fi

# Validate branch name conforms to naming conventions
if ! validate_branch_name "$BRANCHNAME" "branch to delete"; then
  usage_error "Branch does not conform to naming conventions" "$BRANCHNAME"
fi

# Change to repo root
cd "$REPO_ROOT"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  _msg="Repository root '$REPO_ROOT' is not a Git"
  error_exit 2 "$_msg working tree" "$BRANCHNAME" \
      "$COMMENT"
fi

# Require contributor role (or higher) for branch deletion operations.
if ! bash "$CKROLE_HELPER" contributor >/dev/null 2>&1; then
  ACTOR_LOGIN="$(bt_resolve_login_or_empty)"
  if [[ -z "$ACTOR_LOGIN" ]]; then
    ACTOR_LOGIN="<unknown>"
  fi
  error_exit 7 "User '$ACTOR_LOGIN' is not authorized to run rmbranch (requires contributor role or higher)" "$BRANCHNAME" "$COMMENT"
fi

if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  if ! git remote get-url origin >/dev/null 2>&1; then
    error_exit 2 "Remote 'origin' is not configured" "$BRANCHNAME" "$COMMENT"
  fi
fi

# Determine operation description
case "$MODE" in
  local)
    info "Removing local branch '$BRANCHNAME'..."
    ;;
  remote)
    info "Removing branch '$BRANCHNAME' from remote..."
    ;;
  both)
    info "Removing branch '$BRANCHNAME' from local and remote..."
    ;;
esac

# Fetch latest refs from remote
if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  info "Fetching latest refs from remote..."
  if ! git fetch origin >/dev/null 2>&1; then
    error_exit 2 "Failed to fetch from remote" "$BRANCHNAME" "$COMMENT"
  fi
  
  # Propagate repository history from remote if available
  bt_propagate_repository_history
  case $? in
    0) ;;
    1) info "Updated repository history from remote" ;;
    *) ;;
  esac
fi

# Check if branch exists (local or remote)
LOCAL_EXISTS=false
REMOTE_EXISTS=false

if local_branch_exists "$BRANCHNAME"; then
  LOCAL_EXISTS=true
fi

if remote_branch_exists "$BRANCHNAME"; then
  REMOTE_EXISTS=true
fi

# Protected branches are never removed from remote. If user requested both,
# degrade to local-only so local cleanup of protected artifacts is possible.
if is_protected_branch "$BRANCHNAME"; then
  if [[ "$MODE" == "remote" ]]; then
    error_exit 5 "Remote branch '$BRANCHNAME' is protected and cannot be removed" \
      "$BRANCHNAME" "$COMMENT"
  fi

  if [[ "$MODE" == "both" ]]; then
    if [[ "$LOCAL_EXISTS" == false && "$REMOTE_EXISTS" == true ]]; then
      error_exit 5 "Remote branch '$BRANCHNAME' is protected and local branch '$BRANCHNAME' does not exist; nothing was removed" \
        "$BRANCHNAME" "$COMMENT"
    fi

    warn "Branch '$BRANCHNAME' is protected; skipping remote deletion and continuing with local deletion only"
    if [[ "$REMOTE_EXISTS" == true ]]; then
      REMOTE_PROTECTED_SKIPPED=true
    fi
    MODE="local"
  fi
fi

# Verify branch exists in the requested mode
if [[ "$MODE" == "local" && "$LOCAL_EXISTS" == false ]]; then
  _msg="Local branch '$BRANCHNAME' does not exist"
  error_exit 3 "$_msg" "$BRANCHNAME" "$COMMENT"
elif [[ "$MODE" == "remote" && "$REMOTE_EXISTS" == false ]]; then
  _msg="Remote branch '$BRANCHNAME' does not exist"
  error_exit 3 "$_msg" "$BRANCHNAME" "$COMMENT"
elif [[ "$MODE" == "both" && "$LOCAL_EXISTS" == false && \
    "$REMOTE_EXISTS" == false ]]; then
  _msg="Branch '$BRANCHNAME' does not exist locally" 
  error_exit 3 "$_msg or remotely" "$BRANCHNAME" \
      "$COMMENT"
fi

# Additional preconditions for local deletion.
if [[ "$MODE" == "local" || "$MODE" == "both" ]]; then
  if [[ "$LOCAL_EXISTS" == true ]]; then
    if bt_is_worktree_dirty; then
      error_exit 8 "Working tree must be clean before deleting local branch '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
    fi

    BRANCH_AUTO_STASH_REF="$(find_branch_auto_stash_ref "$BRANCHNAME")"
    if [[ -n "$BRANCH_AUTO_STASH_REF" ]]; then
      error_exit 8 "Pending auto-stash '$BRANCH_AUTO_STASH_REF' exists for '$BRANCHNAME'; switch to '$BRANCHNAME' to recover it (or drop it explicitly) before deletion" "$BRANCHNAME" "$COMMENT"
    fi
  fi
fi

# Delete local branch if needed
if [[ "$MODE" == "local" || "$MODE" == "both" ]]; then
  if [[ "$LOCAL_EXISTS" == true ]]; then
    info "Deleting local branch..."
    
    # Check if we're currently on the branch
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$CURRENT_BRANCH" == "$BRANCHNAME" ]]; then
      info "Switching away from '$BRANCHNAME' before deletion..."
      if [[ "$BRANCHNAME" != "main" ]] && local_branch_exists "main"; then
        if ! git switch main >/dev/null 2>&1; then
          _msg="Failed to switch away from branch"
          error_exit 2 "$_msg '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
        fi
      elif remote_branch_exists "main"; then
        if ! git switch --detach "origin/main" >/dev/null 2>&1; then
          _msg="Failed to switch away from branch"
          error_exit 2 "$_msg '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
        fi
      else
        _msg="Failed to switch away from branch"
        error_exit 2 "$_msg '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
      fi
    fi
    
    if ! git branch -d "$BRANCHNAME" >/dev/null 2>&1; then
      if [[ "$FORCE" == true ]]; then
        _msg="Local branch has unmerged commits, forcing"
        warn "$_msg deletion..."
        if ! git branch -D "$BRANCHNAME" >/dev/null 2>&1; then
          _msg="Failed to delete local branch"
          error_exit 2 "$_msg '$BRANCHNAME'" "$BRANCHNAME" \
              "$COMMENT"
        fi
      else
        error_exit 6 "Local branch '$BRANCHNAME' has unmerged commits; use -f option to force removal" "$BRANCHNAME" "$COMMENT"
      fi
    fi
    
    success "Local branch '$BRANCHNAME' deleted"
  fi
fi

# Delete remote branch if needed
if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  if [[ "$REMOTE_EXISTS" == true ]]; then
    info "Deleting remote branch..."
    if ! GIT_BYPASS_HOOKS=true git push origin --delete "$BRANCHNAME" >/dev/null 2>&1; then
    _msg="Failed to delete remote branch" 
    error_exit 2 "$_msg '$BRANCHNAME'" "$BRANCHNAME" \
        "$COMMENT"
    fi
    
    success "Remote branch '$BRANCHNAME' deleted"
  fi
fi

# Log successful operation
_log_msg="Branch \`$BRANCHNAME\` deleted."
log_operation "SUCCESS" "$BRANCHNAME" "$_log_msg" \
    "$COMMENT"

if [[ "$REMOTE_PROTECTED_SKIPPED" == true ]]; then
  warn "Local branch '$BRANCHNAME' deleted, but remote branch is protected and was not deleted"
  exit 4
fi

success "Branch '$BRANCHNAME' successfully removed"

exit 0
