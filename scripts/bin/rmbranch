#!/usr/bin/env bash

# rmbranch - Remove a branch locally and/or from remote.
#
# See usage below for details, or run: rmbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  rmbranch [OPTIONS] <branchname> [-- MSG]
  rmbranch {-h | --help}

Remove a local branch and/or remote branch.

Arguments:
  <branchname>       Name of the branch to remove.
                     Examples: fix/bug, add-feature, refactor.

Protected branches:
  - main and version branches cannot be removed from remote.
  - Local protected branches can be removed when they exist as local.
  - No branch-name policy validation is applied by this script. If a branch
    ref exists (local and/or remote), it can be removed subject to protected
    branch safeguards above.

Permissions:
  - The current user must be a contributor, reviewer, or approver.

Options:
  -h, --help         Output this help to stdout and exit (other options
                     and arguments are ignored).
  -l                 Remove local branch.
  -r                 Remove branch from remote.
  -a                 Remove from both local and remote (alias for -l -r).
  -f                 Force removal when local branch has unmerged commits.
  -m "MSG"           Attach a commit message/comment to the
                     operation. Usage: rmbranch patch/old-fix -m
                     "Reverted in favor of better approach.".
  --message "MSG"    Attach a commit message/comment to the
                     operation. Usage: rmbranch old-fix --message
                     "Reverted in favor of better approach."
  -- MSG             Attach a commit message/comment (everything
                     after -- is the comment). Usage: rmbranch
                     old-fix -- Reverted in favor of better approach.
                     Note: No quotes needed, captures all remaining.

Safety behavior:
  - rmbranch does not prompt for confirmation.
  - Without -f, local deletion uses safe mode and fails if unmerged
    commits exist.
  - When local deletion is requested (-l or default both), working tree must
    be clean before deletion starts.
  - Local deletion is blocked if a pending `chbranch` auto-stash exists for
    the target branch.
  - Rerun with -f only after validating branch cleanup status.

Modes:
  Local (-l):
    - Remove the local branch.
    - Log the operation to 'logs/local_branch_history.md'.

  Remote (-r):
    - Remove the branch from remote only.
    - Log the operation to 'logs/remote_branch_history.md'.
    - Exits with code 5 if the remote branch is protected and
      cannot be removed.

  Both (-l -r, default):
    - Remove the local branch.
    - Remove the branch from remote if it is not protected (main
      or version branches).
    - Exits with code 4 when local removal succeeded but remote
      protected branch removal was skipped.
    - Log the operation to 'logs/remote_branch_history.md' and
      'logs/local_branch_history.md'

Examples: Basic usage.
  rmbranch old-fix
  rmbranch -l old-fix
  rmbranch -r experiment
  rmbranch -l -r -f temp-feature
  rmbranch -a -f temp-feature

Examples: With GitHub-style comment.
  rmbranch old-fix -m "Reverted in favor of better
    approach."
  rmbranch -r experiment -m "Experiment failed."

Examples: With Unix-style comment.
  rmbranch old-fix -- Reverted in favor of better
    approach.
  rmbranch -r experiment -- Experiment failed.

Examples: Force removal with comment.
  rmbranch -f temp -m "Temporary testing branch."
  rmbranch -a -f old -- Cleanup old feature branch.

Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.

Exit codes:
  0   Success.
  1   Argument error.
  2   Git operation failed.
  3   Branch does not exist.
  4   Local branch removed successfully but remote branch is
      protected and was not removed (applies to both-mode requests).
  5   Remote branch is protected (cannot remove).
  6   Branch has unmerged commits (use -f option to force removal).
  7   User is not authorized (must be contributor or higher).
  8   Local deletion blocked (working tree not clean or pending auto-stash
      exists for target branch).
EOF
}

# High-Level Flow:
# 1) Parse flags and determine requested scope (local/remote/both).
# 2) Validate repo context and contributor-or-higher authorization.
# 3) Refresh remote refs for remote-involved operations.
# 4) Resolve branch presence and enforce protected-branch policy.
# 5) Enforce local safety preconditions (clean tree, no pending auto-stash).
# 6) Execute local and/or remote deletion with actionable diagnostics.
# 7) Write operation history and emit final status/exit code.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
_LOG_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
[[ "$_LOG_BRANCH" == "HEAD" ]] && _LOG_BRANCH="main"

COMMON_HELPER="$SCRIPT_DIR/../helpers/common.sh"
HISTORY_HELPER="$SCRIPT_DIR/../helpers/history_log.sh"
GIT_HELPER="$SCRIPT_DIR/../helpers/git_helpers.sh"
CKROLE_HELPER="$SCRIPT_DIR/../helpers/ckrole.sh"

# Exit codes used by this script.
E_ARGS=1
E_GIT=2
E_NOT_FOUND=3
E_REMOTE_PROTECTED_SKIPPED=4
E_REMOTE_PROTECTED=5
E_UNMERGED=6
E_UNAUTHORIZED=7
E_LOCAL_BLOCKED=8

# Operation state.
MODE="both" # local, remote, both
FORCE=false
COMMENT=""
INCLUDE_LOCAL_FLAG=false
INCLUDE_REMOTE_FLAG=false
REMOTE_PROTECTED_SKIPPED=false
BRANCHNAME=""
LOCAL_EXISTS=false
REMOTE_EXISTS=false
LOG_FILE=""

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$E_ARGS"
}

require_file() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    echo "Error: Required helper not found: $path" >&2
    exit "$E_GIT"
  fi
}

source_or_die() {
  local path="$1"
  if ! source "$path"; then
    echo "Error: Failed to load helper: $path" >&2
    exit "$E_GIT"
  fi
}

initialize_helpers() {
  require_file "$COMMON_HELPER"
  require_file "$HISTORY_HELPER"
  require_file "$GIT_HELPER"
  require_file "$CKROLE_HELPER"

  # shellcheck source=helpers/common.sh
  source_or_die "$COMMON_HELPER"
  # shellcheck source=helpers/history_log.sh
  source_or_die "$HISTORY_HELPER"
  # shellcheck source=helpers/git_helpers.sh
  source_or_die "$GIT_HELPER"

  LOG_FILE="$REPO_ROOT/$(bt_branch_to_history_file "$_LOG_BRANCH")"
}

append_log_entry() {
  local log_file="$1"
  local status="$2"
  local branchname="$3"
  local message="$4"
  local comment="${5:-}"

  # status/branchname retained for compatibility with existing callers.
  : "$status" "$branchname"
  if ! bt_append_history_log "$log_file" "$message" "$comment"; then
    echo "Warning: Failed to append history log: $log_file" >&2
  fi
}

log_operation() {
  local status="$1"
  local branchname="$2"
  local message="$3"
  local comment="${4:-}"

  # status/branchname are retained for compatibility with existing callers.
  : "$status" "$branchname"
  append_log_entry "$LOG_FILE" "" "" "$message" "$comment"
}

error_exit() {
  local code="$1"
  local message="$2"
  local branchname="${3:-}"
  local comment="${4:-}"

  echo "Error: $message" >&2
  if [[ -n "$branchname" ]]; then
    local log_msg
    log_msg="Branch \`$branchname\` deletion failed"
    log_operation "FAILED" "$branchname" "$log_msg - $message" "$comment"
  fi
  exit "$code"
}

info() {
  bt_info "$1"
}

success() {
  bt_success "$1"
}

warn() {
  bt_warn "$1"
}

local_branch_exists() {
  local branch="$1"
  git show-ref --verify --quiet "refs/heads/$branch"
}

remote_branch_exists() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

find_branch_auto_stash_ref() {
  local branch="$1"
  local prefix

  prefix="chbranch-auto:${branch}:"
  git stash list --format='%gd%x09%gs' | \
    awk -F '\t' -v p="$prefix" 'index($2, p) { print $1; exit }'
}

parse_args() {
  local positional_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      -l)
        INCLUDE_LOCAL_FLAG=true
        shift
        ;;
      -r)
        INCLUDE_REMOTE_FLAG=true
        shift
        ;;
      -a)
        INCLUDE_LOCAL_FLAG=true
        INCLUDE_REMOTE_FLAG=true
        shift
        ;;
      -f)
        FORCE=true
        shift
        ;;
      -m | --message)
        if [[ $# -lt 2 ]]; then
          usage_error "Option -m requires a message argument"
        fi
        if [[ -n "$COMMENT" ]]; then
          usage_error "Cannot use both -m and -- for comment"
        fi
        COMMENT="$2"
        shift 2
        ;;
      --)
        shift
        if [[ -n "$COMMENT" ]]; then
          usage_error "Cannot use both -m and -- for comment"
        fi
        COMMENT="$*"
        break
        ;;
      -*)
        usage_error "Unknown option: $1"
        ;;
      *)
        positional_args+=("$1")
        shift
        ;;
    esac
  done

  if [[ "$INCLUDE_LOCAL_FLAG" == false && "$INCLUDE_REMOTE_FLAG" == false ]]; then
    MODE="both"
  elif [[ "$INCLUDE_LOCAL_FLAG" == true && "$INCLUDE_REMOTE_FLAG" == true ]]; then
    MODE="both"
  elif [[ "$INCLUDE_LOCAL_FLAG" == true ]]; then
    MODE="local"
  else
    MODE="remote"
  fi

  set -- "${positional_args[@]}"
  if [[ $# -ne 1 ]]; then
    usage_error "Expected 1 argument (branchname), got $#"
  fi

  BRANCHNAME="$1"
  if [[ -z "$BRANCHNAME" ]]; then
    usage_error "Branch name cannot be empty"
  fi
}

validate_runtime_context() {
  cd "$REPO_ROOT"

  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    error_exit "$E_GIT" "Repository root '$REPO_ROOT' is not a Git working tree" "$BRANCHNAME" "$COMMENT"
  fi

  if ! bash "$CKROLE_HELPER" contributor >/dev/null 2>&1; then
    local actor_login
    actor_login="$(bt_resolve_login_or_empty)"
    if [[ -z "$actor_login" ]]; then
      actor_login="<unknown>"
    fi
    error_exit "$E_UNAUTHORIZED" "User '$actor_login' is not authorized to run rmbranch (requires contributor role or higher)" "$BRANCHNAME" "$COMMENT"
  fi

  if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
    if ! git remote get-url origin >/dev/null 2>&1; then
      error_exit "$E_GIT" "Remote 'origin' is not configured" "$BRANCHNAME" "$COMMENT"
    fi
  fi
}

describe_operation() {
  case "$MODE" in
    local) info "Removing local branch '$BRANCHNAME'..." ;;
    remote) info "Removing branch '$BRANCHNAME' from remote..." ;;
    both) info "Removing branch '$BRANCHNAME' from local and remote..." ;;
  esac
}

sync_remote_state_if_needed() {
  if [[ "$MODE" != "remote" && "$MODE" != "both" ]]; then
    return 0
  fi

  info "Fetching latest refs from remote..."

  local fetch_err
  if ! fetch_err=$(git fetch origin 2>&1); then
    error_exit "$E_GIT" "Failed to fetch from remote: $fetch_err" "$BRANCHNAME" "$COMMENT"
  fi

  # Repository history propagation is best-effort. It should not block branch
  # deletion when remote metadata is unavailable.
  set +e
  bt_propagate_repository_history
  local propagate_rc=$?
  set -e
  case "$propagate_rc" in
    1) info "Updated repository history from remote" ;;
    *) ;;
  esac
}

refresh_branch_presence() {
  LOCAL_EXISTS=false
  REMOTE_EXISTS=false

  if local_branch_exists "$BRANCHNAME"; then
    LOCAL_EXISTS=true
  fi
  if remote_branch_exists "$BRANCHNAME"; then
    REMOTE_EXISTS=true
  fi
}

apply_protected_branch_policy() {
  if ! bt_is_protected_branch "$BRANCHNAME"; then
    return 0
  fi

  if [[ "$MODE" == "remote" ]]; then
    error_exit "$E_REMOTE_PROTECTED" "Remote branch '$BRANCHNAME' is protected and cannot be removed" "$BRANCHNAME" "$COMMENT"
  fi

  if [[ "$MODE" == "both" ]]; then
    if [[ "$LOCAL_EXISTS" == false && "$REMOTE_EXISTS" == true ]]; then
      error_exit "$E_REMOTE_PROTECTED" "Remote branch '$BRANCHNAME' is protected and local branch '$BRANCHNAME' does not exist; nothing was removed" "$BRANCHNAME" "$COMMENT"
    fi
    warn "Branch '$BRANCHNAME' is protected; skipping remote deletion and continuing with local deletion only"
    if [[ "$REMOTE_EXISTS" == true ]]; then
      REMOTE_PROTECTED_SKIPPED=true
    fi
    MODE="local"
  fi
}

ensure_requested_refs_exist() {
  if [[ "$MODE" == "local" && "$LOCAL_EXISTS" == false ]]; then
    error_exit "$E_NOT_FOUND" "Local branch '$BRANCHNAME' does not exist" "$BRANCHNAME" "$COMMENT"
  fi

  if [[ "$MODE" == "remote" && "$REMOTE_EXISTS" == false ]]; then
    error_exit "$E_NOT_FOUND" "Remote branch '$BRANCHNAME' does not exist" "$BRANCHNAME" "$COMMENT"
  fi

  if [[ "$MODE" == "both" && "$LOCAL_EXISTS" == false && "$REMOTE_EXISTS" == false ]]; then
    error_exit "$E_NOT_FOUND" "Branch '$BRANCHNAME' does not exist locally or remotely" "$BRANCHNAME" "$COMMENT"
  fi
}

check_local_deletion_preconditions() {
  if [[ "$MODE" != "local" && "$MODE" != "both" ]]; then
    return 0
  fi

  if [[ "$LOCAL_EXISTS" != true ]]; then
    return 0
  fi

  if bt_is_worktree_dirty; then
    error_exit "$E_LOCAL_BLOCKED" "Working tree must be clean before deleting local branch '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
  fi

  # Do not allow deletion while a branch-specific auto-stash recovery marker is
  # present, to avoid silently orphaning user recovery state.
  local branch_auto_stash_ref
  branch_auto_stash_ref="$(find_branch_auto_stash_ref "$BRANCHNAME")"
  if [[ -n "$branch_auto_stash_ref" ]]; then
    error_exit "$E_LOCAL_BLOCKED" "Pending auto-stash '$branch_auto_stash_ref' exists for '$BRANCHNAME'; switch to '$BRANCHNAME' to recover it (or drop it explicitly) before deletion" "$BRANCHNAME" "$COMMENT"
  fi
}

switch_away_from_target_if_current() {
  local current_branch
  current_branch="$(git rev-parse --abbrev-ref HEAD)"
  if [[ "$current_branch" != "$BRANCHNAME" ]]; then
    return 0
  fi

  info "Switching away from '$BRANCHNAME' before deletion..."

  local switch_err
  if [[ "$BRANCHNAME" != "main" ]] && local_branch_exists "main"; then
    if ! switch_err=$(git switch main 2>&1); then
      error_exit "$E_GIT" "Failed to switch away from branch '$BRANCHNAME': $switch_err" "$BRANCHNAME" "$COMMENT"
    fi
    return 0
  fi

  if remote_branch_exists "main"; then
    if ! switch_err=$(git switch --detach "origin/main" 2>&1); then
      error_exit "$E_GIT" "Failed to switch away from branch '$BRANCHNAME': $switch_err" "$BRANCHNAME" "$COMMENT"
    fi
    return 0
  fi

  if ! switch_err=$(git switch --detach HEAD 2>&1); then
    error_exit "$E_GIT" "Failed to switch away from branch '$BRANCHNAME': $switch_err" "$BRANCHNAME" "$COMMENT"
  fi
}

delete_local_if_needed() {
  if [[ "$MODE" != "local" && "$MODE" != "both" ]]; then
    return 0
  fi
  if [[ "$LOCAL_EXISTS" != true ]]; then
    return 0
  fi

  info "Deleting local branch..."
  switch_away_from_target_if_current

  local local_delete_err
  if ! local_delete_err=$(git branch -d "$BRANCHNAME" 2>&1); then
    if [[ "$FORCE" == true ]]; then
      warn "Local branch has unmerged commits, forcing deletion..."
      local force_delete_err
      if ! force_delete_err=$(git branch -D "$BRANCHNAME" 2>&1); then
        error_exit "$E_GIT" "Failed to delete local branch '$BRANCHNAME': $force_delete_err" "$BRANCHNAME" "$COMMENT"
      fi
    else
      if grep -qi "not fully merged" <<< "$local_delete_err"; then
        error_exit "$E_UNMERGED" "Local branch '$BRANCHNAME' has unmerged commits; use -f option to force removal" "$BRANCHNAME" "$COMMENT"
      fi
      error_exit "$E_GIT" "Failed to delete local branch '$BRANCHNAME': $local_delete_err" "$BRANCHNAME" "$COMMENT"
    fi
  fi

  success "Local branch '$BRANCHNAME' deleted"
}

delete_remote_if_needed() {
  if [[ "$MODE" != "remote" && "$MODE" != "both" ]]; then
    return 0
  fi
  if [[ "$REMOTE_EXISTS" != true ]]; then
    return 0
  fi

  info "Deleting remote branch..."

  local push_delete_err
  if ! push_delete_err=$(GIT_BYPASS_HOOKS=true git push origin --delete "$BRANCHNAME" 2>&1); then
    error_exit "$E_GIT" "Failed to delete remote branch '$BRANCHNAME': $push_delete_err" "$BRANCHNAME" "$COMMENT"
  fi

  success "Remote branch '$BRANCHNAME' deleted"
}

finalize_success() {
  local log_msg
  log_msg="Branch \`$BRANCHNAME\` deleted."
  log_operation "SUCCESS" "$BRANCHNAME" "$log_msg" "$COMMENT"

  if [[ "$REMOTE_PROTECTED_SKIPPED" == true ]]; then
    warn "Local branch '$BRANCHNAME' deleted, but remote branch is protected and was not deleted"
    exit "$E_REMOTE_PROTECTED_SKIPPED"
  fi

  success "Branch '$BRANCHNAME' successfully removed"
}

main() {
  initialize_helpers
  parse_args "$@"
  # Intentionally no naming-policy validation: rmbranch is used for ref cleanup
  # of legacy/non-conforming branch names as well.
  validate_runtime_context
  describe_operation
  sync_remote_state_if_needed
  refresh_branch_presence
  apply_protected_branch_policy
  ensure_requested_refs_exist
  check_local_deletion_preconditions
  delete_local_if_needed
  delete_remote_if_needed
  finalize_success
}

main "$@"
exit 0
