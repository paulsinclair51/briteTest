#!/usr/bin/env bash

# lsbranch - list branches and their status.
#
# See usage below for details, or run: lsbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  lsbranch [-b] [-v]
  lsbranch BRANCH [-b] [-v]
  lsbranch {-a | PATTERN} [-b] [-i] [-l] [-r] [-v] [-x "PATTERN"]
  lsbranch {-h | --help}

For first usage, list status of the current branch and its parent
branch.

Use BRANCH to list status of the branch with the name BRANCH and
its parent branch.

Use -a or PATTERN to list the status of branches matching "*"
or PATTERN, respectively.

A branch report is written to <repo>/reports/branch/branch-<datetime>.md

  - Report files are made read-only after generation. To edit a report,
    copy it outside the repository first.
  - Report files are local-only artifacts: lsbranch does not commit
    or push them.

Report includes:
  Branch:  Indicates the branch name. `*` indicates this is
           the current branch. '!' indicates the branch name
           violates naming rules.
  Type:    Indicates branch is `local` or `remote`.
  Parent:  Parent branch reference for the row when applicable.
           For example, 'main' or 'v1.0.0'.
  Status:  'clean', 'dirty', 'read-only', or 'not checked out' for local
           worktree state. For local branches, 'clean'/'dirty' reflect the
           current checkout's shared working tree, including untracked files.
           If branch-matching legacy auto-stashes exist
           (label: chcurrent-auto:BRANCH:TIMESTAMP),
           status includes '; auto-stash:N' in reports and
           '[auto-stash: N]' in stdout rows.
           'synced' or 'diverged' for tracked-branch state,
           or 'unknown'.
  Staged/Unstaged: Count of staged files and count of unstaged files.
           Unstaged includes tracked modifications and untracked files
           (anything requiring 'git add' before commit).
  Unpushed Commits: Count of local commits pending sync
           for this branch.
  Ahead/Behind: Counts of commits this branch is ahead of / behind
           its tracked remote branch and parent branch.
  PR:      Count of pending (not closed) pull requests.
  First Commit: Approximate date of the branch's first commit.
  Last Commit: Date of the last commit on the branch.

Arguments:
  BRANCH      Check branch with name BRANCH.
  PATTERN     Filter branches by quoted (") glob pattern on
              branch name. Supports *, ?, [abc], etc.
              Examples: "*bug*", "fix*",  "*issue*".

Options (see above for the options allowed for each form of usage):

  -a          Same as specifying "*" as PATTERN.
  -b          Black text (disable color) in stdout and report output.
  -h          Output this help to stdout and exit (other options
              and arguments are ignored). Help is output also
              if invalid arguments or options are provided.
  --help      Alias for -h.
  -i          List branches that violate naming rules (see
              Contributor Guide for rules).
  -l          List local branches.
  -r          List remote branches.
  -v          Verbose output to stdout for debugging.
  -x PATTERN  Exclude branches matching the given quoted (") glob
              pattern.

  If neither -l nor -r is specified, same as specifying
  both -l and -r (i.e., both local and remote branches are listed).

Examples:
  # Check current branch
  lsbranch

  # Check all branches (local and remote)
  lsbranch -a
  lsbranch -a -l -r
  lsbranch "*"
  lsbranch "*" -l -r

  # Check local branches
  lsbranch -a -l
  lsbranch "*" -l

  # Check remote branches
  lsbranch -a -r
  lsbranch "*" -r

  # Check development branches (both local and remote)
  lsbranch "dev/*"

  # Check branches matching pattern (both local and remote)
  lsbranch "*auth*"

  # Verbose output for current branch
  lsbranch -v

Outputs:
  - Writes help (usage) text or status messages for the
    selected branches to stdout.
  - Writes errors and diagnostics to stderr.
  - When remote is unreachable, remote fields use cached local
    remote refs from your last successful remote update and this is noted
    in stdout and the report.
  - Writes a report to <repo>/reports/branch/branch-<datetime>.md.
  - Removes previous reports before writing a new one.

Exit codes:
  0   Success.
  1   Argument or validation error.
  2   Required branch/repository state not found (for example,
      requested branch reference is missing).
  4   Branches found that violate naming rules if option -i
      specified.
  200 Git/report persistence operation failed.
EOF
}

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_NOT_FOUND=2
readonly EXIT_OPERATION_FAILED=200
readonly EXIT_CONFIG_ERROR=4
readonly EXIT_RUNTIME_ERROR=200

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

# High-Level Flow:
# 1. Validate arguments and parse options (-a, -l, -r, -v, -b, -i, -x).
# 2. Resolve query scope: current branch, exact branch, or glob pattern.
# 3. Set up report directory and capture initial repository state.
# 4. Ensure remote refs are up-to-date (with timeout and fallback).
# 5. For each candidate branch:
#    - Collect status, sync metrics, PR count with per-field error fallbacks.
#    - Append row to markdown report table.
#    - Print compact status to stdout.
# 6. Persist report locally (no commit/push).
# 7. Log warnings for degraded data collection; exit with appropriate code.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${SCRIPT_DIR}/../.." && pwd)"
branch_reports_dir="$repo_root/reports/branch"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/github_helpers.sh
source "$SCRIPT_DIR/../helpers/github_helpers.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"

RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
ORIGINAL_ARGS=("$@")
REPORT_COMMAND=""

# Default options
OUTPUT_FILE=""
BRANCH_REPORT_DELETIONS=()
BRANCH_PATTERN=""
EXCLUDE_PATTERN=""
TARGET_BRANCH=""
VERBOSE=false
INVALID_BRANCHES_FOUND=0
ALL_BRANCHES=false
INCLUDE_LOCAL_FLAG=false
INCLUDE_REMOTE_FLAG=false
INVALID_ONLY=false
COLOR_OUTPUT=true
NO_ARG_MODE=false
FETCH_ATTEMPTED=false
FETCH_FAILED=false
WARNINGS_FILE=""
AUTO_STASH_INDEX_READY=false
INITIAL_STATUS_PORCELAIN=""
BRANCH_REPORTS_DIR_UNLOCKED=false
declare -A AUTO_STASH_COUNTS=()

COLOR_RESET=$'\033[0m'
COLOR_BOLD_GREEN=$'\033[1;92m'
COLOR_BOLD_RED=$'\033[1;31m'

# Validate temporary file creation for diagnostics
if ! WARNINGS_FILE="$(mktemp)"; then
  echo "Error: Failed to create temporary file for warnings." >&2
  exit "$EXIT_RUNTIME_ERROR"
fi

cleanup_runtime_files() {
  # shellcheck disable=SC2317  # Invoked by trap cleanup_runtime_files EXIT.
  if [[ "$BRANCH_REPORTS_DIR_UNLOCKED" == true ]]; then
    bt_report_dir_disable_writes "$branch_reports_dir" "$EXIT_OPERATION_FAILED" || true
    BRANCH_REPORTS_DIR_UNLOCKED=false
  fi
  # Suppress errors during cleanup to ensure trap always completes
  rm -f "$WARNINGS_FILE" 2>/dev/null || true
}

trap cleanup_runtime_files EXIT

matches_glob() {
  local text="$1"
  local pattern="$2"
  # shellcheck disable=SC2053  # pattern is intentionally treated as glob.
  [[ "$text" == $pattern ]]
}

append_unique_branch_line() {
  local existing_list="$1"
  local candidate="$2"

  [[ -n "$candidate" ]] || {
    printf '%s' "$existing_list"
    return 0
  }

  if [[ -z "$existing_list" ]]; then
    printf '%s' "$candidate"
    return 0
  fi

  if printf '%s\n' "$existing_list" | grep -Fxq "$candidate"; then
    printf '%s' "$existing_list"
  else
    printf '%s\n%s' "$existing_list" "$candidate"
  fi
}

# Branch existence checks
has_local_branch() {
  local branch="$1"
  git show-ref --verify --quiet "refs/heads/$branch"
}

has_remote_branch() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

capture_initial_worktree_status() {
  # Snapshot git status before mutations to report files for accurate stdout/report
  # Use --no-optional-locks to prevent git index refresh and opportunistic locking
  INITIAL_STATUS_PORCELAIN="$(git --no-optional-locks status --porcelain 2>/dev/null || true)"
}

enable_branch_reports_write_access() {
  bt_report_dir_enable_writes "$branch_reports_dir" "$EXIT_OPERATION_FAILED"
  BRANCH_REPORTS_DIR_UNLOCKED=true
}

disable_branch_reports_write_access() {
  if [[ "$BRANCH_REPORTS_DIR_UNLOCKED" == true ]]; then
    bt_report_dir_disable_writes "$branch_reports_dir" "$EXIT_OPERATION_FAILED"
    BRANCH_REPORTS_DIR_UNLOCKED=false
  fi
}

# Branch naming rule validators
# Main:  main
# Version: v#.#.# (e.g., v1.0.0, v10.5.9)
# Targeted: (dev|fix)/<desc>-v#.#.# (e.g., dev/auth-fix-v1.0.0)
# Contributor: [<type>/]<desc> (e.g., feature/new-login, jsmith/bug-fix)
is_version_branch() {
  local branch="$1"
  [[ "$branch" =~ ^v([1-9][0-9]?)\.([0-9]|[1-9][0-9]?)\.([0-9]|[1-9][0-9]?)$ ]]
}

is_main_branch() {
  local branch="$1"
  [[ "$branch" == "main" ]]
}

is_targeted_branch() {
  local branch="$1"
  local desc='[a-z0-9]+(-[a-z0-9]+)*'

  [[ "$branch" =~ ^(dev|fix)/${desc}-v([1-9][0-9]?)\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$ ]]
}

is_contributor_branch() {
  local branch="$1"
  local desc='[a-z0-9]+(-[a-z0-9]+)*'
  local type='[a-z][a-z]{0,29}'

  [[ "$branch" =~ ^((${type}/)?${desc})$ && "$branch" != "main" ]]
}

is_protected_branch() {
  local branch="$1"

  if is_main_branch "$branch" || is_version_branch "$branch"; then
    return 0
  fi
  return 1
}

branch_violates_naming_rules() {
  local branch="$1"

  if is_main_branch "$branch" || is_version_branch "$branch" ||
    is_targeted_branch "$branch" || is_contributor_branch "$branch"; then
    return 1
  fi
  return 0
}

branch_name_display() {
  local branch="$1"
  local suffix=""

  if branch_violates_naming_rules "$branch"; then
    suffix="!"
  fi

  printf '%s%s\n' "$branch" "$suffix"
}

supports_color_output() {
  [[ "$COLOR_OUTPUT" == true && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]
}

supports_report_color_output() {
  [[ "$COLOR_OUTPUT" == true && -z "${NO_COLOR:-}" ]]
}

add_report_warning() {
  local message="$1"

  if grep -Fqx "$message" "$WARNINGS_FILE" 2>/dev/null; then
    return 0
  fi

  printf '%s\n' "$message" >> "$WARNINGS_FILE"
}

record_diagnostic() {
  local message="$1"
  local detail="${2:-}"

  add_report_warning "$message"

  if [[ "$VERBOSE" == true ]]; then
    if [[ -n "$detail" ]]; then
      printf '  Warning: %s (%s)\n' "$message" "$detail" >&2
    else
      printf '  Warning: %s\n' "$message" >&2
    fi
  fi
}

capture_command_output() {
  local stdout_var="$1"
  local stderr_var="$2"
  shift 2

  local stdout_file
  local stderr_file
  local rc
  
  # Create temporary files for captured output
  if ! stdout_file=$(mktemp); then
    printf -v "$stdout_var" '%s' ""
    printf -v "$stderr_var" '%s' "mktemp failed for stdout"
    return 1
  fi
  if ! stderr_file=$(mktemp); then
    rm -f "$stdout_file"
    printf -v "$stdout_var" '%s' ""
    printf -v "$stderr_var" '%s' "mktemp failed for stderr"
    return 1
  fi

  # Execute command and capture output; preserve exit code
  set +e
  "$@" >"$stdout_file" 2>"$stderr_file"
  rc=$?
  set -e

  # Read captured output into variables
  printf -v "$stdout_var" '%s' "$(<"$stdout_file")"
  printf -v "$stderr_var" '%s' "$(<"$stderr_file")"

  # Clean up temporary files
  rm -f "$stdout_file" "$stderr_file" || true
  return "$rc"
}

branch_name_status_display() {
  local branch="$1"
  local is_current="${2:-false}"
  local display="$branch"

  if supports_color_output; then
    if branch_violates_naming_rules "$branch"; then
      display+="${COLOR_BOLD_RED}!${COLOR_RESET}"
    fi
    if [[ "$is_current" == true ]]; then
      display+="${COLOR_BOLD_GREEN}*${COLOR_RESET}"
    fi
  else
    if branch_violates_naming_rules "$branch"; then
      display+="!"
    fi
    if [[ "$is_current" == true ]]; then
      display+="*"
    fi
  fi

  printf '%s\n' "$display"
}

branch_name_report_display() {
  local branch="$1"
  local is_current="${2:-false}"
  local display="$branch"

  if supports_report_color_output; then
    if branch_violates_naming_rules "$branch"; then
      display+="<span style=\"color:#c62828;font-weight:700\">!</span>"
    fi
    if [[ "$is_current" == true ]]; then
      display+="<span style=\"color:#66bb6a;font-weight:700\">*</span>"
    fi
  else
    if branch_violates_naming_rules "$branch"; then
      display+="!"
    fi
    if [[ "$is_current" == true ]]; then
      display+="*"
    fi
  fi

  printf '%s\n' "$display"
}

apply_exclude_filter() {
  local branches="$1"
  local exclude_pattern="$2"

  if [[ -z "$exclude_pattern" ]]; then
    printf '%s\n' "$branches"
    return 0
  fi

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    if ! matches_glob "$branch" "$exclude_pattern"; then
      echo "$branch"
    fi
  done <<< "$branches"
}

get_branch_created_date() {
  local branch="$1"
  local ref_type="${2:-local}"
  local ref="$branch"
  local log_output=""
  local log_error=""

  if [[ "$ref_type" == "remote" ]]; then
    ref="origin/$branch"
  fi

  if ! capture_command_output \
    log_output log_error \
    git log "$ref" --reverse --date=short --format='%ad'; then
    record_diagnostic \
      "Failed to read first commit date for '$ref';" \
      "First Commit column left blank." \
      "$log_error"
    echo ""
    return 0
  fi

  printf '%s\n' "$log_output" | head -n 1
}

get_branch_last_commit_date() {
  local branch="$1"
  local ref_type="${2:-local}"
  local ref="$branch"
  local log_output=""
  local log_error=""

  if [[ "$ref_type" == "remote" ]]; then
    ref="origin/$branch"
  fi

  if ! capture_command_output \
    log_output log_error \
    git log -1 --date=short --format='%ad' "$ref"; then
    record_diagnostic \
      "Failed to read last commit date for '$ref';" \
      "Last Commit column left blank." \
      "$log_error"
    echo ""
    return 0
  fi

  printf '%s\n' "$log_output"
}

get_remote_branches() {
  local pattern="$1"
  local refs_output=""
  local refs_error=""

  if ! capture_command_output \
    refs_output refs_error \
    git for-each-ref --format='%(refname:short)' refs/remotes/origin; then
    record_diagnostic \
      "Failed to enumerate remote branches; remote rows may be incomplete." \
      "$refs_error"
    echo ""
    return 0
  fi

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    [[ "$branch" == "origin" ]] && continue
    [[ "$branch" == "origin/HEAD" ]] && continue
    branch="${branch#origin/}"
    [[ -z "$branch" ]] && continue
    if matches_glob "$branch" "$pattern"; then
      echo "$branch"
    fi
  done <<< "$refs_output" | sort
}

get_local_branches() {
  local pattern="$1"
  local refs_output=""
  local refs_error=""

  if ! capture_command_output \
    refs_output refs_error \
    git for-each-ref --format='%(refname:short)' refs/heads; then
    record_diagnostic \
      "Failed to enumerate local branches; local rows may be incomplete." \
      "$refs_error"
    echo ""
    return 0
  fi

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    if matches_glob "$branch" "$pattern"; then
      echo "$branch"
    fi
  done <<< "$refs_output" | sort
}

get_remote_only_branches() {
  local pattern="$1"
  get_remote_branches "$pattern" | while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    # Only include if not local
    if ! has_local_branch "$branch"; then
      echo "$branch"
    fi
  done | sort || echo ""
}

check_repo_status() {
  local branch="$1"

  if [[ -n "$INITIAL_STATUS_PORCELAIN" ]]; then
    echo "dirty"
  else
    echo "clean"
  fi
}

get_staged_changes() {
  local branch="$1"

  # Count files with a staged change (column 1 is not a space).
  # Exclude '??' untracked-file lines — untracked files are not staged.
  printf '%s' "$INITIAL_STATUS_PORCELAIN" | awk '
    substr($0,1,2) != "??" && substr($0,1,1) != " " { c++ }
    END { print c + 0 }
  '
}

get_unstaged_changes() {
  local branch="$1"

  # Count files with an unstaged change (column 2 is not a space).
  # Untracked files ("??") have "?" in column 2 and are intentionally
  # included: they represent pending work requiring "git add" before commit,
  # consistent with bt_is_worktree_dirty and the dirty status reported above.
  printf '%s' "$INITIAL_STATUS_PORCELAIN" | awk '
    substr($0,2,1) != " " { c++ }
    END { print c + 0 }
  '
}

persist_report_changes() {
  local report_filename
  local report_rel

  if [[ -z "$OUTPUT_FILE" || ! -f "$OUTPUT_FILE" ]]; then
    bt_error_exit "$EXIT_OPERATION_FAILED" "Report file was not generated as expected."
  fi

  report_filename="$(basename "$OUTPUT_FILE")"
  report_rel="${OUTPUT_FILE#"${repo_root}"/}"
  bt_success "See $report_rel for details."
}

build_auto_stash_index() {
  local stash_output=""
  local stash_error=""
  local subject=""
  local stash_branch=""

  if [[ "$AUTO_STASH_INDEX_READY" == true ]]; then
    return 0
  fi

  AUTO_STASH_INDEX_READY=true

  if ! capture_command_output \
    stash_output stash_error \
    git stash list --format='%gs'; then
    record_diagnostic \
      "Failed to read stash list; auto-stash indicators unavailable." \
      "$stash_error"
    return 0
  fi

  while IFS= read -r subject; do
    [[ -n "$subject" ]] || continue
    if [[ "$subject" =~ chcurrent-auto:([^:]+): ]]; then
      stash_branch="${BASH_REMATCH[1]}"
      AUTO_STASH_COUNTS["$stash_branch"]=$((
        ${AUTO_STASH_COUNTS["$stash_branch"]:-0} + 1
      ))
    fi
  done <<< "$stash_output"
}

get_branch_auto_stash_count() {
  local branch="$1"

  build_auto_stash_index
  echo "${AUTO_STASH_COUNTS["$branch"]:-0}"
}

get_unpushed_commits() {
  local branch="$1"
  local rev_list_output=""
  local rev_list_error=""

  if ! has_remote_branch "$branch"; then
    echo ""
    return 0
  fi

  if ! capture_command_output \
    rev_list_output rev_list_error \
    git rev-list --count "origin/$branch..$branch"; then
    record_diagnostic \
      "Failed to compare '$branch' against 'origin/$branch';" \
      "Unpushed Commits may be blank." \
      "$rev_list_error"
    echo ""
    return 0
  fi

  printf '%s\n' "$rev_list_output"
}

get_behind_count() {
  local branch="$1"
  local rev_list_output=""
  local rev_list_error=""

  if ! has_remote_branch "$branch"; then
    echo ""
    return 0
  fi

  if ! capture_command_output \
    rev_list_output rev_list_error \
    git rev-list --count "$branch..origin/$branch"; then
    record_diagnostic \
      "Failed to compare 'origin/$branch' against '$branch';" \
      "Ahead/Behind may be blank." \
      "$rev_list_error"
    echo ""
    return 0
  fi

  printf '%s\n' "$rev_list_output"
}

get_pending_pr_count() {
  local branch="$1"
  local pr_output=""
  local pr_error=""
  local pr_count

  if ! command -v gh >/dev/null 2>&1; then
    record_diagnostic \
      "PR lookup unavailable for '$branch'; PR column shown as N/A." \
      "gh CLI not found"
    echo "N/A"
    return 0
  fi

  if ! capture_command_output \
    pr_output pr_error \
    gh pr list --head "$branch" --state open --json number --jq 'length'; then
    record_diagnostic \
      "Failed to query pull requests for '$branch'; PR column shown as N/A." \
      "$pr_error"
    echo "N/A"
    return 0
  fi

  pr_count="$pr_output"

  if [[ "$pr_count" =~ ^[0-9]+$ ]]; then
    echo "$pr_count"
  else
    record_diagnostic \
      "Unexpected PR lookup output for '$branch'; PR column shown as N/A." \
      "$pr_count"
    echo "N/A"
  fi
}

ensure_remote_refs_fetched() {
  # shellcheck disable=SC2034  # capture_command_output populates by name.
  local fetch_output=""
  local fetch_error=""

  if [[ "$FETCH_ATTEMPTED" == true ]]; then
    return 0
  fi

  # Skip fetch if only listing local branches
  if [[ "$INCLUDE_LOCAL_FLAG" == true && "$INCLUDE_REMOTE_FLAG" == false ]]; then
    FETCH_ATTEMPTED=true
    return 0
  fi

  FETCH_ATTEMPTED=true
    if ! capture_command_output fetch_output fetch_error timeout 10 git fetch origin; then
    FETCH_FAILED=true
      record_diagnostic \
        "Failed to fetch remote; remote status may use cached refs from your last successful remote update." \
        "$fetch_error"
  fi
  
  # Propagate repository history from remote if available
  bt_propagate_repository_history
  case $? in
    0) ;;
    1) bt_info "Updated repository history from remote" ;;
    *) ;;
  esac
}

# shellcheck disable=SC2317  # Called during report row formatting.
format_zero_as_dash() {
  local value="$1"

  if [[ "$value" =~ ^[0-9]+$ && "$value" -eq 0 ]]; then
    echo "-"
  else
    echo "$value"
  fi
}

format_zero_as_blank() {
  local value="$1"

  if [[ "$value" =~ ^[0-9]+$ && "$value" -eq 0 ]]; then
    echo ""
  else
    echo "$value"
  fi
}

get_branch_type() {
  local branch="$1"
  
  local is_local=false
  local is_remote=false
  
  # Check if branch exists locally
  has_local_branch "$branch" && is_local=true
  
  # Check if branch exists on remote
  has_remote_branch "$branch" && is_remote=true
  
  if [[ "$is_local" == true && "$is_remote" == true ]]; then
    echo "local (tracking origin)"
  elif [[ "$is_local" == true ]]; then
    echo "local"
  elif [[ "$is_remote" == true ]]; then
    echo "remote"
  else
    echo "unknown"
  fi
}

build_report_command() {
  local args_rendered=""
  local arg rendered

  for arg in "${ORIGINAL_ARGS[@]}"; do
    printf -v rendered '%q' "$arg"
    if [[ -z "$args_rendered" ]]; then
      args_rendered="$rendered"
    else
      args_rendered+=" $rendered"
    fi
  done

  if [[ -n "$args_rendered" ]]; then
    REPORT_COMMAND="lsbranch $args_rendered"
  else
    REPORT_COMMAND="lsbranch"
  fi
}

get_branch_base_reference() {
  local branch="$1"
  local branch_ref="$branch"
  local target_version=""
  local branch_tip=""
  local tip_error=""

  if [[ "$branch" == "main" ]]; then
    echo ""
    return 0
  fi

  # Version branches are based on main.
  if [[ "$branch" =~ ^v([1-9][0-9]?)\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$ ]]; then
    echo "main"
    return 0
  fi

  # Directed dev/fix branches explicitly target the version suffix.
  if [[ "$branch" =~ \
    ^(dev|fix)/.+-(v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?))$ ]]; then
    target_version="${BASH_REMATCH[2]}"
    echo "$target_version"
    return 0
  fi

  # Contributor/other branches: infer the nearest ancestor branch.
  if ! has_local_branch "$branch"; then
    if has_remote_branch "$branch"; then
      branch_ref="origin/$branch"
    else
      echo ""
      return 0
    fi
  fi

  if ! capture_command_output \
    branch_tip tip_error \
    git rev-parse "$branch_ref"; then
    record_diagnostic \
      "Failed to resolve branch tip for '$branch'; Parent column left blank." \
      "$tip_error"
    echo ""
    return 0
  fi

  local best_base=""
  local best_distance=""
  local ref

  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    [[ "$ref" == "origin" ]] && continue
    [[ "$ref" == "origin/HEAD" ]] && continue
    [[ "$ref" == "$branch" ]] && continue
    [[ "$ref" == "origin/$branch" ]] && continue

    local candidate_ref="$ref"
    local candidate_display="$ref"
    local candidate_tip=""
    if [[ "$ref" == origin/* ]]; then
      candidate_display="${ref#origin/}"
    fi
    [[ "$candidate_display" == "$branch" ]] && continue

    # If two branches point to the same tip commit, neither should be treated
    # as the other's parent.
    candidate_tip=$(git rev-parse "$candidate_ref" 2>/dev/null || true)
    if [[ -n "$branch_tip" && -n "$candidate_tip" &&
      "$candidate_tip" == "$branch_tip" ]]; then
      continue
    fi

    if ! git merge-base --is-ancestor \
      "$candidate_ref" "$branch_ref" >/dev/null 2>&1; then
      continue
    fi

    local distance
    distance=$(git rev-list --count "$candidate_ref..$branch_ref" \
      2>/dev/null || echo "")
    [[ "$distance" =~ ^[0-9]+$ ]] || continue

    if [[ -z "$best_distance" || "$distance" -lt "$best_distance" ]]; then
      best_distance="$distance"
      best_base="$candidate_display"
    fi
  done < <(
    {
      git for-each-ref --format='%(refname:short)' refs/heads
      git for-each-ref --format='%(refname:short)' refs/remotes/origin
    } | sort -u
  )

  if [[ -z "$best_base" ]]; then
    record_diagnostic \
      "Could not infer parent branch for '$branch'; Parent column left blank."
  fi

  echo "$best_base"
}

resolve_branch_ref() {
  local branch="$1"

  if [[ -z "$branch" ]]; then
    echo ""
    return 0
  fi

  if has_local_branch "$branch"; then
    echo "$branch"
    return 0
  fi

  if has_remote_branch "$branch"; then
    echo "origin/$branch"
    return 0
  fi

  echo ""
}

get_latest_version_branch() {
  local refs_output=""
  local refs_error=""

  if ! capture_command_output \
    refs_output refs_error \
    git for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin; then
    record_diagnostic \
      "Failed to enumerate refs for version-branch comparison; parent inference may be incomplete." \
      "$refs_error"
    echo ""
    return 0
  fi

  local versions=""
  local ref=""
  local branch_name=""

  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    [[ "$ref" == "origin" ]] && continue
    [[ "$ref" == "origin/HEAD" ]] && continue

    branch_name="$ref"
    if [[ "$branch_name" == origin/* ]]; then
      branch_name="${branch_name#origin/}"
    fi

    if is_version_branch "$branch_name"; then
      versions+="$branch_name"$'\n'
    fi
  done <<< "$refs_output"

  if [[ -z "$versions" ]]; then
    echo ""
    return 0
  fi

  printf '%s' "$versions" | sort -u -V | tail -n 1
}

get_remote_comparison_target() {
  local branch="$1"
  local base_reference=""

  if [[ "$branch" == "main" ]]; then
    base_reference=$(get_latest_version_branch)
    if [[ "$base_reference" == "main" ]]; then
      echo ""
      return 0
    fi
    echo "$base_reference"
    return 0
  fi

  base_reference=$(get_branch_base_reference "$branch")
  if [[ "$base_reference" == "$branch" ]]; then
    echo ""
    return 0
  fi

  echo "$base_reference"
}

get_remote_divergence_counts() {
  local branch="$1"
  local compare_branch="$2"
  local compare_ref=""
  local rev_list_output=""
  local rev_list_error=""

  if [[ -z "$compare_branch" ]]; then
    echo ""
    return 0
  fi

  compare_ref=$(resolve_branch_ref "$compare_branch")
  if [[ -z "$compare_ref" ]]; then
    record_diagnostic \
      "Comparison ref '$compare_branch' not found for remote branch '$branch'; Ahead/Behind left blank."
    echo ""
    return 0
  fi

  if ! capture_command_output \
    rev_list_output rev_list_error \
    git rev-list --left-right --count "origin/$branch...$compare_ref"; then
    record_diagnostic \
      "Failed to compare remote branch '$branch' against '$compare_ref'; Ahead/Behind left blank." \
      "$rev_list_error"
    echo ""
    return 0
  fi

  printf '%s\n' "$rev_list_output"
}

get_branch_parent_divergence_counts() {
  local branch="$1"
  local compare_branch="$2"
  local compare_ref=""
  local rev_list_output=""
  local rev_list_error=""

  if [[ -z "$compare_branch" ]]; then
    echo ""
    return 0
  fi

  compare_ref=$(resolve_branch_ref "$compare_branch")
  if [[ -z "$compare_ref" ]]; then
    record_diagnostic \
      "Comparison ref '$compare_branch' not found for local branch '$branch'; Ahead/Behind parent segment left blank."
    echo ""
    return 0
  fi

  if ! capture_command_output \
    rev_list_output rev_list_error \
    git rev-list --left-right --count "$branch...$compare_ref"; then
    record_diagnostic \
      "Failed to compare local branch '$branch' against '$compare_ref'; Ahead/Behind parent segment left blank." \
      "$rev_list_error"
    echo ""
    return 0
  fi

  printf '%s\n' "$rev_list_output"
}

format_ahead_behind_segments() {
  local tracking_ahead="$1"
  local tracking_behind="$2"
  local parent_ahead="$3"
  local parent_behind="$4"
  local tracking_segment=""
  local parent_segment=""

  if [[ "$tracking_ahead" =~ ^[0-9]+$ && "$tracking_behind" =~ ^[0-9]+$ ]]; then
    tracking_segment="remote ${tracking_ahead}/${tracking_behind}"
  fi

  if [[ "$parent_ahead" =~ ^[0-9]+$ && "$parent_behind" =~ ^[0-9]+$ ]]; then
    parent_segment="parent ${parent_ahead}/${parent_behind}"
  fi

  if [[ -n "$tracking_segment" && -n "$parent_segment" ]]; then
    echo "${tracking_segment}; ${parent_segment}"
  elif [[ -n "$tracking_segment" ]]; then
    echo "$tracking_segment"
  elif [[ -n "$parent_segment" ]]; then
    echo "$parent_segment"
  else
    echo ""
  fi
}

# Report generation and output formatting
generate_report_header() {
  local report_header_cols

  report_header_cols='| **Branch** | **Type** | **Parent** | **Status** | '
  report_header_cols+='**Staged/<br>Unstaged** | **Unpushed<br>Commits** | '
  report_header_cols+='**Ahead/<br>Behind** | **PR** | **First Commit** | '
  report_header_cols+='**Last Commit** |'

  cat > "$OUTPUT_FILE" << EOF
# Branch Report ${RUN_TS_DISPLAY}

**Command:** \`${REPORT_COMMAND}\`

$report_header_cols
| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |
EOF
}

append_report_note_about_stale_remote() {
  # Add note if remote refs are from cache (fetch failed/timed out)
  # and we're showing remote branches
  if [[ "$FETCH_FAILED" == true ]] && 
     [[ "$INCLUDE_REMOTE_FLAG" == true || 
        ("$INCLUDE_LOCAL_FLAG" == false && "$INCLUDE_REMOTE_FLAG" == false) ]]; then
    cat >> "$OUTPUT_FILE" << EOF

**Note:** Cannot connect to remote repository. Remote branch status uses cached refs from your last successful remote update.
EOF
  fi
}

append_report_warnings() {
  local warning

  [[ -s "$WARNINGS_FILE" ]] || return 0

  cat >> "$OUTPUT_FILE" << EOF

## Warnings

EOF

  while IFS= read -r warning; do
    printf -- '- %s\n' "$warning" >> "$OUTPUT_FILE"
  done < "$WARNINGS_FILE"
}

append_report_row() {
  local branch="$1"
  local type="$2"
  local base="$3"
  local status="$4"
  local staged_unstaged="$5"
  local unpushed_commits="$6"
  local ahead_behind="$7"
  local pr="$8"
  local created="$9"
  local last_commit="${10}"

  # Escape markdown-table delimiters so table column counts stay stable.
  branch="${branch//|/\\|}"
  type="${type//|/\\|}"
  base="${base//|/\\|}"
  status="${status//|/\\|}"
  staged_unstaged="${staged_unstaged//|/\\|}"
  unpushed_commits="${unpushed_commits//|/\\|}"
  ahead_behind="${ahead_behind//|/\\|}"
  pr="${pr//|/\\|}"
  created="${created//|/\\|}"
  last_commit="${last_commit//|/\\|}"

  printf '| %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |\n' \
    "$branch" "$type" "$base" "$status" "$staged_unstaged" \
    "$unpushed_commits" "$ahead_behind" "$pr" "$created" \
    "$last_commit" >> "$OUTPUT_FILE"
}

format_ratio_or_blank() {
  local left="$1"
  local right="$2"

  if [[ "$left" =~ ^[0-9]+$ && "$right" =~ ^[0-9]+$ ]]; then
    if [[ "$left" -eq 0 && "$right" -eq 0 ]]; then
      echo ""
    else
      echo "$left/$right"
    fi
  else
    echo ""
  fi
}

cleanup_old_reports() {
  local old_report
  local report_rel

  BRANCH_REPORT_DELETIONS=()
  
  # Validate that OUTPUT_FILE path is set (file is created after cleanup)
  [[ -n "$OUTPUT_FILE" ]] || return 0
  
  # Verify reports directory exists before attempting cleanup
  [[ -d "$branch_reports_dir" ]] || return 0
  
  # Remove all prior branch reports except the new one being generated
  # Delete only untracked local-only reports. Skip tracked files to avoid
  # creating unrelated working-tree deletions that can affect merge workflows.
  for old_report in "$branch_reports_dir"/branch-*.md; do
    [[ "$old_report" == "$OUTPUT_FILE" ]] && continue    # Skip current report
    [[ -e "$old_report" ]] || continue                    # Skip if already removed

    # Keep tracked files untouched (older committed artifacts).
    if git ls-files --error-unmatch "$old_report" >/dev/null 2>&1; then
      continue
    fi

    report_rel="${old_report#"${repo_root}"/}"
    if rm -f "$old_report" 2>/dev/null; then
      BRANCH_REPORT_DELETIONS+=("$report_rel")
    else
      bt_warn "Could not remove stale branch report: $report_rel"
    fi
  done
}

mark_report_read_only() {
  local report_path="$1"

  if ! chmod a-w "$report_path" 2>/dev/null; then
    bt_error_exit "$EXIT_OPERATION_FAILED" "Failed to mark report read-only: $report_path"
  fi
}

check_branch_status() {
  local branch="$1"
  local is_current="${3:-false}"
  local include_local_rows="${4:-true}"
  local include_remote_rows="${5:-true}"

  if [[ "$INVALID_ONLY" == true ]] &&
    ! branch_violates_naming_rules "$branch"; then
    return 0
  fi

  local branch_display
  local branch_status_display
  local branch_status_display_local
  local branch_status_display_remote
  local branch_report_display
  branch_display=$(branch_name_display "$branch")
  branch_status_display=$(branch_name_status_display "$branch" "$is_current")
  branch_status_display_local="$branch_status_display"
  branch_status_display_remote=$(branch_name_status_display "$branch" "false")
  branch_report_display=$(branch_name_report_display "$branch" "$is_current")
  if branch_violates_naming_rules "$branch"; then
    INVALID_BRANCHES_FOUND=$((INVALID_BRANCHES_FOUND + 1))
  fi

  # Fetch latest remote refs once so remote-derived fields are less stale.
  ensure_remote_refs_fetched

  # Gather status information — use fallback values if any step fails
  local repo_status staged_count unstaged_count auto_stash_count
  local unpushed_count pr_count branch_type
  if [[ "$is_current" == true ]]; then
    repo_status=$(check_repo_status "$branch") || repo_status="unknown"
    staged_count=$(get_staged_changes "$branch") || staged_count="N/A"
    unstaged_count=$(get_unstaged_changes "$branch") || unstaged_count="N/A"
  else
    if is_protected_branch "$branch"; then
      repo_status="read-only"
    else
      repo_status="not checked out"
    fi
    staged_count=""
    unstaged_count=""
  fi
  auto_stash_count=$(get_branch_auto_stash_count "$branch") || \
    auto_stash_count="0"
  unpushed_count=$(get_unpushed_commits "$branch") || unpushed_count="N/A"
  pr_count=$(get_pending_pr_count    "$branch") || pr_count="N/A"
  branch_type=$(get_branch_type      "$branch") || branch_type="unknown"
  local behind_count="0"
  local parent_ahead_count=""
  local parent_behind_count=""
  local parent_divergence_counts=""
  local created_date last_commit_date
  local base_reference=""
  created_date=$(get_branch_created_date "$branch" "local")
  last_commit_date=$(get_branch_last_commit_date "$branch" "local")
  base_reference=$(get_branch_base_reference "$branch")
  [[ -z "$created_date" ]] && created_date=""
  [[ -z "$last_commit_date" ]] && last_commit_date=""
  [[ "$branch_type" == "local (tracking origin)" ]] && \
    behind_count=$(get_behind_count "$branch") || behind_count="0"

    if [[ -n "$base_reference" ]]; then
      parent_divergence_counts=$(get_branch_parent_divergence_counts \
        "$branch" "$base_reference")
      if [[ "$parent_divergence_counts" =~ ^([0-9]+)[[:space:]]+([0-9]+)$ ]]; then
        parent_ahead_count="${BASH_REMATCH[1]}"
        parent_behind_count="${BASH_REMATCH[2]}"
      fi
    fi

  # Build and print compact status line(s)
  if [[ "$branch_type" == "local (tracking origin)" &&
    "$include_local_rows" == true && "$include_remote_rows" == true ]]; then
    local local_tags=("[local]")
    local remote_tags=("[remote]")
    local split_rows=false
    local local_status_sig remote_status_sig

    [[ "$is_current" == true ]] && local_tags+=("[current]")
    if [[ "$is_current" == true ]]; then
      [[ "$repo_status" == "dirty" ]] && local_tags+=("[dirty]")
      [[ "$staged_count" =~ ^[0-9]+$ && "$staged_count" -gt 0 ]] && \
        local_tags+=("[staged]")
      [[ "$unstaged_count" =~ ^[0-9]+$ && "$unstaged_count" -gt 0 ]] && \
        local_tags+=("[unstaged]")
    elif is_protected_branch "$branch"; then
      local_tags+=("[read-only]")
    fi
    [[ "$auto_stash_count" =~ ^[0-9]+$ && "$auto_stash_count" -gt 0 ]] && \
      local_tags+=("[auto-stash: $auto_stash_count]")
    [[ "$unpushed_count" =~ ^[0-9]+$ && "$unpushed_count" -gt 0 ]] && \
        local_tags+=("[ahead of remote by $unpushed_count]")
      [[ "$parent_behind_count" =~ ^[0-9]+$ && "$parent_behind_count" -gt 0 ]] && \
        local_tags+=("[behind parent by $parent_behind_count]")
      [[ "$parent_ahead_count" =~ ^[0-9]+$ && "$parent_ahead_count" -gt 0 ]] && \
        local_tags+=("[ahead of parent by $parent_ahead_count]")

    [[ "$behind_count" =~ ^[0-9]+$ && "$behind_count" -gt 0 ]] && \
      remote_tags+=("[ahead of local by $behind_count]")
      [[ "$parent_behind_count" =~ ^[0-9]+$ && "$parent_behind_count" -gt 0 ]] && \
        remote_tags+=("[behind parent by $parent_behind_count]")
      [[ "$parent_ahead_count" =~ ^[0-9]+$ && "$parent_ahead_count" -gt 0 ]] && \
        remote_tags+=("[ahead of parent by $parent_ahead_count]")
    [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && \
      remote_tags+=("[PRs: $pr_count]")

    local_status_sig="${local_tags[*]}"
    remote_status_sig="${remote_tags[*]}"
    if [[ "$local_status_sig" != "[local]" ||
      "$remote_status_sig" != "[remote]" ]]; then
      split_rows=true
    fi

    if [[ "$split_rows" == true ]]; then
      printf '%s %s\n' "$branch_status_display_local" "${local_tags[*]}"
      printf '%s %s\n' "$branch_status_display_remote" "${remote_tags[*]}"
    else
      printf '%s [local] [remote]\n' "$branch_status_display"
    fi
  elif [[ "$branch_type" == "local (tracking origin)" &&
    "$include_remote_rows" == true ]]; then
    local tags=("[remote]")
    [[ "$behind_count" =~ ^[0-9]+$ && "$behind_count" -gt 0 ]] && \
      tags+=("[ahead of local by $behind_count]")
      [[ "$parent_behind_count" =~ ^[0-9]+$ && "$parent_behind_count" -gt 0 ]] && \
        tags+=("[behind parent by $parent_behind_count]")
      [[ "$parent_ahead_count" =~ ^[0-9]+$ && "$parent_ahead_count" -gt 0 ]] && \
        tags+=("[ahead of parent by $parent_ahead_count]")
    [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && \
      tags+=("[PRs: $pr_count]")
    printf '%s %s\n' "$branch_status_display_remote" "${tags[*]}"
  else
    local tags=()
    if [[ "$include_remote_rows" == true &&
      "$include_local_rows" == false ]]; then
      tags+=("[remote]")
    elif [[ "$branch_type" == "remote" ]]; then
      tags+=("[remote]")
    else
      tags+=("[local]")
    fi
    if [[ "$include_local_rows" == true ]]; then
      [[ "$is_current" == true ]] && tags+=("[current]")
      if [[ "$is_current" == true ]]; then
        [[ "$repo_status" == "dirty" ]] && tags+=("[dirty]")
        [[ "$staged_count" =~ ^[0-9]+$ && "$staged_count" -gt 0 ]] && \
          tags+=("[staged]")
        [[ "$unstaged_count" =~ ^[0-9]+$ && "$unstaged_count" -gt 0 ]] && \
          tags+=("[unstaged]")
      elif is_protected_branch "$branch"; then
        tags+=("[read-only]")
      fi
      [[ "$auto_stash_count" =~ ^[0-9]+$ && "$auto_stash_count" -gt 0 ]] && \
        tags+=("[auto-stash: $auto_stash_count]")
    fi
    [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && \
      tags+=("[PRs: $pr_count]")
      [[ "$parent_behind_count" =~ ^[0-9]+$ && "$parent_behind_count" -gt 0 ]] && \
        tags+=("[behind parent by $parent_behind_count]")
      [[ "$parent_ahead_count" =~ ^[0-9]+$ && "$parent_ahead_count" -gt 0 ]] && \
        tags+=("[ahead of parent by $parent_ahead_count]")
    if [[ "$include_remote_rows" == true &&
      "$include_local_rows" == false ]]; then
      printf '%s %s\n' "$branch_status_display_remote" "${tags[*]}"
    else
      printf '%s %s\n' "$branch_status_display_local" "${tags[*]}"
    fi
  fi

  # Append to report
  # Append report row(s)
    local branch_local_display="$branch_report_display"
    local local_status="$repo_status"
    if [[ "$auto_stash_count" =~ ^[0-9]+$ && "$auto_stash_count" -gt 0 ]]; then
      local_status+="; auto-stash:$auto_stash_count"
    fi
    local branch_remote_display
    branch_remote_display=$(branch_name_report_display "$branch" "false")

    if [[ "$branch_type" == "local (tracking origin)" ]]; then
      local pr_count_display
      local unpushed_display
        local local_ahead_behind
        local remote_ahead_behind
        local tracking_ahead=""
        local tracking_behind=""
      pr_count_display=$(format_zero_as_blank "$pr_count")
      unpushed_display=$(format_zero_as_blank "$unpushed_count")
        if [[ "$unpushed_count" =~ ^[0-9]+$ ]]; then
          tracking_ahead="$unpushed_count"
        fi
        if [[ "$behind_count" =~ ^[0-9]+$ ]]; then
          tracking_behind="$behind_count"
        fi
        local_ahead_behind=$(format_ahead_behind_segments \
          "$tracking_ahead" "$tracking_behind" \
          "$parent_ahead_count" "$parent_behind_count")
        remote_ahead_behind=$(format_ahead_behind_segments \
          "$tracking_ahead" "$tracking_behind" \
          "$parent_ahead_count" "$parent_behind_count")
      if [[ "$include_local_rows" == true ]]; then
        local staged_unstaged_display
        staged_unstaged_display=$(format_ratio_or_blank \
          "$staged_count" "$unstaged_count")
        append_report_row \
          "$branch_local_display" "local" "$base_reference" \
          "$local_status" "$staged_unstaged_display" \
          "$unpushed_display" "$local_ahead_behind" \
          "$pr_count_display" "$created_date" "$last_commit_date"
      fi

      local remote_status="synced"
      if [[ "$behind_count" =~ ^[0-9]+$ && "$behind_count" -gt 0 ]] ||
        [[ "$unpushed_count" =~ ^[0-9]+$ && "$unpushed_count" -gt 0 ]]; then
        remote_status="diverged"
      fi
      if [[ "$include_remote_rows" == true ]]; then
        append_report_row \
          "$branch_remote_display" "remote" "$base_reference" \
          "$remote_status" "" "" "$remote_ahead_behind" \
          "$pr_count_display" "$created_date" "$last_commit_date"
      fi
    elif [[ "$branch_type" == "local" ]]; then
      local pr_count_display
      local staged_unstaged_display
      local unpushed_display
        local local_ahead_behind
      pr_count_display=$(format_zero_as_blank "$pr_count")
      staged_unstaged_display=$(format_ratio_or_blank \
        "$staged_count" "$unstaged_count")
      unpushed_display=$(format_zero_as_blank "$unpushed_count")
        local_ahead_behind=$(format_ahead_behind_segments \
          "" "" "$parent_ahead_count" "$parent_behind_count")
      if [[ "$include_local_rows" == true ]]; then
        append_report_row \
          "$branch_local_display" "local" "" "$local_status" \
            "$staged_unstaged_display" "$unpushed_display" "$local_ahead_behind" \
          "$pr_count_display" "$created_date" "$last_commit_date"
      elif [[ "$include_remote_rows" == true ]]; then
        append_report_row \
          "$branch_remote_display" "remote" "" "not tracking origin" \
            "" "" "$local_ahead_behind" "$pr_count_display" "$created_date" \
          "$last_commit_date"
      fi
    else
      local pr_count_display
      pr_count_display=$(format_zero_as_blank "$pr_count")
      if [[ "$include_remote_rows" == true ]]; then
        append_report_row \
          "$branch_display" "remote" "" "$repo_status" "" "" "" \
          "$pr_count_display" "$created_date" "$last_commit_date"
      fi
    fi

  if [[ "$VERBOSE" == true ]]; then
    echo "  Status: $repo_status"
    echo "  Auto-stash: $auto_stash_count"
    echo "  Staged: $staged_count"
    echo "  Unstaged: $unstaged_count"
    echo "  Unpushed: $unpushed_count"
    echo "  Pending PRs: $pr_count"
  fi

}

check_remote_branch_status() {
  local branch="$1"

  if [[ "$INVALID_ONLY" == true ]] &&
    ! branch_violates_naming_rules "$branch"; then
    return 0
  fi

  local branch_display
  local branch_status_display
  local branch_report_display
  branch_display=$(branch_name_display "$branch")
  branch_status_display=$(branch_name_status_display "$branch" "false")
  branch_report_display=$(branch_name_report_display "$branch" "false")
  if branch_violates_naming_rules "$branch"; then
    INVALID_BRANCHES_FOUND=$((INVALID_BRANCHES_FOUND + 1))
  fi

  ensure_remote_refs_fetched

  # Get PR status and last commit
  local pr_count created_date last_commit_date base_reference
  local divergence_counts remote_status remote_ahead remote_behind
  local remote_ahead_behind
  pr_count=$(get_pending_pr_count "$branch") || pr_count="N/A"
  created_date=$(get_branch_created_date "$branch" "remote")
  last_commit_date=$(get_branch_last_commit_date "$branch" "remote")
  base_reference=$(get_remote_comparison_target "$branch")
  [[ -z "$created_date" ]] && created_date=""
  [[ -z "$last_commit_date" ]] && last_commit_date=""

  divergence_counts=$(get_remote_divergence_counts "$branch" "$base_reference")
  remote_ahead=""
  remote_behind=""
  remote_status="unknown"
  if [[ "$divergence_counts" =~ ^[[:space:]]*([0-9]+)[[:space:]]+([0-9]+)[[:space:]]*$ ]]; then
    remote_ahead="${BASH_REMATCH[1]}"
    remote_behind="${BASH_REMATCH[2]}"
    if [[ "$remote_ahead" -eq 0 && "$remote_behind" -eq 0 ]]; then
      remote_status="synced"
    else
      remote_status="diverged"
    fi
  elif [[ -z "$base_reference" ]]; then
    remote_status="synced"
  fi

  # Build and print compact status line
  local tags=("[remote]")
  if [[ "$remote_ahead" =~ ^[0-9]+$ && "$remote_behind" =~ ^[0-9]+$ ]]; then
    if [[ "$remote_ahead" -gt 0 && "$remote_behind" -gt 0 ]]; then
      tags+=("[diverged ${remote_ahead}/${remote_behind} vs ${base_reference}]")
    elif [[ "$remote_behind" -gt 0 ]]; then
      tags+=("[behind ${remote_behind} of ${base_reference}]")
    elif [[ "$remote_ahead" -gt 0 ]]; then
      tags+=("[ahead ${remote_ahead} of ${base_reference}]")
    fi
  fi
  [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && \
    tags+=("[PRs: $pr_count]")
  printf '%s %s\n' "$branch_status_display" "${tags[*]}"

  local pr_count_display
  pr_count_display=$(format_zero_as_blank "$pr_count")
  remote_ahead_behind=$(format_ratio_or_blank "$remote_ahead" "$remote_behind")
  append_report_row \
    "$branch_report_display" "remote" "$base_reference" "$remote_status" "" \
    "" "$remote_ahead_behind" "$pr_count_display" "$created_date" "$last_commit_date"

  if [[ "$VERBOSE" == true ]]; then
    if [[ -n "$base_reference" ]]; then
      echo "  Parent: $base_reference"
    fi
    if [[ -n "$remote_ahead_behind" ]]; then
      echo "  Ahead/Behind: $remote_ahead_behind"
    fi
    echo "  Last Commit: $last_commit_date"
    echo "  Pending PRs: $pr_count"
  fi
}


# Check for help first — if specified, ignore all other arguments
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    usage
    exit 0
  fi
done

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -a)
      ALL_BRANCHES=true
      shift
      ;;
    -b)
      COLOR_OUTPUT=false
      shift
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    -i)
      INVALID_ONLY=true
      shift
      ;;
    -l)
      INCLUDE_LOCAL_FLAG=true
      shift
      ;;
    -r)
      INCLUDE_REMOTE_FLAG=true
      shift
      ;;
    -x)
      shift
      if [[ $# -eq 0 ]]; then
        usage_error "Missing PATTERN for -x"
      fi
      EXCLUDE_PATTERN="$1"
      shift
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      if [[ -n "$TARGET_BRANCH" || -n "$BRANCH_PATTERN" ]]; then
        printf 'Error: Unexpected argument: %q\n' "$1" >&2
        printf 'Multiple positional arguments received — pattern '
        printf 'was likely expanded by the shell.\n' >&2
        printf 'Quote the pattern to prevent expansion, '
        printf 'e.g.: lsbranch "*"\n' >&2
        exit "$EXIT_INVALID_ARGUMENT"
      fi
      if [[ "$1" =~ [\*\?\[] ]]; then
        BRANCH_PATTERN="$1"
      else
        TARGET_BRANCH="$1"
      fi
      shift
      ;;
  esac
done

# If -a specified, set pattern to match all branches
if $ALL_BRANCHES; then
  if [[ -n "$TARGET_BRANCH" ]]; then
    usage_error "Cannot combine BRANCH with -a"
  fi
  BRANCH_PATTERN="*"
fi

if [[ -n "$TARGET_BRANCH" &&
  ( "$INVALID_ONLY" == true || -n "$EXCLUDE_PATTERN" ||
    "$INCLUDE_LOCAL_FLAG" == true || "$INCLUDE_REMOTE_FLAG" == true ) ]]; then
  usage_error "When BRANCH is specified, only -v and -b are allowed"
fi

if [[ -n "$EXCLUDE_PATTERN" && -z "$BRANCH_PATTERN" ]]; then
  usage_error "Option -x requires -a or PATTERN"
fi

if [[ "$INVALID_ONLY" == true && -z "$BRANCH_PATTERN" ]]; then
  usage_error "Option -i requires -a or PATTERN"
fi

# Determine what to include based on flags
# If neither flag specified, default to both; if at least one flag
# specified, use the flags
if ! $INCLUDE_LOCAL_FLAG && ! $INCLUDE_REMOTE_FLAG; then
  # Default: include both
  INCLUDE_LOCAL=true
  INCLUDE_REMOTE=true
else
  # At least one flag specified: use exactly what was specified
  INCLUDE_LOCAL=$INCLUDE_LOCAL_FLAG
  INCLUDE_REMOTE=$INCLUDE_REMOTE_FLAG
fi

# No-argument invocation should show the current branch and its parent branch.
if [[ -z "$TARGET_BRANCH" && -z "$BRANCH_PATTERN" &&
    "$INCLUDE_LOCAL_FLAG" == false && "$INCLUDE_REMOTE_FLAG" == false ]]; then
  NO_ARG_MODE=true
fi

# Build the exact command string used to generate this report.
build_report_command

# Snapshot status before this run mutates report files so stdout/report status
# reflects repository state at invocation time.
capture_initial_worktree_status

# Validate reports directory exists (should be part of repository structure)
if [[ ! -d "$branch_reports_dir" ]]; then
  bt_error_exit "$EXIT_OPERATION_FAILED" "$branch_reports_dir directory not found. Repository may be corrupted; run 'fixlocal' to verify."
fi

enable_branch_reports_write_access

OUTPUT_FILE="$branch_reports_dir/branch-${RUN_TS_FILE}.md"

# Get current branch to restore later
ORIGINAL_BRANCH=$(bt_get_current_branch ||
  bt_error_exit "$EXIT_NOT_FOUND" "Failed to determine current branch.")

# Determine branches to check
if [[ -n "$TARGET_BRANCH" ]]; then
  if ! has_local_branch "$TARGET_BRANCH" &&
    ! has_remote_branch "$TARGET_BRANCH"; then
    bt_error_exit "$EXIT_NOT_FOUND" "$TARGET_BRANCH branch does not exist."
  fi

  TARGET_PARENT_BRANCH="$(bt_resolve_parent_branch "$TARGET_BRANCH" "main" 2>/dev/null || true)"

  BRANCHES_TO_CHECK=""
  REMOTE_BRANCHES_TO_CHECK=""
  REMOTE_ONLY=""

  for candidate_branch in "$TARGET_BRANCH" "$TARGET_PARENT_BRANCH"; do
    [[ -n "$candidate_branch" ]] || continue

    if has_local_branch "$candidate_branch"; then
      BRANCHES_TO_CHECK="$(append_unique_branch_line "$BRANCHES_TO_CHECK" "$candidate_branch")"
    fi

    if has_remote_branch "$candidate_branch"; then
      REMOTE_BRANCHES_TO_CHECK="$(append_unique_branch_line "$REMOTE_BRANCHES_TO_CHECK" "$candidate_branch")"
      if ! has_local_branch "$candidate_branch"; then
        REMOTE_ONLY="$(append_unique_branch_line "$REMOTE_ONLY" "$candidate_branch")"
      fi
    fi
  done
elif [[ -z "$BRANCH_PATTERN" ]]; then
  # Default scope is current branch and its parent branch.
  if ! has_local_branch "$ORIGINAL_BRANCH"; then
    bt_error_exit "$EXIT_NOT_FOUND" "Current branch $ORIGINAL_BRANCH not found locally."
  fi

  CURRENT_PARENT_BRANCH="$(bt_resolve_parent_branch "$ORIGINAL_BRANCH" "main" 2>/dev/null || true)"

  BRANCHES_TO_CHECK=""
  REMOTE_BRANCHES_TO_CHECK=""
  REMOTE_ONLY=""

  for candidate_branch in "$ORIGINAL_BRANCH" "$CURRENT_PARENT_BRANCH"; do
    [[ -n "$candidate_branch" ]] || continue

    if has_local_branch "$candidate_branch"; then
      BRANCHES_TO_CHECK="$(append_unique_branch_line "$BRANCHES_TO_CHECK" "$candidate_branch")"
    fi

    if has_remote_branch "$candidate_branch"; then
      REMOTE_BRANCHES_TO_CHECK="$(append_unique_branch_line "$REMOTE_BRANCHES_TO_CHECK" "$candidate_branch")"
      if ! has_local_branch "$candidate_branch"; then
        REMOTE_ONLY="$(append_unique_branch_line "$REMOTE_ONLY" "$candidate_branch")"
      fi
    fi
  done
else
  # Check branches matching pattern
  local_branches=$(get_local_branches "$BRANCH_PATTERN")
  remote_branches=$(get_remote_branches "$BRANCH_PATTERN")
  remote_only_branches=$(get_remote_only_branches "$BRANCH_PATTERN")

  local_branches=$(apply_exclude_filter "$local_branches" "$EXCLUDE_PATTERN")
  remote_branches=$(apply_exclude_filter "$remote_branches" "$EXCLUDE_PATTERN")
  remote_only_branches=$(apply_exclude_filter \
    "$remote_only_branches" "$EXCLUDE_PATTERN")

  BRANCHES_TO_CHECK="$local_branches"
  REMOTE_BRANCHES_TO_CHECK="$remote_branches"
  REMOTE_ONLY="$remote_only_branches"

  if [[ "$INCLUDE_LOCAL" == true && "$INCLUDE_REMOTE" == false &&
    -z "$BRANCHES_TO_CHECK" ]]; then
    bt_warn "No branches found matching pattern: $BRANCH_PATTERN"
  elif [[ "$INCLUDE_REMOTE" == true && "$INCLUDE_LOCAL" == false &&
    -z "$REMOTE_BRANCHES_TO_CHECK" ]]; then
    bt_warn "No branches found matching pattern: $BRANCH_PATTERN"
  elif [[ "$INCLUDE_REMOTE" == true && "$INCLUDE_LOCAL" == true &&
    -z "$BRANCHES_TO_CHECK" && -z "$REMOTE_BRANCHES_TO_CHECK" ]]; then
    bt_warn "No branches found matching pattern: $BRANCH_PATTERN"
  fi
fi

# Remove stale branch reports before generating the new one so old report
# files are not counted as untracked during the status check below.
cleanup_old_reports

# Generate report header
generate_report_header

# Warn if remote status is stale (fetch failed/timed out)
if [[ "$FETCH_FAILED" == true ]] && 
   [[ "$INCLUDE_REMOTE_FLAG" == true || 
      ("$INCLUDE_LOCAL_FLAG" == false && "$INCLUDE_REMOTE_FLAG" == false) ]]; then
    bt_warn "Cannot connect to remote repository. Branch status uses cached refs from your last successful remote update."
fi

# No-argument invocation shows rows for the current branch and its parent.
if [[ "$NO_ARG_MODE" == true ]]; then
  if [[ -n "$BRANCHES_TO_CHECK" ]]; then
    while IFS= read -r branch; do
      [[ -n "$branch" ]] || continue
      _is_current=false
      [[ "$branch" == "$ORIGINAL_BRANCH" ]] && _is_current=true
      check_branch_status "$branch" "$OUTPUT_FILE" "$_is_current" true true || true
    done <<< "$BRANCHES_TO_CHECK"
  fi

  if [[ -n "$REMOTE_ONLY" ]]; then
    while IFS= read -r branch; do
      [[ -n "$branch" ]] || continue
      check_remote_branch_status "$branch" "$OUTPUT_FILE" || true
    done <<< "$REMOTE_ONLY"
  fi
else
  # Check local branches only when local inclusion is enabled.
  if [[ "$INCLUDE_LOCAL" == true ]]; then
    local_to_check=""
    if [[ -z "$BRANCH_PATTERN" ]]; then
      local_to_check="$BRANCHES_TO_CHECK"
    else
      local_to_check="$BRANCHES_TO_CHECK"
    fi
    
    if [[ -n "$local_to_check" ]]; then
      while IFS= read -r branch; do
        if [[ -n "$branch" ]]; then
          _is_current=false
          [[ "$branch" == "$ORIGINAL_BRANCH" ]] && _is_current=true
          check_branch_status \
            "$branch" "$OUTPUT_FILE" "$_is_current" \
            "$INCLUDE_LOCAL" "$INCLUDE_REMOTE" || true
        fi
      done <<< "$local_to_check"
    fi
  fi

  # Check remote-only branches if enabled
  if [[ "$INCLUDE_REMOTE" == true ]]; then
    remote_to_check=""
    if [[ "$INCLUDE_LOCAL" == true ]]; then
      remote_to_check="$REMOTE_ONLY"
    else
      remote_to_check="$REMOTE_BRANCHES_TO_CHECK"
    fi

    if [[ -n "$remote_to_check" ]]; then
      while IFS= read -r branch; do
        if [[ -n "$branch" ]]; then
          check_remote_branch_status "$branch" "$OUTPUT_FILE" || true
        fi
      done <<< "$remote_to_check"
    fi
  fi
fi

if supports_report_color_output; then
  FOOTER_BRANCH_LINE='**Branch**: Indicates the branch name. '
  FOOTER_BRANCH_LINE+='<span style="color:#66bb6a;font-weight:700">*</span> '
  FOOTER_BRANCH_LINE+='indicates this is the current branch.'
  FOOTER_INVALID_LINE='<span style="color:#c62828;font-weight:700">!</span> '
  FOOTER_INVALID_LINE+='after branch name indicates the name violates naming '
  FOOTER_INVALID_LINE+='rules.'
else
  FOOTER_BRANCH_LINE='**Branch**: Indicates the branch name. '
  FOOTER_BRANCH_LINE+='* indicates this is the current branch.'
  FOOTER_INVALID_LINE='! after branch name indicates the name '
  FOOTER_INVALID_LINE+='violates naming rules.'
fi

cat >> "$OUTPUT_FILE" << EOF

$FOOTER_BRANCH_LINE

$FOOTER_INVALID_LINE

**Type**: Indicates branch is \`local\` or \`remote\`.

**Parent**: Parent branch reference for the row when applicable (for example,
\`main\` or \`v1.0.0\`).

**Status**: \`clean\`, \`dirty\`, or \`not checked out\` for local worktree
state, \`synced\` or \`diverged\` for tracked-branch state, or \`unknown\`.
For local branches, \`dirty\` reflects any working tree change including
untracked files. Status includes \`; auto-stash:N\` when branch-matching
legacy auto-stashes exist (label:
\`chcurrent-auto:BRANCH:TIMESTAMP\`).

**Staged/Unstaged**: Count of staged files and count of unstaged files.
Unstaged includes tracked modifications and untracked files (anything
requiring \`git add\` before a commit).

**Unpushed Commits**: Count of local commits pending sync for this branch.

**Ahead/Behind**: Commit divergence segments for the branch. Uses
\`remote A/B\` for ahead/behind versus tracked remote and \`parent C/D\`
for ahead/behind versus parent branch when available.

**PR**: Count of pending (not closed) pull requests.

**First Commit**: Approximate branch creation date, derived from the
first commit on the branch.

**Last Commit**: Date of the last commit on the branch.
EOF

append_report_note_about_stale_remote

append_report_warnings

mark_report_read_only "$OUTPUT_FILE"

persist_report_changes
disable_branch_reports_write_access

if [[ "$VERBOSE" == true ]]; then
  echo ""
  bt_info "Report contents:"
  sed 's/^/  /' "$OUTPUT_FILE"
fi

if [[ "$INVALID_ONLY" == true && "$INVALID_BRANCHES_FOUND" -gt 0 ]]; then
  exit "$EXIT_CONFIG_ERROR"
fi
exit 0
