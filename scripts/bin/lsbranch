#!/usr/bin/env bash

# lsbranch - list branches and their status.
#
# See usage below for details, or run: lsbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  lsbranch [-b] [-n] [-v]
  lsbranch BRANCH [-b] [-n] [-v]
  lsbranch {-a | PATTERN} [-b] [-n] [-i] [-l] [-r] [-v] [-x "PATTERN"]
  lsbranch {-h | --help}

For first usage, list status of the current branch.

Use BRANCH to list status of the branch with the name BRANCH.

Use -a or PATTERN to list the status of branches matching "*"
or PATTERN, respectively.

Report includes:
  Branch:  Indicates the branch name. `*` indicates this is
           the current branch. '!' indicates the branch name
           violates naming rules.
  Type:    Indicates branch is `local` or `remote`.
  Parent:  Parent branch reference for the row when applicable.
           For example, 'main' or 'v1.0.0'.
  Status:  'clean', 'dirty', 'read-only', or 'not checked out' for local
           worktree state. For local branches, 'clean'/'dirty' reflect the
           current checkout's shared working tree.
           If branch-matching chcurrent auto-stashes exist,
           status includes '; auto-stash:N' in reports and
           '[auto-stash: N]' in stdout rows.
           'synced' or 'diverged' for tracked-branch state,
           or 'unknown'.
  Staged/Unstaged: Counts of staged and unstaged files.
  Unpushed Commits: Count of local commits pending sync
           for this branch.
  Ahead/Behind: Counts of commits this branch is
           ahead of / behind its tracked branch.
  PR:      Count of pending (not closed) pull requests.
  First Commit: Approximate date of the branch's first commit.
  Last Commit: Date of the last commit on the branch.

Arguments:
  BRANCH      Check branch with name BRANCH.
  PATTERN     Filter branches by quoted (") glob pattern on
              branch name. Supports *, ?, [abc], etc.
              Examples: "*bug*", "fix*",  "*issue*".

Options (see above for the options allowed for each form of usage):
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored). Help is output also
              if invalid arguments or options are provided.
  -a          Same as specifying "*" as PATTERN.
  -b          Black text (disable color) in stdout and report output.
  -n          Do not run git fetch. Use existing local refs only.
  -i          List branches that violate naming rules (see
              Contributor Guide for rules).
  -l          List local branches.
  -r          List remote branches.
  -v          Verbose output to stdout for debugging.
  -x PATTERN  Exclude branches matching the given quoted (") glob
              pattern.

  If neither -l nor -r is specified, same as specifying
  both -l and -r (i.e., both local and remote branches are listed).

Examples:
  # Check current branch
  lsbranch

  # Check all branches (local and remote)
  lsbranch -a
  lsbranch -a -l -r
  lsbranch "*"
  lsbranch "*" -l -r

  # Check local branches
  lsbranch -a -l
  lsbranch "*" -l

  # Check remote branches
  lsbranch -a -r
  lsbranch "*" -r

  # Check feature branches (both local and remote)
  lsbranch "feature/*"

  # Check branches matching pattern (both local and remote)
  lsbranch "*auth*"

  # Verbose output for current branch
  lsbranch -v

  # Offline/no-network mode
  lsbranch -a -r -n

Outputs:
  - Writes help (usage) text or status messages for the
    selected branches to stdout.
  - Writes errors and diagnostics to stderr.
  - Writes a report to <repo>/reports/branch/branch-<datetime>.md
    (a GitHub untracked file).
  - Removes previous reports when a new one is successfully
    written.

Exit codes:
  0   Success.
  1   Argument or validation error.
  2   Git operation failed.
  3   Reports directory does not exist.
  4   Branches found that violate naming rules if option -i
      specified.
  5   Branch does not exist when BRANCH is specified or
      when request is for current branch.
EOF
}

usage_error() {
  local message="$1"
  echo "Error: $message" >&2
  echo >&2
  usage >&2
  exit 1
}

# High-Level Flow:
# - Parses query scope (current branch, exact branch, or glob pattern) and
#   resolves local/remote branch candidates.
# - Collects branch status, sync deltas, parent inference, and optional PR
#   metadata with per-field fallbacks so report generation continues on
#   errors.
# - Writes a markdown branch report, including diagnostics warnings when
#   metadata collection degrades.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${SCRIPT_DIR}/../.." && pwd)"
branch_reports_dir="$repo_root/reports/branch"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/github_helpers.sh
source "$SCRIPT_DIR/../helpers/github_helpers.sh"

RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
ORIGINAL_ARGS=("$@")
REPORT_COMMAND=""

# Default options
OUTPUT_FILE=""
BRANCH_PATTERN=""
EXCLUDE_PATTERN=""
TARGET_BRANCH=""
VERBOSE=false
BRANCH_ERRORS=0
INVALID_BRANCHES_FOUND=0
ALL_BRANCHES=false
INCLUDE_LOCAL_FLAG=false
INCLUDE_REMOTE_FLAG=false
INVALID_ONLY=false
COLOR_OUTPUT=true
NO_ARG_MODE=false
FETCH_ATTEMPTED=false
REMOTE_FETCH_ENABLED=true
WARNINGS_FILE="$(mktemp)"
AUTO_STASH_INDEX_READY=false
declare -A AUTO_STASH_COUNTS=()

COLOR_RESET=$'\033[0m'
COLOR_BOLD_GREEN=$'\033[1;92m'
COLOR_BOLD_RED=$'\033[1;31m'

cleanup_runtime_files() {
  rm -f "$WARNINGS_FILE"
}

trap cleanup_runtime_files EXIT

matches_glob() {
  local text="$1"
  local pattern="$2"
  [[ "$text" == $pattern ]]
}

has_local_branch() {
  local branch="$1"
  git show-ref --verify --quiet "refs/heads/$branch"
}

has_remote_branch() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

is_version_branch() {
  local branch="$1"
  [[ "$branch" =~ ^v([1-9][0-9]?)\.([0-9]|[1-9][0-9]?)\.([0-9]|[1-9][0-9]?)$ ]]
}

is_main_branch() {
  local branch="$1"
  [[ "$branch" == "main" ]]
}

is_targeted_branch() {
  local branch="$1"
  local desc='[a-z0-9]+(-[a-z0-9]+)*'

  [[ "$branch" =~ ^(dev|fix)/${desc}-v([1-9][0-9]?)\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$ ]]
}

is_contributor_branch() {
  local branch="$1"
  local desc='[a-z0-9]+(-[a-z0-9]+)*'
  local type='[a-z][a-z]{0,29}'

  [[ "$branch" =~ ^((${type}/)?${desc})$ && "$branch" != "main" ]]
}

is_protected_branch() {
  local branch="$1"

  if is_main_branch "$branch" || is_version_branch "$branch"; then
    return 0
  fi
  return 1
}

branch_violates_naming_rules() {
  local branch="$1"

  if is_main_branch "$branch" || is_version_branch "$branch" ||
    is_targeted_branch "$branch" || is_contributor_branch "$branch"; then
    return 1
  fi
  return 0
}

branch_name_display() {
  local branch="$1"
  local suffix=""

  if branch_violates_naming_rules "$branch"; then
    suffix="!"
  fi

  printf '%s%s\n' "$branch" "$suffix"
}

supports_color_output() {
  [[ "$COLOR_OUTPUT" == true && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]
}

supports_report_color_output() {
  [[ "$COLOR_OUTPUT" == true && -z "${NO_COLOR:-}" ]]
}

add_report_warning() {
  local message="$1"

  if grep -Fqx "$message" "$WARNINGS_FILE" 2>/dev/null; then
    return 0
  fi

  printf '%s\n' "$message" >> "$WARNINGS_FILE"
}

record_diagnostic() {
  local message="$1"
  local detail="${2:-}"

  add_report_warning "$message"

  if [[ "$VERBOSE" == true ]]; then
    if [[ -n "$detail" ]]; then
      printf '  Warning: %s (%s)\n' "$message" "$detail" >&2
    else
      printf '  Warning: %s\n' "$message" >&2
    fi
  fi
}

capture_command_output() {
  local stdout_var="$1"
  local stderr_var="$2"
  shift 2

  local stdout_file
  local stderr_file
  local rc
  stdout_file=$(mktemp)
  stderr_file=$(mktemp)

  set +e
  "$@" >"$stdout_file" 2>"$stderr_file"
  rc=$?
  set -e

  printf -v "$stdout_var" '%s' "$(<"$stdout_file")"
  printf -v "$stderr_var" '%s' "$(<"$stderr_file")"

  rm -f "$stdout_file" "$stderr_file"
  return "$rc"
}

branch_name_status_display() {
  local branch="$1"
  local is_current="${2:-false}"
  local display="$branch"

  if supports_color_output; then
    if branch_violates_naming_rules "$branch"; then
      display+="${COLOR_BOLD_RED}!${COLOR_RESET}"
    fi
    if [[ "$is_current" == true ]]; then
      display+="${COLOR_BOLD_GREEN}*${COLOR_RESET}"
    fi
  else
    if branch_violates_naming_rules "$branch"; then
      display+="!"
    fi
    if [[ "$is_current" == true ]]; then
      display+="*"
    fi
  fi

  printf '%s\n' "$display"
}

branch_name_report_display() {
  local branch="$1"
  local is_current="${2:-false}"
  local display="$branch"

  if supports_report_color_output; then
    if branch_violates_naming_rules "$branch"; then
      display+="<span style=\"color:#c62828;font-weight:700\">!</span>"
    fi
    if [[ "$is_current" == true ]]; then
      display+="<span style=\"color:#66bb6a;font-weight:700\">*</span>"
    fi
  else
    if branch_violates_naming_rules "$branch"; then
      display+="!"
    fi
    if [[ "$is_current" == true ]]; then
      display+="*"
    fi
  fi

  printf '%s\n' "$display"
}

apply_exclude_filter() {
  local branches="$1"
  local exclude_pattern="$2"

  if [[ -z "$exclude_pattern" ]]; then
    printf '%s\n' "$branches"
    return 0
  fi

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    if ! matches_glob "$branch" "$exclude_pattern"; then
      echo "$branch"
    fi
  done <<< "$branches"
}

get_branch_created_date() {
  local branch="$1"
  local ref_type="${2:-local}"
  local ref="$branch"
  local log_output=""
  local log_error=""

  if [[ "$ref_type" == "remote" ]]; then
    ref="origin/$branch"
  fi

  if ! capture_command_output \
    log_output log_error \
    git log "$ref" --reverse --date=short --format='%ad'; then
    record_diagnostic \
      "Failed to read first commit date for '$ref';" \
      "First Commit column left blank." \
      "$log_error"
    echo ""
    return 0
  fi

  printf '%s\n' "$log_output" | head -n 1
}

get_branch_last_commit_date() {
  local branch="$1"
  local ref_type="${2:-local}"
  local ref="$branch"
  local log_output=""
  local log_error=""

  if [[ "$ref_type" == "remote" ]]; then
    ref="origin/$branch"
  fi

  if ! capture_command_output \
    log_output log_error \
    git log -1 --date=short --format='%ad' "$ref"; then
    record_diagnostic \
      "Failed to read last commit date for '$ref';" \
      "Last Commit column left blank." \
      "$log_error"
    echo ""
    return 0
  fi

  printf '%s\n' "$log_output"
}

get_remote_branches() {
  local pattern="$1"
  local refs_output=""
  local refs_error=""

  if ! capture_command_output \
    refs_output refs_error \
    git for-each-ref --format='%(refname:short)' refs/remotes/origin; then
    record_diagnostic \
      "Failed to enumerate remote branches; remote rows may be incomplete." \
      "$refs_error"
    echo ""
    return 0
  fi

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    [[ "$branch" == "origin" ]] && continue
    [[ "$branch" == "origin/HEAD" ]] && continue
    branch="${branch#origin/}"
    [[ -z "$branch" ]] && continue
    if matches_glob "$branch" "$pattern"; then
      echo "$branch"
    fi
  done <<< "$refs_output" | sort
}

get_local_branches() {
  local pattern="$1"
  local refs_output=""
  local refs_error=""

  if ! capture_command_output \
    refs_output refs_error \
    git for-each-ref --format='%(refname:short)' refs/heads; then
    record_diagnostic \
      "Failed to enumerate local branches; local rows may be incomplete." \
      "$refs_error"
    echo ""
    return 0
  fi

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    if matches_glob "$branch" "$pattern"; then
      echo "$branch"
    fi
  done <<< "$refs_output" | sort
}

get_remote_only_branches() {
  local pattern="$1"
  get_remote_branches "$pattern" | while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    # Only include if not local
    if ! has_local_branch "$branch"; then
      echo "$branch"
    fi
  done | sort || echo ""
}

check_repo_status() {
  local branch="$1"
  local tracked_changes

  tracked_changes=$(git status --porcelain --untracked-files=no \
    2>/dev/null || true)
  if [[ -z "$tracked_changes" ]]; then
    echo "clean"
  else
    echo "dirty"
  fi
}

get_staged_changes() {
  local branch="$1"

  git status --porcelain --untracked-files=no 2>/dev/null | awk '
    substr($0,1,1) != " " { c++ }
    END { print c + 0 }
  '
}

get_unstaged_changes() {
  local branch="$1"

  git status --porcelain --untracked-files=no 2>/dev/null | awk '
    substr($0,2,1) != " " { c++ }
    END { print c + 0 }
  '
}

build_auto_stash_index() {
  local stash_output=""
  local stash_error=""
  local subject=""
  local stash_branch=""

  if [[ "$AUTO_STASH_INDEX_READY" == true ]]; then
    return 0
  fi

  AUTO_STASH_INDEX_READY=true

  if ! capture_command_output \
    stash_output stash_error \
    git stash list --format='%gs'; then
    record_diagnostic \
      "Failed to read stash list; auto-stash indicators unavailable." \
      "$stash_error"
    return 0
  fi

  while IFS= read -r subject; do
    [[ -n "$subject" ]] || continue
    if [[ "$subject" =~ chcurrent-auto:([^:]+): ]]; then
      stash_branch="${BASH_REMATCH[1]}"
      AUTO_STASH_COUNTS["$stash_branch"]=$((
        ${AUTO_STASH_COUNTS["$stash_branch"]:-0} + 1
      ))
    fi
  done <<< "$stash_output"
}

get_branch_auto_stash_count() {
  local branch="$1"

  build_auto_stash_index
  echo "${AUTO_STASH_COUNTS["$branch"]:-0}"
}

get_unpushed_commits() {
  local branch="$1"
  local rev_list_output=""
  local rev_list_error=""

  if ! has_remote_branch "$branch"; then
    echo ""
    return 0
  fi

  if ! capture_command_output \
    rev_list_output rev_list_error \
    git rev-list --count "origin/$branch..$branch"; then
    record_diagnostic \
      "Failed to compare '$branch' against 'origin/$branch';" \
      "Unpushed Commits may be blank." \
      "$rev_list_error"
    echo ""
    return 0
  fi

  printf '%s\n' "$rev_list_output"
}

get_behind_count() {
  local branch="$1"
  local rev_list_output=""
  local rev_list_error=""

  if ! has_remote_branch "$branch"; then
    echo ""
    return 0
  fi

  if ! capture_command_output \
    rev_list_output rev_list_error \
    git rev-list --count "$branch..origin/$branch"; then
    record_diagnostic \
      "Failed to compare 'origin/$branch' against '$branch';" \
      "Ahead/Behind may be blank." \
      "$rev_list_error"
    echo ""
    return 0
  fi

  printf '%s\n' "$rev_list_output"
}

get_pending_pr_count() {
  local branch="$1"
  local pr_output=""
  local pr_error=""
  local pr_count

  if ! command -v gh >/dev/null 2>&1; then
    record_diagnostic \
      "PR lookup unavailable for '$branch'; PR column shown as N/A." \
      "gh CLI not found"
    echo "N/A"
    return 0
  fi

  if ! capture_command_output \
    pr_output pr_error \
    gh pr list --head "$branch" --state open --json number --jq 'length'; then
    record_diagnostic \
      "Failed to query pull requests for '$branch'; PR column shown as N/A." \
      "$pr_error"
    echo "N/A"
    return 0
  fi

  pr_count="$pr_output"

  if [[ "$pr_count" =~ ^[0-9]+$ ]]; then
    echo "$pr_count"
  else
    record_diagnostic \
      "Unexpected PR lookup output for '$branch'; PR column shown as N/A." \
      "$pr_count"
    echo "N/A"
  fi
}

ensure_remote_refs_fetched() {
  local fetch_output=""
  local fetch_error=""

  if [[ "$REMOTE_FETCH_ENABLED" == false ]]; then
    FETCH_ATTEMPTED=true
    return 0
  fi

  if [[ "$FETCH_ATTEMPTED" == true ]]; then
    return 0
  fi

  FETCH_ATTEMPTED=true
  if ! capture_command_output fetch_output fetch_error git fetch origin; then
    record_diagnostic \
      "Failed to fetch 'origin'; remote status may be stale in this report." \
      "$fetch_error"
  fi
}

format_zero_as_dash() {
  local value="$1"

  if [[ "$value" =~ ^[0-9]+$ && "$value" -eq 0 ]]; then
    echo "-"
  else
    echo "$value"
  fi
}

format_zero_as_blank() {
  local value="$1"

  if [[ "$value" =~ ^[0-9]+$ && "$value" -eq 0 ]]; then
    echo ""
  else
    echo "$value"
  fi
}

get_branch_type() {
  local branch="$1"
  
  local is_local=false
  local is_remote=false
  
  # Check if branch exists locally
  has_local_branch "$branch" && is_local=true
  
  # Check if branch exists on remote
  has_remote_branch "$branch" && is_remote=true
  
  if [[ "$is_local" == true && "$is_remote" == true ]]; then
    echo "local (tracking origin)"
  elif [[ "$is_local" == true ]]; then
    echo "local"
  elif [[ "$is_remote" == true ]]; then
    echo "remote"
  else
    echo "unknown"
  fi
}

build_report_command() {
  local args_rendered=""
  local arg rendered

  for arg in "${ORIGINAL_ARGS[@]}"; do
    printf -v rendered '%q' "$arg"
    if [[ -z "$args_rendered" ]]; then
      args_rendered="$rendered"
    else
      args_rendered+=" $rendered"
    fi
  done

  if [[ -n "$args_rendered" ]]; then
    REPORT_COMMAND="lsbranch $args_rendered"
  else
    REPORT_COMMAND="lsbranch"
  fi
}

get_branch_base_reference() {
  local branch="$1"
  local branch_ref="$branch"
  local target_version=""
  local branch_tip=""
  local tip_error=""

  if [[ "$branch" == "main" ]]; then
    echo ""
    return 0
  fi

  # Version branches are based on main.
  if [[ "$branch" =~ ^v([1-9][0-9]?)\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$ ]]; then
    echo "main"
    return 0
  fi

  # Directed dev/fix branches explicitly target the version suffix.
  if [[ "$branch" =~ \
    ^(dev|fix)/.+-(v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?))$ ]]; then
    target_version="${BASH_REMATCH[2]}"
    echo "$target_version"
    return 0
  fi

  # Contributor/other branches: infer the nearest ancestor branch.
  if ! has_local_branch "$branch"; then
    if has_remote_branch "$branch"; then
      branch_ref="origin/$branch"
    else
      echo ""
      return 0
    fi
  fi

  if ! capture_command_output \
    branch_tip tip_error \
    git rev-parse "$branch_ref"; then
    record_diagnostic \
      "Failed to resolve branch tip for '$branch'; Parent column left blank." \
      "$tip_error"
    echo ""
    return 0
  fi

  local best_base=""
  local best_distance=""
  local ref

  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    [[ "$ref" == "origin" ]] && continue
    [[ "$ref" == "origin/HEAD" ]] && continue
    [[ "$ref" == "$branch" ]] && continue
    [[ "$ref" == "origin/$branch" ]] && continue

    local candidate_ref="$ref"
    local candidate_display="$ref"
    local candidate_tip=""
    if [[ "$ref" == origin/* ]]; then
      candidate_display="${ref#origin/}"
    fi
    [[ "$candidate_display" == "$branch" ]] && continue

    # If two branches point to the same tip commit, neither should be treated
    # as the other's parent.
    candidate_tip=$(git rev-parse "$candidate_ref" 2>/dev/null || true)
    if [[ -n "$branch_tip" && -n "$candidate_tip" &&
      "$candidate_tip" == "$branch_tip" ]]; then
      continue
    fi

    if ! git merge-base --is-ancestor \
      "$candidate_ref" "$branch_ref" >/dev/null 2>&1; then
      continue
    fi

    local distance
    distance=$(git rev-list --count "$candidate_ref..$branch_ref" \
      2>/dev/null || echo "")
    [[ "$distance" =~ ^[0-9]+$ ]] || continue

    if [[ -z "$best_distance" || "$distance" -lt "$best_distance" ]]; then
      best_distance="$distance"
      best_base="$candidate_display"
    fi
  done < <(
    {
      git for-each-ref --format='%(refname:short)' refs/heads
      git for-each-ref --format='%(refname:short)' refs/remotes/origin
    } | sort -u
  )

  if [[ -z "$best_base" ]]; then
    record_diagnostic \
      "Could not infer parent branch for '$branch'; Parent column left blank."
  fi

  echo "$best_base"
}

generate_report_header() {
  local report_header_cols

  report_header_cols='| **Branch** | **Type** | **Parent** | **Status** | '
  report_header_cols+='**Staged/<br>Unstaged** | **Unpushed<br>Commits** | '
  report_header_cols+='**Ahead/<br>Behind** | **PR** | **First Commit** | '
  report_header_cols+='**Last Commit** |'

  cat > "$OUTPUT_FILE" << EOF
# Branch Report ${RUN_TS_DISPLAY}

**Command:** \`${REPORT_COMMAND}\`

$report_header_cols
| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |
EOF
}

append_report_warnings() {
  local warning

  [[ -s "$WARNINGS_FILE" ]] || return 0

  cat >> "$OUTPUT_FILE" << EOF

## Warnings

EOF

  while IFS= read -r warning; do
    printf -- '- %s\n' "$warning" >> "$OUTPUT_FILE"
  done < "$WARNINGS_FILE"
}

append_report_row() {
  local branch="$1"
  local type="$2"
  local base="$3"
  local status="$4"
  local staged_unstaged="$5"
  local unpushed_commits="$6"
  local ahead_behind="$7"
  local pr="$8"
  local created="$9"
  local last_commit="${10}"

  # Escape markdown-table delimiters so table column counts stay stable.
  branch="${branch//|/\\|}"
  type="${type//|/\\|}"
  base="${base//|/\\|}"
  status="${status//|/\\|}"
  staged_unstaged="${staged_unstaged//|/\\|}"
  unpushed_commits="${unpushed_commits//|/\\|}"
  ahead_behind="${ahead_behind//|/\\|}"
  pr="${pr//|/\\|}"
  created="${created//|/\\|}"
  last_commit="${last_commit//|/\\|}"

  printf '| %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |\n' \
    "$branch" "$type" "$base" "$status" "$staged_unstaged" \
    "$unpushed_commits" "$ahead_behind" "$pr" "$created" \
    "$last_commit" >> "$OUTPUT_FILE"
}

format_ratio_or_blank() {
  local left="$1"
  local right="$2"

  if [[ "$left" =~ ^[0-9]+$ && "$right" =~ ^[0-9]+$ ]]; then
    if [[ "$left" -eq 0 && "$right" -eq 0 ]]; then
      echo ""
    else
      echo "$left/$right"
    fi
  else
    echo ""
  fi
}

cleanup_old_reports() {
  local old_report
  [[ -f "$OUTPUT_FILE" ]] || return
  for old_report in "$branch_reports_dir"/branch-*.md; do
    [[ "$old_report" == "$OUTPUT_FILE" ]] && continue
    [[ -e "$old_report" ]] || continue
    rm -f "$old_report" || true
  done
}

check_branch_status() {
  local branch="$1"
  local report_file="$2"
  local is_current="${3:-false}"
  local include_local_rows="${4:-true}"
  local include_remote_rows="${5:-true}"

  if [[ "$INVALID_ONLY" == true ]] &&
    ! branch_violates_naming_rules "$branch"; then
    return 0
  fi

  local branch_display
  local branch_status_display
  local branch_status_display_local
  local branch_status_display_remote
  local branch_report_display
  branch_display=$(branch_name_display "$branch")
  branch_status_display=$(branch_name_status_display "$branch" "$is_current")
  branch_status_display_local="$branch_status_display"
  branch_status_display_remote=$(branch_name_status_display "$branch" "false")
  branch_report_display=$(branch_name_report_display "$branch" "$is_current")
  if branch_violates_naming_rules "$branch"; then
    INVALID_BRANCHES_FOUND=$((INVALID_BRANCHES_FOUND + 1))
  fi

  # Fetch latest remote refs once so remote-derived fields are less stale.
  ensure_remote_refs_fetched

  # Gather status information — use fallback values if any step fails
  local repo_status staged_count unstaged_count auto_stash_count
  local unpushed_count pr_count branch_type
  if [[ "$is_current" == true ]]; then
    repo_status=$(check_repo_status "$branch") || repo_status="unknown"
    staged_count=$(get_staged_changes "$branch") || staged_count="N/A"
    unstaged_count=$(get_unstaged_changes "$branch") || unstaged_count="N/A"
  else
    if is_protected_branch "$branch"; then
      repo_status="read-only"
    else
      repo_status="not checked out"
    fi
    staged_count=""
    unstaged_count=""
  fi
  auto_stash_count=$(get_branch_auto_stash_count "$branch") || \
    auto_stash_count="0"
  unpushed_count=$(get_unpushed_commits "$branch") || unpushed_count="N/A"
  pr_count=$(get_pending_pr_count    "$branch") || pr_count="N/A"
  branch_type=$(get_branch_type      "$branch") || branch_type="unknown"
  if [[ "$NO_ARG_MODE" == true &&
    "$branch_type" == "local (tracking origin)" ]]; then
    include_remote_rows=false
  fi
  local behind_count="0"
  local created_date last_commit_date
  local base_reference=""
  created_date=$(get_branch_created_date "$branch" "local")
  last_commit_date=$(get_branch_last_commit_date "$branch" "local")
  base_reference=$(get_branch_base_reference "$branch")
  [[ -z "$created_date" ]] && created_date=""
  [[ -z "$last_commit_date" ]] && last_commit_date=""
  [[ "$branch_type" == "local (tracking origin)" ]] && \
    behind_count=$(get_behind_count "$branch") || behind_count="0"

  # Build and print compact status line(s)
  if [[ "$branch_type" == "local (tracking origin)" &&
    "$include_local_rows" == true && "$include_remote_rows" == true ]]; then
    local local_tags=("[local]")
    local remote_tags=("[remote]")
    local split_rows=false
    local local_status_sig remote_status_sig

    [[ "$is_current" == true ]] && local_tags+=("[current]")
    if [[ "$is_current" == true ]]; then
      [[ "$repo_status" == "dirty" ]] && local_tags+=("[dirty]")
      [[ "$staged_count" =~ ^[0-9]+$ && "$staged_count" -gt 0 ]] && \
        local_tags+=("[staged]")
      [[ "$unstaged_count" =~ ^[0-9]+$ && "$unstaged_count" -gt 0 ]] && \
        local_tags+=("[unstaged]")
    elif is_protected_branch "$branch"; then
      local_tags+=("[read-only]")
    fi
    [[ "$auto_stash_count" =~ ^[0-9]+$ && "$auto_stash_count" -gt 0 ]] && \
      local_tags+=("[auto-stash: $auto_stash_count]")
    [[ "$unpushed_count" =~ ^[0-9]+$ && "$unpushed_count" -gt 0 ]] && \
      local_tags+=("[ahead $unpushed_count]")

    [[ "$behind_count" =~ ^[0-9]+$ && "$behind_count" -gt 0 ]] && \
      remote_tags+=("[ahead $behind_count of local]")
    [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && \
      remote_tags+=("[PRs: $pr_count]")

    local_status_sig="${local_tags[*]}"
    remote_status_sig="${remote_tags[*]}"
    if [[ "$local_status_sig" != "[local]" ||
      "$remote_status_sig" != "[remote]" ]]; then
      split_rows=true
    fi

    if [[ "$split_rows" == true ]]; then
      printf '%s %s\n' "$branch_status_display_local" "${local_tags[*]}"
      printf '%s %s\n' "$branch_status_display_remote" "${remote_tags[*]}"
    else
      printf '%s [local] [remote]\n' "$branch_status_display"
    fi
  elif [[ "$branch_type" == "local (tracking origin)" &&
    "$include_remote_rows" == true ]]; then
    local tags=("[remote]")
    [[ "$behind_count" =~ ^[0-9]+$ && "$behind_count" -gt 0 ]] && \
      tags+=("[ahead $behind_count of local]")
    [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && \
      tags+=("[PRs: $pr_count]")
    printf '%s %s\n' "$branch_status_display_remote" "${tags[*]}"
  else
    local tags=()
    if [[ "$include_remote_rows" == true &&
      "$include_local_rows" == false ]]; then
      tags+=("[remote]")
    elif [[ "$branch_type" == "remote" ]]; then
      tags+=("[remote]")
    else
      tags+=("[local]")
    fi
    if [[ "$include_local_rows" == true ]]; then
      [[ "$is_current" == true ]] && tags+=("[current]")
      if [[ "$is_current" == true ]]; then
        [[ "$repo_status" == "dirty" ]] && tags+=("[dirty]")
        [[ "$staged_count" =~ ^[0-9]+$ && "$staged_count" -gt 0 ]] && \
          tags+=("[staged]")
        [[ "$unstaged_count" =~ ^[0-9]+$ && "$unstaged_count" -gt 0 ]] && \
          tags+=("[unstaged]")
      elif is_protected_branch "$branch"; then
        tags+=("[read-only]")
      fi
      [[ "$auto_stash_count" =~ ^[0-9]+$ && "$auto_stash_count" -gt 0 ]] && \
        tags+=("[auto-stash: $auto_stash_count]")
    fi
    [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && \
      tags+=("[PRs: $pr_count]")
    if [[ "$include_remote_rows" == true &&
      "$include_local_rows" == false ]]; then
      printf '%s %s\n' "$branch_status_display_remote" "${tags[*]}"
    else
      printf '%s %s\n' "$branch_status_display_local" "${tags[*]}"
    fi
  fi

  # Append to report
  # Append report row(s)
    local branch_local_display="$branch_report_display"
    local local_status="$repo_status"
    if [[ "$auto_stash_count" =~ ^[0-9]+$ && "$auto_stash_count" -gt 0 ]]; then
      local_status+="; auto-stash:$auto_stash_count"
    fi
    local branch_remote_display
    branch_remote_display=$(branch_name_report_display "$branch" "false")

    if [[ "$branch_type" == "local (tracking origin)" ]]; then
      local pr_count_display
      local unpushed_display
      pr_count_display=$(format_zero_as_blank "$pr_count")
      unpushed_display=$(format_zero_as_blank "$unpushed_count")
      if [[ "$include_local_rows" == true ]]; then
        local local_ahead_behind
        local staged_unstaged_display
        local_ahead_behind=$(format_ratio_or_blank \
          "$unpushed_count" "$behind_count")
        staged_unstaged_display=$(format_ratio_or_blank \
          "$staged_count" "$unstaged_count")
        append_report_row \
          "$branch_local_display" "local" "$base_reference" \
          "$local_status" "$staged_unstaged_display" \
          "$unpushed_display" "$local_ahead_behind" \
          "$pr_count_display" "$created_date" "$last_commit_date"
      fi

      local remote_status="synced"
      if [[ "$behind_count" =~ ^[0-9]+$ && "$behind_count" -gt 0 ]] ||
        [[ "$unpushed_count" =~ ^[0-9]+$ && "$unpushed_count" -gt 0 ]]; then
        remote_status="diverged"
      fi
      if [[ "$include_remote_rows" == true ]]; then
        local remote_ahead_behind
        remote_ahead_behind=$(format_ratio_or_blank \
          "$behind_count" "$unpushed_count")
        append_report_row \
          "$branch_remote_display" "remote" "$base_reference" \
          "$remote_status" "" "" "$remote_ahead_behind" \
          "$pr_count_display" "$created_date" "$last_commit_date"
      fi
    elif [[ "$branch_type" == "local" ]]; then
      local pr_count_display
      local staged_unstaged_display
      local unpushed_display
      pr_count_display=$(format_zero_as_blank "$pr_count")
      staged_unstaged_display=$(format_ratio_or_blank \
        "$staged_count" "$unstaged_count")
      unpushed_display=$(format_zero_as_blank "$unpushed_count")
      if [[ "$include_local_rows" == true ]]; then
        append_report_row \
          "$branch_local_display" "local" "" "$local_status" \
          "$staged_unstaged_display" "$unpushed_display" "" \
          "$pr_count_display" "$created_date" "$last_commit_date"
      elif [[ "$include_remote_rows" == true ]]; then
        append_report_row \
          "$branch_remote_display" "remote" "" "not tracking origin" \
          "" "" "" "$pr_count_display" "$created_date" \
          "$last_commit_date"
      fi
    else
      local pr_count_display
      pr_count_display=$(format_zero_as_blank "$pr_count")
      if [[ "$include_remote_rows" == true ]]; then
        append_report_row \
          "$branch_display" "remote" "" "$repo_status" "" "" "" \
          "$pr_count_display" "$created_date" "$last_commit_date"
      fi
    fi

  if [[ "$VERBOSE" == true ]]; then
    echo "  Status: $repo_status"
    echo "  Auto-stash: $auto_stash_count"
    echo "  Staged: $staged_count"
    echo "  Unstaged: $unstaged_count"
    echo "  Unpushed: $unpushed_count"
    echo "  Pending PRs: $pr_count"
  fi

}

check_remote_branch_status() {
  local branch="$1"
  local report_file="$2"

  if [[ "$INVALID_ONLY" == true ]] &&
    ! branch_violates_naming_rules "$branch"; then
    return 0
  fi

  local branch_display
  local branch_status_display
  local branch_report_display
  branch_display=$(branch_name_display "$branch")
  branch_status_display=$(branch_name_status_display "$branch" "false")
  branch_report_display=$(branch_name_report_display "$branch" "false")
  if branch_violates_naming_rules "$branch"; then
    INVALID_BRANCHES_FOUND=$((INVALID_BRANCHES_FOUND + 1))
  fi

  ensure_remote_refs_fetched

  # Get PR status and last commit
  local pr_count created_date last_commit_date base_reference
  pr_count=$(get_pending_pr_count "$branch") || pr_count="N/A"
  created_date=$(get_branch_created_date "$branch" "remote")
  last_commit_date=$(get_branch_last_commit_date "$branch" "remote")
  base_reference=$(get_branch_base_reference "$branch")
  [[ -z "$created_date" ]] && created_date=""
  [[ -z "$last_commit_date" ]] && last_commit_date=""

  # Build and print compact status line
  local tags=("[remote]")
  [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && \
    tags+=("[PRs: $pr_count]")
  printf '%s %s\n' "$branch_status_display" "${tags[*]}"

  local pr_count_display
  pr_count_display=$(format_zero_as_blank "$pr_count")
  append_report_row \
    "$branch_report_display" "remote" "$base_reference" "synced" "" \
    "" "" "$pr_count_display" "$created_date" "$last_commit_date"

  if [[ "$VERBOSE" == true ]]; then
    echo "  Last Commit: $last_commit_date"
    echo "  Pending PRs: $pr_count"
  fi
}


# Check for help first — if specified, ignore all other arguments
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    usage
    exit 0
  fi
done

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -a)
      ALL_BRANCHES=true
      shift
      ;;
    -b)
      COLOR_OUTPUT=false
      shift
      ;;
    -n)
      REMOTE_FETCH_ENABLED=false
      shift
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    -i)
      INVALID_ONLY=true
      shift
      ;;
    -l)
      INCLUDE_LOCAL_FLAG=true
      shift
      ;;
    -r)
      INCLUDE_REMOTE_FLAG=true
      shift
      ;;
    -x)
      shift
      if [[ $# -eq 0 ]]; then
        usage_error "Missing PATTERN for -x"
      fi
      EXCLUDE_PATTERN="$1"
      shift
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      if [[ -n "$TARGET_BRANCH" || -n "$BRANCH_PATTERN" ]]; then
        printf 'Error: Unexpected argument: %q\n' "$1" >&2
        printf 'Multiple positional arguments received — pattern '
        printf 'was likely expanded by the shell.\n' >&2
        printf 'Quote the pattern to prevent expansion, '
        printf 'e.g.: lsbranch "*"\n' >&2
        exit 1
      fi
      if [[ "$1" =~ [\*\?\[] ]]; then
        BRANCH_PATTERN="$1"
      else
        TARGET_BRANCH="$1"
      fi
      shift
      ;;
  esac
done

# If -a specified, set pattern to match all branches
if $ALL_BRANCHES; then
  if [[ -n "$TARGET_BRANCH" ]]; then
    usage_error "Cannot combine BRANCH with -a"
  fi
  BRANCH_PATTERN="*"
fi

if [[ -n "$TARGET_BRANCH" &&
  ( "$INVALID_ONLY" == true || -n "$EXCLUDE_PATTERN" ||
    "$INCLUDE_LOCAL_FLAG" == true || "$INCLUDE_REMOTE_FLAG" == true ) ]]; then
  usage_error "When BRANCH is specified, only -v, -b, and -n are allowed"
fi

if [[ -n "$EXCLUDE_PATTERN" && -z "$BRANCH_PATTERN" ]]; then
  usage_error "Option -x requires -a or PATTERN"
fi

if [[ "$INVALID_ONLY" == true && -z "$BRANCH_PATTERN" ]]; then
  usage_error "Option -i requires -a or PATTERN"
fi

# Determine what to include based on flags
# If neither flag specified, default to both; if at least one flag
# specified, use the flags
if ! $INCLUDE_LOCAL_FLAG && ! $INCLUDE_REMOTE_FLAG; then
  # Default: include both
  INCLUDE_LOCAL=true
  INCLUDE_REMOTE=true
else
  # At least one flag specified: use exactly what was specified
  INCLUDE_LOCAL=$INCLUDE_LOCAL_FLAG
  INCLUDE_REMOTE=$INCLUDE_REMOTE_FLAG
fi

# No-argument invocation should show only the current local branch row.
if [[ -z "$TARGET_BRANCH" && -z "$BRANCH_PATTERN" &&
    "$INCLUDE_LOCAL_FLAG" == false && "$INCLUDE_REMOTE_FLAG" == false ]]; then
  NO_ARG_MODE=true
fi

# Build the exact command string used to generate this report.
build_report_command

# Validate reports directory and set output path
mkdir -p "$branch_reports_dir"
OUTPUT_FILE="$branch_reports_dir/branch-${RUN_TS_FILE}.md"

# Get current branch to restore later
ORIGINAL_BRANCH=$(bt_get_current_branch ||
  bt_error_exit 2 "Failed to determine current branch")

# Determine branches to check
if [[ -n "$TARGET_BRANCH" ]]; then
  if ! has_local_branch "$TARGET_BRANCH" &&
    ! has_remote_branch "$TARGET_BRANCH"; then
    bt_error_exit 5 "Branch does not exist: $TARGET_BRANCH"
  fi

  BRANCHES_TO_CHECK=""
  REMOTE_BRANCHES_TO_CHECK=""
  REMOTE_ONLY=""

  if has_local_branch "$TARGET_BRANCH"; then
    BRANCHES_TO_CHECK="$TARGET_BRANCH"
  fi
  if has_remote_branch "$TARGET_BRANCH"; then
    REMOTE_BRANCHES_TO_CHECK="$TARGET_BRANCH"
    if ! has_local_branch "$TARGET_BRANCH"; then
      REMOTE_ONLY="$TARGET_BRANCH"
    fi
  fi
elif [[ -z "$BRANCH_PATTERN" ]]; then
  # Default scope is current branch; remote scope is current tracked branch,
  # if any.
  if ! has_local_branch "$ORIGINAL_BRANCH"; then
    bt_error_exit 5 "Current branch does not exist: $ORIGINAL_BRANCH"
  fi

  BRANCHES_TO_CHECK="$ORIGINAL_BRANCH"
  if has_remote_branch "$ORIGINAL_BRANCH"; then
    REMOTE_BRANCHES_TO_CHECK="$ORIGINAL_BRANCH"
  else
    REMOTE_BRANCHES_TO_CHECK=""
  fi
  REMOTE_ONLY=""
else
  # Check branches matching pattern
  local_branches=$(get_local_branches "$BRANCH_PATTERN")
  remote_branches=$(get_remote_branches "$BRANCH_PATTERN")
  remote_only_branches=$(get_remote_only_branches "$BRANCH_PATTERN")

  local_branches=$(apply_exclude_filter "$local_branches" "$EXCLUDE_PATTERN")
  remote_branches=$(apply_exclude_filter "$remote_branches" "$EXCLUDE_PATTERN")
  remote_only_branches=$(apply_exclude_filter \
    "$remote_only_branches" "$EXCLUDE_PATTERN")

  BRANCHES_TO_CHECK="$local_branches"
  REMOTE_BRANCHES_TO_CHECK="$remote_branches"
  REMOTE_ONLY="$remote_only_branches"

  if [[ "$INCLUDE_LOCAL" == true && "$INCLUDE_REMOTE" == false &&
    -z "$BRANCHES_TO_CHECK" ]]; then
    bt_warn "No branches found matching pattern: $BRANCH_PATTERN"
  elif [[ "$INCLUDE_REMOTE" == true && "$INCLUDE_LOCAL" == false &&
    -z "$REMOTE_BRANCHES_TO_CHECK" ]]; then
    bt_warn "No branches found matching pattern: $BRANCH_PATTERN"
  elif [[ "$INCLUDE_REMOTE" == true && "$INCLUDE_LOCAL" == true &&
    -z "$BRANCHES_TO_CHECK" && -z "$REMOTE_BRANCHES_TO_CHECK" ]]; then
    bt_warn "No branches found matching pattern: $BRANCH_PATTERN"
  fi
fi

# Generate report header
generate_report_header

# No-argument invocation shows exactly one row for the current branch, using
# the current branch's actual ref type if it only exists remotely.
if [[ "$NO_ARG_MODE" == true ]]; then
  if has_local_branch "$ORIGINAL_BRANCH"; then
    check_branch_status \
      "$ORIGINAL_BRANCH" "$OUTPUT_FILE" true true false || true
  elif has_remote_branch "$ORIGINAL_BRANCH"; then
    check_remote_branch_status "$ORIGINAL_BRANCH" "$OUTPUT_FILE" || true
  fi
else
  # Check local branches only when local inclusion is enabled.
  if [[ "$INCLUDE_LOCAL" == true ]]; then
    local_to_check=""
    if [[ -z "$BRANCH_PATTERN" ]]; then
      local_to_check="$BRANCHES_TO_CHECK"
    else
      local_to_check="$BRANCHES_TO_CHECK"
    fi
    
    if [[ -n "$local_to_check" ]]; then
      while IFS= read -r branch; do
        if [[ -n "$branch" ]]; then
          _is_current=false
          [[ "$branch" == "$ORIGINAL_BRANCH" ]] && _is_current=true
          check_branch_status \
            "$branch" "$OUTPUT_FILE" "$_is_current" \
            "$INCLUDE_LOCAL" "$INCLUDE_REMOTE" || true
        fi
      done <<< "$local_to_check"
    fi
  fi

  # Check remote-only branches if enabled
  if [[ "$INCLUDE_REMOTE" == true ]]; then
    remote_to_check=""
    if [[ "$INCLUDE_LOCAL" == true ]]; then
      remote_to_check="$REMOTE_ONLY"
    else
      remote_to_check="$REMOTE_BRANCHES_TO_CHECK"
    fi

    if [[ -n "$remote_to_check" ]]; then
      while IFS= read -r branch; do
        if [[ -n "$branch" ]]; then
          check_remote_branch_status "$branch" "$OUTPUT_FILE" || true
        fi
      done <<< "$remote_to_check"
    fi
  fi
fi

if supports_report_color_output; then
  FOOTER_BRANCH_LINE='**Branch**: Indicates the branch name. '
  FOOTER_BRANCH_LINE+='<span style="color:#66bb6a;font-weight:700">*</span> '
  FOOTER_BRANCH_LINE+='indicates this is the current branch.'
  FOOTER_INVALID_LINE='<span style="color:#c62828;font-weight:700">!</span> '
  FOOTER_INVALID_LINE+='after branch name indicates the name violates naming '
  FOOTER_INVALID_LINE+='rules.'
else
  FOOTER_BRANCH_LINE='**Branch**: Indicates the branch name. '
  FOOTER_BRANCH_LINE+='* indicates this is the current branch.'
  FOOTER_INVALID_LINE='! after branch name indicates the name '
  FOOTER_INVALID_LINE+='violates naming rules.'
fi

cat >> "$OUTPUT_FILE" << EOF

$FOOTER_BRANCH_LINE

$FOOTER_INVALID_LINE

**Type**: Indicates branch is \`local\` or \`remote\`.

**Parent**: Parent branch reference for the row when applicable (for example,
\`main\` or \`v1.0.0\`).

**Status**: \`clean\`, \`dirty\`, or \`not checked out\` for local worktree
state, \`synced\` or \`diverged\` for tracked-branch state, or \`unknown\`.
For local branches, status includes \`; auto-stash:N\` when branch-matching
chcurrent auto-stashes exist.

**Staged/Unstaged**: Counts of staged and unstaged files.

**Unpushed Commits**: Count of local commits pending sync for this branch.

**Ahead/Behind**: Counts of commits this branch is ahead of / behind
its tracked branch.

**PR**: Count of pending (not closed) pull requests.

**First Commit**: Approximate branch creation date, derived from the
first commit on the branch.

**Last Commit**: Date of the last commit on the branch.
EOF

append_report_warnings

cleanup_old_reports

bt_success "Report generated: ${OUTPUT_FILE#${repo_root}/}"
if [[ "$VERBOSE" == true ]]; then
  echo ""
  bt_info "Report contents:"
  sed 's/^/  /' "$OUTPUT_FILE"
fi

if [[ "$INVALID_ONLY" == true && "$INVALID_BRANCHES_FOUND" -gt 0 ]]; then
  exit 4
fi
exit 0
