#!/usr/bin/env bash

# lsbranch - list branches and their status.
#
# See usage below for details, or run: lsbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  lsbranch [-v]
  lsbranch BRANCH [-v]
  lsbranch {-a | PATTERN} [-i] [-l] [-r] [-v] [-x "PATTERN"]
  lsbranch {-h | --help}

For first usage, list status of the current branch.

Use BRANCH to list status of the branch with the name BRANCH.

Use -a or PATTERN to list the status of branches matching "*"
or PATTERN, respectively.

Report includes:
  Branch:  Indicates the branch name. `*` indicates this is
           the current branch. '!' indicates the branch name
           violates naming rules.
  Type:    Indicates branch is `local` or `remote`.
  Base:    Base branch reference for the row when applicable.
           For example, 'remote main' or 'local v1.0.0'.
  Status:  'clean' or 'dirty' for local worktree state,
           'synced' or 'diverged' for tracked-branch state,
           or 'unknown'.
  Staged/Unstaged: Counts of staged and unstaged files.
  Unpushed Commits: Count of local commits pending sync
           for this branch.
  Ahead/Behind: Counts of commits this branch is
           ahead of / behind its tracked branch.
  PR:      Count of pending (not closed) pull requests.
  Created: Date the branch was created.
  Last Commit: Date of the last commit on the branch.

Arguments:
  BRANCH      Check branch with name BRANCH.
  PATTERN     Filter branches by quoted (") glob pattern on
              branch name. Supports *, ?, [abc], etc.
              Examples: "*bug*", "fix*",  "*issue*".

Options (see above for the options allowed for each form of usage):
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored). Help is output also
              if invalid arguments or options are provided.
  -a          Same as specifying "*" as PATTERN.
  -i          List branches that violate naming rules (see
              Contributor Guide for rules).
  -l          List local branches.
  -r          List remote branches.
  -v          Verbose output to stdout for debugging.
  -x PATTERN  Exclude branches matching the given quoted (") glob
              pattern.

  If neither -l nor -r is specified, same as specifying
  both -l and -r (i.e., both local and remote branches are listed).

Examples:
  # Check current branch
  lsbranch

  # Check all branches (local and remote)
  lsbranch -a
  lsbranch -a -l -r
  lsbranch "*"
  lsbranch "*" -l -r

  # Check local branches
  lsbranch -a -l
  lsbranch "*" -l

  # Check remote branches
  lsbranch -a -r
  lsbranch "*" -r

  # Check feature branches (both local and remote)
  lsbranch "feature/*"

  # Check branches matching pattern (both local and remote)
  lsbranch "*auth*"

  # Verbose output for current branch
  lsbranch -v

Outputs:
  - Writes help (usage) text or status messages for the
    selected branches to stdout.
  - Writes errors and diagnostics to stderr.
  - Writes a report to <repo>/reports/branch-<datetime>.md
    (a GitHub untracked file).
  - Removes previous reports when a new one is successfully
    written.

Exit codes:
  0   Success.
  1   Argument or validation error.
  2   Git operation failed.
  3   Reports directory does not exist.
  4   Branches found that violate naming rules if option -i
      specified.
  5   Branch does not exist when BRANCH is specified or
      when request is for current branch.
EOF
}

usage_error() {
  local message="$1"
  echo "Error: $message" >&2
  echo >&2
  usage >&2
  exit 1
}

# High-Level Flow:
# - Resolves branch context, base-branch relationship, and remote
#   synchronization status.
# - Collects ahead/behind, dirty-worktree, and optional PR metadata details.
# - Writes a branch-status report and optionally appends status snapshots to
#   history logs.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${SCRIPT_DIR}/../.." && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/github_helpers.sh
source "$SCRIPT_DIR/../helpers/github_helpers.sh"

RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
ORIGINAL_ARGS=("$@")
REPORT_COMMAND=""

# Default options
OUTPUT_FILE=""
BRANCH_PATTERN=""
EXCLUDE_PATTERN=""
TARGET_BRANCH=""
VERBOSE=false
BRANCH_ERRORS=0
INVALID_BRANCHES_FOUND=0
ALL_BRANCHES=false
INCLUDE_LOCAL_FLAG=false
INCLUDE_REMOTE_FLAG=false
INVALID_ONLY=false

matches_glob() {
  local text="$1"
  local pattern="$2"
  [[ "$text" == $pattern ]]
}

has_local_branch() {
  local branch="$1"
  [[ -n "$(git branch --list "$branch")" ]]
}

has_remote_branch() {
  local branch="$1"
  [[ -n "$(git branch -r --list "origin/$branch")" ]]
}

is_version_branch() {
  local branch="$1"
  [[ "$branch" =~ ^v([1-9][0-9]?)\.([0-9]|[1-9][0-9]?)\.([0-9]|[1-9][0-9]?)$ ]]
}

is_nonversion_branch() {
  local branch="$1"
  [[ "$branch" != *.* ]]
}

branch_violates_naming_rules() {
  local branch="$1"

  if is_version_branch "$branch" || is_nonversion_branch "$branch"; then
    return 1
  fi
  return 0
}

branch_name_display() {
  local branch="$1"
  local suffix=""

  if branch_violates_naming_rules "$branch"; then
    suffix="!"
  fi

  printf '%s%s\n' "$branch" "$suffix"
}

apply_exclude_filter() {
  local branches="$1"
  local exclude_pattern="$2"

  if [[ -z "$exclude_pattern" ]]; then
    printf '%s\n' "$branches"
    return 0
  fi

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    if ! matches_glob "$branch" "$exclude_pattern"; then
      echo "$branch"
    fi
  done <<< "$branches"
}

get_branch_created_date() {
  local branch="$1"
  local ref_type="${2:-local}"
  local ref="$branch"

  if [[ "$ref_type" == "remote" ]]; then
    ref="origin/$branch"
  fi

  if [[ "$ref_type" == "local" ]]; then
    git reflog show --date=short --format='%ad' --reverse "$ref" 2>/dev/null | head -n 1 || true
  else
    git log "$ref" --reverse --date=short --format='%ad' 2>/dev/null | head -n 1 || true
  fi
}

get_branch_last_commit_date() {
  local branch="$1"
  local ref_type="${2:-local}"
  local ref="$branch"

  if [[ "$ref_type" == "remote" ]]; then
    ref="origin/$branch"
  fi

  git log -1 --date=short --format='%ad' "$ref" 2>/dev/null || true
}

get_remote_branches() {
  local pattern="$1"
  git branch -r | sed 's|origin/||' | sed 's/^[[:space:]]*//' | grep -v HEAD | while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    if matches_glob "$branch" "$pattern"; then
      echo "$branch"
    fi
  done | sort || echo ""
}

get_local_branches() {
  local pattern="$1"
  git branch --list | sed 's/^[[:space:]]*//' | sed 's/^\* //' | while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    if matches_glob "$branch" "$pattern"; then
      echo "$branch"
    fi
  done | sort || echo ""
}

get_remote_only_branches() {
  local pattern="$1"
  get_remote_branches "$pattern" | while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    # Only include if not local
    if ! has_local_branch "$branch"; then
      echo "$branch"
    fi
  done | sort || echo ""
}

check_repo_status() {
  local branch="$1"
  local tracked_changes

  tracked_changes=$(git status --porcelain --untracked-files=no 2>/dev/null || true)
  if [[ -z "$tracked_changes" ]]; then
    echo "clean"
  else
    echo "dirty"
  fi
}

get_staged_changes() {
  local branch="$1"

  git status --porcelain --untracked-files=no 2>/dev/null | awk '
    substr($0,1,1) != " " { c++ }
    END { print c + 0 }
  '
}

get_unstaged_changes() {
  local branch="$1"

  git status --porcelain --untracked-files=no 2>/dev/null | awk '
    substr($0,2,1) != " " { c++ }
    END { print c + 0 }
  '
}

get_unpushed_commits() {
  local branch="$1"
  # Use a subshell so pipefail doesn't propagate when origin/$branch doesn't exist
  { git log "origin/$branch..HEAD" --oneline 2>/dev/null || true; } | wc -l
}

get_behind_count() {
  local branch="$1"
  # Commits on remote not yet in local
  { git log "HEAD..origin/$branch" --oneline 2>/dev/null || true; } | wc -l
}

get_pending_pr_count() {
  local branch="$1"

  local pr_count
  pr_count=$(gh pr list --head "$branch" --state open --json number --jq 'length' 2>/dev/null || echo "N/A")

  if [[ "$pr_count" =~ ^[0-9]+$ ]]; then
    echo "$pr_count"
  else
    echo "N/A"
  fi
}

format_zero_as_dash() {
  local value="$1"

  if [[ "$value" =~ ^[0-9]+$ && "$value" -eq 0 ]]; then
    echo "-"
  else
    echo "$value"
  fi
}

format_zero_as_blank() {
  local value="$1"

  if [[ "$value" =~ ^[0-9]+$ && "$value" -eq 0 ]]; then
    echo ""
  else
    echo "$value"
  fi
}

get_branch_type() {
  local branch="$1"
  
  local is_local=false
  local is_remote=false
  
  # Check if branch exists locally
  has_local_branch "$branch" && is_local=true
  
  # Check if branch exists on remote
  has_remote_branch "$branch" && is_remote=true
  
  if [[ "$is_local" == true && "$is_remote" == true ]]; then
    echo "local (tracking origin)"
  elif [[ "$is_local" == true ]]; then
    echo "local"
  elif [[ "$is_remote" == true ]]; then
    echo "remote"
  else
    echo "unknown"
  fi
}

build_report_command() {
  local args_rendered=""
  local arg rendered

  for arg in "${ORIGINAL_ARGS[@]}"; do
    printf -v rendered '%q' "$arg"
    if [[ -z "$args_rendered" ]]; then
      args_rendered="$rendered"
    else
      args_rendered+=" $rendered"
    fi
  done

  if [[ -n "$args_rendered" ]]; then
    REPORT_COMMAND="lsbranch $args_rendered"
  else
    REPORT_COMMAND="lsbranch"
  fi
}

get_branch_base_reference() {
  local branch="$1"
  local branch_ref="$branch"

  if [[ "$branch" == "main" ]]; then
    echo ""
    return 0
  fi

  if ! has_local_branch "$branch"; then
    echo ""
    return 0
  fi

  local best_base=""
  local best_distance=""
  local ref

  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    [[ "$ref" == "origin/HEAD" ]] && continue
    [[ "$ref" == "$branch" ]] && continue
    [[ "$ref" == "origin/$branch" ]] && continue

    local candidate_ref="$ref"
    local candidate_display
    if [[ "$ref" == origin/* ]]; then
      candidate_display="remote $ref"
    else
      candidate_display="local $ref"
    fi

    if ! git merge-base --is-ancestor "$candidate_ref" "$branch_ref" >/dev/null 2>&1; then
      continue
    fi

    local distance
    distance=$(git rev-list --count "$candidate_ref..$branch_ref" 2>/dev/null || echo "")
    [[ "$distance" =~ ^[0-9]+$ ]] || continue

    if [[ -z "$best_distance" || "$distance" -lt "$best_distance" ]]; then
      best_distance="$distance"
      best_base="$candidate_display"
    elif [[ "$distance" -eq "$best_distance" ]]; then
      # Keep ties stable and meaningful: prefer remote candidates over local.
      if [[ "$candidate_display" == remote* && "$best_base" == local* ]]; then
        best_base="$candidate_display"
      fi
    fi
  done < <(
    {
      git for-each-ref --format='%(refname:short)' refs/heads
      git for-each-ref --format='%(refname:short)' refs/remotes/origin
    } | sort -u
  )

  echo "$best_base"
}

generate_report_header() {
  cat > "$OUTPUT_FILE" << EOF
# Branch Report ${RUN_TS_DISPLAY}

**Command:** \`${REPORT_COMMAND}\`

| **Branch** | **Type** | **Base** | **Status** | **Staged/<br>Unstaged** | **Unpushed<br>Commits** | **Ahead/<br>Behind** | **PR** | **Created** | **Last Commit** |
| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |
EOF
}

append_report_row() {
  local branch="$1"
  local type="$2"
  local base="$3"
  local status="$4"
  local staged_unstaged="$5"
  local unpushed_commits="$6"
  local ahead_behind="$7"
  local pr="$8"
  local created="$9"
  local last_commit="${10}"

  # Escape markdown-table delimiters in cell values so row column counts stay stable.
  branch="${branch//|/\\|}"
  type="${type//|/\\|}"
  base="${base//|/\\|}"
  status="${status//|/\\|}"
  staged_unstaged="${staged_unstaged//|/\\|}"
  unpushed_commits="${unpushed_commits//|/\\|}"
  ahead_behind="${ahead_behind//|/\\|}"
  pr="${pr//|/\\|}"
  created="${created//|/\\|}"
  last_commit="${last_commit//|/\\|}"

  printf '| %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |\n' \
    "$branch" "$type" "$base" "$status" "$staged_unstaged" "$unpushed_commits" "$ahead_behind" "$pr" "$created" "$last_commit" >> "$OUTPUT_FILE"
}

format_ratio_or_blank() {
  local left="$1"
  local right="$2"

  if [[ "$left" =~ ^[0-9]+$ && "$right" =~ ^[0-9]+$ ]]; then
    if [[ "$left" -eq 0 && "$right" -eq 0 ]]; then
      echo ""
    else
      echo "$left/$right"
    fi
  else
    echo ""
  fi
}

cleanup_old_reports() {
  local old_report
  [[ -f "$OUTPUT_FILE" ]] || return
  for old_report in "$repo_root"/reports/branch-*.md; do
    [[ "$old_report" == "$OUTPUT_FILE" ]] && continue
    [[ -e "$old_report" ]] || continue
    rm -f "$old_report" || true
  done
}

check_branch_status() {
  local branch="$1"
  local report_file="$2"
  local is_current="${3:-false}"
  local include_local_rows="${4:-true}"
  local include_remote_rows="${5:-true}"

  if [[ "$INVALID_ONLY" == true ]] && ! branch_violates_naming_rules "$branch"; then
    return 0
  fi

  local branch_display
  branch_display=$(branch_name_display "$branch")
  if branch_violates_naming_rules "$branch"; then
    INVALID_BRANCHES_FOUND=$((INVALID_BRANCHES_FOUND + 1))
  fi

  # Attempt checkout; on failure write error entry and print status line
  if ! git checkout "$branch" >/dev/null 2>&1; then
    printf '%s [check failed]\n' "$branch_display"
    local current_marker=""
    [[ "$is_current" == true ]] && current_marker=" (current)"
    cat >> "$report_file" << EOF
### Branch: \`$branch_display\`$current_marker

> **ERROR:** Could not check out branch \`$branch\`. It may be a remote-only branch
> or contain uncommitted conflicts preventing checkout.

EOF
    BRANCH_ERRORS=$((BRANCH_ERRORS + 1))
    return 0
  fi

  # Fetch latest
  git fetch origin 2>/dev/null || true

  # Gather status information — use fallback values if any step fails
  local repo_status staged_count unstaged_count unpushed_count pr_count branch_type
  repo_status=$(check_repo_status   "$branch") || repo_status="unknown"
  staged_count=$(get_staged_changes  "$branch") || staged_count="N/A"
  unstaged_count=$(get_unstaged_changes "$branch") || unstaged_count="N/A"
  unpushed_count=$(get_unpushed_commits "$branch") || unpushed_count="N/A"
  pr_count=$(get_pending_pr_count    "$branch") || pr_count="N/A"
  branch_type=$(get_branch_type      "$branch") || branch_type="unknown"
  local behind_count="0"
  local created_date last_commit_date
  local base_reference=""
  created_date=$(get_branch_created_date "$branch" "local")
  last_commit_date=$(get_branch_last_commit_date "$branch" "local")
  base_reference=$(get_branch_base_reference "$branch")
  [[ -z "$created_date" ]] && created_date="unknown"
  [[ -z "$last_commit_date" ]] && last_commit_date="unknown"
  [[ "$branch_type" == "local (tracking origin)" ]] && \
    behind_count=$(get_behind_count "$branch") || behind_count="0"

  # Build and print compact status line(s)
  if [[ "$branch_type" == "local (tracking origin)" && "$include_local_rows" == true && "$include_remote_rows" == true ]]; then
    local local_tags=("[local]")
    local remote_tags=("[remote]")
    local split_rows=false
    local local_status_sig remote_status_sig

    [[ "$is_current" == true ]] && local_tags+=("[current]")
    [[ "$repo_status" == "dirty" ]] && local_tags+=("[dirty]")
    [[ "$staged_count" =~ ^[0-9]+$ && "$staged_count" -gt 0 ]] && local_tags+=("[staged]")
    [[ "$unstaged_count" =~ ^[0-9]+$ && "$unstaged_count" -gt 0 ]] && local_tags+=("[unstaged]")
    [[ "$unpushed_count" =~ ^[0-9]+$ && "$unpushed_count" -gt 0 ]] && local_tags+=("[ahead $unpushed_count]")

    [[ "$behind_count" =~ ^[0-9]+$ && "$behind_count" -gt 0 ]] && remote_tags+=("[ahead $behind_count of local]")
    [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && remote_tags+=("[PRs: $pr_count]")

    local_status_sig="${local_tags[*]}"
    remote_status_sig="${remote_tags[*]}"
    if [[ "$local_status_sig" != "[local]" || "$remote_status_sig" != "[remote]" ]]; then
      split_rows=true
    fi

    if [[ "$split_rows" == true ]]; then
      printf '%s %s\n' "$branch_display" "${local_tags[*]}"
      printf '%s %s\n' "$branch_display" "${remote_tags[*]}"
    else
      printf '%s [local] [remote]\n' "$branch_display"
    fi
  elif [[ "$branch_type" == "local (tracking origin)" && "$include_remote_rows" == true ]]; then
    local tags=("[remote]")
    [[ "$behind_count" =~ ^[0-9]+$ && "$behind_count" -gt 0 ]] && tags+=("[ahead $behind_count of local]")
    [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && tags+=("[PRs: $pr_count]")
    printf '%s %s\n' "$branch_display" "${tags[*]}"
  else
    local tags=()
    if [[ "$include_remote_rows" == true && "$include_local_rows" == false ]]; then
      tags+=("[remote]")
    elif [[ "$branch_type" == "remote" ]]; then
      tags+=("[remote]")
    else
      tags+=("[local]")
    fi
    if [[ "$include_local_rows" == true ]]; then
      [[ "$is_current" == true ]] && tags+=("[current]")
      [[ "$repo_status" == "dirty" ]] && tags+=("[dirty]")
      [[ "$staged_count" =~ ^[0-9]+$ && "$staged_count" -gt 0 ]] && tags+=("[staged]")
      [[ "$unstaged_count" =~ ^[0-9]+$ && "$unstaged_count" -gt 0 ]] && tags+=("[unstaged]")
    fi
    [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && tags+=("[PRs: $pr_count]")
    printf '%s %s\n' "$branch_display" "${tags[*]}"
  fi

  # Append to report
  # Append report row(s)
    local branch_local_display="$branch_display"
    local local_status="$repo_status"
    [[ "$is_current" == true ]] && branch_local_display="${branch_display}*"

    if [[ "$branch_type" == "local (tracking origin)" ]]; then
      local pr_count_display
      local unpushed_display
      pr_count_display=$(format_zero_as_blank "$pr_count")
      unpushed_display=$(format_zero_as_blank "$unpushed_count")
      if [[ "$include_local_rows" == true ]]; then
        local local_ahead_behind
        local staged_unstaged_display
        local_ahead_behind=$(format_ratio_or_blank "$unpushed_count" "$behind_count")
        staged_unstaged_display=$(format_ratio_or_blank "$staged_count" "$unstaged_count")
        append_report_row "$branch_local_display" "local" "$base_reference" "$local_status" "$staged_unstaged_display" "$unpushed_display" "$local_ahead_behind" "$pr_count_display" "$created_date" "$last_commit_date"
      fi

      local remote_status="synced"
      if [[ "$behind_count" =~ ^[0-9]+$ && "$behind_count" -gt 0 ]] || [[ "$unpushed_count" =~ ^[0-9]+$ && "$unpushed_count" -gt 0 ]]; then
        remote_status="diverged"
      fi
      if [[ "$include_remote_rows" == true ]]; then
        local remote_ahead_behind
        remote_ahead_behind=$(format_ratio_or_blank "$behind_count" "$unpushed_count")
        append_report_row "$branch_display" "remote" "$base_reference" "$remote_status" "" "" "$remote_ahead_behind" "$pr_count_display" "$created_date" "$last_commit_date"
      fi
    elif [[ "$branch_type" == "local" ]]; then
      local pr_count_display
      local staged_unstaged_display
      local unpushed_display
      pr_count_display=$(format_zero_as_blank "$pr_count")
      staged_unstaged_display=$(format_ratio_or_blank "$staged_count" "$unstaged_count")
      unpushed_display=$(format_zero_as_blank "$unpushed_count")
      if [[ "$include_local_rows" == true ]]; then
        append_report_row "$branch_local_display" "local" "" "$local_status" "$staged_unstaged_display" "$unpushed_display" "" "$pr_count_display" "$created_date" "$last_commit_date"
      elif [[ "$include_remote_rows" == true ]]; then
        append_report_row "$branch_display" "remote" "" "not tracking origin" "" "" "" "$pr_count_display" "$created_date" "$last_commit_date"
      fi
    else
      local pr_count_display
      pr_count_display=$(format_zero_as_blank "$pr_count")
      if [[ "$include_remote_rows" == true ]]; then
        append_report_row "$branch_display" "remote" "" "$repo_status" "" "" "" "$pr_count_display" "$created_date" "$last_commit_date"
      fi
    fi

  if [[ "$VERBOSE" == true ]]; then
    echo "  Status: $repo_status"
    echo "  Staged: $staged_count"
    echo "  Unstaged: $unstaged_count"
    echo "  Unpushed: $unpushed_count"
    echo "  Pending PRs: $pr_count"
  fi

}

check_remote_branch_status() {
  local branch="$1"
  local report_file="$2"

  if [[ "$INVALID_ONLY" == true ]] && ! branch_violates_naming_rules "$branch"; then
    return 0
  fi

  local branch_display
  branch_display=$(branch_name_display "$branch")
  if branch_violates_naming_rules "$branch"; then
    INVALID_BRANCHES_FOUND=$((INVALID_BRANCHES_FOUND + 1))
  fi

  # Get PR status and last commit
  local pr_count created_date last_commit_date
  pr_count=$(get_pending_pr_count "$branch") || pr_count="N/A"
  created_date=$(get_branch_created_date "$branch" "remote")
  last_commit_date=$(get_branch_last_commit_date "$branch" "remote")
  [[ -z "$created_date" ]] && created_date="unknown"
  [[ -z "$last_commit_date" ]] && last_commit_date="unknown"

  # Build and print compact status line
  local tags=("[remote]")
  [[ "$pr_count" =~ ^[0-9]+$ && "$pr_count" -gt 0 ]] && tags+=("[PRs: $pr_count]")
  printf '%s %s\n' "$branch_display" "${tags[*]}"

  local pr_count_display
  pr_count_display=$(format_zero_as_blank "$pr_count")
  append_report_row "$branch_display" "remote" "" "synced" "" "" "" "$pr_count_display" "$created_date" "$last_commit_date"

  if [[ "$VERBOSE" == true ]]; then
    echo "  Last Commit: $last_commit_date"
    echo "  Pending PRs: $pr_count"
  fi
}


# Check for help first — if specified, ignore all other arguments
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    usage
    exit 0
  fi
done

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -a)
      ALL_BRANCHES=true
      shift
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    -i)
      INVALID_ONLY=true
      shift
      ;;
    -l)
      INCLUDE_LOCAL_FLAG=true
      shift
      ;;
    -r)
      INCLUDE_REMOTE_FLAG=true
      shift
      ;;
    -x)
      shift
      if [[ $# -eq 0 ]]; then
        usage_error "Missing PATTERN for -x"
      fi
      EXCLUDE_PATTERN="$1"
      shift
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      if [[ -n "$TARGET_BRANCH" || -n "$BRANCH_PATTERN" ]]; then
        printf 'Error: Unexpected argument: %q\n' "$1" >&2
        printf 'Multiple positional arguments received — pattern was likely expanded by the shell.\n' >&2
        printf 'Quote the pattern to prevent expansion, e.g.: lsbranch "*"\n' >&2
        exit 1
      fi
      if [[ "$1" =~ [\*\?\[] ]]; then
        BRANCH_PATTERN="$1"
      else
        TARGET_BRANCH="$1"
      fi
      shift
      ;;
  esac
done

# If -a specified, set pattern to match all branches
if $ALL_BRANCHES; then
  if [[ -n "$TARGET_BRANCH" ]]; then
    usage_error "Cannot combine BRANCH with -a"
  fi
  BRANCH_PATTERN="*"
fi

if [[ -n "$TARGET_BRANCH" && ( "$INVALID_ONLY" == true || -n "$EXCLUDE_PATTERN" || "$INCLUDE_LOCAL_FLAG" == true || "$INCLUDE_REMOTE_FLAG" == true ) ]]; then
  usage_error "When BRANCH is specified, only -v is allowed"
fi

if [[ -n "$EXCLUDE_PATTERN" && -z "$BRANCH_PATTERN" ]]; then
  usage_error "Option -x requires -a or PATTERN"
fi

if [[ "$INVALID_ONLY" == true && -z "$BRANCH_PATTERN" ]]; then
  usage_error "Option -i requires -a or PATTERN"
fi

# Determine what to include based on flags
# If neither flag specified, default to both; if at least one flag specified, use the flags
if ! $INCLUDE_LOCAL_FLAG && ! $INCLUDE_REMOTE_FLAG; then
  # Default: include both
  INCLUDE_LOCAL=true
  INCLUDE_REMOTE=true
else
  # At least one flag specified: use exactly what was specified
  INCLUDE_LOCAL=$INCLUDE_LOCAL_FLAG
  INCLUDE_REMOTE=$INCLUDE_REMOTE_FLAG
fi

# Build the exact command string used to generate this report.
build_report_command

# Validate reports directory and set output path
if [[ ! -d "$repo_root/reports" ]]; then
  bt_error_exit 3 "Reports directory not found: $repo_root/reports"
fi
OUTPUT_FILE="$repo_root/reports/branch-${RUN_TS_FILE}.md"

# Get current branch to restore later
ORIGINAL_BRANCH=$(bt_get_current_branch || bt_error_exit 2 "Failed to determine current branch")

# Determine branches to check
if [[ -n "$TARGET_BRANCH" ]]; then
  if ! has_local_branch "$TARGET_BRANCH" && ! has_remote_branch "$TARGET_BRANCH"; then
    bt_error_exit 5 "Branch does not exist: $TARGET_BRANCH"
  fi

  BRANCHES_TO_CHECK=""
  REMOTE_BRANCHES_TO_CHECK=""
  REMOTE_ONLY=""

  if has_local_branch "$TARGET_BRANCH"; then
    BRANCHES_TO_CHECK="$TARGET_BRANCH"
  fi
  if has_remote_branch "$TARGET_BRANCH"; then
    REMOTE_BRANCHES_TO_CHECK="$TARGET_BRANCH"
    if ! has_local_branch "$TARGET_BRANCH"; then
      REMOTE_ONLY="$TARGET_BRANCH"
    fi
  fi
elif [[ -z "$BRANCH_PATTERN" ]]; then
  # Default scope is current branch; remote scope is current tracked branch, if any.
  if ! has_local_branch "$ORIGINAL_BRANCH"; then
    bt_error_exit 5 "Current branch does not exist: $ORIGINAL_BRANCH"
  fi

  BRANCHES_TO_CHECK="$ORIGINAL_BRANCH"
  if has_remote_branch "$ORIGINAL_BRANCH"; then
    REMOTE_BRANCHES_TO_CHECK="$ORIGINAL_BRANCH"
  else
    REMOTE_BRANCHES_TO_CHECK=""
  fi
  REMOTE_ONLY=""
else
  # Check branches matching pattern
  local_branches=$(get_local_branches "$BRANCH_PATTERN")
  remote_branches=$(get_remote_branches "$BRANCH_PATTERN")
  remote_only_branches=$(get_remote_only_branches "$BRANCH_PATTERN")

  local_branches=$(apply_exclude_filter "$local_branches" "$EXCLUDE_PATTERN")
  remote_branches=$(apply_exclude_filter "$remote_branches" "$EXCLUDE_PATTERN")
  remote_only_branches=$(apply_exclude_filter "$remote_only_branches" "$EXCLUDE_PATTERN")

  BRANCHES_TO_CHECK="$local_branches"
  REMOTE_BRANCHES_TO_CHECK="$remote_branches"
  REMOTE_ONLY="$remote_only_branches"

  if [[ "$INCLUDE_LOCAL" == true && "$INCLUDE_REMOTE" == false && -z "$BRANCHES_TO_CHECK" ]]; then
    bt_warn "No branches found matching pattern: $BRANCH_PATTERN"
  elif [[ "$INCLUDE_REMOTE" == true && "$INCLUDE_LOCAL" == false && -z "$REMOTE_BRANCHES_TO_CHECK" ]]; then
    bt_warn "No branches found matching pattern: $BRANCH_PATTERN"
  elif [[ "$INCLUDE_REMOTE" == true && "$INCLUDE_LOCAL" == true && -z "$BRANCHES_TO_CHECK" && -z "$REMOTE_BRANCHES_TO_CHECK" ]]; then
    bt_warn "No branches found matching pattern: $BRANCH_PATTERN"
  fi
fi

# Generate report header
generate_report_header

# Check local branches only when local inclusion is enabled.
if [[ "$INCLUDE_LOCAL" == true ]]; then
  local_to_check=""
  if [[ -z "$BRANCH_PATTERN" ]]; then
    local_to_check="$BRANCHES_TO_CHECK"
  else
    local_to_check="$BRANCHES_TO_CHECK"
  fi
  
  if [[ -n "$local_to_check" ]]; then
    while IFS= read -r branch; do
      if [[ -n "$branch" ]]; then
        _is_current=false
        [[ "$branch" == "$ORIGINAL_BRANCH" ]] && _is_current=true
        check_branch_status "$branch" "$OUTPUT_FILE" "$_is_current" "$INCLUDE_LOCAL" "$INCLUDE_REMOTE" || true
      fi
    done <<< "$local_to_check"
  fi
fi

# Check remote-only branches if enabled
if [[ "$INCLUDE_REMOTE" == true ]]; then
  remote_to_check=""
  if [[ "$INCLUDE_LOCAL" == true ]]; then
    remote_to_check="$REMOTE_ONLY"
  else
    remote_to_check="$REMOTE_BRANCHES_TO_CHECK"
  fi

  if [[ -n "$remote_to_check" ]]; then
    while IFS= read -r branch; do
      if [[ -n "$branch" ]]; then
        check_remote_branch_status "$branch" "$OUTPUT_FILE" || true
      fi
    done <<< "$remote_to_check"
  fi
fi

# Return to original branch
if ! git checkout "$ORIGINAL_BRANCH" >/dev/null 2>&1; then
  bt_warn "Failed to return to original branch: $ORIGINAL_BRANCH"
fi

# Append summary footer if any branches failed
if [[ "$BRANCH_ERRORS" -gt 0 ]]; then
  cat >> "$OUTPUT_FILE" << EOF
---

**Warning:** $BRANCH_ERRORS branch(es) could not be checked out and were skipped.
EOF
fi

cat >> "$OUTPUT_FILE" << 'EOF'

**Branch**: Indicates the branch name. `*` indicates this is the current branch.

`!` after branch name indicates the name violates naming rules.

**Type**: Indicates branch is `local` or `remote`.

**Base**: Base branch reference for the row when applicable (for example,
`remote origin/main` or `local v1.0.0`).

**Status**: `clean` or `dirty` for local worktree state, `synced` or `diverged` for tracked-branch state, or `unknown`.

**Staged/Unstaged**: Counts of staged and unstaged files.

**Unpushed Commits**: Count of local commits pending sync for this branch.

**Ahead/Behind**: Counts of commits this branch is ahead of / behind its tracked branch.

**PR**: Count of pending (not closed) pull requests.

**Created**: Date the branch was created.

**Last Commit**: Date of the last commit on the branch.
EOF

cleanup_old_reports

bt_success "Report generated: ${OUTPUT_FILE#${repo_root}/}"
if [[ "$VERBOSE" == true ]]; then
  echo ""
  bt_info "Report contents:"
  sed 's/^/  /' "$OUTPUT_FILE"
fi

if [[ "$BRANCH_ERRORS" -gt 0 ]]; then
  exit 2
fi

if [[ "$INVALID_ONLY" == true && "$INVALID_BRANCHES_FOUND" -gt 0 ]]; then
  exit 4
fi
exit 0
