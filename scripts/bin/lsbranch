#!/usr/bin/env bash

# lsbranch - List branches organized by type with optional filtering.
#
# See usage below for details, or run: lsbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

usage() {
  cat <<'EOF'
Usage:
  lsbranch [OPTIONS] [TYPE]
  lsbranch -h | --help

List branches by branch-group naming model with optional filtering and formatting.

Arguments:
  TYPE               Filter by branch group: version or nonversion
                     If not specified, lists all branches grouped by branch group

Options:
  -h, --help         Output this help to stdout and exit.
  -r                 Show remote branches instead of local branches.
  -a                 Show both local and remote branches (with source labels).
  -s                 Show summary view: counts instead of full branch lists.
  -b PAT             Filter branches by glob pattern on branch name
                     Supports *, ?, [abc], etc.
                     If pattern contains no wildcards, it's auto-wrapped as *PAT*
                     Examples: -b bug (same as -b "*bug*"), -b "fix*", -b "*issue"
  -x PAT             Exclude branches matching glob pattern (inverse of -b)
                     Examples: -x bug (exclude branches with "bug"), -x "hotfix*"
  -c                 Show only branch count (useful for scripts)
  -d                 Show detailed info: commit hash, author, date
  -n NUM             Limit results to first NUM branches
  -f FMT             Output format: table (default), json, csv
  -ri                Include a line with remote metadata
                     Shows remote name and default branch
  -S FIELD           Sort by: name, type, or date
                     name = alphabetical, type = grouped, date = newest first
                     Default: type
  -I                 Show only branches that violate naming rules
  -T                 Exit with code 4 when any invalid branch names are found

Examples:
  # List all local branches grouped by branch group
  lsbranch

  # List only version branches
  lsbranch version

  # List remote branches
  lsbranch -r

  # List all local+remote branches with source labels
  lsbranch -a
  lsbranch -a -d -S date

  # Filter branches by name pattern
  lsbranch -b bug              # branches containing "bug"
  lsbranch -b "fix*"           # branches starting with "fix"

  # Exclude branches by pattern
  lsbranch -x bug              # branches NOT containing "bug"
  lsbranch -x "hotfix*"        # branches NOT starting with "hotfix"

  # Show summary
  lsbranch -s                  # summary of all branches
  lsbranch -s version          # summary of version branches
  lsbranch -s -b fix           # summary for branches matching "*fix*"

  # Count only
  lsbranch -c                  # total count
  lsbranch version -c          # count of version branches
  lsbranch -c -b login         # count for branches matching "*login*"
  lsbranch -x test -c          # count excluding "*test*"

  # Detailed information
  lsbranch -d                  # show commit hash, author, date
  lsbranch version -d          # detailed version branches
  lsbranch -d -x hotfix        # detailed list excluding "*hotfix*"

  # Limit results
  lsbranch -n 5                # show first 5 branches
  lsbranch -n 10 -b api        # first 10 branches matching "*api*"

  # Different sorting
  lsbranch -S name             # alphabetical by branch name
  lsbranch -S date             # by date (newest first)
  lsbranch -S type             # by type (default)

  # Output formats
  lsbranch -f json             # JSON output
  lsbranch -f csv              # CSV format
  lsbranch version -f csv      # CSV of version branches

  # Validation
  lsbranch -I                  # show only invalid branch names
  lsbranch -T                  # exit 4 if invalid branch names are found
  lsbranch -I -T

  # Combine options
  lsbranch -s -r -b memory     # remote summary for "*memory*" matches
  lsbranch -d -n 5 version     # first 5 detailed version branches
  lsbranch -f json -x api      # JSON for branches not matching "*api*"


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented output locations.

Exit codes:
  0   Success
  1   Invalid arguments or options
  2   Invalid type specified
  3   No matching branches found
  4   Invalid branch names found (strict mode)
EOF
}

# High-Level Flow:
# - Lists local/remote branches grouped by branch type conventions.
# - Supports filtering, formatting, and status decoration for quick branch
#   inspection.
# - Reports branch names and workflow state before branch operations.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Branch groups aligned with mkbranch naming model
VALID_TYPES=("version" "nonversion")

# Default behavior
FILTER_TYPE=""
FILTER_NAME=""
FILTER_EXCEPT=false
SHOW_REMOTE=false
SUMMARY_MODE=false
COUNT_ONLY=false
DETAILED_MODE=false
SORT_BY="type"
OUTPUT_FORMAT="table"
LIMIT_RESULTS=0
INVALID_ONLY=false
STRICT_MODE=false
INVALID_FOUND=false
SHOW_REMOTE_INFO=false
REMOTE_NAME="origin"
INVALID_NAME_LABEL="invalid name"


# Script flow summary:
# 1) Parse and validate CLI options.
# 2) Build branch records from local/remote refs with optional filters.
# 3) Render output in table/json/csv formats and enforce strict-mode exit rules.

error_exit() {
  local code="$1"
  local message="$2"
  local usage_hint=' For usage, enter lsbranch -h.'
  local punctuated_message="$message"

  if [[ ! "$punctuated_message" =~ [.!?]$ ]]; then
    punctuated_message+="."
  fi

  if [[ "$code" -eq 1 || "$code" -eq 2 ]]; then
    echo "Error: $punctuated_message$usage_hint" >&2
  else
    echo "Error: $punctuated_message" >&2
  fi
  exit "$code"
}

normalize_filter() {
  local pattern="$1"
  if [[ "$pattern" =~ [\*\?\[] ]]; then
    echo "$pattern"
  else
    echo "*${pattern}*"
  fi
}

matches_filter() {
  local branch="$1"
  local pattern="$2"
  [[ "$branch" == $pattern ]]
}

apply_filter() {
  local branch="$1"
  local pattern="$2"
  local except="$3"

  if [[ -z "$pattern" ]]; then
    return 0
  fi

  if matches_filter "$branch" "$pattern"; then
    [[ "$except" == true ]] && return 1 || return 0
  else
    [[ "$except" == true ]] && return 0 || return 1
  fi
}

get_branch_date() {
  local branch="$1"
  local is_remote="$2"
  local ref
  ref=$(branch_ref "$branch" "$is_remote")
  git log -1 --format=%ai "$ref" 2>/dev/null || echo "unknown"
}

get_branch_info() {
  local branch="$1"
  local is_remote="$2"
  local ref
  ref=$(branch_ref "$branch" "$is_remote")

  local hash
  hash=$(git rev-parse --short "$ref" 2>/dev/null || echo "unknown")
  local author
  author=$(git log -1 --format=%an "$ref" 2>/dev/null || echo "unknown")
  local date
  date=$(git log -1 --format=%ar "$ref" 2>/dev/null || echo "unknown")

  echo "$hash|$author|$date"
}

branch_ref() {
  local branch="$1"
  local is_remote="$2"

  if [[ "$is_remote" == true ]]; then
    echo "${REMOTE_NAME}/$branch"
  else
    echo "$branch"
  fi
}

is_version_branch() {
  local branch="$1"
  [[ "$branch" =~ ^v([1-9][0-9]?)\.([0-9]|[1-9][0-9]?)\.([0-9]|[1-9][0-9]?)$ ]]
}

is_nonversion_branch() {
  local branch="$1"
  [[ "$branch" != *.* ]]
}

get_branch_status() {
  local branch="$1"

  if [[ "$branch" == "main" ]]; then
    echo "skip"
    return 0
  fi

  if is_version_branch "$branch" || is_nonversion_branch "$branch"; then
    echo "valid"
  else
    echo "invalid"
  fi
}

status_label_for_branch() {
  local branch="$1"

  if [[ "$(get_branch_status "$branch")" == "invalid" ]]; then
    echo "$INVALID_NAME_LABEL"
  else
    echo ""
  fi
}

branch_matches_type() {
  local type="$1"
  local branch="$2"

  if [[ "$branch" == "main" ]]; then
    return 1
  fi

  case "$type" in
    version)
      is_version_branch "$branch"
      ;;
    nonversion)
      [[ ! "$branch" =~ \. ]] && ! is_version_branch "$branch"
      ;;
    *)
      return 1
      ;;
  esac
}

list_by_type_local() {
  local type="$1"
  local branches=""

  while IFS= read -r branch; do
    if branch_matches_type "$type" "$branch"; then
      branches+="$branch"$'\n'
    fi
  done < <(git branch --format='%(refname:short)')
  branches="${branches%$'\n'}"

  [[ -z "$branches" ]] && return 1
  echo "$branches"
}

list_by_type_remote() {
  local type="$1"
  local branches=""

  while IFS= read -r branch; do
    if branch_matches_type "$type" "$branch"; then
      branches+="$branch"$'\n'
    fi
  done < <(list_all_remote)
  branches="${branches%$'\n'}"

  [[ -z "$branches" ]] && return 1
  echo "$branches"
}

list_all_local() {
  git branch --format='%(refname:short)'
}

list_all_remote() {
  git branch -r --format='%(refname:short)' \
    | sed -n "s#^${REMOTE_NAME}/##p" \
    | grep -v '^HEAD$' || true
}

get_remote_default_branch() {
  local remote="$1"
  local ref

  ref=$(git symbolic-ref --short "refs/remotes/${remote}/HEAD" 2>/dev/null || true)
  if [[ -n "$ref" ]]; then
    echo "${ref#${remote}/}"
  else
    echo "unknown"
  fi
}

print_remote_info_line() {
  local default_branch
  default_branch=$(get_remote_default_branch "$REMOTE_NAME")
  echo "Remote: ${REMOTE_NAME} (default: ${default_branch})"
}

filter_branches() {
  local branches="$1"
  local pattern="$2"
  local except="$3"
  local filtered=""

  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    if apply_filter "$branch" "$pattern" "$except"; then
      filtered+="$branch"$'\n'
    fi
  done <<< "$branches"

  echo "${filtered%$'\n'}"
}

filter_invalid_only() {
  local branches="$1"
  local filtered=""

  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    if [[ -n "$(status_label_for_branch "$branch")" ]]; then
      filtered+="$branch"$'\n'
    fi
  done <<< "$branches"

  echo "${filtered%$'\n'}"
}

# record format: source|branch
# source: local|remote
sort_records() {
  local records="$1"
  local sort_by="$2"

  case "$sort_by" in
    name)
      echo "$records" | sort -t'|' -k2,2 -k1,1
      ;;
    date)
      while IFS= read -r rec; do
        [[ -z "$rec" ]] && continue
        local src="${rec%%|*}"
        local br="${rec#*|}"
        local is_remote=false
        [[ "$src" == "remote" ]] && is_remote=true
        local date
        date=$(get_branch_date "$br" "$is_remote")
        echo "$date|$src|$br"
      done <<< "$records" | sort -rV | cut -d'|' -f2-
      ;;
    type)
      {
        for type in "${VALID_TYPES[@]}"; do
          while IFS= read -r rec; do
            [[ -z "$rec" ]] && continue
            local br="${rec#*|}"
            if branch_matches_type "$type" "$br"; then
              echo "$rec"
            fi
          done <<< "$records" | sort -t'|' -k2,2 -k1,1
        done

        while IFS= read -r rec; do
          [[ -z "$rec" ]] && continue
          local br="${rec#*|}"
          if [[ "$(get_branch_status "$br")" == "skip" ]]; then
            echo "$rec"
          fi
        done <<< "$records" | sort -t'|' -k2,2 -k1,1

        while IFS= read -r rec; do
          [[ -z "$rec" ]] && continue
          local br="${rec#*|}"
          if [[ "$(get_branch_status "$br")" == "invalid" ]]; then
            echo "$rec"
          fi
        done <<< "$records" | sort -t'|' -k2,2 -k1,1
      } | awk '!seen[$0]++'
      ;;
    *)
      echo "$records"
      ;;
  esac
}

limit_records() {
  local records="$1"
  local limit="$2"
  if [[ $limit -le 0 ]]; then
    echo "$records"
  else
    echo "$records" | head -n "$limit"
  fi
}

get_current_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null || echo ""
}

compute_invalid_found_from_records() {
  local records="$1"
  local found=false

  while IFS= read -r rec; do
    [[ -z "$rec" ]] && continue
    local br="${rec#*|}"
    if [[ "$(get_branch_status "$br")" == "invalid" ]]; then
      found=true
      break
    fi
  done <<< "$records"

  if [[ "$found" == true ]]; then
    INVALID_FOUND=true
  fi

  return 0
}

build_records() {
  local source="$1"    # local|remote
  local branches="$2"
  local records=""

  while IFS= read -r br; do
    [[ -z "$br" ]] && continue
    records+="${source}|${br}"$'\n'
  done <<< "$branches"

  echo "${records%$'\n'}"
}

merge_records() {
  local a="$1"
  local b="$2"

  if [[ -n "$a" && -n "$b" ]]; then
    echo "$a"$'\n'"$b"
  elif [[ -n "$a" ]]; then
    echo "$a"
  else
    echo "$b"
  fi
}

build_strict_scope_records() {
  local local_branches=""
  local remote_branches=""
  local local_records=""
  local remote_records=""

  if [[ "$SHOW_REMOTE" == "both" ]]; then
    local_branches="$(list_all_local)"
    remote_branches="$(list_all_remote)"
    [[ -n "$FILTER_NAME" ]] && local_branches="$(filter_branches "$local_branches" "$FILTER_NAME" "$FILTER_EXCEPT")"
    [[ -n "$FILTER_NAME" ]] && remote_branches="$(filter_branches "$remote_branches" "$FILTER_NAME" "$FILTER_EXCEPT")"
    local_records="$(build_records "local" "$local_branches")"
    remote_records="$(build_records "remote" "$remote_branches")"
    merge_records "$local_records" "$remote_records"
  elif [[ "$SHOW_REMOTE" == true ]]; then
    remote_branches="$(list_all_remote)"
    [[ -n "$FILTER_NAME" ]] && remote_branches="$(filter_branches "$remote_branches" "$FILTER_NAME" "$FILTER_EXCEPT")"
    build_records "remote" "$remote_branches"
  else
    local_branches="$(list_all_local)"
    [[ -n "$FILTER_NAME" ]] && local_branches="$(filter_branches "$local_branches" "$FILTER_NAME" "$FILTER_EXCEPT")"
    build_records "local" "$local_branches"
  fi
}

format_json_records() {
  local records="$1"

  echo "{"
  echo '  "branches": ['

  local first=true
  while IFS= read -r rec; do
    [[ -z "$rec" ]] && continue
    local src="${rec%%|*}"
    local br="${rec#*|}"
    local is_remote=false
    [[ "$src" == "remote" ]] && is_remote=true

    [[ "$first" == false ]] && echo ","
    first=false

    local display_status
    display_status=$(status_label_for_branch "$br")

    echo -n "    {"
    echo -n "\"name\": \"$br\""
    echo -n ", \"source\": \"$src\""
    if [[ -n "$display_status" ]]; then
      echo -n ", \"status\": \"$display_status\""
    fi

    if [[ "$DETAILED_MODE" == true ]]; then
      local info
      info=$(get_branch_info "$br" "$is_remote")
      local hash author date
      hash=$(echo "$info" | cut -d'|' -f1)
      author=$(echo "$info" | cut -d'|' -f2)
      date=$(echo "$info" | cut -d'|' -f3)

      echo -n ", \"hash\": \"$hash\""
      echo -n ", \"author\": \"$author\""
      echo -n ", \"date\": \"$date\""
    fi
    echo -n "}"
  done <<< "$records"

  echo ""
  echo "  ]"
  echo "}"
}

format_csv_records() {
  local records="$1"

  if [[ "$DETAILED_MODE" == true ]]; then
    echo "source,branch,status,hash,author,date"
    while IFS= read -r rec; do
      [[ -z "$rec" ]] && continue
      local src="${rec%%|*}"
      local br="${rec#*|}"
      local is_remote=false
      [[ "$src" == "remote" ]] && is_remote=true
      local display_status
      display_status=$(status_label_for_branch "$br")
      local info
      info=$(get_branch_info "$br" "$is_remote")
      local hash author date
      hash=$(echo "$info" | cut -d'|' -f1)
      author=$(echo "$info" | cut -d'|' -f2)
      date=$(echo "$info" | cut -d'|' -f3)
      echo "$src,$br,$display_status,$hash,$author,$date"
    done <<< "$records"
  else
    echo "source,branch,status"
    while IFS= read -r rec; do
      [[ -z "$rec" ]] && continue
      local src="${rec%%|*}"
      local br="${rec#*|}"
      local display_status
      display_status=$(status_label_for_branch "$br")
      echo "$src,$br,$display_status"
    done <<< "$records"
  fi
}

format_table_records() {
  local records="$1"
  local current
  current=$(get_current_branch)

  if [[ "$DETAILED_MODE" == true ]]; then
    printf "%-8s %-35s %-10s %-8s %-20s %s\n" "Source" "Branch" "Status" "Hash" "Author" "Date"
    printf "%-8s %-35s %-10s %-8s %-20s %s\n" "--------" "-----------------------------------" "----------" "--------" "--------------------" "-------------------"

    while IFS= read -r rec; do
      [[ -z "$rec" ]] && continue
      local src="${rec%%|*}"
      local br="${rec#*|}"
      local is_remote=false
      [[ "$src" == "remote" ]] && is_remote=true

      local info
      info=$(get_branch_info "$br" "$is_remote")
      local hash author date
      hash=$(echo "$info" | cut -d'|' -f1)
      author=$(echo "$info" | cut -d'|' -f2)
      date=$(echo "$info" | cut -d'|' -f3)
      local display_status
      display_status=$(status_label_for_branch "$br")

      local branch_display="$br"
      if [[ "$src" == "local" && "$br" == "$current" ]]; then
        branch_display+=" [current]"
      fi

      printf "%-8s %-35s %-10s %-8s %-20s %s\n" "$src" "$branch_display" "$display_status" "$hash" "$author" "$date"
    done <<< "$records"
  else
    while IFS= read -r rec; do
      [[ -z "$rec" ]] && continue
      local src="${rec%%|*}"
      local br="${rec#*|}"
      local branch_display="$br"
      if [[ "$src" == "local" && "$br" == "$current" ]]; then
        branch_display+=" [current]"
      fi
      if [[ -n "$(status_label_for_branch "$br")" ]]; then
        echo "[$src] $branch_display [$INVALID_NAME_LABEL]"
      else
        echo "[$src] $branch_display"
      fi
    done <<< "$records"
  fi
}

count_records() {
  local records="$1"
  if [[ -z "$(echo "$records" | sed '/^$/d')" ]]; then
    echo "0"
  else
    echo "$records" | sed '/^$/d' | wc -l
  fi
}

is_valid_type() {
  local type="$1"
  local valid
  for valid in "${VALID_TYPES[@]}"; do
    [[ "$type" == "$valid" ]] && return 0
  done
  return 1
}

count_statuses_records() {
  local records="$1"
  local valid=0 invalid=0 skipped=0

  while IFS= read -r rec; do
    [[ -z "$rec" ]] && continue
    local br="${rec#*|}"
    case "$(get_branch_status "$br")" in
      valid) ((valid++)) ;;
      invalid) ((invalid++)) ;;
      skip) ((skipped++)) ;;
    esac
  done <<< "$records"

  echo "$valid|$invalid|$skipped"
}

should_refresh_remote() {
  [[ "$SHOW_REMOTE" == true || "$SHOW_REMOTE" == "both" || "$SHOW_REMOTE_INFO" == true ]]
}

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -r)
      SHOW_REMOTE=true
      shift
      ;;
    -a)
      SHOW_REMOTE="both"
      shift
      ;;
    -s)
      SUMMARY_MODE=true
      shift
      ;;
    -c)
      COUNT_ONLY=true
      shift
      ;;
    -d)
      DETAILED_MODE=true
      shift
      ;;
    -b)
      [[ $# -lt 2 ]] && error_exit 1 "Option -b requires a pattern argument"
      FILTER_NAME=$(normalize_filter "$2")
      FILTER_EXCEPT=false
      shift 2
      ;;
    -x)
      [[ $# -lt 2 ]] && error_exit 1 "Option -x requires a pattern argument"
      FILTER_NAME=$(normalize_filter "$2")
      FILTER_EXCEPT=true
      shift 2
      ;;
    -n)
      [[ $# -lt 2 ]] && error_exit 1 "Option -n requires a number argument"
      LIMIT_RESULTS="$2"
      shift 2
      ;;
    -S)
      [[ $# -lt 2 ]] && error_exit 1 "Option -S requires a field argument (name, type, date)"
      SORT_BY="$2"
      shift 2
      ;;
    -f)
      [[ $# -lt 2 ]] && error_exit 1 "Option -f requires a format argument (table, json, csv)"
      OUTPUT_FORMAT="$2"
      shift 2
      ;;
    -ri)
      SHOW_REMOTE_INFO=true
      shift
      ;;
    -I)
      INVALID_ONLY=true
      shift
      ;;
    -T)
      STRICT_MODE=true
      shift
      ;;
    -*)
      error_exit 1 "Unknown option: $1"
      ;;
    *)
      FILTER_TYPE="$1"
      shift
      ;;
  esac
done

# Validate options
if [[ "$SORT_BY" != "name" && "$SORT_BY" != "type" && "$SORT_BY" != "date" ]]; then
  error_exit 1 "Invalid sort field: $SORT_BY (must be name, type, or date)"
fi

if [[ "$OUTPUT_FORMAT" != "table" && "$OUTPUT_FORMAT" != "json" && "$OUTPUT_FORMAT" != "csv" ]]; then
  error_exit 1 "Invalid format: $OUTPUT_FORMAT (must be table, json, or csv)"
fi

if [[ "$LIMIT_RESULTS" != "0" ]] && ! [[ "$LIMIT_RESULTS" =~ ^[0-9]+$ ]]; then
  error_exit 1 "Limit must be a positive number"
fi

if [[ -n "$FILTER_TYPE" ]] && ! is_valid_type "$FILTER_TYPE"; then
  error_exit 2 "Invalid type '$FILTER_TYPE'. Valid types: ${VALID_TYPES[*]}"
fi

if [[ "$SUMMARY_MODE" == true && "$DETAILED_MODE" == true ]]; then
  error_exit 1 "Cannot use -s and -d together"
fi

if [[ "$COUNT_ONLY" == true && "$SUMMARY_MODE" == true ]]; then
  error_exit 1 "Cannot use -c and -s together"
fi

if [[ "$COUNT_ONLY" == true && "$DETAILED_MODE" == true ]]; then
  error_exit 1 "Cannot use -c and -d together"
fi

if [[ "$OUTPUT_FORMAT" != "table" && "$SUMMARY_MODE" == true ]]; then
  error_exit 1 "Cannot use -f with -s"
fi

if [[ "$SHOW_REMOTE_INFO" == true && "$OUTPUT_FORMAT" != "table" ]]; then
  error_exit 1 "-ri is supported only with table output"
fi

if [[ "$SHOW_REMOTE_INFO" == true && "$COUNT_ONLY" == true ]]; then
  error_exit 1 "Cannot use -ri with -c"
fi

cd "$REPO_ROOT"
if should_refresh_remote; then
  git fetch "$REMOTE_NAME" >/dev/null 2>&1 || true
fi

# Build candidate records based on scope/type/filter
local_branches=""
remote_branches=""
local_records=""
remote_records=""

if [[ -n "$FILTER_TYPE" ]]; then
  if [[ "$SHOW_REMOTE" == "both" ]]; then
    local_branches="$(list_by_type_local "$FILTER_TYPE" 2>/dev/null || true)"
    remote_branches="$(list_by_type_remote "$FILTER_TYPE" 2>/dev/null || true)"
  elif [[ "$SHOW_REMOTE" == true ]]; then
    remote_branches="$(list_by_type_remote "$FILTER_TYPE" 2>/dev/null || true)"
  else
    local_branches="$(list_by_type_local "$FILTER_TYPE" 2>/dev/null || true)"
  fi
else
  if [[ "$SHOW_REMOTE" == "both" ]]; then
    local_branches="$(list_all_local)"
    remote_branches="$(list_all_remote)"
  elif [[ "$SHOW_REMOTE" == true ]]; then
    remote_branches="$(list_all_remote)"
  else
    local_branches="$(list_all_local)"
  fi
fi

if [[ -n "$FILTER_NAME" ]]; then
  [[ -n "$local_branches" ]] && local_branches="$(filter_branches "$local_branches" "$FILTER_NAME" "$FILTER_EXCEPT")"
  [[ -n "$remote_branches" ]] && remote_branches="$(filter_branches "$remote_branches" "$FILTER_NAME" "$FILTER_EXCEPT")"
fi

if [[ "$INVALID_ONLY" == true ]]; then
  [[ -n "$local_branches" ]] && local_branches="$(filter_invalid_only "$local_branches")"
  [[ -n "$remote_branches" ]] && remote_branches="$(filter_invalid_only "$remote_branches")"
fi

[[ -n "$local_branches" ]] && local_records="$(build_records "local" "$local_branches")" || local_records=""
[[ -n "$remote_branches" ]] && remote_records="$(build_records "remote" "$remote_branches")" || remote_records=""
records="$(merge_records "$local_records" "$remote_records")"

# Count-only mode
if [[ "$COUNT_ONLY" == true ]]; then
  echo "$(count_records "$records")"
  exit 0
fi

# Summary mode
if [[ "$SUMMARY_MODE" == true ]]; then
  if [[ "$SHOW_REMOTE_INFO" == true ]]; then
    print_remote_info_line
  fi

  if [[ "$SHOW_REMOTE" == "both" ]]; then
    l_stats="$(count_statuses_records "$local_records")"
    r_stats="$(count_statuses_records "$remote_records")"
    l_valid=$(echo "$l_stats" | cut -d'|' -f1)
    l_invalid=$(echo "$l_stats" | cut -d'|' -f2)
    l_skip=$(echo "$l_stats" | cut -d'|' -f3)
    r_valid=$(echo "$r_stats" | cut -d'|' -f1)
    r_invalid=$(echo "$r_stats" | cut -d'|' -f2)
    r_skip=$(echo "$r_stats" | cut -d'|' -f3)

    if [[ -n "$FILTER_TYPE" ]]; then
      echo "Local $FILTER_TYPE branches: $((l_valid + l_invalid + l_skip)) (valid: $l_valid, invalid: $l_invalid, skipped: $l_skip)"
      echo "Remote $FILTER_TYPE branches: $((r_valid + r_invalid + r_skip)) (valid: $r_valid, invalid: $r_invalid, skipped: $r_skip)"
      echo "Total: $((l_valid + l_invalid + l_skip + r_valid + r_invalid + r_skip))"
    else
      echo "Local Branch Summary:"
      echo "  valid: $l_valid"
      echo "  invalid: $l_invalid"
      echo "  skipped: $l_skip"
      echo ""
      echo "Remote Branch Summary:"
      echo "  valid: $r_valid"
      echo "  invalid: $r_invalid"
      echo "  skipped: $r_skip"
    fi
  else
    scope_records="$records"
    s_stats="$(count_statuses_records "$scope_records")"
    s_valid=$(echo "$s_stats" | cut -d'|' -f1)
    s_invalid=$(echo "$s_stats" | cut -d'|' -f2)
    s_skip=$(echo "$s_stats" | cut -d'|' -f3)

    if [[ "$SHOW_REMOTE" == true ]]; then
      if [[ -n "$FILTER_TYPE" ]]; then
        echo "Remote $FILTER_TYPE branches: $((s_valid + s_invalid + s_skip)) (valid: $s_valid, invalid: $s_invalid, skipped: $s_skip)"
      else
        echo "Remote Branch Summary:"
        echo "  valid: $s_valid"
        echo "  invalid: $s_invalid"
        echo "  skipped: $s_skip"
      fi
    else
      if [[ -n "$FILTER_TYPE" ]]; then
        echo "Local $FILTER_TYPE branches: $((s_valid + s_invalid + s_skip)) (valid: $s_valid, invalid: $s_invalid, skipped: $s_skip)"
      else
        echo "Local Branch Summary:"
        echo "  valid: $s_valid"
        echo "  invalid: $s_invalid"
        echo "  skipped: $s_skip"
      fi
    fi
  fi

  if [[ "$STRICT_MODE" == true ]]; then
    strict_records="$(build_strict_scope_records)"
    compute_invalid_found_from_records "$strict_records"
    [[ "$INVALID_FOUND" == true ]] && exit 4
  fi

  exit 0
fi

# Non-summary: ensure we have rows
if [[ -z "$(echo "$records" | sed '/^$/d')" ]]; then
  if [[ "$INVALID_ONLY" == true ]]; then
    exit 0
  fi
  error_exit 3 "No branches found"
fi

# Track invalids in output scope
compute_invalid_found_from_records "$records"

# Sort/limit
records="$(sort_records "$records" "$SORT_BY")"
if [[ $LIMIT_RESULTS -gt 0 ]]; then
  records="$(limit_records "$records" "$LIMIT_RESULTS")"
fi

# Output
if [[ "$SHOW_REMOTE_INFO" == true ]]; then
  print_remote_info_line
fi

case "$OUTPUT_FORMAT" in
  json)
    format_json_records "$records"
    ;;
  csv)
    format_csv_records "$records"
    ;;
  table)
    format_table_records "$records"
    ;;
esac

# Strict mode validates full strict scope (ignores TYPE intentionally)
if [[ "$STRICT_MODE" == true ]]; then
  strict_records="$(build_strict_scope_records)"
  compute_invalid_found_from_records "$strict_records"
  [[ "$INVALID_FOUND" == true ]] && exit 4
fi

exit 0
