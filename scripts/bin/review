#!/usr/bin/env bash

# review - Create or update pull request on GitHub.
#
# See usage below for details, or run: review -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  review [OPTIONS]
  review {-h | --help}

Create a new pull request or update an existing one for the current branch.

The target branch is determined automatically based on the branch's Git history
(the branch that current branch was created from).

Reviewers are automatically extracted from config/contributors.md
(all R/ and A/ entries).

Features:
  - Auto-generates title from branch name
  - Determines target branch from Git history
  - Reads reviewers from config/contributors.md
  - Creates ready-to-review PRs by default
  - Supports draft PRs with --draft flag
  - Updates existing PRs (title, description, labels, reviewers)
  - Marks draft PRs as ready when updated (unless --draft flag used)
  - Optionally opens PR in browser

Options:
  -h, --help           Output this help to stdout and exit (other options
                       and arguments are ignored).
  -t, --title TITLE    PR title (auto-generated from branch name
                       if not specified)
  -d, --description D  PR description
  --draft              Create as draft PR (Work In Progress)
  -l, --labels LABELS  Comma-separated labels (e.g., "bug,urgent")
  -a, --assignees USR  Comma-separated GitHub usernames
  -b, --browser        Open PR in browser after creation/update
  -v, --verbose        Show detailed information
  -- TEXT              Unix-style description
                       (everything after -- is description)
                       Note: No quotes needed, captures all remaining arguments

Examples:
  # Create PR with auto-generated title
  review

  # Create draft PR
  review --draft -t "WIP: New feature"

  # Create PR with labels and open in browser
  review -l "bug,urgent" -b

  # Create PR and add description
  review -d "This PR fixes issue #123 by refactoring the auth module"

  # Unix-style description
  review -- This PR fixes the critical bug

Workflow:
  1. Create PR: review --draft -t "WIP: Feature"
  2. Code review requests changes
  3. Make changes and commit: git add . && git commit -m "Address feedback"
  4. Update PR and mark ready: review


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented
    output locations.

Exit codes:
  0   Success
  1   Argument or validation error
  2   Git operation failed
  3   Cannot create PR from main branch
  4   GitHub API error
  5   Configuration error (missing contributors.md or no approvers)
EOF
}

# High-Level Flow:
# - Creates or updates a GitHub pull request using branch/workflow metadata.
# - Validates branch context and required PR fields before submission.
# - Integrates with gh CLI and reports resulting PR identifiers/links.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/github_helpers.sh
source "$SCRIPT_DIR/../helpers/github_helpers.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"

# Propagate repository history from remote if available
bt_propagate_repository_history >/dev/null 2>&1

# Default options
DRAFT=false
VERBOSE=false
CUSTOM_TITLE=""
CUSTOM_DESCRIPTION=""
LABELS=""
ASSIGNEES=""
OPEN_BROWSER=false
PROMPT_BROWSER=true


get_target_branch() {
  local current_branch="$1"
  
  # Cannot create PR from main
  if [[ "$current_branch" == "main" ]]; then
    bt_error_exit 3 "Cannot create PR from main branch"
  fi
  
  local target_branch
  target_branch=$(bt_resolve_target_branch_from_fork_point \
    "$current_branch" "main") || {
    bt_error_exit 2 "Failed to determine target branch"
  }

  echo "$target_branch"
}

generate_title_from_branch() {
  local branch="$1"
  
  # Extract the part after the last slash
  local title="${branch##*/}"
  
  # Replace hyphens and underscores with spaces
  title="${title//-/ }"
  title="${title//_/ }"
  
  # Capitalize first letter of each word
  title=$(echo "$title" | sed 's/\b\(.\)/\u\1/g')
  
  echo "$title"
}

get_existing_pr_number() {
  local branch="$1"

  bt_gh_find_pr_number_for_branch "$branch" "all"
}

get_pr_draft_status() {
  local pr_number="$1"
  
  # Check if PR is draft
  gh pr view "$pr_number" --json isDraft --jq '.isDraft' 2>/dev/null \
    || echo "false"
}

extract_reviewers_from_config() {
  local config_file="config/contributors.md"
  
  if [[ ! -f "$config_file" ]]; then
    bt_error_exit 5 "Configuration file not found: $config_file"
  fi
  
  # Extract all R/ and A/ entries, format: [R/]name or [A/]name
  # Pattern: - [R/]name, email or - [A/]name, email
  local reviewers
  reviewers=$(grep -E '^\s*-\s+[RA]/' "$config_file" | \
    sed -E 's/^\s*-\s+[RA]\/([^,]+).*/\1/' | \
    tr '\n' ',' | sed 's/,$//')
  
  if [[ -z "$reviewers" ]]; then
    bt_error_exit 5 "No reviewers or approvers found in $config_file" \
      "(need at least one A/ entry)"
  fi
  
  echo "$reviewers"
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -t | --title)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -t requires a title argument"
      fi
      CUSTOM_TITLE="$2"
      shift 2
      ;;
    -d | --description)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -d requires a description argument"
      fi
      if [[ -n "$CUSTOM_DESCRIPTION" ]]; then
        bt_error_exit 1 "Cannot use both -d and -- for description"
      fi
      CUSTOM_DESCRIPTION="$2"
      shift 2
      ;;
    --draft)
      DRAFT=true
      shift
      ;;
    -l | --labels)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -l requires labels argument"
      fi
      LABELS="$2"
      shift 2
      ;;
    -a | --assignees)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -a requires assignees argument"
      fi
      ASSIGNEES="$2"
      shift 2
      ;;
    -b | --browser)
      OPEN_BROWSER=true
      PROMPT_BROWSER=false
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    --)
      # Unix-style description: everything after -- is the description
      shift
      if [[ -n "$CUSTOM_DESCRIPTION" ]]; then
        bt_error_exit 1 "Cannot use both -d and -- for description"
      fi
      CUSTOM_DESCRIPTION="$*"
      break
      ;;
    -*)
      bt_error_exit 1 "Unknown option: $1"
      ;;
    *)
      bt_error_exit 1 "Unknown argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit 2 "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

# Determine target branch
bt_info "Determining target branch..."
TARGET_BRANCH=$(get_target_branch "$CURRENT_BRANCH")
bt_info "Target branch: $TARGET_BRANCH"

# Extract reviewers from config
bt_info "Reading reviewers from config/contributors.md..."
REVIEWERS=$(extract_reviewers_from_config)
bt_info "Reviewers: $REVIEWERS"

# Determine title
if [[ -z "$CUSTOM_TITLE" ]]; then
  TITLE=$(generate_title_from_branch "$CURRENT_BRANCH")
  bt_info "Generated title: $TITLE"
else
  TITLE="$CUSTOM_TITLE"
  bt_info "Title: $TITLE"
fi

# Check for existing PR
EXISTING_PR=$(get_existing_pr_number "$CURRENT_BRANCH")

if [[ -n "$EXISTING_PR" ]]; then
  # Update existing PR
  bt_info "Updating existing PR #$EXISTING_PR..."
  
  # Update title
  gh pr edit "$EXISTING_PR" --title "$TITLE" 2>&1 || \
    bt_error_exit 4 "Failed to update PR title"
  
  # Update description if provided
  if [[ -n "$CUSTOM_DESCRIPTION" ]]; then
    gh pr edit "$EXISTING_PR" --body "$CUSTOM_DESCRIPTION" 2>&1 || \
      bt_error_exit 4 "Failed to update PR description"
  fi
  
  # Update labels if provided
  if [[ -n "$LABELS" ]]; then
    gh pr edit "$EXISTING_PR" --add-label "$LABELS" 2>&1 || \
      bt_error_exit 4 "Failed to add labels"
  fi
  
  # Update assignees if provided
  if [[ -n "$ASSIGNEES" ]]; then
    gh pr edit "$EXISTING_PR" --add-assignee "$ASSIGNEES" 2>&1 || \
      bt_error_exit 4 "Failed to add assignees"
  fi
  
  # Update reviewers from config
  gh pr edit "$EXISTING_PR" --add-reviewer "$REVIEWERS" 2>&1 || \
    bt_error_exit 4 "Failed to add reviewers"
  
  # Check if PR is draft and mark ready if not using --draft flag
  CURRENT_DRAFT_STATUS=$(get_pr_draft_status "$EXISTING_PR")
  if [[ "$CURRENT_DRAFT_STATUS" == "true" ]] && [[ "$DRAFT" == false ]]; then
    bt_info "Marking PR as ready for review..."
    gh pr ready "$EXISTING_PR" 2>&1 || \
      bt_error_exit 4 "Failed to mark PR as ready"
  fi
  
  bt_success "PR #$EXISTING_PR updated"
  
else
  # Create new PR
  bt_info "Creating new PR..."
  
  # Build gh pr create command
  create_cmd="gh pr create --base $TARGET_BRANCH"
  create_cmd="$create_cmd --head $CURRENT_BRANCH --title '$TITLE'"
  
  if [[ -n "$CUSTOM_DESCRIPTION" ]]; then
    create_cmd="$create_cmd --body '$CUSTOM_DESCRIPTION'"
  fi
  
  if [[ "$DRAFT" == true ]]; then
    create_cmd="$create_cmd --draft"
  fi
  
  if [[ -n "$LABELS" ]]; then
    create_cmd="$create_cmd --label '$LABELS'"
  fi
  
  if [[ -n "$ASSIGNEES" ]]; then
    create_cmd="$create_cmd --assignee '$ASSIGNEES'"
  fi
  
  # Always add reviewers from config
  create_cmd="$create_cmd --reviewer '$REVIEWERS'"
  
  # Execute command and capture PR number
  pr_url=""
  pr_url=$(eval "$create_cmd" 2>&1) || bt_error_exit 4 "Failed to create PR"
  
  # Extract PR number from URL
  EXISTING_PR=$(echo "$pr_url" | grep -oP '#\K[0-9]+' | head -1)
  
  if [[ -z "$EXISTING_PR" ]]; then
    bt_error_exit 4 "Failed to extract PR number from response"
  fi
  
  if [[ "$DRAFT" == true ]]; then
    bt_success "Draft PR #$EXISTING_PR created"
  else
    bt_success "PR #$EXISTING_PR created (ready for review)"
  fi
fi

# Show PR details if verbose
if [[ "$VERBOSE" == true ]]; then
  bt_info "PR details:"
  gh pr view "$EXISTING_PR" --json number,title,state,isDraft,url \
    --jq '{number:.number, title:.title, state:.state, draft:.isDraft, \
  url:.url}' | \
    sed 's/^/  /'
fi

# Prompt to open in browser if not already decided
if [[ "$PROMPT_BROWSER" == true ]]; then
  echo -n "Open PR in browser? (y/n): "
  read -r response
  if [[ "$response" =~ ^[Yy]$ ]]; then
    OPEN_BROWSER=true
  fi
fi

# Open in browser if requested
if [[ "$OPEN_BROWSER" == true ]]; then
  gh pr view "$EXISTING_PR" --web 2>&1 || bt_warn "Failed to open PR in browser"
fi

bt_success "Done"
exit 0
