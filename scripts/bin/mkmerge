#!/usr/bin/env bash

# mkmerge - Merge current branch to its base branch with approval tracking.
#
# See usage below for details, or run: mkmerge -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

# Summary of script behavior:
# - Merges the current branch into its base branch with pre-merge safety
#   validations.
# - Applies workflow policy checks and optional history logging around the merge
#   action.
# - Reports merge outcomes and next-step guidance.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/github_helpers.sh
source "$SCRIPT_DIR/../helpers/github_helpers.sh"

# Default options
CUSTOM_MESSAGE=""
VERBOSE=false

usage() {
  cat <<'EOF'
Usage:
  mkmerge [OPTIONS]
  mkmerge -h | --help

Merge the current branch to its base branch using squash merge.

Merging to a protected branch (base is main) requires the current user to be
an approver (A/ entry in config/contributors.md).

Before merging:
  - Verifies current user is an approver (if merging to protected branch)
  - Checks that all status checks and CI/CD pass
  - Uses PR title or custom message as squash commit message
  - Logs merge to logs/remote_branch_history.md

Features:
  - Squash commits into single commit
  - Automatic approval verification for protected branches
  - Status check validation
  - Merge logging to logs/remote_branch_history.md
  - No branch cleanup (branches remain after merge)

Options:
  -h, --help           Output this help to stdout and exit.
  -m, --message MSG    Custom squash commit message (uses PR title if not specified)
  -v, --verbose        Show detailed information

Examples:
  # Merge current branch with PR title as message
  mkmerge

  # Merge with custom message
  mkmerge -m "Custom commit message"

  # Merge with verbose output
  mkmerge -v

Exit codes:
  0   Success
  1   Argument or validation error
  2   Git operation failed
  3   User is not an approver (required for protected branch)
  4   GitHub API error
  5   Configuration error
  6   Status checks not passing
  7   PR not found or invalid state
EOF
}

get_current_user() {
  git config user.name 2>/dev/null || bt_error_exit 2 "Failed to determine current user"
}

get_target_branch() {
  local current_branch="$1"

  local target_branch
  target_branch=$(bt_resolve_target_branch_from_fork_point "$current_branch" "main") || {
    bt_error_exit 2 "Failed to determine target branch"
  }

  echo "$target_branch"
}

is_protected_branch() {
  local target_branch="$1"
  
  # A protected branch is one whose base branch is main
  if [[ "$target_branch" == "main" ]]; then
    return 0
  fi
  return 1
}

is_approver() {
  local config_file="config/contributors.md"
  local user_name="$1"
  
  if [[ ! -f "$config_file" ]]; then
    bt_error_exit 5 "Configuration file not found: $config_file"
  fi
  
  # Check if user is in A/ (Approver) entries
  if grep -E "^\s*-\s+A/${user_name}," "$config_file" > /dev/null 2>&1; then
    return 0
  fi
  return 1
}

get_existing_pr_number() {
  local branch="$1"

  bt_gh_find_pr_number_for_branch "$branch" "open"
}

get_pr_title() {
  local pr_number="$1"
  
  # Get PR title
  gh pr view "$pr_number" --json title --jq '.title' 2>/dev/null || echo ""
}

get_pr_status_check() {
  local pr_number="$1"
  
  # Get PR status check state
  gh pr view "$pr_number" --json statusCheckRollup --jq '.statusCheckRollup[].state' 2>/dev/null | sort | uniq || echo "UNKNOWN"
}

check_status_checks() {
  local pr_number="$1"
  
  bt_info "Checking status checks and CI/CD..."
  
  # Get the status check state
  local status_state
  status_state=$(gh pr view "$pr_number" --json statusCheckRollup --jq '.statusCheckRollup[].state' 2>/dev/null | sort | uniq | head -1)
  
  if [[ -z "$status_state" ]]; then
    # No checks found
    bt_info "No status checks found"
    return 0
  fi
  
  case "$status_state" in
    SUCCESS)
      bt_success "All status checks passed"
      return 0
      ;;
    PENDING)
      bt_error_exit 6 "Status checks still pending"
      ;;
    FAILURE)
      bt_error_exit 6 "Status checks failed"
      ;;
    *)
      bt_error_exit 6 "Unknown status check state: $status_state"
      ;;
  esac
}

log_merge_to_history() {
  local branch="$1"
  local target_branch="$2"
  local approver="$3"
  local message="$4"
  
  local history_file="logs/remote_branch_history.md"
  local timestamp
  timestamp=$(date '+%Y-%m-%d %H:%M:%S')

  mkdir -p "$(dirname "$history_file")"
  
  # Create history file if it doesn't exist
  if [[ ! -f "$history_file" ]]; then
    cat > "$history_file" << 'EOF'
# Branch History

Copyright (c) 2026 Paul Sinclair  
SPDX-License-Identifier: MIT  
For license details, see `LICENSE` in the repository root.

See `README.md` in the root directory for an introduction to the project.

## Merge Log

EOF
  fi
  
  # Append merge entry
  cat >> "$history_file" << EOF
- [$timestamp] [$approver] Merged [$branch] to [$target_branch]: $message
EOF
  
  bt_info "Logged merge to $history_file"
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -m requires a message argument"
      fi
      CUSTOM_MESSAGE="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -*)
      bt_error_exit 1 "Unknown option: $1"
      ;;
    *)
      bt_error_exit 1 "Unknown argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || bt_error_exit 2 "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

# Get current user
CURRENT_USER=$(get_current_user)
bt_info "Current user: $CURRENT_USER"

# Determine target branch
bt_info "Determining target branch..."
TARGET_BRANCH=$(get_target_branch "$CURRENT_BRANCH")
bt_info "Target branch: $TARGET_BRANCH"

# Check if target branch is protected (base is main)
if is_protected_branch "$TARGET_BRANCH"; then
  bt_info "Target branch is protected (base is main)"
  
  # Verify current user is an approver
  if ! is_approver "$CURRENT_USER"; then
    bt_error_exit 3 "User '$CURRENT_USER' is not an approver. Only approvers can merge to protected branches."
  fi
  bt_success "User '$CURRENT_USER' is an approver"
else
  bt_info "Target branch is not protected"
fi

# Find associated PR
PR_NUMBER=$(get_existing_pr_number "$CURRENT_BRANCH")
if [[ -z "$PR_NUMBER" ]]; then
  bt_error_exit 7 "No open PR found for branch '$CURRENT_BRANCH'"
fi
bt_info "Found PR #$PR_NUMBER"

# Check status checks pass
check_status_checks "$PR_NUMBER"

# Determine commit message
if [[ -n "$CUSTOM_MESSAGE" ]]; then
  COMMIT_MESSAGE="$CUSTOM_MESSAGE"
  bt_info "Using custom message: $COMMIT_MESSAGE"
else
  COMMIT_MESSAGE=$(get_pr_title "$PR_NUMBER")
  if [[ -z "$COMMIT_MESSAGE" ]]; then
    bt_error_exit 4 "Failed to get PR title"
  fi
  bt_info "Using PR title as message: $COMMIT_MESSAGE"
fi

# Perform squash merge
bt_info "Performing squash merge..."
git fetch origin 2>/dev/null || bt_warn "Failed to fetch from origin"

merge_cmd="git merge --squash --no-commit origin/$TARGET_BRANCH"
if ! eval "$merge_cmd" 2>&1; then
  bt_error_exit 2 "Failed to squash merge"
fi

# Create commit with message
if ! git commit -m "$COMMIT_MESSAGE" 2>&1; then
  bt_error_exit 2 "Failed to create commit"
fi

# Push to remote
bt_info "Pushing merged branch..."
if ! git push -f origin "$CURRENT_BRANCH" 2>&1; then
  bt_error_exit 2 "Failed to push branch"
fi

# Log merge to history
log_merge_to_history "$CURRENT_BRANCH" "$TARGET_BRANCH" "$CURRENT_USER" "$COMMIT_MESSAGE"

# Show verbose output if requested
if [[ "$VERBOSE" == true ]]; then
  bt_info "Merge details:"
  echo "  Branch: $CURRENT_BRANCH"
  echo "  Target: $TARGET_BRANCH"
  echo "  Approver: $CURRENT_USER"
  echo "  PR: #$PR_NUMBER"
  echo "  Message: $COMMIT_MESSAGE"
fi

bt_success "Branch '$CURRENT_BRANCH' merged to '$TARGET_BRANCH'"
bt_success "Done"
exit 0
