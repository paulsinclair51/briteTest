#!/usr/bin/env bash

# undo - Undo recent commits, merges, or releases.
#
# See usage below for details, or run: undo -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  undo TYPE [OPTIONS]
  undo -h | --help

Undo recent commits, merges, or releases with confirmation.

Arguments:
  TYPE               Type of operation to undo: commit, merge, release

Options:
  -h, --help         Output this help to stdout and exit
  -v, --verbose      Show detailed information

Examples:
  # Undo the last commit
  undo commit

  # Undo the last merge
  undo merge

  # Undo the last release
  undo release

Outputs:
  - Writes status messages to stdout
  - Writes errors to stderr
  - Logs undo operations

Exit codes:
  0  Success
  1  Argument error
  2  Git operation failed
  3  Undo cancelled by user
  5  No operation found to undo
EOF
}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"

# Ensure Git hooks are installed
ensure_hooks_installed

VERBOSE=false
UNDO_TYPE=""

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    commit|merge|release)
      UNDO_TYPE="$1"
      shift
      ;;
    *)
      bt_error_exit 1 "Unknown option or type: $1"
      ;;
  esac
done

if [[ -z "$UNDO_TYPE" ]]; then
  bt_error_exit 1 "TYPE is required (commit, merge, or release)"
fi

cd "$REPO_ROOT"

case "$UNDO_TYPE" in
  commit)
    bt_info "Checking for recent commits..."
    LAST_COMMIT=$(git log --oneline -1 2>/dev/null | head -1)
    if [[ -z "$LAST_COMMIT" ]]; then
      bt_error_exit 5 "No commit to undo"
    fi
    bt_info "Found commit: $LAST_COMMIT"
    read -p "Undo this commit? (y/N): " -r confirm
    if [[ ! $confirm =~ ^[Yy]$ ]]; then
      bt_error_exit 3 "Undo cancelled"
    fi
    
    bt_info "Soft resetting to previous commit..."
    export BRITETEST_BYPASS_HOOKS=true
    if ! git reset --soft HEAD~1 2>&1; then
      unset BRITETEST_BYPASS_HOOKS
      bt_error_exit 2 "Failed to reset commit"
    fi
    unset BRITETEST_BYPASS_HOOKS
    
    bt_success "Commit undone (changes preserved in staging area)"
    if [[ "$VERBOSE" == true ]]; then
      git status --short | sed 's/^/  /'
    fi
    ;;
  merge)
    bt_info "Checking for recent merge commits..."
    LAST_MERGE=$(git log --oneline --all --grep='Merge' -1 2>/dev/null || true)
    if [[ -z "$LAST_MERGE" ]]; then
      bt_error_exit 5 "No merge to undo"
    fi
    bt_info "Found merge: $LAST_MERGE"
    read -p "Undo this merge? (y/N): " -r confirm
    if [[ ! $confirm =~ ^[Yy]$ ]]; then
      bt_error_exit 3 "Undo cancelled"
    fi
    
    COMMIT_HASH=$(echo "$LAST_MERGE" | awk '{print $1}')
    bt_info "Reverting merge commit..."
    export BRITETEST_BYPASS_HOOKS=true
    if ! git revert -m 1 "$COMMIT_HASH" --no-edit 2>&1; then
      unset BRITETEST_BYPASS_HOOKS
      bt_error_exit 2 "Failed to revert merge commit"
    fi
    unset BRITETEST_BYPASS_HOOKS
    
    bt_success "Merge reverted"
    ;;
  release)
    bt_info "Checking for recent release tags..."
    LAST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")
    if [[ -z "$LAST_TAG" ]]; then
      bt_error_exit 5 "No release tag found to undo"
    fi
    bt_info "Found release tag: $LAST_TAG"
    read -p "Undo release $LAST_TAG? (y/N): " -r confirm
    if [[ ! $confirm =~ ^[Yy]$ ]]; then
      bt_error_exit 3 "Undo cancelled"
    fi
    
    bt_info "Deleting local tag..."
    export BRITETEST_BYPASS_HOOKS=true
    if ! git tag -d "$LAST_TAG" 2>&1; then
      unset BRITETEST_BYPASS_HOOKS
      bt_error_exit 2 "Failed to delete local tag"
    fi
    
    bt_info "Deleting remote tag..."
    if ! git push origin --delete "$LAST_TAG" 2>&1; then
      unset BRITETEST_BYPASS_HOOKS
      bt_warn "Failed to delete remote tag (may need manual cleanup)"
    else
      unset BRITETEST_BYPASS_HOOKS
    fi
    
    bt_success "Release tag deleted"
    ;;
esac

exit 0
