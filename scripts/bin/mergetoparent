#!/usr/bin/env bash

# mergetoparent - Merge current branch to its parent branch with approval tracking.
#
# See usage below for details, or run: mergetoparent -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  mergetoparent [OPTIONS]
  mergetoparent -h | --help

Merge the current branch to its parent branch using squash merge.

Merging to a protected branch (main or a version branch) requires the current
user to be
an approver (A entry in config/contributors.md).

Before merging:
  - Verifies current user is an approver (if merging to protected branch)
  - Checks that all status checks and CI/CD pass
  - Uses PR title or custom message as squash commit message
  - Logs merge to logs/remote_branch_history.md

Features:
  - Squash commits into single commit
  - Automatic approval verification for protected branches
  - Status check validation
  - Merge logging to logs/remote_branch_history.md
  - No branch cleanup (branches remain after merge)

Options:
  -h, --help           Output this help to stdout and exit (other options
                       and arguments are ignored).
  -m, --message MSG    Custom squash commit message
                       (uses PR title if not specified)
  -v, --verbose        Show detailed information

Examples:
  # Merge current branch with PR title as message
  mergetoparent

  # Merge with custom message
  mergetoparent -m "Custom commit message"

  # Merge with verbose output
  mergetoparent -v


Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - May generate files, reports, or other artifacts in the documented
    output locations.

Exit codes:
  0   Success
  1   Argument or validation error
  2   Git operation failed
  3   User is not an approver (required for protected branch)
  4   GitHub API error
  5   Configuration error
  6   Status checks not passing
  7   PR not found or invalid state
EOF
}

# High-Level Flow:
# - Merges the current branch into its parent branch with pre-merge safety
#   validations.
# - Applies workflow policy checks and optional history logging around the merge
#   action.
# - Reports merge outcomes and next-step guidance.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/github_helpers.sh
source "$SCRIPT_DIR/../helpers/github_helpers.sh"

# Default options
CUSTOM_MESSAGE=""
VERBOSE=false


get_current_user() {
  local user_name

  if ! user_name="$(bt_require_login)"; then
    bt_error_exit 2 "Unable to determine GitHub login identity for role checks"
  fi

  echo "$user_name"
}

get_parent_branch() {
  local current_branch="$1"

  local parent_branch
  parent_branch=$(bt_resolve_parent_branch \
    "$current_branch" "main") || {
    bt_error_exit 2 "Failed to determine parent branch"
  }

  echo "$parent_branch"
}

is_approver() {
  local user_name="$1"

  # Reuse shared role-check helper for consistent contributors.md parsing.
  GITHUB_ACTOR="$user_name" \
    bash "$SCRIPT_DIR/../helpers/ckrole.sh" approver >/dev/null 2>&1
}

get_existing_pr_number() {
  local branch="$1"

  bt_gh_find_pr_number_for_branch "$branch" "open"
}

get_pr_title() {
  local pr_number="$1"
  
  # Get PR title
  gh pr view "$pr_number" --json title --jq '.title' 2>/dev/null || echo ""
}

get_pr_status_check() {
  local pr_number="$1"
  
  # Get PR status check state
  gh pr view "$pr_number" --json statusCheckRollup \
    --jq '.statusCheckRollup[].state' 2>/dev/null | sort | uniq \
    || echo "UNKNOWN"
}

check_status_checks() {
  local pr_number="$1"
  
  bt_info "Checking status checks and CI/CD..."
  
  # Get the status check state
  local status_states
  status_states=$(gh pr view "$pr_number" --json statusCheckRollup \
    --jq '.statusCheckRollup[].state' 2>/dev/null || true)

  if [[ -z "$status_states" ]]; then
    # No checks found
    bt_info "No status checks found"
    return 0
  fi

  if echo "$status_states" | grep -Eq '^(PENDING|EXPECTED|ACTION_REQUIRED)$'; then
    bt_error_exit 6 "Status checks still pending"
  fi

  if echo "$status_states" | grep -Eq '^(FAILURE|ERROR|CANCELLED|TIMED_OUT)$'; then
    bt_error_exit 6 "Status checks failed"
  fi

  if echo "$status_states" | grep -Ev '^(SUCCESS|SKIPPED|NEUTRAL)$' >/dev/null 2>&1; then
    bt_error_exit 6 "Unknown status check state detected"
  fi

  bt_success "All status checks passed"
}

ensure_clean_worktree() {
  if ! git diff --quiet || ! git diff --cached --quiet; then
    bt_error_exit 2 "Working tree must be clean before running mergetoparent"
  fi
}

log_merge_to_history() {
  local branch="$1"
  local target_branch="$2"
  local approver="$3"
  local message="$4"
  
  local history_file="logs/remote_branch_history.md"
  local timestamp
  timestamp=$(date '+%Y-%m-%d %H:%M:%S')

  mkdir -p "$(dirname "$history_file")"
  
  # Create history file if it doesn't exist
  if [[ ! -f "$history_file" ]]; then
    cat > "$history_file" << 'EOF'
# Branch History

Copyright (c) 2026 Paul Sinclair  
SPDX-License-Identifier: MIT  
For license details, see `LICENSE` in the repository root.

See `README.md` in the root directory for an introduction to the project.

## Merge Log

EOF
  fi
  
  # Append merge entry
  cat >> "$history_file" << EOF
- [$timestamp] [$approver] Merged [$branch] to [$target_branch]: $message
EOF
  
  bt_info "Logged merge to $history_file"
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        bt_error_exit 1 "Option -m requires a message argument"
      fi
      CUSTOM_MESSAGE="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -*)
      bt_error_exit 1 "Unknown option: $1"
      ;;
    *)
      bt_error_exit 1 "Unknown argument: $1"
      ;;
  esac
done

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit 2 "Failed to determine current branch")
bt_info "Current branch: $CURRENT_BRANCH"

if [[ "$CURRENT_BRANCH" == "HEAD" ]]; then
  bt_error_exit 1 "Cannot run mergetoparent from detached HEAD"
fi

if bt_is_protected_branch "$CURRENT_BRANCH"; then
  bt_error_exit 1 \
    "Current branch '$CURRENT_BRANCH' is protected. Run mergetoparent from a non-protected branch."
fi

# Get current user
CURRENT_USER=$(get_current_user)
bt_info "Current user: $CURRENT_USER"

# Determine parent branch
bt_info "Determining parent branch..."
PARENT_BRANCH=$(get_parent_branch "$CURRENT_BRANCH")
bt_info "Parent branch: $PARENT_BRANCH"

ensure_clean_worktree

# Check if parent branch is protected
if bt_is_protected_branch "$PARENT_BRANCH"; then
  bt_info "Parent branch is protected"
  
  # Verify current user is an approver
  if ! is_approver "$CURRENT_USER"; then
    bt_error_exit 3 "User '$CURRENT_USER' is not an approver. Only approvers can merge to protected branches."
  fi
  bt_success "User '$CURRENT_USER' is an approver"
else
  bt_info "Parent branch is not protected"
fi

# Find associated PR
PR_NUMBER=$(get_existing_pr_number "$CURRENT_BRANCH")
if [[ -z "$PR_NUMBER" ]]; then
  bt_error_exit 7 "No open PR found for branch '$CURRENT_BRANCH'"
fi
bt_info "Found PR #$PR_NUMBER"

# Check status checks pass
check_status_checks "$PR_NUMBER"

# Determine commit message
if [[ -n "$CUSTOM_MESSAGE" ]]; then
  COMMIT_MESSAGE="$CUSTOM_MESSAGE"
  bt_info "Using custom message: $COMMIT_MESSAGE"
else
  COMMIT_MESSAGE=$(get_pr_title "$PR_NUMBER")
  if [[ -z "$COMMIT_MESSAGE" ]]; then
    bt_error_exit 4 "Failed to get PR title"
  fi
  bt_info "Using PR title as message: $COMMIT_MESSAGE"
fi

# Perform squash merge
bt_info "Performing squash merge..."
git fetch origin 2>/dev/null || bt_warn "Failed to fetch from origin"

if git show-ref --verify --quiet "refs/heads/$PARENT_BRANCH"; then
  if ! git switch "$PARENT_BRANCH" >/dev/null 2>&1; then
    bt_error_exit 2 "Failed to switch to parent branch '$PARENT_BRANCH'"
  fi
else
  if ! git switch -c "$PARENT_BRANCH" --track "origin/$PARENT_BRANCH" >/dev/null 2>&1; then
    bt_error_exit 2 "Failed to create local parent branch '$PARENT_BRANCH'"
  fi
fi

if ! git pull --ff-only origin "$PARENT_BRANCH" 2>&1; then
  bt_error_exit 2 "Failed to fast-forward parent branch '$PARENT_BRANCH'"
fi

if ! git merge --squash --no-commit "$CURRENT_BRANCH" 2>&1; then
  bt_error_exit 2 "Failed to squash merge '$CURRENT_BRANCH' into '$PARENT_BRANCH'"
fi

# Log merge to history before committing so the audit record is preserved.
log_merge_to_history "$CURRENT_BRANCH" "$PARENT_BRANCH" \
  "$CURRENT_USER" "$COMMIT_MESSAGE"
git add logs/remote_branch_history.md 2>/dev/null || true

# Create commit with message
if ! git commit -m "$COMMIT_MESSAGE" 2>&1; then
  bt_error_exit 2 "Failed to create commit"
fi

# Push to remote
bt_info "Pushing parent branch..."
if ! git push origin "$PARENT_BRANCH" 2>&1; then
  bt_error_exit 2 "Failed to push parent branch"
fi

if ! git switch "$CURRENT_BRANCH" >/dev/null 2>&1; then
  bt_warn "Merged successfully, but failed to switch back to '$CURRENT_BRANCH'"
fi

# Show verbose output if requested
if [[ "$VERBOSE" == true ]]; then
  bt_info "Merge details:"
  echo "  Branch: $CURRENT_BRANCH"
  echo "  Parent: $PARENT_BRANCH"
  echo "  Actor: $CURRENT_USER"
  echo "  PR: #$PR_NUMBER"
  echo "  Message: $COMMIT_MESSAGE"
fi

bt_success "Branch '$CURRENT_BRANCH' merged to '$PARENT_BRANCH'"
bt_success "Done"
exit 0
