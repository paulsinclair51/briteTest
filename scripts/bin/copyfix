#!/usr/bin/env bash

# copyfix - Copy commits from a source fix branch to the
#           current branch.
#
# See usage below for details, or run: copyfix -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  copyfix [OPTIONS] SOURCE_BRANCH [-- TOKEN...]
  copyfix --continue [-v]
  copyfix {-h | --help}

Copy commits from a local source fix branch into the current local
branch (the target). Commits not already present in the target are
copied oldest first.

Prerequisites:
  - The current branch must be a targeted branch and local.
  - For a new copy, SOURCE_BRANCH must be a local targeted fix branch:
    fix/<description>-v<M>.<m>.0. The current branch must not have
    uncommitted changes or an unfinished copyfix operation.
  - For --continue, the current branch must have an unfinished copyfix
    operation with resolved changes ready to continue.

Commits added to SOURCE_BRANCH after copying begins are not included in the
current operation and remain available for a later copyfix operation.

If conflicts occur:
  - Resolve any conflicting files in the current branch. Do not commit
    the changes (commit will fail).
  - Run 'copyfix --continue' to continue the copy and commit the changes.
  - Repeat these steps if another conflict occurs.

After all commits are copied, the current branch leaves the copyfix continue
state.

Options:
  -c TOKEN        Copied-commit comment from TOKEN.
                  By default, original comments are retained.
  -- TOKEN...     Copied-commit comment from one or more tokens.
                  This option must be last.
  --continue      Continue copyfix after resolving conflicts.
  -d              Dry-run. Validate and report the fixes that would be
                  copied without updating the current target branch.
  -e              Generate an error report without copying.
  -h, --help      Output this help to stdout and exit (other options and
                  arguments are ignored).
  -v              Output progress and diagnostics to stdout.

  For copied-commit comment options '-c TOKEN' and '-- TOKEN...':
    - These options are mutually exclusive.
    - By default, original comments are retained.
    - For '-- TOKEN...', '--' must be a separate token.
    - Comment text is built by joining tokens with a single space.
    - For a quoted token, whitespace in the token is preserved and the
      quotes are removed.
    - The resulting copied-commit comment from TOKEN or TOKEN... must
      include at least one non-whitespace character.

Examples:
  # From dev/release-v1.0.0, copy fixes from a fix branch.
  copyfix fix/auth-v1.0.0

  # Copy fixes and replace each copied commit comment.
  copyfix fix/auth-v1.0.0 -- Backport authentication fixes.

  # Continue after resolving conflicts.
  copyfix --continue

  # Output progress and diagnostic details.
  copyfix fix/auth-v1.0.0 -v

Workflow:
  1. Identify SOURCE_BRANCH commits not in the current branch.
  2. Copy those commits oldest first into the current target branch.
  3. If a conflict occurs, preserve it for manual resolution.
  4. Continue with 'copyfix --continue'.

Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - The current worktree remains on the current branch.
  - No-work prerequisite failures do not generate or delete reports.
  - After a successful copy, records history for the report command and
    writes 'Run report for details.' to stdout. It does not write an immediate
    local copy report.
  - A dry-run writes an untracked report locally to:
        <repo>/reports/copyfix-d-<datetime>.md
  - A failure after target work starts or if the -e option is specified
    writes an untracked error report locally to:
        <repo>/reports/copyfix-e-<datetime>.md

Exit codes:
  0    Success.
  1    Invalid option or argument.
  2    Operation failed (e.g., uncommitted changes).
  3    Config error (e.g., source branch not found locally).
  4    No new fix commits are available to copy.
  5    Copy paused because conflicts require manual resolution.
  6    Copy skipped because -e was specified.
  200  Git operation failed.
EOF
}

# High-Level Flow:
# - Validate source/target branch policy, worktree state, and available commits.
# - Preview counts for -d or cherry-pick source commits oldest first into the
#   current target branch, preserving messages unless a comment is supplied.
# - Persist workflow state on conflicts; --continue stages resolutions and
#   resumes the same action.
# - After all commits succeed, record one aggregate event on the target tip;
#   write local reports only for dry-run/error paths.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck disable=SC1091
# shellcheck source=../helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck disable=SC1091
# shellcheck source=../helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck disable=SC1091
# shellcheck source=../helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"
# shellcheck disable=SC1091
# shellcheck source=../helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"

REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
REPORTS_DIR="$REPO_ROOT/reports"
RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
ORIGINAL_ARGS=("$@")

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_OPERATION_FAILED=2
readonly EXIT_CONFIG_ERROR=3
readonly EXIT_NOTHING_TO_COPY=4
readonly EXIT_CONFLICTS=5
readonly EXIT_WORKFLOW_SKIPPED=6
readonly EXIT_GIT_FAILED=200

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

# Default options
COPY_COMMENT=""
COPY_COMMENT_SET=false
VERBOSE=false
DRY_RUN=false
ERROR_RUN=false
CONTINUE_MODE=false
SOURCE_BRANCH_ARG=""
COPYFIX_STATE_DIR=""
SOURCE_BRANCH=""
TARGET_BRANCH=""
REPORT_FILE=""
REPORT_LOCK_FD=""
REPORT_LOCK_HELD=false
OPERATION_STARTED=false
ERROR_REPORT_WRITTEN=false
ERROR_REPORT_IN_PROGRESS=false
CLEANUP_DONE=false
COPYFIX_STATE_LOCKED=false
COPYFIX_STATE_OWNED=false
COMMITS=""
FILES_MODIFIED=0
FILES_ADDED=0
FILES_DELETED=0
FILES_RENAMED=0
FILES_RENAMED_MODIFIED=0
DIRECTORIES_DELETED=0
DIRECTORIES_ADDED=0
DIRECTORIES_RENAMED=0
FILE_COPY_SUMMARY=""

format_file_copy_summary() {
  local suffix="$1"
  printf '%s %s.' "$FILE_COPY_SUMMARY" "$suffix"
}

compute_file_copy_counts() {
  local source_branch="$1"
  local target_branch="$2"
  bt_git_collect_ref_change_summary "$target_branch" "$source_branch"
  FILES_MODIFIED="$BT_CHANGE_MODIFIED_FILES"
  FILES_DELETED="$BT_CHANGE_DELETED_FILES"
  FILES_ADDED="$BT_CHANGE_ADDED_FILES"
  FILES_RENAMED="$BT_CHANGE_RENAMED_FILES"
  FILES_RENAMED_MODIFIED="$BT_CHANGE_RENAMED_MODIFIED_FILES"
  DIRECTORIES_DELETED="$BT_CHANGE_DELETED_DIRECTORIES"
  DIRECTORIES_ADDED="$BT_CHANGE_ADDED_DIRECTORIES"
  DIRECTORIES_RENAMED="$BT_CHANGE_RENAMED_DIRECTORIES"
  FILE_COPY_SUMMARY="$(bt_format_change_summary)"
}

format_command_line() {
  bt_format_command_line "copyfix" "${ORIGINAL_ARGS[@]}"
}

acquire_report_lock() {
  if ! bt_report_acquire_lock "$REPO_ROOT" "copyfix" 10 REPORT_LOCK_FD; then
    echo "Error: Timed out waiting 10s for report write lock." >&2
    exit "$EXIT_CONFIG_ERROR"
  fi
  REPORT_LOCK_HELD=true
}

release_report_lock() {
  bt_report_release_lock "$REPORT_LOCK_FD"
  REPORT_LOCK_FD=""
  REPORT_LOCK_HELD=false
}

# shellcheck disable=SC2317  # Invoked by EXIT/INT/TERM traps.
cleanup_runtime() {
  local exit_code="${1:-$?}"
  local should_remove_state=false

  if [[ "$CLEANUP_DONE" == true ]]; then
    return 0
  fi
  CLEANUP_DONE=true

  if [[ "$REPORT_LOCK_HELD" == true ]]; then
    release_report_lock
  fi
  if [[ "$COPYFIX_STATE_OWNED" == true ]]; then
    case "$exit_code" in
      5)
        should_remove_state=false
        ;;
      130|143)
        git cherry-pick --abort >/dev/null 2>&1 || true
        should_remove_state=true
        ;;
      *)
        should_remove_state=true
        ;;
    esac
  fi

  if [[ "$should_remove_state" == true ]]; then
    remove_copyfix_state >/dev/null 2>&1 || true
  else
    release_copyfix_state_lock
  fi
  return 0
}

trap 'cleanup_runtime $?' EXIT
trap 'cleanup_runtime 130; exit 130' INT
trap 'cleanup_runtime 143; exit 143' TERM

cleanup_old_transient_reports() {
  bt_report_cleanup_transient_reports \
    "$REPORTS_DIR" \
    "$TARGET_BRANCH" \
    "$REPORT_FILE" \
    "copyfix-d-*.md" \
    "copyfix-e-*.md"
}

cleanup_success_transient_reports() {
  REPORT_FILE=""
  acquire_report_lock
  bt_report_dir_enable_writes "$REPORTS_DIR" "$EXIT_GIT_FAILED"
  cleanup_old_transient_reports
  release_report_lock
}

prepare_report_write() {
  acquire_report_lock
  bt_report_dir_enable_writes "$REPORTS_DIR" "$EXIT_GIT_FAILED"
  cleanup_old_transient_reports
}

finish_report_write() {
  release_report_lock
}

generate_copyfix_report() {
  local prefix="$1"
  local branch="$2"
  local status="$3"
  local mode="$4"
  local detail="${5:-}${6:-}"
  local command_text=""
  local commit_count=0

  detail="$(printf '%b' "$detail")"
  command_text="$(format_command_line)"
  [[ -z "$COMMITS" ]] || \
    commit_count="$(printf '%s\n' "$COMMITS" | wc -l | tr -d ' ')"
  prepare_report_write
  REPORT_FILE="$(bt_report_transient_path "$REPORTS_DIR" "$prefix" \
    "$RUN_TS_FILE")"
  cat > "$REPORT_FILE" <<EOF
# Copy-Fix Report ${RUN_TS_DISPLAY}

**Command:** \`${command_text}\`

**Branch:** \`${branch}\`

**Source Branch:** \`${SOURCE_BRANCH}\`

**Target Branch:** \`${TARGET_BRANCH:-unknown}\`

**Status:** ${status}

**Mode:** ${mode}

**Commits:** ${commit_count}

${detail}
EOF
  finish_report_write
}

generate_error_report() {
  local message="$1"
  local code="$2"
  local detail=""

  ERROR_REPORT_IN_PROGRESS=true
  printf -v detail '**Exit Code:** %s\n\n**Error:** %s' "$code" "$message"
  generate_copyfix_report "copyfix-e" "$TARGET_BRANCH" "Failed" "error" \
    "$detail"
  ERROR_REPORT_IN_PROGRESS=false
}

bt_error_exit() {
  local code="$1"
  local message="$2"
  local guidance="${3:-}"

  if [[ "$DRY_RUN" == false && "$OPERATION_STARTED" == true && \
    "$ERROR_REPORT_WRITTEN" == false && \
      "$ERROR_REPORT_IN_PROGRESS" == false ]]; then
    ERROR_REPORT_WRITTEN=true
    generate_error_report "$message" "$code" >/dev/null 2>&1 || true
  fi
  echo "Error: ${message%.}." >&2
  [[ -z "$guidance" ]] || echo "Guidance: ${guidance%.}." >&2
  exit "$code"
}


check_working_directory_clean() {
  if bt_is_worktree_dirty; then
    bt_error_exit "$EXIT_OPERATION_FAILED" \
      "Working directory has uncommitted changes." \
      "Commit or stash them first."
  fi
}

local_branch_exists() {
  local branch="$1"
  git show-ref --verify --quiet "refs/heads/$branch" \
    2>/dev/null || return 1
}

get_commits_from_branch() {
  local source_branch="$1"
  local target_branch="$2"

  # Exclude source commits whose patches are already present on the target,
  # including commits previously copied by cherry-pick under a different ID.
  git rev-list --cherry-pick --right-only \
    "$target_branch...$source_branch" 2>/dev/null || true
}

remove_copyfix_state() {
  if [[ "$COPYFIX_STATE_LOCKED" == true ]]; then
    flock -u 9 2>/dev/null || true
    exec 9>&- 2>/dev/null || true
    COPYFIX_STATE_LOCKED=false
  fi
  [[ -z "$COPYFIX_STATE_DIR" ]] || \
    rm -rf "$COPYFIX_STATE_DIR" "$COPYFIX_STATE_DIR.lock"
}

acquire_copyfix_state_lock() {
  local create_state_dir="${1:-true}"
  local lock_file=""

  if [[ "$create_state_dir" == true ]]; then
    mkdir -p "$(dirname "$COPYFIX_STATE_DIR")" || \
      bt_error_exit "$EXIT_GIT_FAILED" \
        "Failed to prepare copyfix state for target branch"
    if ! mkdir "$COPYFIX_STATE_DIR" 2>/dev/null; then
      bt_error_exit "$EXIT_OPERATION_FAILED" \
        "The current branch has an unfinished copyfix operation; complete" \
        "it with 'copyfix --continue'"
    fi
    COPYFIX_STATE_OWNED=true
  else
    [[ -d "$COPYFIX_STATE_DIR" ]] || \
      bt_error_exit "$EXIT_OPERATION_FAILED" "No copyfix operation to continue"
    COPYFIX_STATE_OWNED=false
  fi

  lock_file="$COPYFIX_STATE_DIR.lock"
  : > "$lock_file"
  exec 9>"$lock_file"
  if ! flock -x -n 9; then
    exec 9>&-
    bt_error_exit "$EXIT_OPERATION_FAILED" \
      "The current branch has an active copyfix operation"
  fi
  COPYFIX_STATE_LOCKED=true
}

# shellcheck disable=SC2317  # Called from cleanup_runtime trap path.
release_copyfix_state_lock() {
  if [[ "$COPYFIX_STATE_LOCKED" == true ]]; then
    flock -u 9 2>/dev/null || true
    exec 9>&- 2>/dev/null || true
    COPYFIX_STATE_LOCKED=false
  fi
}

save_copyfix_state() {
  local remaining_commits="$1"

  printf '%s\n' "$remaining_commits" > "$COPYFIX_STATE_DIR/remaining"
  printf '%s\n' "$COPY_COMMENT_SET" > "$COPYFIX_STATE_DIR/comment-set"
  printf '%s' "$COPY_COMMENT" > "$COPYFIX_STATE_DIR/comment"
  printf '%s\n' "$SOURCE_BRANCH" > "$COPYFIX_STATE_DIR/source"
  printf '%s\n' "$TARGET_BRANCH" > "$COPYFIX_STATE_DIR/target"
  printf '%s\n' "$COMMITS" > "$COPYFIX_STATE_DIR/commits"
  printf '%s\n' "$FILES_MODIFIED" > "$COPYFIX_STATE_DIR/files-modified"
  printf '%s\n' "$FILES_ADDED" > "$COPYFIX_STATE_DIR/files-added"
  printf '%s\n' "$FILES_DELETED" > "$COPYFIX_STATE_DIR/files-deleted"
  printf '%s\n' "$FILES_RENAMED" > "$COPYFIX_STATE_DIR/files-renamed"
  printf '%s\n' "$FILES_RENAMED_MODIFIED" \
    > "$COPYFIX_STATE_DIR/files-renamed-modified"
  printf '%s\n' "$DIRECTORIES_DELETED" \
    > "$COPYFIX_STATE_DIR/directories-deleted"
  printf '%s\n' "$DIRECTORIES_ADDED" \
    > "$COPYFIX_STATE_DIR/directories-added"
  printf '%s\n' "$DIRECTORIES_RENAMED" \
    > "$COPYFIX_STATE_DIR/directories-renamed"
}

apply_copy_comment() {
  local commit_message=""

  if [[ "$COPY_COMMENT_SET" == true ]]; then
    commit_message="$COPY_COMMENT"
  else
    commit_message="$(git log -1 --format=%B)"
  fi
  if ! git commit --amend -m "$commit_message" \
    >/dev/null 2>&1; then
    bt_error_exit "$EXIT_GIT_FAILED" \
      "Failed to apply copied fix commit comment"
  fi
}

record_copyfix_success() {
  local commit_count=0
  local command_line=""

  [[ -z "$COMMITS" ]] || \
    commit_count="$(printf '%s\n' "$COMMITS" | sed '/^$/d' | wc -l | tr -d ' ')"
  command_line="$(format_command_line)"
  if ! bt_record_workflow_event "copyfix" "$TARGET_BRANCH" "$command_line" \
    "Copied ${commit_count} fix commit(s) from $SOURCE_BRANCH to $TARGET_BRANCH" \
    "$TARGET_BRANCH" \
    "Source-Branch" "$SOURCE_BRANCH" \
    "Target-Branch" "$TARGET_BRANCH" \
    "Commits-Copied" "$commit_count" \
    "Files-Modified" "$FILES_MODIFIED" \
    "Files-Added" "$FILES_ADDED" \
    "Files-Deleted" "$FILES_DELETED" \
    "Files-Renamed" "$FILES_RENAMED" \
    "Files-Renamed-Modified" "$FILES_RENAMED_MODIFIED" \
    "Directories-Deleted" "$DIRECTORIES_DELETED" \
    "Directories-Added" "$DIRECTORIES_ADDED" \
    "Directories-Renamed" "$DIRECTORIES_RENAMED" \
    "Status" "Fix commits copied to target branch" \
    "Method" "Cherry-pick created by copyfix"; then
    bt_error_exit "$EXIT_GIT_FAILED" \
      "Copy completed, but its report history could not be recorded"
  fi
}

copy_commits() {
  local commits="$1"
  local commits_are_oldest_first="${2:-false}"
  local commit=""
  local remaining_commits=""
  
  if [[ -z "$commits" ]]; then
    bt_warn "No new commits to copy from source branch"
    return 0
  fi
  
  # Convert to array and reverse so copy runs oldest first.
  local commit_array=()
  local reversed=()
  mapfile -t commit_array < <(printf '%s\n' "$commits" | sed '/^$/d')
  if [[ "$commits_are_oldest_first" == true ]]; then
    reversed=("${commit_array[@]}")
  else
    for ((i=${#commit_array[@]}-1; i>=0; i--)); do
      reversed+=("${commit_array[$i]}")
    done
  fi
  
  bt_info "Copying ${#reversed[@]} commit(s)..."
  
  for ((i=0; i<${#reversed[@]}; i++)); do
    commit="${reversed[$i]}"
    bt_info "Copying $commit..."
    
    if ! git cherry-pick "$commit" 2>&1; then
      conflict_msg=""

      if [[ -n "$(git diff --name-only --diff-filter=U 2>/dev/null)" ]]; then
        remaining_commits="$(printf '%s\n' "${reversed[@]:$((i + 1))}")"
        save_copyfix_state "$remaining_commits"
        ERROR_REPORT_WRITTEN=true
        conflict_msg="Copy paused because conflicts require manual resolution"
        generate_error_report "$conflict_msg" "$EXIT_CONFLICTS" || true
        bt_warn "Conflict detected while copying $commit"
        echo "Resolve the conflicting files in the current branch."
        echo "Then run:"
        echo "  copyfix --continue"
        exit "$EXIT_CONFLICTS"
      fi

      git cherry-pick --abort >/dev/null 2>&1 || true
      bt_error_exit "$EXIT_GIT_FAILED" \
        "Failed to cherry-pick commit $commit"
    fi
    apply_copy_comment
  done
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --continue)
      CONTINUE_MODE=true
      shift
      ;;
    -c)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -c requires a comment token"
      fi
      if [[ "$COPY_COMMENT_SET" == true ]]; then
        usage_error "Cannot use both -c and -- for the commit comment"
      fi
      COPY_COMMENT="$2"
      COPY_COMMENT_SET=true
      shift 2
      ;;
    -d)
      [[ "$ERROR_RUN" == false ]] || \
        usage_error "Options -d and -e are mutually exclusive"
      DRY_RUN=true
      shift
      ;;
    -e)
      [[ "$DRY_RUN" == false ]] || \
        usage_error "Options -d and -e are mutually exclusive"
      ERROR_RUN=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    --)
      shift
      if [[ "$COPY_COMMENT_SET" == true ]]; then
        usage_error "Cannot use both -c and -- for the commit comment"
      fi
      if [[ $# -eq 0 ]]; then
        usage_error "Option -- requires one or more tokens for the commit" \
                    "comment"
      fi
      COPY_COMMENT="$*"
      COPY_COMMENT_SET=true
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      if [[ "$CONTINUE_MODE" == false ]]; then
        if [[ -n "$SOURCE_BRANCH_ARG" ]]; then
          usage_error "Unexpected argument: $1"
        fi
        SOURCE_BRANCH_ARG="$1"
        shift
      else
        usage_error "Unexpected argument with --continue: $1"
      fi
      ;;
  esac
done

if [[ "$COPY_COMMENT_SET" == true ]]; then
  comment_validation_msg=""
  trim_prefix=""
  trim_suffix=""

  COPY_COMMENT_TRIMMED="$COPY_COMMENT"
  trim_prefix="${COPY_COMMENT_TRIMMED%%[![:space:]]*}"
  COPY_COMMENT_TRIMMED="${COPY_COMMENT_TRIMMED#"$trim_prefix"}"
  trim_suffix="${COPY_COMMENT_TRIMMED##*[![:space:]]}"
  COPY_COMMENT_TRIMMED="${COPY_COMMENT_TRIMMED%"$trim_suffix"}"
  comment_validation_msg="Commit comment must include at least one "
  comment_validation_msg+="non-whitespace character"
  [[ -n "$COPY_COMMENT_TRIMMED" ]] || \
    usage_error "$comment_validation_msg"
fi

# Handle continue mode
if [[ "$CONTINUE_MODE" == true ]]; then
  declare -a unresolved_paths=()
  conflict_check=""
  [[ "$ERROR_RUN" == false ]] || \
    usage_error "Option -e cannot be used with --continue"
  [[ "$DRY_RUN" == false ]] || \
    usage_error "Option -d cannot be used with --continue"
  [[ -z "$SOURCE_BRANCH_ARG" ]] || \
    usage_error "SOURCE_BRANCH is not allowed with --continue"
  [[ "$COPY_COMMENT_SET" == false ]] || \
    usage_error "Comment options are not allowed with --continue"
  current_branch="$(bt_get_current_branch || true)"
  [[ -n "$current_branch" ]] || \
    bt_error_exit "$EXIT_GIT_FAILED" "Failed to determine current branch"
  COPYFIX_STATE_DIR="$(bt_copyfix_state_dir_for_branch "$current_branch")" || \
    bt_error_exit "$EXIT_GIT_FAILED" \
      "Failed to determine copyfix state for current branch"
  [[ -d "$COPYFIX_STATE_DIR" ]] || \
    bt_error_exit "$EXIT_OPERATION_FAILED" "No copyfix operation to continue"
  git rev-parse --verify CHERRY_PICK_HEAD >/dev/null 2>&1 || \
    bt_error_exit "$EXIT_OPERATION_FAILED" \
      "Current branch is not in the copyfix continue state"
  acquire_copyfix_state_lock false
  COPY_COMMENT_SET="$(cat "$COPYFIX_STATE_DIR/comment-set" 2>/dev/null || \
    echo false)"
  COPY_COMMENT="$(cat "$COPYFIX_STATE_DIR/comment" 2>/dev/null || true)"
  SOURCE_BRANCH="$(cat "$COPYFIX_STATE_DIR/source" 2>/dev/null || true)"
  TARGET_BRANCH="$(cat "$COPYFIX_STATE_DIR/target" 2>/dev/null || true)"
  COMMITS="$(cat "$COPYFIX_STATE_DIR/commits" 2>/dev/null || true)"
  FILES_MODIFIED="$(cat "$COPYFIX_STATE_DIR/files-modified" 2>/dev/null || \
    echo 0)"
  FILES_ADDED="$(cat "$COPYFIX_STATE_DIR/files-added" 2>/dev/null || echo 0)"
  FILES_DELETED="$(cat "$COPYFIX_STATE_DIR/files-deleted" 2>/dev/null || \
    echo 0)"
  FILES_RENAMED="$(cat "$COPYFIX_STATE_DIR/files-renamed" 2>/dev/null || \
    echo 0)"
  FILES_RENAMED_MODIFIED="$(cat \
    "$COPYFIX_STATE_DIR/files-renamed-modified" 2>/dev/null || echo 0)"
  DIRECTORIES_DELETED="$(cat \
    "$COPYFIX_STATE_DIR/directories-deleted" 2>/dev/null || echo 0)"
  DIRECTORIES_ADDED="$(cat \
    "$COPYFIX_STATE_DIR/directories-added" 2>/dev/null || echo 0)"
  DIRECTORIES_RENAMED="$(cat \
    "$COPYFIX_STATE_DIR/directories-renamed" 2>/dev/null || echo 0)"
  BT_CHANGE_MODIFIED_FILES="$FILES_MODIFIED"
  BT_CHANGE_DELETED_FILES="$FILES_DELETED"
  BT_CHANGE_ADDED_FILES="$FILES_ADDED"
  BT_CHANGE_RENAMED_FILES="$FILES_RENAMED"
  BT_CHANGE_RENAMED_MODIFIED_FILES="$FILES_RENAMED_MODIFIED"
  BT_CHANGE_DELETED_DIRECTORIES="$DIRECTORIES_DELETED"
  BT_CHANGE_ADDED_DIRECTORIES="$DIRECTORIES_ADDED"
  BT_CHANGE_RENAMED_DIRECTORIES="$DIRECTORIES_RENAMED"
  FILE_COPY_SUMMARY="$(bt_format_change_summary)"
  if [[ -n "$TARGET_BRANCH" && "$current_branch" != "$TARGET_BRANCH" ]]; then
    bt_error_exit "$EXIT_OPERATION_FAILED" \
      "Current branch must match the saved target branch for --continue:" \
      "$TARGET_BRANCH"
  fi
  OPERATION_STARTED=true
  bt_info "Continuing copy..."

  mapfile -d '' -t unresolved_paths < <(
    git diff --name-only --diff-filter=U -z 2>/dev/null
  )
  if [[ ${#unresolved_paths[@]} -gt 0 ]]; then
    conflict_check="$(git diff --check -- "${unresolved_paths[@]}" \
      2>&1 || true)"
  fi
  if [[ "$conflict_check" == *"leftover conflict marker"* ]]; then
      bt_warn "Conflicts remain after continue"
      echo "Resolve the conflicting files in the current branch."
      echo "Then run:"
      echo "  copyfix --continue"
      exit "$EXIT_CONFLICTS"
  fi
  if [[ ${#unresolved_paths[@]} -gt 0 ]] && \
    ! git add -- "${unresolved_paths[@]}"; then
      bt_error_exit "$EXIT_GIT_FAILED" \
        "Failed to stage resolved conflict files"
  fi
  if ! GIT_EDITOR=true git cherry-pick --continue 2>&1; then
    if [[ -n "$(git diff --name-only --diff-filter=U 2>/dev/null)" ]]; then
      bt_warn "Conflicts remain after continue"
      echo "Resolve the conflicting files in the current branch."
      echo "Then run:"
      echo "  copyfix --continue"
      exit "$EXIT_CONFLICTS"
    fi
    bt_error_exit "$EXIT_GIT_FAILED" "Failed to continue the cherry-pick"
  fi
  apply_copy_comment
  REMAINING_COMMITS="$(cat "$COPYFIX_STATE_DIR/remaining" 2>/dev/null || true)"
  if [[ -n "$REMAINING_COMMITS" ]]; then
    local_remaining_count="$(printf '%s\n' "$REMAINING_COMMITS" | \
      sed '/^$/d' | wc -l | tr -d ' ')"
    bt_info "Continuing with ${local_remaining_count} remaining commit(s)..."
    copy_commits "$REMAINING_COMMITS" true
  fi
  remove_copyfix_state || \
    bt_error_exit "$EXIT_GIT_FAILED" "Failed to remove copyfix state"
  summary_line="$(format_file_copy_summary "copied")"
  record_copyfix_success
  cleanup_success_transient_reports
  bt_success "Copy continued successfully"
  bt_success "$summary_line"
  bt_success "Run report for details."
  exit 0
fi

# Validate source branch provided
if [[ -z "$SOURCE_BRANCH_ARG" ]]; then
  usage_error "SOURCE_BRANCH argument required"
fi

# Get source branch argument and current target branch.
SOURCE_BRANCH="$SOURCE_BRANCH_ARG"
TARGET_BRANCH=$(bt_get_current_branch || \
  bt_error_exit "$EXIT_GIT_FAILED" "Failed to determine current branch")
bt_info "Target branch: $TARGET_BRANCH"
bt_info "Source branch: $SOURCE_BRANCH"

if [[ "$SOURCE_BRANCH" != fix/* ]] || \
  ! bt_is_targeted_branch "$SOURCE_BRANCH"; then
  bt_error_exit "$EXIT_OPERATION_FAILED" \
    "SOURCE_BRANCH must match fix/<description>-v<M>.<m>.0"
fi

if ! local_branch_exists "$SOURCE_BRANCH"; then
  bt_error_exit "$EXIT_CONFIG_ERROR" \
    "Source branch not found locally: $SOURCE_BRANCH"
fi
if ! bt_is_targeted_branch "$TARGET_BRANCH"; then
  bt_error_exit "$EXIT_OPERATION_FAILED" \
    "Current target branch must match <type>/<description>-v<M>.<m>.0"
fi
if [[ "$TARGET_BRANCH" == "$SOURCE_BRANCH" ]]; then
  usage_error "SOURCE_BRANCH must differ from the current target branch"
fi

COPYFIX_STATE_DIR="$(bt_copyfix_state_dir_for_branch "$TARGET_BRANCH")" || \
  bt_error_exit "$EXIT_GIT_FAILED" \
    "Failed to determine copyfix state for target branch"
acquire_copyfix_state_lock true

# Check working directory is clean
bt_info "Checking working directory..."
check_working_directory_clean
bt_success "Working directory is clean"

if [[ "$ERROR_RUN" == true ]]; then
  ERROR_REPORT_WRITTEN=true
  generate_error_report "Copy skipped due to -e option." \
    "$EXIT_WORKFLOW_SKIPPED"
  bt_emit_error "Copy skipped due to -e option."
  bt_emit_guidance "Run without -e option."
  bt_success "See ${REPORT_FILE#"${REPO_ROOT}"/} for details."
  exit "$EXIT_WORKFLOW_SKIPPED"
fi

# Get commits to copy
bt_info "Getting commits from $SOURCE_BRANCH for target $TARGET_BRANCH..."
COMMITS=$(get_commits_from_branch "$SOURCE_BRANCH" "$TARGET_BRANCH")
compute_file_copy_counts "$SOURCE_BRANCH" "$TARGET_BRANCH"

if [[ -z "$COMMITS" ]]; then
  bt_emit_prerequisite_failure "$EXIT_NOTHING_TO_COPY" \
    "Source branch '$SOURCE_BRANCH' has no new commits to copy into '$TARGET_BRANCH'." \
    "rerun copyfix after new fix commits are available."
fi

bt_info "Found commits to copy:"
echo "$COMMITS" | while read -r commit; do
  echo "  $commit"
done

if [[ "$DRY_RUN" == true ]]; then
  dry_run_count=""

  summary_line="$(format_file_copy_summary "to be copied")"
  generate_copyfix_report "copyfix-d" "$TARGET_BRANCH" "Preview" "dry-run" \
    "**Result:** Fix commits would be copied; the target branch was not " \
    "changed.\n\n**Summary:** ${summary_line}"
  dry_run_count="$(printf '%s\n' "$COMMITS" | wc -l | tr -d ' ')"
  bt_success "$summary_line"
  bt_success "Dry run: ${dry_run_count} commit(s) would be copied to " \
    "'$TARGET_BRANCH'."
  bt_success "See ${REPORT_FILE#"${REPO_ROOT}/"} for details."
  exit 0
fi

# Copy commits directly into the current target branch so conflict resolution
# occurs in the user's current worktree.
OPERATION_STARTED=true
copy_commits "$COMMITS"
remove_copyfix_state || \
  bt_error_exit "$EXIT_GIT_FAILED" "Failed to remove copyfix state"
summary_line="$(format_file_copy_summary "copied")"
record_copyfix_success
cleanup_success_transient_reports

bt_success "Copy completed successfully"
bt_success "$summary_line"
if [[ "$VERBOSE" == true ]]; then
  bt_info "Details:"
  echo "  Target branch: $TARGET_BRANCH"
  echo "  Source branch: $SOURCE_BRANCH"
  echo "  Commits picked: $(echo "$COMMITS" | wc -l)"
fi

bt_success "Done"
bt_success "Run report for details."
exit 0
