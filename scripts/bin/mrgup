readonly EXIT_GITHUB_IDENTITY_FAILED=200
readonly EXIT_GITHUB_PR_QUERY_FAILED=201
readonly EXIT_GIT_OPERATION_FAILED=202
readonly EXIT_LOCAL_REPORT_FAILED=203
