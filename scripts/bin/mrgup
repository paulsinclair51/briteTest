#!/usr/bin/env bash

# mrgup - Merge current branch to its parent branch with
# approval tracking.
#
# See usage below for details, or run: mrgup -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  mrgup [OPTIONS] [-- TOKENS]
  mrgup {-h | --help}

Merge the current branch to its parent branch.

Pre-merge checks:
  - Remote origin must be connected/reachable.
  - If -o option is specified, the user must be the repository owner.
  - For merges up to a protected branch: user must be an approver or
    the -o option must be specified.
  - PR requirements:
    - With -o: PR is optional for merges up to a version branch.
    - Without -o: PR is required for merges up to a version branch.
    - PR is not required for merges up to a contributor branch,
      targeted branch, or main branch.
  - If a PR exists, it must be open, not draft, head=current branch,
    base=parent branch, have no outstanding Changes Requested,
    be approved, and not already be merged.
  - Current branch must have all changes committed.
  - If current branch has both local and remote branches, current must be
    checked out locally and local/remote must be synchronized to avoid conflicts.
  - Parent branch must have all changes committed.
  - If parent branch has both local and remote branches, local/remote must
    be synchronized to avoid conflicts.
  - Current branch must not be behind its parent branch to avoid conflicts.
  - CI/CD results are included in the report.
  - If CI or CD fails, parent is a version branch, and -o is not specified,
    mrgup behaves as a dry-run (-d): merge to the parent version branch is
    skipped.
  - CI/CD exit codes: if only CI fails then 19, if only CD fails then 20,
    or if both fail then 21.

Merge behavior:
  - Combines changes into a single commit on the parent branch.
  - No branch cleanup (branches remain after merge).

Options:
  -c TOKEN           Set commit comment from one token.
  -- TOKEN...        Set commit comment from one or more tokens.
  -d                 Dry-run for branch commit/push workflow. Script does
                     not commit or push the primary code commit. It still
                     generates a dry-run report and deletes stale dry-run
                     reports (see Output below for details).
                     Dry-run runs pre-merge checks and returns exit
                     codes for failures.
  -h                 Output this help to stdout and exit (other options
                     and arguments are ignored).
  --help             Output this help to stdout and exit (other options
                     and arguments are ignored).
  -o                 Owner override for repository owner. Allows this run on
                     branches normally blocked by workflow policy. Normal
                     role restrictions apply again after exit.
  -v                 Show detailed merge information.

  For commit comment options '-c TOKEN' and '-- TOKEN...':
    - These options are mutually exclusive.
    - For '-- TOKEN...', '--' must be a separate token.
    - Commit comment is built by joining tokens with a single space.
    - For a quoted token, whitespace in the token is preserved and the
      quotes are removed.
    - For example, the following both have the same commit comment:
        mrgup -- do "  keep   this spacing  " for commit comment.
        mrgup -c "do   keep   this spacing   for commit comment."
    - The resulting commit comment from TOKEN or TOKEN... must include at least
      one non-whitespace character.
    - Always ensure that the commit comment accurately reflects the changes
      being committed to the parent branch.

If a commit comment is not specified:

  - The associated PR title is used as the commit comment or,
    when a PR is not required, a default commit comment is used:
    - mrgup with -o option merging a targeted branch up to its
      corresponding parent version branch:
        "<targeted_branch> merged to v<M>.<m>.0 by owner <user>."
    - Approver merging a version branch up to origin/main:
        "v<M>.<m>.0 merged to origin/main by approver <user>."
    - Contributor merging a contributor branch up to a targeted or
      contributor branch:
        "<branch> merged to <parent> by contributor <user>."

Example: When current branch is a targeted branch, merge the branch
up to its parent version branch using the PR title as the commit comment.
  mrgup

Example: Merge with '-c' commit comment.
  mrgup -c "My commit comment."

Example: Merge with '--' commit comment.
  mrgup -- "Merge parser fixes."

Example: Merge with verbose output.
  mrgup -v

Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - For a non-dry-run mrgup:
    - Writes an untracked report to the current and parent branches to:
          <repo>/reports/branch/merge-<datetime>-<pid>.md
    - The report is copied (untracked) to the remote current and parent
      branch so both local and remote have the same reports for audit
      trail continuity.
  - A dry-run report is written (untracked) to the current branch to: 
        <repo>/reports/branch/merge-d-<datetime>.md
  - Report files are made read-only after generation.

Exit codes:
  0    Success.
  1    Argument or validation error.
  2    Commit comment is specified but it is empty.
  3    User is not an approver.
  4    User is not the repository owner.
  5    Missing pull request (PR).
  6    Pull request (PR) is not open.
  7    Pull request (PR) is a draft.
  8    Pull request (PR) is not for the current branch.
  9    Pull request (PR) target is not the parent branch.
  10   Pull request (PR) has outstanding changes requested.
  11   Pull request (PR) is not approved.
  12   Pull request (PR) indicates already merged.
  13   Remote is not connected/reachable.
  14   Uncommitted changes in the current branch.
  15   Current branch local and remote are not synchronized.
  16   Parent branch does not exist.
  17   Parent branch local and remote are not synchronized.
  18   Current branch is behind its parent branch.
  19   CI failed.
  20   CD failed.
  21   Both CI and CD failed.
  200  Git operation failed.
EOF
}

# High-Level Flow:
# - Parse options and determine current branch, parent branch, and actor context.
# - Acquire an exclusive local run lock so only one mrgup run mutates this
#   repository at a time.
# - Run pre-merge policy gates (role, PR, branch sync, CI/CD) with
#   usage-defined exit codes.
# - If eligible to merge, perform squash merge, update history, push, and
#   verify post-merge synchronization.
# - If CI/CD fails under usage-defined fallback conditions, skip merge and
#   complete as dry-run with CI/CD exit semantics.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/github_helpers.sh
source "$SCRIPT_DIR/../helpers/github_helpers.sh"
# shellcheck source=helpers/validation-helpers.sh
source "$SCRIPT_DIR/../helpers/validation-helpers.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_EMPTY_COMMIT_COMMENT=2
readonly EXIT_NOT_APPROVER=3
readonly EXIT_NOT_REPOSITORY_OWNER=4
readonly EXIT_PR_MISSING=5
readonly EXIT_PR_NOT_OPEN=6
readonly EXIT_PR_DRAFT=7
readonly EXIT_PR_HEAD_MISMATCH=8
readonly EXIT_PR_BASE_MISMATCH=9
readonly EXIT_PR_HAS_CHANGES_REQUESTED=10
readonly EXIT_PR_NOT_APPROVED=11
readonly EXIT_PR_ALREADY_MERGED=12
readonly EXIT_REMOTE_UNREACHABLE=13
readonly EXIT_CURRENT_UNCOMMITTED=14
readonly EXIT_CURRENT_NOT_SYNCED=15
readonly EXIT_PARENT_MISSING=16
readonly EXIT_PARENT_NOT_SYNCED=17
readonly EXIT_CURRENT_BEHIND_PARENT=18
readonly EXIT_CI_FAILED=19
readonly EXIT_CD_FAILED=20
readonly EXIT_CI_AND_CD_FAILED=21
readonly EXIT_GIT_OPERATION_FAILED=200

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

# Default options
CUSTOM_MESSAGE=""
VERBOSE=false
DRY_RUN=false
OWNER_OVERRIDE=false
OWNER_OVERRIDE_ACTIVE=false
MESSAGE_SOURCE=""
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S')"
CURRENT_IS_LOCAL=true
CURRENT_SOURCE_REF=""
TEMP_PARENT_BRANCH_CREATED=false
TEMP_PARENT_BRANCH_NAME=""
PARENT_CHECKOUT_ACTIVE=false
REPORTS_BRANCH_DIR_UNLOCKED=false
VERIFY_LAST_ERROR=""
VERIFY_FAILURE_KIND=""
CI_CD_DRY_RUN_EXIT=0
LOCK_FILE=""
LOCK_HELD=false

ensure_trailing_period() {
  local message="$1"

  if [[ -z "$message" ]]; then
    printf '.'
    return 0
  fi

  if [[ "$message" == *"." ]]; then
    printf '%s' "$message"
  else
    printf '%s.' "$message"
  fi
}

# Keep informational logs quiet unless verbose mode is requested.
bt_info() {
  if [[ "$VERBOSE" == true ]]; then
    echo "$(ensure_trailing_period "$1")"
  fi
}

bt_success() {
  echo "$(ensure_trailing_period "$1")"
}

bt_warn() {
  echo "$(ensure_trailing_period "$1")"
}

bt_error_exit() {
  local code="$1"
  local message="$2"

  echo "Error: $(ensure_trailing_period "$message")" >&2
  exit "$code"
}

bt_run_cmd() {
  if [[ "$VERBOSE" == true ]]; then
    "$@"
  else
    "$@" >/dev/null 2>&1
  fi
}

print_merge_change_summary() {
  local commit_sha="$1"
  local updated_count=0
  local new_count=0
  local deleted_count=0
  local status=""

  while IFS=$'\t' read -r status _; do
    case "$status" in
      M|R*|C*)
        updated_count=$((updated_count + 1))
        ;;
      A)
        new_count=$((new_count + 1))
        ;;
      D)
        deleted_count=$((deleted_count + 1))
        ;;
      *)
        ;;
    esac
  done < <(git show --pretty=format: --name-status "$commit_sha" 2>/dev/null || true)

  bt_success "$updated_count files updated, $new_count new files, and $deleted_count files deleted."
}

unlock_reports_branch_dir_for_merge() {
  local reports_dir="reports/branch"

  [[ -d "$reports_dir" ]] || return 0

  if chmod u+w "$reports_dir" >/dev/null 2>&1; then
    REPORTS_BRANCH_DIR_UNLOCKED=true
  fi
}

relock_reports_branch_dir_after_merge() {
  local reports_dir="reports/branch"

  if [[ "$REPORTS_BRANCH_DIR_UNLOCKED" == true ]]; then
    chmod a-w "$reports_dir" >/dev/null 2>&1 || true
    REPORTS_BRANCH_DIR_UNLOCKED=false
  fi
}

acquire_run_lock() {
  local lock_path=""
  local existing_pid=""

  lock_path="$(git rev-parse --git-path mrgup.run.lock 2>/dev/null || true)"
  if [[ -z "$lock_path" ]]; then
    bt_error_exit "$EXIT_INVALID_ARGUMENT" "Unable to resolve repository lock path for mrgup"
  fi

  LOCK_FILE="$lock_path"

  if [[ -f "$LOCK_FILE" ]]; then
    existing_pid="$(cat "$LOCK_FILE" 2>/dev/null || true)"
    if [[ "$existing_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$existing_pid" >/dev/null 2>&1; then
      rm -f "$LOCK_FILE" >/dev/null 2>&1 || true
    fi
  fi

  if ( set -o noclobber; printf '%s\n' "$$" > "$LOCK_FILE" ) 2>/dev/null; then
    LOCK_HELD=true
    return 0
  fi

  existing_pid="$(cat "$LOCK_FILE" 2>/dev/null || true)"
  if [[ "$existing_pid" =~ ^[0-9]+$ ]]; then
    bt_error_exit "$EXIT_INVALID_ARGUMENT" \
      "Another mrgup run appears active (pid $existing_pid). Verify with 'ps -p $existing_pid -o comm='. If no mrgup process is running, remove stale lock '.git/mrgup.run.lock' and rerun mrgup"
  fi

  bt_error_exit "$EXIT_INVALID_ARGUMENT" "Another mrgup run appears active. If no run is active, remove stale lock '.git/mrgup.run.lock' and rerun mrgup"
}

release_run_lock() {
  if [[ "$LOCK_HELD" == true && -n "$LOCK_FILE" ]]; then
    rm -f "$LOCK_FILE" >/dev/null 2>&1 || true
    LOCK_HELD=false
  fi
}

print_failure_guidance() {
  local exit_code="$1"

  case "$exit_code" in
    "$EXIT_PR_MISSING"|"$EXIT_PR_NOT_OPEN"|"$EXIT_PR_DRAFT"|"$EXIT_PR_HEAD_MISMATCH"|"$EXIT_PR_BASE_MISMATCH"|"$EXIT_PR_HAS_CHANGES_REQUESTED"|"$EXIT_PR_NOT_APPROVED"|"$EXIT_PR_ALREADY_MERGED")
      bt_warn "Guidance: fix PR state/approval for this branch and rerun mrgup"
      ;;
    "$EXIT_CURRENT_UNCOMMITTED")
      bt_warn "Guidance: commit or discard local changes, then rerun mrgup"
      ;;
    "$EXIT_CURRENT_NOT_SYNCED"|"$EXIT_PARENT_NOT_SYNCED"|"$EXIT_CURRENT_BEHIND_PARENT")
      bt_warn "Guidance: sync branches (fetch/rebase or merge parent as needed), resolve divergence, then rerun mrgup"
      ;;
    "$EXIT_REMOTE_UNREACHABLE")
      bt_warn "Guidance: restore remote connectivity (origin) and rerun mrgup"
      ;;
    "$EXIT_CI_FAILED"|"$EXIT_CD_FAILED"|"$EXIT_CI_AND_CD_FAILED")
      bt_warn "Guidance: fix failing CI/CD checks, then rerun mrgup"
      ;;
    "$EXIT_GIT_OPERATION_FAILED")
      bt_warn "Guidance: if merge conflicts occurred, resolve conflicts, ensure a clean branch state, then rerun mrgup"
      ;;
    *)
      bt_warn "Guidance: review the error above, correct the reported issue, then rerun mrgup"
      ;;
  esac
}

restore_current_branch_on_failure() {
  local exit_code="$1"
  local restored=false
  local now_branch=""

  # Recover only when a failure occurs after switching to parent.
  if [[ "$exit_code" -eq 0 || "$PARENT_CHECKOUT_ACTIVE" != true ]]; then
    return 0
  fi

  if [[ "$CURRENT_IS_LOCAL" == true ]]; then
    git switch "$CURRENT_BRANCH" >/dev/null 2>&1 || true

    now_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ "$now_branch" == "$CURRENT_BRANCH" ]]; then
      restored=true
    else
      git switch -f "$CURRENT_BRANCH" >/dev/null 2>&1 || true
      now_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
      if [[ "$now_branch" == "$CURRENT_BRANCH" ]]; then
        restored=true
      fi
    fi

    if [[ "$restored" == true ]]; then
      bt_warn "mrgup failed; restored working branch to '$CURRENT_BRANCH'"
    else
      bt_warn "mrgup failed and could not restore branch '$CURRENT_BRANCH' automatically"
    fi
  else
    git switch --detach "origin/$CURRENT_BRANCH" >/dev/null 2>&1 || true

    now_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ "$now_branch" == "HEAD" ]]; then
      restored=true
    else
      git switch -f --detach "origin/$CURRENT_BRANCH" >/dev/null 2>&1 || true
      now_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
      if [[ "$now_branch" == "HEAD" ]]; then
        restored=true
      fi
    fi

    if [[ "$restored" == true ]]; then
      bt_warn "mrgup failed; restored detached branch to origin/$CURRENT_BRANCH"
    else
      bt_warn "mrgup failed and could not restore detached branch origin/$CURRENT_BRANCH automatically"
    fi
  fi
}

on_exit_restore_branch_if_needed() {
  local exit_code=$?
  restore_current_branch_on_failure "$exit_code" || true
  relock_reports_branch_dir_after_merge || true
  release_run_lock || true

  if [[ "$exit_code" -ne 0 ]]; then
    print_failure_guidance "$exit_code" || true
  fi
}

trap on_exit_restore_branch_if_needed EXIT

get_repository_owner_login() {
  local origin_url=""
  local owner=""

  origin_url="$(git remote get-url origin 2>/dev/null || true)"
  [[ -n "$origin_url" ]] || {
    echo ""
    return 0
  }

  if [[ "$origin_url" =~ ^git@github\.com:([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  elif [[ "$origin_url" =~ ^https://github\.com/([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  elif [[ "$origin_url" =~ ^ssh://git@github\.com/([^/]+)/[^/]+(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
  fi

  owner="$(bt_normalize_login "$owner")"
  echo "$owner"
}

is_repository_owner() {
  local user_name="$1"
  local repo_owner=""

  repo_owner="$(get_repository_owner_login)"
  [[ -n "$repo_owner" ]] || return 1

  [[ "$(bt_normalize_login "$user_name")" == "$repo_owner" ]]
}


get_current_user() {
  local user_name

  if ! user_name="$(bt_require_login)"; then
    bt_error_exit "$EXIT_INVALID_ARGUMENT" "Unable to determine GitHub login identity for role checks"
  fi

  echo "$user_name"
}

get_parent_branch() {
  local current_branch="$1"

  local parent_branch
  parent_branch=$(bt_resolve_parent_branch \
    "$current_branch" "main") || {
    bt_error_exit "$EXIT_PARENT_MISSING" "Failed to determine parent branch"
  }

  echo "$parent_branch"
}

is_remote_connected() {
  git remote get-url origin >/dev/null 2>&1
}

has_local_branch() {
  local branch="$1"
  git show-ref --verify --quiet "refs/heads/$branch"
}

has_remote_branch() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

parent_has_remote_push_target() {
  local parent_branch="$1"

  if [[ "$parent_branch" == "main" ]]; then
    return 0
  fi

  has_remote_branch "$parent_branch"
}

set_verify_failure() {
  local failure_kind="$1"
  local message="$2"

  VERIFY_FAILURE_KIND="$failure_kind"
  VERIFY_LAST_ERROR="$message"
}

verify_ref_at_commit() {
  local ref_name="$1"
  local expected_sha="$2"
  local label="$3"
  local failure_kind="$4"
  local actual_sha=""

  actual_sha="$(git rev-parse "$ref_name" 2>/dev/null || true)"
  if [[ -z "$actual_sha" ]]; then
    set_verify_failure "$failure_kind" "unable to resolve $label ($ref_name)"
    return 1
  fi

  if [[ "$actual_sha" != "$expected_sha" ]]; then
    set_verify_failure "$failure_kind" "$label is at $actual_sha, expected $expected_sha"
    return 1
  fi

  return 0
}

verify_post_merge_sync() {
  local current_branch="$1"
  local parent_branch="$2"
  local current_is_local="$3"
  local expected_tip="$4"
  local now_branch=""

  VERIFY_LAST_ERROR=""
  VERIFY_FAILURE_KIND=""

  # Refresh remote refs before asserting final state.
  git fetch origin "$current_branch" >/dev/null 2>&1 || true
  if parent_has_remote_push_target "$parent_branch"; then
    git fetch origin "$parent_branch" >/dev/null 2>&1 || true
  fi

  verify_ref_at_commit "$current_branch" "$expected_tip" "local current branch '$current_branch'" "local_current_ref" || return 1

  if has_local_branch "$parent_branch"; then
    verify_ref_at_commit "$parent_branch" "$expected_tip" "local parent branch '$parent_branch'" "local_parent_ref" || return 1
  fi

  if has_remote_branch "$current_branch"; then
    verify_ref_at_commit "origin/$current_branch" "$expected_tip" "remote current branch origin/$current_branch" "remote_current_ref" || return 1
  fi

  if parent_has_remote_push_target "$parent_branch"; then
    verify_ref_at_commit "origin/$parent_branch" "$expected_tip" "remote parent branch origin/$parent_branch" "remote_parent_ref" || return 1
  fi

  now_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [[ "$current_is_local" == true && "$now_branch" != "$current_branch" ]]; then
    set_verify_failure "checked_out_branch" "expected current branch '$current_branch', found '$now_branch'"
    return 1
  fi

  if bt_is_worktree_dirty; then
    set_verify_failure "worktree_dirty" "worktree is dirty after mrgup"
    return 1
  fi

  if [[ "$VERBOSE" == true ]]; then
    bt_info "Post-merge sync verification passed"
  fi

  return 0
}

attempt_post_merge_sync_repair() {
  local current_branch="$1"
  local parent_branch="$2"
  local current_is_local="$3"
  local expected_tip="$4"
  local failure_kind="$5"
  local now_branch=""

  case "$failure_kind" in
    local_current_ref)
      if ! git branch -f "$current_branch" "$expected_tip" >/dev/null 2>&1; then
        set_verify_failure "$failure_kind" "failed to align local current branch '$current_branch' to expected merge tip"
        return 1
      fi
      ;;
    local_parent_ref)
      if has_local_branch "$parent_branch"; then
        now_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
        if [[ "$now_branch" == "$parent_branch" ]]; then
          set_verify_failure "$failure_kind" "cannot force-align local parent branch '$parent_branch' while it is checked out"
          return 1
        fi
        if ! git branch -f "$parent_branch" "$expected_tip" >/dev/null 2>&1; then
          set_verify_failure "$failure_kind" "failed to align local parent branch '$parent_branch' to expected merge tip"
          return 1
        fi
      fi
      ;;
    remote_current_ref)
      if has_remote_branch "$current_branch"; then
        if ! GIT_BYPASS_HOOKS=true git push --force-with-lease origin "$expected_tip:$current_branch" >/dev/null 2>&1; then
          set_verify_failure "$failure_kind" "failed to align remote current branch origin/$current_branch"
          return 1
        fi
      fi
      ;;
    remote_parent_ref)
      if parent_has_remote_push_target "$parent_branch"; then
        if ! GIT_BYPASS_HOOKS=true git push origin "$expected_tip:$parent_branch" >/dev/null 2>&1; then
          set_verify_failure "$failure_kind" "failed to align remote parent branch origin/$parent_branch"
          return 1
        fi
      fi
      ;;
    checked_out_branch)
      if [[ "$current_is_local" == true ]]; then
        if ! git switch "$current_branch" >/dev/null 2>&1; then
          set_verify_failure "$failure_kind" "failed to restore current branch '$current_branch' after repair"
          return 1
        fi
      else
        if has_remote_branch "$current_branch"; then
          if ! git switch --detach "origin/$current_branch" >/dev/null 2>&1; then
            set_verify_failure "$failure_kind" "failed to restore detached branch origin/$current_branch after repair"
            return 1
          fi
        elif ! git switch --detach "$expected_tip" >/dev/null 2>&1; then
          set_verify_failure "$failure_kind" "failed to restore detached expected merge tip after repair"
          return 1
        fi
      fi
      ;;
    worktree_dirty)
      set_verify_failure "$failure_kind" "worktree became dirty after merge; auto-repair is intentionally disabled for this condition"
      return 1
      ;;
    *)
      set_verify_failure "$failure_kind" "no targeted repair rule for verification failure kind '$failure_kind'"
      return 1
      ;;
  esac

  return 0
}

ensure_post_merge_sync_or_repair() {
  local current_branch="$1"
  local parent_branch="$2"
  local current_is_local="$3"
  local expected_tip="$4"

  if verify_post_merge_sync "$current_branch" "$parent_branch" "$current_is_local" "$expected_tip"; then
    return 0
  fi

  bt_warn "Post-merge sync verification failed: $VERIFY_LAST_ERROR"
  bt_warn "Failure kind: ${VERIFY_FAILURE_KIND:-unknown}"
  bt_warn "Attempting automatic repair and retrying verification once"

  if ! attempt_post_merge_sync_repair "$current_branch" "$parent_branch" "$current_is_local" "$expected_tip" "$VERIFY_FAILURE_KIND"; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Post-merge sync auto-repair failed: $VERIFY_LAST_ERROR"
  fi

  if verify_post_merge_sync "$current_branch" "$parent_branch" "$current_is_local" "$expected_tip"; then
    if [[ "$VERBOSE" == true ]]; then
      bt_info "Post-merge sync verification passed after one automatic repair attempt"
    fi
    return 0
  fi

  bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Post-merge verification failed after one repair attempt: $VERIFY_LAST_ERROR"
}

resolve_detached_current_remote_branch() {
  local remote_ref=""
  local match_count=0
  local ref
  local first_match=""
  local -a matched_refs=()

  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    [[ "$ref" == "origin/HEAD" ]] && continue
    remote_ref="$ref"
    if [[ -z "$first_match" ]]; then
      first_match="$ref"
    fi
    matched_refs+=("$ref")
    match_count=$((match_count + 1))
  done < <(git for-each-ref --format='%(refname:short)' --points-at HEAD refs/remotes/origin)

  if [[ "$match_count" -eq 1 ]]; then
    echo "${remote_ref#origin/}"
    return 0
  fi

  if [[ "$match_count" -gt 1 ]]; then
    local baseline_parent=""
    local baseline_pr_required=""
    local baseline_protected_mode=""
    local same_behavior=true
    local branch=""
    local parent=""
    local pr_required="false"
    local protected_mode="normal"
    local -a candidate_branches=()
    local -a candidate_parents=()
    local -a candidate_pr_required=()
    local -a candidate_protected_mode=()

    for ref in "${matched_refs[@]}"; do
      branch="${ref#origin/}"
      parent="$(get_parent_branch "$branch")"

      pr_required="false"
      if is_pr_required "$branch" "$parent"; then
        pr_required="true"
      fi

      protected_mode="normal"
      if bt_is_protected_branch "$branch"; then
        if bt_is_version_branch "$branch" && [[ "$parent" == "main" ]]; then
          protected_mode="version-to-main"
        else
          protected_mode="invalid-protected-source"
        fi
      fi

      if [[ -z "$baseline_parent" ]]; then
        baseline_parent="$parent"
        baseline_pr_required="$pr_required"
        baseline_protected_mode="$protected_mode"
      elif [[ "$parent" != "$baseline_parent" || \
              "$pr_required" != "$baseline_pr_required" || \
              "$protected_mode" != "$baseline_protected_mode" ]]; then
        same_behavior=false
      fi

      candidate_branches+=("$branch")
      candidate_parents+=("$parent")
      candidate_pr_required+=("$pr_required")
      candidate_protected_mode+=("$protected_mode")
    done

    if [[ "$same_behavior" == false ]]; then
      local i=0
      local merge_eligible_count=0
      local merge_eligible_index=-1
      local local_present_count=0
      local local_present_index=-1

      # Safe case 1: exactly one merge-eligible candidate.
      # Safe case 2: if multiple merge-eligible candidates exist, exactly one
      # has a local counterpart branch.
      for ((i = 0; i < ${#candidate_branches[@]}; i++)); do
        if [[ "${candidate_protected_mode[$i]}" != "invalid-protected-source" ]]; then
          merge_eligible_count=$((merge_eligible_count + 1))
          merge_eligible_index=$i

          if has_local_branch "${candidate_branches[$i]}"; then
            local_present_count=$((local_present_count + 1))
            local_present_index=$i
          fi
        fi
      done

      if [[ "$merge_eligible_count" -eq 1 ]]; then
        bt_info "Detached HEAD matches multiple remote branches with different behavior; safely selecting merge-eligible origin/${candidate_branches[$merge_eligible_index]}"
        echo "${candidate_branches[$merge_eligible_index]}"
        return 0
      fi

      if [[ "$merge_eligible_count" -gt 1 && "$local_present_count" -eq 1 ]]; then
        bt_info "Detached HEAD matches multiple remote branches with different behavior; safely selecting local-backed origin/${candidate_branches[$local_present_index]}"
        echo "${candidate_branches[$local_present_index]}"
        return 0
      fi

      bt_error_exit "$EXIT_INVALID_ARGUMENT" \
        "Detached HEAD matches multiple remote branches with different parent/merge behavior"
    fi

    bt_info "Detached HEAD matches multiple remote branches; selecting origin/${first_match#origin/}"
    echo "${first_match#origin/}"
    return 0
  fi

  return 1
}

trim_whitespace() {
  local value="$1"
  value="${value#${value%%[![:space:]]*}}"
  value="${value%${value##*[![:space:]]}}"
  printf '%s' "$value"
}

ensure_branch_synced_with_remote() {
  local branch="$1"
  local label="$2"
  local exit_code="$3"

  if ! has_remote_branch "$branch"; then
    bt_error_exit "$exit_code" "$label branch '$branch' has no origin/$branch reference"
  fi

  local ahead_behind
  local ahead
  local behind
  ahead_behind=$(git rev-list --left-right --count "origin/$branch...$branch" 2>/dev/null || echo "")
  ahead="${ahead_behind%%$'\t'*}"
  behind="${ahead_behind##*$'\t'}"

  if [[ ! "$ahead" =~ ^[0-9]+$ || ! "$behind" =~ ^[0-9]+$ ]]; then
    bt_error_exit "$exit_code" "Unable to determine $label branch sync state for '$branch'"
  fi

  if [[ "$ahead" -ne 0 || "$behind" -ne 0 ]]; then
    bt_error_exit "$exit_code" "$label branch '$branch' is not in sync with origin/$branch"
  fi
}

resolve_parent_reference() {
  local parent_branch="$1"

  if [[ "$parent_branch" == "main" ]]; then
    echo "origin/main"
    return 0
  fi

  if has_local_branch "$parent_branch"; then
    echo "$parent_branch"
    return 0
  fi

  if has_remote_branch "$parent_branch"; then
    echo "origin/$parent_branch"
    return 0
  fi

  bt_error_exit "$EXIT_PARENT_MISSING" "Unable to resolve parent branch reference for '$parent_branch'"
}

ensure_current_up_to_date_with_parent() {
  local current_branch="$1"
  local parent_branch="$2"
  local parent_ref
  local current_ref="$current_branch"

  parent_ref=$(resolve_parent_reference "$parent_branch")

  if ! has_local_branch "$current_branch"; then
    if has_remote_branch "$current_branch"; then
      current_ref="origin/$current_branch"
    else
      bt_error_exit "$EXIT_CURRENT_NOT_SYNCED" "Unable to resolve current branch reference for '$current_branch'"
    fi
  fi

  if ! git merge-base --is-ancestor "$parent_ref" "$current_ref" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_CURRENT_BEHIND_PARENT" "Current branch '$current_branch' is not up-to-date with parent '$parent_branch'"
  fi
}

warn_downstream_targeted_branches_behind_version() {
  local version_branch="$1"
  local version_ref="$1"
  local version_regex=""
  local branch=""
  local branch_ref=""
  local counts=""
  local behind=""
  local ahead=""
  local -a behind_branches=()

  if ! bt_is_version_branch "$version_branch"; then
    return 0
  fi

  if ! has_local_branch "$version_branch" && has_remote_branch "$version_branch"; then
    version_ref="origin/$version_branch"
  fi

  version_regex="${version_branch//./\\.}"

  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    [[ "$branch" == "$version_branch" ]] && continue

    if [[ ! "$branch" =~ ^(dev|fix)/.+-${version_regex}$ ]]; then
      continue
    fi

    branch_ref="$branch"
    if ! has_local_branch "$branch" && has_remote_branch "$branch"; then
      branch_ref="origin/$branch"
    elif ! has_local_branch "$branch" && ! has_remote_branch "$branch"; then
      continue
    fi

    counts="$(git rev-list --left-right --count "$version_ref...$branch_ref" 2>/dev/null || true)"
    [[ -n "$counts" ]] || continue

    behind="${counts%%$'\t'*}"
    ahead="${counts##*$'\t'}"
    if [[ "$behind" =~ ^[0-9]+$ && "$ahead" =~ ^[0-9]+$ && "$behind" -gt 0 ]]; then
      behind_branches+=("$branch")
    fi
  done < <(
    {
      git for-each-ref --format='%(refname:short)' refs/heads
      git for-each-ref --format='%(refname:short)' refs/remotes/origin
    } | sed 's#^origin/##' | sort -u
  )

  if [[ ${#behind_branches[@]} -gt 0 ]]; then
    bt_warn "Downstream sync needed: ${#behind_branches[@]} targeted branch(es) are now behind '$version_branch'. Run mrgdown on each affected branch."
    if [[ "$VERBOSE" == true ]]; then
      for branch in "${behind_branches[@]}"; do
        bt_info "  behind: $branch"
      done
    fi
  fi
}

is_targeted_branch() {
  local branch="$1"
  [[ "$branch" =~ ^(dev|fix)/.+-(v[1-9][0-9]?\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?))$ ]]
}

is_contributor_branch() {
  local branch="$1"

  if bt_is_protected_branch "$branch" || is_targeted_branch "$branch"; then
    return 1
  fi

  return 0
}

is_pr_required() {
  local current_branch="$1"
  local parent_branch="$2"

  # Usage contract: PR is required when merging up to a version branch
  # unless owner override is active.
  if bt_is_version_branch "$parent_branch"; then
    return 0
  fi

  return 1
}

build_default_commit_message() {
  local current_branch="$1"
  local parent_branch="$2"
  local actor="$3"

  if bt_is_version_branch "$current_branch" && [[ "$parent_branch" == "main" ]]; then
    echo "$current_branch merged to origin/main by approver $actor."
    return 0
  fi

  if is_targeted_branch "$current_branch" && bt_is_version_branch "$parent_branch"; then
    echo "$current_branch merged to $parent_branch by owner $actor."
    return 0
  fi

  if is_contributor_branch "$current_branch" && \
    (is_targeted_branch "$parent_branch" || is_contributor_branch "$parent_branch"); then
    echo "$current_branch merged to $parent_branch by contributor $actor."
    return 0
  fi

  bt_error_exit "$EXIT_INVALID_ARGUMENT" "No default commit message rule applies for '$current_branch' -> '$parent_branch'"
}

branch_to_history_file() {
  local branch="$1"
  local slug="${branch//\//.}"
  echo "logs/${slug}_history.md"
}

# Remove branch-specific files that should not carry over to the parent branch
# after a squash merge: branch reports from reports/branch/ (except README.md
# and mergeto-*.md) and history log files belonging to other branches.
cleanup_merged_branch_files() {
  local current_branch="$1"
  local parent_branch="$2"
  local parent_slug="${parent_branch//\//.}"
  local current_slug="${current_branch//\//.}"

  local report_files
  mapfile -t report_files < <(
    git ls-files -- 'reports/branch/' \
      | grep -Ev '(^|/)README\.md$|(^|/)mergeto-[^/]*\.md$'
  )
  if [[ ${#report_files[@]} -gt 0 ]]; then
    git rm -f --ignore-unmatch -- "${report_files[@]}" >/dev/null 2>&1 || true
  fi

  local history_files
  mapfile -t history_files < <(
    git ls-files -- 'logs/' \
      | grep '_history\.md$' \
      | grep -Fv "logs/${parent_slug}_history.md" \
      | grep -Fv "logs/${current_slug}_history.md"
  )
  if [[ ${#history_files[@]} -gt 0 ]]; then
    git rm -f --ignore-unmatch -- "${history_files[@]}" >/dev/null 2>&1 || true
  fi

  if [[ "$VERBOSE" == true ]]; then
    bt_info "Cleaned up branch-specific files from merge"
  fi
}

cleanup_untracked_branch_reports_for_merge() {
  local reports_dir="reports/branch"
  local report_file
  local rel_path
  local removed_count=0

  [[ -d "$reports_dir" ]] || return 0

  # Allow temporary cleanup in report directory when directory lock is active.
  chmod u+w "$reports_dir" >/dev/null 2>&1 || true

  while IFS= read -r report_file; do
    [[ -n "$report_file" ]] || continue
    rel_path="${report_file#./}"

    # Keep README and merge summary artifacts; remove only generated run reports.
    case "$rel_path" in
      reports/branch/README.md|reports/branch/mergeto-*.md)
        continue
        ;;
    esac

    if rm -f -- "$rel_path" >/dev/null 2>&1; then
      removed_count=$((removed_count + 1))
    fi
  done < <(git ls-files --others --exclude-standard -- "$reports_dir"/*.md 2>/dev/null || true)

  chmod a-w "$reports_dir" >/dev/null 2>&1 || true

  if [[ "$VERBOSE" == true && "$removed_count" -gt 0 ]]; then
    bt_info "Removed $removed_count untracked report artifact(s) before merge"
  fi
}

checkout_parent_branch() {
  local parent_branch="$1"

  if [[ "$parent_branch" == "main" ]]; then
    if ! git switch --detach "origin/$parent_branch" >/dev/null 2>&1; then
      bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to switch to remote parent branch '$parent_branch'"
    fi
    PARENT_CHECKOUT_ACTIVE=true
    return 0
  fi

  if git show-ref --verify --quiet "refs/heads/$parent_branch"; then
    if ! git switch "$parent_branch" >/dev/null 2>&1; then
      bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to switch to parent branch '$parent_branch'"
    fi
    PARENT_CHECKOUT_ACTIVE=true
  else
    if ! git switch -c "$parent_branch" --track "origin/$parent_branch" >/dev/null 2>&1; then
      bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to create local parent branch '$parent_branch'"
    fi
    TEMP_PARENT_BRANCH_CREATED=true
    TEMP_PARENT_BRANCH_NAME="$parent_branch"
    PARENT_CHECKOUT_ACTIVE=true
  fi
}

cleanup_temporary_parent_branch() {
  if [[ "$TEMP_PARENT_BRANCH_CREATED" != true || -z "$TEMP_PARENT_BRANCH_NAME" ]]; then
    return 0
  fi

  # Ensure we are not currently on the temporary parent branch.
  local now_branch
  now_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [[ "$now_branch" == "$TEMP_PARENT_BRANCH_NAME" ]]; then
    if [[ "$CURRENT_IS_LOCAL" == true ]]; then
      if ! git switch "$CURRENT_BRANCH" >/dev/null 2>&1; then
        bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to leave temporary parent branch '$TEMP_PARENT_BRANCH_NAME'"
      fi
    else
      if ! git switch --detach "origin/$CURRENT_BRANCH" >/dev/null 2>&1; then
        bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to leave temporary parent branch '$TEMP_PARENT_BRANCH_NAME'"
      fi
    fi
  fi

  if ! git branch -D "$TEMP_PARENT_BRANCH_NAME" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to remove temporary parent branch '$TEMP_PARENT_BRANCH_NAME'"
  fi

  bt_info "Removed temporary local parent branch '$TEMP_PARENT_BRANCH_NAME'"
}

is_approver() {
  local user_name="$1"

  # Reuse shared role-check helper for consistent contributors.md parsing.
  GITHUB_ACTOR="$user_name" \
    bash "$SCRIPT_DIR/../helpers/ckrole.sh" approver >/dev/null 2>&1
}

get_existing_pr_number() {
  local branch="$1"

  bt_gh_find_pr_number_for_branch "$branch" "open"
}

get_pr_title() {
  local pr_number="$1"
  
  # Get PR title
  gh pr view "$pr_number" --json title --jq '.title' 2>/dev/null || echo ""
}

get_pr_validation_fields() {
  local pr_number="$1"

  gh pr view "$pr_number" \
    --json state,isDraft,headRefName,baseRefName,reviewDecision,mergedAt \
    --jq '[.state, (.isDraft|tostring), .headRefName, .baseRefName, .reviewDecision, (.mergedAt // "")] | @tsv' \
    2>/dev/null || echo ""
}

validate_pr_for_merge() {
  local pr_number="$1"
  local current_branch="$2"
  local parent_branch="$3"
  local fields=""
  local state=""
  local is_draft=""
  local head_ref=""
  local base_ref=""
  local review_decision=""
  local merged_at=""

  fields="$(get_pr_validation_fields "$pr_number")"
  if [[ -z "$fields" ]]; then
    bt_error_exit "$EXIT_INVALID_ARGUMENT" "Pull request #$pr_number is missing required metadata"
  fi

  IFS=$'\t' read -r state is_draft head_ref base_ref review_decision merged_at <<< "$fields"

  if [[ -n "$merged_at" || "$state" == "MERGED" ]]; then
    bt_error_exit "$EXIT_PR_ALREADY_MERGED" "Pull request #$pr_number indicates already merged"
  fi

  if [[ "$state" != "OPEN" ]]; then
    bt_error_exit "$EXIT_PR_NOT_OPEN" "Pull request #$pr_number is not open"
  fi

  if [[ "$is_draft" == "true" ]]; then
    bt_error_exit "$EXIT_PR_DRAFT" "Pull request #$pr_number is a draft"
  fi

  if [[ "$head_ref" != "$current_branch" ]]; then
    bt_error_exit "$EXIT_PR_HEAD_MISMATCH" "Pull request #$pr_number head is not current branch '$current_branch'"
  fi

  if [[ "$base_ref" != "$parent_branch" ]]; then
    bt_error_exit "$EXIT_PR_BASE_MISMATCH" "Pull request #$pr_number base is not parent branch '$parent_branch'"
  fi

  if [[ "$review_decision" == "CHANGES_REQUESTED" ]]; then
    bt_error_exit "$EXIT_PR_HAS_CHANGES_REQUESTED" "Pull request #$pr_number has outstanding changes requested"
  fi

  if [[ "$review_decision" != "APPROVED" ]]; then
    bt_error_exit "$EXIT_PR_NOT_APPROVED" "Pull request #$pr_number is not approved"
  fi
}

is_ci_or_cd_check_line_failure() {
  local check_state="$1"

  case "$check_state" in
    FAILURE|ERROR|CANCELLED|TIMED_OUT|ACTION_REQUIRED|EXPECTED|PENDING)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

check_ci_cd_statuses() {
  local pr_number="$1"
  local checks_text=""
  local line=""
  local check_name=""
  local check_state=""
  local ci_failed=false
  local cd_failed=false

  bt_info "Checking CI/CD statuses..."

  checks_text="$(gh pr view "$pr_number" --json statusCheckRollup \
    --jq '.statusCheckRollup[]? | "\((.name // .context // .workflowName // "")|ascii_downcase)\t\((.state // .conclusion // "")|ascii_upcase)"' \
    2>/dev/null || true)"

  # When no checks are present, do not block merge.
  if [[ -z "$checks_text" ]]; then
    bt_info "No CI/CD checks found"
    return 0
  fi

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue

    if [[ "$line" == *$'\t'* ]]; then
      check_name="${line%%$'\t'*}"
      check_state="${line##*$'\t'}"
    else
      # Compatibility fallback for simple state-only output.
      check_name=""
      check_state="$line"
    fi

    check_state="${check_state^^}"
    if ! is_ci_or_cd_check_line_failure "$check_state"; then
      case "$check_state" in
        SUCCESS|SKIPPED|NEUTRAL)
          continue
          ;;
        *)
          # Unknown states are treated as blocking.
          check_state="ERROR"
          ;;
      esac
    fi

    if [[ -z "$check_name" ]]; then
      ci_failed=true
      cd_failed=true
      continue
    fi

    if [[ "$check_name" == *"ci"* ]]; then
      ci_failed=true
    fi
    if [[ "$check_name" == *"cd"* ]]; then
      cd_failed=true
    fi

    # For non-labeled checks, conservatively block both signals.
    if [[ "$check_name" != *"ci"* && "$check_name" != *"cd"* ]]; then
      ci_failed=true
      cd_failed=true
    fi
  done <<< "$checks_text"

  if [[ "$ci_failed" == true && "$cd_failed" == true ]]; then
    return "$EXIT_CI_AND_CD_FAILED"
  fi
  if [[ "$ci_failed" == true ]]; then
    return "$EXIT_CI_FAILED"
  fi
  if [[ "$cd_failed" == true ]]; then
    return "$EXIT_CD_FAILED"
  fi

  return 0
}

ensure_clean_worktree() {
  if bt_is_worktree_dirty; then
    bt_error_exit "$EXIT_CURRENT_UNCOMMITTED" "Current branch has uncommitted changes. Commit first before running mrgup"
  fi
}

log_merge_to_history() {
  local branch="$1"
  local target_branch="$2"
  local approver="$3"
  local message="$4"
  local history_file="$5"
  local history_entry="$6"

  mkdir -p "$(dirname "$history_file")"
  
  # Create history file if it doesn't exist
  if [[ ! -f "$history_file" ]]; then
    cat > "$history_file" << 'EOF'
# Branch History

Copyright (c) 2026 Paul Sinclair  
SPDX-License-Identifier: MIT  
For license details, see `LICENSE` in the repository root.

See `README.md` in the root directory for an introduction to the project.

## Merge Log

EOF
  fi
  
  # Append merge entry
  printf '%s\n' "$history_entry" >> "$history_file"
  
  bt_info "Logged merge to $history_file"
}

build_history_entry() {
  local branch="$1"
  local target_branch="$2"
  local approver="$3"
  local message="$4"

  printf '%s' "- [$RUN_TS_DISPLAY] [$approver] Merged [$branch] to [$target_branch]: $message"
}

preflight_current_history_sync_push() {
  local current_branch="$1"

  # If there is no remote current branch, there is nothing to preflight.
  if ! has_remote_branch "$current_branch"; then
    return 0
  fi

  # Current branches are aligned to parent tip after successful merge;
  # verify force-with-lease capability before mutation.
  if ! GIT_BYPASS_HOOKS=true git push --dry-run --force-with-lease origin "HEAD:$current_branch" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" \
      "Preflight failed: unable to verify force-with-lease push access for origin/$current_branch required for post-merge alignment"
  fi

  if [[ "$VERBOSE" == true ]]; then
    bt_info "Preflight: post-merge alignment push check passed for origin/$current_branch"
  fi
}

sync_local_parent_branch_ref() {
  local parent_branch="$1"
  local parent_tip="$2"
  local now_branch=""

  if ! has_local_branch "$parent_branch"; then
    return 0
  fi

  # If the parent branch is currently checked out, it is already at parent_tip
  # during this phase of mrgup and cannot be force-updated with git branch -f.
  now_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [[ "$now_branch" == "$parent_branch" ]]; then
    return 0
  fi

  if ! git branch -f "$parent_branch" "$parent_tip" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to align local parent branch '$parent_branch'"
  fi

  if [[ "$VERBOSE" == true ]]; then
    bt_info "Aligned local parent branch '$parent_branch' to merged parent tip"
  fi
}

align_current_branch_to_parent_tip() {
  local current_branch="$1"
  local parent_branch="$2"
  local current_is_local="$3"

  # HEAD is on the merged parent tip at this point; reuse that exact commit
  # for source-branch alignment.
  local parent_tip
  parent_tip="$(git rev-parse HEAD 2>/dev/null || true)"
  if [[ -z "$parent_tip" ]]; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to resolve merged parent tip"
  fi

  sync_local_parent_branch_ref "$parent_branch" "$parent_tip"

  if ! git branch -f "$current_branch" "$parent_tip" >/dev/null 2>&1; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to align '$current_branch' to merged parent '$parent_branch'"
  fi

  if [[ "$current_is_local" == true ]]; then
    if ! git switch "$current_branch" >/dev/null 2>&1; then
      bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to switch back to '$current_branch'"
    fi
  else
    if ! git switch --detach "$parent_tip" >/dev/null 2>&1; then
      bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to switch to aligned detached tip for '$current_branch'"
    fi
  fi

  if has_remote_branch "$current_branch"; then
    if [[ "$current_is_local" == true ]]; then
      if ! GIT_BYPASS_HOOKS=true git push --force-with-lease origin "$current_branch" >/dev/null 2>&1; then
        bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to push aligned source branch to origin/$current_branch"
      fi
    else
      if ! GIT_BYPASS_HOOKS=true git push --force-with-lease origin "$parent_tip:$current_branch" >/dev/null 2>&1; then
        bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to push aligned detached source tip to origin/$current_branch"
      fi
      if ! git switch --detach "origin/$current_branch" >/dev/null 2>&1; then
        bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to refresh detached checkout to origin/$current_branch"
      fi
    fi
  fi

  PARENT_CHECKOUT_ACTIVE=false

  if [[ "$VERBOSE" == true ]]; then
    bt_info "Aligned source branch '$current_branch' to merged parent tip"
  fi
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -c)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -c requires a commit comment token"
      fi
      if [[ -n "$MESSAGE_SOURCE" ]]; then
        usage_error "-c TOKEN and -- TOKENS are mutually exclusive"
      fi
      CUSTOM_MESSAGE="$2"
      MESSAGE_SOURCE="option"
      shift 2
      ;;
    -d)
      DRY_RUN=true
      shift
      ;;
    -o)
      OWNER_OVERRIDE=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    --)
      shift
      if [[ $# -eq 0 ]]; then
        usage_error "'-- TOKENS' requires at least one token"
      fi
      if [[ -n "$MESSAGE_SOURCE" ]]; then
        usage_error "-c TOKEN and -- TOKENS are mutually exclusive"
      fi
      CUSTOM_MESSAGE="$*"
      MESSAGE_SOURCE="tokens"
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      usage_error "Unknown argument: $1"
      ;;
  esac
done

if [[ -n "$MESSAGE_SOURCE" ]]; then
  CUSTOM_MESSAGE="$(trim_whitespace "$CUSTOM_MESSAGE")"
  if [[ -z "$CUSTOM_MESSAGE" ]]; then
    bt_error_exit "$EXIT_EMPTY_COMMIT_COMMENT" \
      "Commit comment is specified but it is empty after normalization"
  fi
fi

# Lock after argument parsing. Help/usage exits do not require repository lock.
acquire_run_lock

if ! is_remote_connected; then
  bt_error_exit "$EXIT_REMOTE_UNREACHABLE" "Remote 'origin' is not connected"
fi

git fetch origin >/dev/null 2>&1 || bt_error_exit "$EXIT_REMOTE_UNREACHABLE" "Failed to fetch from remote 'origin'"

# Propagate repository history from remote if available.
# Under set -e, capture non-zero statuses explicitly because status 2 is a
# documented non-fatal outcome (offline/file unavailable/fetch skipped).
history_sync_rc=0
bt_propagate_repository_history || history_sync_rc=$?
case "$history_sync_rc" in
  0) ;;
  1) bt_info "Updated repository history from remote" ;;
  *) ;;
esac

# Get current branch
CURRENT_BRANCH=$(bt_get_current_branch || \
  bt_error_exit "$EXIT_INVALID_ARGUMENT" "Failed to determine current branch")

if [[ "$CURRENT_BRANCH" == "HEAD" ]]; then
  DETACHED_REMOTE_BRANCH="$(resolve_detached_current_remote_branch || true)"
  if [[ -z "$DETACHED_REMOTE_BRANCH" ]]; then
    usage_error "Cannot determine remote-only current branch from detached HEAD"
  fi

  CURRENT_BRANCH="$DETACHED_REMOTE_BRANCH"
  CURRENT_IS_LOCAL=false
  CURRENT_SOURCE_REF="origin/$CURRENT_BRANCH"
  bt_info "Current branch: $CURRENT_BRANCH (remote-only origin/$CURRENT_BRANCH)"
else
  bt_info "Current branch: $CURRENT_BRANCH"
fi

if [[ "$CURRENT_IS_LOCAL" == true ]]; then
  if ! has_local_branch "$CURRENT_BRANCH"; then
    if has_remote_branch "$CURRENT_BRANCH"; then
      CURRENT_IS_LOCAL=false
      CURRENT_SOURCE_REF="origin/$CURRENT_BRANCH"
    else
      bt_error_exit "$EXIT_INVALID_ARGUMENT" "Current branch '$CURRENT_BRANCH' is not resolvable locally or remotely"
    fi
  else
    CURRENT_SOURCE_REF="$CURRENT_BRANCH"
  fi
fi

if [[ -z "$CURRENT_SOURCE_REF" ]]; then
  CURRENT_SOURCE_REF="$CURRENT_BRANCH"
fi

# Get current user
CURRENT_USER=$(get_current_user)
bt_info "Current user: $CURRENT_USER"

if [[ "$OWNER_OVERRIDE" == true ]]; then
  if is_repository_owner "$CURRENT_USER"; then
    OWNER_OVERRIDE_ACTIVE=true
    bt_info "Owner override enabled for repository owner '$CURRENT_USER'"
  else
    bt_error_exit "$EXIT_NOT_REPOSITORY_OWNER" "Option -o is allowed only for the repository owner"
  fi
fi

# Determine parent branch
bt_info "Determining parent branch..."
PARENT_BRANCH=$(get_parent_branch "$CURRENT_BRANCH")
bt_info "Parent branch: $PARENT_BRANCH"

# Validate branch names conform to naming conventions
if ! validate_branch_name "$CURRENT_BRANCH" "current branch"; then
  usage_error "Current branch does not conform to naming conventions"
fi

if ! validate_branch_name "$PARENT_BRANCH" "parent branch"; then
  usage_error "Parent branch does not conform to naming conventions"
fi

if bt_is_protected_branch "$CURRENT_BRANCH"; then
  if ! bt_is_version_branch "$CURRENT_BRANCH" || [[ "$PARENT_BRANCH" != "main" ]]; then
    bt_error_exit 1 \
      "Current branch '$CURRENT_BRANCH' is protected. Run mrgup from a non-protected branch."
  fi

  if [[ "$OWNER_OVERRIDE_ACTIVE" != true ]] && ! is_approver "$CURRENT_USER"; then
    bt_error_exit "$EXIT_NOT_APPROVER" "User '$CURRENT_USER' is not an approver. Only approvers can merge protected branches to origin/main."
  fi
fi

ensure_clean_worktree
if [[ "$CURRENT_IS_LOCAL" == true ]]; then
  ensure_branch_synced_with_remote "$CURRENT_BRANCH" "Current" "$EXIT_CURRENT_NOT_SYNCED"
else
  if ! has_remote_branch "$CURRENT_BRANCH"; then
    bt_error_exit "$EXIT_CURRENT_NOT_SYNCED" "Current branch '$CURRENT_BRANCH' has no origin/$CURRENT_BRANCH reference"
  fi
fi

if has_local_branch "$PARENT_BRANCH" && has_remote_branch "$PARENT_BRANCH"; then
  ensure_branch_synced_with_remote "$PARENT_BRANCH" "Parent" "$EXIT_PARENT_NOT_SYNCED"
fi

ensure_current_up_to_date_with_parent "$CURRENT_BRANCH" "$PARENT_BRANCH"
preflight_current_history_sync_push "$CURRENT_BRANCH"

# Check if parent branch is protected
if bt_is_protected_branch "$PARENT_BRANCH"; then
  bt_info "Parent branch is protected"
  
  # Verify current user is an approver
  if [[ "$OWNER_OVERRIDE_ACTIVE" != true ]] && ! is_approver "$CURRENT_USER"; then
    bt_error_exit "$EXIT_NOT_APPROVER" "User '$CURRENT_USER' is not an approver. Only approvers can merge to protected branches."
  fi
  if [[ "$OWNER_OVERRIDE_ACTIVE" == true ]]; then
    if [[ "$VERBOSE" == true ]]; then
      bt_success "User '$CURRENT_USER' is repository owner (approver check bypassed with -o)"
    fi
  else
    if [[ "$VERBOSE" == true ]]; then
      bt_success "User '$CURRENT_USER' is an approver"
    fi
  fi
else
  bt_info "Parent branch is not protected"
fi

# Determine whether a PR is required for this merge path.
PR_REQUIRED=true
if [[ "$OWNER_OVERRIDE_ACTIVE" == true ]]; then
  PR_REQUIRED=false
  bt_info "Owner override enabled: PR is not required for this merge"
elif is_pr_required "$CURRENT_BRANCH" "$PARENT_BRANCH"; then
  PR_REQUIRED=true
else
  PR_REQUIRED=false
fi

PR_NUMBER=""
if [[ "$PR_REQUIRED" == true ]]; then
  PR_NUMBER=$(get_existing_pr_number "$CURRENT_BRANCH")
  if [[ -z "$PR_NUMBER" ]]; then
    bt_error_exit "$EXIT_PR_MISSING" "No open PR found for branch '$CURRENT_BRANCH'"
  fi
  bt_info "Found PR #$PR_NUMBER"

  validate_pr_for_merge "$PR_NUMBER" "$CURRENT_BRANCH" "$PARENT_BRANCH"
else
  bt_info "PR not required for '$CURRENT_BRANCH' -> '$PARENT_BRANCH'"

  PR_NUMBER=$(get_existing_pr_number "$CURRENT_BRANCH")
  if [[ -n "$PR_NUMBER" ]]; then
    bt_info "Found PR #$PR_NUMBER; validating PR state"
    validate_pr_for_merge "$PR_NUMBER" "$CURRENT_BRANCH" "$PARENT_BRANCH"
  else
    if [[ "$VERBOSE" == true ]]; then
      bt_info "PR validation skipped (a PR does not exist and is not required)"
    fi
  fi
fi

# CI/CD checks are evaluated only when a PR exists.
if [[ -n "$PR_NUMBER" ]]; then
  ci_cd_exit=0
  check_ci_cd_statuses "$PR_NUMBER" || ci_cd_exit=$?

  if [[ "$ci_cd_exit" -ne 0 ]]; then
    if bt_is_version_branch "$PARENT_BRANCH" && [[ "$OWNER_OVERRIDE_ACTIVE" != true ]]; then
      CI_CD_DRY_RUN_EXIT="$ci_cd_exit"
      DRY_RUN=true
      bt_warn "CI/CD checks failed for PR #$PR_NUMBER; proceeding as dry run due to version-branch fallback policy"
    else
      bt_error_exit "$ci_cd_exit" "CI/CD checks failed for PR #$PR_NUMBER"
    fi
  fi
fi

# Determine commit message
if [[ -n "$CUSTOM_MESSAGE" ]]; then
  COMMIT_MESSAGE="$CUSTOM_MESSAGE"
  bt_info "Using custom message: $COMMIT_MESSAGE"
else
  if [[ -n "$PR_NUMBER" ]]; then
    COMMIT_MESSAGE=$(get_pr_title "$PR_NUMBER")
    if [[ -z "$COMMIT_MESSAGE" ]]; then
      bt_error_exit "$EXIT_INVALID_ARGUMENT" "Failed to get PR title"
    fi
    bt_info "Using PR title as message: $COMMIT_MESSAGE"
  else
    COMMIT_MESSAGE=$(build_default_commit_message \
      "$CURRENT_BRANCH" "$PARENT_BRANCH" "$CURRENT_USER")
    bt_info "Using default message: $COMMIT_MESSAGE"
  fi
fi

HISTORY_FILE=$(branch_to_history_file "$PARENT_BRANCH")
HISTORY_ENTRY=$(build_history_entry \
  "$CURRENT_BRANCH" "$PARENT_BRANCH" "$CURRENT_USER" "$COMMIT_MESSAGE")
CURRENT_HISTORY_FILE=$(branch_to_history_file "$CURRENT_BRANCH")

if [[ "$DRY_RUN" == true ]]; then
  bt_success "0 files updated, 0 new files, and 0 files deleted."
  bt_success "Branch '$CURRENT_BRANCH' merged to '$PARENT_BRANCH' (dry run)."

  if [[ "$CI_CD_DRY_RUN_EXIT" -ne 0 ]]; then
    exit "$CI_CD_DRY_RUN_EXIT"
  fi

  exit 0
fi

# Perform squash merge
bt_info "Performing squash merge..."

checkout_parent_branch "$PARENT_BRANCH"

cleanup_untracked_branch_reports_for_merge
unlock_reports_branch_dir_for_merge

if [[ "$PARENT_BRANCH" != "main" ]] && parent_has_remote_push_target "$PARENT_BRANCH"; then
  if ! bt_run_cmd git pull --ff-only origin "$PARENT_BRANCH"; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to fast-forward parent branch '$PARENT_BRANCH'"
  fi
fi

if ! bt_run_cmd git merge --squash --no-commit "$CURRENT_SOURCE_REF"; then
  bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to squash merge '$CURRENT_BRANCH' into '$PARENT_BRANCH'"
fi

# Remove branch-specific files that should not carry over to the parent branch.
cleanup_merged_branch_files "$CURRENT_BRANCH" "$PARENT_BRANCH"

# Log merge to history before committing so the audit record is preserved.
log_merge_to_history "$CURRENT_BRANCH" "$PARENT_BRANCH" \
  "$CURRENT_USER" "$COMMIT_MESSAGE" "$HISTORY_FILE" "$HISTORY_ENTRY"
GIT_BYPASS_HOOKS=true git add "$HISTORY_FILE" 2>/dev/null || true

if [[ "$CURRENT_HISTORY_FILE" != "$HISTORY_FILE" ]]; then
  log_merge_to_history "$CURRENT_BRANCH" "$PARENT_BRANCH" \
    "$CURRENT_USER" "$COMMIT_MESSAGE" "$CURRENT_HISTORY_FILE" "$HISTORY_ENTRY"
  GIT_BYPASS_HOOKS=true git add "$CURRENT_HISTORY_FILE" 2>/dev/null || true
fi

# Create commit with message
if ! GIT_BYPASS_HOOKS=true bt_run_cmd git commit -m "$COMMIT_MESSAGE"; then
  bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to create commit"
fi

MERGE_COMMIT_SHA="$(git rev-parse HEAD 2>/dev/null || true)"
if [[ -z "$MERGE_COMMIT_SHA" ]]; then
  bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Merge completed, but failed to resolve merge commit"
fi

# Push to remote
if parent_has_remote_push_target "$PARENT_BRANCH"; then
  bt_info "Pushing parent branch..."
  if [[ "$PARENT_BRANCH" == "main" ]]; then
    if ! GIT_BYPASS_HOOKS=true bt_run_cmd git push origin HEAD:"$PARENT_BRANCH"; then
      bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to push remote parent branch"
    fi
  else
    if ! GIT_BYPASS_HOOKS=true bt_run_cmd git push origin "$PARENT_BRANCH"; then
      bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to push parent branch"
    fi
  fi
else
  bt_info "Parent branch '$PARENT_BRANCH' has no remote branch; skipping push"
fi

align_current_branch_to_parent_tip "$CURRENT_BRANCH" "$PARENT_BRANCH" "$CURRENT_IS_LOCAL"
cleanup_temporary_parent_branch
relock_reports_branch_dir_after_merge
ensure_post_merge_sync_or_repair "$CURRENT_BRANCH" "$PARENT_BRANCH" "$CURRENT_IS_LOCAL" "$MERGE_COMMIT_SHA"

if bt_is_version_branch "$CURRENT_BRANCH" && [[ "$PARENT_BRANCH" == "main" ]]; then
  warn_downstream_targeted_branches_behind_version "$CURRENT_BRANCH"
fi

# Show verbose output if requested
if [[ "$VERBOSE" == true ]]; then
  bt_info "Merge details:"
  echo "  Branch: $CURRENT_BRANCH."
  echo "  Parent: $PARENT_BRANCH."
  echo "  Actor: $CURRENT_USER."
  echo "  PR: #$PR_NUMBER."
  echo "  Message: $COMMIT_MESSAGE."
fi

print_merge_change_summary "$MERGE_COMMIT_SHA"
bt_success "Branch '$CURRENT_BRANCH' merged to '$PARENT_BRANCH'."
exit 0
