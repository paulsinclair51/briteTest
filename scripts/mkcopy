#!/usr/bin/env bash

# mkcopy - Cherry-pick commits from one branch to another.
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default options
CUSTOM_MESSAGE=""
VERBOSE=false
CONTINUE_MODE=false
SOURCE_BRANCH=""

usage() {
  cat <<'EOF'
Usage:
  mkcopy SOURCE_BRANCH [OPTIONS]
  mkcopy --continue [OPTIONS]
  mkcopy -h | --help

Cherry-pick all commits from a source branch to the current branch.

Before cherry-picking:
  - Verifies current branch has no uncommitted changes
  - Fetches latest from remote
  - Cherry-picks all commits from source branch

If conflicts occur:
  - Script pauses and prompts to resolve conflicts manually
  - Run `mkcopy --continue` after resolving to complete the cherry-pick

Features:
  - Cherry-picks all commits from source branch
  - Auto-generates commit message or uses specified message
  - Handles conflicts with pause and resume
  - Validates clean working directory

Options:
  -h, --help           Output this help to stdout and exit.
  -m, --message MSG    Custom commit message for squashed result
                       Default: "Copy from source-branch to target-branch: message"
  -v, --verbose        Show detailed information
  --continue           Continue after resolving conflicts manually

Examples:
  # Cherry-pick from feature branch to current branch
  mkcopy feature-auth

  # Cherry-pick with custom message
  mkcopy feature-auth -m "Backport: Auth improvements"

  # Continue after resolving conflicts
  mkcopy --continue

  # Verbose output
  mkcopy feature-auth -v

Workflow:
  1. Cherry-pick commits: mkcopy source-branch
  2. If conflicts occur, resolve them manually
  3. Continue: mkcopy --continue
  4. Repeat steps 2-3 if more conflicts

Exit codes:
  0   Success
  1   Argument or validation error
  2   Git operation failed
  3   Working directory not clean
  4   Source branch not found
  5   Cherry-pick conflicts (pause for resolution)
EOF
}

info() {
  echo -e "${BLUE}ℹ${NC} $1"
}

success() {
  echo -e "${GREEN}✓${NC} $1"
}

warn() {
  echo -e "${YELLOW}⚠${NC} $1"
}

error_exit() {
  local code="$1"
  local message="$2"

  echo -e "${RED}Error:${NC} $message" >&2
  exit "$code"
}

get_current_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null || error_exit 2 "Failed to determine current branch"
}

check_working_directory_clean() {
  if ! git diff-index --quiet HEAD --; then
    error_exit 3 "Working directory has uncommitted changes. Commit or stash them first."
  fi
}

branch_exists() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null || return 1
}

get_commits_from_branch() {
  local source_branch="$1"
  local current_branch="$2"
  
  # Get commits in source branch that are not in current branch
  git log "$current_branch..origin/$source_branch" --oneline 2>/dev/null | awk '{print $1}' || echo ""
}

cherry_pick_commits() {
  local commits="$1"
  
  if [[ -z "$commits" ]]; then
    warn "No new commits to cherry-pick from source branch"
    return 0
  fi
  
  # Convert to array and reverse (cherry-pick oldest first)
  local commit_array=($commits)
  local reversed=()
  for ((i=${#commit_array[@]}-1; i>=0; i--)); do
    reversed+=("${commit_array[$i]}")
  done
  
  info "Cherry-picking ${#reversed[@]} commit(s)..."
  
  for commit in "${reversed[@]}"; do
    info "Cherry-picking $commit..."
    
    if ! git cherry-pick "$commit" 2>&1; then
      warn "Conflict detected during cherry-pick of $commit"
      echo -e "${YELLOW}Please resolve conflicts manually, then run:${NC}"
      echo "  mkcopy --continue"
      exit 5
    fi
  done
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --continue)
      CONTINUE_MODE=true
      shift
      ;;
    -m | --message)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -m requires a message argument"
      fi
      CUSTOM_MESSAGE="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -*)
      error_exit 1 "Unknown option: $1"
      ;;
    *)
      if [[ "$CONTINUE_MODE" == false ]]; then
        SOURCE_BRANCH="$1"
        shift
      else
        error_exit 1 "Unexpected argument with --continue: $1"
      fi
      ;;
  esac
done

# Handle continue mode
if [[ "$CONTINUE_MODE" == true ]]; then
  info "Continuing cherry-pick..."
  
  if git cherry-pick --continue 2>&1; then
    success "Cherry-pick continued successfully"
    exit 0
  else
    warn "Conflict still present after continue"
    echo -e "${YELLOW}Please resolve remaining conflicts, then run:${NC}"
    echo "  mkcopy --continue"
    exit 5
  fi
fi

# Validate source branch provided
if [[ -z "$SOURCE_BRANCH" ]]; then
  error_exit 1 "SOURCE_BRANCH argument required"
fi

# Get current branch
CURRENT_BRANCH=$(get_current_branch)
info "Current branch: $CURRENT_BRANCH"

# Check working directory is clean
info "Checking working directory..."
check_working_directory_clean
success "Working directory is clean"

# Fetch latest from remote
info "Fetching latest from remote..."
git fetch origin 2>/dev/null || warn "Failed to fetch from origin"

# Verify source branch exists
if ! branch_exists "$SOURCE_BRANCH"; then
  error_exit 4 "Source branch not found: $SOURCE_BRANCH"
fi
info "Source branch found: $SOURCE_BRANCH"

# Get commits to cherry-pick
info "Getting commits from $SOURCE_BRANCH..."
COMMITS=$(get_commits_from_branch "$SOURCE_BRANCH" "$CURRENT_BRANCH")

if [[ -z "$COMMITS" ]]; then
  success "No new commits to cherry-pick from $SOURCE_BRANCH"
  exit 0
fi

info "Found commits to cherry-pick:"
echo "$COMMITS" | while read -r commit; do
  echo "  $commit"
done

# Cherry-pick commits
cherry_pick_commits "$COMMITS"

success "Cherry-pick completed successfully"
if [[ "$VERBOSE" == true ]]; then
  info "Details:"
  echo "  Source branch: $SOURCE_BRANCH"
  echo "  Target branch: $CURRENT_BRANCH"
  echo "  Commits picked: $(echo "$COMMITS" | wc -l)"
fi

success "Done"
exit 0
