#!/usr/bin/env bash

# lsbranch - List branches organized by type with optional filtering.
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Valid branch type prefixes
VALID_TYPES=("major" "minor" "patch" "docs")

# Default behavior
FILTER_TYPE=""
FILTER_NAME=""
FILTER_EXCEPT=false
SHOW_REMOTE=false
SUMMARY_MODE=false
COUNT_ONLY=false
DETAILED_MODE=false
SORT_BY="type"
OUTPUT_FORMAT="table"
LIMIT_RESULTS=0

usage() {
  cat <<'EOF'
Usage:
  lsbranch [OPTIONS] [TYPE]
  lsbranch -h | --help

List branches organized by type with optional filtering and formatting.

Arguments:
  TYPE               Filter by branch type: major, minor, patch, or docs
                     If not specified, lists all branches grouped by type

Options:
  -h, --help         Output this help to stdout and exit.
  -r, --remote       Show remote branches instead of local branches.
  -a, --all          Show both local and remote branches (with labels).
  -s, --summary      Show summary view: counts instead of full branch lists.
  -b, --branch PAT   Filter branches by glob pattern on branch name (supports *, ?, [abc], etc.)
                     If pattern contains no wildcards, it's auto-wrapped as *PAT*
                     Examples: -b bug (same as -b "*bug*"), -b "fix*", -b "*issue"
  -x, --exclude PAT  Exclude branches matching glob pattern (inverse of -b)
                     Examples: -x bug (exclude branches with "bug"), -x "hotfix*"
  -c, --count        Show only branch count (useful for scripts)
  -d, --detailed     Show detailed info: commit hash, author, date
  -n, --limit NUM    Limit results to first NUM branches
  -f, --format FMT   Output format: table (default), json, csv
  --sort FIELD       Sort by: name (alphabetical), type (grouped), date (newest first)
                     Default: type

Examples:
  # List all local branches grouped by type
  lsbranch

  # List only patch branches
  lsbranch patch

  # List remote branches
  lsbranch -r

  # Filter branches by name pattern
  lsbranch -b bug              # branches containing "bug"
  lsbranch -b "fix*"           # branches starting with "fix"

  # Exclude branches by pattern
  lsbranch -x bug              # branches NOT containing "bug"
  lsbranch -x "hotfix*"        # branches NOT starting with "hotfix"

  # Show summary
  lsbranch -s                  # summary of all branches
  lsbranch -s patch            # summary of patch branches
  lsbranch -s -b fix           # summary matching "*fix*"

  # Count only
  lsbranch -c                  # total count
  lsbranch patch -c            # count of patch branches
  lsbranch -c -b login         # count matching "*login*"
  lsbranch -x test -c          # count excluding "*test*"

  # Detailed information
  lsbranch -d                  # show commit hash, author, date
  lsbranch patch -d            # detailed patch branches
  lsbranch -d -x hotfix        # detailed branches excluding "*hotfix*"

  # Limit results
  lsbranch -n 5                # show first 5 branches
  lsbranch -n 10 -b api        # first 10 branches matching "*api*"

  # Different sorting
  lsbranch --sort name         # alphabetical by branch name
  lsbranch --sort date         # by date (newest first)
  lsbranch --sort type         # by type (default)

  # Output formats
  lsbranch -f json             # JSON output
  lsbranch -f csv              # CSV format
  lsbranch patch -f csv        # CSV of patch branches

  # Combine options
  lsbranch -s -r -b memory     # remote summary matching "*memory*"
  lsbranch -d -n 5 patch       # first 5 detailed patch branches
  lsbranch -f json -x api      # JSON of branches NOT matching "*api*"

Exit codes:
  0   Success
  1   Invalid arguments or options
  2   Invalid type specified
  3   No matching branches found
EOF
}

error_exit() {
  local code="$1"
  local message="$2"

  echo "Error: $message" >&2
  exit "$code"
}

# Auto-wrap filter pattern: if no wildcards, wrap as *pattern*
normalize_filter() {
  local pattern="$1"
  
  # Check if pattern contains any glob characters: * ? [ ]
  if [[ "$pattern" =~ [\*\?\[] ]]; then
    # Already has wildcards, return as-is
    echo "$pattern"
  else
    # No wildcards, auto-wrap as *pattern*
    echo "*${pattern}*"
  fi
}

matches_filter() {
  local branch="$1"
  local pattern="$2"
  
  # Use bash glob matching
  if [[ "$branch" == $pattern ]]; then
    return 0
  fi
  return 1
}

apply_filter() {
  local branch="$1"
  local pattern="$2"
  local except="$3"
  
  if [[ -z "$pattern" ]]; then
    return 0  # No filter, include
  fi
  
  if matches_filter "$branch" "$pattern"; then
    if [[ "$except" == true ]]; then
      return 1  # Matches but we want except, exclude
    else
      return 0  # Matches, include
    fi
  else
    if [[ "$except" == true ]]; then
      return 0  # Doesn't match and we want except, include
    else
      return 1  # Doesn't match, exclude
    fi
  fi
}

get_branch_date() {
  local branch="$1"
  local is_remote="$2"
  
  if [[ "$is_remote" == true ]]; then
    git log -1 --format=%ai "origin/$branch" 2>/dev/null || echo "unknown"
  else
    git log -1 --format=%ai "$branch" 2>/dev/null || echo "unknown"
  fi
}

get_branch_info() {
  local branch="$1"
  local is_remote="$2"
  
  local ref="$branch"
  [[ "$is_remote" == true ]] && ref="origin/$branch"
  
  local hash=$(git rev-parse --short "$ref" 2>/dev/null || echo "unknown")
  local author=$(git log -1 --format=%an "$ref" 2>/dev/null || echo "unknown")
  local date=$(git log -1 --format=%ar "$ref" 2>/dev/null || echo "unknown")
  
  echo "$hash|$author|$date"
}

list_by_type_local() {
  local type="$1"
  local branches
  
  branches=$(git branch --format='%(refname:short)' | grep "^${type}/" || true)
  
  if [[ -z "$branches" ]]; then
    return 1
  fi
  
  echo "$branches"
  return 0
}

list_by_type_remote() {
  local type="$1"
  local branches
  
  branches=$(git branch -r --format='%(refname:short)' | grep "^origin/${type}/" | sed 's|^origin/||' || true)
  
  if [[ -z "$branches" ]]; then
    return 1
  fi
  
  echo "$branches"
  return 0
}

filter_branches() {
  local branches="$1"
  local pattern="$2"
  local except="$3"
  local filtered=""
  
  while IFS= read -r branch; do
    if apply_filter "$branch" "$pattern" "$except"; then
      filtered+="$branch"$'\n'
    fi
  done <<< "$branches"
  
  echo "${filtered%$'\n'}"
}

sort_branches() {
  local branches="$1"
  local sort_by="$2"
  
  case "$sort_by" in
    name)
      echo "$branches" | sort
      ;;
    date)
      # Sort by date (newest first)
      while IFS= read -r branch; do
        date=$(get_branch_date "$branch" false)
        echo "$date|$branch"
      done <<< "$branches" | sort -rV | cut -d'|' -f2
      ;;
    type)
      # Group by type, then alphabetical within each type
      for type in "${VALID_TYPES[@]}"; do
        echo "$branches" | grep "^${type}/" | sort || true
      done
      ;;
    *)
      echo "$branches"
      ;;
  esac
}

limit_branches() {
  local branches="$1"
  local limit="$2"
  
  if [[ $limit -le 0 ]]; then
    echo "$branches"
  else
    echo "$branches" | head -n "$limit"
  fi
}

get_current_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null || echo ""
}

format_json() {
  local branches="$1"
  local is_remote="$2"
  
  echo "{"
  echo '  "branches": ['
  
  local first=true
  while IFS= read -r branch; do
    if [[ "$first" == false ]]; then
      echo ","
    fi
    first=false
    
    echo -n "    {"
    echo -n "\"name\": \"$branch\""
    
    if [[ "$DETAILED_MODE" == true ]]; then
      local info=$(get_branch_info "$branch" "$is_remote")
      local hash=$(echo "$info" | cut -d'|' -f1)
      local author=$(echo "$info" | cut -d'|' -f2)
      local date=$(echo "$info" | cut -d'|' -f3)
      
      echo -n ", \"hash\": \"$hash\""
      echo -n ", \"author\": \"$author\""
      echo -n ", \"date\": \"$date\""
    fi
    
    echo -n "}"
  done <<< "$branches"
  
  echo ""
  echo "  ]"
  echo "}"
}

format_csv() {
  local branches="$1"
  local is_remote="$2"
  
  if [[ "$DETAILED_MODE" == true ]]; then
    echo "branch,hash,author,date"
    while IFS= read -r branch; do
      local info=$(get_branch_info "$branch" "$is_remote")
      local hash=$(echo "$info" | cut -d'|' -f1)
      local author=$(echo "$info" | cut -d'|' -f2)
      local date=$(echo "$info" | cut -d'|' -f3)
      echo "$branch,$hash,$author,$date"
    done <<< "$branches"
  else
    echo "branch"
    echo "$branches"
  fi
}

format_table() {
  local branches="$1"
  local show_detail="$2"
  local current=$(get_current_branch)
  
  if [[ "$show_detail" == true ]]; then
    # Detailed table format
    printf "%-35s %-8s %-20s %s\n" "Branch" "Hash" "Author" "Date"
    printf "%-35s %-8s %-20s %s\n" "-----------------------------------" "--------" "--------------------" "-------------------"
    
    while IFS= read -r branch; do
      local info=$(get_branch_info "$branch" false)
      local hash=$(echo "$info" | cut -d'|' -f1)
      local author=$(echo "$info" | cut -d'|' -f2)
      local date=$(echo "$info" | cut -d'|' -f3)
      
      local indicator=" "
      [[ "$branch" == "$current" ]] && indicator=">"
      
      printf "%s %-34s %-8s %-20s %s\n" "$indicator" "$branch" "$hash" "$author" "$date"
    done <<< "$branches"
  else
    # Simple list format
    while IFS= read -r branch; do
      local indicator=" "
      [[ "$branch" == "$current" ]] && indicator=">"
      echo "$indicator * $branch"
    done <<< "$branches"
  fi
}

count_by_type_local() {
  local type="$1"
  if branches=$(list_by_type_local "$type" 2>/dev/null); then
    if [[ -n "$FILTER_NAME" ]]; then
      branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
    fi
    if [[ -z "$branches" ]]; then
      echo "0"
    else
      echo "$branches" | wc -l
    fi
  else
    echo "0"
  fi
}

count_by_type_remote() {
  local type="$1"
  if branches=$(list_by_type_remote "$type" 2>/dev/null); then
    if [[ -n "$FILTER_NAME" ]]; then
      branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
    fi
    if [[ -z "$branches" ]]; then
      echo "0"
    else
      echo "$branches" | wc -l
    fi
  else
    echo "0"
  fi
}

is_valid_type() {
  local type="$1"
  local valid
  
  for valid in "${VALID_TYPES[@]}"; do
    if [[ "$type" == "$valid" ]]; then
      return 0
    fi
  done
  
  return 1
}

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -r | --remote)
      SHOW_REMOTE=true
      shift
      ;;
    -a | --all)
      SHOW_REMOTE="both"
      shift
      ;;
    -s | --summary)
      SUMMARY_MODE=true
      shift
      ;;
    -c | --count)
      COUNT_ONLY=true
      shift
      ;;
    -d | --detailed)
      DETAILED_MODE=true
      shift
      ;;
    -b | --branch)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -b requires a pattern argument"
      fi
      FILTER_NAME=$(normalize_filter "$2")
      FILTER_EXCEPT=false
      shift 2
      ;;
    -x | --exclude)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -x requires a pattern argument"
      fi
      FILTER_NAME=$(normalize_filter "$2")
      FILTER_EXCEPT=true
      shift 2
      ;;
    -n | --limit)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -n requires a number argument"
      fi
      LIMIT_RESULTS="$2"
      shift 2
      ;;
    --sort)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option --sort requires a field argument (name, type, date)"
      fi
      SORT_BY="$2"
      shift 2
      ;;
    -f | --format)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -f requires a format argument (table, json, csv)"
      fi
      OUTPUT_FORMAT="$2"
      shift 2
      ;;
    -*)
      error_exit 1 "Unknown option: $1"
      ;;
    *)
      FILTER_TYPE="$1"
      shift
      ;;
  esac
done

# Validate options
if [[ "$SORT_BY" != "name" && "$SORT_BY" != "type" && "$SORT_BY" != "date" ]]; then
  error_exit 1 "Invalid sort field: $SORT_BY (must be name, type, or date)"
fi

if [[ "$OUTPUT_FORMAT" != "table" && "$OUTPUT_FORMAT" != "json" && "$OUTPUT_FORMAT" != "csv" ]]; then
  error_exit 1 "Invalid format: $OUTPUT_FORMAT (must be table, json, or csv)"
fi

if [[ "$LIMIT_RESULTS" != "0" ]] && ! [[ "$LIMIT_RESULTS" =~ ^[0-9]+$ ]]; then
  error_exit 1 "Limit must be a positive number"
fi

if [[ -n "$FILTER_TYPE" ]]; then
  if ! is_valid_type "$FILTER_TYPE"; then
    error_exit 2 "Invalid type '$FILTER_TYPE'. Valid types: ${VALID_TYPES[*]}"
  fi
fi

# Validate option combinations
if [[ "$SUMMARY_MODE" == true && "$DETAILED_MODE" == true ]]; then
  error_exit 1 "Cannot use -s and -d together"
fi

if [[ "$COUNT_ONLY" == true && "$SUMMARY_MODE" == true ]]; then
  error_exit 1 "Cannot use -c and -s together"
fi

if [[ "$COUNT_ONLY" == true && "$DETAILED_MODE" == true ]]; then
  error_exit 1 "Cannot use -c and -d together"
fi

if [[ "$OUTPUT_FORMAT" != "table" && "$SUMMARY_MODE" == true ]]; then
  error_exit 1 "Cannot use -f with -s"
fi

cd "$REPO_ROOT"

# Fetch latest refs
git fetch origin >/dev/null 2>&1 || true

# Handle count only mode
if [[ "$COUNT_ONLY" == true ]]; then
  if [[ -n "$FILTER_TYPE" ]]; then
    if [[ "$SHOW_REMOTE" == "both" ]]; then
      local_count=$(count_by_type_local "$FILTER_TYPE")
      remote_count=$(count_by_type_remote "$FILTER_TYPE")
      echo "$((local_count + remote_count))"
    elif [[ "$SHOW_REMOTE" == true ]]; then
      count_by_type_remote "$FILTER_TYPE"
    else
      count_by_type_local "$FILTER_TYPE"
    fi
  else
    # Count all branches
    if [[ "$SHOW_REMOTE" == "both" ]]; then
      local_total=0
      remote_total=0
      for type in "${VALID_TYPES[@]}"; do
        local_total=$((local_total + $(count_by_type_local "$type")))
        remote_total=$((remote_total + $(count_by_type_remote "$type")))
      done
      echo "$((local_total + remote_total))"
    elif [[ "$SHOW_REMOTE" == true ]]; then
      total=0
      for type in "${VALID_TYPES[@]}"; do
        total=$((total + $(count_by_type_remote "$type")))
      done
      echo "$total"
    else
      total=0
      for type in "${VALID_TYPES[@]}"; do
        total=$((total + $(count_by_type_local "$type")))
      done
      echo "$total"
    fi
  fi
  exit 0
fi

# Handle summary mode
if [[ "$SUMMARY_MODE" == true ]]; then
  if [[ -n "$FILTER_TYPE" ]]; then
    if [[ "$SHOW_REMOTE" == "both" ]]; then
      local_count=$(count_by_type_local "$FILTER_TYPE")
      remote_count=$(count_by_type_remote "$FILTER_TYPE")
      echo "Local $FILTER_TYPE branches: $local_count"
      echo "Remote $FILTER_TYPE branches: $remote_count"
      echo "Total: $((local_count + remote_count))"
    elif [[ "$SHOW_REMOTE" == true ]]; then
      count=$(count_by_type_remote "$FILTER_TYPE")
      echo "Remote $FILTER_TYPE branches: $count"
    else
      count=$(count_by_type_local "$FILTER_TYPE")
      echo "Local $FILTER_TYPE branches: $count"
    fi
  else
    local_totals=()
    remote_totals=()
    
    for type in "${VALID_TYPES[@]}"; do
      local_totals+=("$(count_by_type_local "$type")")
      remote_totals+=("$(count_by_type_remote "$type")")
    done
    
    if [[ "$SHOW_REMOTE" == "both" ]]; then
      echo "Local Branch Summary:"
      for i in "${!VALID_TYPES[@]}"; do
        echo "  ${VALID_TYPES[$i]}: ${local_totals[$i]}"
      done
      echo ""
      echo "Remote Branch Summary:"
      for i in "${!VALID_TYPES[@]}"; do
        echo "  ${VALID_TYPES[$i]}: ${remote_totals[$i]}"
      done
    elif [[ "$SHOW_REMOTE" == true ]]; then
      echo "Remote Branch Summary:"
      for i in "${!VALID_TYPES[@]}"; do
        echo "  ${VALID_TYPES[$i]}: ${remote_totals[$i]}"
      done
    else
      echo "Local Branch Summary:"
      for i in "${!VALID_TYPES[@]}"; do
        echo "  ${VALID_TYPES[$i]}: ${local_totals[$i]}"
      done
    fi
  fi
  exit 0
fi

# Collect branches
all_branches=""

if [[ -n "$FILTER_TYPE" ]]; then
  if [[ "$SHOW_REMOTE" == "both" ]]; then
    if branches=$(list_by_type_local "$FILTER_TYPE" 2>/dev/null); then
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      all_branches+="$branches"
    fi
    if branches=$(list_by_type_remote "$FILTER_TYPE" 2>/dev/null); then
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ -n "$all_branches" ]]; then
        all_branches+=$'\n'
      fi
      all_branches+="$branches"
    fi
  elif [[ "$SHOW_REMOTE" == true ]]; then
    if branches=$(list_by_type_remote "$FILTER_TYPE" 2>/dev/null); then
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      all_branches="$branches"
    fi
  else
    if branches=$(list_by_type_local "$FILTER_TYPE" 2>/dev/null); then
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      all_branches="$branches"
    fi
  fi
else
  # All branches
  for type in "${VALID_TYPES[@]}"; do
    if [[ "$SHOW_REMOTE" == "both" ]]; then
      if branches=$(list_by_type_local "$type" 2>/dev/null); then
        if [[ -n "$FILTER_NAME" ]]; then
          branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
        fi
        if [[ -n "$all_branches" ]]; then
          all_branches+=$'\n'
        fi
        all_branches+="$branches"
      fi
      if branches=$(list_by_type_remote "$type" 2>/dev/null); then
        if [[ -n "$FILTER_NAME" ]]; then
          branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
        fi
        if [[ -n "$all_branches" ]]; then
          all_branches+=$'\n'
        fi
        all_branches+="$branches"
      fi
    elif [[ "$SHOW_REMOTE" == true ]]; then
      if branches=$(list_by_type_remote "$type" 2>/dev/null); then
        if [[ -n "$FILTER_NAME" ]]; then
          branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
        fi
        if [[ -n "$all_branches" ]]; then
          all_branches+=$'\n'
        fi
        all_branches+="$branches"
      fi
    else
      if branches=$(list_by_type_local "$type" 2>/dev/null); then
        if [[ -n "$FILTER_NAME" ]]; then
          branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
        fi
        if [[ -n "$all_branches" ]]; then
          all_branches+=$'\n'
        fi
        all_branches+="$branches"
      fi
    fi
  done
fi

# Check if any branches found
if [[ -z "$all_branches" ]]; then
  error_exit 3 "No branches found"
fi

# Apply sorting
all_branches=$(sort_branches "$all_branches" "$SORT_BY")

# Apply limit
if [[ $LIMIT_RESULTS -gt 0 ]]; then
  all_branches=$(limit_branches "$all_branches" "$LIMIT_RESULTS")
fi

# Output based on format
case "$OUTPUT_FORMAT" in
  json)
    format_json "$all_branches" false
    ;;
  csv)
    format_csv "$all_branches" false
    ;;
  table)
    format_table "$all_branches" "$DETAILED_MODE"
    ;;
esac

exit 0
