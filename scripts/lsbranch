#!/usr/bin/env bash

# lsbranch - List branches organized by type with optional filtering.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Branch groups aligned with mkbranch naming model
VALID_TYPES=("version" "nonversion")

# Default behavior
FILTER_TYPE=""
FILTER_NAME=""
FILTER_EXCEPT=false
SHOW_REMOTE=false
SUMMARY_MODE=false
COUNT_ONLY=false
DETAILED_MODE=false
SORT_BY="type"
OUTPUT_FORMAT="table"
LIMIT_RESULTS=0
INVALID_ONLY=false
STRICT_MODE=false
INVALID_FOUND=false

usage() {
  cat <<'EOF'
Usage:
  lsbranch [OPTIONS] [TYPE]
  lsbranch -h | --help

List branches by branch-group naming model with optional filtering and formatting.

Arguments:
  TYPE               Filter by branch group: version or nonversion
                     If not specified, lists all branches grouped by branch group

Options:
  -h, --help         Output this help to stdout and exit.
  -r, --remote       Show remote branches instead of local branches.
  -a, --all          Show both local and remote branches (with labels).
  -s, --summary      Show summary view: counts instead of full branch lists.
  -b, --branch PAT   Filter branches by glob pattern on branch name (supports *, ?, [abc], etc.)
                     If pattern contains no wildcards, it's auto-wrapped as *PAT*
                     Examples: -b bug (same as -b "*bug*"), -b "fix*", -b "*issue"
  -x, --exclude PAT  Exclude branches matching glob pattern (inverse of -b)
                     Examples: -x bug (exclude branches with "bug"), -x "hotfix*"
  -c, --count        Show only branch count (useful for scripts)
  -d, --detailed     Show detailed info: commit hash, author, date
  -n, --limit NUM    Limit results to first NUM branches
  -f, --format FMT   Output format: table (default), json, csv
  --sort FIELD       Sort by: name (alphabetical), type (grouped), date (newest first)
                     Default: type
  --invalid-only     Show only branches that violate naming rules
  --strict           Exit with code 4 when any invalid branch names are found

Examples:
  # List all local branches grouped by branch group
  lsbranch

  # List only version branches
  lsbranch version

  # List remote branches
  lsbranch -r

  # Filter branches by name pattern
  lsbranch -b bug              # branches containing "bug"
  lsbranch -b "fix*"           # branches starting with "fix"

  # Exclude branches by pattern
  lsbranch -x bug              # branches NOT containing "bug"
  lsbranch -x "hotfix*"        # branches NOT starting with "hotfix"

  # Show summary
  lsbranch -s                  # summary of all branches
  lsbranch -s version          # summary of version branches
  lsbranch -s -b fix           # summary matching "*fix*"

  # Count only
  lsbranch -c                  # total count
  lsbranch version -c          # count of version branches
  lsbranch -c -b login         # count matching "*login*"
  lsbranch -x test -c          # count excluding "*test*"

  # Detailed information
  lsbranch -d                  # show commit hash, author, date
  lsbranch version -d          # detailed version branches
  lsbranch -d -x hotfix        # detailed branches excluding "*hotfix*"

  # Limit results
  lsbranch -n 5                # show first 5 branches
  lsbranch -n 10 -b api        # first 10 branches matching "*api*"

  # Different sorting
  lsbranch --sort name         # alphabetical by branch name
  lsbranch --sort date         # by date (newest first)
  lsbranch --sort type         # by type (default)

  # Output formats
  lsbranch -f json             # JSON output
  lsbranch -f csv              # CSV format
  lsbranch version -f csv      # CSV of version branches

  # Validation
  lsbranch --invalid-only      # show only invalid branch names
  lsbranch --strict            # fail with exit code 4 if invalid names found
  lsbranch --invalid-only --strict

  # Combine options
  lsbranch -s -r -b memory     # remote summary matching "*memory*"
  lsbranch -d -n 5 version     # first 5 detailed version branches
  lsbranch -f json -x api      # JSON of branches NOT matching "*api*"

Exit codes:
  0   Success
  1   Invalid arguments or options
  2   Invalid type specified
  3   No matching branches found
  4   Invalid branch names found (strict mode)
EOF
}

error_exit() {
  local code="$1"
  local message="$2"

  echo "Error: $message" >&2
  exit "$code"
}

# Auto-wrap filter pattern: if no wildcards, wrap as *pattern*
normalize_filter() {
  local pattern="$1"

  # Check if pattern contains any glob characters: * ? [ ]
  if [[ "$pattern" =~ [\*\?\[] ]]; then
    # Already has wildcards, return as-is
    echo "$pattern"
  else
    # No wildcards, auto-wrap as *pattern*
    echo "*${pattern}*"
  fi
}

matches_filter() {
  local branch="$1"
  local pattern="$2"

  # Use bash glob matching
  if [[ "$branch" == $pattern ]]; then
    return 0
  fi
  return 1
}

apply_filter() {
  local branch="$1"
  local pattern="$2"
  local except="$3"

  if [[ -z "$pattern" ]]; then
    return 0  # No filter, include
  fi

  if matches_filter "$branch" "$pattern"; then
    if [[ "$except" == true ]]; then
      return 1  # Matches but we want except, exclude
    else
      return 0  # Matches, include
    fi
  else
    if [[ "$except" == true ]]; then
      return 0  # Doesn't match and we want except, include
    else
      return 1  # Doesn't match, exclude
    fi
  fi
}

get_branch_date() {
  local branch="$1"
  local is_remote="$2"

  if [[ "$is_remote" == true ]]; then
    git log -1 --format=%ai "origin/$branch" 2>/dev/null || echo "unknown"
  else
    git log -1 --format=%ai "$branch" 2>/dev/null || echo "unknown"
  fi
}

get_branch_info() {
  local branch="$1"
  local is_remote="$2"

  local ref="$branch"
  [[ "$is_remote" == true ]] && ref="origin/$branch"

  local hash
  hash=$(git rev-parse --short "$ref" 2>/dev/null || echo "unknown")
  local author
  author=$(git log -1 --format=%an "$ref" 2>/dev/null || echo "unknown")
  local date
  date=$(git log -1 --format=%ar "$ref" 2>/dev/null || echo "unknown")

  echo "$hash|$author|$date"
}

is_version_branch() {
  local branch="$1"
  [[ "$branch" =~ ^v([1-9][0-9]?)\.([0-9]|[1-9][0-9]?)\.([0-9]|[1-9][0-9]?)$ ]]
}

is_nonversion_branch() {
  local branch="$1"
  [[ "$branch" != *.* ]]
}

get_branch_status() {
  local branch="$1"

  # main is excluded from naming-rule validation
  if [[ "$branch" == "main" ]]; then
    echo "skip"
    return 0
  fi

  if is_version_branch "$branch" || is_nonversion_branch "$branch"; then
    echo "valid"
  else
    echo "invalid"
  fi
}

branch_matches_type() {
  local type="$1"
  local branch="$2"

  if [[ "$branch" == "main" ]]; then
    return 1
  fi

  case "$type" in
    version)
      is_version_branch "$branch"
      ;;
    nonversion)
      [[ ! "$branch" =~ \. ]] && ! is_version_branch "$branch"
      ;;
    *)
      return 1
      ;;
  esac
}

list_by_type_local() {
  local type="$1"
  local branches

  branches=""
  while IFS= read -r branch; do
    if branch_matches_type "$type" "$branch"; then
      branches+="$branch"$'\n'
    fi
  done < <(git branch --format='%(refname:short)')
  branches="${branches%$'\n'}"

  if [[ -z "$branches" ]]; then
    return 1
  fi

  echo "$branches"
  return 0
}

list_by_type_remote() {
  local type="$1"
  local branches

  branches=""
  while IFS= read -r branch; do
    branch="${branch#origin/}"
    if branch_matches_type "$type" "$branch"; then
      branches+="$branch"$'\n'
    fi
  done < <(git branch -r --format='%(refname:short)')
  branches="${branches%$'\n'}"

  if [[ -z "$branches" ]]; then
    return 1
  fi

  echo "$branches"
  return 0
}

list_all_local() {
  git branch --format='%(refname:short)'
}

list_all_remote() {
  git branch -r --format='%(refname:short)' | sed 's#^origin/##'
}

filter_branches() {
  local branches="$1"
  local pattern="$2"
  local except="$3"
  local filtered=""

  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    if apply_filter "$branch" "$pattern" "$except"; then
      filtered+="$branch"$'\n'
    fi
  done <<< "$branches"

  echo "${filtered%$'\n'}"
}

filter_invalid_only() {
  local branches="$1"
  local filtered=""

  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    if [[ "$(get_branch_status "$branch")" == "invalid" ]]; then
      filtered+="$branch"$'\n'
    fi
  done <<< "$branches"

  echo "${filtered%$'\n'}"
}

sort_branches() {
  local branches="$1"
  local sort_by="$2"
  local is_remote="$3"

  case "$sort_by" in
    name)
      echo "$branches" | sort
      ;;
    date)
      # Sort by date (newest first)
      while IFS= read -r branch; do
        [[ -z "$branch" ]] && continue
        local date
        date=$(get_branch_date "$branch" "$is_remote")
        echo "$date|$branch"
      done <<< "$branches" | sort -rV | cut -d'|' -f2
      ;;
    type)
      # Group by type, then alphabetical within each type, de-duplicated
      {
        for type in "${VALID_TYPES[@]}"; do
          while IFS= read -r branch; do
            [[ -z "$branch" ]] && continue
            if branch_matches_type "$type" "$branch"; then
              echo "$branch"
            fi
          done <<< "$branches" | sort
        done

        # Append invalid branches at end for visibility
        while IFS= read -r branch; do
          [[ -z "$branch" ]] && continue
          if [[ "$(get_branch_status "$branch")" == "invalid" ]]; then
            echo "$branch"
          fi
        done <<< "$branches" | sort
      } | awk '!seen[$0]++'
      ;;
    *)
      echo "$branches"
      ;;
  esac
}

limit_branches() {
  local branches="$1"
  local limit="$2"

  if [[ $limit -le 0 ]]; then
    echo "$branches"
  else
    echo "$branches" | head -n "$limit"
  fi
}

get_current_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null || echo ""
}

compute_invalid_found() {
  local branches="$1"
  local found=false

  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    if [[ "$(get_branch_status "$branch")" == "invalid" ]]; then
      found=true
      break
    fi
  done <<< "$branches"

  if [[ "$found" == true ]]; then
    INVALID_FOUND=true
  fi
}

build_strict_scope_branches() {
  local scope_branches=""
  local local_branches=""
  local remote_branches=""

  if [[ "$SHOW_REMOTE" == "both" ]]; then
    local_branches="$(list_all_local)"
    remote_branches="$(list_all_remote)"
    scope_branches="$local_branches"
    if [[ -n "$scope_branches" && -n "$remote_branches" ]]; then
      scope_branches+=$'\n'
    fi
    scope_branches+="$remote_branches"
  elif [[ "$SHOW_REMOTE" == true ]]; then
    scope_branches="$(list_all_remote)"
  else
    scope_branches="$(list_all_local)"
  fi

  if [[ -n "$FILTER_NAME" ]]; then
    scope_branches="$(filter_branches "$scope_branches" "$FILTER_NAME" "$FILTER_EXCEPT")"
  fi

  # Important: do NOT apply FILTER_TYPE here.
  # Strict mode validates all branches in scope, not just displayed type-filtered branches.
  echo "$scope_branches"
}

format_json() {
  local branches="$1"
  local is_remote="$2"

  echo "{"
  echo '  "branches": ['

  local first=true
  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    if [[ "$first" == false ]]; then
      echo ","
    fi
    first=false

    local status
    status=$(get_branch_status "$branch")

    echo -n "    {"
    echo -n "\"name\": \"$branch\""
    echo -n ", \"status\": \"$status\""

    if [[ "$DETAILED_MODE" == true ]]; then
      local info
      info=$(get_branch_info "$branch" "$is_remote")
      local hash
      hash=$(echo "$info" | cut -d'|' -f1)
      local author
      author=$(echo "$info" | cut -d'|' -f2)
      local date
      date=$(echo "$info" | cut -d'|' -f3)

      echo -n ", \"hash\": \"$hash\""
      echo -n ", \"author\": \"$author\""
      echo -n ", \"date\": \"$date\""
    fi

    echo -n "}"
  done <<< "$branches"

  echo ""
  echo "  ]"
  echo "}"
}

format_csv() {
  local branches="$1"
  local is_remote="$2"

  if [[ "$DETAILED_MODE" == true ]]; then
    echo "branch,status,hash,author,date"
    while IFS= read -r branch; do
      [[ -z "$branch" ]] && continue
      local status
      status=$(get_branch_status "$branch")
      local info
      info=$(get_branch_info "$branch" "$is_remote")
      local hash
      hash=$(echo "$info" | cut -d'|' -f1)
      local author
      author=$(echo "$info" | cut -d'|' -f2)
      local date
      date=$(echo "$info" | cut -d'|' -f3)
      echo "$branch,$status,$hash,$author,$date"
    done <<< "$branches"
  else
    echo "branch,status"
    while IFS= read -r branch; do
      [[ -z "$branch" ]] && continue
      local status
      status=$(get_branch_status "$branch")
      echo "$branch,$status"
    done <<< "$branches"
  fi
}

format_table() {
  local branches="$1"
  local show_detail="$2"
  local is_remote="$3"
  local current
  current=$(get_current_branch)

  if [[ "$show_detail" == true ]]; then
    # Detailed table format
    printf "%-35s %-10s %-8s %-20s %s\n" "Branch" "Status" "Hash" "Author" "Date"
    printf "%-35s %-10s %-8s %-20s %s\n" "-----------------------------------" "----------" "--------" "--------------------" "-------------------"

    while IFS= read -r branch; do
      [[ -z "$branch" ]] && continue
      local info
      info=$(get_branch_info "$branch" "$is_remote")
      local hash
      hash=$(echo "$info" | cut -d'|' -f1)
      local author
      author=$(echo "$info" | cut -d'|' -f2)
      local date
      date=$(echo "$info" | cut -d'|' -f3)
      local status
      status=$(get_branch_status "$branch")

      local indicator=" "
      [[ "$branch" == "$current" ]] && indicator=">"

      printf "%s %-34s %-10s %-8s %-20s %s\n" "$indicator" "$branch" "$status" "$hash" "$author" "$date"
    done <<< "$branches"
  else
    # Simple list format
    while IFS= read -r branch; do
      [[ -z "$branch" ]] && continue
      local indicator=" "
      [[ "$branch" == "$current" ]] && indicator=">"
      local status
      status=$(get_branch_status "$branch")
      echo "$indicator * $branch [$status]"
    done <<< "$branches"
  fi
}

count_by_type_local() {
  local type="$1"
  if branches=$(list_by_type_local "$type" 2>/dev/null); then
    if [[ -n "$FILTER_NAME" ]]; then
      branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
    fi
    if [[ "$INVALID_ONLY" == true ]]; then
      branches=$(filter_invalid_only "$branches")
    fi
    if [[ -z "$branches" ]]; then
      echo "0"
    else
      echo "$branches" | wc -l
    fi
  else
    echo "0"
  fi
}

count_by_type_remote() {
  local type="$1"
  if branches=$(list_by_type_remote "$type" 2>/dev/null); then
    if [[ -n "$FILTER_NAME" ]]; then
      branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
    fi
    if [[ "$INVALID_ONLY" == true ]]; then
      branches=$(filter_invalid_only "$branches")
    fi
    if [[ -z "$branches" ]]; then
      echo "0"
    else
      echo "$branches" | wc -l
    fi
  else
    echo "0"
  fi
}

is_valid_type() {
  local type="$1"
  local valid

  for valid in "${VALID_TYPES[@]}"; do
    if [[ "$type" == "$valid" ]]; then
      return 0
    fi
  done

  return 1
}

count_statuses() {
  local branches="$1"
  local valid=0
  local invalid=0
  local skipped=0

  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    case "$(get_branch_status "$branch")" in
      valid) ((valid++)) ;;
      invalid) ((invalid++)) ;;
      skip) ((skipped++)) ;;
    esac
  done <<< "$branches"

  echo "$valid|$invalid|$skipped"
}

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -r | --remote)
      SHOW_REMOTE=true
      shift
      ;;
    -a | --all)
      SHOW_REMOTE="both"
      shift
      ;;
    -s | --summary)
      SUMMARY_MODE=true
      shift
      ;;
    -c | --count)
      COUNT_ONLY=true
      shift
      ;;
    -d | --detailed)
      DETAILED_MODE=true
      shift
      ;;
    -b | --branch)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -b requires a pattern argument"
      fi
      FILTER_NAME=$(normalize_filter "$2")
      FILTER_EXCEPT=false
      shift 2
      ;;
    -x | --exclude)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -x requires a pattern argument"
      fi
      FILTER_NAME=$(normalize_filter "$2")
      FILTER_EXCEPT=true
      shift 2
      ;;
    -n | --limit)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -n requires a number argument"
      fi
      LIMIT_RESULTS="$2"
      shift 2
      ;;
    --sort)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option --sort requires a field argument (name, type, date)"
      fi
      SORT_BY="$2"
      shift 2
      ;;
    -f | --format)
      if [[ $# -lt 2 ]]; then
        error_exit 1 "Option -f requires a format argument (table, json, csv)"
      fi
      OUTPUT_FORMAT="$2"
      shift 2
      ;;
    --invalid-only)
      INVALID_ONLY=true
      shift
      ;;
    --strict)
      STRICT_MODE=true
      shift
      ;;
    -*)
      error_exit 1 "Unknown option: $1"
      ;;
    *)
      FILTER_TYPE="$1"
      shift
      ;;
  esac
done

# Validate options
if [[ "$SORT_BY" != "name" && "$SORT_BY" != "type" && "$SORT_BY" != "date" ]]; then
  error_exit 1 "Invalid sort field: $SORT_BY (must be name, type, or date)"
fi

if [[ "$OUTPUT_FORMAT" != "table" && "$OUTPUT_FORMAT" != "json" && "$OUTPUT_FORMAT" != "csv" ]]; then
  error_exit 1 "Invalid format: $OUTPUT_FORMAT (must be table, json, or csv)"
fi

if [[ "$LIMIT_RESULTS" != "0" ]] && ! [[ "$LIMIT_RESULTS" =~ ^[0-9]+$ ]]; then
  error_exit 1 "Limit must be a positive number"
fi

if [[ -n "$FILTER_TYPE" ]]; then
  if ! is_valid_type "$FILTER_TYPE"; then
    error_exit 2 "Invalid type '$FILTER_TYPE'. Valid types: ${VALID_TYPES[*]}"
  fi
fi

# Validate option combinations
if [[ "$SUMMARY_MODE" == true && "$DETAILED_MODE" == true ]]; then
  error_exit 1 "Cannot use -s and -d together"
fi

if [[ "$COUNT_ONLY" == true && "$SUMMARY_MODE" == true ]]; then
  error_exit 1 "Cannot use -c and -s together"
fi

if [[ "$COUNT_ONLY" == true && "$DETAILED_MODE" == true ]]; then
  error_exit 1 "Cannot use -c and -d together"
fi

if [[ "$OUTPUT_FORMAT" != "table" && "$SUMMARY_MODE" == true ]]; then
  error_exit 1 "Cannot use -f with -s"
fi

cd "$REPO_ROOT"

# Fetch latest refs
git fetch origin >/dev/null 2>&1 || true

# Handle count only mode
if [[ "$COUNT_ONLY" == true ]]; then
  if [[ -n "$FILTER_TYPE" ]]; then
    if [[ "$SHOW_REMOTE" == "both" ]]; then
      local_count=$(count_by_type_local "$FILTER_TYPE")
      remote_count=$(count_by_type_remote "$FILTER_TYPE")
      echo "$((local_count + remote_count))"
    elif [[ "$SHOW_REMOTE" == true ]]; then
      count_by_type_remote "$FILTER_TYPE"
    else
      count_by_type_local "$FILTER_TYPE"
    fi
  else
    # Count all branches using full branch listing so invalid branches are included
    if [[ "$SHOW_REMOTE" == "both" ]]; then
      local_branches=$(list_all_local)
      remote_branches=$(list_all_remote)
      if [[ -n "$FILTER_NAME" ]]; then
        local_branches=$(filter_branches "$local_branches" "$FILTER_NAME" "$FILTER_EXCEPT")
        remote_branches=$(filter_branches "$remote_branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ "$INVALID_ONLY" == true ]]; then
        local_branches=$(filter_invalid_only "$local_branches")
        remote_branches=$(filter_invalid_only "$remote_branches")
      fi
      local_count=0
      remote_count=0
      [[ -n "$local_branches" ]] && local_count=$(echo "$local_branches" | sed '/^$/d' | wc -l)
      [[ -n "$remote_branches" ]] && remote_count=$(echo "$remote_branches" | sed '/^$/d' | wc -l)
      echo "$((local_count + remote_count))"
    elif [[ "$SHOW_REMOTE" == true ]]; then
      branches=$(list_all_remote)
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ "$INVALID_ONLY" == true ]]; then
        branches=$(filter_invalid_only "$branches")
      fi
      if [[ -z "$branches" ]]; then
        echo "0"
      else
        echo "$branches" | sed '/^$/d' | wc -l
      fi
    else
      branches=$(list_all_local)
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ "$INVALID_ONLY" == true ]]; then
        branches=$(filter_invalid_only "$branches")
      fi
      if [[ -z "$branches" ]]; then
        echo "0"
      else
        echo "$branches" | sed '/^$/d' | wc -l
      fi
    fi
  fi
  exit 0
fi

# Handle summary mode
if [[ "$SUMMARY_MODE" == true ]]; then
  if [[ -n "$FILTER_TYPE" ]]; then
    if [[ "$SHOW_REMOTE" == "both" ]]; then
      local_branches=""
      remote_branches=""
      if local_branches=$(list_by_type_local "$FILTER_TYPE" 2>/dev/null); then :; fi
      if remote_branches=$(list_by_type_remote "$FILTER_TYPE" 2>/dev/null); then :; fi

      if [[ -n "$FILTER_NAME" ]]; then
        [[ -n "$local_branches" ]] && local_branches=$(filter_branches "$local_branches" "$FILTER_NAME" "$FILTER_EXCEPT")
        [[ -n "$remote_branches" ]] && remote_branches=$(filter_branches "$remote_branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ "$INVALID_ONLY" == true ]]; then
        [[ -n "$local_branches" ]] && local_branches=$(filter_invalid_only "$local_branches")
        [[ -n "$remote_branches" ]] && remote_branches=$(filter_invalid_only "$remote_branches")
      fi

      local_stats=$(count_statuses "$local_branches")
      remote_stats=$(count_statuses "$remote_branches")
      l_valid=$(echo "$local_stats" | cut -d'|' -f1)
      l_invalid=$(echo "$local_stats" | cut -d'|' -f2)
      r_valid=$(echo "$remote_stats" | cut -d'|' -f1)
      r_invalid=$(echo "$remote_stats" | cut -d'|' -f2)

      echo "Local $FILTER_TYPE branches: $((l_valid + l_invalid)) (valid: $l_valid, invalid: $l_invalid)"
      echo "Remote $FILTER_TYPE branches: $((r_valid + r_invalid)) (valid: $r_valid, invalid: $r_invalid)"
      echo "Total: $((l_valid + l_invalid + r_valid + r_invalid))"
    elif [[ "$SHOW_REMOTE" == true ]]; then
      branches=""
      if branches=$(list_by_type_remote "$FILTER_TYPE" 2>/dev/null); then :; fi
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ "$INVALID_ONLY" == true ]]; then
        branches=$(filter_invalid_only "$branches")
      fi
      stats=$(count_statuses "$branches")
      valid=$(echo "$stats" | cut -d'|' -f1)
      invalid=$(echo "$stats" | cut -d'|' -f2)
      echo "Remote $FILTER_TYPE branches: $((valid + invalid)) (valid: $valid, invalid: $invalid)"
    else
      branches=""
      if branches=$(list_by_type_local "$FILTER_TYPE" 2>/dev/null); then :; fi
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ "$INVALID_ONLY" == true ]]; then
        branches=$(filter_invalid_only "$branches")
      fi
      stats=$(count_statuses "$branches")
      valid=$(echo "$stats" | cut -d'|' -f1)
      invalid=$(echo "$stats" | cut -d'|' -f2)
      echo "Local $FILTER_TYPE branches: $((valid + invalid)) (valid: $valid, invalid: $invalid)"
    fi
  else
    # Summary of all branches (includes invalid branches)
    if [[ "$SHOW_REMOTE" == "both" ]]; then
      local_branches=$(list_all_local)
      remote_branches=$(list_all_remote)
      if [[ -n "$FILTER_NAME" ]]; then
        local_branches=$(filter_branches "$local_branches" "$FILTER_NAME" "$FILTER_EXCEPT")
        remote_branches=$(filter_branches "$remote_branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ "$INVALID_ONLY" == true ]]; then
        local_branches=$(filter_invalid_only "$local_branches")
        remote_branches=$(filter_invalid_only "$remote_branches")
      fi

      local_stats=$(count_statuses "$local_branches")
      remote_stats=$(count_statuses "$remote_branches")
      l_valid=$(echo "$local_stats" | cut -d'|' -f1)
      l_invalid=$(echo "$local_stats" | cut -d'|' -f2)
      l_skip=$(echo "$local_stats" | cut -d'|' -f3)
      r_valid=$(echo "$remote_stats" | cut -d'|' -f1)
      r_invalid=$(echo "$remote_stats" | cut -d'|' -f2)
      r_skip=$(echo "$remote_stats" | cut -d'|' -f3)

      echo "Local Branch Summary:"
      echo "  valid: $l_valid"
      echo "  invalid: $l_invalid"
      echo "  skipped: $l_skip"
      echo ""
      echo "Remote Branch Summary:"
      echo "  valid: $r_valid"
      echo "  invalid: $r_invalid"
      echo "  skipped: $r_skip"
    elif [[ "$SHOW_REMOTE" == true ]]; then
      branches=$(list_all_remote)
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ "$INVALID_ONLY" == true ]]; then
        branches=$(filter_invalid_only "$branches")
      fi
      stats=$(count_statuses "$branches")
      valid=$(echo "$stats" | cut -d'|' -f1)
      invalid=$(echo "$stats" | cut -d'|' -f2)
      skip=$(echo "$stats" | cut -d'|' -f3)

      echo "Remote Branch Summary:"
      echo "  valid: $valid"
      echo "  invalid: $invalid"
      echo "  skipped: $skip"
    else
      branches=$(list_all_local)
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ "$INVALID_ONLY" == true ]]; then
        branches=$(filter_invalid_only "$branches")
      fi
      stats=$(count_statuses "$branches")
      valid=$(echo "$stats" | cut -d'|' -f1)
      invalid=$(echo "$stats" | cut -d'|' -f2)
      skip=$(echo "$stats" | cut -d'|' -f3)

      echo "Local Branch Summary:"
      echo "  valid: $valid"
      echo "  invalid: $invalid"
      echo "  skipped: $skip"
    fi
  fi

  # Strict mode check on full strict scope
  if [[ "$STRICT_MODE" == true ]]; then
    scope_branches="$(build_strict_scope_branches)"
    compute_invalid_found "$scope_branches"
    if [[ "$INVALID_FOUND" == true ]]; then
      exit 4
    fi
  fi

  exit 0
fi

# Collect branches
all_branches=""
SORT_IS_REMOTE=false

if [[ -n "$FILTER_TYPE" ]]; then
  if [[ "$SHOW_REMOTE" == "both" ]]; then
    SORT_IS_REMOTE=false
    if branches=$(list_by_type_local "$FILTER_TYPE" 2>/dev/null); then
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      all_branches+="$branches"
    fi
    if branches=$(list_by_type_remote "$FILTER_TYPE" 2>/dev/null); then
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      if [[ -n "$all_branches" && -n "$branches" ]]; then
        all_branches+=$'\n'
      fi
      all_branches+="$branches"
    fi
  elif [[ "$SHOW_REMOTE" == true ]]; then
    SORT_IS_REMOTE=true
    if branches=$(list_by_type_remote "$FILTER_TYPE" 2>/dev/null); then
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      all_branches="$branches"
    fi
  else
    SORT_IS_REMOTE=false
    if branches=$(list_by_type_local "$FILTER_TYPE" 2>/dev/null); then
      if [[ -n "$FILTER_NAME" ]]; then
        branches=$(filter_branches "$branches" "$FILTER_NAME" "$FILTER_EXCEPT")
      fi
      all_branches="$branches"
    fi
  fi
else
  # All branches (includes invalid names)
  if [[ "$SHOW_REMOTE" == "both" ]]; then
    SORT_IS_REMOTE=false
    local_branches=$(list_all_local)
    remote_branches=$(list_all_remote)
    all_branches="$local_branches"
    if [[ -n "$all_branches" && -n "$remote_branches" ]]; then
      all_branches+=$'\n'
    fi
    all_branches+="$remote_branches"
  elif [[ "$SHOW_REMOTE" == true ]]; then
    SORT_IS_REMOTE=true
    all_branches=$(list_all_remote)
  else
    SORT_IS_REMOTE=false
    all_branches=$(list_all_local)
  fi

  if [[ -n "$FILTER_NAME" ]]; then
    all_branches=$(filter_branches "$all_branches" "$FILTER_NAME" "$FILTER_EXCEPT")
  fi
fi

if [[ "$INVALID_ONLY" == true ]]; then
  all_branches=$(filter_invalid_only "$all_branches")
fi

# Check if any branches found
if [[ -z "$(echo "$all_branches" | sed '/^$/d')" ]]; then
  error_exit 3 "No branches found"
fi

# Determine if invalid branches exist in current output scope
compute_invalid_found "$all_branches"

# Apply sorting
all_branches=$(sort_branches "$all_branches" "$SORT_BY" "$SORT_IS_REMOTE")

# Apply limit
if [[ $LIMIT_RESULTS -gt 0 ]]; then
  all_branches=$(limit_branches "$all_branches" "$LIMIT_RESULTS")
fi

# Output based on format
case "$OUTPUT_FORMAT" in
  json)
    format_json "$all_branches" "$SORT_IS_REMOTE"
    ;;
  csv)
    format_csv "$all_branches" "$SORT_IS_REMOTE"
    ;;
  table)
    format_table "$all_branches" "$DETAILED_MODE" "$SORT_IS_REMOTE"
    ;;
esac

if [[ "$STRICT_MODE" == true ]]; then
  scope_branches="$(build_strict_scope_branches)"
  compute_invalid_found "$scope_branches"
  if [[ "$INVALID_FOUND" == true ]]; then
    exit 4
  fi
fi

exit 0
