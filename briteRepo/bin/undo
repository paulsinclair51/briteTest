#!/usr/bin/env bash

# undo - uncommitted changes, commit, push, copyfix, pull, pulldown,
#        retarget, or release.
#
# See usage below for details, or run: undo -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  undo [OPTIONS] [TYPE]
  undo {-h | --help}

Undo supported recent operations or abort a supported operation in progress.
Before changing the repository, undo describes the target and safety impact and
requires typing `UNDO` exactly. Dry-run does not prompt.

Prerequisites:
  - If the current branch is a targeted or contributor branch, the
    user must be a contributor, reviewer, or approver (listed in
    <repo>/config/contributors.md).
  - If the current branch is main or a version branch, the user
    must be an approver (listed in <repo>/config/contributors.md
    with approver role) or the repository owner.
  - If the current branch has an invalid name, TYPE must be uncommitted.
    This allows undoing uncommitted changes on any branch, even if the
    name is invalid, so that accidental uncommitted changes to a
    read-only branch can still be undone and the user can then change to
    another branch. Use rmbranch to delete invalid branches if needed.
  - For undo uncommitted, the current branch may be local or remote.
  - For undo commit, pull, or pulldown, the current branch must be local and
    must have no uncommitted changes (undo uncommitted first and
    rerun undo commit, pull, or pulldown).
  - For undo push, the current branch must be the remote branch that was
    the target of the push and must have no uncommitted changes
    (undo uncommitted first and rerun undo push).
  - For undo copyfix, the current branch must be local, must be the branch
    to which the copyfix was the target and must have no uncommitted changes
    (undo uncommitted first and rerun undo copyfix).
  - For undo release, the current branch must be the branch
    from which the release was made and must have no accidental uncommitted
    changes (undo uncommitted first and rerun undo release).

Arguments:
  TYPE          The type of operation to undo:
                  uncommitted  Undo uncommitted changes (revert working tree).
                               This is the default if no TYPE is specified.
                  commit       Soft reset to previous commit (staging area
                  preserved).
                  pull         Undo last pull (revert working tree and reset to
                               previous commit).
                  push         Undo last push (revert working tree and reset to
                               previous commit).
                  copyfix      Undo last copyfix (revert working tree and reset
                  to
                               previous commit).
                  pulldown     Undo last merge down.
                  retarget     Abort an in-progress retarget rebase.
                  release      Undo last release (delete local and remote tag,
                               and delete GitHub release if it exists).

Options:
  -c TOKEN      undo comment from TOKEN.
  -- TOKEN...   undo comment from one or more tokens.
  -d            Dry-run. Validates preconditions and reports what
                would be undone, but does not perform the undo.
  -h, --help  Output this help to stdout and exit (other options and
              arguments are ignored).
  -t SEC        Remote operation timeout in seconds (default: 10)
                for connecting to the remote if the current branch
                is a remote branch. SEC must be an integer greater
                than 0.
  -v            Output progress and diagnostics to stdout.

  For undo comment options '-c TOKEN' and '-- TOKEN...':
    - These options are mutually exclusive.
    - Comment text is optional and is used to annotate the undo action.
    - For '-- TOKEN...', '--' must be a separate token.
    - Comment text is built by joining tokens with a single space.
    - For a quoted token, whitespace in the token is preserved and the
      quotes are removed.
    - The resulting undo comment from TOKEN or TOKEN... must include at
      least one non-whitespace character.

Examples:
  # Undo uncommitted changes (revert working tree).
  undo

  # Undo last merge down.
  undo pulldown

   # Undo last commit with a comment.
  undo commit -c "Undo incorrect change."

  # Undo merge down with verbose output.
  undo pulldown -v

Limits:
  - Completed pushup and retarget history rewrites cannot be undone safely
    unless their exact pre-operation local and remote tips were retained.
  - Deleted branches, repositories, clones, and GitHub administration changes
    cannot be reconstructed unless an external backup or retained ref exists.
  - File-generating commands can be undone as uncommitted changes, or through
    undo commit after their changes are committed.
  - Repair commands are not reversed automatically because doing so can restore
    the repository damage they repaired.

Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - Before a non-dry-run undo, writes the operation, target, and safety impact,
    then prompts for the exact confirmation text `UNDO`.
  - Writes an undo report if successful to:
      '<repo>/reports/undo-<TYPE>-YYYYMMDD-HHMMSS-<pid>.md'
    The report is written locally based on the TYPE being undone:
      - For undo uncommitted, commit, pull, copyfix,and pulldown, the undo report
      is
        written to the current branch.
      - For undo push, the undo report is written to the remote branch for
        the current branch.
      - For undo release, the undo report is written to the remote branch
        for the current branch.
  - Writes an error report if unsuccessful (and -d not specified) to the
    current branch locally to:
      '<repo>/reports/undo-<TYPE>-e-YYYYMMDD-HHMMSS-<pid>.md'
  - Writes a dry-run report if -d is specified locally to:
      '<repo>/reports/undo-<TYPE>-d-YYYYMMDD-HHMMSS-<pid>.md'
  - Deletes older dry-run (-d) and error reports for the current
    branch if a new report is written or there is nothing to undo.

Exit codes:
  0    Success ().
  1    Argument or validation error.
  2    User not authorized to perform undo operation.
  3    No uncommitted changes to undo.
  4    No commit to undo.
  5    No pull to undo.
  6    No push to undo.
  7    No copyfix to undo.
  8    No pulldown to undo.
  10   No release to undo.
  11   Configuration error.
  200  Git operation failed (e.g., revert, reset, or push)
  201  GitHub API error (release undo)
  202  Unable to write undo report.
EOF
}

# High-Level Flow:
# - Reverts recent workflow operations such as commit, merge, or release
#   actions.
# - Applies safe undo procedures with branch-state validation.
# - Reports what was reverted and any manual cleanup required.

# shellcheck disable=SC1091  # Helper source paths are resolved at runtime.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"
# shellcheck source=helpers/validation_helpers.sh
source "$SCRIPT_DIR/../helpers/validation_helpers.sh"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_NO_UNCOMMITTED=3
readonly EXIT_NO_COMMIT=4
readonly EXIT_NO_PULL=5
readonly EXIT_NO_PUSH=6
readonly EXIT_NO_COPYFIX=7
readonly EXIT_NO_PULLDOWN=8
readonly EXIT_NO_RETARGET=9
readonly EXIT_NO_RELEASE=10
readonly EXIT_CONFIG_ERROR=11
readonly EXIT_GIT_OPERATION_FAILED=200

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

# Default options
UNDO_TYPE=""
VERBOSE=false
COMMENT=""
DRY_RUN=false
REMOTE_TIMEOUT_SECONDS=10
ORIGINAL_ARGS=("$@")

get_current_user() {
  git config user.name 2>/dev/null || \
    bt_error_exit "$EXIT_CONFIG_ERROR" "Failed to determine current user"
}

record_undo_workflow_event() {
  local operation="$1"
  local details="$2"
  local current_branch
  local command_line=""

  current_branch=$(bt_get_current_branch_or_empty || echo "main")
  [[ "$current_branch" == "HEAD" ]] && current_branch="main"
  command_line="$(bt_format_command_line "undo" "${ORIGINAL_ARGS[@]}")"

  if ! bt_record_workflow_event "undo" "$current_branch" \
      "$command_line" "Undo $operation: $details" HEAD \
      "Undo-Type" "$operation" \
      "Details" "$details"; then
    bt_warn "Undo completed, but its workflow metadata could not be recorded"
  fi
}

confirm_undo() {
  local operation="$1"
  local details="$2"
  local safety=""

  case "$operation" in
    uncommitted)
      safety="Tracked changes and untracked files will be permanently discarded."
      ;;
    commit)
      safety="The commit will be removed; its changes will remain staged."
      ;;
    pull|push|copyfix)
      safety="The branch will be reset and commits after the selected point may become unreachable."
      ;;
    pulldown)
      safety="A new revert commit will reverse the selected merge commit."
      ;;
    retarget)
      safety="The in-progress retarget rebase will be aborted and the previous branch state restored."
      ;;
    release)
      safety="The local tag, remote tag, and GitHub release will be deleted."
      ;;
    *)
      safety="Repository history or files will be changed."
      ;;
  esac

  echo "Undo operation: $operation"
  echo "Target: $details"
  echo "Safety: $safety"
  echo -n "Type UNDO to confirm: "
  read -r response

  if [[ "$response" != "UNDO" ]]; then
    return 1
  fi

  return 0
}

undo_merge() {
  local op_type="${1:-pulldown}"
  local not_found_code="$EXIT_NO_PULLDOWN"

  local current_branch
  current_branch=$(bt_get_current_branch || \
    bt_error_exit "$EXIT_CONFIG_ERROR" "Failed to determine current branch")

  bt_info "Checking for merge commits..."

  # Get last merge commit
  local last_merge
  last_merge=$(git log --oneline --grep="^Merge" -1 2>/dev/null | head -1)

  if [[ -z "$last_merge" ]]; then
    bt_error_exit "$not_found_code" "No ${op_type} operation found to undo"
  fi

  bt_info "Found merge commit: $last_merge"

  # Extract commit hash and message
  local commit_hash="${last_merge%% *}"
  local commit_msg="${last_merge#* }"

  if [[ "$DRY_RUN" == true ]]; then
    bt_info "Dry-run: would revert merge commit $commit_hash"
    return 0
  fi

  if ! confirm_undo "$op_type" "$commit_msg"; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Undo cancelled"
  fi

  # Revert the merge commit
  bt_info "Reverting merge commit..."
  if ! git revert -m 1 "$commit_hash" --no-edit 2>&1; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to revert merge commit"
  fi

  bt_success "Merge reverted"

  # Log undo
  if [[ -n "$COMMENT" ]]; then
    record_undo_workflow_event "$op_type" \
      "Reverted $commit_hash ($commit_msg). $COMMENT"
  else
    record_undo_workflow_event "$op_type" "Reverted $commit_hash ($commit_msg)"
  fi

  if [[ "$VERBOSE" == true ]]; then
    bt_info "Revert details:"
    git log -1 --oneline | sed 's/^/  /'
  fi
}

undo_in_progress_git_operation() {
  local operation="$1"
  local current_branch=""

  current_branch="$(bt_get_current_branch_or_empty)"
  bt_git_workflow_marker_matches "$operation" "$current_branch" || return 1

  case "$operation" in
    pull|retarget)
      bt_git_is_rebase_in_progress || return 1
      if [[ "$DRY_RUN" == true ]]; then
        bt_success "Dry-run: would abort in-progress $operation on $current_branch"
        return 0
      fi
      confirm_undo "$operation" "In-progress rebase on $current_branch" || \
        bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Undo cancelled"
      GIT_BYPASS_HOOKS=true git rebase --abort >/dev/null 2>&1 || \
        bt_error_exit "$EXIT_GIT_OPERATION_FAILED" \
          "Failed to abort in-progress $operation rebase"
      ;;
    pulldown)
      git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 || return 1
      if [[ "$DRY_RUN" == true ]]; then
        bt_success "Dry-run: would abort in-progress pulldown on $current_branch"
        return 0
      fi
      confirm_undo pulldown "In-progress merge on $current_branch" || \
        bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Undo cancelled"
      GIT_BYPASS_HOOKS=true git merge --abort >/dev/null 2>&1 || \
        bt_error_exit "$EXIT_GIT_OPERATION_FAILED" \
          "Failed to abort in-progress pulldown merge"
      ;;
    *)
      return 1
      ;;
  esac

  bt_git_clear_workflow_in_progress "$operation"
  bt_success "In-progress $operation undone"
}

undo_copyfix() {
  local current_branch=""
  local state_dir=""

  current_branch="$(bt_get_current_branch_or_empty)"
  state_dir="$(bt_copyfix_state_dir_for_branch "$current_branch" || true)"
  if [[ -n "$state_dir" && -d "$state_dir" ]] && \
    git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1; then
    if [[ "$DRY_RUN" == true ]]; then
      bt_success "Dry-run: would abort in-progress copyfix on $current_branch"
      return 0
    fi
    confirm_undo copyfix "In-progress cherry-pick on $current_branch" || \
      bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Undo cancelled"
    GIT_BYPASS_HOOKS=true git cherry-pick --abort >/dev/null 2>&1 || \
      bt_error_exit "$EXIT_GIT_OPERATION_FAILED" \
        "Failed to abort in-progress copyfix"
    rm -rf "$state_dir" "${state_dir}.lock"
    bt_success "In-progress copyfix undone"
    return 0
  fi

  undo_reset_hard_head "copyfix" "$EXIT_NO_COPYFIX"
}

undo_release() {
  get_current_user >/dev/null

  bt_info "Checking for recent release tags..."

  # Get last annotated tag
  local last_tag
  last_tag=$(git describe --tags --abbrev=0 2>/dev/null || echo "")

  if [[ -z "$last_tag" ]]; then
    bt_error_exit "$EXIT_NO_RELEASE" "No release tag found to undo"
  fi

  bt_info "Found release tag: $last_tag"

  if [[ "$DRY_RUN" == true ]]; then
    bt_info "Dry-run: would delete release tag $last_tag locally/remotely" \
            "and remove GitHub release"
    return 0
  fi

  if ! confirm_undo "release" "Tag: $last_tag"; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Undo cancelled"
  fi

  # Delete local tag
  bt_info "Deleting local tag..."
  if ! git tag -d "$last_tag" 2>&1; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to delete local tag"
  fi

  # Delete remote tag
  bt_info "Deleting remote tag..."
  if ! bt_run_remote_command env GIT_BYPASS_HOOKS=true \
    git push origin --delete "$last_tag" 2>&1; then
    bt_warn "Failed to delete remote tag (may need manual cleanup)"
  fi

  bt_success "Tag deleted locally and remotely"

  # Delete GitHub release if it exists
  bt_info "Deleting GitHub release..."
  if bt_run_remote_command gh release delete "$last_tag" --confirm 2>&1; then
    bt_success "GitHub release deleted"
  else
    bt_warn "Failed to delete GitHub release (may need manual cleanup)"
  fi

  # Log undo
  if [[ -n "$COMMENT" ]]; then
    record_undo_workflow_event "release" "Deleted release $last_tag. $COMMENT"
  else
    record_undo_workflow_event "release" "Deleted release $last_tag"
  fi

  bt_success "Release undo complete"
}

undo_commit() {
  local current_branch
  current_branch=$(bt_get_current_branch || \
    bt_error_exit "$EXIT_CONFIG_ERROR" "Failed to determine current branch")

  bt_info "Checking for recent commits..."

  # Get last commit
  local last_commit
  last_commit=$(git log --oneline -1 2>/dev/null | head -1)

  if [[ -z "$last_commit" ]]; then
    bt_error_exit "$EXIT_NO_COMMIT" "No commit to undo"
  fi

  bt_info "Found commit: $last_commit"

  if [[ "$DRY_RUN" == true ]]; then
    bt_info "Dry-run: would soft reset HEAD~1 from $last_commit"
    return 0
  fi

  if ! confirm_undo "commit" "$last_commit"; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Undo cancelled"
  fi

  # Soft reset to previous commit (preserves changes in staging)
  bt_info "Soft resetting to previous commit..."
  if ! git reset --soft HEAD~1 2>&1; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to reset commit"
  fi

  bt_success "Commit undone (changes preserved in staging area)"

  # Log undo
  if [[ -n "$COMMENT" ]]; then
    record_undo_workflow_event "commit" "Soft reset from $last_commit. $COMMENT"
  else
    record_undo_workflow_event "commit" "Soft reset from $last_commit"
  fi

  if [[ "$VERBOSE" == true ]]; then
    bt_info "Status after undo:"
    git status --short | sed 's/^/  /'
  fi
}

undo_uncommitted() {
  local current_branch
  current_branch=$(bt_get_current_branch || \
    bt_error_exit "$EXIT_CONFIG_ERROR" "Failed to determine current branch")

  if ! bt_is_worktree_dirty; then
    bt_error_exit "$EXIT_NO_UNCOMMITTED" "No uncommitted changes to undo"
  fi

  if [[ "$DRY_RUN" == true ]]; then
    bt_info "Dry-run: would discard uncommitted tracked changes and remove" \
            "untracked files"
    return 0
  fi

  if ! confirm_undo "uncommitted" \
    "Discard tracked and untracked working tree changes"; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Undo cancelled"
  fi

  if ! git reset --hard HEAD >/dev/null 2>&1; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to reset tracked changes"
  fi
  if ! git clean -fd >/dev/null 2>&1; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" \
      "Failed to remove untracked files"
  fi

  bt_success "Uncommitted changes undone"
}

undo_reset_hard_head() {
  local op_type="$1"
  local not_found_code="$2"

  local last_commit
  last_commit=$(git log --oneline -1 2>/dev/null | head -1)
  if [[ -z "$last_commit" ]]; then
    bt_error_exit "$not_found_code" "No ${op_type} operation found to undo"
  fi

  if [[ "$DRY_RUN" == true ]]; then
    bt_info "Dry-run: would hard reset HEAD~1 to undo $op_type"
    return 0
  fi

  if ! confirm_undo "$op_type" "$last_commit"; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Undo cancelled"
  fi

  if ! git reset --hard HEAD~1 >/dev/null 2>&1; then
    bt_error_exit "$EXIT_GIT_OPERATION_FAILED" "Failed to reset for $op_type"
  fi

  bt_success "$op_type undone"
  if [[ -n "$COMMENT" ]]; then
    record_undo_workflow_event "$op_type" "Hard reset from $last_commit. $COMMENT"
  else
    record_undo_workflow_event "$op_type" "Hard reset from $last_commit"
  fi
}

# Parse options and arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -d)
      DRY_RUN=true
      shift
      ;;
    -c)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -c requires a comment argument"
      fi
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -c/-m and -- for comment"
      fi
      COMMENT="$2"
      shift 2
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    -t)
      [[ $# -ge 2 ]] || usage_error "Option -t requires SEC"
      bt_is_valid_remote_timeout "$2" || \
        usage_error "SEC for -t must be an integer greater than 0"
      REMOTE_TIMEOUT_SECONDS="$2"
      shift 2
      ;;
    --)
      # Unix-style message: everything after -- is the message
      shift
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -c and -- for comment"
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      if [[ -z "$UNDO_TYPE" ]]; then
        UNDO_TYPE="$1"
        shift
      else
        usage_error "Unexpected argument: $1"
      fi
      ;;
  esac
done

export BT_REMOTE_TIMEOUT_SECONDS="$REMOTE_TIMEOUT_SECONDS"

# Validate undo type provided
if [[ -z "$UNDO_TYPE" ]]; then
  UNDO_TYPE="uncommitted"
fi

# Validate current branch conforms to naming conventions
current_branch=$(bt_get_current_branch || echo "main")
[[ "$current_branch" == "HEAD" ]] && current_branch="main"
if bt_is_current_internal_remote_copy; then
  bt_emit_prerequisite_failure "$EXIT_CONFIG_ERROR" \
    "Current branch '$current_branch' is a read-only remote snapshot." \
    "switch to a writable local branch before running undo."
fi
if [[ "$UNDO_TYPE" != "uncommitted" ]] && \
  ! validate_branch_name "$current_branch" "current branch"; then
  usage_error "Current branch does not conform to naming conventions"
fi

# Propagate repository history from remote if available
history_status=0
bt_propagate_repository_history || history_status=$?
case "$history_status" in
  0) ;;
  1) bt_info "Updated repository history from remote" ;;
  *) ;;
esac

# Dispatch to appropriate undo function
case "$UNDO_TYPE" in
  uncommitted)
    undo_uncommitted
    ;;
  pulldown)
    undo_in_progress_git_operation pulldown || undo_merge "pulldown"
    ;;
  pull)
    undo_in_progress_git_operation pull || \
      undo_reset_hard_head "pull" "$EXIT_NO_PULL"
    ;;
  push)
    undo_reset_hard_head "push" "$EXIT_NO_PUSH"
    ;;
  copyfix)
    undo_copyfix
    ;;
  release)
    undo_release
    ;;
  retarget)
    undo_in_progress_git_operation retarget || \
      bt_error_exit "$EXIT_NO_RETARGET" \
        "No in-progress retarget operation found to undo"
    ;;
  commit)
    undo_commit
    ;;
  *)
    usage_error "Unknown undo type: $UNDO_TYPE" \
      "(valid: uncommitted, commit, pull, push, copyfix, pulldown," \
      "retarget, release)"
    ;;
esac

bt_success "Done"
exit 0
