build_top_level_files() {
  write_file "CHANGELOG.md" <<EOF
# Changelog

Copyright (c) $COPYRIGHT_YEAR  
SPDX-License-Identifier: MIT  
For license details, see \`<repo>/LICENSE\`.

For repository and branch history, generate a report by running
\`<repo>/briteRepo/bin/report\` or simply \`report\` (if path is setup)
using the \`repo\` or \`branch\` argument. Reports are written to the
\`<repo>/reports/\` directory. \`report\` using the \`style\` argument
generates a report of style violations for the current branch.
EOF

  write_file "CONTRIBUTING.md" <<EOF
# Contributing

Copyright (c) $COPYRIGHT_YEAR  
SPDX-License-Identifier: MIT  
For license details, see \`<repo>/LICENSE\`.

Contributors are listed in \`<repo>/config/contributors.md\`.

Use the scripts in \`<repo>/briteRepo/bin/\` for branch, commit, review, and
release workflows.
EOF

  write_file "CODE_OF_CONDUCT.md" <<EOF
# Code of Conduct

Copyright (c) $COPYRIGHT_YEAR  
SPDX-License-Identifier: MIT  
For license details, see \`<repo>/LICENSE\`.

Describe the expected behavior for participants in this repository and how to
report unacceptable behavior.
EOF

  write_file "MAINTAINERS.md" <<EOF
# Maintainers

Copyright (c) $COPYRIGHT_YEAR  
SPDX-License-Identifier: MIT  
For license details, see \`<repo>/LICENSE\`.

List the maintainers of this repository here. Roles are defined in
\`<repo>/config/contributors.md\`.
EOF

  write_file "SECURITY.md" <<EOF
# Security Policy

Copyright (c) $COPYRIGHT_YEAR  
SPDX-License-Identifier: MIT  
For license details, see \`<repo>/LICENSE\`.

Describe the supported versions and how to report a vulnerability privately.
EOF

  # The source clone is the preferred origin for these files; the inline
  # templates are the fallback when it does not carry them.
  if ! copy_source_file "$SOURCE_REPO_ROOT/LICENSE" "LICENSE"; then
    write_file "LICENSE" <<EOF
MIT License

Copyright (c) $COPYRIGHT_YEAR

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in
all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.
EOF
  fi

  if ! copy_source_file "$SOURCE_REPO_ROOT/.gitignore" ".gitignore"; then
    write_file ".gitignore" <<'EOF'
# Object files
*.o
*.obj

# Executables
*.exe
*.out

# Temporary test outputs
tests/tmp/*
!tests/tmp/README.md

# Generated reports
reports/*
!reports/README.md
EOF
  fi
}

build_config_files() {
  if ! copy_source_file "$SOURCE_REPO_ROOT/config/markdownlint.json" \
    "config/markdownlint.json"; then
    write_file "config/markdownlint.json" <<'EOF'
{
  "MD001": false,
  "MD013": { "line_length": 120, "code_blocks": false, "tables": false },
  "MD029": false,
  "MD033": false,
  "MD041": false
}
EOF
  fi

  write_file "config/contributors.md" <<EOF
# Contributors

Copyright (c) $COPYRIGHT_YEAR  
SPDX-License-Identifier: MIT  
For license details, see \`<repo>/LICENSE\`.

| Login | Role |
| ----- | ---- |
EOF

  write_file "config/version_status.md" <<EOF
# Version Status

Copyright (c) $COPYRIGHT_YEAR  
SPDX-License-Identifier: MIT  
For license details, see \`<repo>/LICENSE\`.

| Version | Status |
| ------- | ------ |
| v1.0.0  | open   |
EOF

  make_dir ".github"
  copy_source_file "$SOURCE_REPO_ROOT/.github/CODEOWNERS" \
    ".github/CODEOWNERS" || true
}

# Scripts and workflows are versioned as a set, so the whole directory is
# replaced; a stale script left behind would enforce the wrong policy.
refresh_directories() {
  local path src dest

  echo "Refreshing scripts and workflows..."
  for path in "${REFRESH_PATHS[@]}"; do
    src="$SOURCE_REPO_ROOT/$path"
    dest="$TARGET_ROOT/$path"
    [[ -d "$src" ]] || continue

    if [[ "$DRY_RUN" != true ]]; then
      rm -rf "$dest"
      mkdir -p "$dest"
      cp -R "$src/." "$dest/" || \
        error_exit "$EXIT_OPERATION_FAILED" "Failed to copy $src"
      chmod -R u+x "$TARGET_ROOT/briteRepo/bin" 2>/dev/null || true
    fi

    REFRESHED_DIRS+=("$path/")
    echo "  * $path/ (fresh copy)"
  done
}

build_layout() {
  echo "Applying canonical layout to $TARGET_SLUG ($REPO_DEFAULT_BRANCH)..."
  if [[ "$DRY_RUN" == true ]]; then
    bt_info "Dry-run mode: nothing is written, committed, or pushed"
  fi

  build_directories
  build_documentation
  build_branding
  build_top_level_files
  build_config_files
  refresh_directories

  echo ""
  echo "  Created:       $CREATED_COUNT"
  echo "  Non-canonical: $DIVERGENT_COUNT"
  echo "  Unchanged:     $UNCHANGED_COUNT"
  echo ""
}

# ---------------------------------------------------------------------------
# Publishing
# ---------------------------------------------------------------------------

# Stage, commit, push, and confirm the remote received the commit.
# Returns 1 when there was nothing to publish.
publish_changes() {
  git -C "$TARGET_ROOT" add -A || \
    error_exit "$EXIT_OPERATION_FAILED" "Failed to stage changes"

  if git -C "$TARGET_ROOT" diff --cached --quiet; then
    LAST_COMMIT="$(git -C "$TARGET_ROOT" rev-parse HEAD 2>/dev/null \
      || echo "None")"
    return 1
  fi

  if ! git -C "$TARGET_ROOT" commit -q -m "$COMMIT_MESSAGE"; then
    error_exit "$EXIT_OPERATION_FAILED" \
      "Failed to commit. Check that user.name and user.email are configured"
  fi
  LAST_COMMIT="$(git -C "$TARGET_ROOT" rev-parse HEAD)"

  if ! run_remote_logged git -C "$TARGET_ROOT" push -q -u origin \
    "HEAD:$REPO_DEFAULT_BRANCH"; then
    local push_error="Failed to push to $TARGET_SLUG "
    push_error+="($REPO_DEFAULT_BRANCH). The branch may be protected; push "
    push_error+="from a branch and open a pull request instead"
    error_exit "$EXIT_OPERATION_FAILED" "$push_error"
  fi

  verify_push
}

# A push can report success and still leave the branch behind, for example
# when a server-side hook rewrites or rejects the update.
verify_push() {
  local remote_commit

  remote_commit="$(run_remote git -C "$TARGET_ROOT" ls-remote origin \
    "refs/heads/$REPO_DEFAULT_BRANCH" 2>/dev/null | cut -f1 || true)"

  if [[ -z "$remote_commit" ]]; then
    bt_info "Could not read the remote branch to verify the push"
    return 0
  fi
  if [[ "$remote_commit" != "$LAST_COMMIT" ]]; then
    error_exit "$EXIT_OPERATION_FAILED" \
      "Push reported success but $REPO_DEFAULT_BRANCH is at $remote_commit"
  fi
}

apply_rulesets() {
  local rulesets_script="$TARGET_ROOT/briteRepo/bin/setup_rulesets"

  [[ "$APPLY_RULESETS" == true ]] || return 0

  echo ""
  echo "Applying repository rulesets..."
  if [[ ! -f "$rulesets_script" ]]; then
    error_exit "$EXIT_GITHUB_ERROR" \
      "setup_rulesets not found in the working clone"
  fi
  if ! run_remote bash "$rulesets_script" "$TARGET_SLUG"; then
    local ruleset_error="Canonical layout was pushed, but setup_rulesets "
    ruleset_error+="failed for $TARGET_SLUG. Rerun: setup_rulesets "
    ruleset_error+="$TARGET_SLUG"
    error_exit "$EXIT_GITHUB_ERROR" "$ruleset_error"
  fi
  bt_success "Rulesets applied to $TARGET_SLUG"
}

print_next_steps() {
  echo ""
  echo "Next steps:"
  echo "  gh repo clone $TARGET_SLUG"
  echo "  cd $REPO_NAME"
  echo "  bash briteRepo/bin/setupclone"
  echo "  Add contributor logins and roles to config/contributors.md"
  if [[ "$APPLY_RULESETS" != true ]]; then
    echo "  setup_rulesets $TARGET_SLUG   # protect main and version branches"
  fi
  echo "  See the report above for the full follow-up list"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
  parse_options "$@"
  preflight
  guard_local_clones
  detect_repository
  create_repository
  create_working_clone

  # From here on there is enough state to describe the run in a report.
  REPORT_READY=true

  build_layout

  if [[ "$FORCE_ERROR" == true ]]; then
    error_exit "$EXIT_OPERATION_FAILED" \
      "Forced error requested with -e; nothing was committed or pushed"
  fi

  if [[ "$DRY_RUN" == true ]]; then
    write_report "dry" "To be determined"
    bt_success "Dry run complete for $TARGET_SLUG"
    return 0
  fi

  if ! publish_changes; then
    write_report "final" "$LAST_COMMIT"
    bt_success "$TARGET_SLUG already has the canonical layout; nothing to push"
    return 0
  fi

  bt_success "Canonical layout pushed to $TARGET_SLUG ($REPO_DEFAULT_BRANCH)"
  apply_rulesets
  write_report "final" "$LAST_COMMIT"
  print_next_steps
}

main "$@"
