#!/usr/bin/env bash

# report - Generate the specified type of report.
#
# See usage below for details, or run: report -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  report [OPTIONS] [TYPE]
  report {-h | --help}

Generate a report as specified by the TYPE argument:
  - repo generates a repository-level report of repo status,
    branches (local and remote) and activity.

  - branch generates a report of activity for the current
    branch (local or remote copy). An activity is a commit,
    pull, push, pushup, pulldown, copyfix, or retarget.

  - style generates a report of style violations for the current branch.

Prerequisites for a repo report:
  - Current branch must be a local branch or remote copy.

Prerequisites for a branch report:
  - Current branch must be a local branch or remote copy.

Prerequisites for a style report:
  - Current branch must be a local branch.

Arguments:
  TYPE        Report type: branch, repo, or style (default: branch).
              TYPE may appear before or after options, but may be specified
              only once.

Options:
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored).
  -v          Output progress and diagnostics to stdout.

Additional options only for a branch or repo report:
  -n N        Limit the report to N matching activities (default: 10).
              N must be 0 or an integer greater than 0; 0 means all matching
              activities are included. The newest N matches are selected.
  -q TEXT     Include activity whose summary or details contain TEXT.
              Matching is case-insensitive.
  -r          Report on remote activity instead of local activity.
  -t SEC      Remote timeout in seconds (default: 10 seconds).
              SEC must be an integer greater than 0.
  -u USER     Include activity whose associated user contains USER.
              Matching is case-insensitive.

Additional options only for a branch report:
  -p          Report for the parent of the current branch instead of the
              current branch. Combine with -r for the remote parent.

Additional options only for a style report:
  -f FILE     Check only FILE. May be specified more than once.
  -i          Run include (.h) checks if applicable to the selected files.
  -m          Run Markdown document and version consistency checks.
  -r          Run directory guide README checks.
  -s          Run source (.c) and script checks.

  If no style check options are provided, all checks are enabled.

Repo Examples:
  report repo
  report repo -t 20
  report repo -v

Branch Examples:
  report
  report -p
  report -p -r
  report branch -u testuser -q "authentication" -n 10
  report branch -n 2
  report -n 0
  report -v

Style Examples:
  report style
  report style -m -f docs/md/Guide.md
  report style -v

Outputs:
  - Writes errors and diagnostics to stderr.
  - Writes verbose (-v) progress and diagnostics to stdout.
  - Writes one untracked report directly in '<repo>/reports/':
      - 'repo-<datetime>.md' for a repository report.
      - 'branch-l-<datetime>.md' for a local branch report.
      - 'branch-r-<datetime>.md' for a remote branch report.
      - 'branch-p-l-<datetime>.md' for a local parent branch report.
      - 'branch-p-r-<datetime>.md' for a remote parent branch report.
      - 'style-<datetime>.md' for a style report.
    The previous report of the same type is deleted.
  - Writes 'See <reportpath>' to stdout when a
    report is written.

Exit codes:
  0    Success (report written, -h/--help).
  1    Argument or validation error.
  2    Style report requires a local targeted or contributor branch
       as the current branch.
  3    Style report found validation issues.
  4    Style report is not authorized for the current user.
    5    Repo and branch reports require a local branch or remote copy as the
      current branch.
  6    No matching activity was found for branch report.
  200  Failed to read recorded activity.
  201  Failed to create or write the report.
EOF
}

# High-Level Flow:
# - Resolve the selected local branch, fetched remote branch, or remote snapshot.
# - Read recorded commits and completed workflow activity newest first.
# - Apply user/text filters and select the newest limit.
# - Write one report of the selected type; never mutate workflow history.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
REPORTS_DIR="$REPO_ROOT/reports"
RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S%z')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S%z' | sed -E 's/([+-][0-9]{2})([0-9]{2})$/\1:\2/')"

# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_NO_MATCH=6
readonly EXIT_CURRENT_BRANCH_REQUIRED=5
readonly EXIT_HISTORY_READ_FAILED=200
readonly EXIT_REPORT_WRITE_FAILED=201

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

ensure_git_repository() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    bt_error_exit "$EXIT_CURRENT_BRANCH_REQUIRED" \
      "Repo and branch reports require a local branch or remote copy as the current branch."
  fi
}

is_non_negative_integer() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

is_positive_integer() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

refresh_remote_branch_report_refs() {
  local branch="$1"
  local remote_output=""
  local remote_branch_ref="refs/heads/$branch"
  local remote_notes_ref="refs/notes/briteRepo-remote-workflow"

  if ! remote_output="$(bt_run_remote_command git ls-remote origin \
    "$remote_branch_ref" "$remote_notes_ref" 2>/dev/null)"; then
    bt_warn "Failed to query origin for remote branch report"
    exit "$EXIT_HISTORY_READ_FAILED"
  fi
  if ! printf '%s\n' "$remote_output" | awk -v ref="$remote_branch_ref" \
    '$2 == ref { found = 1 } END { exit !found }'; then
    usage_error "Remote branch 'origin/$branch' is not available"
  fi

  if ! bt_run_remote_command git fetch origin \
    "+${remote_branch_ref}:refs/remotes/origin/$branch" \
    >/dev/null 2>&1; then
    bt_warn "Failed to refresh remote branch 'origin/$branch'"
    exit "$EXIT_HISTORY_READ_FAILED"
  fi

  if printf '%s\n' "$remote_output" | awk -v ref="$remote_notes_ref" \
    '$2 == ref { found = 1 } END { exit !found }'; then
    if ! bt_run_remote_command git fetch origin \
      "+${remote_notes_ref}:${remote_notes_ref}" >/dev/null 2>&1; then
      bt_warn "Failed to refresh remote workflow history"
      exit "$EXIT_HISTORY_READ_FAILED"
    fi
  else
    git update-ref -d "$remote_notes_ref" >/dev/null 2>&1 || {
      bt_warn "Failed to reset unavailable remote workflow history"
      exit "$EXIT_HISTORY_READ_FAILED"
    }
  fi
}

resolve_remote_snapshot_ref() {
  local remote_refs=""
  local remote_count=""
  local remembered_branch=""

  remote_refs="$(git for-each-ref --format='%(refname:short)' \
    --points-at HEAD refs/remotes/origin 2>/dev/null | \
    grep -v '^origin/HEAD$' || true)"
  remote_count="$(printf '%s\n' "$remote_refs" | sed '/^$/d' | \
    wc -l | tr -d ' ')"
  remembered_branch="$(git config --local --get chbranch.lastBranch \
    2>/dev/null || true)"

  if [[ "$remote_count" == "1" ]]; then
    printf '%s\n' "$remote_refs" | sed '/^$/d' | head -n 1
    return 0
  fi
  if [[ "$remote_count" -gt 1 && -n "$remembered_branch" ]] && \
    printf '%s\n' "$remote_refs" | grep -Fxq "origin/$remembered_branch"; then
    printf 'origin/%s\n' "$remembered_branch"
    return 0
  fi
  return 1
}

remove_stale_reports() {
  local current_report="$1"
  shift
  local old_report=""
  local pattern=""
  local -a matching_reports=()

  for pattern in "$@"; do
    mapfile -t matching_reports < <(compgen -G "$pattern" || true)
    for old_report in "${matching_reports[@]}"; do
      [[ "$old_report" == "$current_report" ]] && continue
      git -C "$REPO_ROOT" ls-files --error-unmatch -- \
        "${old_report#"${REPO_ROOT}"/}" \
        >/dev/null 2>&1 || rm -f "$old_report"
    done
  done
}

generate_repo_activity_entries() {
  local history=""
  local row=""
  local full_hash=""
  local short_hash=""
  local date_text=""
  local author_name=""
  local author_email=""
  local subject=""
  local body=""
  local note=""
  local note_record=""
  local note_type=""
  local note_date=""
  local note_user=""
  local note_command=""
  local note_summary=""
  local note_details=""
  local note_user_display=""
  local affected_tables=""
  local entry=""
  local line=""
  local action_number=0
  local command_line=""
  local entry_type=""
  local sanitized_body=""
  local action_user_display=""
  local entry_text=""
  local repo_entries=()

  local repo_log_target="--all"
  if [[ "$REMOTE_BRANCH_REPORT" == true ]]; then
    repo_log_target="origin"
  fi

  history="$(git log "$repo_log_target" --date-order --pretty=tformat:'%H%x1f%h%x1f%cI%x1f%an%x1f%ae%x1f%s%x1f%B%x1e' 2>/dev/null || true)"

  while IFS= read -r -d $'\x1e' row; do
    [[ -n "$row" ]] || continue
    row="${row#$'\n'}"
    full_hash="${row%%$'\x1f'*}"
    row="${row#*$'\x1f'}"
    short_hash="${row%%$'\x1f'*}"
    row="${row#*$'\x1f'}"
    date_text="$(normalize_report_datetime "${row%%$'\x1f'*}")"
    row="${row#*$'\x1f'}"
    author_name="${row%%$'\x1f'*}"
    row="${row#*$'\x1f'}"
    author_email="${row%%$'\x1f'*}"
    row="${row#*$'\x1f'}"
    subject="${row%%$'\x1f'*}"
    body="${row#*$'\x1f'}"

    note="$(git notes --ref='briteRepo-workflow' show "$full_hash" 2>/dev/null || true)"
    if [[ -z "$note" ]]; then
      note="$(git notes --ref='briteRepo-remote-workflow' show "$full_hash" 2>/dev/null || true)"
    fi

    if [[ -n "$note" ]]; then
      while IFS= read -r -d $'\x1e' note_record; do
        [[ -n "$note_record" ]] || continue
        missing_note_fields="$(workflow_record_missing_fields "$note_record")"
        if [[ -n "$missing_note_fields" ]]; then
          if [[ "$VERBOSE" == true ]]; then
            bt_warn "Skipping malformed workflow record on $short_hash; missing: $missing_note_fields"
          fi
          continue
        fi

        note_type="$(recorded_field_value "$note_record" "Workflow-Type")"
        note_date="$(normalize_report_datetime "$(recorded_field_value "$note_record" "Workflow-Time")")"
        note_user="$(recorded_field_value "$note_record" "Workflow-User")"
        note_command="$(recorded_field_value "$note_record" "Command-Line")"
        note_command="$(expand_command_line_placeholders "$note_command" "$note_record")"
        note_summary="$(recorded_field_value "$note_record" "Summary")"
        note_details="$(printf '%s\n' "$note_record" | workflow_event_details)"
        note_authority="$(recorded_field_value "$note_record" "Authority")"
        note_user_display="$(format_user_with_role "$note_user" "" "" \
          "$note_authority")"
        affected_tables="$(render_affected_tables "$full_hash")"

        if ! entry_matches_filters "$note_type" "$note_user" \
          "$note_summary $note_details $note_command"; then
          continue
        fi

        action_number=$((action_number + 1))
        printf -v entry '## %d. %s: %s\n\n' "$action_number" "$note_type" "$note_date"
        if [[ "$note_type" == "push" ]]; then
          printf -v line '**Pushed Branch Tip:** `%s`  \n' "$(recorded_field_value "$note_record" "Pushed-Tip")"
          entry+="$line"
        else
          printf -v line '**Commit:** `%s`  \n' "$full_hash"
          entry+="$line"
        fi
        printf -v line '**Command:** `%s`  \n' "$note_command"
        entry+="$line"
        printf -v line '**User:** %s  \n' "$note_user_display"
        entry+="$line"
        if [[ -n "$note_summary" && "$note_type" != "push" ]]; then
          printf -v line '\n%s\n' "$note_summary"
          entry+="$line"
        fi
        if [[ -n "$note_details" && "$note_type" != "push" ]]; then
          entry+=$'\n'
          entry+="$note_details"
          entry+=$'\n'
        fi
        if [[ "$note_type" == "push" ]]; then
          entry+="$(render_push_summary_tables "$(recorded_field_value "$note_record" "Previous-Remote-Tip")" "$(recorded_field_value "$note_record" "Pushed-Tip")")"
        else
          entry+="$affected_tables"
        fi
        repo_entries+=("$entry")
        if [[ "$LIMIT" -gt 0 && "${#repo_entries[@]}" -ge "$LIMIT" ]]; then
          printf '%s\n' "${repo_entries[@]}"
          return 0
        fi
      done < <(printf '%s\n' "$note" | workflow_note_records)
    fi

    command_line="$(recorded_field_value "$body" "Command-Line")"
    command_line="$(expand_command_line_placeholders "$command_line" "$body")"
    entry_type="$(activity_type "$command_line")"
    sanitized_body="$(sanitize_commit_body_for_report "$body" "$subject")"
    while [[ "$sanitized_body" == $'\n'* ]]; do
      sanitized_body="${sanitized_body#$'\n'}"
    done
    action_user_display="$(format_user_with_role "$author_name" "$author_name" "$author_email")"
    affected_tables="$(render_affected_tables "$full_hash")"
    if ! entry_matches_filters "$entry_type" "$author_name $author_email" \
      "$subject $body"; then
      continue
    fi

    action_number=$((action_number + 1))
    printf -v entry '## %d. %s: %s\n\n' "$action_number" "$entry_type" "$(normalize_report_datetime "$date_text")"
    printf -v line '**Commit:** `%s`  \n' "$full_hash"
    entry+="$line"
    if [[ -n "$command_line" ]]; then
      printf -v line '**Command:** `%s`  \n' "$command_line"
      entry+="$line"
    fi
    printf -v line '**User:** %s  \n' "$action_user_display"
    entry+="$line"
    if [[ -n "$subject" ]] && ! is_redundant_commit_summary "$subject"; then
      printf -v line '\n%s\n' "$subject"
      entry+="$line"
    fi
    if [[ -n "$sanitized_body" ]]; then
      entry+="$sanitized_body"
      entry+=$'\n'
    fi
    entry+="$affected_tables"
    repo_entries+=("$entry")
    if [[ "$LIMIT" -gt 0 && "${#repo_entries[@]}" -ge "$LIMIT" ]]; then
      printf '%s\n' "${repo_entries[@]}"
      return 0
    fi
  done < <(printf '%s' "$history")

  if [[ "${#repo_entries[@]}" -gt 0 ]]; then
    printf '%s\n' "${repo_entries[@]}"
  fi
}

generate_repository_report() {
  local current_ref=""
  local head_commit=""
  local integrity="pass"
  local local_branch_count=""
  local remote_branch_count=""
  local remote_url=""
  local report_file=""
  local report_rel=""
  local report_lock_fd=""
  local worktree_status="clean"
  local branch_output=""
  local branch_report=""
  local branch_report_dir=""
  local repo_activity_output=""
  local repo_log_target="--all"
  local -a branch_report_args=(-a -t "$REMOTE_TIMEOUT")
  local -a staged_reports=()

  if [[ "$REMOTE_BRANCH_REPORT" == true ]]; then
    repo_log_target="origin"
  fi

  [[ "$VERBOSE" == false ]] || branch_report_args+=(-v)

  current_ref="$(bt_get_current_branch_or_empty)"
  if [[ -z "$current_ref" ]]; then
    current_ref="detached at $(git rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
  fi
  head_commit="$(git rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
  remote_url="$(git remote get-url origin 2>/dev/null || printf 'not configured')"
  local_branch_count="$(git for-each-ref --format='%(refname)' refs/heads | wc -l | tr -d ' ')"
  remote_branch_count="$(git for-each-ref --format='%(refname)' refs/remotes/origin | \
    awk '!/\/HEAD$/ { count++ } END { print count + 0 }')"
  [[ -z "$(git status --porcelain 2>/dev/null)" ]] || worktree_status="dirty"
  git fsck --no-dangling --no-progress >/dev/null 2>&1 || integrity="fail"

  bt_report_dir_enable_writes "$REPORTS_DIR" "$EXIT_REPORT_WRITE_FAILED"
  if ! branch_report_dir="$(mktemp -d)"; then
    bt_warn "Failed to create temporary directory for branch status"
    exit "$EXIT_REPORT_WRITE_FAILED"
  fi
  if ! branch_output="$(bt_run_lsbranch_mode report \
    "$SCRIPT_DIR/lsbranch" "$branch_report_dir" repo-branches \
    "${branch_report_args[@]}")"; then
    rm -rf "$branch_report_dir"
    bt_warn "Failed to collect branch status for repository report"
    exit "$EXIT_REPORT_WRITE_FAILED"
  fi
  if [[ "$VERBOSE" == true ]]; then
    printf '%s\n' "$branch_output" | \
      sed '/repo-branches-.* for details\./d'
  fi

  shopt -s nullglob
  staged_reports=("$branch_report_dir"/repo-branches-*.md)
  shopt -u nullglob
  if [[ "${#staged_reports[@]}" -ne 1 ]]; then
    rm -rf "$branch_report_dir"
    bt_warn "Repository branch status report was not generated as expected"
    exit "$EXIT_REPORT_WRITE_FAILED"
  fi
  branch_report="${staged_reports[0]}"

  repo_activity_output="$(generate_repo_activity_entries || true)"

  if ! bt_report_acquire_lock "$REPO_ROOT" "report-repo" 10 \
    report_lock_fd; then
    rm -rf "$branch_report_dir"
    bt_warn "Timed out waiting for repository report write lock"
    exit "$EXIT_REPORT_WRITE_FAILED"
  fi
  report_file="$(bt_report_transient_path \
    "$REPORTS_DIR" repo "$RUN_TS_FILE")"
  report_rel="${report_file#"${REPO_ROOT}"/}"
  if ! {
    printf '# Repository Report\n\n'
    printf '**Repository:** `%s`  \n' "$(basename "$REPO_ROOT")"
    printf '**Generated:** %s  \n' "$RUN_TS_DISPLAY"
    printf '**Current Ref:** `%s`  \n' "$current_ref"
    printf '**HEAD:** `%s`  \n' "$head_commit"
    printf '**Origin:** `%s`\n\n' "$remote_url"
    printf '## Health\n\n'
    printf '| Check | Status |\n| --- | --- |\n'
    printf '| Git object integrity | %s |\n' "$integrity"
    printf '| Working tree | %s |\n' "$worktree_status"
    printf '| Local branches | %s |\n' "$local_branch_count"
    printf '| Remote branches | %s |\n\n' "$remote_branch_count"
    printf '## Branch Status\n\n'
    sed '1,2d' "$branch_report"
    printf '\n## Repository Activity\n\n'
    if [[ -n "$repo_activity_output" ]]; then
      printf '<details>\n<summary>Most recent repository activity</summary>\n\n'
      printf '%s\n' "$repo_activity_output"
      printf '\n</details>\n'
    else
      printf 'No matching repository activity found.\n'
    fi
  } > "$report_file"; then
    rm -rf "$branch_report_dir"
    bt_report_release_lock "$report_lock_fd"
    bt_warn "Failed to write report: $report_rel"
    exit "$EXIT_REPORT_WRITE_FAILED"
  fi

  rm -rf "$branch_report_dir"
  remove_stale_reports "$report_file" \
    "$REPORTS_DIR/repo-*.md"
  bt_report_release_lock "$report_lock_fd"

  printf "See '%s'.\n" "$report_rel"
  exit 0
}

contains_ci() {
  local haystack="$1"
  local needle="$2"
  local hay_lc=""
  local needle_lc=""
  local hay_normalized=""
  local needle_normalized=""

  hay_lc="$(printf '%s' "$haystack" | tr '[:upper:]' '[:lower:]')"
  needle_lc="$(printf '%s' "$needle" | tr '[:upper:]' '[:lower:]')"
  [[ "$hay_lc" == *"$needle_lc"* ]] && return 0

  hay_normalized="$(printf '%s' "$hay_lc" | tr -d '*' | tr '-' ' ')"
  needle_normalized="$(printf '%s' "$needle_lc" | tr -d '*' | tr '-' ' ')"
  [[ "$hay_normalized" == *"$needle_normalized"* ]]
}

entry_matches_filters() {
  local entry_type="$1"
  local entry_user="$2"
  local entry_text="$3"

  [[ "$TYPE_FILTER" == "all" || "$entry_type" == "$TYPE_FILTER" ]] || \
    return 1
  [[ -z "$FILTER_USER" ]] || contains_ci "$entry_user" "$FILTER_USER" || \
    return 1
  [[ -z "$FILTER_TEXT" ]] || contains_ci "$entry_text" "$FILTER_TEXT"
}

activity_type() {
  local command_line="$1"
  local command_name="${command_line%% *}"

  case "$command_name" in
    pull|push|pushup|pulldown|copyfix|retarget)
      printf '%s\n' "$command_name"
      ;;
    *)
      printf 'commit\n'
      ;;
  esac
}

workflow_note_records() {
  awk '
    /^--- briteRepo workflow ---$/ {
      if (record != "") {
        records[++count] = record
      }
      record = $0 ORS
      next
    }
    record != "" {
      record = record $0 ORS
    }
    END {
      if (record != "") {
        records[++count] = record
      }
      for (item = count; item >= 1; item--) {
        printf "%s%c", records[item], 30
      }
    }
  '
}

workflow_event_details() {
  awk '
    function render_metadata_line(text, label, value) {
      sub(/^[[:space:]]+/, "", text)
      if (text !~ /^[A-Z][A-Za-z0-9-]*:[[:space:]]/) return 0
      label = text
      sub(/:.*/, "", label)
      value = text
      sub(/^[^:]+:[[:space:]]*/, "", value)
      if (label == "CI-CD") {
        label = "CI/CD"
      } else {
        gsub(/-/, " ", label)
      }
      printf "**%s:** %s  \n", label, value
      return 1
    }
    function print_source_branch() {
      if (source_branch == "") return
      if (source_tip != "") {
        render_metadata_line(source_branch " (" source_tip ")")
      } else {
        render_metadata_line(source_branch)
      }
      source_branch = ""
      source_tip = ""
    }
    /^--- briteRepo workflow ---$/ { next }
    /^(Workflow-Type|Workflow-Time|Workflow-Branch|Workflow-User|Command-Line|Command-Source|Summary|Authority):/ {
      next
    }
    /^Source-Branch:/ {
      print_source_branch()
      source_branch = $0
      next
    }
    /^Source-Tip:/ {
      source_tip = $0
      sub(/^Source-Tip:[[:space:]]*/, "", source_tip)
      if (source_branch != "") {
        print_source_branch()
      } else if (source_tip != "") {
        print "Source-Tip: " source_tip
        source_tip = ""
      }
      next
    }
    NF > 0 {
      print_source_branch()
      if (!render_metadata_line($0)) print
    }
    END { print_source_branch() }
  '
}

render_activity_context() {
  local activity_type="$1"
  local record="$2"
  local scope="$3"
  local target_ref="$4"
  local affected_tables="$5"
  local include_workflow_details="${6:-true}"
  local source_branch=""
  local target_branch=""
  local pr_number=""
  local ci_cd=""
  local action=""

  source_branch="$(recorded_field_value "$record" "Source-Branch")"
  target_branch="$(recorded_field_value "$record" "Target-Branch")"
  pr_number="$(recorded_field_value "$record" "PR")"
  ci_cd="$(recorded_field_value "$record" "CI-CD")"

  case "$activity_type" in
    pulldown)
      action="Synchronized with parent."
      [[ -n "$affected_tables" ]] || \
        action+=" No file or directory changes."
      ;;
    pushup)
      action="Pushed up to parent."
      ;;
    push)
      action="Published branch to remote."
      ;;
    commit)
      action="Committed changes."
      ;;
    *)
      return 0
      ;;
  esac

  printf '**Action:** %s  \n' "$action"
  if [[ -n "$source_branch" ]]; then
    printf '**Source Branch:** %s (%s)  \n' "$source_branch" "$scope"
  fi
  if [[ -n "$target_branch" ]]; then
    printf '**Target Branch:** %s (%s)  \n' "$target_branch" "$scope"
  elif [[ "$activity_type" == "commit" || "$activity_type" == "push" ]]; then
    printf '**Branch:** %s (%s)  \n' "$target_ref" "$scope"
  fi
  if [[ "$include_workflow_details" == true ]]; then
    [[ -z "$pr_number" ]] || printf '**PR:** %s  \n' "$pr_number"
    [[ -z "$ci_cd" ]] || printf '**CI/CD:** %s  \n' "$ci_cd"
  fi
}

role_name_from_code() {
  bt_role_name_from_code "$1"
}

role_name_for_login() {
  bt_role_name_for_login "$1" "$REPO_ROOT/config/contributors.md"
}

is_redundant_commit_summary() {
  local summary="$1"

  [[ "$summary" == *" committed by approver "* ]]
}

branch_status_tags() {
  bt_git_branch_status_tags "$1" "$2"
}

push_directory_summary() {
  local deleted="${1:-0}"
  local added="${2:-0}"
  local renamed="${3:-0}"
  local -a parts=()
  local output=""
  local index=0
  local part=""

  if (( deleted > 0 )); then
    parts+=("$deleted deleted")
  fi
  if (( added > 0 )); then
    parts+=("$added added")
  fi
  if (( renamed > 0 )); then
    parts+=("$renamed renamed")
  fi
  if (( ${#parts[@]} == 0 )); then
    printf ''
    return 0
  fi

  for index in "${!parts[@]}"; do
    part="${parts[$index]}"
    if (( index > 0 )); then
      if (( index == ${#parts[@]} - 1 )); then
        output+=" and "
      else
        output+=", "
      fi
    fi
    output+="$part"
  done

  printf '%s' "$output"
}

push_file_summary() {
  local modified="${1:-0}"
  local deleted="${2:-0}"
  local added="${3:-0}"
  local renamed="${4:-0}"
  local renamed_modified="${5:-0}"
  local -a parts=()
  local total_files=0
  local output=""
  local index=0
  local part=""
  local type_count=0

  total_files=$((modified + deleted + added + renamed + renamed_modified))
  if (( modified > 0 )); then
    parts+=("$modified modified")
    type_count=$((type_count + 1))
  fi
  if (( deleted > 0 )); then
    parts+=("$deleted deleted")
    type_count=$((type_count + 1))
  fi
  if (( added > 0 )); then
    parts+=("$added added")
    type_count=$((type_count + 1))
  fi
  if (( renamed > 0 )); then
    parts+=("$renamed renamed")
    type_count=$((type_count + 1))
  fi
  if (( renamed_modified > 0 )); then
    parts+=("$renamed_modified renamed/modified")
    type_count=$((type_count + 1))
  fi
  if (( ${#parts[@]} == 0 )); then
    printf ''
    return 0
  fi

  for index in "${!parts[@]}"; do
    part="${parts[$index]}"
    if (( index > 0 )); then
      if (( index == ${#parts[@]} - 1 )); then
        output+=" and "
      else
        output+=", "
      fi
    fi
    output+="$part"
  done

  if (( type_count > 1 )); then
    printf '%s; %s total' "$output" "$total_files"
  else
    printf '%s' "$output"
  fi
}

extract_email_from_identity() {
  local identity="$1"
  local email=""

  if [[ "$identity" =~ \<([^\>]*)\> ]]; then
    email="${BASH_REMATCH[1]}"
  fi

  printf '%s' "$(bt_trim_whitespace "$email")"
}

extract_login_from_identity() {
  local identity="$1"
  local login=""
  local email=""

  login="${identity%%<*}"
  login="$(bt_trim_whitespace "$login")"
  login="$(bt_normalize_login "$login")"

  if [[ -z "$login" ]]; then
    email="$(extract_email_from_identity "$identity")"
    if [[ "$email" == *"@"* ]]; then
      login="$(bt_normalize_login "${email%@*}")"
    fi
  fi

  printf '%s' "$login"
}

format_user_with_role() {
  local identity="$1"
  local fallback_login="${2:-}"
  local fallback_email="${3:-}"
  local authority="${4:-}"
  local login=""
  local role_name=""

  login="$(extract_login_from_identity "$identity")"
  if [[ -z "$login" && -n "$fallback_login" ]]; then
    login="$(bt_normalize_login "$fallback_login")"
  fi
  if [[ -z "$login" && -n "$fallback_email" && "$fallback_email" == *"@"* ]]; then
    login="$(bt_normalize_login "${fallback_email%@*}")"
  fi
  [[ -n "$login" ]] || login="unknown"

  if [[ -n "$authority" ]]; then
    role_name="$authority"
  else
    role_name="$(role_name_for_login "$login")"
  fi
  printf '%s (%s)' "$login" "$role_name"
}

extract_user_comment_from_body() {
  local body="$1"

  printf '%s\n' "$body" | awk '
    /^## User Comment[[:space:]]*$/ {
      in_comment = 1
      next
    }
    in_comment == 1 && /^## / {
      in_comment = 0
    }
    in_comment == 1 {
      if ($0 ~ /^>[[:space:]]?/) {
        sub(/^>[[:space:]]?/, "", $0)
        if (length($0) > 0) {
          if (out != "") {
            out = out " "
          }
          out = out $0
        }
      }
    }
    END {
      print out
    }
  '
}

expand_command_line_placeholders() {
  local command_line="$1"
  local body="$2"
  local user_comment=""
  local quoted_comment=""

  if [[ "$command_line" == *"<user-comment>"* || \
    "$command_line" == *"<user comment>"* ]]; then
    user_comment="$(extract_user_comment_from_body "$body")"
    if [[ -n "$user_comment" ]]; then
      quoted_comment="$user_comment"
      command_line="${command_line//<user-comment>/$quoted_comment}"
      command_line="${command_line//<user comment>/$quoted_comment}"
    fi
  fi

  printf '%s' "$command_line"
}

sanitize_commit_body_for_report() {
  local body="$1"
  local summary="$2"

  printf '%s\n' "$body" | awk -v summary="$summary" '
    BEGIN {
      summary_line = summary
      skipped_first = 0
      started = 0
    }
    /^## User Comment[[:space:]]*$/ {
      skip = 1
      next
    }
    /^## (Commit|Workflow) Metadata[[:space:]]*$/ {
      skip = 1
      next
    }
    /^## Summary[[:space:]]*$/ {
      skip = 1
      next
    }
    skip == 1 && /^## / {
      skip = 0
    }
    skip == 0 {
      if (started == 0 && $0 ~ /^[[:space:]]*$/) {
        next
      }
      started = 1
      if ($0 ~ /^-[[:space:]]+Directories:/) {
        sub(/^-+[[:space:]]+Directories:[[:space:]]*/, "")
        if ($0 != "" && $0 !~ /^none\.?[[:space:]]*$/) {
          if ($0 !~ /\.[[:space:]]*$/) $0 = $0 "."
          print "**Directories:** " $0 "  "
        }
        next
      }
      if ($0 ~ /^-[[:space:]]+Files:/) {
        sub(/^-+[[:space:]]+Files:[[:space:]]*/, "")
        if ($0 != "" && $0 !~ /^none\.?[[:space:]]*$/) {
          if ($0 !~ /\.[[:space:]]*$/) $0 = $0 "."
          print "**Files:** " $0 "  "
        }
        next
      }
      if ($0 ~ /^-[[:space:]]+Changes:/) {
        sub(/^-+[[:space:]]+Changes:[[:space:]]*/, "")
        if ($0 != "" && $0 !~ /^none\.?[[:space:]]*$/) {
          print "**Files:** " $0 "  "
        }
        next
      }
      if ($0 ~ /^-[[:space:]]+Lines:/) {
        sub(/^-+[[:space:]]+Lines:[[:space:]]*/, "")
        if ($0 !~ /^0 added and 0 deleted\.?[[:space:]]*$/) {
          print "**Lines:** " $0 "  "
        }
        next
      }
      if (skipped_first == 0 && $0 ~ /[^[:space:]]/) {
        skipped_first = 1
        if ($0 == summary_line) {
          next
        }
      }
      print
    }
  '
}

render_affected_tables() {
  local commit_ref="$1"
  local numstat=""
  local empty_tree_ref="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
  local parent_ref=""
  local tree_ref_before=""
  local tree_ref_after="$commit_ref"
  local parent_info=""
  local name_status=""
  local line=""
  local added=""
  local deleted=""
  local file_path=""
  local dir_path=""
  local old_path=""
  local new_path=""
  local old_dir=""
  local new_dir=""
  local action_text=""
  local net=0
  local file_count=0
  local total_added=0
  local total_deleted=0
  local total_net=0
  local total_lines=0
  local directories_row_count=0
  local directories_summary=""
  local files_summary=""
  local -a files_order=()
  local -a directories_before_order=()
  local -a directories_after_order=()
  local -a directories_added_order=()
  local -a directories_deleted_order=()
  local -a directories_renamed_order=()
  local rendered=""
  local key=""

  declare -A file_added=()
  declare -A file_deleted=()
  declare -A file_lines=()
  declare -A directories_before=()
  declare -A directories_after=()
  declare -A directories_added=()
  declare -A directories_deleted=()
  declare -A directories_renamed_to=()

  parent_info="$(git rev-list --parents -n 1 "$commit_ref" 2>/dev/null || true)"
  set -- $parent_info
  if [[ "$#" -ge 2 ]]; then
    parent_ref="$2"
  fi
  tree_ref_before="${parent_ref:-$empty_tree_ref}"

  if ! numstat="$(git diff --numstat --find-renames \
    "$tree_ref_before" "$tree_ref_after" 2>/dev/null || true)"; then
    numstat=""
  fi

  while IFS= read -r file_path; do
    [[ -n "$file_path" ]] || continue
    dir_path="${file_path%/*}"
    [[ "$dir_path" == "$file_path" ]] && continue
    if [[ -z "${directories_before[$dir_path]+x}" ]]; then
      directories_before["$dir_path"]=1
      directories_before_order+=("$dir_path")
    fi
  done < <(git ls-tree -r --name-only "$tree_ref_before" 2>/dev/null || true)

  while IFS= read -r file_path; do
    [[ -n "$file_path" ]] || continue
    dir_path="${file_path%/*}"
    [[ "$dir_path" == "$file_path" ]] && continue
    if [[ -z "${directories_after[$dir_path]+x}" ]]; then
      directories_after["$dir_path"]=1
      directories_after_order+=("$dir_path")
    fi
  done < <(git ls-tree -r --name-only "$tree_ref_after" 2>/dev/null || true)

  for key in "${directories_before_order[@]}"; do
    if [[ -z "${directories_after[$key]+x}" ]]; then
      directories_deleted["$key"]=1
      directories_deleted_order+=("$key")
    fi
  done

  for key in "${directories_after_order[@]}"; do
    if [[ -z "${directories_before[$key]+x}" ]]; then
      directories_added["$key"]=1
      directories_added_order+=("$key")
    fi
  done

  if ! name_status="$(git diff --name-status --find-renames \
    "$tree_ref_before" "$tree_ref_after" 2>/dev/null || true)"; then
    name_status=""
  fi
  while IFS=$'\t' read -r key old_path new_path; do
    [[ "$key" == R* ]] || continue
    [[ -n "$old_path" && -n "$new_path" ]] || continue
    old_dir="${old_path%/*}"
    new_dir="${new_path%/*}"
    [[ "$old_dir" == "$old_path" ]] && old_dir=""
    [[ "$new_dir" == "$new_path" ]] && new_dir=""
    [[ -n "$old_dir" && -n "$new_dir" ]] || continue
    [[ "$old_dir" == "$new_dir" ]] && continue
    if [[ -n "${directories_deleted[$old_dir]+x}" && \
      -n "${directories_added[$new_dir]+x}" && \
      -z "${directories_renamed_to[$old_dir]+x}" ]]; then
      directories_renamed_to["$old_dir"]="$new_dir"
      directories_renamed_order+=("$old_dir")
      unset 'directories_deleted[$old_dir]'
      unset 'directories_added[$new_dir]'
    fi
  done <<< "$name_status"

  bt_git_collect_file_actions <<< "$name_status"

  while IFS=$'\t' read -r added deleted file_path; do
    [[ -n "$file_path" ]] || continue
    [[ "$added" =~ ^[0-9]+$ ]] || added=0
    [[ "$deleted" =~ ^[0-9]+$ ]] || deleted=0

    files_order+=("$file_path")
    file_added["$file_path"]="$added"
    file_deleted["$file_path"]="$deleted"
    file_lines["$file_path"]="$(git show "$commit_ref:$file_path" 2>/dev/null |
      wc -l | tr -d ' ')"
    [[ "${file_lines[$file_path]}" =~ ^[0-9]+$ ]] || \
      file_lines["$file_path"]=0

    net=$((added - deleted))
    total_added=$((total_added + added))
    total_deleted=$((total_deleted + deleted))
    total_net=$((total_net + net))
    total_lines=$((total_lines + file_lines[$file_path]))

    file_count=$((file_count + 1))
  done <<< "$numstat"

  bt_git_collect_ref_change_summary "$tree_ref_before" "$tree_ref_after"
  directories_summary="$(push_directory_summary \
    "$BT_CHANGE_DELETED_DIRECTORIES" "$BT_CHANGE_ADDED_DIRECTORIES" \
    "$BT_CHANGE_RENAMED_DIRECTORIES")"
  files_summary="$(push_file_summary \
    "$BT_CHANGE_MODIFIED_FILES" "$BT_CHANGE_DELETED_FILES" \
    "$BT_CHANGE_ADDED_FILES" "$BT_CHANGE_RENAMED_FILES" \
    "$BT_CHANGE_RENAMED_MODIFIED_FILES")"
  if [[ -n "$directories_summary" ]]; then
    printf -v line '\n**Directories:** %s  \n' "$directories_summary"
    rendered+="$line"
  fi
  if [[ -n "$files_summary" ]]; then
    printf -v line '**Files:** %s.  \n' "$files_summary"
    rendered+="$line"
  fi
  if [[ "$total_added" -gt 0 || "$total_deleted" -gt 0 ]]; then
    printf -v line '**Lines:** %s added and %s deleted.  \n' \
      "$total_added" "$total_deleted"
    rendered+="$line"
  fi

  if [[ "$file_count" -gt 0 ]]; then
    rendered+=$'\n<details>\n<summary>Files</summary>\n\n'
    rendered+="| **File** | **Added** | **Deleted** | **Net** | **Lines** |"
    rendered+=" **Action** |"$'\n'
    rendered+="| --- | ---: | ---: | ---: | ---: | --- |"$'\n'
    for key in "${files_order[@]}"; do
      added="${file_added[$key]}"
      deleted="${file_deleted[$key]}"
      net=$((added - deleted))
      file_lines_value="${file_lines[$key]}"
      printf -v line '| `%s` | %s | %s | %+d | %s | %s |\n' \
        "$key" "$added" "$deleted" "$net" "$file_lines_value" \
        "$(bt_git_file_action "$key")"
      rendered+="$line"
    done
    printf -v line '| **Total** | %s | %s | %+d | %s |  |\n' \
      "$total_added" "$total_deleted" "$total_net" "$total_lines"
    rendered+="$line"
    rendered+='</details>'$'\n'
  fi

  for key in "${directories_renamed_order[@]}"; do
    [[ -n "${directories_renamed_to[$key]+x}" ]] && \
      directories_row_count=$((directories_row_count + 1))
  done
  for key in "${directories_added_order[@]}"; do
    [[ -n "${directories_added[$key]+x}" ]] && \
      directories_row_count=$((directories_row_count + 1))
  done
  for key in "${directories_deleted_order[@]}"; do
    [[ -n "${directories_deleted[$key]+x}" ]] && \
      directories_row_count=$((directories_row_count + 1))
  done

  if [[ "$directories_row_count" -gt 0 ]]; then
    rendered+=$'\n<details>\n<summary>Directories</summary>\n\n'
    rendered+="| **Directory** | **Action** |"$'\n'
    rendered+="| --- | --- |"$'\n'
    for key in "${directories_renamed_order[@]}"; do
      [[ -n "${directories_renamed_to[$key]+x}" ]] || continue
      action_text="Renamed (was ${key})"
      printf -v line '| `%s` | %s |\n' "${directories_renamed_to[$key]}" \
        "$action_text"
      rendered+="$line"
    done
    for key in "${directories_added_order[@]}"; do
      [[ -n "${directories_added[$key]+x}" ]] || continue
      printf -v line '| `%s` | Added |\n' "$key"
      rendered+="$line"
    done
    for key in "${directories_deleted_order[@]}"; do
      [[ -n "${directories_deleted[$key]+x}" ]] || continue
      printf -v line '| `%s` | Deleted |\n' "$key"
      rendered+="$line"
    done
    rendered+='</details>'$'\n'
  fi

  printf '%s' "$rendered"
}

render_affected_tables_cached() {
  local commit_ref="$1"
  local output_name="$2"
  local -n output_ref="$output_name"

  if [[ -n "${affected_tables_cache[$commit_ref]+x}" ]]; then
    output_ref="${affected_tables_cache[$commit_ref]}"
    return 0
  fi
  output_ref="$(render_affected_tables "$commit_ref")"
  affected_tables_cache["$commit_ref"]="$output_ref"
}

render_push_commits() {
  local previous_tip="$1"
  local pushed_tip="$2"
  local parent_action_number="$3"
  local nested_number=1
  local commit_hash=""
  local commit_date=""
  local commit_subject=""
  local commit_user=""
  local commit_email=""
  local commit_command=""
  local commit_body=""
  local commit_entry=""
  local commit_tables=""

  while IFS= read -r commit_hash; do
    [[ -n "$commit_hash" ]] || continue
    commit_date="$(normalize_report_datetime "$(git show -s --format='%cI' "$commit_hash")")"
    commit_subject="$(git show -s --format='%s' "$commit_hash")"
    commit_user="$(git show -s --format='%an' "$commit_hash")"
    commit_email="$(git show -s --format='%ae' "$commit_hash")"
    commit_body="$(git show -s --format='%B' "$commit_hash")"
    commit_command="$(expand_command_line_placeholders \
      "$(recorded_field_value "$commit_body" "Command-Line")" "$commit_body")"
    commit_tables="$(render_affected_tables "$commit_hash")"
    printf -v commit_entry '<details>\n<summary>%s.%s. commit: %s</summary>\n\n' \
      "$parent_action_number" "$nested_number" "$commit_date"
    printf -v line '**Commit:** `%s`  \n' "$commit_hash"
    commit_entry+="$line"
    printf -v line '**Command:** `%s`  \n' "$commit_command"
    commit_entry+="$line"
    printf -v line '**User:** %s  \n' \
      "$(format_user_with_role "$commit_user" "$commit_user" "$commit_email")"
    commit_entry+="$line"
    commit_sanitized_body="$(sanitize_commit_body_for_report \
      "$commit_body" "$commit_subject")"
    while [[ "$commit_sanitized_body" == $'\n'* ]]; do
      commit_sanitized_body="${commit_sanitized_body#$'\n'}"
    done
    commit_entry+="$commit_sanitized_body"
    commit_entry+="$commit_tables"
    commit_entry+=$'\n</details>\n'
    printf '%s' "$commit_entry"
    nested_number=$((nested_number + 1))
  done < <(git rev-list "$previous_tip..$pushed_tip")
}

render_push_summary_tables() {
  local previous_tip="$1"
  local pushed_tip="$2"
  local commit_hash=""
  local commit_date=""
  local commit_comment=""
  local file_path=""
  local added=0
  local deleted=0
  local net=0
  local total_lines=0
  local total_added=0
  local total_deleted=0
  local total_net=0
  local total_lines_sum=0
  local -a directory_rows=()
  local directory=""
  local old_directory=""
  local new_directory=""
  local name_status=""

  printf '\n<details>\n<summary>Commits</summary>\n\n'
  printf '| **Commit** | **Date Time** | **Comment** |\n| --- | --- | --- |\n'
  while IFS= read -r commit_hash; do
    [[ -n "$commit_hash" ]] || continue
    commit_date="$(normalize_report_datetime "$(git show -s --format='%cI' "$commit_hash")")"
    commit_body="$(git show -s --format='%B' "$commit_hash")"
    commit_comment="$(extract_user_comment_from_body "$commit_body")"
    if [[ -z "$commit_comment" ]]; then
      commit_comment="${commit_body//$'\r'/}"
      commit_comment="${commit_comment%%$'\n'*}"
    fi
    printf '| `%s` | %s | %s |\n' "$commit_hash" "$commit_date" "$commit_comment"
  done < <(git rev-list "$previous_tip..$pushed_tip" 2>/dev/null || true)
  printf '</details>\n'
  name_status="$(git diff --name-status --find-renames "$previous_tip..$pushed_tip")"
  if [[ -n "$name_status" ]]; then
    printf '\n<details>\n<summary>Files</summary>\n\n'
    bt_git_collect_file_actions <<< "$name_status"
    printf '| **File** | **Commit** | **Added** | **Deleted** | **Net** | **Lines** | **Action** |\n'
    printf '| --- | --- | ---: | ---: | ---: | ---: | --- |\n'
    while IFS= read -r file_path; do
      [[ -n "$file_path" ]] || continue
      added=0
      deleted=0
      while IFS=$'\t' read -r num_added num_deleted _; do
        [[ "$num_added" =~ ^[0-9]+$ ]] && added=$((added + num_added))
        [[ "$num_deleted" =~ ^[0-9]+$ ]] && deleted=$((deleted + num_deleted))
      done < <(git diff --numstat --find-renames "$previous_tip..$pushed_tip" -- "$file_path")
      net=$((added - deleted))
      total_lines=0
      if git cat-file -e "$pushed_tip:$file_path" 2>/dev/null; then
        total_lines="$(git show "$pushed_tip:$file_path" | wc -l | tr -d ' ')"
      fi
      commit_hash="$(git log -1 --format='%h' "$previous_tip..$pushed_tip" -- "$file_path")"
      printf '| `%s` | `%s` | %s | %s | %+d | %s | %s |\n' \
        "$file_path" "$commit_hash" "$added" "$deleted" "$net" "$total_lines" \
        "$(bt_git_file_action "$file_path")"
      total_added=$((total_added + added))
      total_deleted=$((total_deleted + deleted))
      total_net=$((total_net + net))
      total_lines_sum=$((total_lines_sum + total_lines))
    done < <(git diff --name-only --find-renames "$previous_tip..$pushed_tip")
    printf '| **Total** |  | %s | %s | %+d | %s |  |\n</details>\n' \
      "$total_added" "$total_deleted" "$total_net" "$total_lines_sum"

    while IFS=$'\t' read -r status old_path new_path; do
      [[ "$status" == R* ]] || continue
      old_directory="${old_path%/*}"
      new_directory="${new_path%/*}"
      [[ "$old_directory" != "$old_path" && "$new_directory" != "$new_path" && \
        "$old_directory" != "$new_directory" ]] || continue
      directory_rows+=("$new_directory|$(git log -1 --format='%h' "$previous_tip..$pushed_tip" -- "$new_directory" 2>/dev/null || true)|Renamed (was $old_directory)")
    done <<< "$name_status"
    if [[ "${#directory_rows[@]}" -gt 0 ]]; then
      printf '\n<details>\n<summary>Directories</summary>\n\n'
      printf '| **Directory** | **Commit** | **Action** |\n| --- | --- | --- |\n'
      for directory_row in "${directory_rows[@]}"; do
        directory="${directory_row%%|*}"
        directory_commit="${directory_row#*|}"
        directory_commit="${directory_commit%%|*}"
        directory_action="${directory_row#*|*|}"
        printf '| `%s` | `%s` | %s |\n' "$directory" "$directory_commit" "$directory_action"
      done
      printf '</details>\n'
    fi
  fi
}

recorded_field_value() {
  local body="$1"
  local key="$2"
  local value=""
  local line=""

  while IFS= read -r line; do
    if [[ "$line" =~ ^${key}:[[:space:]]*(.*)$ ]]; then
      value="${BASH_REMATCH[1]}"
    fi
  done <<< "$body"

  printf '%s' "$value"
}

normalize_report_datetime() {
  local value="${1:-}"

  value="${value//$'\r'/}"
  if [[ -z "$value" ]]; then
    printf '%s' ""
    return 0
  fi

  value="${value//Z/+00:00}"
  if [[ "$value" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})T([0-9]{2}:[0-9]{2}:[0-9]{2})([+-][0-9]{2}:[0-9]{2})$ ]]; then
    printf '%s %s%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    return 0
  fi
  if [[ "$value" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})[[:space:]]+([0-9]{2}:[0-9]{2}:[0-9]{2})([+-][0-9]{2}:[0-9]{2})$ ]]; then
    printf '%s %s%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    return 0
  fi
  if [[ "$value" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})[[:space:]]+([0-9]{2}:[0-9]{2}:[0-9]{2})([+-][0-9]{2})([0-9]{2})$ ]]; then
    printf '%s %s%s:%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
    return 0
  fi
  if [[ "$value" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})[[:space:]]+([0-9]{2}:[0-9]{2}:[0-9]{2})$ ]]; then
    printf '%s %s+00:00' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    return 0
  fi

  printf '%s' "$value"
}

workflow_detail_value() {
  local details="$1"
  local key="$2"

  printf '%s\n' "$details" | awk -F ';' -v key="$key" '
    function normalized_label(value) {
      gsub(/\*/, "", value)
      gsub(/-/, " ", value)
      return tolower(value)
    }
    {
      for (item = 1; item <= NF; item++) {
        value = $item
        gsub(/\*/, "", value)
        sub(/^[[:space:]]+/, "", value)
        sub(/^[[:space:]]*Details:[[:space:]]*/, "", value)
        label = value
        sub(/:.*/, "", label)
        if (normalized_label(label) == normalized_label(key)) {
          sub(/^[^:]+:[[:space:]]*/, "", value)
          print value
          exit
        }
      }
    }
  '
}

recorded_change_summary() {
  local body="$1"
  local field=""
  local value=""
  local found=false

  bt_git_reset_change_summary
  for field in Files-Modified Files-Deleted Files-Added Files-Renamed \
    Files-Renamed-Modified Directories-Deleted Directories-Added \
    Directories-Renamed; do
    value="$(recorded_field_value "$body" "$field")"
    [[ "$value" =~ ^[0-9]+$ ]] || value=0
    [[ "$value" -gt 0 ]] && found=true
    # shellcheck disable=SC2034  # Consumed by bt_format_change_summary.
    case "$field" in
      Files-Modified) BT_CHANGE_MODIFIED_FILES="$value" ;;
      Files-Deleted) BT_CHANGE_DELETED_FILES="$value" ;;
      Files-Added) BT_CHANGE_ADDED_FILES="$value" ;;
      Files-Renamed) BT_CHANGE_RENAMED_FILES="$value" ;;
      Files-Renamed-Modified) BT_CHANGE_RENAMED_MODIFIED_FILES="$value" ;;
      Directories-Deleted) BT_CHANGE_DELETED_DIRECTORIES="$value" ;;
      Directories-Added) BT_CHANGE_ADDED_DIRECTORIES="$value" ;;
      Directories-Renamed) BT_CHANGE_RENAMED_DIRECTORIES="$value" ;;
    esac
  done

  [[ "$found" == true ]] || return 0
  bt_format_change_summary
}

workflow_record_missing_fields() {
  local record="$1"
  local field=""
  local missing_fields=""
  local value=""

  for field in Workflow-Type Workflow-Time Workflow-Branch Workflow-User \
    Command-Line Summary; do
    value="$(recorded_field_value "$record" "$field")"
    [[ -n "$value" ]] && continue
    [[ -z "$missing_fields" ]] || missing_fields+=", "
    missing_fields+="$field"
  done

  printf '%s' "$missing_fields"
}

workflow_record_matches_branch() {
  local record="$1"
  local target_branch="$2"

  [[ "$(recorded_field_value "$record" "Workflow-Branch")" == \
    "$target_branch" ]]
}

REPORT_TYPE="branch"
REPORT_TYPE_SPECIFIED=false
REMOTE_TIMEOUT=10
REMOTE_TIMEOUT_SPECIFIED=false
REMOTE_BRANCH_REPORT=false
PARENT_BRANCH_REPORT=false
TYPE_FILTER="all"
FILTER_USER=""
FILTER_TEXT=""
LIMIT=10
VERBOSE=false
declare -a ORIGINAL_ARGS=("$@")
declare -a STYLE_ARGS=()

for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    usage
    exit 0
  fi
done

for ((index=0; index < ${#ORIGINAL_ARGS[@]}; index++)); do
  arg="${ORIGINAL_ARGS[index]}"
  case "$arg" in
    -u|-q|-n|-l|-t|-f)
      ((index += 1))
      ;;
    repo|branch|style)
      [[ "$REPORT_TYPE_SPECIFIED" == false ]] || \
        usage_error "TYPE may be specified only once"
      REPORT_TYPE="$arg"
      REPORT_TYPE_SPECIFIED=true
      ;;
    -*)
      ;;
    *)
      usage_error "Unsupported TYPE '$arg'"
      ;;
  esac
done

while [[ $# -gt 0 ]]; do
  case "$1" in
    repo|branch|style)
      shift
      ;;
    -u)
      [[ "$REPORT_TYPE" == "branch" || "$REPORT_TYPE" == "repo" ]] || \
        usage_error "Option -u requires TYPE branch or TYPE repo"
      [[ $# -ge 2 ]] || usage_error "Option -u requires USER"
      FILTER_USER="$2"
      shift 2
      ;;
    -q)
      [[ "$REPORT_TYPE" == "branch" || "$REPORT_TYPE" == "repo" ]] || \
        usage_error "Option -q requires TYPE branch or TYPE repo"
      [[ $# -ge 2 ]] || usage_error "Option -q requires TEXT"
      FILTER_TEXT="$2"
      shift 2
      ;;
    -n)
      [[ "$REPORT_TYPE" == "branch" || "$REPORT_TYPE" == "repo" ]] || \
        usage_error "Option -n requires TYPE branch or TYPE repo"
      [[ $# -ge 2 ]] || usage_error "Option -n requires N"
      is_non_negative_integer "$2" || usage_error "N for -n must be an integer >= 0"
      LIMIT="$2"
      shift 2
      ;;
    -t)
      [[ "$REPORT_TYPE" == "repo" || "$REPORT_TYPE" == "branch" ]] || \
        usage_error "Option -t requires TYPE repo or TYPE branch with -r"
      [[ $# -ge 2 ]] || usage_error "Option -t requires SEC"
      is_positive_integer "$2" || \
        usage_error "SEC for -t must be an integer > 0"
      REMOTE_TIMEOUT="$2"
      REMOTE_TIMEOUT_SPECIFIED=true
      shift 2
      ;;
    -f)
      [[ "$REPORT_TYPE" == "style" ]] || \
        usage_error "Option -f requires TYPE style"
      [[ $# -ge 2 ]] || usage_error "Option -f requires FILE"
      STYLE_ARGS+=("$2")
      shift 2
      ;;
    -i|-m|-s)
      [[ "$REPORT_TYPE" == "style" ]] || \
        usage_error "Option $1 requires TYPE style"
      STYLE_ARGS+=("$1")
      shift
      ;;
    -r)
      if [[ "$REPORT_TYPE" == "style" ]]; then
        STYLE_ARGS+=(-r)
      elif [[ "$REPORT_TYPE" == "branch" || "$REPORT_TYPE" == "repo" ]]; then
        REMOTE_BRANCH_REPORT=true
      else
        usage_error "Option -r requires TYPE branch, TYPE repo, or TYPE style"
      fi
      shift
      ;;
    -p)
      [[ "$REPORT_TYPE" == "branch" ]] || \
        usage_error "Option -p requires TYPE branch"
      PARENT_BRANCH_REPORT=true
      shift
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      usage_error "Unexpected argument: $1"
      ;;
  esac
done

if [[ "$REPORT_TYPE" == "branch" && "$REMOTE_TIMEOUT_SPECIFIED" == true && \
  "$REMOTE_BRANCH_REPORT" == false ]]; then
  usage_error "Option -t requires -r for TYPE branch"
fi
export BT_REMOTE_TIMEOUT_SECONDS="$REMOTE_TIMEOUT"

ensure_git_repository

if [[ "$REPORT_TYPE" == "style" ]]; then
  [[ "$VERBOSE" == false ]] || STYLE_ARGS+=(-v)
  # shellcheck source=helpers/ckstyle.sh
  source "$SCRIPT_DIR/../helpers/ckstyle.sh"
  bt_ckstyle "${STYLE_ARGS[@]}"
fi

if [[ "$REPORT_TYPE" == "repo" ]]; then
  generate_repository_report
fi

CURRENT_REF="$(bt_get_current_branch_raw 2>/dev/null || true)"
if [[ "$CURRENT_REF" != "HEAD" && -n "$CURRENT_REF" ]]; then
  CURRENT_REF="$(bt_get_current_branch_or_empty)"
else
  CURRENT_REF=""
fi
TARGET_REF="$CURRENT_REF"
HISTORY_REF="$CURRENT_REF"
WORKFLOW_NOTES_REF="briteRepo-workflow"
BRANCH_REPORT_PREFIX="branch-l"
SNAPSHOT_HISTORY_REF=""
SNAPSHOT_TARGET_REF=""
BRANCH_SCOPE_LABEL="local"
BRANCH_STATUS_TAGS=""
REPORT_COMMAND_LINE="$(bt_format_command_line "$(basename "$0")" "${ORIGINAL_ARGS[@]}")"
REPORT_USER_LOGIN="$(bt_resolve_login_or_empty)"
REPORT_USER="$(format_user_with_role "$REPORT_USER_LOGIN" "$REPORT_USER_LOGIN" "")"
if [[ -z "$CURRENT_REF" ]]; then
  if ! SNAPSHOT_HISTORY_REF="$(resolve_remote_snapshot_ref)"; then
    usage_error "Could not identify the branch for the current remote copy"
  fi
  SNAPSHOT_TARGET_REF="${SNAPSHOT_HISTORY_REF#origin/}"
fi

if [[ "$PARENT_BRANCH_REPORT" == true ]]; then
  BASIS_REF="${CURRENT_REF:-$SNAPSHOT_TARGET_REF}"
  TARGET_REF="$(bt_resolve_parent_branch "$BASIS_REF" main)"
  [[ -n "$TARGET_REF" ]] || \
    usage_error "Current branch '$BASIS_REF' has no parent branch"
  HISTORY_REF="$TARGET_REF"
fi

if [[ "$REMOTE_BRANCH_REPORT" == true ]]; then
  if [[ "$PARENT_BRANCH_REPORT" == false ]]; then
    TARGET_REF="${CURRENT_REF:-$SNAPSHOT_TARGET_REF}"
  fi
  refresh_remote_branch_report_refs "$TARGET_REF"
  HISTORY_REF="origin/$TARGET_REF"
  WORKFLOW_NOTES_REF="briteRepo-remote-workflow"
  BRANCH_REPORT_PREFIX="branch-r"
  BRANCH_SCOPE_LABEL="remote"
elif [[ -z "$TARGET_REF" ]]; then
  BRANCH_REPORT_PREFIX="branch-r"
  WORKFLOW_NOTES_REF="briteRepo-remote-workflow"
  HISTORY_REF="$SNAPSHOT_HISTORY_REF"
  TARGET_REF="$SNAPSHOT_TARGET_REF"
  BRANCH_SCOPE_LABEL="remote"
fi
if [[ "$PARENT_BRANCH_REPORT" == true ]]; then
  if [[ "$BRANCH_SCOPE_LABEL" == "remote" ]]; then
    BRANCH_REPORT_PREFIX="branch-p-r"
  else
    BRANCH_REPORT_PREFIX="branch-p-l"
  fi
fi
[[ -n "$TARGET_REF" ]] || usage_error "Could not resolve current branch/ref"

if ! git rev-parse --verify "$HISTORY_REF" >/dev/null 2>&1; then
  usage_error "Selected branch is not available: $TARGET_REF"
fi
BRANCH_STATUS_TAGS="$(branch_status_tags "$TARGET_REF" "$BRANCH_SCOPE_LABEL")"

log_format='%H%x1f%h%x1f%cI%x1f%an%x1f%ae%x1f%s%x1f%B%x1e'
git_log_args=(
  "$HISTORY_REF"
  --first-parent
  --pretty=format:"$log_format"
)
if ! history="$(git log "${git_log_args[@]}" 2>/dev/null)"; then
  bt_warn "Failed to read repository history"
  exit "$EXIT_HISTORY_READ_FAILED"
fi

entries=()
action_number=0
declare -A push_commit_hashes=()
declare -A affected_tables_cache=()

while IFS= read -r -d $'\x1e' row; do
  while [[ "$row" == $'\n'* ]]; do
    row="${row#$'\n'}"
  done
  [[ -n "$row" ]] || continue
  sep=$'\x1f'
  full_hash="${row%%"$sep"*}"
  row="${row#*"$sep"}"
  short_hash="${row%%"$sep"*}"
  row="${row#*"$sep"}"
  date_text="$(normalize_report_datetime "${row%%"$sep"*}")"
  row="${row#*"$sep"}"
  author_name="${row%%"$sep"*}"
  row="${row#*"$sep"}"
  author_email="${row%%"$sep"*}"
  row="${row#*"$sep"}"
  subject="${row%%"$sep"*}"
  body="${row#*"$sep"}"

  note="$(git notes --ref="$WORKFLOW_NOTES_REF" show "$full_hash" 2>/dev/null || true)"
  if [[ -n "$note" ]]; then
    while IFS= read -r -d $'\x1e' note_record; do
      missing_note_fields="$(workflow_record_missing_fields "$note_record")"
      if [[ -n "$missing_note_fields" ]]; then
        if [[ "$VERBOSE" == true ]]; then
          bt_warn "Skipping malformed workflow record on $short_hash; missing: $missing_note_fields"
        fi
        continue
      fi
      note_type="$(recorded_field_value "$note_record" "Workflow-Type")"
      note_date="$(normalize_report_datetime "$(recorded_field_value "$note_record" "Workflow-Time")")"
      note_user="$(recorded_field_value "$note_record" "Workflow-User")"
      note_command="$(recorded_field_value "$note_record" "Command-Line")"
      note_command="$(expand_command_line_placeholders "$note_command" "$note_record")"
      note_summary="$(recorded_field_value "$note_record" "Summary")"
      note_details="$(printf '%s\n' "$note_record" | workflow_event_details)"
      note_authority="$(recorded_field_value "$note_record" "Authority")"

      previous_tip=""
      pushed_tip=""
      if [[ "$note_type" == "push" ]]; then
        previous_tip="$(recorded_field_value "$note_record" "Previous-Remote-Tip")"
        pushed_tip="$(recorded_field_value "$note_record" "Pushed-Tip")"
        [[ -n "$previous_tip" ]] || \
          previous_tip="$(workflow_detail_value "$note_details" "Previous-Remote-Tip")"
        [[ -n "$pushed_tip" ]] || \
          pushed_tip="$(workflow_detail_value "$note_details" "Pushed-Tip")"
        if [[ "$pushed_tip" == "HEAD" ]]; then
          pushed_tip="$(git rev-parse "$HISTORY_REF" 2>/dev/null || true)"
        fi
        if [[ -n "$previous_tip" && -n "$pushed_tip" ]]; then
          while IFS= read -r push_commit_hash; do
            [[ -n "$push_commit_hash" ]] && \
              push_commit_hashes["$push_commit_hash"]=1
          done < <(git rev-list "$previous_tip..$pushed_tip" \
            2>/dev/null || true)
        fi
      fi

      workflow_record_matches_branch "$note_record" "$TARGET_REF" || continue
      if ! entry_matches_filters "$note_type" "$note_user" \
        "$note_summary $note_details $note_command"; then
        continue
      fi
      note_user_display="$(format_user_with_role "$note_user" "" "" \
        "$note_authority")"
      render_affected_tables_cached "$full_hash" affected_tables

      action_number=$((action_number + 1))
      printf -v entry '## %d. %s: %s\n\n' "$action_number" "$note_type" "$note_date"
      line=""
      if [[ "$note_type" != "push" ]]; then
        printf -v line '**Commit:** `%s`  \n' "$full_hash"
      fi
      entry+="$line"
      if [[ "$note_type" == "push" ]]; then
        printf -v line '**Pushed Branch Tip:** `%s`  \n' "$pushed_tip"
        entry+="$line"
      fi
      printf -v line '**Command:** `%s`  \n' "$note_command"
      entry+="$line"
      printf -v line '**User:** %s  \n' "$note_user_display"
      entry+="$line"
      activity_context="$(render_activity_context "$note_type" \
        "$note_record" "$BRANCH_SCOPE_LABEL" "$TARGET_REF" \
        "$affected_tables")"
      if [[ -n "$activity_context" ]]; then
        entry+="$activity_context"
        entry+=$'\n'
      else
        if [[ -n "$note_summary" && "$note_type" != "push" ]]; then
          printf -v line '\n%s\n' "$note_summary"
          entry+="$line"
        fi
        if [[ -n "$note_details" && "$note_type" != "push" ]]; then
          entry+=$'\n'
          entry+="$note_details"
          entry+=$'\n'
        fi
      fi
      if [[ "$note_type" == "push" ]]; then
        if [[ -n "$previous_tip" && -n "$pushed_tip" ]]; then
          printf -v line '**Commits:** %s  \n' \
            "$(git rev-list --count "$previous_tip..$pushed_tip")"
          entry+="$line"
          push_change_record=""
          push_modified_files=0
          push_deleted_files=0
          push_added_files=0
          push_renamed_files=0
          push_renamed_modified_files=0
          push_deleted_directories=0
          push_added_directories=0
          push_renamed_directories=0
          bt_git_reset_change_summary
          bt_git_collect_ref_change_summary "$previous_tip" "$pushed_tip" >/dev/null 2>&1 || true
          push_modified_files="$BT_CHANGE_MODIFIED_FILES"
          push_deleted_files="$BT_CHANGE_DELETED_FILES"
          push_added_files="$BT_CHANGE_ADDED_FILES"
          push_renamed_files="$BT_CHANGE_RENAMED_FILES"
          push_renamed_modified_files="$BT_CHANGE_RENAMED_MODIFIED_FILES"
          push_deleted_directories="$BT_CHANGE_DELETED_DIRECTORIES"
          push_added_directories="$BT_CHANGE_ADDED_DIRECTORIES"
          push_renamed_directories="$BT_CHANGE_RENAMED_DIRECTORIES"

          for push_field in Files-Modified Files-Deleted Files-Added \
            Files-Renamed Files-Renamed-Modified Directories-Deleted \
            Directories-Added Directories-Renamed; do
            push_field_value="$(recorded_field_value "$note_record" "$push_field")"
            [[ -n "$push_field_value" ]] || \
              push_field_value="$(workflow_detail_value "$note_details" "$push_field")"
            if [[ -n "$push_field_value" ]] && [[ "$push_field_value" =~ ^[0-9]+$ ]]; then
              if [[ "$push_field" == "Files-Modified" && "$push_modified_files" -eq 0 ]]; then
                push_modified_files="$push_field_value"
              elif [[ "$push_field" == "Files-Deleted" && "$push_deleted_files" -eq 0 ]]; then
                push_deleted_files="$push_field_value"
              elif [[ "$push_field" == "Files-Added" && "$push_added_files" -eq 0 ]]; then
                push_added_files="$push_field_value"
              elif [[ "$push_field" == "Files-Renamed" && "$push_renamed_files" -eq 0 ]]; then
                push_renamed_files="$push_field_value"
              elif [[ "$push_field" == "Files-Renamed-Modified" && "$push_renamed_modified_files" -eq 0 ]]; then
                push_renamed_modified_files="$push_field_value"
              elif [[ "$push_field" == "Directories-Deleted" && "$push_deleted_directories" -eq 0 ]]; then
                push_deleted_directories="$push_field_value"
              elif [[ "$push_field" == "Directories-Added" && "$push_added_directories" -eq 0 ]]; then
                push_added_directories="$push_field_value"
              elif [[ "$push_field" == "Directories-Renamed" && "$push_renamed_directories" -eq 0 ]]; then
                push_renamed_directories="$push_field_value"
              fi
            fi
            push_change_record+="$push_field: $push_field_value"$'\n'
          done
          push_changes="$(recorded_change_summary "$push_change_record")"
          [[ -n "$push_changes" ]] || \
            push_changes="$(workflow_detail_value "$note_details" "Files")"
          push_directories_summary="$(push_directory_summary "$push_deleted_directories" "$push_added_directories" "$push_renamed_directories")"
          push_files_summary="$(push_file_summary "$push_modified_files" "$push_deleted_files" "$push_added_files" "$push_renamed_files" "$push_renamed_modified_files")"
          if [[ -n "$push_directories_summary" ]]; then
            printf -v line '**Directories:** %s  \n' "$push_directories_summary"
            entry+="$line"
          fi
          if [[ -n "$push_files_summary" ]]; then
            printf -v line '**Files:** %s.  \n' "$push_files_summary"
            entry+="$line"
            push_line_totals="$(git diff --numstat "$previous_tip" "$pushed_tip" | \
              awk '{ added += $1; deleted += $2 } END { print added + 0, deleted + 0 }')"
            read -r push_added push_deleted <<< "$push_line_totals"
            printf -v line '**Lines:** %s added and %s deleted.  \n' \
              "$push_added" "$push_deleted"
            entry+="$line"
          fi
          entry+="$(render_push_summary_tables "$previous_tip" "$pushed_tip")"
        fi
      else
        entry+="$affected_tables"
      fi
      entries+=("$entry")

      if [[ "$LIMIT" -gt 0 && "${#entries[@]}" -ge "$LIMIT" ]]; then
        break
      fi
    done < <(printf '%s\n' "$note" | workflow_note_records)
  fi

  if [[ "$LIMIT" -gt 0 && "${#entries[@]}" -ge "$LIMIT" ]]; then
    break
  fi

  command_line="$(recorded_field_value "$body" "Command-Line")"
  [[ -n "${push_commit_hashes[$full_hash]+x}" ]] && continue
  command_line="$(expand_command_line_placeholders "$command_line" "$body")"
  entry_type="$(recorded_field_value "$body" "Workflow-Type")"
  [[ -n "$entry_type" ]] || entry_type="$(activity_type "$command_line")"
  context_type="$entry_type"
  context_record="$body"
  action_authority="$(recorded_field_value "$body" "Authority")"
  if ! entry_matches_filters "$entry_type" "$author_name $author_email" \
    "$subject $body"; then
    continue
  fi
  sanitized_body="$(sanitize_commit_body_for_report "$body" "$subject")"
  while [[ "$sanitized_body" == $'\n'* ]]; do
    sanitized_body="${sanitized_body#$'\n'}"
  done
  action_user_display="$(format_user_with_role "$author_name" "$author_name" \
    "$author_email" "$action_authority")"
  render_affected_tables_cached "$full_hash" affected_tables

  action_number=$((action_number + 1))
  printf -v entry '## %d. %s: %s\n\n' "$action_number" "$entry_type" "$date_text"
  printf -v line '**Commit:** `%s`  \n' "$full_hash"
  entry+="$line"
  if [[ -n "$command_line" ]]; then
    printf -v line '**Command:** `%s`  \n' "$command_line"
    entry+="$line"
  fi
  printf -v line '**User:** %s  \n' "$action_user_display"
  entry+="$line"
  activity_context="$(render_activity_context "$context_type" \
    "$context_record" "$BRANCH_SCOPE_LABEL" "$TARGET_REF" \
    "$affected_tables")"
  entry+="$activity_context"
  [[ -z "$activity_context" ]] || entry+=$'\n'
  if [[ -z "$command_line" && -n "$subject" ]] && \
    ! is_redundant_commit_summary "$subject"; then
    printf -v line '\n%s\n' "$subject"
    entry+="$line"
  fi
  if [[ -n "$sanitized_body" ]]; then
    entry+="$sanitized_body"
    entry+=$'\n'
  fi
  entry+="$affected_tables"
  entries+=("$entry")

  if [[ "$LIMIT" -gt 0 && "${#entries[@]}" -ge "$LIMIT" ]]; then
    break
  fi
done < <(printf '%s' "$history")

if [[ "${#entries[@]}" -eq 0 ]]; then
  bt_warn "No matching activity was found"
  exit "$EXIT_NO_MATCH"
fi

trim_trailing_newlines() {
  local text="$1"

  while [[ "$text" == *$'\n' ]]; do
    text="${text%$'\n'}"
  done
  printf '%s' "$text"
}

report_lock_fd=""

bt_report_dir_enable_writes "$REPORTS_DIR" "$EXIT_REPORT_WRITE_FAILED"
if ! bt_report_acquire_lock "$REPO_ROOT" \
  "report-$BRANCH_REPORT_PREFIX" 10 report_lock_fd; then
  bt_warn "Timed out waiting for $BRANCH_REPORT_PREFIX report write lock"
  exit "$EXIT_REPORT_WRITE_FAILED"
fi
report_file="$(bt_report_transient_path \
  "$REPORTS_DIR" "$BRANCH_REPORT_PREFIX" "$RUN_TS_FILE")"
report_rel="${report_file#"${REPO_ROOT}"/}"
if ! {
  printf '# Branch Report\n\n'
  printf '**Branch:** `%s`  \n' "$TARGET_REF"
  printf '**Status:** %s  \n' "$BRANCH_STATUS_TAGS"
  printf '**Generated:** %s  \n' "$RUN_TS_DISPLAY"
  printf '**Command:** `%s`  \n' "$REPORT_COMMAND_LINE"
  printf '**User:** %s\n\n' "$REPORT_USER"
  for entry_index in "${!entries[@]}"; do
    if [[ "$entry_index" -gt 0 ]]; then
      printf '\n'
    fi
    printf '%s\n' "$(trim_trailing_newlines "${entries[$entry_index]}")"
  done
} > "$report_file"; then
  bt_report_release_lock "$report_lock_fd"
  bt_warn "Failed to write report: $report_rel"
  exit "$EXIT_REPORT_WRITE_FAILED"
fi

remove_stale_reports "$report_file" \
  "$REPORTS_DIR/${BRANCH_REPORT_PREFIX}-*.md"
bt_report_release_lock "$report_lock_fd"

if [[ "$VERBOSE" == true ]]; then
  bt_info "Found ${#entries[@]} matching activities"
fi
printf "See '%s'.\n" "$report_rel"
exit 0
