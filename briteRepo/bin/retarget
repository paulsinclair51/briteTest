#!/usr/bin/env bash

# retarget - Retarget a targeted branch to a different version parent.
#
# See usage below for details, or run: retarget -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  retarget [OPTIONS] <new-parent-version> [-- TOKEN...]
  retarget -e [<new-parent-version>]
  retarget {-h | --help}

Move the current targeted branch to a different version parent.

This command is available to contributors, reviewers, and approvers when a
targeted branch must move to another version.

Prerequisites:
  - The current branch must be a local targeted branch.
  - The current branch must not have an unfinished copyfix operation.

Arguments:
  <new-parent-version>  New parent version branch (v<M>.<m>.0)

Options:
  -d                    Validate only. Do not change or publish the branch.
  -e                    Generate an error report without retargeting.
  -h, --help  Output this help to stdout and exit (other options and
              arguments are ignored).
  -c TOKEN              Retarget comment from TOKEN.
  -- TOKEN...           Retarget comment from one or more tokens.
  -t SEC                Remote operation timeout in seconds (default: 10).
                        SEC must be an integer greater than 0.
  -r                    Update the remote targeted branch after
                        the local retarget succeeds.
  -v                    Output progress and diagnostics to stdout.

  For retarget comment options '-c TOKEN' and '-- TOKEN...':
    - These options are mutually exclusive.
    - Comment text is optional and is used to annotate the retarget action.
    - For '-- TOKEN...', '--' must be a separate token.
    - Comment text is built by joining tokens with a single space.
    - For a quoted token, whitespace in the token is preserved and the
      quotes are removed.
    - The resulting retarget comment from TOKEN or TOKEN... must include
      at least one non-whitespace character.

Policy checks:
  - Caller must be a contributor, reviewer, or approver.
  - New parent version branch must exist.
  - For dev/* targeted branches, new parent must be open for dev.
  - For fix/* targeted branches, new parent must be open for fixes.
  - Version openness is read from: config/version_branch_access.csv

Conflict handling:
  - If conflicts occur, the command stops and prints the required steps.
  - A contributor with access to this clone resolves the listed files and
    reruns retarget.

Examples:
  retarget v1.1.0
  retarget -r v1.1.0
  retarget v1.2.0 -c "Defer fix to later version"
  retarget -d v1.1.0

Outputs:
  - Writes help text, status messages, and summaries to stdout.
  - Writes errors and diagnostics to stderr.
  - After a successful local retarget, records local history for the report
    command. With -r, updates the remote branch and its workflow history.
  - With -e, writes <repo>/reports/retarget-e-<datetime>.md.

Exit codes:
  0   Success.
  1   Argument or validation error.
  2   Permission denied (contributor access required or identity unavailable).
  3   Policy denied (branch type/version access window).
  4   Git/prerequisite operation failed.
  5   Conflicts require resolution by the contributor.
  6   Retarget skipped because -e was specified.
EOF
}

# High-Level Flow:
# - Validate contributor identity, current branch, version access, and clean state.
# - Preview the new parent for -d; otherwise rebase the current branch locally.
# - Publish the rewritten target with force-with-lease only when -r is used.
# - Preserve conflicts for another contributor with clone access if needed.
# - Append tracked history and one structured event to the rewritten target tip,
#   then direct users to report generation.

# shellcheck disable=SC1091  # Helper source paths are resolved at runtime.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
ACCESS_FILE="$REPO_ROOT/config/version_branch_access.csv"
ORIGINAL_ARGS=("$@")

# Shared helpers
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/history_log.sh
source "$SCRIPT_DIR/../helpers/history_log.sh"
# shellcheck source=helpers/validation_helpers.sh
source "$SCRIPT_DIR/../helpers/validation_helpers.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_PERMISSION_DENIED=2
readonly EXIT_POLICY_DENIED=3
readonly EXIT_OPERATION_FAILED=4
readonly EXIT_REBASE_CONFLICT=5
readonly EXIT_WORKFLOW_SKIPPED=6
readonly EXIT_REPORT_FAILED=201

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

DRY_RUN=false
ERROR_RUN=false
VERBOSE=false
REMOTE=false
COMMENT=""
REMOTE_TIMEOUT_SECONDS=10
REPORTS_DIR="$REPO_ROOT/reports"
REPORT_FILE=""
REPORT_LOCK_FD=""
RETARGET_BEFORE_TIP=""
RETARGET_REMOTE_BEFORE_TIP=""
UNDO_METADATA_RECORDED=true

generate_error_report() {
  local message="$1"
  local command_text=""

  if ! bt_report_acquire_lock "$REPO_ROOT" "retarget" 10 REPORT_LOCK_FD; then
    bt_error_exit "$EXIT_REPORT_FAILED" \
      "Timed out waiting for the retarget report lock"
  fi
  bt_report_dir_enable_writes "$REPORTS_DIR" "$EXIT_REPORT_FAILED"
  REPORT_FILE="$(bt_report_transient_path \
    "$REPORTS_DIR" "retarget-e" "$(bt_datetime_filename_now)")"
  bt_report_cleanup_transient_reports \
    "$REPORTS_DIR" "${TARGET_BRANCH:-unknown}" "$REPORT_FILE" \
    "retarget-e-*.md"
  command_text="$(bt_format_command_line "retarget" "${ORIGINAL_ARGS[@]}")"
  bt_report_write_header "$REPORT_FILE" "Retarget Error Report" \
    "$(bt_datetime_display_now)" "$command_text"
  cat >> "$REPORT_FILE" <<EOF
**Branch:** \`${TARGET_BRANCH:-unknown}\`

**New Parent:** \`${NEW_PARENT:-unknown}\`

**Exit Code:** ${EXIT_WORKFLOW_SKIPPED}

**Error:** ${message}

## Guidance

- Run without -e option.

EOF
  bt_report_release_lock "$REPORT_LOCK_FD"
  REPORT_LOCK_FD=""
}

log_verbose() {
  if [[ "$VERBOSE" == true ]]; then
    bt_info "$1"
  fi
}

retarget_publication_pending_exit() {
  local reason="$1"

  bt_emit_error \
    "Retargeted '$TARGET_BRANCH' to '$NEW_PARENT' locally, but the remote update is pending: $reason."
  bt_emit_guidance \
    "Address the error, then run retarget -r $NEW_PARENT."
  exit "$EXIT_OPERATION_FAILED"
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

is_contributor_or_higher() {
  local user_name="$1"
  bt_contributors_has_min_role \
    "$user_name" "contributor" "$REPO_ROOT/config/contributors.md"
}

version_window_status() {
  local version="$1"
  local branch_type="$2"

  if [[ ! -f "$ACCESS_FILE" ]]; then
    bt_error_exit "$EXIT_OPERATION_FAILED" \
      "Version access file not found: $ACCESS_FILE"
  fi

  awk -F',' -v version="$version" -v btype="$branch_type" '
    NR == 1 { next }
    /^#/ { next }
    NF >= 3 {
      v=$1
      d=$2
      f=$3
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", d)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", f)
      if (tolower(v) == tolower(version)) {
        if (btype == "dev") {
          print tolower(d)
          found=1
          exit 0
        }
        if (btype == "fix") {
          print tolower(f)
          found=1
          exit 0
        }
      }
    }
    END {
      if (!found) {
        exit 2
      }
    }
  ' "$ACCESS_FILE"
}

# Parse args
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -d)
      [[ "$ERROR_RUN" == false ]] || \
        usage_error "Options -d and -e are mutually exclusive"
      DRY_RUN=true
      shift
      ;;
    -e)
      [[ "$DRY_RUN" == false ]] || \
        usage_error "Options -d and -e are mutually exclusive"
      ERROR_RUN=true
      shift
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    -r)
      REMOTE=true
      shift
      ;;
    -t)
      [[ $# -ge 2 ]] || usage_error "Option -t requires SEC"
      bt_is_valid_remote_timeout "$2" || \
        usage_error "SEC for -t must be an integer greater than 0"
      REMOTE_TIMEOUT_SECONDS="$2"
      shift 2
      ;;
    -c)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -c requires a comment argument"
      fi
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -c and -- for comment"
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      shift
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -c and -- for comment"
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

set -- "${POSITIONAL_ARGS[@]}"
export BT_REMOTE_TIMEOUT_SECONDS="$REMOTE_TIMEOUT_SECONDS"

if [[ "$ERROR_RUN" == true ]]; then
  TARGET_BRANCH="$(bt_get_current_branch_or_empty)"
  TARGET_BRANCH="${TARGET_BRANCH:-unknown}"
  NEW_PARENT="${1:-unknown}"
  generate_error_report "Retarget skipped due to -e option."
  bt_emit_error "Retarget skipped due to -e option."
  bt_emit_guidance "Run without -e option."
  bt_success "See ${REPORT_FILE#"${REPO_ROOT}"/} for details."
  exit "$EXIT_WORKFLOW_SKIPPED"
fi

if [[ $# -ne 1 ]]; then
  usage_error "Expected 1 argument: <new-parent-version>"
fi

TARGET_BRANCH="$(bt_get_current_branch_or_empty)"
NEW_PARENT="$1"

if [[ -z "$TARGET_BRANCH" ]]; then
  bt_error_exit "$EXIT_INVALID_ARGUMENT" \
    "Current branch must be a local targeted branch"
fi

if [[ "$TARGET_BRANCH" =~ ^(dev|fix)/.+-(v[1-9][0-9]?\.(0|[1-9][0-9]?)\.0)$
 ]]; then
  TARGET_TYPE="${BASH_REMATCH[1]}"
  OLD_PARENT="${BASH_REMATCH[2]}"
else
  bt_error_exit "$EXIT_INVALID_ARGUMENT" \
    "Current branch '$TARGET_BRANCH' is not targeted. Use chbranch to select" \
    "a local dev/...-v<M>.<m>.0 or fix/...-v<M>.<m>.0 branch"
fi

if ! bt_is_version_branch "$NEW_PARENT"; then
  bt_error_exit "$EXIT_INVALID_ARGUMENT" \
    "Invalid new parent '$NEW_PARENT'. Expected version branch v<M>.<m>.0"
fi

if [[ "$OLD_PARENT" == "$NEW_PARENT" ]]; then
  bt_warn "Branch '$TARGET_BRANCH' already targets '$NEW_PARENT'"
  exit 0
fi

CURRENT_USER="$(bt_require_login || true)"
CURRENT_USER="$(trim "$CURRENT_USER")"
if [[ -z "$CURRENT_USER" ]]; then
  bt_error_exit "$EXIT_PERMISSION_DENIED" \
    "Unable to determine GitHub login identity for permission check"
fi

if ! is_contributor_or_higher "$CURRENT_USER"; then
  bt_error_exit "$EXIT_PERMISSION_DENIED" \
    "User '$CURRENT_USER' is not a contributor"
fi

log_verbose "Contributor access verified: $CURRENT_USER"

status=""
if status=$(version_window_status "$NEW_PARENT" "$TARGET_TYPE"); then
  :
else
  status_rc=$?
  if [[ "$status_rc" -eq 2 ]]; then
    bt_error_exit "$EXIT_POLICY_DENIED" \
      "Version '$NEW_PARENT' has no access policy in $ACCESS_FILE"
  fi
  bt_error_exit "$EXIT_OPERATION_FAILED" \
    "Failed to evaluate version access policy"
fi

if [[ "$status" != "open" ]]; then
  bt_error_exit "$EXIT_POLICY_DENIED" \
    "Version '$NEW_PARENT' is closed for '$TARGET_TYPE' branches"
fi

if bt_is_copyfix_in_progress "$TARGET_BRANCH"; then
  bt_emit_prerequisite_failure "$EXIT_OPERATION_FAILED" \
    "Current branch '$TARGET_BRANCH' has an unfinished copyfix operation." \
    "rerun copyfix to complete it before rerunning retarget."
fi

cd "$REPO_ROOT"

if bt_git_workflow_marker_matches retarget "$TARGET_BRANCH" && \
  bt_git_is_rebase_in_progress; then
  RETARGET_BEFORE_TIP="$(git rev-parse ORIG_HEAD 2>/dev/null || true)"
  if ! bt_git_stage_resolved_rebase_files; then
    bt_emit_prerequisite_failure "$EXIT_REBASE_CONFLICT" \
      "Retarget still has unresolved conflicts on '$TARGET_BRANCH'." \
      "resolve the remaining conflicts and rerun retarget -r $NEW_PARENT."
  fi
  while bt_git_is_rebase_in_progress; do
    if ! GIT_BYPASS_HOOKS=true GIT_EDITOR=true \
      git rebase --continue >/dev/null 2>&1; then
      bt_emit_prerequisite_failure "$EXIT_REBASE_CONFLICT" \
        "Retarget rebase paused again on '$TARGET_BRANCH'." \
        "resolve the remaining conflicts and rerun retarget -r $NEW_PARENT."
    fi
  done
  bt_git_clear_workflow_in_progress retarget
fi

if bt_is_worktree_dirty; then
  bt_error_exit "$EXIT_OPERATION_FAILED" \
    "Current branch has uncommitted changes. Commit first before running" \
    "retarget"
fi

if ! bt_run_remote_command git fetch origin >/dev/null 2>&1; then
  bt_error_exit "$EXIT_OPERATION_FAILED" "Failed to fetch from remote"
fi

if ! git show-ref --verify --quiet "refs/remotes/origin/$NEW_PARENT"; then
  bt_error_exit "$EXIT_INVALID_ARGUMENT" \
    "New parent version branch '$NEW_PARENT' not found on remote"
fi

log_verbose "Retargeting '$TARGET_BRANCH' from '$OLD_PARENT' to '$NEW_PARENT'"
[[ -n "$RETARGET_BEFORE_TIP" ]] || \
  RETARGET_BEFORE_TIP="$(git rev-parse HEAD 2>/dev/null || true)"
if [[ "$DRY_RUN" == true ]]; then
  bt_success "Dry-run: retarget $TARGET_BRANCH -> $NEW_PARENT"
  log_verbose "Rebase preview: git rebase origin/$NEW_PARENT"
  exit 0
fi

ALREADY_RETARGETED=false
if git merge-base --is-ancestor "origin/$NEW_PARENT" HEAD; then
  ALREADY_RETARGETED=true
fi

if [[ "$ALREADY_RETARGETED" == false ]]; then
  bt_git_mark_workflow_in_progress retarget "$TARGET_BRANCH" || \
    bt_error_exit "$EXIT_GIT_FAILED" \
      "Failed to record retarget progress for '$TARGET_BRANCH'"
  if ! git rebase "origin/$NEW_PARENT"; then
    bt_emit_error "Retarget in progress for '$TARGET_BRANCH'."
    bt_emit_guidance \
      "Resolve conflicts in the current branch, then rerun retarget -r $NEW_PARENT."
    exit "$EXIT_REBASE_CONFLICT"
  fi
  bt_git_clear_workflow_in_progress retarget
elif [[ "$REMOTE" == true ]]; then
  log_verbose "Local branch already contains new parent '$NEW_PARENT'; updating the remote branch"
else
  bt_warn "Branch '$TARGET_BRANCH' is already based on '$NEW_PARENT'"
  exit 0
fi

MESSAGE="Retargeted '$TARGET_BRANCH' from '$OLD_PARENT' to '$NEW_PARENT' by "
MESSAGE+="approver '$CURRENT_USER'"
command_line="$(bt_format_command_line "retarget" "${ORIGINAL_ARGS[@]}")"
retarget_tip="$(git rev-parse HEAD 2>/dev/null || true)"
local_retarget_note="$(git notes --ref=briteRepo-workflow show \
  "$retarget_tip" 2>/dev/null || true)"
local_retarget_recorded=false
if [[ "$(bt_workflow_note_field "$local_retarget_note" "Workflow-Type")" == \
  "retarget" && \
  "$(bt_workflow_note_field "$local_retarget_note" "New-Parent")" == \
  "$NEW_PARENT" ]]; then
  local_retarget_recorded=true
fi
if [[ "$local_retarget_recorded" == false ]]; then
  if ! bt_record_workflow_event "retarget" "$TARGET_BRANCH" "$command_line" \
    "$MESSAGE" "$retarget_tip" \
    "Old-Parent" "$OLD_PARENT" \
    "New-Parent" "$NEW_PARENT" \
    "Retargeted-Tip" "$retarget_tip" \
    "Comment" "${COMMENT:-none}"; then
    bt_emit_error \
      "Retargeted '$TARGET_BRANCH' to '$NEW_PARENT' locally, but report metadata was not recorded."
    bt_emit_guidance \
      "Rerun retarget -r $NEW_PARENT to record metadata and update the remote branch."
    exit "$EXIT_OPERATION_FAILED"
  fi
fi
if [[ "$REMOTE" == true ]]; then
  RETARGET_REMOTE_BEFORE_TIP="$(git rev-parse \
    "origin/$TARGET_BRANCH" 2>/dev/null || true)"
  if ! bt_refresh_remote_workflow_history; then
    retarget_publication_pending_exit \
      "remote report history could not be refreshed"
  fi
  if ! bt_record_remote_workflow_event "retarget" "$TARGET_BRANCH" \
    "$command_line" "Updated retargeted '$TARGET_BRANCH' on remote" \
    "$retarget_tip" \
    "Old-Parent" "$OLD_PARENT" \
    "New-Parent" "$NEW_PARENT" \
    "Retargeted-Tip" "$retarget_tip" \
    "Comment" "${COMMENT:-none}"; then
    retarget_publication_pending_exit \
      "remote report metadata could not be recorded"
  fi
  if ! bt_run_remote_command env GIT_BYPASS_HOOKS=true git push --atomic \
    --force-with-lease="refs/heads/$TARGET_BRANCH" origin "$TARGET_BRANCH" \
    refs/notes/briteRepo-remote-workflow:refs/notes/briteRepo-remote-workflow; then
    retarget_publication_pending_exit \
      "the branch and report metadata could not be recorded"
  fi
fi

if [[ "$REMOTE" == true ]]; then
  bt_undo_record_operation retarget "$TARGET_BRANCH" \
    "$RETARGET_BEFORE_TIP" "$retarget_tip" local-remote-reset \
    "$MESSAGE" "$RETARGET_REMOTE_BEFORE_TIP" "$retarget_tip" >/dev/null || \
    UNDO_METADATA_RECORDED=false
else
  bt_undo_record_operation retarget "$TARGET_BRANCH" \
    "$RETARGET_BEFORE_TIP" "$retarget_tip" hard-reset "$MESSAGE" \
    >/dev/null || \
    UNDO_METADATA_RECORDED=false
fi

if [[ "$UNDO_METADATA_RECORDED" == true ]]; then
  bt_success "Retargeted '$TARGET_BRANCH' to '$NEW_PARENT'"
else
  bt_warn "Retargeted '$TARGET_BRANCH' to '$NEW_PARENT', but undo metadata could not be recorded"
  bt_emit_guidance \
    "Retarget cannot be undone; rerunning retarget cannot recreate the missing metadata."
fi

bt_success "Run report for local details."
if [[ "$REMOTE" == true ]]; then
  bt_success "For remote details, run report -r."
else
  bt_success "Run retarget -r $NEW_PARENT when ready to update remote."
fi

exit 0
