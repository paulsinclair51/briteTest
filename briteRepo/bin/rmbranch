#!/usr/bin/env bash

# rmbranch - Remove a branch locally and/or from remote.
#
# See usage below for details, or run: rmbranch -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  rmbranch [OPTIONS] <branchname> [-- MSG]
  rmbranch {-h | --help}

Remove a local branch and/or remote branch.

Arguments:
  <branchname>       Name of the branch to remove.
                     Examples: fix/bug, add-feature, refactor.

Protected branches:
  - main and version branches cannot be removed from remote.
  - Local protected branches can be removed when they exist as local.
  - No branch-name policy validation is applied by this script. If a branch
    ref exists (local and/or remote), it can be removed subject to protected
    branch safeguards above.

Permissions:
  - The current user must be a contributor, reviewer, or approver.

Options:
  -a            Remove from both local and remote (alias for -l -r).
  -c TOKEN      Branch-removal comment from TOKEN.
                Usage: rmbranch patch/old-fix -c
                "Reverted in favor of better approach.".
  -- TOKEN...   Branch-removal comment from one or more tokens.
                     Usage: rmbranch patch/old-fix --
                Reverted in favor of better approach.
  -h, --help    Output this help to stdout and exit (other options and
                arguments are ignored).
  -l            Remove local branch.
  -r            Remove branch from remote.
  -t SEC        Remote operation timeout in seconds (default: 10).
                SEC must be an integer greater than 0.

  For branch-removal comment options '-c TOKEN' and '-- TOKEN...':
    - These options are mutually exclusive.
    - Comment text is optional and is used to annotate the deletion.
    - For '-- TOKEN...', '--' must be a separate token.
    - Comment text is built by joining tokens with a single space.
    - For a quoted token, whitespace in the token is preserved and the
      quotes are removed.
    - The resulting branch-removal comment from TOKEN or TOKEN... must
      include at least one non-whitespace character.

Safety behavior:
  - rmbranch requires typing `DELETE <branchname>` when deletion may discard
    unique commits or remove a parent branch used by another branch.
  - rmbranch requires typing `DELETE <branchname>` when local deletion
    is unable to use safe mode due to unpushed or unpushed-up changes.
  - Local-only deletion (-l) is blocked when the branch also exists on
    remote. Use -a (or -l -r) to remove both local and remote together.
  - When local deletion is requested (-l or default both), working tree must
    be clean before deletion starts.
  - Local deletion is blocked if a pending `chbranch` auto-stash exists for
    the target branch.
  - Rerun with -f only after validating branch cleanup status.

Modes:
  Local (-l):
    - Remove the local branch.
    - Log the operation to 'logs/local_branch_history.md'.

  Remote (-r):
    - Remove the branch from remote only.
    - Log the operation to 'logs/remote_branch_history.md'.
    - Exits with code 5 if the remote branch is protected and
      cannot be removed.

  Both (-l -r, default):
    - Remove the local branch.
    - Remove the branch from remote.
    - Fails if the remote branch is protected (main or version).
    - Log the operation to 'logs/remote_branch_history.md' and
      'logs/local_branch_history.md'

Examples:
  # Basic usage.
  rmbranch old-fix
  rmbranch -l old-fix
  rmbranch -r experiment
  rmbranch -l -r -f temp-feature
  rmbranch -a -f temp-feature

  # With -c comment.
  rmbranch old-fix -c "Reverted in favor of better
    approach."
  rmbranch -r experiment -c "Experiment failed."

  # With Unix-style comment.
  rmbranch old-fix -- Reverted in favor of better
    approach.
  rmbranch -r experiment -- Experiment failed.

  # Force removal with comment.
  rmbranch -f temp -c "Temporary testing branch."
  rmbranch -a -f old -- Cleanup old feature branch.

Outputs:
  - Writes help text, status messages, and results or summaries to stdout.
  - Writes errors and diagnostics to stderr.

Exit codes:
  0   Success.
  1   Argument error.
  2   Git operation failed.
  3   Branch does not exist.
  4   Branch has unmerged commits (use -f option to force removal).
  5   User is not authorized (must be contributor or higher).
  6   Local deletion blocked (working tree not clean or pending auto-stash
      exists for target branch).
  7   Local-only deletion blocked because branch also exists on remote.
EOF
}

# High-Level Flow:
# - Deletes branches locally and optionally on remote with
#   protected-branch safeguards.
# - Validates branch existence, current-branch constraints, and deletion scope.
# - Reports deletion results and skipped/protected targets.

# shellcheck disable=SC1091  # Helper source paths are resolved at runtime.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
COMMON_HELPER="$SCRIPT_DIR/../helpers/common.sh"
HISTORY_HELPER="$SCRIPT_DIR/../helpers/history_log.sh"
CKROLE_HELPER="$SCRIPT_DIR/../helpers/ckrole.sh"

# Shared helpers
if [[ ! -f "$COMMON_HELPER" ]]; then
  bt_emit_error "Required helper not found: $COMMON_HELPER"
  exit 2
fi
if [[ ! -f "$HISTORY_HELPER" ]]; then
  bt_emit_error "Required helper not found: $HISTORY_HELPER"
  exit 2
fi
if [[ ! -f "$CKROLE_HELPER" ]]; then
  bt_emit_error "Required helper not found: $CKROLE_HELPER"
  exit 2
fi

# shellcheck source=helpers/common.sh
if ! source "$COMMON_HELPER"; then
  bt_emit_error "Failed to load helper: $COMMON_HELPER"
  exit 2
fi
# Record branch-deletion history against the main branch history log so
# branch cleanup actions are preserved regardless of which branch was checked
# out during execution.
# shellcheck source=helpers/history_log.sh
if ! source "$HISTORY_HELPER"; then
  bt_emit_error "Failed to load helper: $HISTORY_HELPER"
  exit 2
fi
# shellcheck source=helpers/validation_helpers.sh
VALIDATION_HELPER="$SCRIPT_DIR/../helpers/validation_helpers.sh"
# shellcheck disable=SC1090  # Path is validated immediately before sourcing.
if ! source "$VALIDATION_HELPER"; then
  _msg="Error: Failed to load helper: $VALIDATION_HELPER"
  echo "$_msg" >&2
  exit 2
fi
GIT_HELPER="$SCRIPT_DIR/../helpers/git_helpers.sh"
if [[ ! -f "$GIT_HELPER" ]]; then
  bt_emit_error "Required helper not found: $GIT_HELPER"
  exit 2
fi
# shellcheck source=helpers/git_helpers.sh
if ! source "$GIT_HELPER"; then
  bt_emit_error "Failed to load helper: $GIT_HELPER"
  exit 2
fi

usage_error() {
  local message="$1"
  usage
  echo >&2
  bt_emit_error "$message. See usage above for details."
  exit 1
}

# Default options
MODE="both"  # local, remote, or both
FORCE=false
COMMENT=""
INCLUDE_LOCAL_FLAG=false
INCLUDE_REMOTE_FLAG=false
REMOTE_TIMEOUT_SECONDS=10

append_log_entry() {
  local target="${1:-local}"
  local branchname="$2"
  local message="$3"
  local comment="${4:-}"
  local notes_ref="refs/notes/briteRepo-workflow"
  local record=""
  local timestamp=""
  local target_commit=""

  case "$target" in
    local)
      target_commit="$(git rev-parse --verify refs/heads/main 2>/dev/null || true)"
      ;;
    remote)
      target_commit="$(git rev-parse --verify refs/remotes/origin/main 2>/dev/null || git rev-parse --verify refs/heads/main 2>/dev/null || true)"
      ;;
    *)
      return 0
      ;;
  esac

  [[ -n "$target_commit" ]] || return 0

  timestamp="$(date '+%Y-%m-%d %H:%M:%S%z' | sed -E 's/([+-][0-9]{2})([0-9]{2})$/\1:\2/')"
  record=$(cat <<EOF
--- briteRepo workflow ---
Workflow-Type: rmbranch
Workflow-Time: ${timestamp}
Workflow-Branch: ${branchname}
Workflow-User: $(git config user.name 2>/dev/null || echo unknown) <$(git config user.email 2>/dev/null || echo unknown@local)>
Command-Line: rmbranch ${branchname}
Summary: ${message}
Scope: ${target}
EOF
)
  if [[ -n "$comment" ]]; then
    record+=$'\n'
    record+="Comment: ${comment}"
  fi

  git notes --ref="$notes_ref" append -m "$record" "$target_commit" >/dev/null 2>&1 || true

  if [[ "$target" == "remote" ]]; then
    git push origin refs/notes/briteRepo-workflow:refs/notes/briteRepo-workflow >/dev/null 2>&1 || true
  fi
}

log_operation() {
  local status="$1"
  local branchname="$2"
  local message="$3"
  local comment="${4:-}"
  local scope="${5:-local}"

  : "$status"
  append_log_entry "$scope" "$branchname" "$message" "$comment"
}

error_exit() {
  local code="$1"
  local message="$2"
  local branchname="${3:-}"
  local comment="${4:-}"

  bt_emit_error "$message"

  if [[ -n "$branchname" ]]; then
    _log_msg="Branch \`$branchname\` deletion failed"
    log_operation "FAILED" "$branchname" \
        "$_log_msg - $message" "$comment" "${MODE:-local}"
  fi

  exit "$code"
}

info() {
  bt_info "$1"
}

success() {
  bt_success "$1"
}

warn() {
  bt_warn "$1"
}

is_protected_branch() {
  local branch="$1"

  bt_is_protected_branch "$branch"
}

# Use exact ref lookups rather than generic revision parsing so branch-like
# names that are invalid by local policy can still be removed when refs exist.
local_branch_exists() {
  local branch="$1"
  git show-ref --verify --quiet "refs/heads/$branch"
}

remote_branch_exists() {
  local branch="$1"
  git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

find_branch_auto_stash_ref() {
  local branch="$1"
  local prefix

  prefix="chbranch-auto:${branch}:"
  git stash list --format='%gd%x09%gs' | \
    awk -F '\t' -v p="$prefix" 'index($2, p) { print $1; exit }'
}

branch_ahead_count() {
  local base_ref="$1"
  local branch_ref="$2"

  git rev-list --count "$base_ref..$branch_ref" 2>/dev/null || echo 0
}

preferred_parent_ref() {
  local branch="$1"
  local parent=""

  parent="$(bt_resolve_parent_branch "$branch" "" 2>/dev/null || true)"
  [[ -n "$parent" ]] || return 1
  if remote_branch_exists "$parent"; then
    printf 'origin/%s\n' "$parent"
  elif local_branch_exists "$parent"; then
    printf '%s\n' "$parent"
  fi
}

branch_children() {
  local target="$1"
  local candidate=""
  local candidate_parent=""

  git for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin \
    2>/dev/null | sed 's#^origin/##' | grep -v '^HEAD$' | sort -u | \
    while IFS= read -r candidate; do
      [[ -n "$candidate" && "$candidate" != "$target" ]] || continue
      candidate_parent="$(bt_resolve_parent_branch "$candidate" "" \
        2>/dev/null || true)"
      [[ "$candidate_parent" == "$target" ]] && printf '%s\n' "$candidate"
    done || true
}

collect_deletion_risks() {
  local parent_ref=""
  local count=0
  local children=""

  DELETION_RISKS=()
  if [[ "$LOCAL_EXISTS" == true && "$REMOTE_EXISTS" == true ]]; then
    count="$(branch_ahead_count "origin/$BRANCHNAME" "$BRANCHNAME")"
    if [[ "$count" -gt 0 ]]; then
      DELETION_RISKS+=("local branch has $count commit(s) not on its remote")
      DELETION_RISKS+=("remote branch is behind its local branch")
    fi
  fi
  if [[ "$LOCAL_EXISTS" == true ]]; then
    parent_ref="$(preferred_parent_ref "$BRANCHNAME" || true)"
    if [[ -n "$parent_ref" ]]; then
      count="$(branch_ahead_count "$parent_ref" "$BRANCHNAME")"
      [[ "$count" -eq 0 ]] || \
        DELETION_RISKS+=("local branch has $count commit(s) not on parent '$parent_ref'")
    fi
  fi
  if [[ "$REMOTE_EXISTS" == true ]]; then
    parent_ref="$(preferred_parent_ref "$BRANCHNAME" || true)"
    if [[ -n "$parent_ref" ]]; then
      count="$(branch_ahead_count "$parent_ref" "origin/$BRANCHNAME")"
      [[ "$count" -eq 0 ]] || \
        DELETION_RISKS+=("remote branch has $count commit(s) not on parent '$parent_ref'")
    fi
  fi
  children="$(branch_children "$BRANCHNAME")"
  if [[ -n "$children" ]]; then
    DELETION_RISKS+=("branch is the parent of: $(tr '\n' ' ' <<< "$children" | sed 's/[[:space:]]*$//')")
  fi
}

confirm_risky_deletion() {
  local response=""
  local reason=""

  [[ ${#DELETION_RISKS[@]} -gt 0 ]] || return 0
  echo "Branch deletion requires confirmation:"
  for reason in "${DELETION_RISKS[@]}"; do
    echo "  - $reason"
  done
  echo -n "Type DELETE $BRANCHNAME to confirm: "
  read -r response
  [[ "$response" == "DELETE $BRANCHNAME" ]]
}

# Parse options and arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -l)
      INCLUDE_LOCAL_FLAG=true
      shift
      ;;
    -r)
      INCLUDE_REMOTE_FLAG=true
      shift
      ;;
    -t)
      [[ $# -ge 2 ]] || usage_error "Option -t requires SEC" "" ""
      bt_is_valid_remote_timeout "$2" || \
        usage_error "SEC for -t must be an integer greater than 0" "" ""
      REMOTE_TIMEOUT_SECONDS="$2"
      shift 2
      ;;
    -a)
      INCLUDE_LOCAL_FLAG=true
      INCLUDE_REMOTE_FLAG=true
      shift
      ;;
    -f)
      FORCE=true
      shift
      ;;
    -c)
      if [[ $# -lt 2 ]]; then
        usage_error "Option -c requires a comment argument" "" ""
      fi
      if [[ -n "$COMMENT" ]]; then
      _msg="Cannot use both -c and -- for comment"
      usage_error "$_msg" "" ""
      fi
      COMMENT="$2"
      shift 2
      ;;
    --)
      # Unix-style comment: everything after -- is the comment
      shift
      if [[ -n "$COMMENT" ]]; then
        usage_error "Cannot use both -c and -- for comment" "" ""
      fi
      COMMENT="$*"
      break
      ;;
    -*)
      usage_error "Unknown option: $1" "" ""
      ;;
    *)
      # Positional argument
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

export BT_REMOTE_TIMEOUT_SECONDS="$REMOTE_TIMEOUT_SECONDS"

# Resolve deletion scope: if neither -l nor -r is provided, default to both.
if [[ "$INCLUDE_LOCAL_FLAG" == false && "$INCLUDE_REMOTE_FLAG" == false ]]; then
  INCLUDE_LOCAL=true
  INCLUDE_REMOTE=true
else
  INCLUDE_LOCAL="$INCLUDE_LOCAL_FLAG"
  INCLUDE_REMOTE="$INCLUDE_REMOTE_FLAG"
fi

if [[ "$INCLUDE_LOCAL" == true && "$INCLUDE_REMOTE" == true ]]; then
  MODE="both"
elif [[ "$INCLUDE_LOCAL" == true ]]; then
  MODE="local"
else
  MODE="remote"
fi

# Restore positional arguments
set -- "${POSITIONAL_ARGS[@]}"

# Check that we have exactly 1 positional argument
if [[ $# -ne 1 ]]; then
  usage_error "Expected 1 argument (branchname), got $#" ""
fi

BRANCHNAME="$1"

# Validate branch name
if [[ -z "$BRANCHNAME" ]]; then
  usage_error "Branch name cannot be empty" ""
fi

# Change to repo root
cd "$REPO_ROOT"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  _msg="Repository root '$REPO_ROOT' is not a Git"
  error_exit 2 "$_msg working tree" "$BRANCHNAME" \
      "$COMMENT"
fi

# Require contributor role (or higher) for branch deletion operations.
if ! BRITEREPO_INTERNAL=1 bash "$CKROLE_HELPER" contributor >/dev/null 2>&1; then
  unauthorized_msg=""

  ACTOR_LOGIN="$(bt_resolve_login_or_empty)"
  if [[ -z "$ACTOR_LOGIN" ]]; then
    ACTOR_LOGIN="<unknown>"
  fi
  unauthorized_msg="User '$ACTOR_LOGIN' is not authorized to run rmbranch "
  unauthorized_msg+="(requires contributor role or higher)"
  error_exit 7 "$unauthorized_msg" "$BRANCHNAME" "$COMMENT"
fi

if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  if ! git remote get-url origin >/dev/null 2>&1; then
    error_exit 2 "This clone has no remote repository URL" "$BRANCHNAME" "$COMMENT"
  fi
fi

# Determine operation description
case "$MODE" in
  local)
    info "Removing local branch '$BRANCHNAME'..."
    ;;
  remote)
    info "Removing branch '$BRANCHNAME' from remote..."
    ;;
  both)
    info "Removing branch '$BRANCHNAME' from local and remote..."
    ;;
esac

# Fetch latest refs from remote
if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  info "Fetching latest refs from remote..."
  fetch_output=""
  if ! fetch_output="$(bt_run_remote_command git fetch origin 2>&1)"; then
    error_exit 2 "Failed to fetch from remote: ${fetch_output:-unknown error}" \
      "$BRANCHNAME" "$COMMENT"
  fi
  
fi

# Check if branch exists (local or remote)
LOCAL_EXISTS=false
REMOTE_EXISTS=false

if local_branch_exists "$BRANCHNAME"; then
  LOCAL_EXISTS=true
fi

if remote_branch_exists "$BRANCHNAME"; then
  REMOTE_EXISTS=true
fi

# Protected branches are never removed from remote.
if is_protected_branch "$BRANCHNAME"; then
  if [[ "$MODE" == "remote" ]]; then
    _msg="Remote branch '$BRANCHNAME' is protected and cannot be removed"
    error_exit 5 "$_msg" "$BRANCHNAME" "$COMMENT"
  fi

  if [[ "$MODE" == "both" ]]; then
    if [[ "$REMOTE_EXISTS" == true ]]; then
      _msg="Remote branch '$BRANCHNAME' is protected and cannot be removed; "
      _msg+="local branch deletion is blocked unless both local and remote "
      _msg+="can be removed"
      error_exit 5 "$_msg" "$BRANCHNAME" "$COMMENT"
    fi
  fi
fi

# Verify branch exists in the requested mode
if [[ "$MODE" == "local" && "$LOCAL_EXISTS" == false ]]; then
  _msg="Local branch '$BRANCHNAME' does not exist"
  error_exit 3 "$_msg" "$BRANCHNAME" "$COMMENT"
elif [[ "$MODE" == "remote" && "$REMOTE_EXISTS" == false ]]; then
  _msg="Remote branch '$BRANCHNAME' does not exist"
  error_exit 3 "$_msg" "$BRANCHNAME" "$COMMENT"
elif [[ "$MODE" == "both" && "$LOCAL_EXISTS" == false && \
    "$REMOTE_EXISTS" == false ]]; then
  _msg="Branch '$BRANCHNAME' does not exist locally" 
  error_exit 3 "$_msg or remotely" "$BRANCHNAME" \
      "$COMMENT"
fi

if [[ "$MODE" == "local" && "$LOCAL_EXISTS" == true && \
  "$REMOTE_EXISTS" == true ]]; then
  _msg="Local branch '$BRANCHNAME' has corresponding remote branch "
  _msg+="'origin/$BRANCHNAME'. Use -a (or -l -r) to remove both"
  error_exit 9 "$_msg" "$BRANCHNAME" "$COMMENT"
fi

# Additional preconditions for local deletion.
if [[ "$MODE" == "local" || "$MODE" == "both" ]]; then
  if [[ "$LOCAL_EXISTS" == true ]]; then
    if bt_is_worktree_dirty; then
      _msg="Working tree must be clean before deleting local branch "
      _msg+="'$BRANCHNAME'"
      error_exit 8 "$_msg" "$BRANCHNAME" "$COMMENT"
    fi

    BRANCH_AUTO_STASH_REF="$(find_branch_auto_stash_ref "$BRANCHNAME")"
    if [[ -n "$BRANCH_AUTO_STASH_REF" ]]; then
      _msg="Pending auto-stash '$BRANCH_AUTO_STASH_REF' exists for "
      _msg+="'$BRANCHNAME'; switch to '$BRANCHNAME' to recover it "
      _msg+="(or drop it explicitly) before deletion"
      error_exit 8 "$_msg" "$BRANCHNAME" "$COMMENT"
    fi
  fi
fi

collect_deletion_risks
if ! confirm_risky_deletion; then
  error_exit 2 "Branch deletion cancelled" "$BRANCHNAME" "$COMMENT"
fi

# Delete local branch if needed
if [[ "$MODE" == "local" || "$MODE" == "both" ]]; then
  if [[ "$LOCAL_EXISTS" == true ]]; then
    info "Deleting local branch..."
    
    # Check if we're currently on the branch
    CURRENT_BRANCH=$(bt_get_current_branch_or_empty)
    if [[ "$CURRENT_BRANCH" == "$BRANCHNAME" ]]; then
      info "Switching away from '$BRANCHNAME' before deletion..."
      if [[ "$BRANCHNAME" != "main" ]] && local_branch_exists "main"; then
        if ! git switch main >/dev/null 2>&1; then
          _msg="Failed to switch away from branch"
          error_exit 2 "$_msg '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
        fi
      elif remote_branch_exists "main"; then
        if ! git switch --detach "origin/main" >/dev/null 2>&1; then
          _msg="Failed to switch away from branch"
          error_exit 2 "$_msg '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
        fi
      else
        _msg="Failed to switch away from branch"
        error_exit 2 "$_msg '$BRANCHNAME'" "$BRANCHNAME" "$COMMENT"
      fi
    fi
    
    if ! git branch -d "$BRANCHNAME" >/dev/null 2>&1; then
      if [[ "$FORCE" == true ]]; then
        _msg="Local branch has unmerged commits, forcing"
        warn "$_msg deletion..."
        if ! git branch -D "$BRANCHNAME" >/dev/null 2>&1; then
          _msg="Failed to delete local branch"
          error_exit 2 "$_msg '$BRANCHNAME'" "$BRANCHNAME" \
              "$COMMENT"
        fi
      else
        _msg="Local branch '$BRANCHNAME' has unmerged commits; use -f option"
        _msg+=" to force removal"
        error_exit 6 "$_msg" "$BRANCHNAME" "$COMMENT"
      fi
    fi
    
    success "Local branch '$BRANCHNAME' deleted"
  fi
fi

# Delete remote branch if needed
if [[ "$MODE" == "remote" || "$MODE" == "both" ]]; then
  if [[ "$REMOTE_EXISTS" == true ]]; then
    info "Deleting remote branch..."
    push_output=""
    if ! push_output="$(bt_run_remote_command env GIT_BYPASS_HOOKS=true \
      git push origin --delete "$BRANCHNAME" 2>&1)"; then
    _msg="Failed to delete remote branch" 
    _msg="$_msg '$BRANCHNAME': ${push_output:-unknown error}"
    error_exit 2 "$_msg" "$BRANCHNAME" "$COMMENT"
    fi
    
    success "Remote branch '$BRANCHNAME' deleted"
  fi
fi

# Log successful operation
_log_msg="Branch \`$BRANCHNAME\` deleted."
if [[ "$MODE" == "local" ]]; then
  log_operation "SUCCESS" "$BRANCHNAME" "$_log_msg" "$COMMENT" "local"
elif [[ "$MODE" == "remote" ]]; then
  log_operation "SUCCESS" "$BRANCHNAME" "$_log_msg" "$COMMENT" "remote"
else
  log_operation "SUCCESS" "$BRANCHNAME" "$_log_msg" "$COMMENT" "local"
  log_operation "SUCCESS" "$BRANCHNAME" "$_log_msg" "$COMMENT" "remote"
fi

success "Branch '$BRANCHNAME' successfully removed"

exit 0
