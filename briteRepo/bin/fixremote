#!/usr/bin/env bash

# fixremote - Recover a remote repository from a healthy local clone.
#
# See usage below for details, or run: fixremote -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  fixremote [OPTIONS] <clone-path>
  fixremote {-h | --help}

Restore remote branches, tags, and required Git data from a healthy local clone.

By default, fixremote checks whether recovery can be performed and writes a
report without changing the remote. Use -x to perform the recovery.

When to use this script:
  - Use fixremote only after fixlocal and fixrepo show that the issue is in the
    remote repository, or when remote branches, tags, or Git data are damaged.
  - Use fixlocal first for local files or branch synchronization problems;
    fixlocal is the default starting point for fixing the current local repo.
  - Use fixrepo for broader local repository-level verification/repair.
  - Use override -r only to mark a temporary owner-admin remote repair window;
    it does not perform the repair itself.

Recommended order when more than one repair path applies:
  1. fixlocal (default for fixing the current local repository)
  2. fixrepo
  3. fixremote
  4. owner-admin remote repair workflow, if required

Prerequisites:
  - User must be an approver/owner (checked via config/contributors.md).
  - Clone-path must point to a clean, healthy clone of the same repository.
  - The remote repository must exist and be reachable for recovery.

Arguments:
  <clone-path>      Path to clean local clone used as recovery source.

Options:
  -d                Check and report only. Does not change the remote.
  -h, --help  Output this help to stdout and exit (other options and
              arguments are ignored).
  -t SEC            Remote reachability timeout in seconds (default: 10).
                    Use 0 to skip reachability checks.
  -v                Verbose mode: add per-step detail and print report at end.
  -x                Execute recovery actions (required for mutation).

What This Script Does:
  1. Verifies user authorization (approver/owner).
  2. Validates source clone integrity and cleanliness.
  3. Verifies that both local repositories refer to the same remote.
  4. With -x, restores remote branches and tags from the healthy clone.
  5. Verifies that remote main matches the healthy clone after recovery.
  6. Generates a recovery report.

What Gets Recovered:
  - Remote branches and tags found in the healthy clone (-x mode).
  - Required Git data available from those branches and tags (-x mode).

What Does NOT Get Recovered:
  - Data not present in the source clone.
  - GitHub settings, permissions, issues, pull requests, or other service data.

Outputs:
  - Writes an untracked local recovery report to:
  <repo>/reports/recovery-<datetime>.md
    <repo>/reports is created if absent. If it is unwritable, exits with
    code 100.
  - Prints issue counts and report path to stdout.
  - Adds per-step detail with -v.
  - Writes errors to stderr.

Common Run:
  fixremote /path/to/clean-clone
    Check whether recovery can be performed.
  fixremote -x /path/to/clean-clone
    Execute guarded recovery.

Exit codes:
  0   Success - checks passed and no unresolved issues.
  1   Invalid option or argument.
  2   User is not authorized - only approver/owner can run fixremote.
  3   Recovery failed - see the report for the next action.
  100 Missing required dependencies or configuration files.
  200 Git operation failed during recovery (fetch, push, fsck, etc.).
EOF
}

# High-Level Flow:
# 1. Validate dependencies/options and ensure approver authorization.
# 2. Run preflight checks on source clone and target origin.
# 3. Continue collecting findings on recoverable check failures.
# 4. Optionally run guarded recovery actions with verification (-x).
# 5. Persist report and exit based on unresolved findings.

# shellcheck disable=SC1091,SC2317  # Helper source paths and trap-managed
# paths.

# Fast-path help handling before any helper sourcing/network/git side effects.
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    usage
    exit 0
  fi
done

set -euo pipefail

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_UNAUTHORIZED=2
readonly EXIT_RECOVERY_FAILED=3
readonly EXIT_MISSING_DEPENDENCIES=100

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"
RECOVERY_REPORTS_DIR="$REPO_ROOT/reports"
RUN_TS_FILE="$(date '+%Y%m%d-%H%M%S%z')"
RUN_TS_DISPLAY="$(date '+%Y-%m-%d %H:%M:%S%z' | sed -E 's/([+-][0-9]{2})([0-9]{2})$/\1:\2/')"
REPORT_FILE=""
CLONE_PATH=""
CLONE_ABS=""
VERBOSE=false
DRY_RUN=false
EXECUTE_RECOVERY=false
REMOTE_TIMEOUT_SECONDS=10
readonly REMOTE_RETRY_ATTEMPTS=3
readonly REMOTE_RETRY_BASE_DELAY_SECONDS=1

ISSUES_FOUND=0
ISSUES_FIXED=0
REMEDIATIONS_ATTEMPTED=0
REMEDIATIONS_VERIFIED=0
REMEDIATIONS_UNVERIFIED=0
REMEDIATIONS_FAILED=0

# Validate required helpers exist
if [[ ! -f "$SCRIPT_DIR/../helpers/common.sh" ]]; then
  bt_emit_error "Required helper not found: $SCRIPT_DIR/../helpers/common.sh"
  exit "$EXIT_MISSING_DEPENDENCIES"
fi
if [[ ! -f "$SCRIPT_DIR/../helpers/git_helpers.sh" ]]; then
  bt_emit_error \
    "Required helper not found: $SCRIPT_DIR/../helpers/git_helpers.sh"
  exit "$EXIT_MISSING_DEPENDENCIES"
fi
if [[ ! -f "$SCRIPT_DIR/../helpers/report_helpers.sh" ]]; then
  bt_emit_error \
    "Required helper not found: $SCRIPT_DIR/../helpers/report_helpers.sh"
  exit "$EXIT_MISSING_DEPENDENCIES"
fi
if [[ ! -f "$SCRIPT_DIR/../helpers/health_report.sh" ]]; then
  bt_emit_error \
    "Required helper not found: $SCRIPT_DIR/../helpers/health_report.sh"
  exit "$EXIT_MISSING_DEPENDENCIES"
fi
# shellcheck source=helpers/common.sh
source "$SCRIPT_DIR/../helpers/common.sh"
# shellcheck source=helpers/git_helpers.sh
source "$SCRIPT_DIR/../helpers/git_helpers.sh"
# shellcheck source=helpers/report_helpers.sh
source "$SCRIPT_DIR/../helpers/report_helpers.sh"
# shellcheck source=helpers/health_report.sh
source "$SCRIPT_DIR/../helpers/health_report.sh"

usage_error() {
  local message="$1"
  usage
  echo >&2
  echo "$message. See usage above for details." >&2
  exit "$EXIT_INVALID_ARGUMENT"
}

# log_verbose: printed only when -v (verbose mode).
# Use for per-step progress detail inside check functions.
log_verbose() {
  [[ "$VERBOSE" == true ]] || return 0
  bt_info "$1"
}

append_section() {
  bt_hr_append_section "$REPORT_FILE" "$1"
}

append_check() {
  local check_name="$1"
  local status="$2"
  local details="${3:-}"

  if (( $# > 3 )); then
    shift 3
    details="$(printf '%s %s' "$details" "$*")"
  fi

  bt_hr_append_check \
    "$REPORT_FILE" "$check_name" "$status" "$details" \
    ISSUES_FOUND ISSUES_FIXED
}

normalize_remote_url() {
  local url="$1"
  url="${url%.git}"
  printf '%s' "$url"
}

require_approver_role() {
  local actor_login=""
  local actor_email=""

  actor_login="$(bt_require_login 2>/dev/null || true)"
  [[ -n "$actor_login" ]] || bt_error_exit "$EXIT_UNAUTHORIZED" \
    "User is not authorized to run fixremote (requires approver/owner role)."

  actor_email="$(git -C "$REPO_ROOT" config user.email 2>/dev/null || true)"

  if bt_contributors_has_min_role_by_login_or_email \
    "$actor_login" "$actor_email" "approver" \
    "$REPO_ROOT/config/contributors.md" || \
    bt_is_repository_owner_login "$actor_login"; then
    return 0
  fi
  bt_error_exit "$EXIT_UNAUTHORIZED" \
    "User is not authorized to run fixremote (requires approver/owner role)."
}

init_report() {
  {
    printf '# Remote Recovery Report\n\n'
    printf '**Timestamp:** %s  \n' "$RUN_TS_DISPLAY"
    printf '**Repository for Reports:** %s  \n' "$REPO_ROOT"
    printf '**Target Remote (from this repository):** %s  \n' \
      "$(bt_git_get_origin_url_or_empty "$REPO_ROOT")"
    printf '**Source Clone Path:** %s\n\n' "$CLONE_ABS"
    printf '%s\n\n' '---'
    printf '## Checks Performed\n\n'
  } > "$REPORT_FILE"
}

check_clone_repository() {
  append_section "Source Clone Validation"

  if bt_git_is_repository "$CLONE_ABS"; then
    append_check "Clone Git Repository" "PASS" \
      "Clone path is a valid git repository"
    return 0
  fi

  append_check "Clone Git Repository" "ERROR" \
    "Clone path is not a valid git repository"
  return 1
}

check_clone_worktree_clean() {
  append_section "Source Clone Working Tree"

  local status_output=""
  status_output="$(git -C "$CLONE_ABS" status --porcelain 2>/dev/null || true)"
  if [[ -n "$status_output" ]]; then
    local file_count=""
    file_count="$(printf '%s\n' "$status_output" | wc -l | tr -d ' ')"
    append_check "Clone Worktree Clean" "ISSUE" \
      "Clone has $file_count changed tracked/untracked entries. Clean/stash" \
      "clone changes before recovery."
    return 1
  fi

  append_check "Clone Worktree Clean" "PASS" "Clone working tree is clean"
  return 0
}

check_clone_fsck() {
  append_section "Source Clone Object Integrity"

  local fsck_output=""
  fsck_output="$(git -C "$CLONE_ABS" fsck --full 2>&1 || true)"
  if printf '%s\n' "$fsck_output" | \
    grep -Eq '(^|[[:space:]])(error|fatal):'; then
    append_check "Clone Object Database" "ISSUE" \
      "git fsck detected integrity errors in source clone; recovery is" \
      "blocked until clone is healthy."
    printf '%s\n' "$fsck_output" | sed 's/^/    /' >> "$REPORT_FILE"
    return 1
  fi

  append_check "Clone Object Database" "PASS" \
    "No clone corruption detected by git fsck --full"
  return 0
}

check_origin_configuration() {
  append_section "Remote Repository"

  local target_origin=""
  local clone_origin=""
  target_origin="$(bt_git_get_origin_url_or_empty "$REPO_ROOT")"
  clone_origin="$(bt_git_get_origin_url_or_empty "$CLONE_ABS")"

  if [[ -z "$target_origin" ]]; then
    append_check "Target Remote" "ERROR" \
      "This repository has no remote repository URL"
    return 1
  fi

  append_check "Target Remote" "PASS" "$target_origin"

  if [[ -z "$clone_origin" ]]; then
    append_check "Source Clone Remote" "ISSUE" \
      "The source clone has no remote URL. Recovery can still use this" \
      "repository's remote."
  else
    append_check "Source Clone Remote" "PASS" "$clone_origin"
    if [[ "$(normalize_remote_url "$target_origin")" == \
      "$(normalize_remote_url "$clone_origin")" ]]; then
      append_check "Remote URL Match" "PASS" \
        "The source clone and this repository use the same remote"
    else
      append_check "Remote URL Match" "ISSUE" \
        "The source clone uses a different remote URL. Verify you" \
        "selected the correct clean clone."
    fi
  fi

  if [[ "$REMOTE_TIMEOUT_SECONDS" -eq 0 ]]; then
    append_check "Remote Reachability" "PASS" "Skipped (disabled by -t 0)"
    return 0
  fi

  if bt_git_ls_remote_origin_with_timeout_and_retry \
    "$REPO_ROOT" "$REMOTE_TIMEOUT_SECONDS" \
    "$REMOTE_RETRY_ATTEMPTS" "$REMOTE_RETRY_BASE_DELAY_SECONDS"; then
    append_check "Remote Reachability" "PASS" "Remote is reachable"
    return 0
  fi

  append_check "Remote Reachability" "ISSUE" \
    "Remote could not be reached within ${REMOTE_TIMEOUT_SECONDS}s." \
    "Recovery execution is blocked."
  return 1
}

run_recovery_if_requested() {
  append_section "Recovery Execution"

  if [[ "$EXECUTE_RECOVERY" == false ]]; then
    append_check "Recovery Mode" "PASS" \
      "Checks only (use -x to perform recovery)"
    return 0
  fi

  if [[ "$DRY_RUN" == true ]]; then
    append_check "Recovery Mode" "PASS" \
      "Dry-run mode enabled; no mutation attempted"
    return 0
  fi

  if [[ "$REMOTE_TIMEOUT_SECONDS" -eq 0 ]]; then
    append_check "Recovery Mode" "ISSUE" \
      "Cannot execute recovery with -t 0 because reachability checks are" \
      "disabled"
    return 1
  fi

  bt_increment_counter REMEDIATIONS_ATTEMPTED

  if ! bt_git_run_with_retry \
    "$REMOTE_RETRY_ATTEMPTS" "$REMOTE_RETRY_BASE_DELAY_SECONDS" \
    git -C "$CLONE_ABS" push --prune origin \
    '+refs/heads/*:refs/heads/*' '+refs/tags/*:refs/tags/*' \
    >/dev/null 2>&1; then
    append_check "Restore Remote Branches and Tags" "ISSUE" \
      "Failed to restore branches and tags from the source clone. See Git output" \
      "from manual run for details."
    bt_increment_counter REMEDIATIONS_FAILED
    return 1
  fi

  local clone_main_sha=""
  local remote_main_sha=""

  clone_main_sha="$(git -C "$CLONE_ABS" rev-parse refs/heads/main \
    2>/dev/null || true)"
  remote_main_sha="$(git -C "$REPO_ROOT" ls-remote --heads origin \
    refs/heads/main 2>/dev/null | awk '{print $1}' | head -n 1)"

  if [[ -n "$clone_main_sha" && -n "$remote_main_sha" && \
    "$clone_main_sha" == "$remote_main_sha" ]]; then
    append_check "Main Branch Match" "FIXED" \
      "Remote main now matches source clone main ($clone_main_sha)"
    bt_increment_counter REMEDIATIONS_VERIFIED
    return 0
  fi

  append_check "Main Branch Match" "ISSUE" \
    "Remote recovery finished, but main could not be verified. Check" \
    "source/remote branch state manually."
  bt_increment_counter REMEDIATIONS_UNVERIFIED
  return 1
}

finalize_report() {
  local issues_remaining
  issues_remaining=$((ISSUES_FOUND - ISSUES_FIXED))
  if [[ "$issues_remaining" -lt 0 ]]; then
    issues_remaining=0
  fi

  cat >> "$REPORT_FILE" << EOF

---

## Summary

**Issues Detected:** $ISSUES_FOUND
**Issues Fixed:** $ISSUES_FIXED
**Recovery Attempts:** $REMEDIATIONS_ATTEMPTED
**Recovery Verified:** $REMEDIATIONS_VERIFIED
**Recovery Not Verified:** $REMEDIATIONS_UNVERIFIED
**Recovery Failed:** $REMEDIATIONS_FAILED
**Issues Remaining:** $issues_remaining

EOF

  if [[ "$issues_remaining" -eq 0 ]]; then
    cat >> "$REPORT_FILE" << 'EOF'

Status: No unresolved issues remain.

EOF
  else
    cat >> "$REPORT_FILE" << 'EOF'

Status: Unresolved issues remain; manual follow-up required.

EOF
  fi

  cat >> "$REPORT_FILE" << 'EOF'

### Recommendations

- Review ISSUE/ERROR entries in this report before retrying recovery.
- Ensure source clone is clean and passes `git fsck --full`.
- Verify the remote URL, authentication, and network access when checks fail.
- Use `fixremote -x <clone-path>` only after the checks pass.

EOF
}

POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d)
      DRY_RUN=true
      shift
      ;;
    -t)
      [[ $# -ge 2 ]] || usage_error "Missing value for $1"
      REMOTE_TIMEOUT_SECONDS="$2"
      shift 2
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    -x)
      EXECUTE_RECOVERY=true
      shift
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ "${#POSITIONAL[@]}" -ne 1 ]]; then
  usage_error "Exactly one clone-path argument is required"
fi

if [[ ! "$REMOTE_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]]; then
  usage_error \
    "Invalid -t value: $REMOTE_TIMEOUT_SECONDS (expected integer >= 0)"
fi

CLONE_PATH="${POSITIONAL[0]}"
require_approver_role

if [[ ! -d "$CLONE_PATH" ]]; then
  bt_error_exit "$EXIT_INVALID_ARGUMENT" \
    "Clone path not found or not a directory: $CLONE_PATH"
fi

CLONE_ABS="$(cd "$CLONE_PATH" && pwd -P)"

if [[ ! -d "$REPO_ROOT/reports" ]]; then
  bt_error_exit "$EXIT_MISSING_DEPENDENCIES" \
    "Reports directory not found: $REPO_ROOT/reports"
fi

if ! mkdir -p "$RECOVERY_REPORTS_DIR"; then
  bt_error_exit "$EXIT_MISSING_DEPENDENCIES" \
    "Unable to create reports directory: $RECOVERY_REPORTS_DIR"
fi

REPORT_TARGET_FILE="$(bt_report_retained_path \
  "$RECOVERY_REPORTS_DIR" "recovery" "$RUN_TS_FILE")"
staged_report_file=""
if ! bt_report_create_staging_file "$REPORT_TARGET_FILE" staged_report_file; then
  bt_error_exit "$EXIT_MISSING_DEPENDENCIES" \
    "Unable to stage recovery report: $REPORT_TARGET_FILE"
fi
REPORT_FILE="$staged_report_file"

init_report

check_clone_repository || true
check_clone_worktree_clean || true
check_clone_fsck || true
check_origin_configuration || true
run_recovery_if_requested || true

finalize_report

if ! bt_report_publish_staged_file "$staged_report_file" "$REPORT_TARGET_FILE"; then
  bt_report_discard_staged_file "$staged_report_file"
  bt_error_exit "$EXIT_MISSING_DEPENDENCIES" \
    "Unable to publish recovery report: $REPORT_TARGET_FILE"
fi
REPORT_FILE="$REPORT_TARGET_FILE"

ISSUES_REMAINING=$((ISSUES_FOUND - ISSUES_FIXED))
if [[ "$ISSUES_REMAINING" -lt 0 ]]; then
  ISSUES_REMAINING=0
fi

echo "Issues: $ISSUES_FOUND found  $ISSUES_FIXED fixed  $ISSUES_REMAINING" \
     "remaining."
echo "See ${REPORT_FILE#"${REPO_ROOT}"/} for details."

if [[ "$VERBOSE" == true ]]; then
  echo ""
  echo "Report contents:"
  sed 's/^/  /' "$REPORT_FILE"
fi

if [[ "$ISSUES_REMAINING" -gt 0 ]]; then
  exit "$EXIT_RECOVERY_FAILED"
fi

exit 0
