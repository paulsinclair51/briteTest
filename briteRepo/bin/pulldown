#!/usr/bin/env bash

# pulldown - Pull parent branch down into current branch.
#
# Run pulldown -h for usage.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PULLDOWN_WORKFLOW="$SCRIPT_DIR/../helpers/pulldown_workflow.sh"
declare -a ORIGINAL_ARGS=("$@")

for argument in "${ORIGINAL_ARGS[@]}"; do
  if [[ "$argument" == "-h" || "$argument" == "--help" ]]; then
    exec bash "$PULLDOWN_WORKFLOW" --public --help
  fi
done

for ((index=0; index < ${#ORIGINAL_ARGS[@]}; index++)); do
  argument="${ORIGINAL_ARGS[index]}"
  case "$argument" in
    -c|-t)
      ((index += 1))
      ;;
    -d|-h|--help|-o|-v)
      ;;
    --)
      break
      ;;
    -*)
      printf 'Unknown option: %s\n' "$argument" >&2
      exit 1
      ;;
    *)
      printf 'Unknown argument: %s\n' "$argument" >&2
      exit 1
      ;;
  esac
done

exec bash "$PULLDOWN_WORKFLOW" --public "${ORIGINAL_ARGS[@]}"
