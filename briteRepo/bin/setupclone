#!/usr/bin/env bash

# setupclone - Make all scripts in the script directory executable, add to PATH,
#              and configure Git hooks using core.hooksPath.
#
# See usage below for details, or run: setupclone -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  setupclone [-t SEC]
  setupclone {-h | --help}

Make all scripts in the script directory executable, add it to PATH, and
configure Git hooks.

This script:
  - Makes all scripts in the script directory executable (chmod +x).
  - Adds the script directory to PATH in ~/.bashrc if not already present.
  - Configures ~/.inputrc to make command completion more discoverable.
  - Adds a ~/.bashrc hook to auto-load ~/.inputrc in interactive shells.
  - Configures Git to use hooks from the adjacent helpers/.githooks/ directory
    via core.hooksPath.
  - Updates the shell configuration for current and future sessions.

After running, scripts in the script directory will be:
  - Executable by the user.
  - Available by name in the shell (e.g., lsbranch -h, setupclone -h).
  - Persistent across new shell sessions.

Git hooks will be:
  - Configured to use the versioned hooks directory (helpers/.githooks/)
  - Active immediately on checkout operations
  - Automatically maintained through version control

Options:
  -h, --help  Output this help to stdout and exit (other options
              and arguments are ignored).
  -t SEC      Remote operation timeout in seconds (default: 10).
              SEC must be an integer greater than 0.

Examples:
  # Setup clone environment
  setupclone

  # Show help
  setupclone -h

Outputs:
  - Writes help text, status messages, and results to stdout.
  - Writes errors and diagnostics to stderr.
  - Modifies ~/.bashrc to add the script directory to PATH.
  - Modifies ~/.bashrc to auto-load ~/.inputrc for interactive shells.
  - Modifies ~/.inputrc to configure completion visibility settings.

Exit codes:
  0  Success
  1  Invalid option or argument
EOF
}

# High-Level Flow:
# - Parse options and resolve repository root and helper availability.
# - Ensure the script directory exists and make scripts executable.
# - Update shell startup files for PATH and completion behavior.
# - Configure repository hooks path and load updated shell configuration.

set -euo pipefail

readonly EXIT_INVALID_ARGUMENT=1

bt_emit_error() {
  printf 'Error: %s\n' "$1" >&2
}

usage_error() {
  local message="$1"
  usage
  echo >&2
  bt_emit_error "$message. See usage above for details."
  exit "$EXIT_INVALID_ARGUMENT"
}

# Check for help options first
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    usage
    exit 0
  fi
done

REMOTE_TIMEOUT_SECONDS=10
while [[ $# -gt 0 ]]; do
  case "$1" in
    -t)
      [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || \
        usage_error "Option -t requires an integer greater than 0"
      REMOTE_TIMEOUT_SECONDS="$2"
      shift 2
      ;;
    *) usage_error "Unknown argument: $1" ;;
  esac
done
export BT_REMOTE_TIMEOUT_SECONDS="$REMOTE_TIMEOUT_SECONDS"

# Determine repository root from git or from this script's location
if git rev-parse --git-dir > /dev/null 2>&1; then
  repo_root="$(git rev-parse --show-toplevel)"
else
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_name="$(basename "$repo_root")"
hooks_dir="$SCRIPT_DIR/../helpers/.githooks"

scripts_bin="$SCRIPT_DIR"

# Verify the script directory exists
if [[ ! -d "$scripts_bin" ]]; then
  bt_emit_error "Script directory not found at $scripts_bin"
  exit "$EXIT_INVALID_ARGUMENT"
fi

echo "Installing scripts for $repo_name from $scripts_bin..."

# Make all scripts executable (chmod +x)
echo "Making scripts executable..."
for script in "$scripts_bin"/*; do
  # Skip directories and README
  if [[ -f "$script" && "$script" != *"README.md" ]]; then
    chmod +x "$script"
    echo "  ✓ $(basename "$script")"
  fi
done

# Add the script directory to PATH in ~/.bashrc if not already present
echo ""
echo "Adding $scripts_bin to PATH..."

path_line="export PATH=\"$scripts_bin:\$PATH\""

if grep -qxF "$path_line" ~/.bashrc 2>/dev/null; then
  echo "  → Already in ~/.bashrc"
else
  echo "$path_line" >> ~/.bashrc
  echo "  ✓ Added to ~/.bashrc"
fi

bind_hook_line="if [[ \$- == *i* ]] && [[ -f \"\$HOME/.inputrc\" ]]; then bind -f \"\$HOME/.inputrc\" >/dev/null 2>&1 || true; fi"
if grep -qxF "$bind_hook_line" ~/.bashrc 2>/dev/null; then
  echo "  → ~/.bashrc already auto-loads ~/.inputrc"
else
  echo "$bind_hook_line" >> ~/.bashrc
  echo "  ✓ Added ~/.bashrc hook to auto-load ~/.inputrc"
fi

# Configure ~/.inputrc for more discoverable completion behavior
echo ""
echo "Configuring Bash completion visibility..."

inputrc_file="$HOME/.inputrc"
completion_setting_lines=(
  "set show-all-if-ambiguous on"
  "set menu-complete-display-prefix on"
  "set colored-completion-prefix on"
  "set colored-stats on"
  "\"\\en\": menu-complete"
  "\"\\ep\": menu-complete-backward"
)

if [[ ! -f "$inputrc_file" ]]; then
  touch "$inputrc_file"
fi

inputrc_updated=false
for setting_line in "${completion_setting_lines[@]}"; do
  if ! grep -qxF "$setting_line" "$inputrc_file"; then
    echo "$setting_line" >> "$inputrc_file"
    inputrc_updated=true
  fi
done

if [[ "$inputrc_updated" == true ]]; then
  echo "  ✓ Updated ~/.inputrc"
else
  echo "  → Already configured in ~/.inputrc"
fi

# Install Git hooks
echo ""
echo "Installing Git hooks for workflow protection..."
hook_installer="$SCRIPT_DIR/../helpers/install_git_hooks.sh"

if [[ -f "$hook_installer" ]]; then
  if bash "$hook_installer"; then
    echo "  ✓ Git hooks configured"
  else
    echo "  ⚠ Warning: Failed to configure Git hooks" >&2
    echo "     Run manually: bash $hook_installer" >&2
  fi
else
  echo "  ⚠ Warning: Hook installer not found at $hook_installer" >&2
fi

# Load the updated configuration
echo ""
echo "Loading updated configuration..."
# shellcheck disable=SC1090  # Intentional user shell profile source.
if ! source ~/.bashrc 2>/dev/null; then
  echo "Warning: Updated ~/.bashrc, but could not reload it." >&2
  echo "Run: source ~/.bashrc, or start a new shell session." >&2
else
  if [[ -f "$inputrc_file" ]]; then
    bind -f "$inputrc_file" 2>/dev/null || true
  fi
fi

echo ""
echo "Installed briteRepo scripts and configured Git hooks for this clone."
echo ""
echo "Scripts in $scripts_bin are now:"
echo "  - Executable"
echo "  - Available in PATH for current and future sessions"
echo ""
echo "Git hooks are now:"
echo "  - Configured to use versioned hooks directory ($hooks_dir)"
echo "  - Active immediately"
echo "  - Will run on checkout and other git operations"
echo ""
echo "For a new terminal, scripts can be run by name."
echo "For this already-open terminal, run: source ~/.bashrc && hash -r"
echo "Then run scripts by name, e.g.: lsbranch -h"
echo "For completion settings in this already-open terminal, run: bind -f ~/.inputrc"
