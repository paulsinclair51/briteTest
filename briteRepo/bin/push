#!/usr/bin/env bash

# push - Push local branch commits to remote.
#
# Run push -h for usage.
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PUSH_COMMAND="$SCRIPT_DIR/../helpers/push_command.sh"
declare -a ORIGINAL_ARGS=("$@")

for argument in "${ORIGINAL_ARGS[@]}"; do
  if [[ "$argument" == "-h" || "$argument" == "--help" ]]; then
    exec bash "$PUSH_COMMAND" --public --help
  fi
done

for ((index=0; index < ${#ORIGINAL_ARGS[@]}; index++)); do
  argument="${ORIGINAL_ARGS[index]}"
  case "$argument" in
    -t)
      ((index += 1))
      ;;
    -d|-e|-v)
      ;;
    -*)
      printf 'Unknown option: %s\n' "$argument" >&2
      exit 1
      ;;
    *)
      printf 'Unknown argument: %s\n' "$argument" >&2
      exit 1
      ;;
  esac
done

exec bash "$PUSH_COMMAND" --public "${ORIGINAL_ARGS[@]}"
