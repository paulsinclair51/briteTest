#!/usr/bin/env bash

# pre-merge-commit hook - Block direct git merge operations
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see LICENSE in the repository root.
#
# This hook runs before 'git merge' command creates a merge commit.
# It prevents developers from bypassing the script-based merge workflow.
#
# Scripts set GIT_BYPASS_HOOKS=true when performing authorized merges.
#
# Blocked operations:
#   git merge <branch>              → Use: pulldown (sync parent into current)
#   git merge --squash              → Use: pulldown (if policy allows squash)
#   git merge --no-ff               → Use: pulldown/pushup workflow scripts

set -euo pipefail

# Source hook helper for common functions
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GITHOOK_HELPER="$HOOK_DIR/githook_helper.sh"

# Fallback for legacy installs that still run from .git/hooks.
if [[ ! -f "$GITHOOK_HELPER" ]]; then
  GITHOOK_HELPER="$(git rev-parse --git-dir)/hooks/githook_helper.sh"
fi
if [[ -f "$GITHOOK_HELPER" ]]; then
  source "$GITHOOK_HELPER" 2>/dev/null || true
fi

# Check if bypass is set by authorized script or owner unrestricted mode
if declare -F check_bypass >/dev/null 2>&1; then
  if check_bypass "git merge" "pulldown"; then
    exit 0
  fi
elif [[ "${GIT_BYPASS_HOOKS:-false}" == "true" ]]; then
  exit 0
fi
exit 1
