#!/bin/bash
# Cleanup script - delete orphaned branches and sync v1.0.0

set -e

# Delete 7 orphaned branches
git push origin --delete copilot/copilotport-versioning-check-to-pr-4 2>/dev/null || true
git push origin --delete copilot/copilotupdate-ckstyle-validation-checks 2>/dev/null || true
git push origin --delete copilot/copilotupdate-ckstyle-validation-checks-again 2>/dev/null || true
git push origin --delete copilot/delete-stale-copilot-branches 2>/dev/null || true
git push origin --delete copilot/feat-add-v-versioning-check-to-ckstyle 2>/dev/null || true
git push origin --delete copilot/pr-5-complete-versioning-check 2>/dev/null || true
git push origin --delete copilot/research-ckdocs-ckdirectory-checks 2>/dev/null || true

# Delete agent working branches
git push origin --delete copilot/clean-up-repository 2>/dev/null || true
git push origin --delete copilot/cleanup-repository-tasks 2>/dev/null || true

# Sync v1.0.0 with main (force)
git fetch origin main:main
git fetch origin v1.0.0:v1.0.0
git branch -f v1.0.0 main
git push origin v1.0.0 --force

echo "Cleanup complete!"
